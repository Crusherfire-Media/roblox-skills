{
  "extraKnownMarketplaces": {
    "crusherfire": {
      "source": {
        "source": "github",
        "repo": "Crusherfire-Media/roblox-skills",
        "ref": "v0.1.4"
      }
    }
  },
  "enabledPlugins": {
    "roblox-dev@crusherfire": true,
    "mattpocock-skills@claude-plugins-official": true,
    "pages@crusherfire": true
  },
  "permissions": {
    "allow": [
      "Bash(rojo build *)",
      "Bash(rojo sourcemap *)",
      "Bash(luau-lsp analyze *)",
      "Bash(selene *)",
      "Bash(stylua --check *)",
      "PowerShell(rojo build *)",
      "PowerShell(rojo sourcemap *)",
      "PowerShell(luau-lsp analyze *)",
      "PowerShell(selene *)",
      "PowerShell(stylua --check *)",
      "Read(~/.claude/plugins/cache/crusherfire/**)"
