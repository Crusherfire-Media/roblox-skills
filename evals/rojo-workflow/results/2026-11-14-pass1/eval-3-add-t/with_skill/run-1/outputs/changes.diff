+-- t.Vector3 checks only the type, and NaN would break the grid math.
+local function isNotNaN(value: any): (boolean, string?)
+	-- NaN is the only value not equal to itself.
+	if value ~= value then
+		return false, "unexpected NaN value"
+	end
+	return true, nil
+end
+
+local checkPlaceBlockArgs = t.tuple(
+	t.intersection(t.string, t.keyOf(BlockTypes.ByName)),
+	t.intersection(t.Vector3, isNotNaN)
+)
