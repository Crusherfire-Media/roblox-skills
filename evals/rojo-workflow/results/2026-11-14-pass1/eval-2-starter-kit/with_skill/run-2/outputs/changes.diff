-Players.PlayerAdded:Connect(function(player: Player)
+const Players = game:GetService("Players")
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+const STARTER_KIT_NAME = "StarterKit"
+
+local function findStarterKit(): Configuration?
+	const starterKit = ReplicatedStorage:FindFirstChild(STARTER_KIT_NAME, true)
+	if starterKit and starterKit:IsA("Configuration") then
+		return starterKit
+	end
+	return nil
+end
+
+local function readCount(starterKit: Configuration?, blockName: string): number
+	if not starterKit then
+		return 0
+	end
+	const value = starterKit:GetAttribute(blockName)
+	if value == nil then
+		return 0
+	end
+	-- value ~= value catches NaN, which passes every range check
+	if typeof(value) ~= "number" or value ~= value or value < 0 then
+		warn(`{STARTER_KIT_NAME}.{blockName} must be a number of 0 or more; using 0`)
+		return 0
+	end
+	return math.floor(value)
+end
+
+local function giveStarterKit(player: Player)
+	const starterKit = findStarterKit()
+	if not starterKit then
+		warn(`No Configuration named {STARTER_KIT_NAME} under ReplicatedStorage; kit is empty`)
+	end
+	for _, blockType in BlockTypes.List do
+		player:SetAttribute(blockType.Name, readCount(starterKit, blockType.Name))
+	end
+end
+
+local function onPlayerAdded(player: Player)
 	print(`{player.Name} joined`)
-end)
+	giveStarterKit(player)
+end
+
+Players.PlayerAdded:Connect(onPlayerAdded)
+-- A player can join before this script connects, most often in a Studio playtest
+for _, player in Players:GetPlayers() do
+	onPlayerAdded(player)
+end
