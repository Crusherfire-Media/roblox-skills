diff --git a/src/StarterPlayer/StarterPlayerScripts/Main.client.luau b/src/StarterPlayer/StarterPlayerScripts/Main.client.luau
index 19820e1..d8b7d16 100644
--- a/src/StarterPlayer/StarterPlayerScripts/Main.client.luau
+++ b/src/StarterPlayer/StarterPlayerScripts/Main.client.luau
@@ -1,4 +1,67 @@
+--!strict
 local Players = game:GetService("Players")
+local StarterGui = game:GetService("StarterGui")
+
+local BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+local NOTIFICATION_DURATION = 8 -- seconds
+local SET_CORE_RETRY_DELAY = 0.5 -- seconds
+local SET_CORE_MAX_ATTEMPTS = 20
 
 local localPlayer = Players.LocalPlayer
 print(`client started for {localPlayer.Name}`)
+
+local function hasStarterKit(): boolean
+	for _, blockType in BlockTypes.List do
+		if typeof(localPlayer:GetAttribute(blockType.Name)) ~= "number" then
+			return false
+		end
+	end
+	return true
+end
+
+local function formatStarterKit(): string
+	local entries = {}
+	for _, blockType in BlockTypes.List do
+		local count = localPlayer:GetAttribute(blockType.Name) :: number
+		if count > 0 then
+			table.insert(entries, `{count} {blockType.DisplayName}`)
+		end
+	end
+	return table.concat(entries, ", ")
+end
+
+local function showStarterKitNotificationAsync()
+	local text = formatStarterKit()
+	if text == "" then
+		return
+	end
+	for _ = 1, SET_CORE_MAX_ATTEMPTS do
+		-- SetCore errors until the CoreScripts register SendNotification
+		local success = pcall(function()
+			StarterGui:SetCore("SendNotification", {
+				Title = "Starter kit",
+				Text = text,
+				Duration = NOTIFICATION_DURATION,
+			})
+		end)
+		if success then
+			return
+		end
+		task.wait(SET_CORE_RETRY_DELAY)
+	end
+	warn("Could not show the starter kit notification")
+end
+
+if hasStarterKit() then
+	task.spawn(showStarterKitNotificationAsync)
+else
+	local connection: RBXScriptConnection
+	connection = localPlayer.AttributeChanged:Connect(function()
+		if not hasStarterKit() then
+			return
+		end
+		connection:Disconnect()
+		task.spawn(showStarterKitNotificationAsync)
+	end)
+end
