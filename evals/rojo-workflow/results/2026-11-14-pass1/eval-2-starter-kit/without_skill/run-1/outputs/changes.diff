diff --git a/src/StarterPlayer/StarterPlayerScripts/Main.client.luau b/src/StarterPlayer/StarterPlayerScripts/Main.client.luau
index 19820e1..ac1ed51 100644
--- a/src/StarterPlayer/StarterPlayerScripts/Main.client.luau
+++ b/src/StarterPlayer/StarterPlayerScripts/Main.client.luau
@@ -1,4 +1,68 @@
 local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local StarterGui = game:GetService("StarterGui")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
 
 local localPlayer = Players.LocalPlayer
 print(`client started for {localPlayer.Name}`)
+
+local function allCountsSet(): boolean
+	for _, blockType in BlockTypes.List do
+		if typeof(localPlayer:GetAttribute(blockType.Name)) ~= "number" then
+			return false
+		end
+	end
+	return true
+end
+
+local function buildKitText(): string
+	local parts = {}
+	for _, blockType in BlockTypes.List do
+		local count = localPlayer:GetAttribute(blockType.Name) :: number
+		if count > 0 then
+			table.insert(parts, `{count} {blockType.DisplayName}`)
+		end
+	end
+	if #parts == 0 then
+		return "No starting blocks this time."
+	end
+	return table.concat(parts, ", ")
+end
+
+local function sendNotification(text: string)
+	-- SetCore fails until the CoreScripts have registered the callback, so retry for a bit.
+	for _ = 1, 20 do
+		local ok = pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
+			Title = "Starter kit",
+			Text = text,
+			Duration = 8,
+		})
+		if ok then
+			return
+		end
+		task.wait(0.5)
+	end
+	warn("Could not show the starter kit notification")
+end
+
+local notified = false
+local function tryNotify()
+	if notified or not allCountsSet() then
+		return
+	end
+	notified = true
+	sendNotification(buildKitText())
+end
+
+local connection
+connection = localPlayer.AttributeChanged:Connect(function()
+	tryNotify()
+	if notified then
+		connection:Disconnect()
+	end
+end)
+tryNotify()
+if notified then
+	connection:Disconnect()
+end
