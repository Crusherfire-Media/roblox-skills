+end
diff --git a/src/StarterPlayer/StarterPlayerScripts/Main.client.luau b/src/StarterPlayer/StarterPlayerScripts/Main.client.luau
index 19820e1..82216eb 100644
--- a/src/StarterPlayer/StarterPlayerScripts/Main.client.luau
+++ b/src/StarterPlayer/StarterPlayerScripts/Main.client.luau
@@ -1,4 +1,71 @@
 local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local StarterGui = game:GetService("StarterGui")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
 
 local localPlayer = Players.LocalPlayer
 print(`client started for {localPlayer.Name}`)
+
+local function hasAllCounts(): boolean
+	for _, blockType in BlockTypes.List do
+		if typeof(localPlayer:GetAttribute(blockType.Name)) ~= "number" then
+			return false
+		end
+	end
+	return true
+end
+
+-- Yields until the server has set a count attribute for every block type.
+local function waitForCounts()
+	if hasAllCounts() then
+		return
+	end
+	local ready = Instance.new("BindableEvent")
+	local connection = localPlayer.AttributeChanged:Connect(function()
+		if hasAllCounts() then
+			ready:Fire()
+		end
+	end)
+	-- Re-check in case the counts arrived between the first check and connecting.
+	if not hasAllCounts() then
+		ready.Event:Wait()
+	end
+	connection:Disconnect()
+	ready:Destroy()
+end
+
+local function buildKitText(): string
+	local parts = {}
+	for _, blockType in BlockTypes.List do
+		local count = localPlayer:GetAttribute(blockType.Name) :: number
+		if count > 0 then
+			table.insert(parts, `{count} {blockType.DisplayName}`)
+		end
+	end
+	if #parts == 0 then
+		return "You start with no blocks."
+	end
+	return `You got: {table.concat(parts, ", ")}`
+end
+
+-- SetCore fails until the core scripts have registered it, so retry for a little while.
+local function sendNotification(title: string, text: string)
+	for _ = 1, 20 do
+		local ok = pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
+			Title = title,
+			Text = text,
+			Duration = 8,
+		})
+		if ok then
+			return
+		end
+		task.wait(0.5)
+	end
+	warn("Could not show the starter kit notification")
+end
+
+task.spawn(function()
+	waitForCounts()
+	sendNotification("Starter kit", buildKitText())
+end)
