-Players.PlayerAdded:Connect(function(player: Player)
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+
+-- Designers tune the counts as attributes on this Configuration in Studio. It may live anywhere
+-- under ReplicatedStorage, so search for it rather than hard-coding a path.
+local function findStarterKit(): Configuration?
+	local found = ReplicatedStorage:FindFirstChild("StarterKit", true)
+	if found and found:IsA("Configuration") then
+		return found
+	end
+	warn("StarterKit Configuration not found under ReplicatedStorage; players start with 0 blocks")
+	return nil
+end
+
+local starterKit = findStarterKit()
+
+local function getStarterCount(blockName: string): number
+	if not starterKit then
+		return 0
+	end
+	local value = starterKit:GetAttribute(blockName)
+	if typeof(value) ~= "number" then
+		warn(`StarterKit has no number attribute "{blockName}"; using 0`)
+		return 0
+	end
+	return math.max(0, math.floor(value))
+end
+
+local function giveStarterKit(player: Player)
+	for _, blockType in BlockTypes.List do
+		player:SetAttribute(blockType.Name, getStarterCount(blockType.Name))
+	end
+end
+
+local function onPlayerAdded(player: Player)
 	print(`{player.Name} joined`)
-end)
