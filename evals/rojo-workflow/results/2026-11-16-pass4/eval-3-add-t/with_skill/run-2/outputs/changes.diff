+-- t.Vector3 only checks the type, so NaN components get their own check.
+local function isVector3WithoutNan(value: unknown): (boolean, string?)
+	local isVector3, message = t.Vector3(value)
+	if not isVector3 then
+		return false, message
+	end
+	-- A Vector3 with a NaN component is the only one not equal to itself.
+	if value ~= value then
+		return false, "Vector3 has a NaN component"
 	end
-	-- NaN is the only value not equal to itself.
-	if position ~= position then
+	return true, nil
+end
+
+local checkPlaceBlockArguments = t.tuple(t.string, isVector3WithoutNan)
+
+local function onPlaceBlock(player: Player, blockTypeNameValue: unknown, positionValue: unknown)
+	if not checkPlaceBlockArguments(blockTypeNameValue, positionValue) then
 		return
 	end
+	-- t is untyped, so the casts carry what the check above proved.
