diff --git a/src/StarterPlayer/StarterPlayerScripts/Main.client.luau b/src/StarterPlayer/StarterPlayerScripts/Main.client.luau
index 19820e1..956c87c 100644
--- a/src/StarterPlayer/StarterPlayerScripts/Main.client.luau
+++ b/src/StarterPlayer/StarterPlayerScripts/Main.client.luau
@@ -1,4 +1,54 @@
 local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local StarterGui = game:GetService("StarterGui")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
 
 local localPlayer = Players.LocalPlayer
 print(`client started for {localPlayer.Name}`)
+
+-- Yields until the server has set a count attribute for every block type.
+local function waitForStarterKit()
+	for _, blockType in BlockTypes.List do
+		while typeof(localPlayer:GetAttribute(blockType.Name)) ~= "number" do
+			localPlayer:GetAttributeChangedSignal(blockType.Name):Wait()
+		end
+	end
+end
+
+local function describeStarterKit(): string
+	local parts = {}
+	for _, blockType in BlockTypes.List do
+		local count = localPlayer:GetAttribute(blockType.Name) :: number
+		if count > 0 then
+			table.insert(parts, `{count} {blockType.DisplayName}`)
+		end
+	end
+	if #parts == 0 then
+		return "No blocks this time."
+	end
+	return table.concat(parts, ", ")
+end
+
+-- SetCore errors until the CoreScripts have registered it, so retry for a little while.
+local function sendNotification(title: string, text: string)
+	for _ = 1, 20 do
+		local ok = pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
+			Title = title,
+			Text = text,
+			Duration = 8,
+		})
+		if ok then
+			return
+		end
+		task.wait(0.5)
+	end
+	warn("Could not show the starter kit notification")
+end
+
+-- This LocalScript runs once per session (StarterPlayerScripts doesn't reset on respawn),
+-- so the notification shows once.
+task.spawn(function()
+	waitForStarterKit()
+	sendNotification("Starter kit", describeStarterKit())
+end)
