+-- t.Vector3 only checks the type, so a Vector3 with a NaN component would get through it.
+-- NaN is the only value not equal to itself, and a Vector3 with any NaN component is not equal
+-- to itself either.
+local function notNaN(value: any): (boolean, string?)
+	if value ~= value then
+		return false, "unexpected NaN value"
+	end
+	return true
+end
+
+-- Arguments a client sends with PlaceBlock: block type name, position.
+local checkPlaceBlockArgs = t.tuple(t.string, t.intersection(t.Vector3, notNaN))
+
 local function snapAxis(value: number): number
 	return math.floor(value / BLOCK_SIZE) * BLOCK_SIZE + BLOCK_SIZE / 2
 end
