diff --git a/src/ServerScriptService/Tests/Specs/Rules/BlockRules.spec.luau b/src/ServerScriptService/Tests/Specs/Rules/BlockRules.spec.luau
new file mode 100644
index 0000000..d7398c7
--- /dev/null
+++ b/src/ServerScriptService/Tests/Specs/Rules/BlockRules.spec.luau
@@ -0,0 +1,31 @@
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local ServerScriptService = game:GetService("ServerScriptService")
+
+local JestGlobals = require(ServerScriptService.Tests.Packages.JestGlobals)
+local describe = JestGlobals.describe
+local expect = JestGlobals.expect
+local it = JestGlobals.it
+
+local BlockRules = require(ReplicatedStorage.Rules.BlockRules)
+
+describe("BlockRules", function()
+	it("refuses an unknown block type", function()
+		local ok = BlockRules.validate("Lava", Vector3.new(1, 1, 1), Vector3.new(2, 2, 2), {})
+
+		expect(ok).toBe(false)
+	end)
+
+	it("refuses a cell beyond the player's reach", function()
+		local ok = BlockRules.validate("Brick", Vector3.new(2, 2, 61), Vector3.new(2, 2, 2), {})
+
+		expect(ok).toBe(false)
+	end)
+
+	it("accepts a free cell in reach and returns its center", function()
+		local ok, center =
+			BlockRules.validate("Brick", Vector3.new(5, 1, -3), Vector3.new(2, 2, 2), {})
+
+		expect(ok).toBe(true)
+		expect(center).toBe(Vector3.new(6, 2, -2))
+	end)
+end)
