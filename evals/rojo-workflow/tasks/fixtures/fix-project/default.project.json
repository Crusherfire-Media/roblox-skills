{
  "name": "eval-sandbox",
  "servePort": 34872,
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/ReplicatedStorage/Shared"
      },
      "Packages": {
        "$path": "roblox_packages"
      },
      "TestPackages": {
        "$path": "test_packages/roblox_packages"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/ServerScriptService",
      "Tests": {
        "$path": "src/ServerScriptService/Tests"
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$path": "src/StarterGui"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/StarterPlayer/StarterPlayerScript"
      }
    },
    "Players": {
      "$className": "Players"
    },
    "Lighting": {
      "$className": "Lighting"
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "SignalBehavior": "Deferred"
      },
      "Baseplate": {
        "$className": "Part",
        "$properties": {
          "Anchored": true,
          "Locked": true,
          "Size": [
            2048,
            16,
            2048
          ],
          "Position": [
            0,
            -8,
            0
          ],
          "Material": "Plastic",
          "Color": [
            0.388,
            0.373,
            0.384
          ]
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [
            12,
            1,
            12
          ],
          "Position": [
            0,
            0.5,
            0
          ]
        }
      }
    }
  }
}
