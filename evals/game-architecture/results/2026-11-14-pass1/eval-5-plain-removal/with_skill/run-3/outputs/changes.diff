+-- How far from the player's character a block may be placed or removed, in studs.
 local MAX_REACH = 64
--- Shortest time between two placements by one player, in seconds.
+-- Shortest time between two block actions by one player, in seconds. Placing and removing share
+-- it, so alternating the two can't double the rate.
 local MIN_INTERVAL = 0.1
 
+type PlacedBlock = {
+	Cell: Vector3,
+	OwnerUserId: number,
+}
+
 local placeBlock = Instance.new("RemoteEvent")
 placeBlock.Name = "PlaceBlock"
 placeBlock.Parent = ReplicatedStorage
 
+local removeBlock = Instance.new("RemoteEvent")
+removeBlock.Name = "RemoveBlock"
+removeBlock.Parent = ReplicatedStorage
+
 local blocksFolder = Instance.new("Folder")
 blocksFolder.Name = "Blocks"
 blocksFolder.Parent = Workspace
 
-local lastPlacedAt: { [Player]: number } = {}
+local lastActedAt: { [Player]: number } = {}
 local occupied: { [Vector3]: boolean } = {}
+local placedBlocks: { [Instance]: PlacedBlock? } = {}
 
 local function snapAxis(value: number): number
 	return math.floor(value / BLOCK_SIZE) * BLOCK_SIZE + BLOCK_SIZE / 2
@@ -34,6 +46,19 @@ local function snapToCell(position: Vector3): Vector3
 	return Vector3.new(snapAxis(position.X), snapAxis(position.Y), snapAxis(position.Z))
 end
 
+local function isRateLimited(player: Player, now: number): boolean
+	return now - (lastActedAt[player] or 0) < MIN_INTERVAL
+end
+
+local function isInReach(player: Player, cell: Vector3): boolean
+	local character = player.Character
+	local rootPart = if character then character:FindFirstChild("HumanoidRootPart") else nil
+	if not rootPart or not rootPart:IsA("BasePart") then
+		return false
+	end
+	return (cell - rootPart.Position).Magnitude <= MAX_REACH
+end
+
 local function onPlaceBlock(player: Player, blockTypeName: unknown, position: unknown)
 	if typeof(blockTypeName) ~= "string" or typeof(position) ~= "Vector3" then
 		return
@@ -49,13 +74,7 @@ local function onPlaceBlock(player: Player, blockTypeName: unknown, position: un
 	end
 
 	local now = os.clock()
-	if now - (lastPlacedAt[player] or 0) < MIN_INTERVAL then
-		return
-	end
-
-	local character = player.Character
-	local rootPart = if character then character:FindFirstChild("HumanoidRootPart") else nil
-	if not rootPart or not rootPart:IsA("BasePart") then
+	if isRateLimited(player, now) then
 		return
 	end
 
@@ -63,11 +82,11 @@ local function onPlaceBlock(player: Player, blockTypeName: unknown, position: un
 	if cell.Y < 0 or occupied[cell] then
 		return
 	end
-	if (cell - rootPart.Position).Magnitude > MAX_REACH then
+	if not isInReach(player, cell) then
 		return
 	end
 
-	lastPlacedAt[player] = now
+	lastActedAt[player] = now
 	occupied[cell] = true
 
 	local part = Instance.new("Part")
@@ -79,10 +98,41 @@ local function onPlaceBlock(player: Player, blockTypeName: unknown, position: un
 	part.Material = blockType.Material
 	part.Transparency = blockType.Transparency
 	part.Parent = blocksFolder
+
+	placedBlocks[part] = {
+		Cell = cell,
+		OwnerUserId = player.UserId,
+	}
+end
+
+local function onRemoveBlock(player: Player, block: unknown)
+	if typeof(block) ~= "Instance" then
+		return
+	end
+
+	-- Only blocks placed above are in this table, so it also rejects every other instance.
+	local placed = placedBlocks[block]
+	if not placed or placed.OwnerUserId ~= player.UserId then
+		return
+	end
+
+	local now = os.clock()
+	if isRateLimited(player, now) then
+		return
+	end
+	if not isInReach(player, placed.Cell) then
+		return
+	end
+
+	lastActedAt[player] = now
+	placedBlocks[block] = nil
+	occupied[placed.Cell] = nil
+	block:Destroy()
 end
 
 placeBlock.OnServerEvent:Connect(onPlaceBlock)
+removeBlock.OnServerEvent:Connect(onRemoveBlock)
 
 Players.PlayerRemoving:Connect(function(player: Player)
-	lastPlacedAt[player] = nil
+	lastActedAt[player] = nil
 end)
