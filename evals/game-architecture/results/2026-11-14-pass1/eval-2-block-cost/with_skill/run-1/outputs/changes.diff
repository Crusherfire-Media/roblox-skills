index 0000000..a4e200c
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/Implementation/_PlacementCurrencyMediator.luau
@@ -0,0 +1,38 @@
+--[[
+	Blocks cost coins to place, and placed blocks pay passive income: one coin per
+	block each payout.
+]]
+
+local BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+local CurrencyServerService = require(
+	"@game/ServerScriptService/Modules/Systems/Economy/CurrencySystem/SystemPackage/CurrencyServerService"
+)
+local NotificationServerService = require(
+	"@game/ServerScriptService/Modules/Systems/Core/NotificationSystem/SystemPackage/NotificationServerService"
+)
+local PlacementServerService = require("../SystemPackage/PlacementServerService")
+
+local PlacementCurrencyMediator = {}
+
+local function chargeForBlock(player: Player, blockType: BlockTypes.BlockType): boolean
+	if CurrencyServerService:TrySpend(player, blockType.Price) then
+		return true
+	end
+
+	local shortfall = blockType.Price - CurrencyServerService:GetCoins(player)
+	local noun = if shortfall == 1 then "coin" else "coins"
+	NotificationServerService:Notify(
+		player,
+		`You need {shortfall} more {noun} to place {blockType.DisplayName}.`
+	)
+	return false
+end
+
+function PlacementCurrencyMediator:Init()
+	PlacementServerService:SetChargeForBlock(chargeForBlock)
+	CurrencyServerService:SetIncomeSource(function(player: Player)
+		return PlacementServerService:GetBlockCount(player)
+	end)
+end
+
+return PlacementCurrencyMediator
