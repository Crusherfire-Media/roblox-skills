diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/Implementation/_PlacementCurrencyMediator.luau b/src/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/Implementation/_PlacementCurrencyMediator.luau
