--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/Implementation/_PlacementCurrencyMediator.luau
@@ -0,0 +1,23 @@
+--[[
+	Charges coins for each block placed, at the price in BlockTypes.
+]]
+
+local CurrencyServerService = require(
+	"@game/ServerScriptService/Modules/Systems/Economy/CurrencySystem/SystemPackage/CurrencyServerService"
+)
+local PlacementServerService = require("../SystemPackage/PlacementServerService")
+
+local PlacementCurrencyMediator = {}
+
+function PlacementCurrencyMediator:Init()
+	PlacementServerService:SetChargeCallback(function(player, blockType)
+		if CurrencyServerService:TrySpend(player, blockType.Price) then
+			return true, nil
+		end
+		local missing = blockType.Price - CurrencyServerService:GetCoins(player)
+		local unit = if missing == 1 then "coin" else "coins"
+		return false, `You need {missing} more {unit} to place {blockType.DisplayName}.`
+	end)
+end
+
+return PlacementCurrencyMediator
