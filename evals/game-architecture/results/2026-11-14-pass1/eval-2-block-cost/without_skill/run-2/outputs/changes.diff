index 0000000..6255d48
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Economy/CurrencySystem/Implementation/_BlockPriceMediator.luau
@@ -0,0 +1,30 @@
+--[[
+	Makes blocks cost coins. Each placement takes the block type's price from the player's coins;
+	if they can't afford it, the block isn't placed and they are told they need more coins.
+]]
+
+local NotificationServerService = require(
+	"@game/ServerScriptService/Modules/Systems/Core/NotificationSystem/SystemPackage/NotificationServerService"
+)
+local PlacementServerService = require(
+	"@game/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/SystemPackage/PlacementServerService"
+)
+local CurrencyServerService = require("../SystemPackage/CurrencyServerService")
+
+local BlockPriceMediator = {}
+
+function BlockPriceMediator:Init()
+	PlacementServerService:SetApprover(function(player, blockType)
+		if CurrencyServerService:TrySpend(player, blockType.Price) then
+			return true
+		end
+		local shortfall = blockType.Price - CurrencyServerService:GetCoins(player)
+		NotificationServerService:Notify(
+			player,
+			`You need {shortfall} more {if shortfall == 1 then "coin" else "coins"} to place {blockType.DisplayName}.`
+		)
+		return false
+	end)
+end
+
+return BlockPriceMediator
