diff --git a/src/ServerScriptService/Modules/Systems/Economy/CurrencySystem/Implementation/_BlockPriceMediator.luau b/src/ServerScriptService/Modules/Systems/Economy/CurrencySystem/Implementation/_BlockPriceMediator.luau
