+function RoundServerService:Start()
+	-- The loader waits for each Start to return before starting the next module, and only marks
+	-- the server loaded after the last one. Waiting for that inside Start would never finish, so
+	-- the round loop runs in its own thread.
+	task.spawn(runRoundsForever)
+end
+
