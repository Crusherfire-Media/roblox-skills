+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementSharedService.luau
@@ -0,0 +1,28 @@
+--!strict
+--[[
+	Grid rules both realms agree on: which parts count as ground, where placed
+	blocks live, and which cell a click targets.
+]]
+
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+const Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+local Module = {}
+Module.__index = Module
+
+-- Parts with this tag can be built on, and nothing is placed below their top.
+Module.GroundTag = "BlockPlacementGround"
+Module.BlocksFolderName = "PlacedBlocks"
+
+--[[
+	Returns the center of the cell next to a clicked surface, on the side the
+	surface normal points to.
+]]
+function Module:GetTargetCell(hitPosition: Vector3, hitNormal: Vector3): Vector3
+	-- Stepping half a block off the surface lands inside the neighbor cell,
+	-- away from the cell boundary the hit sits on.
+	const offsetPosition = hitPosition + hitNormal * (BlockTypes.BlockSize / 2)
+	return Grid.snapToCell(offsetPosition, BlockTypes.BlockSize)
+end
+
+return Module
diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau
