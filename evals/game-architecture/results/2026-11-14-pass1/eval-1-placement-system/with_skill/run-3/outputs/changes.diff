diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
new file mode 100644
index 0000000..88d1db9
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
@@ -0,0 +1,201 @@
+--!strict
+--[[
+	Places blocks for players, after checking every request a client sends.
+]]
+
+const CollectionService = game:GetService("CollectionService")
+const Players = game:GetService("Players")
+
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+const Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+const BlockPlacementNetwork = require("./BlockPlacementNetwork")
+const BlockPlacementSharedService = require("./BlockPlacementSharedService")
+
+const MAX_PLACE_DISTANCE = 64 -- studs, from the character's root part to the cell center
+const MAX_REQUESTS_PER_WINDOW = 10
+const RATE_WINDOW_SECONDS = 1
+-- Far past any reachable cell, so huge values fail before any grid math.
+const MAX_COORDINATE = 1e6
+const POSITION_TOLERANCE = 1e-3
+
+const BlockPlacementTypes = require("./BlockPlacementTypes")
+
+type RejectReason = BlockPlacementTypes.RejectReason
+type RejectedCallback = BlockPlacementTypes.RejectedCallback
+
+local Module = setmetatable({}, BlockPlacementSharedService)
+
+local blocksFolder: Folder? = nil
+local occupiedCells: { [string]: BasePart? } = {}
+local recentRequestTimes: { [Player]: { number }? } = {}
+local rejectedCallbacks: { RejectedCallback } = {}
+
+local function isSaneCoordinate(value: number): boolean
+	-- value == value rejects NaN, and the range check rejects infinity
+	return value == value and math.abs(value) <= MAX_COORDINATE
+end
+
+local function getCellKey(cellCenter: Vector3): string
+	const size = BlockTypes.BlockSize
+	const x = math.floor(cellCenter.X / size)
+	const y = math.floor(cellCenter.Y / size)
+	const z = math.floor(cellCenter.Z / size)
+	return `{x},{y},{z}`
+end
+
+--[[
+	Returns the top of the highest ground part under the cell, or nil when no
+	ground part covers it.
+]]
+local function getGroundTopUnder(cellCenter: Vector3): number?
+	local groundTop: number? = nil
+	for _, instance in CollectionService:GetTagged(BlockPlacementSharedService.GroundTag) do
+		if not instance:IsA("BasePart") then
+			continue
+		end
+
+		const halfExtents = instance.ExtentsSize / 2
+		const offset = cellCenter - instance.Position
+		if math.abs(offset.X) <= halfExtents.X and math.abs(offset.Z) <= halfExtents.Z then
+			const top = instance.Position.Y + halfExtents.Y
+			groundTop = if groundTop then math.max(groundTop, top) else top
+		end
+	end
+
+	return groundTop
+end
+
+local function tryConsumeRequest(player: Player): boolean
+	const now = os.clock()
+	const times = recentRequestTimes[player] or {}
+	recentRequestTimes[player] = times
+
+	while times[1] and now - times[1] >= RATE_WINDOW_SECONDS do
+		table.remove(times, 1)
+	end
+
+	if #times >= MAX_REQUESTS_PER_WINDOW then
+		return false
+	end
+
+	table.insert(times, now)
+	return true
+end
+
+local function reject(player: Player, reason: RejectReason)
+	for _, callback in rejectedCallbacks do
+		task.spawn(callback, player, reason)
+	end
+end
+
+local function createBlock(blockType: BlockTypes.BlockType, cellCenter: Vector3, folder: Folder)
+	const cellKey = getCellKey(cellCenter)
+	const block = Instance.new("Part")
+	block.Name = blockType.Name
+	block.Anchored = true
+	block.Size = Vector3.one * BlockTypes.BlockSize
+	block.CFrame = CFrame.new(cellCenter)
+	block.Color = blockType.Color
+	block.Material = blockType.Material
+	block.Transparency = blockType.Transparency
+
+	-- Frees the cell when the block is destroyed or unparented, so other systems
+	-- can remove blocks without telling this one.
+	block.AncestryChanged:Connect(function()
+		if not block:IsDescendantOf(workspace) and occupiedCells[cellKey] == block then
+			occupiedCells[cellKey] = nil
+		end
+	end)
+
+	occupiedCells[cellKey] = block
+	block.Parent = folder
+end
+
+local function onPlaceBlock(player: Player, blockTypeName: unknown, cellCenter: unknown)
+	const folder = blocksFolder
+	if not folder then
+		return
+	end
+
+	if not tryConsumeRequest(player) then
+		reject(player, "RateLimited")
+		return
+	end
+
+	if typeof(blockTypeName) ~= "string" then
+		reject(player, "InvalidBlockType")
+		return
+	end
+
+	const blockType: BlockTypes.BlockType? = BlockTypes.ByName[blockTypeName]
+	if not blockType then
+		reject(player, "InvalidBlockType")
+		return
+	end
+
+	if
+		typeof(cellCenter) ~= "Vector3"
+		or not isSaneCoordinate(cellCenter.X)
+		or not isSaneCoordinate(cellCenter.Y)
+		or not isSaneCoordinate(cellCenter.Z)
+	then
+		reject(player, "InvalidPosition")
+		return
+	end
+
+	const snappedCenter = Grid.snapToCell(cellCenter, BlockTypes.BlockSize)
+	if (snappedCenter - cellCenter).Magnitude > POSITION_TOLERANCE then
+		reject(player, "InvalidPosition")
+		return
+	end
+
+	const groundTop = getGroundTopUnder(snappedCenter)
+	const cellBottom = snappedCenter.Y - BlockTypes.BlockSize / 2
+	if not groundTop or cellBottom < groundTop - POSITION_TOLERANCE then
+		reject(player, "BelowGround")
+		return
+	end
+
+	const character = player.Character
+	const rootPart = if character then character:FindFirstChild("HumanoidRootPart") else nil
+	if not rootPart or not rootPart:IsA("BasePart") then
+		reject(player, "NoCharacter")
+		return
+	end
+
+	if (rootPart.Position - snappedCenter).Magnitude > MAX_PLACE_DISTANCE then
+		reject(player, "TooFar")
+		return
+	end
+
+	if occupiedCells[getCellKey(snappedCenter)] then
+		reject(player, "Occupied")
+		return
+	end
+
+	createBlock(blockType, snappedCenter, folder)
+end
+
+function Module:Init()
+	const folder = Instance.new("Folder")
+	folder.Name = BlockPlacementSharedService.BlocksFolderName
+	folder.Parent = workspace
+	blocksFolder = folder
+
+	BlockPlacementNetwork.PlaceBlock.OnServerEvent:Connect(onPlaceBlock)
+	Players.PlayerRemoving:Connect(function(player)
+		recentRequestTimes[player] = nil
+	end)
+end
+
+--[[
+	Calls the callback with the player and reason each time a placement request
+	is refused. Each call runs in its own thread, so a callback that yields or
+	errors never holds up placement.
+]]
+function Module:OnPlacementRejected(callback: RejectedCallback)
+	table.insert(rejectedCallbacks, callback)
+end
+
+return Module
