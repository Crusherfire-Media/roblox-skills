index 0000000..0f6d9a1
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementClientService.luau
@@ -0,0 +1,95 @@
+--!strict
+--[[
+	Turns clicks and taps on the ground or on placed blocks into placement
+	requests, and lets the number keys pick the block type.
+]]
+
+const CollectionService = game:GetService("CollectionService")
+const UserInputService = game:GetService("UserInputService")
+
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+
+const BlockPlacementNetwork = require("./BlockPlacementNetwork")
+const BlockPlacementSharedService = require("./BlockPlacementSharedService")
+
+-- Longer than the server's reach, so a click too far away still reaches the
+-- server and the player is told why nothing was placed.
+const RAY_LENGTH = 1000
+-- The key at index i picks BlockTypes.List[i].
+const BLOCK_TYPE_KEYS = {
+	Enum.KeyCode.One,
+	Enum.KeyCode.Two,
+	Enum.KeyCode.Three,
+	Enum.KeyCode.Four,
+	Enum.KeyCode.Five,
+}
+
+local Module = setmetatable({}, BlockPlacementSharedService)
+
+local selectedIndex = 1
+
+local function getPlacementTargets(): { Instance }
+	const targets = CollectionService:GetTagged(BlockPlacementSharedService.GroundTag)
+	const blocksFolder = workspace:FindFirstChild(BlockPlacementSharedService.BlocksFolderName)
+	if blocksFolder then
+		table.insert(targets, blocksFolder)
+	end
+
+	return targets
+end
+
+local function requestPlacementAt(screenPosition: Vector2)
+	const camera = workspace.CurrentCamera
+	if not camera then
+		return
+	end
+
+	const ray = camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
+	const raycastParams = RaycastParams.new()
+	raycastParams.FilterType = Enum.RaycastFilterType.Include
+	raycastParams.FilterDescendantsInstances = getPlacementTargets()
+
+	const result = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, raycastParams)
+	if not result then
+		return
+	end
+
+	const cellCenter = BlockPlacementSharedService:GetTargetCell(result.Position, result.Normal)
+	const blockType = BlockTypes.List[selectedIndex]
+	BlockPlacementNetwork.PlaceBlock:FireServer(blockType.Name, cellCenter)
+end
+
+local function onInputBegan(input: InputObject, isProcessed: boolean)
+	if isProcessed then
+		return
+	end
+
+	if input.UserInputType == Enum.UserInputType.MouseButton1 then
+		requestPlacementAt(Vector2.new(input.Position.X, input.Position.Y))
+	elseif input.UserInputType == Enum.UserInputType.Keyboard then
+		const index = table.find(BLOCK_TYPE_KEYS, input.KeyCode)
+		if index and BlockTypes.List[index] then
+			selectedIndex = index
+		end
+	end
+end
+
+local function onTouchTapInWorld(position: Vector2, isProcessedByUI: boolean)
+	if isProcessedByUI then
+		return
+	end
+
+	requestPlacementAt(position)
+end
+
+function Module:Init()
+	UserInputService.InputBegan:Connect(onInputBegan)
+	-- A tap, unlike a raw touch, is not the start of a camera drag.
+	UserInputService.TouchTapInWorld:Connect(onTouchTapInWorld)
+end
+
+function Module:GetSelectedBlockType(): BlockTypes.BlockType
+	return BlockTypes.List[selectedIndex]
+end
+
+return Module
