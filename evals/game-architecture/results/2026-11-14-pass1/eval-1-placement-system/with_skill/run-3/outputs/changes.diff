@@ -0,0 +1,14 @@
+--!strict
+
+export type RejectReason =
+	"InvalidBlockType"
+	| "InvalidPosition"
+	| "Occupied"
+	| "BelowGround"
+	| "NoCharacter"
+	| "TooFar"
+	| "RateLimited"
+
+export type RejectedCallback = (player: Player, reason: RejectReason) -> ()
+
+return {}
