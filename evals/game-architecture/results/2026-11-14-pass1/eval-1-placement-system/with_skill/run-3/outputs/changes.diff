+--!strict
+--[[
+	Marks this place's baseplate as ground that blocks can be built on.
+]]
+
+const CollectionService = game:GetService("CollectionService")
+
+const BlockPlacementSharedService = require("../SystemPackage/BlockPlacementSharedService")
+
+local Module = {}
+
+function Module:Init()
+	const baseplate = workspace:FindFirstChild("Baseplate")
+	if not baseplate then
+		warn("BlockPlacement: Workspace.Baseplate is missing, so no ground is set")
+		return
+	end
+
+	CollectionService:AddTag(baseplate, BlockPlacementSharedService.GroundTag)
+end
+
+return Module
