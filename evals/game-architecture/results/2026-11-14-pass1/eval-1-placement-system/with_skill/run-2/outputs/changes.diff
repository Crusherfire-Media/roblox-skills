+	-- Client to server: (blockTypeName: string, cell: Vector3)
+	PlaceBlock = script:WaitForChild("PlaceBlock") :: RemoteEvent,
+}
+
+return table.freeze(Module)
diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
new file mode 100644
index 0000000..ba251ab
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
@@ -0,0 +1,212 @@
+--!strict
+--[[
+	Checks every placement request from clients and places the blocks that pass.
+]]
+
+const Players = game:GetService("Players")
+
+const BlockPlacementNetwork = require("./BlockPlacementNetwork")
+const BlockPlacementSharedService = require("./BlockPlacementSharedService")
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+const Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+const RATE_WINDOW_SECONDS = 1
+-- Far past any reachable spot, so grid math stays well inside float range.
+const MAX_COORDINATE = 1e5
+const MAX_BLOCK_TYPE_NAME_LENGTH = 64
+-- How far a requested cell may sit from a cell center, for float error.
+const GRID_TOLERANCE = 0.01
+
+export type RejectReason =
+	"RateLimited"
+	| "InvalidBlockType"
+	| "InvalidPosition"
+	| "BelowFloor"
+	| "Occupied"
+	| "NoCharacter"
+	| "TooFar"
+
+type RejectListener = (player: Player, reason: RejectReason) -> ()
+
+local Module = setmetatable({}, BlockPlacementSharedService)
+
+local blocksFolder: Folder? = nil
+local floorHeight = -math.huge
+local maxDistance = 64
+local maxPlacementsPerSecond = 10
+local occupiedCells: { [string]: BasePart? } = {}
+local recentPlacementTimes: { [Player]: { number }? } = {}
+local rejectListeners: { RejectListener } = {}
+
+local function getCellKey(cell: Vector3): string
+	local index = (cell / BlockTypes.BlockSize):Floor()
+	return `{index.X},{index.Y},{index.Z}`
+end
+
+local function reject(player: Player, reason: RejectReason)
+	for _, listener in rejectListeners do
+		task.spawn(listener, player, reason)
+	end
+end
+
+local function isRateLimited(player: Player): boolean
+	local now = os.clock()
+	local times = recentPlacementTimes[player] or {}
+	recentPlacementTimes[player] = times
+
+	while times[1] and now - times[1] >= RATE_WINDOW_SECONDS do
+		table.remove(times, 1)
+	end
+	if #times >= maxPlacementsPerSecond then
+		return true
+	end
+	table.insert(times, now)
+	return false
+end
+
+local function isSaneCoordinate(value: number): boolean
+	-- value == value rejects NaN, which passes every range check
+	return value == value and math.abs(value) <= MAX_COORDINATE
+end
+
+--[[
+	Returns the cell center the client meant, or nil when the value is not a
+	finite position on the grid.
+]]
+local function parseCell(value: unknown): Vector3?
+	if typeof(value) ~= "Vector3" then
+		return nil
+	end
+	if
+		not isSaneCoordinate(value.X)
+		or not isSaneCoordinate(value.Y)
+		or not isSaneCoordinate(value.Z)
+	then
+		return nil
+	end
+
+	local cell = Grid.snapToCell(value, BlockTypes.BlockSize)
+	if (cell - value).Magnitude > GRID_TOLERANCE then
+		return nil
+	end
+	return cell
+end
+
+local function createBlock(blockType: BlockTypes.BlockType, cell: Vector3, folder: Folder)
+	local blockSize = BlockTypes.BlockSize
+	local block = Instance.new("Part")
+	block.Name = blockType.Name
+	block.Anchored = true
+	block.Size = Vector3.new(blockSize, blockSize, blockSize)
+	block.CFrame = CFrame.new(cell)
+	block.Color = blockType.Color
+	block.Material = blockType.Material
+	block.Transparency = blockType.Transparency
+	block:SetAttribute("BlockType", blockType.Name)
+	block:AddTag(BlockPlacementSharedService.SurfaceTag)
+
+	local key = getCellKey(cell)
+	occupiedCells[key] = block
+	block.Destroying:Connect(function()
+		if occupiedCells[key] == block then
+			occupiedCells[key] = nil
+		end
+	end)
+
+	block.Parent = folder
+end
+
+local function onPlaceBlock(player: Player, blockTypeName: unknown, cellValue: unknown)
+	if isRateLimited(player) then
+		reject(player, "RateLimited")
+		return
+	end
+
+	if typeof(blockTypeName) ~= "string" or #blockTypeName > MAX_BLOCK_TYPE_NAME_LENGTH then
+		reject(player, "InvalidBlockType")
+		return
+	end
+	local blockType = BlockTypes.ByName[blockTypeName]
+	if not blockType then
+		reject(player, "InvalidBlockType")
+		return
+	end
+
+	local cell = parseCell(cellValue)
+	if not cell then
+		reject(player, "InvalidPosition")
+		return
+	end
+	if cell.Y - BlockTypes.BlockSize / 2 < floorHeight - GRID_TOLERANCE then
+		reject(player, "BelowFloor")
+		return
+	end
+	if occupiedCells[getCellKey(cell)] then
+		reject(player, "Occupied")
+		return
+	end
+
+	local character = player.Character
+	local rootPart = if character then character.PrimaryPart else nil
+	if not rootPart then
+		reject(player, "NoCharacter")
+		return
+	end
+	if (rootPart.Position - cell).Magnitude > maxDistance then
+		reject(player, "TooFar")
+		return
+	end
+
+	local folder = blocksFolder
+	if not folder then
+		return
+	end
+	createBlock(blockType, cell, folder)
+end
+
+--[[
+	Lets players place blocks against the part. Placed blocks are surfaces
+	already.
+]]
+function Module:RegisterSurface(part: BasePart)
+	part:AddTag(BlockPlacementSharedService.SurfaceTag)
+end
+
+--[[
+	Sets the world height no block may extend below, in studs.
+]]
+function Module:SetFloorHeight(height: number)
+	floorHeight = height
+end
+
+--[[
+	Sets how far from a player's character they may place, in studs, and how
+	many requests each player may send per second. Requests count against the
+	rate limit even when they fail.
+]]
+function Module:SetLimits(limits: { MaxDistance: number?, MaxPlacementsPerSecond: number? })
+	maxDistance = limits.MaxDistance or maxDistance
+	maxPlacementsPerSecond = limits.MaxPlacementsPerSecond or maxPlacementsPerSecond
+end
+
+--[[
+	Calls the listener each time the server turns down a placement request.
+	Listeners run in their own thread.
+]]
+function Module:OnPlacementRejected(listener: RejectListener)
+	table.insert(rejectListeners, listener)
+end
+
+function Module:Init()
+	local folder = Instance.new("Folder")
+	folder.Name = "PlacedBlocks"
+	folder.Parent = workspace
+	blocksFolder = folder
+
+	BlockPlacementNetwork.PlaceBlock.OnServerEvent:Connect(onPlaceBlock)
+	Players.PlayerRemoving:Connect(function(player: Player)
+		recentPlacementTimes[player] = nil
+	end)
+end
+
+return Module
