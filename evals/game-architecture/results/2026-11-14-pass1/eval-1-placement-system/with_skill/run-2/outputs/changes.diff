+--!strict
+--[[
+	Sets this game's placement limits, and makes the baseplate a placement
+	surface and the floor blocks can't go below.
+]]
+
+const BlockPlacementServerService = require("../SystemPackage/BlockPlacementServerService")
+
+local Module = {}
+
+function Module:Init()
+	BlockPlacementServerService:SetLimits({
+		MaxDistance = 64,
+		MaxPlacementsPerSecond = 10,
+	})
+
+	local baseplate = workspace:FindFirstChild("Baseplate")
+	if not baseplate or not baseplate:IsA("BasePart") then
+		warn("Block placement found no Workspace.Baseplate part, so it has no floor")
+		return
+	end
+
+	BlockPlacementServerService:RegisterSurface(baseplate)
+	BlockPlacementServerService:SetFloorHeight(baseplate.Position.Y + baseplate.Size.Y / 2)
+end
+
+return Module
