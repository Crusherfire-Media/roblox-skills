index 0000000..88413a8
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementClientService.luau
@@ -0,0 +1,79 @@
+--!strict
+--[[
+	Turns clicks, taps, and the number keys into placement requests. The server
+	decides whether each placement happens.
+]]
+
+const Players = game:GetService("Players")
+const UserInputService = game:GetService("UserInputService")
+
+const BlockPlacementNetwork = require("./BlockPlacementNetwork")
+const BlockPlacementSharedService = require("./BlockPlacementSharedService")
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+
+const RAY_LENGTH = 1000
+-- Index into BlockTypes.List picked by each key.
+const SELECT_KEYS: { [Enum.KeyCode]: number? } = {
+	[Enum.KeyCode.One] = 1,
+	[Enum.KeyCode.Two] = 2,
+	[Enum.KeyCode.Three] = 3,
+	[Enum.KeyCode.Four] = 4,
+	[Enum.KeyCode.Five] = 5,
+}
+
+local Module = setmetatable({}, BlockPlacementSharedService)
+
+local selectedBlockType = BlockTypes.List[1]
+local raycastParams = RaycastParams.new()
+raycastParams.FilterType = Enum.RaycastFilterType.Exclude
+
+local function requestPlacementAt(screenPosition: Vector2)
+	local camera = workspace.CurrentCamera
+	if not camera then
+		return
+	end
+
+	local character = Players.LocalPlayer.Character
+	raycastParams.FilterDescendantsInstances = if character then { character } else {}
+
+	local ray = camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
+	local result = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, raycastParams)
+	if not result or not result.Instance:HasTag(BlockPlacementSharedService.SurfaceTag) then
+		return
+	end
+
+	local cell = Module:GetCellFromHit(result.Position, result.Normal)
+	BlockPlacementNetwork.PlaceBlock:FireServer(selectedBlockType.Name, cell)
+end
+
+local function onInputBegan(input: InputObject, isProcessedByGame: boolean)
+	if isProcessedByGame then
+		return
+	end
+
+	if input.UserInputType == Enum.UserInputType.MouseButton1 then
+		requestPlacementAt(Vector2.new(input.Position.X, input.Position.Y))
+		return
+	end
+
+	local index = SELECT_KEYS[input.KeyCode]
+	local blockType = if index then BlockTypes.List[index] else nil
+	if blockType then
+		selectedBlockType = blockType
+	end
+end
+
+-- Fires only for taps, not drags, so panning the camera never places a block.
+local function onTouchTapInWorld(position: Vector2, isProcessedByUi: boolean)
+	if isProcessedByUi then
+		return
+	end
+	requestPlacementAt(position)
+end
+
+function Module:Init()
+	UserInputService.InputBegan:Connect(onInputBegan)
+	UserInputService.TouchTapInWorld:Connect(onTouchTapInWorld)
+end
+
+return Module
