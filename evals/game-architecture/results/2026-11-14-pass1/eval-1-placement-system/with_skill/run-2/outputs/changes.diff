+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementSharedService.luau
@@ -0,0 +1,24 @@
+--!strict
+--[[
+	Grid rules for block placement that the server and the client share.
+]]
+
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+const Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+local Module = {}
+Module.__index = Module
+
+-- Parts with this tag can be clicked to place a block against them.
+Module.SurfaceTag = "BlockPlacementSurface"
+
+--[[
+	Returns the center of the cell beside the clicked face, given the point and
+	normal of a raycast hit.
+]]
+function Module:GetCellFromHit(position: Vector3, normal: Vector3): Vector3
+	local blockSize = BlockTypes.BlockSize
+	return Grid.snapToCell(position + normal * (blockSize / 2), blockSize)
+end
+
+return Module
