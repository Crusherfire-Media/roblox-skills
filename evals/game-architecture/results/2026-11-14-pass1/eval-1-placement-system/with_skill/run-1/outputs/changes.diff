+--!strict
+--[[
+	Tells a player with a notification when a spot they picked is too far away.
+]]
+
+const Players = game:GetService("Players")
+
+const NotificationServerService = require(
+	"@game/ServerScriptService/Modules/Systems/Core/NotificationSystem/SystemPackage/NotificationServerService"
+)
+
+const BlockPlacementServerService = require("../SystemPackage/BlockPlacementServerService")
+
+const TOO_FAR_MESSAGE = "That spot is too far away."
+-- Stops a player clicking a far spot repeatedly from stacking up notifications.
+const NOTICE_COOLDOWN_SECONDS = 2
+
+type RejectReason = BlockPlacementServerService.RejectReason
+
+local Module = {}
+
+local lastNoticeTimes: { [Player]: number? } = {}
+
+local function onPlacementRejected(player: Player, reason: RejectReason)
+	if reason ~= "TooFar" then
+		return
+	end
+
+	const now = os.clock()
+	const lastNoticeTime = lastNoticeTimes[player]
+	if lastNoticeTime and now - lastNoticeTime < NOTICE_COOLDOWN_SECONDS then
+		return
+	end
+
+	lastNoticeTimes[player] = now
+	NotificationServerService:Notify(player, TOO_FAR_MESSAGE)
+end
+
+local function onPlayerRemoving(player: Player)
+	lastNoticeTimes[player] = nil
+end
+
+function Module:Init()
+	BlockPlacementServerService:OnPlacementRejected(onPlacementRejected)
+	Players.PlayerRemoving:Connect(onPlayerRemoving)
+end
+
+return Module
