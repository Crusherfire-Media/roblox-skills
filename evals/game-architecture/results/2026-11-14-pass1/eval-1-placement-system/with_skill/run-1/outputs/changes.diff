diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
new file mode 100644
index 0000000..e914e5d
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
@@ -0,0 +1,203 @@
+--!strict
+--[[
+	Places blocks for players, after checking every request a client sends.
+]]
+
+const Players = game:GetService("Players")
+
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+
+const BlockPlacementNetwork = require("./BlockPlacementNetwork")
+const BlockPlacementSharedService = require("./BlockPlacementSharedService")
+
+const MAX_REACH = 64 -- studs, from the character's root to the cell center
+const MAX_REQUESTS_PER_WINDOW = 10
+const RATE_WINDOW_SECONDS = 1
+-- Far past any cell a character can reach; rejects garbage before any math.
+const MAX_COORDINATE = 1e6
+const OVERLAP_MARGIN = 0.05 -- studs
+
+export type RejectReason =
+	"RateLimited"
+	| "UnknownBlockType"
+	| "InvalidPosition"
+	| "BelowFloor"
+	| "NoCharacter"
+	| "TooFar"
+	| "Occupied"
+export type RejectedCallback = (player: Player, reason: RejectReason) -> ()
+
+local Module = {}
+
+local blocksFolder: Folder? = nil
+local occupiedCells: { [Vector3]: BasePart? } = {}
+local requestTimes: { [Player]: { number }? } = {}
+local rejectedCallbacks: { RejectedCallback } = {}
+const overlapParams = OverlapParams.new()
+
+local function reject(player: Player, reason: RejectReason)
+	for _, callback in rejectedCallbacks do
+		callback(player, reason)
+	end
+end
+
+--[[
+	Records a request and returns whether the player is still within the rate
+	limit. Every request counts, valid or not, so spam can't buy free checks.
+]]
+local function consumeRateBudget(player: Player): boolean
+	local times = requestTimes[player]
+	if not times then
+		times = {}
+		requestTimes[player] = times
+	end
+
+	const now = os.clock()
+	while times[1] and now - times[1] >= RATE_WINDOW_SECONDS do
+		table.remove(times, 1)
+	end
+
+	if #times >= MAX_REQUESTS_PER_WINDOW then
+		return false
+	end
+
+	table.insert(times, now)
+	return true
+end
+
+local function isSaneCoordinate(value: number): boolean
+	-- NaN fails every comparison, so it fails this one too.
+	return math.abs(value) <= MAX_COORDINATE
+end
+
+local function isSanePosition(position: Vector3): boolean
+	return isSaneCoordinate(position.X)
+		and isSaneCoordinate(position.Y)
+		and isSaneCoordinate(position.Z)
+end
+
+local function getRootPosition(player: Player): Vector3?
+	const character = player.Character
+	if not character then
+		return nil
+	end
+
+	const rootPart = character:FindFirstChild("HumanoidRootPart")
+	if not rootPart or not rootPart:IsA("BasePart") then
+		return nil
+	end
+
+	return rootPart.Position
+end
+
+--[[
+	Returns whether any other part, such as a spawn pad or a character, takes
+	up space inside the cell.
+]]
+local function isCellObstructed(cell: Vector3): boolean
+	-- Shrunk so parts that only touch a face, like the floor, don't count.
+	const size = Vector3.one * (BlockTypes.BlockSize - OVERLAP_MARGIN * 2)
+	return #workspace:GetPartBoundsInBox(CFrame.new(cell), size, overlapParams) > 0
+end
+
+local function placeBlock(blockType: BlockTypes.BlockType, cell: Vector3)
+	const block = Instance.new("Part")
+	block.Name = blockType.Name
+	block.Anchored = true
+	block.Size = Vector3.one * BlockTypes.BlockSize
+	block.CFrame = CFrame.new(cell)
+	block.Color = blockType.Color
+	block.Material = blockType.Material
+	block.Transparency = blockType.Transparency
+	block:SetAttribute("BlockType", blockType.Name)
+	block.Parent = blocksFolder
+
+	occupiedCells[cell] = block
+	block.Destroying:Once(function()
+		if occupiedCells[cell] == block then
+			occupiedCells[cell] = nil
+		end
+	end)
+end
+
+local function onPlaceBlockRequested(player: Player, blockTypeName: unknown, position: unknown)
+	if not consumeRateBudget(player) then
+		reject(player, "RateLimited")
+		return
+	end
+
+	if typeof(blockTypeName) ~= "string" then
+		reject(player, "UnknownBlockType")
+		return
+	end
+
+	const blockType: BlockTypes.BlockType? = BlockTypes.ByName[blockTypeName]
+	if not blockType then
+		reject(player, "UnknownBlockType")
+		return
+	end
+
+	if typeof(position) ~= "Vector3" or not isSanePosition(position) then
+		reject(player, "InvalidPosition")
+		return
+	end
+
+	const cell = BlockPlacementSharedService:SnapToCell(position)
+
+	-- With no floor set there is nothing to measure against, so nothing is
+	-- allowed rather than everything.
+	const floorTop = BlockPlacementSharedService:GetFloorTop()
+	if not floorTop or cell.Y - BlockTypes.BlockSize / 2 < floorTop then
+		reject(player, "BelowFloor")
+		return
+	end
+
+	const rootPosition = getRootPosition(player)
+	if not rootPosition then
+		reject(player, "NoCharacter")
+		return
+	end
+
+	if (cell - rootPosition).Magnitude > MAX_REACH then
+		reject(player, "TooFar")
+		return
+	end
+
+	if occupiedCells[cell] or isCellObstructed(cell) then
+		reject(player, "Occupied")
+		return
+	end
+
+	placeBlock(blockType, cell)
+end
+
+local function onPlayerRemoving(player: Player)
+	requestTimes[player] = nil
+end
+
+--[[
+	Calls the callback whenever a placement request is rejected. Returns a
+	function that stops the calls.
+]]
+function Module:OnPlacementRejected(callback: RejectedCallback): () -> ()
+	table.insert(rejectedCallbacks, callback)
+
+	return function()
+		const index = table.find(rejectedCallbacks, callback)
+		if index then
+			table.remove(rejectedCallbacks, index)
+		end
+	end
+end
+
+function Module:Init()
+	const folder = Instance.new("Folder")
+	folder.Name = BlockPlacementSharedService.BlocksFolderName
+	folder.Parent = workspace
+	blocksFolder = folder
+
+	BlockPlacementNetwork.PlaceBlock.OnServerEvent:Connect(onPlaceBlockRequested)
+	Players.PlayerRemoving:Connect(onPlayerRemoving)
+end
+
+return setmetatable(Module, BlockPlacementSharedService)
