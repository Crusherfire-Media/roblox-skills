+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementSharedService.luau
@@ -0,0 +1,56 @@
+--!strict
+--[[
+	Grid and floor rules both realms share.
+]]
+
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+const Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+local Module = {}
+Module.__index = Module
+
+Module.BlocksFolderName = "PlacedBlocks"
+
+-- Outside the module table so the Server and Client services, which inherit
+-- from it, share one value instead of each writing its own field.
+local floorPart: BasePart? = nil
+
+--[[
+	Sets the part blocks stand on. Clicks on it place blocks, and no block may
+	sit below its top surface.
+]]
+function Module:SetFloor(part: BasePart)
+	floorPart = part
+end
+
+function Module:GetFloor(): BasePart?
+	return floorPart
+end
+
+--[[
+	Returns the height of the floor's top surface, or nil before a floor is set.
+]]
+function Module:GetFloorTop(): number?
+	if not floorPart then
+		return nil
+	end
+
+	return floorPart.Position.Y + floorPart.Size.Y / 2
+end
+
+--[[
+	Returns the center of the grid cell that contains the position.
+]]
+function Module:SnapToCell(position: Vector3): Vector3
+	return Grid.snapToCell(position, BlockTypes.BlockSize)
+end
+
+--[[
+	Returns the center of the cell touching a clicked surface, on the side the
+	surface faces.
+]]
+function Module:GetAdjacentCell(hitPosition: Vector3, normal: Vector3): Vector3
+	return Module:SnapToCell(hitPosition + normal * (BlockTypes.BlockSize / 2))
+end
+
+return Module
