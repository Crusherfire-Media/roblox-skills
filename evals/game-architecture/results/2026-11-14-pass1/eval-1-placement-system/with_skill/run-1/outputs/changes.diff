+--!strict
+--[[
+	Makes the baseplate the floor blocks stand on, on both server and client.
+]]
+
+const BlockPlacementSharedService = require("../SystemPackage/BlockPlacementSharedService")
+
+const FLOOR_NAME = "Baseplate"
+
+local Module = {}
+
+function Module:Init()
+	-- A client can start the loader before the baseplate has replicated.
+	task.spawn(function()
+		const floor = workspace:WaitForChild(FLOOR_NAME)
+		if floor:IsA("BasePart") then
+			BlockPlacementSharedService:SetFloor(floor)
+		else
+			warn(`{FLOOR_NAME} is a {floor.ClassName}, not a part; blocks can't be placed`)
+		end
+	end)
+end
+
+return Module
