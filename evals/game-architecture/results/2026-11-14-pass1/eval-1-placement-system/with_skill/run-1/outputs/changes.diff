@@ -0,0 +1,105 @@
+--!strict
+--[[
+	Turns clicks and taps into placement requests, and number keys into the
+	selected block type.
+]]
+
+const UserInputService = game:GetService("UserInputService")
+
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+
+const BlockPlacementNetwork = require("./BlockPlacementNetwork")
+const BlockPlacementSharedService = require("./BlockPlacementSharedService")
+
+-- Well past the server's reach, so a far click still reaches the server and
+-- the player hears that the spot is too far.
+const MAX_CLICK_DISTANCE = 512
+
+local Module = {}
+
+local selectedIndex = 1
+local hotbarKeys: { Enum.KeyCode } = {}
+local raycastParams = RaycastParams.new()
+raycastParams.FilterType = Enum.RaycastFilterType.Include
+
+local function selectBlockType(index: number)
+	if BlockTypes.List[index] then
+		selectedIndex = index
+	end
+end
+
+local function requestPlacementAlong(ray: Ray)
+	const floor = BlockPlacementSharedService:GetFloor()
+	if not floor then
+		return
+	end
+
+	const targets: { Instance } = { floor }
+	const blocksFolder = workspace:FindFirstChild(BlockPlacementSharedService.BlocksFolderName)
+	if blocksFolder then
+		table.insert(targets, blocksFolder)
+	end
+	raycastParams.FilterDescendantsInstances = targets
+
+	const result = workspace:Raycast(ray.Origin, ray.Direction * MAX_CLICK_DISTANCE, raycastParams)
+	if not result then
+		return
+	end
+
+	const cell = BlockPlacementSharedService:GetAdjacentCell(result.Position, result.Normal)
+	BlockPlacementNetwork.PlaceBlock:FireServer(BlockTypes.List[selectedIndex].Name, cell)
+end
+
+local function onInputBegan(input: InputObject, gameProcessedEvent: boolean)
+	if gameProcessedEvent then
+		return
+	end
+
+	if input.UserInputType == Enum.UserInputType.MouseButton1 then
+		const camera = workspace.CurrentCamera
+		const mouseLocation = UserInputService:GetMouseLocation()
+		requestPlacementAlong(camera:ViewportPointToRay(mouseLocation.X, mouseLocation.Y))
+	elseif input.UserInputType == Enum.UserInputType.Keyboard then
+		const index = table.find(hotbarKeys, input.KeyCode)
+		if index then
+			selectBlockType(index)
+		end
+	end
+end
+
+local function onTouchTapInWorld(position: Vector2, processedByUI: boolean)
+	if processedByUI then
+		return
+	end
+
+	-- Tap positions exclude the top bar inset, like InputObject.Position.
+	const camera = workspace.CurrentCamera
+	requestPlacementAlong(camera:ScreenPointToRay(position.X, position.Y))
+end
+
+--[[
+	Selects the block type at the index in the BlockTypes catalog. Indexes
+	outside the catalog are ignored.
+]]
+--[[
+	Sets the keys that select block types: key N selects entry N of the
+	BlockTypes catalog.
+]]
+function Module:SetHotbarKeys(keys: { Enum.KeyCode })
+	hotbarKeys = table.clone(keys)
+end
+
+function Module:SelectBlockType(index: number)
+	selectBlockType(index)
+end
+
+function Module:GetSelectedBlockType(): BlockTypes.BlockType
+	return BlockTypes.List[selectedIndex]
+end
+
+function Module:Init()
+	UserInputService.InputBegan:Connect(onInputBegan)
+	UserInputService.TouchTapInWorld:Connect(onTouchTapInWorld)
+end
+
+return setmetatable(Module, BlockPlacementSharedService)
