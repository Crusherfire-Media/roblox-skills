diff --git a/src/ServerScriptService/Modules/Systems/Building/PlacementSystem/SystemPackage/PlacementServerService.luau b/src/ServerScriptService/Modules/Systems/Building/PlacementSystem/SystemPackage/PlacementServerService.luau
new file mode 100644
index 0000000..ef9196f
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Building/PlacementSystem/SystemPackage/PlacementServerService.luau
@@ -0,0 +1,172 @@
+--[[
+	Places blocks for players. Clients only ask; every request is checked here before a block
+	appears.
+]]
+
+local Players = game:GetService("Players")
+local Workspace = game:GetService("Workspace")
+
+local BlockTypes = require("../../../../Catalogs/BlockTypes")
+local Grid = require("../../../../Utilities/Grid")
+local NotificationServerService =
+	require("../../../Core/NotificationSystem/SystemPackage/NotificationServerService")
+local PlacementNetwork = require("./PlacementNetwork")
+local PlacementRules = require("./PlacementRules")
+
+-- Farthest a cell center may be from the player's character, in studs.
+local MAX_REACH = 64
+local MAX_PLACEMENTS_PER_SECOND = 10
+-- Highest a block may go above the baseplate, in studs.
+local MAX_BUILD_HEIGHT = 1024
+-- At most one "too far" message per player per this many seconds, so a spammed click
+-- doesn't flood the screen.
+local TOO_FAR_NOTIFY_COOLDOWN = 1
+local TOO_FAR_MESSAGE = "That spot is too far away. Move closer to place a block."
+
+local BLOCK_SIZE = BlockTypes.BlockSize
+
+local PlacementServerService = {}
+
+local blocksFolder: Folder
+local worldBounds: PlacementRules.WorldBounds
+-- Cell key -> the block filling that cell.
+local occupiedCells: { [string]: BasePart } = {}
+local requestHistories: { [Player]: { number } } = {}
+local tooFarNotifyHistories: { [Player]: { number } } = {}
+
+local function getWorldBounds(baseplate: BasePart): PlacementRules.WorldBounds
+	local center = baseplate.Position
+	local halfSize = baseplate.Size / 2
+	local floorY = center.Y + halfSize.Y
+	return table.freeze({
+		MinX = center.X - halfSize.X,
+		MaxX = center.X + halfSize.X,
+		MinZ = center.Z - halfSize.Z,
+		MaxZ = center.Z + halfSize.Z,
+		FloorY = floorY,
+		MaxY = floorY + MAX_BUILD_HEIGHT,
+	})
+end
+
+local function getHistory(histories: { [Player]: { number } }, player: Player): { number }
+	local history = histories[player]
+	if not history then
+		history = {}
+		histories[player] = history
+	end
+	return history
+end
+
+local function getRootPart(player: Player): BasePart?
+	local character = player.Character
+	if not character then
+		return nil
+	end
+	local rootPart = character:FindFirstChild("HumanoidRootPart")
+	if rootPart and rootPart:IsA("BasePart") then
+		return rootPart
+	end
+	return nil
+end
+
+local function notifyTooFar(player: Player)
+	local history = getHistory(tooFarNotifyHistories, player)
+	if PlacementRules.tryRecordRequest(history, os.clock(), 1, TOO_FAR_NOTIFY_COOLDOWN) then
+		NotificationServerService:Notify(player, TOO_FAR_MESSAGE)
+	end
+end
+
+local function createBlock(
+	blockType: BlockTypes.BlockType,
+	cellCenter: Vector3,
+	cellKey: string,
+	player: Player
+)
+	local block = Instance.new("Part")
+	block.Name = blockType.Name
+	block.Anchored = true
+	block.Size = Vector3.one * BLOCK_SIZE
+	block.CFrame = CFrame.new(cellCenter)
+	block.Color = blockType.Color
+	block.Material = blockType.Material
+	block.Transparency = blockType.Transparency
+	block.TopSurface = Enum.SurfaceType.Smooth
+	block.BottomSurface = Enum.SurfaceType.Smooth
+	block:SetAttribute("BlockType", blockType.Name)
+	block:SetAttribute("PlacedByUserId", player.UserId)
+
+	occupiedCells[cellKey] = block
+	-- Free the cell if anything removes the block later.
+	block.Destroying:Once(function()
+		if occupiedCells[cellKey] == block then
+			occupiedCells[cellKey] = nil
+		end
+	end)
+	block.Parent = blocksFolder
+end
+
+local function onPlaceBlockRequested(player: Player, blockTypeName: unknown, position: unknown)
+	-- Every request counts toward the limit, valid or not, so spam stays cheap to reject.
+	local history = getHistory(requestHistories, player)
+	if not PlacementRules.tryRecordRequest(history, os.clock(), MAX_PLACEMENTS_PER_SECOND, 1) then
+		return
+	end
+
+	if typeof(blockTypeName) ~= "string" then
+		return
+	end
+	local blockType = BlockTypes.ByName[blockTypeName]
+	if not blockType then
+		return
+	end
+
+	if not PlacementRules.isSanePosition(position, worldBounds) then
+		return
+	end
+	-- Never trust the client's cell math; snap to the cell the position falls in.
+	local cellCenter = Grid.snapToCell(position :: Vector3, BLOCK_SIZE)
+	if not PlacementRules.isAboveFloor(cellCenter, BLOCK_SIZE, worldBounds.FloorY) then
+		return
+	end
+
+	local rootPart = getRootPart(player)
+	if not rootPart then
+		return
+	end
+	if not PlacementRules.isWithinReach(rootPart.Position, cellCenter, MAX_REACH) then
+		notifyTooFar(player)
+		return
+	end
+
+	local cellKey = PlacementRules.getCellKey(cellCenter, BLOCK_SIZE)
+	if occupiedCells[cellKey] then
+		return
+	end
+
+	createBlock(blockType, cellCenter, cellKey, player)
+end
+
+function PlacementServerService:Init()
+	local baseplate = Workspace:FindFirstChild("Baseplate")
+	assert(
+		baseplate and baseplate:IsA("BasePart"),
+		"PlacementServerService needs Workspace.Baseplate"
+	)
+	worldBounds = getWorldBounds(baseplate)
+
+	local folder = Instance.new("Folder")
+	folder.Name = PlacementNetwork.BlocksFolderName
+	folder.Parent = Workspace
+	blocksFolder = folder
+end
+
+function PlacementServerService:Start()
+	PlacementNetwork.PlaceBlock.OnServerEvent:Connect(onPlaceBlockRequested)
+
+	Players.PlayerRemoving:Connect(function(player)
+		requestHistories[player] = nil
+		tooFarNotifyHistories[player] = nil
+	end)
+end
+
+return PlacementServerService
