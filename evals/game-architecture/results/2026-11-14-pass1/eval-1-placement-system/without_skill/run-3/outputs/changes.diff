+--[[
+	Remotes and shared names for block placement. Each remote is a child of this module, so it
+	reaches clients together with the module.
+]]
+
+local PlacementNetwork = {
+	-- Client to server: (blockTypeName: string, cellCenter: Vector3)
+	PlaceBlock = script:WaitForChild("PlaceBlock") :: RemoteEvent,
+
+	-- Name of the Workspace folder that holds every placed block.
+	BlocksFolderName = "Blocks",
+}
+
+return table.freeze(PlacementNetwork)
diff --git a/src/ServerScriptService/Modules/Systems/Building/PlacementSystem/SystemPackage/PlacementRules.luau b/src/ServerScriptService/Modules/Systems/Building/PlacementSystem/SystemPackage/PlacementRules.luau
new file mode 100644
index 0000000..02d9c26
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Building/PlacementSystem/SystemPackage/PlacementRules.luau
@@ -0,0 +1,100 @@
+--[[
+	The checks the server runs on placement requests. Plain functions with no side effects, so specs
+	can cover them without a running game.
+]]
+
+-- The area blocks may be placed in. Cell centers outside it are rejected.
+export type WorldBounds = {
+	MinX: number,
+	MaxX: number,
+	MinZ: number,
+	MaxZ: number,
+	-- Top of the baseplate. No part of a block may sit below it.
+	FloorY: number,
+	-- Highest allowed cell center.
+	MaxY: number,
+}
+
+-- Slack for floating point error when comparing positions, in studs.
+local EPSILON = 1e-3
+
+local PlacementRules = {}
+
+local function isFiniteNumber(value: number): boolean
+	-- NaN is the only value not equal to itself.
+	return value == value and value > -math.huge and value < math.huge
+end
+
+--[[
+	Whether the value is a Vector3 with finite components inside the world bounds. Use it on
+	anything a client sends before treating it as a position.
+]]
+function PlacementRules.isSanePosition(value: unknown, bounds: WorldBounds): boolean
+	if typeof(value) ~= "Vector3" then
+		return false
+	end
+	local position = value :: Vector3
+	if
+		not isFiniteNumber(position.X)
+		or not isFiniteNumber(position.Y)
+		or not isFiniteNumber(position.Z)
+	then
+		return false
+	end
+	return position.X >= bounds.MinX
+		and position.X <= bounds.MaxX
+		and position.Z >= bounds.MinZ
+		and position.Z <= bounds.MaxZ
+		and position.Y <= bounds.MaxY
+end
+
+--[[
+	Whether a block centered on the cell would sit entirely on or above the floor.
+]]
+function PlacementRules.isAboveFloor(cellCenter: Vector3, cellSize: number, floorY: number): boolean
+	return cellCenter.Y - cellSize / 2 >= floorY - EPSILON
+end
+
+function PlacementRules.isWithinReach(
+	origin: Vector3,
+	cellCenter: Vector3,
+	maxDistance: number
+): boolean
+	return (cellCenter - origin).Magnitude <= maxDistance
+end
+
+--[[
+	A string that names the cell containing the position, for keying occupancy maps.
+]]
+function PlacementRules.getCellKey(position: Vector3, cellSize: number): string
+	return string.format(
+		"%d,%d,%d",
+		math.floor(position.X / cellSize),
+		math.floor(position.Y / cellSize),
+		math.floor(position.Z / cellSize)
+	)
+end
+
+--[[
+	Sliding-window rate limit. <code>history</code> holds the times of recent allowed requests and
+	is updated in place. Returns true and records <code>now</code> when fewer than
+	<code>limit</code> requests were allowed in the last <code>window</code> seconds; otherwise
+	returns false and records nothing.
+]]
+function PlacementRules.tryRecordRequest(
+	history: { number },
+	now: number,
+	limit: number,
+	window: number
+): boolean
+	if #history >= limit and now - history[#history - limit + 1] < window then
+		return false
+	end
+	table.insert(history, now)
+	while #history > limit do
+		table.remove(history, 1)
+	end
+	return true
+end
+
+return table.freeze(PlacementRules)
