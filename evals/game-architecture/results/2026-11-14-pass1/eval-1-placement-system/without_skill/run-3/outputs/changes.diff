diff --git a/src/ServerScriptService/Tests/Specs/PlacementRules.spec.luau b/src/ServerScriptService/Tests/Specs/PlacementRules.spec.luau
new file mode 100644
index 0000000..4f590aa
--- /dev/null
+++ b/src/ServerScriptService/Tests/Specs/PlacementRules.spec.luau
@@ -0,0 +1,101 @@
+local JestGlobals = require("@game/ServerScriptService/Tests/Packages/JestGlobals")
+local PlacementRules =
+	require("../../Modules/Systems/Building/PlacementSystem/SystemPackage/PlacementRules")
+
+local describe = JestGlobals.describe
+local expect = JestGlobals.expect
+local it = JestGlobals.it
+
+local BOUNDS: PlacementRules.WorldBounds = {
+	MinX = -1024,
+	MaxX = 1024,
+	MinZ = -1024,
+	MaxZ = 1024,
+	FloorY = 0,
+	MaxY = 1024,
+}
+
+describe("isSanePosition", function()
+	it("accepts a finite position inside the bounds", function()
+		expect(PlacementRules.isSanePosition(Vector3.new(2, 2, 2), BOUNDS)).toBe(true)
+	end)
+
+	it("rejects values that aren't Vector3s", function()
+		expect(PlacementRules.isSanePosition(nil, BOUNDS)).toBe(false)
+		expect(PlacementRules.isSanePosition("2,2,2", BOUNDS)).toBe(false)
+		expect(PlacementRules.isSanePosition({ X = 2, Y = 2, Z = 2 }, BOUNDS)).toBe(false)
+		expect(PlacementRules.isSanePosition(CFrame.new(2, 2, 2), BOUNDS)).toBe(false)
+	end)
+
+	it("rejects NaN and infinite components", function()
+		expect(PlacementRules.isSanePosition(Vector3.new(0 / 0, 2, 2), BOUNDS)).toBe(false)
+		expect(PlacementRules.isSanePosition(Vector3.new(2, math.huge, 2), BOUNDS)).toBe(false)
+		expect(PlacementRules.isSanePosition(Vector3.new(2, 2, -math.huge), BOUNDS)).toBe(false)
+	end)
+
+	it("rejects positions outside the bounds", function()
+		expect(PlacementRules.isSanePosition(Vector3.new(2000, 2, 2), BOUNDS)).toBe(false)
+		expect(PlacementRules.isSanePosition(Vector3.new(2, 2, -2000), BOUNDS)).toBe(false)
+		expect(PlacementRules.isSanePosition(Vector3.new(2, 5000, 2), BOUNDS)).toBe(false)
+	end)
+end)
+
+describe("isAboveFloor", function()
+	it("accepts a cell resting on the floor", function()
+		expect(PlacementRules.isAboveFloor(Vector3.new(2, 2, 2), 4, 0)).toBe(true)
+	end)
+
+	it("rejects a cell that dips below the floor", function()
+		expect(PlacementRules.isAboveFloor(Vector3.new(2, -2, 2), 4, 0)).toBe(false)
+	end)
+end)
+
+describe("isWithinReach", function()
+	it("accepts exactly the maximum distance", function()
+		expect(PlacementRules.isWithinReach(Vector3.zero, Vector3.new(64, 0, 0), 64)).toBe(true)
+	end)
+
+	it("rejects anything farther", function()
+		expect(PlacementRules.isWithinReach(Vector3.zero, Vector3.new(64.1, 0, 0), 64)).toBe(false)
+	end)
+end)
+
+describe("getCellKey", function()
+	it("gives every point in a cell the same key", function()
+		local key = PlacementRules.getCellKey(Vector3.new(2, 2, 2), 4)
+		expect(PlacementRules.getCellKey(Vector3.new(0.1, 3.9, 1), 4)).toBe(key)
+	end)
+
+	it("gives neighboring cells different keys, including across the origin", function()
+		expect(PlacementRules.getCellKey(Vector3.new(-2, 2, 2), 4)).never.toBe(
+			PlacementRules.getCellKey(Vector3.new(2, 2, 2), 4)
+		)
+	end)
+end)
+
+describe("tryRecordRequest", function()
+	it("allows up to the limit within the window, then refuses", function()
+		local history = {}
+		for i = 1, 10 do
+			expect(PlacementRules.tryRecordRequest(history, i * 0.01, 10, 1)).toBe(true)
+		end
+		expect(PlacementRules.tryRecordRequest(history, 0.5, 10, 1)).toBe(false)
+	end)
+
+	it("allows again once the oldest request leaves the window", function()
+		local history = {}
+		PlacementRules.tryRecordRequest(history, 0, 2, 1)
+		PlacementRules.tryRecordRequest(history, 0.5, 2, 1)
+		expect(PlacementRules.tryRecordRequest(history, 0.9, 2, 1)).toBe(false)
+		-- The request at 0 has left the window; the one at 0.5 has not.
+		expect(PlacementRules.tryRecordRequest(history, 1.1, 2, 1)).toBe(true)
+		expect(PlacementRules.tryRecordRequest(history, 1.2, 2, 1)).toBe(false)
+	end)
+
+	it("does not record refused requests", function()
+		local history = {}
