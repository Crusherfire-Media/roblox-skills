diff --git a/src/ServerScriptService/Modules/Systems/Building/PlacementSystem/SystemPackage/PlacementClientService.luau b/src/ServerScriptService/Modules/Systems/Building/PlacementSystem/SystemPackage/PlacementClientService.luau
new file mode 100644
index 0000000..3b206aa
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Building/PlacementSystem/SystemPackage/PlacementClientService.luau
@@ -0,0 +1,152 @@
+--[[
+	Block placement input for the local player. Number keys 1 to 5 pick the block type, in the
+	order of the BlockTypes catalog. A click, or a tap on a phone, on the baseplate or a block asks
+	the server to place the selected type in the cell next to that spot. The server decides
+	whether it happens.
+]]
+
+local UserInputService = game:GetService("UserInputService")
+local Workspace = game:GetService("Workspace")
+
+local BlockTypes = require("../../../../Catalogs/BlockTypes")
+local Grid = require("../../../../Utilities/Grid")
+local PlacementNetwork = require("./PlacementNetwork")
+
+-- How far the click ray reaches, in studs. Longer than the server's reach on purpose, so the
+-- server can tell the player when a spot is too far away.
+local RAY_LENGTH = 1024
+-- A touch counts as a tap, not a camera drag, when it is this short and moves this little.
+local TAP_MAX_SECONDS = 0.3
+local TAP_MAX_MOVEMENT = 10
+
+local HOTBAR_KEYS: { Enum.KeyCode } = {
+	Enum.KeyCode.One,
+	Enum.KeyCode.Two,
+	Enum.KeyCode.Three,
+	Enum.KeyCode.Four,
+	Enum.KeyCode.Five,
+}
+
+local BLOCK_SIZE = BlockTypes.BlockSize
+
+type TouchStart = {
+	Time: number,
+	Position: Vector2,
+}
+
+local PlacementClientService = {}
+
+local selectedIndex = 1
+local touchStarts: { [InputObject]: TouchStart } = {}
+local raycastParams = RaycastParams.new()
+raycastParams.FilterType = Enum.RaycastFilterType.Include
+
+--[[
+	Rounds a surface normal to the nearest world axis. Blocks are never rotated, so their face
+	normals already are axes; this only removes floating point noise.
+]]
+local function toAxis(normal: Vector3): Vector3
+	local x, y, z = math.abs(normal.X), math.abs(normal.Y), math.abs(normal.Z)
+	if x >= y and x >= z then
+		return Vector3.new(math.sign(normal.X), 0, 0)
+	elseif y >= z then
+		return Vector3.new(0, math.sign(normal.Y), 0)
+	end
+	return Vector3.new(0, 0, math.sign(normal.Z))
+end
+
+--[[
+	The center of the cell next to the baseplate or block under the screen position, or nil when
+	the position isn't over either.
+]]
+local function getTargetCell(screenPosition: Vector2): Vector3?
+	local camera = Workspace.CurrentCamera
+	if not camera then
+		return nil
+	end
+
+	local blocksFolder = Workspace:FindFirstChild(PlacementNetwork.BlocksFolderName)
+	local filter: { Instance } = {}
+	local baseplate = Workspace:FindFirstChild("Baseplate")
+	if baseplate then
+		table.insert(filter, baseplate)
+	end
+	if blocksFolder then
+		table.insert(filter, blocksFolder)
+	end
+	if #filter == 0 then
+		return nil
+	end
+	raycastParams.FilterDescendantsInstances = filter
+
+	local ray = camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
+	local result = Workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, raycastParams)
+	if not result then
+		return nil
+	end
+
+	local hit = result.Instance
+	if blocksFolder and hit:IsDescendantOf(blocksFolder) then
+		-- Step one whole cell out of the face that was clicked.
+		return Grid.snapToCell(hit.Position + toAxis(result.Normal) * BLOCK_SIZE, BLOCK_SIZE)
+	end
+	-- Step half a cell off the surface so the point lands inside the neighboring cell.
+	return Grid.snapToCell(result.Position + result.Normal * (BLOCK_SIZE / 2), BLOCK_SIZE)
+end
+
+local function requestPlacement(screenPosition: Vector2)
+	local blockType = BlockTypes.List[selectedIndex]
+	if not blockType then
+		return
+	end
+	local cellCenter = getTargetCell(screenPosition)
+	if not cellCenter then
+		return
+	end
+	PlacementNetwork.PlaceBlock:FireServer(blockType.Name, cellCenter)
+end
+
+local function onInputBegan(input: InputObject, gameProcessed: boolean)
+	if gameProcessed then
+		return
+	end
+
+	if input.UserInputType == Enum.UserInputType.Keyboard then
+		local index = table.find(HOTBAR_KEYS, input.KeyCode)
+		if index and BlockTypes.List[index] then
+			selectedIndex = index
+		end
+	elseif input.UserInputType == Enum.UserInputType.MouseButton1 then
+		requestPlacement(Vector2.new(input.Position.X, input.Position.Y))
+	elseif input.UserInputType == Enum.UserInputType.Touch then
+		touchStarts[input] = {
+			Time = os.clock(),
+			Position = Vector2.new(input.Position.X, input.Position.Y),
+		}
+	end
+end
+
+local function onInputEnded(input: InputObject)
+	if input.UserInputType ~= Enum.UserInputType.Touch then
+		return
+	end
+	local touchStart = touchStarts[input]
+	if not touchStart then
+		return
+	end
+	touchStarts[input] = nil
+
+	local position = Vector2.new(input.Position.X, input.Position.Y)
+	local isTap = os.clock() - touchStart.Time <= TAP_MAX_SECONDS
+		and (position - touchStart.Position).Magnitude <= TAP_MAX_MOVEMENT
+	if isTap then
+		requestPlacement(position)
+	end
+end
+
+function PlacementClientService:Start()
+	UserInputService.InputBegan:Connect(onInputBegan)
+	UserInputService.InputEnded:Connect(onInputEnded)
+end
+
+return PlacementClientService
