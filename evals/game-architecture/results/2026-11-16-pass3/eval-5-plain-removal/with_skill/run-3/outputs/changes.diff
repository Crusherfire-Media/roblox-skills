 	end
 
-	lastPlacedAt[player] = now
+	lastActionAt[player] = now
 	occupied[cell] = true
 
 	local part = Instance.new("Part")
@@ -78,11 +96,43 @@ local function onPlaceBlock(player: Player, blockTypeName: unknown, position: un
 	part.Color = blockType.Color
 	part.Material = blockType.Material
 	part.Transparency = blockType.Transparency
+	-- Lets clients skip asking to remove blocks they don't own; the server still checks.
+	part:SetAttribute("OwnerUserId", player.UserId)
 	part.Parent = blocksFolder
+
+	placedBlocks[part] = {
+		Cell = cell,
+		OwnerUserId = player.UserId,
+	}
+end
+
+local function onRemoveBlock(player: Player, block: unknown)
+	if typeof(block) ~= "Instance" then
+		return
+	end
+
+	local placedBlock = placedBlocks[block]
+	if not placedBlock or placedBlock.OwnerUserId ~= player.UserId then
+		return
+	end
+
+	local now = os.clock()
+	if isRateLimited(player, now) then
+		return
+	end
+	if not isInReach(player, placedBlock.Cell) then
+		return
+	end
+
+	lastActionAt[player] = now
+	placedBlocks[block] = nil
+	occupied[placedBlock.Cell] = nil
+	block:Destroy()
 end
 
