+local function waitForRemote(name: string): RemoteEvent
+	local remote = ReplicatedStorage:WaitForChild(name)
+	if not remote:IsA("RemoteEvent") then
+		error(`{name} must be a RemoteEvent`)
+	end
+	return remote
+end
