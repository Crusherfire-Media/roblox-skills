+local function onTouchLongPress(
+	touchPositions: { Vector2 },
+	state: Enum.UserInputState,
+	gameProcessedEvent: boolean
+)
+	if state == Enum.UserInputState.Begin then
+		longPressStart = if gameProcessedEvent or #touchPositions ~= 1
+			then nil
+			else touchPositions[1]
+		return
+	end
+	if state ~= Enum.UserInputState.End and state ~= Enum.UserInputState.Cancel then
+		return
+	end
+
+	local start = longPressStart
+	longPressStart = nil
+	if not start or state == Enum.UserInputState.Cancel or #touchPositions ~= 1 then
+		return
+	end
+	if (touchPositions[1] - start).Magnitude <= MAX_REMOVE_DRAG then
+		removeAt(start)
+	end
+end
