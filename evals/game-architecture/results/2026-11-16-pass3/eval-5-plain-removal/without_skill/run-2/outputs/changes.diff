+	blocks[part] = { OwnerUserId = player.UserId, Cell = cell }
+	-- Free the cell however the block goes away, not only through RemoveBlock.
+	part.Destroying:Connect(function()
+		local record = blocks[part]
+		if record then
+			blocks[part] = nil
+			occupied[record.Cell] = nil
+		end
+	end)
+
 	part.Parent = blocksFolder
 end
 
+local function onRemoveBlock(player: Player, block: unknown)
+	if typeof(block) ~= "Instance" then
+		return
+	end
+
+	-- Only blocks this script placed have a record, so anything else is refused here.
+	local record = blocks[block]
+	if not record or record.OwnerUserId ~= player.UserId then
+		return
+	end
+
+	local now = os.clock()
+	if isRateLimited(player, now) then
+		return
+	end
+
+	local rootPart = getRootPart(player)
+	if not rootPart then
+		return
+	end
+	if (record.Cell - rootPart.Position).Magnitude > MAX_REACH then
+		return
+	end
+
+	lastActionAt[player] = now
+	blocks[block] = nil
+	occupied[record.Cell] = nil
+	block:Destroy()
+end
