@@ -0,0 +1,129 @@
+--[[
+	The checks a placement request must pass. Pure functions with no instances or services, so the
+	server service feeds in everything they need and specs can call them directly.
+]]
+
+local BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+local Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+export type RejectReason =
+	"RateLimited"
+	| "UnknownBlockType"
+	| "InvalidPosition"
+	| "BelowBaseplate"
+	| "Occupied"
+	| "NoCharacter"
+	| "TooFar"
+
+export type Request = {
+	blockTypeName: unknown,
+	position: unknown,
+	-- Where the player's character is, or nil when it has none.
+	characterPosition: Vector3?,
+	-- Y of the baseplate's top face. Blocks may not reach below it.
+	floorY: number,
+	isOccupied: (cellKey: string) -> boolean,
+	-- Times of the player's recent accepted placements, from os.clock().
+	recentPlacements: { number },
+	now: number,
+}
+
+export type Accepted = {
+	blockType: BlockTypes.BlockType,
+	cell: Vector3,
+	cellKey: string,
+}
+
+local MAX_DISTANCE = 64
+local MAX_PLACEMENTS_PER_WINDOW = 10
+local RATE_WINDOW_SECONDS = 1
+
+local PlacementRules = {
+	MaxDistance = MAX_DISTANCE,
+	MaxPlacementsPerWindow = MAX_PLACEMENTS_PER_WINDOW,
+	RateWindowSeconds = RATE_WINDOW_SECONDS,
+}
+
+local function isFiniteNumber(value: number): boolean
+	-- NaN is the only value not equal to itself, and it slips past every < and > check.
+	return value == value and math.abs(value) ~= math.huge
+end
+
+--[[
+	Returns the key that names a grid cell, from the cell's center.
+]]
+function PlacementRules.cellKey(cell: Vector3): string
+	local size = BlockTypes.BlockSize
+	return `{math.floor(cell.X / size)},{math.floor(cell.Y / size)},{math.floor(cell.Z / size)}`
+end
+
+--[[
+	Drops placement times older than the rate window, in place.
+]]
+function PlacementRules.pruneRecent(recentPlacements: { number }, now: number)
+	local cutoff = now - RATE_WINDOW_SECONDS
+	local kept = 0
+	for _, time in recentPlacements do
+		if time > cutoff then
+			kept += 1
+			recentPlacements[kept] = time
+		end
+	end
+	for index = #recentPlacements, kept + 1, -1 do
+		recentPlacements[index] = nil
+	end
+end
+
+--[[
+	Checks a request. Returns what to place when it passes, or why it failed.
+]]
+function PlacementRules.check(request: Request): (Accepted?, RejectReason?)
+	PlacementRules.pruneRecent(request.recentPlacements, request.now)
+	if #request.recentPlacements >= MAX_PLACEMENTS_PER_WINDOW then
+		return nil, "RateLimited"
+	end
+
+	local blockTypeName = request.blockTypeName
+	if typeof(blockTypeName) ~= "string" then
+		return nil, "UnknownBlockType"
+	end
+	local blockType = BlockTypes.ByName[blockTypeName]
+	if not blockType then
+		return nil, "UnknownBlockType"
+	end
+
+	local position = request.position
+	if typeof(position) ~= "Vector3" then
+		return nil, "InvalidPosition"
+	end
+	if
+		not isFiniteNumber(position.X)
+		or not isFiniteNumber(position.Y)
+		or not isFiniteNumber(position.Z)
+	then
+		return nil, "InvalidPosition"
+	end
+
+	-- The client sends a cell center, but trust only the cell the position falls in.
+	local cell = Grid.snapToCell(position, BlockTypes.BlockSize)
+	if cell.Y - BlockTypes.BlockSize / 2 < request.floorY then
+		return nil, "BelowBaseplate"
+	end
+
+	local cellKey = PlacementRules.cellKey(cell)
+	if request.isOccupied(cellKey) then
+		return nil, "Occupied"
+	end
+
+	local characterPosition = request.characterPosition
+	if not characterPosition then
+		return nil, "NoCharacter"
+	end
+	if (cell - characterPosition).Magnitude > MAX_DISTANCE then
+		return nil, "TooFar"
+	end
+
+	return { blockType = blockType, cell = cell, cellKey = cellKey }, nil
+end
+
+return table.freeze(PlacementRules)
