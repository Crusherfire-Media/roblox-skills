+--[[
+	Remotes for block placement. Each remote is a child of this module, so it reaches clients
+	together with the module.
+]]
+
+local PlacementNetwork = {
+	-- Client to server: (blockTypeName: string, cellCenter: Vector3)
+	PlaceBlock = script:WaitForChild("PlaceBlock") :: RemoteEvent,
+}
+
+return table.freeze(PlacementNetwork)
diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/SystemPackage/PlacementServerService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/SystemPackage/PlacementServerService.luau
