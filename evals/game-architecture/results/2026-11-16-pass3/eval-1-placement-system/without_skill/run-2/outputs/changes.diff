@@ -0,0 +1,107 @@
+--[[
+	Turns clicks and taps into placement requests. Number keys pick the block type, in catalog
+	order. The server decides whether each block is placed.
+]]
+
+local Players = game:GetService("Players")
+local UserInputService = game:GetService("UserInputService")
+local Workspace = game:GetService("Workspace")
+
+local BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+local Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+local PlacementNetwork = require("./PlacementNetwork")
+
+-- How far the click ray reaches. The server limits the real placement distance.
+local RAY_LENGTH = 1000
+
+local NUMBER_KEYS: { Enum.KeyCode } = {
+	Enum.KeyCode.One,
+	Enum.KeyCode.Two,
+	Enum.KeyCode.Three,
+	Enum.KeyCode.Four,
+	Enum.KeyCode.Five,
+	Enum.KeyCode.Six,
+	Enum.KeyCode.Seven,
+	Enum.KeyCode.Eight,
+	Enum.KeyCode.Nine,
+}
+
+local localPlayer = Players.LocalPlayer
+
+local PlacementClientService = {}
+
+local selectedIndex = 1
+
+--[[
+	Returns the block type that clicks place.
+]]
+function PlacementClientService:GetSelectedBlockType(): BlockTypes.BlockType
+	return BlockTypes.List[selectedIndex]
+end
+
+--[[
+	Selects a block type by its position in the catalog. Out-of-range indexes are ignored.
+]]
+function PlacementClientService:SelectIndex(index: number)
+	if BlockTypes.List[index] then
+		selectedIndex = index
+	end
+end
+
+local function isPlaceableSurface(instance: Instance): boolean
+	return instance == Workspace:FindFirstChild("Baseplate")
+		or instance:GetAttribute("BlockType") ~= nil
+end
+
+local function requestPlacementAt(viewportPosition: Vector2)
+	local camera = Workspace.CurrentCamera
+	if not camera then
+		return
+	end
+
+	local ray = camera:ViewportPointToRay(viewportPosition.X, viewportPosition.Y)
+	local params = RaycastParams.new()
+	params.FilterType = Enum.RaycastFilterType.Exclude
+	params.FilterDescendantsInstances = if localPlayer.Character
+		then { localPlayer.Character }
+		else {}
+
+	local result = Workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, params)
+	if not result or not isPlaceableSurface(result.Instance) then
+		return
+	end
+
+	-- Step half a block out of the clicked face, into the neighboring cell.
+	local inside = result.Position + result.Normal * (BlockTypes.BlockSize / 2)
+	local cell = Grid.snapToCell(inside, BlockTypes.BlockSize)
+	PlacementNetwork.PlaceBlock:FireServer(PlacementClientService:GetSelectedBlockType().Name, cell)
+end
+
+local function onInputBegan(input: InputObject, gameProcessedEvent: boolean)
+	if gameProcessedEvent then
+		return
+	end
+
+	if input.UserInputType == Enum.UserInputType.MouseButton1 then
+		requestPlacementAt(UserInputService:GetMouseLocation())
+	elseif input.UserInputType == Enum.UserInputType.Keyboard then
+		local index = table.find(NUMBER_KEYS, input.KeyCode)
+		if index then
+			PlacementClientService:SelectIndex(index)
+		end
+	end
+end
+
+local function onTouchTapInWorld(position: Vector2, processedByUI: boolean)
+	if processedByUI then
+		return
+	end
+	requestPlacementAt(position)
+end
+
+function PlacementClientService:Init()
+	UserInputService.InputBegan:Connect(onInputBegan)
+	UserInputService.TouchTapInWorld:Connect(onTouchTapInWorld)
+end
+
+return PlacementClientService
