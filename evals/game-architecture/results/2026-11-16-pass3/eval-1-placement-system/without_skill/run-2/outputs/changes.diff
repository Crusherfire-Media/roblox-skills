+++ b/src/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/SystemPackage/PlacementServerService.luau
@@ -0,0 +1,125 @@
+--[[
+	Places blocks for players. Clients only ask; every request is checked here by PlacementRules
+	before a block appears.
+]]
+
+local Players = game:GetService("Players")
+local Workspace = game:GetService("Workspace")
+
+local BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+local NotificationServerService = require(
+	"@game/ServerScriptService/Modules/Systems/Core/NotificationSystem/SystemPackage/NotificationServerService"
+)
+local PlacementRules = require("../Implementation/PlacementRules")
+local PlacementNetwork = require("./PlacementNetwork")
+
+local BLOCKS_FOLDER_NAME = "PlacedBlocks"
+-- Shortest gap between two "too far" notices to one player, so spam clicks don't stack them.
+local TOO_FAR_NOTICE_COOLDOWN = 1
+local TOO_FAR_MESSAGE = `You can only place blocks within {PlacementRules.MaxDistance} studs.`
+
+type PlayerState = {
+	recentPlacements: { number },
+	lastTooFarNotice: number,
+}
+
+local PlacementServerService = {}
+
+local blocksFolder: Folder
+local floorY = 0
+-- Placed blocks by cell key.
+local blocksByCell: { [string]: BasePart } = {}
+local playerStates: { [Player]: PlayerState } = {}
+
+local function getPlayerState(player: Player): PlayerState
+	local state = playerStates[player]
+	if not state then
+		state = { recentPlacements = {}, lastTooFarNotice = -math.huge }
+		playerStates[player] = state
+	end
+	return state
+end
+
+local function getCharacterPosition(player: Player): Vector3?
+	local character = player.Character
+	if not character then
+		return nil
+	end
+	local rootPart = character:FindFirstChild("HumanoidRootPart")
+	if rootPart and rootPart:IsA("BasePart") then
+		return rootPart.Position
+	end
+	return nil
+end
+
+local function isOccupied(cellKey: string): boolean
+	return blocksByCell[cellKey] ~= nil
+end
+
+local function createBlock(blockType: BlockTypes.BlockType, cell: Vector3, cellKey: string)
+	local block = Instance.new("Part")
+	block.Name = blockType.Name
+	block.Anchored = true
+	block.Size = Vector3.one * BlockTypes.BlockSize
+	block.CFrame = CFrame.new(cell)
+	block.Color = blockType.Color
+	block.Material = blockType.Material
+	block.Transparency = blockType.Transparency
+	block.TopSurface = Enum.SurfaceType.Smooth
+	block.BottomSurface = Enum.SurfaceType.Smooth
+	block:SetAttribute("BlockType", blockType.Name)
+
+	blocksByCell[cellKey] = block
+	block.Destroying:Connect(function()
+		if blocksByCell[cellKey] == block then
+			blocksByCell[cellKey] = nil
+		end
+	end)
+	block.Parent = blocksFolder
+end
+
+local function onPlaceBlock(player: Player, blockTypeName: unknown, position: unknown)
+	local state = getPlayerState(player)
+	local now = os.clock()
+	local accepted, reason = PlacementRules.check({
+		blockTypeName = blockTypeName,
+		position = position,
+		characterPosition = getCharacterPosition(player),
+		floorY = floorY,
+		isOccupied = isOccupied,
+		recentPlacements = state.recentPlacements,
+		now = now,
+	})
+
+	if not accepted then
+		if reason == "TooFar" and now - state.lastTooFarNotice >= TOO_FAR_NOTICE_COOLDOWN then
+			state.lastTooFarNotice = now
+			NotificationServerService:Notify(player, TOO_FAR_MESSAGE)
+		end
+		return
+	end
+
+	table.insert(state.recentPlacements, now)
+	createBlock(accepted.blockType, accepted.cell, accepted.cellKey)
+end
+
+function PlacementServerService:Init()
+	local baseplate = Workspace:FindFirstChild("Baseplate")
+	if baseplate and baseplate:IsA("BasePart") then
+		floorY = baseplate.Position.Y + baseplate.Size.Y / 2
+	else
+		warn("PlacementServerService: Workspace.Baseplate not found, using Y = 0 as the floor")
+	end
+
+	local folder = Instance.new("Folder")
+	folder.Name = BLOCKS_FOLDER_NAME
+	folder.Parent = Workspace
+	blocksFolder = folder
+
+	PlacementNetwork.PlaceBlock.OnServerEvent:Connect(onPlaceBlock)
+	Players.PlayerRemoving:Connect(function(player)
+		playerStates[player] = nil
+	end)
+end
+
+return PlacementServerService
