diff --git a/src/ServerScriptService/Tests/Specs/PlacementRules.spec.luau b/src/ServerScriptService/Tests/Specs/PlacementRules.spec.luau
new file mode 100644
index 0000000..1e0cb6d
--- /dev/null
+++ b/src/ServerScriptService/Tests/Specs/PlacementRules.spec.luau
@@ -0,0 +1,101 @@
+local JestGlobals = require("@game/ServerScriptService/Tests/Packages/JestGlobals")
+local PlacementRules = require(
+	"@game/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/Implementation/PlacementRules"
+)
+
+local describe = JestGlobals.describe
+local expect = JestGlobals.expect
+local it = JestGlobals.it
+
+local function never(_cellKey: string): boolean
+	return false
+end
+
+local function makeRequest(overrides: { [string]: any }?): PlacementRules.Request
+	local request: { [string]: any } = {
+		blockTypeName = "Brick",
+		position = Vector3.new(2, 2, 2),
+		characterPosition = Vector3.new(0, 3, 0),
+		floorY = 0,
+		isOccupied = never,
+		recentPlacements = {},
+		now = 100,
+	}
+	if overrides then
+		for key, value in overrides do
+			request[key] = value
+		end
+	end
+	return request :: any
+end
+
+describe("PlacementRules.check", function()
+	it("accepts a valid request and snaps it to its cell", function()
+		local accepted, reason =
+			PlacementRules.check(makeRequest({ position = Vector3.new(3.1, 1, 0.5) }))
+		expect(reason).toBeNil()
+		assert(accepted, "expected the request to pass")
+		expect(accepted.cell).toEqual(Vector3.new(2, 2, 2))
+		expect(accepted.blockType.Name).toBe("Brick")
+	end)
+
+	it("rejects unknown and non-string block types", function()
+		local _, unknown = PlacementRules.check(makeRequest({ blockTypeName = "Lava" }))
+		local _, notString = PlacementRules.check(makeRequest({ blockTypeName = 1 }))
+		expect(unknown).toBe("UnknownBlockType")
+		expect(notString).toBe("UnknownBlockType")
+	end)
+
+	it("rejects positions that are not finite Vector3s", function()
+		local nan = 0 / 0
+		for _, position in { "here", Vector3.new(nan, 2, 2), Vector3.new(math.huge, 2, 2) } do
+			local _, reason = PlacementRules.check(makeRequest({ position = position }))
+			expect(reason).toBe("InvalidPosition")
+		end
+	end)
+
+	it("rejects cells below the baseplate", function()
+		local _, reason = PlacementRules.check(makeRequest({ position = Vector3.new(2, -2, 2) }))
+		expect(reason).toBe("BelowBaseplate")
+	end)
+
+	it("rejects filled cells", function()
+		local _, reason = PlacementRules.check(makeRequest({
+			isOccupied = function()
+				return true
+			end,
+		}))
+		expect(reason).toBe("Occupied")
+	end)
+
+	it("rejects cells beyond the reach limit", function()
+		local _, reason = PlacementRules.check(makeRequest({ position = Vector3.new(102, 2, 2) }))
+		expect(reason).toBe("TooFar")
+	end)
+
+	it("rejects players without a character", function()
+		local _, reason = PlacementRules.check(makeRequest({ characterPosition = false }))
+		expect(reason).toBe("NoCharacter")
+	end)
+
+	it("allows 10 placements per second, then rejects until the window passes", function()
+		local recent = {}
+		for i = 1, 10 do
+			recent[i] = 99.5
+		end
+		local _, limited = PlacementRules.check(makeRequest({ recentPlacements = recent }))
+		expect(limited).toBe("RateLimited")
+
+		local accepted =
+			PlacementRules.check(makeRequest({ recentPlacements = recent, now = 100.6 }))
+		expect(accepted).never.toBeNil()
+		expect(#recent).toBe(0)
+	end)
+end)
+
+describe("PlacementRules.cellKey", function()
+	it("names neighboring cells differently, including across zero", function()
+		expect(PlacementRules.cellKey(Vector3.new(2, 2, 2))).toBe("0,0,0")
+		expect(PlacementRules.cellKey(Vector3.new(-2, 2, 2))).toBe("-1,0,0")
+	end)
+end)
