new file mode 100644
index 0000000..e4d1752
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/Implementation/BlockPlacementRules.luau
@@ -0,0 +1,138 @@
+--[[
+	The checks a placement request must pass. Pure functions with no Roblox state, so the server
+	service stays thin and specs can drive every rule directly.
+]]
+
+local BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+local Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+-- Farthest a cell center may be from the player's character, in studs.
+local MAX_PLACE_DISTANCE = 64
+-- Most placement requests one player may make in RATE_WINDOW_SECONDS.
+local MAX_REQUESTS_PER_WINDOW = 10
+local RATE_WINDOW_SECONDS = 1
+-- Any coordinate beyond this is junk, whatever the reach check would say.
+local MAX_COORDINATE = 16384
+-- Allows for float error when comparing a cell's bottom face with the baseplate top.
+local HEIGHT_EPSILON = 1e-3
+
+export type Rejection =
+	"InvalidBlockType"
+	| "InvalidPosition"
+	| "BelowBaseplate"
+	| "Occupied"
+	| "NoCharacter"
+	| "TooFar"
+
+export type CheckContext = {
+	-- Top surface of the baseplate. No cell may reach below it.
+	BaseplateTopY: number,
+	-- Where the player's character is, or nil when it has none.
+	CharacterPosition: Vector3?,
+	IsOccupied: (cellKey: string) -> boolean,
+}
+
+export type Placement = {
+	BlockType: BlockTypes.BlockType,
+	CellCenter: Vector3,
+	CellKey: string,
+}
+
+local BlockPlacementRules = {
+	MaxPlaceDistance = MAX_PLACE_DISTANCE,
+	MaxRequestsPerWindow = MAX_REQUESTS_PER_WINDOW,
+	RateWindowSeconds = RATE_WINDOW_SECONDS,
+}
+
+local function isSaneNumber(value: number): boolean
+	-- NaN fails every comparison, and infinity fails the bound.
+	return value == value and math.abs(value) <= MAX_COORDINATE
+end
+
+--[[
+	True when the value is a Vector3 with finite components inside the world bounds.
+]]
+function BlockPlacementRules.isSanePosition(value: unknown): boolean
+	if typeof(value) ~= "Vector3" then
+		return false
+	end
+	local position = value :: Vector3
+	return isSaneNumber(position.X) and isSaneNumber(position.Y) and isSaneNumber(position.Z)
+end
+
+--[[
+	A string key naming the grid cell that contains the position.
+]]
+function BlockPlacementRules.getCellKey(position: Vector3): string
+	local index = Grid.toCellIndex(position, BlockTypes.BlockSize)
+	return `{index.X},{index.Y},{index.Z}`
+end
+
+--[[
+	Records a request at time `now` in the player's recent request times and returns whether it
+	fits the rate limit. Refused requests are not recorded, so a player who keeps spamming gets
+	through again as soon as their older requests leave the window.
+]]
+function BlockPlacementRules.allowRequest(recentTimes: { number }, now: number): boolean
+	local windowStart = now - RATE_WINDOW_SECONDS
+	-- Times are appended in order, so the expired ones sit at the front. The list never holds
+	-- more than MAX_REQUESTS_PER_WINDOW entries, so removing from the front stays cheap.
+	while recentTimes[1] ~= nil and recentTimes[1] <= windowStart do
+		table.remove(recentTimes, 1)
+	end
+
+	if #recentTimes >= MAX_REQUESTS_PER_WINDOW then
+		return false
+	end
+	table.insert(recentTimes, now)
+	return true
+end
+
+--[[
+	Checks the arguments a client sent with a placement request. Returns the placement to make,
+	or nil and the reason the request was refused.
+]]
+function BlockPlacementRules.check(
+	blockTypeName: unknown,
+	position: unknown,
+	context: CheckContext
+): (Placement?, Rejection?)
+	local blockType = if typeof(blockTypeName) == "string"
+		then BlockTypes.ByName[blockTypeName :: string]
+		else nil
+	if not blockType then
+		return nil, "InvalidBlockType"
+	end
+
+	if not BlockPlacementRules.isSanePosition(position) then
+		return nil, "InvalidPosition"
+	end
+	-- The client sends a cell center, but snapping here means only whole cells are ever used.
+	local cellCenter = Grid.snapToCell(position :: Vector3, BlockTypes.BlockSize)
+
+	local cellBottom = cellCenter.Y - BlockTypes.BlockSize / 2
+	if cellBottom < context.BaseplateTopY - HEIGHT_EPSILON then
+		return nil, "BelowBaseplate"
+	end
+
+	local cellKey = BlockPlacementRules.getCellKey(cellCenter)
+	if context.IsOccupied(cellKey) then
+		return nil, "Occupied"
+	end
+
+	local characterPosition = context.CharacterPosition
+	if not characterPosition then
+		return nil, "NoCharacter"
+	end
+	if (cellCenter - characterPosition).Magnitude > MAX_PLACE_DISTANCE then
+		return nil, "TooFar"
+	end
+
+	return {
+		BlockType = blockType,
+		CellCenter = cellCenter,
+		CellKey = cellKey,
+	}, nil
+end
+
+return table.freeze(BlockPlacementRules)
