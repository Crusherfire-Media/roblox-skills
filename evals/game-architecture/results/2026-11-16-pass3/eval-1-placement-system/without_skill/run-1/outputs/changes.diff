+--[[
+	Remotes for block placement. Each remote is a child of this module, so it reaches clients
+	together with the module.
+]]
+
+local BlockPlacementNetwork = {
+	-- Client to server: (blockTypeName: string, cellCenter: Vector3)
+	-- The server treats both arguments as untrusted and checks them before placing anything.
+	PlaceBlock = script:WaitForChild("PlaceBlock") :: RemoteEvent,
+}
+
+return table.freeze(BlockPlacementNetwork)
diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
new file mode 100644
index 0000000..25e10e1
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
@@ -0,0 +1,141 @@
+--[[
+	Places blocks for players. Every request from a client is checked by BlockPlacementRules
+	before a block appears, and the server keeps its own record of which cells are filled.
+]]
+
+local Players = game:GetService("Players")
+local Workspace = game:GetService("Workspace")
+
+local BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+local NotificationServerService = require(
+	"@game/ServerScriptService/Modules/Systems/Core/NotificationSystem/SystemPackage/NotificationServerService"
+)
+local BlockPlacementRules = require("../Implementation/BlockPlacementRules")
+local BlockPlacementConstants = require("./BlockPlacementConstants")
+local BlockPlacementNetwork = require("./BlockPlacementNetwork")
+
+-- Shortest gap between two "too far" notifications to one player, so spam clicks don't stack them.
+local TOO_FAR_NOTIFY_COOLDOWN = 1
+local TOO_FAR_MESSAGE =
+	`That spot is too far away. You can place blocks up to {BlockPlacementRules.MaxPlaceDistance} studs from you.`
+
+type PlayerState = {
+	RecentRequestTimes: { number },
+	LastTooFarNotifyTime: number,
+}
+
+local BlockPlacementServerService = {}
+
+local placedBlocksFolder: Folder
+local baseplateTopY = 0
+-- Cell key to the block filling that cell.
+local blocksByCell: { [string]: BasePart } = {}
+local stateByPlayer: { [Player]: PlayerState } = {}
+
+local function getPlayerState(player: Player): PlayerState
+	local state = stateByPlayer[player]
+	if not state then
+		state = {
+			RecentRequestTimes = {},
+			LastTooFarNotifyTime = -math.huge,
+		}
+		stateByPlayer[player] = state
+	end
+	return state
+end
+
+local function getCharacterPosition(player: Player): Vector3?
+	local character = player.Character
+	if not character then
+		return nil
+	end
+	local humanoid = character:FindFirstChildOfClass("Humanoid")
+	local rootPart = character:FindFirstChild("HumanoidRootPart")
+	if not humanoid or humanoid.Health <= 0 or not rootPart or not rootPart:IsA("BasePart") then
+		return nil
+	end
+	return rootPart.Position
+end
+
+local function isOccupied(cellKey: string): boolean
+	return blocksByCell[cellKey] ~= nil
+end
+
+local function createBlock(placement: BlockPlacementRules.Placement)
+	local blockType = placement.BlockType
+	local block = Instance.new("Part")
+	block.Name = blockType.Name
+	block.Anchored = true
+	block.Size = Vector3.one * BlockTypes.BlockSize
+	block.Position = placement.CellCenter
+	block.Color = blockType.Color
+	block.Material = blockType.Material
+	block.Transparency = blockType.Transparency
+	block.TopSurface = Enum.SurfaceType.Smooth
+	block.BottomSurface = Enum.SurfaceType.Smooth
+	block:SetAttribute(BlockPlacementConstants.BLOCK_TYPE_ATTRIBUTE, blockType.Name)
+
+	local cellKey = placement.CellKey
+	blocksByCell[cellKey] = block
+	-- Frees the cell if anything else removes the block later.
+	block.Destroying:Once(function()
+		if blocksByCell[cellKey] == block then
+			blocksByCell[cellKey] = nil
+		end
+	end)
+	block.Parent = placedBlocksFolder
+end
+
+local function notifyTooFar(player: Player, state: PlayerState)
+	local now = os.clock()
+	if now - state.LastTooFarNotifyTime < TOO_FAR_NOTIFY_COOLDOWN then
+		return
+	end
+	state.LastTooFarNotifyTime = now
+	NotificationServerService:Notify(player, TOO_FAR_MESSAGE)
+end
+
+local function onPlaceBlockRequest(player: Player, blockTypeName: unknown, position: unknown)
+	local state = getPlayerState(player)
+	-- Counted before any other check, so junk requests can't be sent faster than real ones.
+	if not BlockPlacementRules.allowRequest(state.RecentRequestTimes, os.clock()) then
+		return
+	end
+
+	local placement, rejection = BlockPlacementRules.check(blockTypeName, position, {
+		BaseplateTopY = baseplateTopY,
+		CharacterPosition = getCharacterPosition(player),
+		IsOccupied = isOccupied,
+	})
+	if placement then
+		createBlock(placement)
+	elseif rejection == "TooFar" then
+		notifyTooFar(player, state)
+	end
+end
+
+local function findBaseplateTopY(): number
+	local baseplate = Workspace:FindFirstChild(BlockPlacementConstants.BASEPLATE_NAME)
+	if baseplate and baseplate:IsA("BasePart") then
+		return baseplate.Position.Y + baseplate.Size.Y / 2
+	end
+	warn(
+		`[BlockPlacement] Workspace.{BlockPlacementConstants.BASEPLATE_NAME} not found; using Y = 0 as the floor.`
+	)
+	return 0
+end
+
+function BlockPlacementServerService:Init()
+	baseplateTopY = findBaseplateTopY()
+
+	placedBlocksFolder = Instance.new("Folder")
+	placedBlocksFolder.Name = BlockPlacementConstants.PLACED_BLOCKS_FOLDER_NAME
+	placedBlocksFolder.Parent = Workspace
+
+	BlockPlacementNetwork.PlaceBlock.OnServerEvent:Connect(onPlaceBlockRequest)
+	Players.PlayerRemoving:Connect(function(player)
+		stateByPlayer[player] = nil
+	end)
+end
+
+return BlockPlacementServerService
