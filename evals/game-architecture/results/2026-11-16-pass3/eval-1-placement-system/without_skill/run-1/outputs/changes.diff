new file mode 100644
index 0000000..2732be0
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementClientService.luau
@@ -0,0 +1,118 @@
+--[[
+	Turns clicks and taps on the baseplate or a placed block into placement requests, and lets
+	the number keys pick the block type. The server decides whether each request goes through.
+]]
+
+local Players = game:GetService("Players")
+local UserInputService = game:GetService("UserInputService")
+local Workspace = game:GetService("Workspace")
+
+local BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+local Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+local BlockPlacementConstants = require("./BlockPlacementConstants")
+local BlockPlacementNetwork = require("./BlockPlacementNetwork")
+
+-- How far the click ray reaches. The server limits reach on its own, so this only needs to be
+-- long enough to hit what the player can see.
+local RAY_LENGTH = 1024
+-- Number keys in order. Key N selects the Nth block type in the catalog.
+local NUMBER_KEYS = {
+	Enum.KeyCode.One,
+	Enum.KeyCode.Two,
+	Enum.KeyCode.Three,
+	Enum.KeyCode.Four,
+	Enum.KeyCode.Five,
+	Enum.KeyCode.Six,
+	Enum.KeyCode.Seven,
+	Enum.KeyCode.Eight,
+	Enum.KeyCode.Nine,
+}
+
+local BlockPlacementClientService = {}
+
+local localPlayer = Players.LocalPlayer
+local selectedBlockType: BlockTypes.BlockType = BlockTypes.List[1]
+local blockIndexByKey: { [Enum.KeyCode]: number } = {}
+for index = 1, math.min(#BlockTypes.List, #NUMBER_KEYS) do
+	blockIndexByKey[NUMBER_KEYS[index]] = index
+end
+
+--[[
+	True for the parts a player may build on: the baseplate and blocks already placed.
+]]
+local function isBuildSurface(instance: Instance): boolean
+	if instance.Name == BlockPlacementConstants.BASEPLATE_NAME and instance.Parent == Workspace then
+		return true
+	end
+	local parent = instance.Parent
+	return parent ~= nil
+		and parent.Name == BlockPlacementConstants.PLACED_BLOCKS_FOLDER_NAME
+		and parent.Parent == Workspace
+		and instance:GetAttribute(BlockPlacementConstants.BLOCK_TYPE_ATTRIBUTE) ~= nil
+end
+
+--[[
+	Casts a ray through the screen point and requests a block in the cell beside the face it hits.
+	The screen point excludes the top bar inset, as InputObject and TouchTapInWorld positions do.
+]]
+local function requestPlacementAt(screenPosition: Vector2)
+	local camera = Workspace.CurrentCamera
+	if not camera then
+		return
+	end
+
+	local ray = camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
+	local params = RaycastParams.new()
+	params.FilterType = Enum.RaycastFilterType.Exclude
+	params.FilterDescendantsInstances = if localPlayer.Character
+		then { localPlayer.Character }
+		else {}
+
+	local result = Workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, params)
+	if not result or not isBuildSurface(result.Instance) then
+		return
+	end
+
+	-- Half a block out along the face normal lands in the middle of the neighboring cell.
+	local cellSize = BlockTypes.BlockSize
+	local cellCenter = Grid.snapToCell(result.Position + result.Normal * (cellSize / 2), cellSize)
+	BlockPlacementNetwork.PlaceBlock:FireServer(selectedBlockType.Name, cellCenter)
+end
+
+local function onInputBegan(input: InputObject, gameProcessedEvent: boolean)
+	if gameProcessedEvent then
+		return
+	end
+
+	if input.UserInputType == Enum.UserInputType.MouseButton1 then
+		requestPlacementAt(Vector2.new(input.Position.X, input.Position.Y))
+		return
+	end
+
+	local blockIndex = blockIndexByKey[input.KeyCode]
+	if blockIndex then
+		selectedBlockType = BlockTypes.List[blockIndex]
+	end
+end
+
+-- Fires for taps only, not for drags that move the camera or the thumbstick.
+local function onTouchTapInWorld(position: Vector2, processedByUI: boolean)
+	if processedByUI then
+		return
+	end
+	requestPlacementAt(position)
+end
+
+function BlockPlacementClientService:Init()
+	UserInputService.InputBegan:Connect(onInputBegan)
+	UserInputService.TouchTapInWorld:Connect(onTouchTapInWorld)
+end
+
+--[[
+	The block type the next placement will use.
+]]
+function BlockPlacementClientService:GetSelectedBlockType(): BlockTypes.BlockType
+	return selectedBlockType
+end
+
+return BlockPlacementClientService
