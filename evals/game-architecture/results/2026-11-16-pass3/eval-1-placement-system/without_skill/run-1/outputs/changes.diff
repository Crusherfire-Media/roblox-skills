diff --git a/src/ServerScriptService/Modules/Utilities/Grid.luau b/src/ServerScriptService/Modules/Utilities/Grid.luau
index 7ee1813..e542a8e 100644
--- a/src/ServerScriptService/Modules/Utilities/Grid.luau
+++ b/src/ServerScriptService/Modules/Utilities/Grid.luau
@@ -19,4 +19,16 @@ function Grid.snapToCell(position: Vector3, cellSize: number): Vector3
 	)
 end
 
+--[[
+	Returns the whole-number index of the grid cell that contains the position. Neighboring cells
+	differ by 1 on one axis, so the index works as a stable key for a cell.
+]]
+function Grid.toCellIndex(position: Vector3, cellSize: number): Vector3
+	return Vector3.new(
+		math.floor(position.X / cellSize),
+		math.floor(position.Y / cellSize),
+		math.floor(position.Z / cellSize)
+	)
+end
+
 return table.freeze(Grid)
diff --git a/src/ServerScriptService/Tests/Specs/BlockPlacementRules.spec.luau b/src/ServerScriptService/Tests/Specs/BlockPlacementRules.spec.luau
new file mode 100644
index 0000000..c05b2bb
--- /dev/null
+++ b/src/ServerScriptService/Tests/Specs/BlockPlacementRules.spec.luau
@@ -0,0 +1,132 @@
+local JestGlobals = require("@game/ServerScriptService/Tests/Packages/JestGlobals")
+local BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+local BlockPlacementRules = require(
+	"@game/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/Implementation/BlockPlacementRules"
+)
+
+local describe = JestGlobals.describe
+local expect = JestGlobals.expect
+local it = JestGlobals.it
+
+local SIZE = BlockTypes.BlockSize
+local FIRST_LAYER_Y = SIZE / 2
+
+local function context(overrides: { [string]: any }?): BlockPlacementRules.CheckContext
+	local base: { [string]: any } = {
+		BaseplateTopY = 0,
+		CharacterPosition = Vector3.new(0, 3, 0),
+		IsOccupied = function()
+			return false
+		end,
+	}
+	if overrides then
+		for key, value in overrides do
+			base[key] = value
+		end
+	end
+	return base :: any
+end
+
+describe("BlockPlacementRules.check", function()
+	it("accepts a valid request and snaps it to a cell", function()
+		local placement, rejection =
+			BlockPlacementRules.check("Brick", Vector3.new(5, FIRST_LAYER_Y + 0.4, 7), context())
+		expect(rejection).toBeNil()
+		assert(placement, "expected a placement")
+		expect(placement.BlockType).toBe(BlockTypes.ByName.Brick)
+		expect(placement.CellCenter).toEqual(Vector3.new(6, FIRST_LAYER_Y, 6))
+		expect(placement.CellKey).toBe("1,0,1")
+	end)
+
+	it("rejects unknown and non-string block types", function()
+		local position = Vector3.new(2, FIRST_LAYER_Y, 2)
+		expect(select(2, BlockPlacementRules.check("Lava", position, context()))).toBe(
+			"InvalidBlockType"
+		)
+		expect(select(2, BlockPlacementRules.check(1, position, context()))).toBe(
+			"InvalidBlockType"
+		)
+		expect(select(2, BlockPlacementRules.check(nil, position, context()))).toBe(
+			"InvalidBlockType"
+		)
+	end)
+
+	it("rejects positions that are not sane Vector3s", function()
+		for _, position in
+			{
+				"here",
+				Vector3.new(0 / 0, 2, 2),
+				Vector3.new(math.huge, 2, 2),
+				Vector3.new(1e9, 2, 2),
+			}
+		do
+			expect(select(2, BlockPlacementRules.check("Dirt", position, context()))).toBe(
+				"InvalidPosition"
+			)
+		end
+	end)
+
+	it("rejects cells below the baseplate top", function()
+		local _, rejection =
+			BlockPlacementRules.check("Dirt", Vector3.new(2, -FIRST_LAYER_Y, 2), context())
+		expect(rejection).toBe("BelowBaseplate")
+	end)
+
+	it("rejects filled cells", function()
+		local _, rejection = BlockPlacementRules.check(
+			"Dirt",
+			Vector3.new(2, FIRST_LAYER_Y, 2),
+			context({
