+--!strict
+--[[
+	Gives the placement system this game's ground: the baseplate.
+]]
+
+const PlacementServerService = require("../SystemPackage/PlacementServerService")
+
+local Module = {}
+
+function Module:Init()
+	const baseplate = workspace:FindFirstChild("Baseplate")
+	if not baseplate or not baseplate:IsA("BasePart") then
+		warn("PlacementSystem: Workspace.Baseplate is missing, so blocks have no ground")
+		return
+	end
+
+	PlacementServerService:SetGround(baseplate)
+end
+
+return Module
