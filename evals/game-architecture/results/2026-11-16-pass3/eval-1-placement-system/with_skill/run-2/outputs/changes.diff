diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/SystemPackage/PlacementServerService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/SystemPackage/PlacementServerService.luau
new file mode 100644
index 0000000..73d4902
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/SystemPackage/PlacementServerService.luau
@@ -0,0 +1,242 @@
+--!strict
+--[[
+	Places blocks for players. Every request a client sends is checked here
+	before a block appears.
+]]
+
+const Players = game:GetService("Players")
+
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+const Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+const PlacementNetwork = require("./PlacementNetwork")
+const PlacementSharedService = require("./PlacementSharedService")
+
+const MAX_PLACE_DISTANCE = 64
+const MAX_REQUESTS_PER_WINDOW = 10
+const RATE_WINDOW_SECONDS = 1
+-- Far beyond any reachable cell. Written as an upper bound on math.abs so NaN
+-- and infinity fail it too.
+const MAX_COORDINATE = 100_000
+const POSITION_TOLERANCE = 0.01
+const NEIGHBOR_OFFSETS = {
+	Vector3.xAxis,
+	-Vector3.xAxis,
+	Vector3.yAxis,
+	-Vector3.yAxis,
+	Vector3.zAxis,
+	-Vector3.zAxis,
+}
+
+export type RejectReason =
+	"RateLimited"
+	| "UnknownBlockType"
+	| "InvalidPosition"
+	| "BelowGround"
+	| "NoCharacter"
+	| "TooFar"
+	| "Occupied"
+	| "Unsupported"
+
+type RejectedCallback = (player: Player, reason: RejectReason) -> ()
+
+local Module = setmetatable({}, PlacementSharedService)
+
+local ground: BasePart? = nil
+local blocksFolder: Folder? = nil
+-- Keyed by integer cell index, so equal cells always share a key.
+local blocksByCell: { [Vector3]: BasePart? } = {}
+local recentRequestTimes: { [Player]: { number }? } = {}
+local rejectedCallbacks: { RejectedCallback } = {}
+
+local function isRateLimited(player: Player): boolean
+	const now = os.clock()
+	local times = recentRequestTimes[player]
+	if not times then
+		times = {}
+		recentRequestTimes[player] = times
+	end
+	assert(times, "Request times were just created")
+
+	while times[1] and now - times[1] >= RATE_WINDOW_SECONDS do
+		table.remove(times, 1)
+	end
+
+	if #times >= MAX_REQUESTS_PER_WINDOW then
+		return true
+	end
+
+	table.insert(times, now)
+	return false
+end
+
+local function isSaneCoordinate(value: number): boolean
+	return math.abs(value) <= MAX_COORDINATE
+end
+
+local function getCellIndex(cellCenter: Vector3): Vector3
+	const blockSize = BlockTypes.BlockSize
+	return Vector3.new(
+		math.floor(cellCenter.X / blockSize),
+		math.floor(cellCenter.Y / blockSize),
+		math.floor(cellCenter.Z / blockSize)
+	)
+end
+
+local function getGroundTop(groundPart: BasePart): number
+	return groundPart.Position.Y + groundPart.Size.Y / 2
+end
+
+--[[
+	A cell is supported when it rests on the ground or shares a face with a
+	placed block, which keeps clients from placing blocks in midair.
+]]
+local function isSupported(cellCenter: Vector3, cellIndex: Vector3): boolean
+	if ground then
+		const cellBottom = cellCenter.Y - BlockTypes.BlockSize / 2
+		if math.abs(cellBottom - getGroundTop(ground)) <= POSITION_TOLERANCE then
+			return true
+		end
+	end
+
+	for _, offset in NEIGHBOR_OFFSETS do
+		if blocksByCell[cellIndex + offset] then
+			return true
+		end
+	end
+
+	return false
+end
+
+local function reject(player: Player, reason: RejectReason)
+	-- Cloned so a callback that disconnects itself cannot skip the next one.
+	for _, callback in table.clone(rejectedCallbacks) do
+		task.spawn(callback, player, reason)
+	end
+end
+
+local function createBlock(blockType: BlockTypes.BlockType, cellCenter: Vector3, cellIndex: Vector3)
+	const block = Instance.new("Part")
+	block.Name = blockType.Name
+	block.Anchored = true
+	block.Size = Vector3.one * BlockTypes.BlockSize
+	block.CFrame = CFrame.new(cellCenter)
+	block.Color = blockType.Color
+	block.Material = blockType.Material
+	block.Transparency = blockType.Transparency
+	block:SetAttribute("BlockType", blockType.Name)
+	block:AddTag(Module.SurfaceTag)
+
+	block.AncestryChanged:Connect(function()
+		if not block:IsDescendantOf(workspace) and blocksByCell[cellIndex] == block then
+			blocksByCell[cellIndex] = nil
+		end
+	end)
+
+	blocksByCell[cellIndex] = block
+	block.Parent = blocksFolder
+end
+
+local function onPlaceBlock(player: Player, blockTypeName: unknown, position: unknown)
+	if isRateLimited(player) then
+		reject(player, "RateLimited")
+		return
+	end
+
+	if typeof(blockTypeName) ~= "string" then
+		reject(player, "UnknownBlockType")
+		return
+	end
+
+	const blockType: BlockTypes.BlockType? = BlockTypes.ByName[blockTypeName]
+	if not blockType then
+		reject(player, "UnknownBlockType")
+		return
+	end
+
+	if
+		typeof(position) ~= "Vector3"
+		or not isSaneCoordinate(position.X)
+		or not isSaneCoordinate(position.Y)
+		or not isSaneCoordinate(position.Z)
+	then
+		reject(player, "InvalidPosition")
+		return
+	end
+
+	const blockSize = BlockTypes.BlockSize
+	const cellCenter = Grid.snapToCell(position, blockSize)
+	if (cellCenter - position).Magnitude > POSITION_TOLERANCE then
+		reject(player, "InvalidPosition")
+		return
+	end
+
+	if ground then
+		if cellCenter.Y - blockSize / 2 < getGroundTop(ground) - POSITION_TOLERANCE then
+			reject(player, "BelowGround")
+			return
+		end
+	end
+
+	const character = player.Character
+	const rootPart = if character then character:FindFirstChild("HumanoidRootPart") else nil
+	if not rootPart or not rootPart:IsA("BasePart") then
+		reject(player, "NoCharacter")
+		return
+	end
+
+	if (rootPart.Position - cellCenter).Magnitude > MAX_PLACE_DISTANCE then
+		reject(player, "TooFar")
+		return
+	end
+
+	const cellIndex = getCellIndex(cellCenter)
+	if blocksByCell[cellIndex] then
+		reject(player, "Occupied")
+		return
+	end
+
+	if not isSupported(cellCenter, cellIndex) then
+		reject(player, "Unsupported")
+		return
+	end
+
+	createBlock(blockType, cellCenter, cellIndex)
+end
+
+--[[
+	Sets the part blocks rest on. No block may sit below its top face, and
+	clicks on it place blocks.
+]]
+function Module:SetGround(part: BasePart)
+	ground = part
+	part:AddTag(Module.SurfaceTag)
+end
+
+--[[
+	Calls the callback whenever the server turns down a placement request.
+	Returns a function that disconnects it.
+]]
+function Module:OnPlacementRejected(callback: RejectedCallback): () -> ()
+	table.insert(rejectedCallbacks, callback)
+
+	return function()
+		const index = table.find(rejectedCallbacks, callback)
+		if index then
+			table.remove(rejectedCallbacks, index)
+		end
+	end
+end
+
+function Module:Init()
+	const folder = Instance.new("Folder")
+	folder.Name = "PlacedBlocks"
+	folder.Parent = workspace
+	blocksFolder = folder
+
+	PlacementNetwork.PlaceBlock.OnServerEvent:Connect(onPlaceBlock)
+	Players.PlayerRemoving:Connect(function(player)
+		recentRequestTimes[player] = nil
+	end)
+end
+
+return Module
