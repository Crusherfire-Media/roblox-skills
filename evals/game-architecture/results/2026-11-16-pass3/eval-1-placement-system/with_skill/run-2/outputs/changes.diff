@@ -0,0 +1,93 @@
+--!strict
+--[[
+	Turns clicks and taps on placement surfaces into placement requests, and
+	picks the block type from the number keys in catalog order.
+]]
+
+const Players = game:GetService("Players")
+const UserInputService = game:GetService("UserInputService")
+
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+const PlacementNetwork = require("./PlacementNetwork")
+const PlacementSharedService = require("./PlacementSharedService")
+
+const MAX_RAY_DISTANCE = 1000
+const HOTBAR_KEYS = {
+	Enum.KeyCode.One,
+	Enum.KeyCode.Two,
+	Enum.KeyCode.Three,
+	Enum.KeyCode.Four,
+	Enum.KeyCode.Five,
+	Enum.KeyCode.Six,
+	Enum.KeyCode.Seven,
+	Enum.KeyCode.Eight,
+	Enum.KeyCode.Nine,
+}
+
+const catalogIndexByKey: { [Enum.KeyCode]: number? } = {}
+for index = 1, math.min(#BlockTypes.List, #HOTBAR_KEYS) do
+	catalogIndexByKey[HOTBAR_KEYS[index]] = index
+end
+
+local Module = setmetatable({}, PlacementSharedService)
+
+local selectedBlockType = BlockTypes.List[1]
+
+local function requestPlacementAt(viewportPosition: Vector2)
+	const camera = workspace.CurrentCamera
+	if not camera then
+		return
+	end
+
+	const characters = {}
+	for _, player in Players:GetPlayers() do
+		if player.Character then
+			table.insert(characters, player.Character)
+		end
+	end
+
+	const raycastParams = RaycastParams.new()
+	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
+	raycastParams.FilterDescendantsInstances = characters
+
+	const ray = camera:ViewportPointToRay(viewportPosition.X, viewportPosition.Y)
+	const result = workspace:Raycast(ray.Origin, ray.Direction * MAX_RAY_DISTANCE, raycastParams)
+	if not result or not result.Instance:HasTag(Module.SurfaceTag) then
+		return
+	end
+
+	const cellCenter = Module:GetAdjacentCell(result.Position, result.Normal)
+	PlacementNetwork.PlaceBlock:FireServer(selectedBlockType.Name, cellCenter)
+end
+
+local function onInputBegan(input: InputObject, gameProcessedEvent: boolean)
+	if gameProcessedEvent then
+		return
+	end
+
+	if input.UserInputType == Enum.UserInputType.MouseButton1 then
+		requestPlacementAt(UserInputService:GetMouseLocation())
+		return
+	end
+
+	const catalogIndex = catalogIndexByKey[input.KeyCode]
+	if catalogIndex then
+		selectedBlockType = BlockTypes.List[catalogIndex]
+	end
+end
+
+-- TouchTapInWorld fires only for taps, not for the drags that turn the camera.
+local function onTouchTapInWorld(viewportPosition: Vector2, processedByUi: boolean)
+	if processedByUi then
+		return
+	end
+
+	requestPlacementAt(viewportPosition)
+end
+
+function Module:Init()
+	UserInputService.InputBegan:Connect(onInputBegan)
+	UserInputService.TouchTapInWorld:Connect(onTouchTapInWorld)
+end
+
+return Module
