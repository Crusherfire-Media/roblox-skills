diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/SystemPackage/PlacementSharedService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/SystemPackage/PlacementSharedService.luau
new file mode 100644
index 0000000..08fe9fa
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/SystemPackage/PlacementSharedService.luau
@@ -0,0 +1,23 @@
+--!strict
+--[[
+	Placement constants and grid math both realms need.
+]]
+
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+const Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+local Module = {}
+Module.__index = Module
+
+-- Parts with this tag accept clicks: the ground and every placed block.
+Module.SurfaceTag = "PlacementSurface"
+
+--[[
+	Returns the center of the grid cell that a clicked face opens onto.
+]]
+function Module:GetAdjacentCell(hitPosition: Vector3, normal: Vector3): Vector3
+	const blockSize = BlockTypes.BlockSize
+	return Grid.snapToCell(hitPosition + normal * (blockSize / 2), blockSize)
+end
+
+return Module
