@@ -0,0 +1,51 @@
+--!strict
+--[[
+	Tells a player when a block they tried to place is out of reach.
+]]
+
+const Players = game:GetService("Players")
+
+const NotificationServerService = require(
+	"@game/ServerScriptService/Modules/Systems/Core/NotificationSystem/SystemPackage/NotificationServerService"
+)
+
+const BlockPlacementServerService = require("../SystemPackage/BlockPlacementServerService")
+
+const BlockPlacementTypes = require("../SystemPackage/BlockPlacementTypes")
+
+type RejectionReason = BlockPlacementTypes.RejectionReason
+
+const TOO_FAR_MESSAGE = "That spot is too far away. Move closer to place a block."
+-- Clicking out of reach several times a second would otherwise stack one
+-- notification per click.
+const NOTIFY_COOLDOWN_SECONDS = 2
+
+const lastNotifiedAt: { [Player]: number? } = {}
+
+local Module = {}
+
+local function onPlacementRejected(player: Player, reason: RejectionReason)
+	if reason ~= "TooFar" then
+		return
+	end
+
+	const now = os.clock()
+	const last = lastNotifiedAt[player]
+	if last and now - last < NOTIFY_COOLDOWN_SECONDS then
+		return
+	end
+
+	lastNotifiedAt[player] = now
+	NotificationServerService:Notify(player, TOO_FAR_MESSAGE)
+end
+
+local function onPlayerRemoving(player: Player)
+	lastNotifiedAt[player] = nil
+end
+
+function Module:Init()
+	BlockPlacementServerService:ConnectPlacementRejected(onPlacementRejected)
+	Players.PlayerRemoving:Connect(onPlayerRemoving)
+end
+
+return Module
