--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementSharedService.luau
@@ -0,0 +1,74 @@
+--!strict
+--[[
+	Block placement state both realms read: the block types, the grid size, and
+	the floor blocks rest on. A setup registers them, in any order.
+]]
+
+const Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+const BlockPlacementTypes = require("./BlockPlacementTypes")
+
+type BlockType = BlockPlacementTypes.BlockType
+
+local blockTypes: { BlockType } = {}
+local blockTypesByName: { [string]: BlockType? } = {}
+local blockSize = 0
+local floor: BasePart? = nil
+
+local Module = {}
+Module.__index = Module
+
+Module.PlacedBlockTag = "PlacedBlock"
+
+--[[
+	Sets the placeable block types, in hotbar order, and the edge length of
+	every block in studs.
+]]
+function Module:RegisterBlockTypes(newBlockTypes: { BlockType }, newBlockSize: number)
+	assert(newBlockSize > 0, "Block size must be positive")
+
+	blockTypes = newBlockTypes
+	blockTypesByName = {}
+	for _, blockType in newBlockTypes do
+		blockTypesByName[blockType.Name] = blockType
+	end
+	blockSize = newBlockSize
+end
+
+--[[
+	Sets the part blocks are placed on. Its top face is the lowest height a
+	block may sit at.
+]]
+function Module:RegisterFloor(newFloor: BasePart)
+	floor = newFloor
+end
+
+function Module:GetBlockTypes(): { BlockType }
+	return blockTypes
+end
+
+function Module:GetBlockType(name: string): BlockType?
+	return blockTypesByName[name]
+end
+
+function Module:GetBlockSize(): number
+	return blockSize
+end
+
+function Module:GetFloor(): BasePart?
+	return floor
+end
+
+function Module:GetCellCenter(position: Vector3): Vector3
+	return Grid.snapToCell(position, blockSize)
+end
+
+--[[
+	Returns the center of the cell next to a clicked surface, given the hit
+	position and the surface normal.
+]]
+function Module:GetAdjacentCellCenter(hitPosition: Vector3, normal: Vector3): Vector3
+	return Grid.snapToCell(hitPosition + normal * (blockSize / 2), blockSize)
+end
+
+return Module
diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau
