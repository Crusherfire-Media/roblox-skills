+--!strict
+--[[
+	Gives block placement this game's block catalog and floor, on both realms.
+]]
+
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+
+const BlockPlacementSharedService = require("../SystemPackage/BlockPlacementSharedService")
+
+local Module = {}
+
+function Module:Init()
+	BlockPlacementSharedService:RegisterBlockTypes(BlockTypes.List, BlockTypes.BlockSize)
+
+	-- With streaming on, the client may not have the baseplate yet.
+	task.spawn(function()
+		const baseplate = workspace:WaitForChild("Baseplate") :: BasePart
+		BlockPlacementSharedService:RegisterFloor(baseplate)
+	end)
+end
+
+return Module
