diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
new file mode 100644
index 0000000..1941986
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
@@ -0,0 +1,189 @@
+--!strict
+--[[
+	Places blocks for players. The client picks the block type and the cell, so
+	every request is checked here before a block appears.
+]]
+
+const Players = game:GetService("Players")
+
+const BlockPlacementNetwork = require("./BlockPlacementNetwork")
+const BlockPlacementSharedService = require("./BlockPlacementSharedService")
+
+const BlockPlacementTypes = require("./BlockPlacementTypes")
+
+type BlockType = BlockPlacementTypes.BlockType
+type RejectionReason = BlockPlacementTypes.RejectionReason
+
+const MAX_PLACE_DISTANCE = 64
+const MAX_PLACEMENTS_PER_WINDOW = 10
+const RATE_WINDOW_SECONDS = 1
+-- Far past any reachable cell; also rejects infinity.
+const MAX_COORDINATE = 100000
+-- Absorbs float error when a cell's bottom sits exactly on the floor's top.
+const HEIGHT_TOLERANCE = 0.01
+
+const requestTimesByPlayer: { [Player]: { number }? } = {}
+const blocksByCell: { [string]: BasePart? } = {}
+const rejectionListeners: { (Player, RejectionReason) -> () } = {}
+local blocksFolder: Folder? = nil
+
+local Module = setmetatable({}, BlockPlacementSharedService)
+
+local function isFiniteCoordinate(value: number): boolean
+	-- value == value is false for NaN
+	return value == value and math.abs(value) <= MAX_COORDINATE
+end
+
+local function getCellKey(cellCenter: Vector3, blockSize: number): string
+	const x = math.floor(cellCenter.X / blockSize)
+	const y = math.floor(cellCenter.Y / blockSize)
+	const z = math.floor(cellCenter.Z / blockSize)
+	return `{x},{y},{z}`
+end
+
+--[[
+	Records a request and returns whether the player is still under the limit
+	for the last RATE_WINDOW_SECONDS. A sliding window, unlike a token bucket,
+	never lets a burst exceed the limit within any one window.
+]]
+local function tryRecordRequest(player: Player): boolean
+	const now = os.clock()
+	const requestTimes = requestTimesByPlayer[player] or {}
+	requestTimesByPlayer[player] = requestTimes
+
+	while requestTimes[1] and now - requestTimes[1] >= RATE_WINDOW_SECONDS do
+		table.remove(requestTimes, 1)
+	end
+	if #requestTimes >= MAX_PLACEMENTS_PER_WINDOW then
+		return false
+	end
+
+	table.insert(requestTimes, now)
+	return true
+end
+
+local function createBlock(blockType: BlockType, cellCenter: Vector3, blockSize: number): BasePart
+	const block = Instance.new("Part")
+	block.Name = blockType.Name
+	block.Anchored = true
+	block.Size = Vector3.one * blockSize
+	block.CFrame = CFrame.new(cellCenter)
+	block.Color = blockType.Color
+	block.Material = blockType.Material
+	block.Transparency = blockType.Transparency
+	block.TopSurface = Enum.SurfaceType.Smooth
+	block.BottomSurface = Enum.SurfaceType.Smooth
+	block:AddTag(Module.PlacedBlockTag)
+	block.Parent = blocksFolder
+	return block
+end
+
+local function tryPlaceBlock(
+	player: Player,
+	blockTypeName: unknown,
+	position: unknown
+): RejectionReason?
+	if not tryRecordRequest(player) then
+		return "RateLimited"
+	end
+
+	if typeof(blockTypeName) ~= "string" then
+		return "UnknownBlockType"
+	end
+	const blockType = Module:GetBlockType(blockTypeName)
+	if not blockType then
+		return "UnknownBlockType"
+	end
+
+	if
+		typeof(position) ~= "Vector3"
+		or not isFiniteCoordinate(position.X)
+		or not isFiniteCoordinate(position.Y)
+		or not isFiniteCoordinate(position.Z)
+	then
+		return "InvalidPosition"
+	end
+
+	const floor = Module:GetFloor()
+	if not floor then
+		return "NoFloor"
+	end
+
+	const blockSize = Module:GetBlockSize()
+	const cellCenter = Module:GetCellCenter(position)
+	const floorTop = floor.Position.Y + floor.Size.Y / 2
+	if cellCenter.Y - blockSize / 2 < floorTop - HEIGHT_TOLERANCE then
+		return "BelowFloor"
+	end
+
+	const character = player.Character
+	if not character then
+		return "NoCharacter"
+	end
+	if (cellCenter - character:GetPivot().Position).Magnitude > MAX_PLACE_DISTANCE then
+		return "TooFar"
+	end
+
+	const cellKey = getCellKey(cellCenter, blockSize)
+	if blocksByCell[cellKey] then
+		return "CellOccupied"
+	end
+
+	const block = createBlock(blockType, cellCenter, blockSize)
+	blocksByCell[cellKey] = block
+	block.Destroying:Once(function()
+		if blocksByCell[cellKey] == block then
+			blocksByCell[cellKey] = nil
+		end
+	end)
+
+	return nil
+end
+
+local function onPlaceBlock(player: Player, blockTypeName: unknown, position: unknown)
+	-- With deferred signals a leaving player's request can run after
+	-- PlayerRemoving, and recording it would keep the Player in memory.
+	if not player.Parent then
+		return
+	end
+
+	const reason = tryPlaceBlock(player, blockTypeName, position)
+	if not reason then
+		return
+	end
+
+	for _, listener in table.clone(rejectionListeners) do
+		task.spawn(listener, player, reason)
+	end
+end
+
+local function onPlayerRemoving(player: Player)
+	requestTimesByPlayer[player] = nil
+end
+
+--[[
+	Calls the callback with the player and the reason each time a placement
+	request is turned down. Returns a function that stops the calls.
+]]
+function Module:ConnectPlacementRejected(callback: (Player, RejectionReason) -> ()): () -> ()
+	table.insert(rejectionListeners, callback)
+
+	return function()
+		const index = table.find(rejectionListeners, callback)
+		if index then
+			table.remove(rejectionListeners, index)
+		end
+	end
+end
+
+function Module:Init()
+	const folder = Instance.new("Folder")
+	folder.Name = "PlacedBlocks"
+	folder.Parent = workspace
+	blocksFolder = folder
+
+	BlockPlacementNetwork.PlaceBlock.OnServerEvent:Connect(onPlaceBlock)
+	Players.PlayerRemoving:Connect(onPlayerRemoving)
+end
+
+return Module
