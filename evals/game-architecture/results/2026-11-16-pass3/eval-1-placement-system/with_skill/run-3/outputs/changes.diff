+--!strict
+
+export type BlockType = {
+	Name: string,
+	Color: Color3,
+	Material: Enum.Material,
+	Transparency: number,
+}
+
+export type RejectionReason =
+	"RateLimited"
+	| "UnknownBlockType"
+	| "InvalidPosition"
+	| "NoFloor"
+	| "BelowFloor"
+	| "NoCharacter"
+	| "TooFar"
+	| "CellOccupied"
+
+return {}
