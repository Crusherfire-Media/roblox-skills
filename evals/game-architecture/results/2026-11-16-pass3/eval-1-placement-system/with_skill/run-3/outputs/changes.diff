+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementClientService.luau
@@ -0,0 +1,105 @@
+--!strict
+--[[
+	Asks the server to place the selected block when the player clicks or taps
+	the floor or a placed block. Number keys pick the block type.
+]]
+
+const Players = game:GetService("Players")
+const UserInputService = game:GetService("UserInputService")
+
+const BlockPlacementNetwork = require("./BlockPlacementNetwork")
+const BlockPlacementSharedService = require("./BlockPlacementSharedService")
+
+const BlockPlacementTypes = require("./BlockPlacementTypes")
+
+type BlockType = BlockPlacementTypes.BlockType
+
+const MAX_CLICK_DISTANCE = 1000
+-- Key 1 picks the first registered block type, key 2 the second, and so on.
+const BLOCK_TYPE_KEYS = {
+	Enum.KeyCode.One,
+	Enum.KeyCode.Two,
+	Enum.KeyCode.Three,
+	Enum.KeyCode.Four,
+	Enum.KeyCode.Five,
+}
+
+const raycastParams = RaycastParams.new()
+raycastParams.FilterType = Enum.RaycastFilterType.Exclude
+
+local selectedIndex = 1
+
+local Module = setmetatable({}, BlockPlacementSharedService)
+
+local function requestPlacementAt(screenPosition: Vector2)
+	const camera = workspace.CurrentCamera
+	const blockType = Module:GetSelectedBlockType()
+	const floor = Module:GetFloor()
+	if not camera or not blockType or not floor then
+		return
+	end
+
+	const character = Players.LocalPlayer.Character
+	raycastParams.FilterDescendantsInstances = if character then { character } else {}
+
+	const ray = camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
+	const result = workspace:Raycast(ray.Origin, ray.Direction * MAX_CLICK_DISTANCE, raycastParams)
+	if not result then
+		return
+	end
+
+	const hit = result.Instance
+	if hit ~= floor and not hit:HasTag(Module.PlacedBlockTag) then
+		return
+	end
+
+	const cellCenter = Module:GetAdjacentCellCenter(result.Position, result.Normal)
+	BlockPlacementNetwork.PlaceBlock:FireServer(blockType.Name, cellCenter)
+end
+
+local function onInputBegan(input: InputObject, gameProcessedEvent: boolean)
+	if gameProcessedEvent then
+		return
+	end
+
+	if input.UserInputType == Enum.UserInputType.MouseButton1 then
+		requestPlacementAt(Vector2.new(input.Position.X, input.Position.Y))
+	elseif input.UserInputType == Enum.UserInputType.Keyboard then
+		const index = table.find(BLOCK_TYPE_KEYS, input.KeyCode)
+		if index then
+			Module:SelectBlockType(index)
+		end
+	end
+end
+
+local function onTouchTap(touchPositions: { Vector2 }, gameProcessedEvent: boolean)
+	if gameProcessedEvent then
+		return
+	end
+
+	const position = touchPositions[1]
+	if position then
+		requestPlacementAt(position)
+	end
+end
+
+function Module:GetSelectedBlockType(): BlockType?
+	return Module:GetBlockTypes()[selectedIndex]
+end
+
+--[[
+	Selects a block type by its position in the registered list. An index with
+	no block type is ignored.
+]]
+function Module:SelectBlockType(index: number)
+	if Module:GetBlockTypes()[index] then
+		selectedIndex = index
+	end
+end
+
+function Module:Init()
+	UserInputService.InputBegan:Connect(onInputBegan)
+	UserInputService.TouchTap:Connect(onTouchTap)
+end
+
+return Module
