diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
new file mode 100644
index 0000000..fd82818
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
@@ -0,0 +1,242 @@
+--!strict
+--[[
+	Places blocks for players. Every request is checked here: the block type,
+	the position, the cell, the distance from the player's character, and how
+	often the player sends requests.
+]]
+
+const Players = game:GetService("Players")
+
+const BlockPlacementNetwork = require("./BlockPlacementNetwork")
+const BlockPlacementSharedService = require("./BlockPlacementSharedService")
+const BlockPlacementTypes = require("./BlockPlacementTypes")
+
+const MAX_PLACE_DISTANCE = 64
+const MAX_REQUESTS_PER_SECOND = 10
+const RATE_WINDOW_SECONDS = 1
+-- No real target is this far from the origin, so only a bad request sends one.
+const MAX_COORDINATE = 100_000
+-- Tolerates float error when a cell sits exactly on the ground's top face.
+const GROUND_EPSILON = 0.001
+const BLOCK_TYPE_ATTRIBUTE = "BlockType"
+
+type BlockType = BlockPlacementTypes.BlockType
+type Rejection = BlockPlacementTypes.Rejection
+type RejectionListener = (player: Player, rejection: Rejection) -> ()
+
+const Module = setmetatable({}, BlockPlacementSharedService)
+
+local blocksFolder: Folder? = nil
+local blocksByCell: { [Vector3]: BasePart? } = {}
+local requestTimesByPlayer: { [Player]: { number }? } = {}
+local rejectionListeners: { RejectionListener } = {}
+
+local function reject(player: Player, rejection: Rejection)
+	for _, listener in rejectionListeners do
+		listener(player, rejection)
+	end
+end
+
+-- Counts the request and reports whether it fits in the player's rate window.
+local function tryCountRequest(player: Player): boolean
+	const now = os.clock()
+	local requestTimes = requestTimesByPlayer[player]
+	if not requestTimes then
+		requestTimes = {}
+		requestTimesByPlayer[player] = requestTimes
+	end
+
+	while requestTimes[1] and now - requestTimes[1] >= RATE_WINDOW_SECONDS do
+		table.remove(requestTimes, 1)
+	end
+	if #requestTimes >= MAX_REQUESTS_PER_SECOND then
+		return false
+	end
+
+	table.insert(requestTimes, now)
+	return true
+end
+
+local function isSaneCoordinate(value: number): boolean
+	-- value == value rejects NaN, which passes every range check
+	return value == value and math.abs(value) <= MAX_COORDINATE
+end
+
+local function isSanePosition(position: Vector3): boolean
+	return isSaneCoordinate(position.X)
+		and isSaneCoordinate(position.Y)
+		and isSaneCoordinate(position.Z)
+end
+
+-- Works for rotated ground too, by projecting each axis of the part onto Y.
+local function getTopHeight(part: BasePart): number
+	const cframe = part.CFrame
+	const size = part.Size
+	const halfHeight = (
+		math.abs(cframe.RightVector.Y) * size.X
+		+ math.abs(cframe.UpVector.Y) * size.Y
+		+ math.abs(cframe.LookVector.Y) * size.Z
+	) / 2
+	return cframe.Position.Y + halfHeight
+end
+
+local function getFloorHeight(): number?
+	local floorHeight: number? = nil
+	for _, part in Module:GetGroundParts() do
+		const topHeight = getTopHeight(part)
+		if not floorHeight or topHeight < floorHeight then
+			floorHeight = topHeight
+		end
+	end
+
+	return floorHeight
+end
+
+local function getCellKey(cellCenter: Vector3, cellSize: number): Vector3
+	return Vector3.new(
+		math.floor(cellCenter.X / cellSize),
+		math.floor(cellCenter.Y / cellSize),
+		math.floor(cellCenter.Z / cellSize)
+	)
+end
+
+local function getCharacterPosition(player: Player): Vector3?
+	const character = player.Character
+	if not character or not character.PrimaryPart then
+		return nil
+	end
+
+	const humanoid = character:FindFirstChildOfClass("Humanoid")
+	if not humanoid or humanoid.Health <= 0 then
+		return nil
+	end
+
+	return character.PrimaryPart.Position
+end
+
+local function getBlocksFolder(): Folder
+	if blocksFolder and blocksFolder.Parent then
+		return blocksFolder
+	end
+
+	const folder = Instance.new("Folder")
+	folder.Name = Module.BlocksFolderName
+	folder.Parent = workspace
+	blocksFolder = folder
+	return folder
+end
+
+local function placeBlock(
+	blockType: BlockType,
+	cellCenter: Vector3,
+	cellKey: Vector3,
+	cellSize: number
+)
+	const block = Instance.new("Part")
+	block.Name = blockType.Name
+	block.Anchored = true
+	block.Size = Vector3.one * cellSize
+	block.CFrame = CFrame.new(cellCenter)
+	block.Color = blockType.Color
+	block.Material = blockType.Material
+	block.Transparency = blockType.Transparency
+	block.TopSurface = Enum.SurfaceType.Smooth
+	block.BottomSurface = Enum.SurfaceType.Smooth
+	block:SetAttribute(BLOCK_TYPE_ATTRIBUTE, blockType.Name)
+
+	const folder = getBlocksFolder()
+	block.AncestryChanged:Connect(function()
+		if not block:IsDescendantOf(folder) and blocksByCell[cellKey] == block then
+			blocksByCell[cellKey] = nil
+		end
+	end)
+
+	blocksByCell[cellKey] = block
+	block.Parent = folder
+end
+
+local function onPlaceBlockRequested(player: Player, blockTypeName: unknown, position: unknown)
+	-- Deferred events can arrive after PlayerRemoving, and would re-create the
+	-- player's rate entry and keep the Player alive.
+	if not player.Parent then
+		return
+	end
+
+	if not tryCountRequest(player) then
+		reject(player, "RateLimited")
+		return
+	end
+
+	if typeof(blockTypeName) ~= "string" then
+		reject(player, "InvalidBlockType")
+		return
+	end
+	const blockType = Module:GetBlockType(blockTypeName)
+	if not blockType then
+		reject(player, "InvalidBlockType")
+		return
+	end
+
+	if typeof(position) ~= "Vector3" or not isSanePosition(position) then
+		reject(player, "InvalidPosition")
+		return
+	end
+
+	const cellSize = Module:GetCellSize()
+	if not cellSize then
+		return
+	end
+	const cellCenter = Module:GetCellCenter(position)
+
+	-- With no ground to measure from, no cell can be shown to be above it.
+	const floorHeight = getFloorHeight()
+	if not floorHeight or cellCenter.Y - cellSize / 2 < floorHeight - GROUND_EPSILON then
+		reject(player, "BelowGround")
+		return
+	end
+
+	const characterPosition = getCharacterPosition(player)
+	if not characterPosition then
+		reject(player, "NoCharacter")
+		return
+	end
+	if (cellCenter - characterPosition).Magnitude > MAX_PLACE_DISTANCE then
+		reject(player, "TooFar")
+		return
+	end
+
+	const cellKey = getCellKey(cellCenter, cellSize)
+	if blocksByCell[cellKey] then
+		reject(player, "Occupied")
+		return
+	end
+
+	placeBlock(blockType, cellCenter, cellKey, cellSize)
+end
+
+local function onPlayerRemoving(player: Player)
+	requestTimesByPlayer[player] = nil
+end
+
+--[[
+	Calls the listener each time the server turns down a placement request.
+	Returns a function that disconnects it.
+]]
+function Module:ConnectPlacementRejected(listener: RejectionListener): () -> ()
+	table.insert(rejectionListeners, listener)
+
+	return function()
+		const index = table.find(rejectionListeners, listener)
+		if index then
+			table.remove(rejectionListeners, index)
+		end
+	end
+end
+
+function Module:Init()
+	getBlocksFolder()
+	BlockPlacementNetwork.PlaceBlock.OnServerEvent:Connect(onPlaceBlockRequested)
+	Players.PlayerRemoving:Connect(onPlayerRemoving)
+end
+
+return Module
