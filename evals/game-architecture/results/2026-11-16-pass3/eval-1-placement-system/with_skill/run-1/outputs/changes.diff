diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementSharedService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementSharedService.luau
new file mode 100644
index 0000000..c23138c
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementSharedService.luau
@@ -0,0 +1,95 @@
+--!strict
+--[[
+	Placement settings both realms read: the block types players can place, in
+	selection order, the grid cell size, and the tags that mark ground parts.
+	A setup registers them, and readers look them up on each use, so the order
+	of registration never matters.
+]]
+
+const CollectionService = game:GetService("CollectionService")
+
+const Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+const BlockPlacementTypes = require("./BlockPlacementTypes")
+
+type BlockType = BlockPlacementTypes.BlockType
+
+const Module = {}
+Module.__index = Module
+
+-- Placed blocks are parented to a Workspace folder of this name.
+Module.BlocksFolderName = "PlacedBlocks"
+
+local blockTypes: { BlockType } = {}
+local blockTypesByName: { [string]: BlockType? } = {}
+local groundTags: { string } = {}
+local cellSize: number? = nil
+
+--[[
+	Adds a block type players can place. Types are selected by the order they
+	are registered in.
+]]
+function Module:RegisterBlockType(blockType: BlockType)
+	if blockTypesByName[blockType.Name] then
+		error(`Block type {blockType.Name} is already registered`)
+	end
+
+	table.insert(blockTypes, blockType)
+	blockTypesByName[blockType.Name] = blockType
+end
+
+function Module:GetBlockType(name: string): BlockType?
+	return blockTypesByName[name]
+end
+
+function Module:GetBlockTypes(): { BlockType }
+	return table.freeze(table.clone(blockTypes))
+end
+
+--[[
+	Sets the edge length of a block and of a grid cell, in studs.
+]]
+function Module:SetCellSize(size: number)
+	assert(size > 0, "Cell size must be positive")
+	cellSize = size
+end
+
+function Module:GetCellSize(): number?
+	return cellSize
+end
+
+--[[
+	Returns the center of the grid cell containing the position. Errors when
+	no cell size is set.
+]]
+function Module:GetCellCenter(position: Vector3): Vector3
+	assert(cellSize, "Cell size is not set")
+	return Grid.snapToCell(position, cellSize)
+end
+
+--[[
+	Marks parts with this tag as ground: players can build on them, and no
+	block may go below the lowest one.
+]]
+function Module:RegisterGroundTag(tag: string)
+	if table.find(groundTags, tag) then
+		return
+	end
+
+	table.insert(groundTags, tag)
+end
+
+function Module:GetGroundParts(): { BasePart }
+	const parts: { BasePart } = {}
+	for _, tag in groundTags do
+		for _, instance in CollectionService:GetTagged(tag) do
+			if instance:IsA("BasePart") then
+				table.insert(parts, instance)
+			end
+		end
+	end
+
+	return parts
+end
+
+return Module
diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau
new file mode 100644
index 0000000..214387d
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau
@@ -0,0 +1,22 @@
+--!strict
+--[[
+	Types shared by the block placement modules.
+]]
+
+export type BlockType = {
+	Name: string,
+	Color: Color3,
+	Material: Enum.Material,
+	Transparency: number,
+}
+
+export type Rejection =
+	"RateLimited"
+	| "InvalidBlockType"
+	| "InvalidPosition"
+	| "BelowGround"
+	| "NoCharacter"
+	| "TooFar"
+	| "Occupied"
+
+return {}
