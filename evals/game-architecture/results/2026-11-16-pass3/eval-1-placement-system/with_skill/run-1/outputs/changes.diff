+--!strict
+--[[
+	Feeds this game's block catalog, grid size, and ground tag into block
+	placement, on the server and on every client.
+]]
+
+const BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+
+const BlockPlacementSharedService = require("../SystemPackage/BlockPlacementSharedService")
+
+-- Keep in sync with the Tags of Workspace.Baseplate in default.project.json.
+const GROUND_TAG = "BuildGround"
+
+const Module = {}
+
+function Module:Init()
+	BlockPlacementSharedService:SetCellSize(BlockTypes.BlockSize)
+	BlockPlacementSharedService:RegisterGroundTag(GROUND_TAG)
+	for _, blockType in BlockTypes.List do
+		BlockPlacementSharedService:RegisterBlockType(blockType)
+	end
+end
+
+return Module
