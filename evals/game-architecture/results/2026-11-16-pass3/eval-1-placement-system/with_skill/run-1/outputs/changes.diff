diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementClientService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementClientService.luau
new file mode 100644
index 0000000..0ffa1a2
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementClientService.luau
@@ -0,0 +1,108 @@
+--!strict
+--[[
+	Turns player input into placement requests. Number keys pick the block type
+	by registration order, and a click or a tap in the world asks the server to
+	place the selected block in the cell beside the surface hit.
+]]
+
+const UserInputService = game:GetService("UserInputService")
+
+const BlockPlacementNetwork = require("./BlockPlacementNetwork")
+const BlockPlacementSharedService = require("./BlockPlacementSharedService")
+const BlockPlacementTypes = require("./BlockPlacementTypes")
+
+const SELECTION_KEYS = {
+	Enum.KeyCode.One,
+	Enum.KeyCode.Two,
+	Enum.KeyCode.Three,
+	Enum.KeyCode.Four,
+	Enum.KeyCode.Five,
+}
+-- Longer than any reach the server allows, so a click out of reach still
+-- reaches the server and the player hears why it failed.
+const MAX_RAY_LENGTH = 1000
+
+type BlockType = BlockPlacementTypes.BlockType
+
+const Module = setmetatable({}, BlockPlacementSharedService)
+
+local selectedIndex = 1
+
+local function requestPlacementAlong(ray: Ray)
+	const blockType = Module:GetSelectedBlockType()
+	const cellSize = Module:GetCellSize()
+	if not blockType or not cellSize then
+		return
+	end
+
+	const targets: { Instance } = {}
+	for _, part in Module:GetGroundParts() do
+		table.insert(targets, part)
+	end
+	const blocksFolder = workspace:FindFirstChild(Module.BlocksFolderName)
+	if blocksFolder then
+		table.insert(targets, blocksFolder)
+	end
+
+	const raycastParams = RaycastParams.new()
+	raycastParams.FilterType = Enum.RaycastFilterType.Include
+	raycastParams.FilterDescendantsInstances = targets
+
+	const direction = ray.Direction.Unit * MAX_RAY_LENGTH
+	const result = workspace:Raycast(ray.Origin, direction, raycastParams)
+	if not result then
+		return
+	end
+
+	-- Half a cell out along the face normal lands in the neighboring cell.
+	const cellCenter = Module:GetCellCenter(result.Position + result.Normal * (cellSize / 2))
+	BlockPlacementNetwork.PlaceBlock:FireServer(blockType.Name, cellCenter)
+end
+
+local function onInputBegan(input: InputObject, isProcessed: boolean)
+	if isProcessed then
+		return
+	end
+
+	if input.UserInputType == Enum.UserInputType.MouseButton1 then
+		const camera = workspace.CurrentCamera
+		const mouseLocation = UserInputService:GetMouseLocation()
+		requestPlacementAlong(camera:ViewportPointToRay(mouseLocation.X, mouseLocation.Y))
+	elseif input.UserInputType == Enum.UserInputType.Keyboard then
+		const index = table.find(SELECTION_KEYS, input.KeyCode)
+		if index then
+			Module:SelectBlockType(index)
+		end
+	end
+end
+
+-- Taps that drag the camera or hit UI never fire this, unlike raw touch input.
+local function onTouchTapInWorld(position: Vector2, isProcessed: boolean)
+	if isProcessed then
+		return
+	end
+
+	const camera = workspace.CurrentCamera
+	requestPlacementAlong(camera:ScreenPointToRay(position.X, position.Y))
+end
+
+--[[
+	Selects the block type at this position in registration order. Ignores an
+	index with no block type.
+]]
+function Module:SelectBlockType(index: number)
+	if Module:GetBlockTypes()[index] then
+		selectedIndex = index
+	end
+end
+
+function Module:GetSelectedBlockType(): BlockType?
+	return Module:GetBlockTypes()[selectedIndex]
+end
+
+function Module:Init()
+	UserInputService.InputBegan:Connect(onInputBegan)
+	UserInputService.TouchTapInWorld:Connect(onTouchTapInWorld)
+end
+
+return Module
