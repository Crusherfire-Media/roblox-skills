@@ -0,0 +1,50 @@
+--!strict
+--[[
+	Tells a player with a notification when a block they tried to place is out
+	of reach.
+]]
+
+const Players = game:GetService("Players")
+
+const BlockPlacementServerService = require("../SystemPackage/BlockPlacementServerService")
+const NotificationServerService = require(
+	"@game/ServerScriptService/Modules/Systems/Core/NotificationSystem/SystemPackage/NotificationServerService"
+)
+
+const TOO_FAR_MESSAGE = "That spot is too far away. Move closer to build there."
+-- A player clicking far away 10 times a second would otherwise get a stack of
+-- identical notifications.
+const NOTIFY_COOLDOWN_SECONDS = 1
+
+const BlockPlacementTypes = require("../SystemPackage/BlockPlacementTypes")
+type Rejection = BlockPlacementTypes.Rejection
+
+const Module = {}
+
+local lastNotifiedAtByPlayer: { [Player]: number? } = {}
+
+local function onPlacementRejected(player: Player, rejection: Rejection)
+	if rejection ~= "TooFar" or not player.Parent then
+		return
+	end
+
+	const now = os.clock()
+	const lastNotifiedAt = lastNotifiedAtByPlayer[player]
+	if lastNotifiedAt and now - lastNotifiedAt < NOTIFY_COOLDOWN_SECONDS then
+		return
+	end
+
+	lastNotifiedAtByPlayer[player] = now
+	NotificationServerService:Notify(player, TOO_FAR_MESSAGE)
+end
+
+local function onPlayerRemoving(player: Player)
+	lastNotifiedAtByPlayer[player] = nil
+end
+
+function Module:Init()
+	BlockPlacementServerService:ConnectPlacementRejected(onPlacementRejected)
+	Players.PlayerRemoving:Connect(onPlayerRemoving)
+end
+
+return Module
