 	part.Parent = blocksFolder
 end
 
+local function onRemoveBlock(player: Player, block: unknown)
+	if typeof(block) ~= "Instance" or not block:IsA("BasePart") then
+		return
+	end
+
+	-- Only blocks this script placed are in the table, so this also rejects any other part.
+	local info = blockInfo[block]
+	if not info or info.ownerUserId ~= player.UserId then
+		return
+	end
