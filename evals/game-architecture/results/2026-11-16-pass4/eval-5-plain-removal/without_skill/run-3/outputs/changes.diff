+--[[
+	Checks the player isn't acting too fast and that the cell is within reach of their character.
+	Returns the current time to record if the action goes ahead, or nil if it must be refused.
+]]
+local function checkRateAndReach(player: Player, cell: Vector3): number?
+	local now = os.clock()
+	if now - (lastActionAt[player] or 0) < MIN_INTERVAL then
