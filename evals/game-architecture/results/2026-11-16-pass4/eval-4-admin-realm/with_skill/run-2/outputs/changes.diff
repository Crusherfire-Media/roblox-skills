 	return screenGui
 end
 
-function AdminClientService:Start()
-	local player = Players.LocalPlayer
-	if not self:IsAdmin(player.UserId) then
-		return
-	end
+local function showPanel(player: Player)
 	local playerGui = player:FindFirstChildOfClass("PlayerGui")
 	if playerGui then
 		createPanel().Parent = playerGui
 	end
 end
 
+function AdminClientService:Start()
+	local player = Players.LocalPlayer
+	local attribute = AdminSharedService.IsAdminAttribute
+	if player:GetAttribute(attribute) == true then
+		showPanel(player)
+		return
+	end
+
+	-- The server's attribute can replicate after this runs.
+	local connection: RBXScriptConnection
+	connection = player:GetAttributeChangedSignal(attribute):Connect(function()
+		if player:GetAttribute(attribute) == true then
+			connection:Disconnect()
+			showPanel(player)
+		end
+	end)
+end
+
 return AdminClientService
