@@ -0,0 +1,24 @@
+--[[
+	Makes blocks cost coins. Placing a block takes its price from the player's coins; a player who
+	can't afford it places nothing and is told how many more coins they need.
+]]
+
+local PlacementServerService = require(
+	"@game/ServerScriptService/Modules/Systems/Gameplay/PlacementSystem/SystemPackage/PlacementServerService"
+)
+local CurrencyServerService = require("../SystemPackage/CurrencyServerService")
+
+local BlockCostMediator = {}
+
+function BlockCostMediator:Init()
+	PlacementServerService:SetPaymentHandler(function(player, blockType)
+		if CurrencyServerService:TrySpend(player, blockType.Price) then
+			return true
+		end
+		local shortfall = blockType.Price - CurrencyServerService:GetCoins(player)
+		return false,
+			`You need {shortfall} more {if shortfall == 1 then "coin" else "coins"} to place {blockType.DisplayName}.`
+	end)
+end
+
+return BlockCostMediator
