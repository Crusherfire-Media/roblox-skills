index 0000000..fc4e3c5
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementClientService.luau
@@ -0,0 +1,91 @@
+--[[
+	Turns clicks and taps on build surfaces and placed blocks into placement requests, and picks
+	the selected block type with the number keys, in catalog order.
+]]
+
+local Players = game:GetService("Players")
+local UserInputService = game:GetService("UserInputService")
+
+local BlockPlacementNetwork = require("./BlockPlacementNetwork")
+local BlockPlacementSharedService = require("./BlockPlacementSharedService")
+local Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+local RAY_LENGTH = 1000
+local NUMBER_KEYS = {
+	Enum.KeyCode.One,
+	Enum.KeyCode.Two,
+	Enum.KeyCode.Three,
+	Enum.KeyCode.Four,
+	Enum.KeyCode.Five,
+	Enum.KeyCode.Six,
+	Enum.KeyCode.Seven,
+	Enum.KeyCode.Eight,
+	Enum.KeyCode.Nine,
+}
+
+local BlockPlacementClientService = setmetatable({}, BlockPlacementSharedService)
+
+local selectedIndex = 1
+
+local function isBuildTarget(instance: Instance): boolean
+	return instance:HasTag(BlockPlacementSharedService.BuildSurfaceTag)
+		or instance:HasTag(BlockPlacementSharedService.PlacedBlockTag)
+end
+
+local function requestPlacementAt(screenPosition: Vector2)
+	local blockType = BlockPlacementClientService:GetBlockTypes()[selectedIndex]
+	local camera = workspace.CurrentCamera
+	if not blockType or not camera then
+		return
+	end
+
+	local raycastParams = RaycastParams.new()
+	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
+	local character = Players.LocalPlayer.Character
+	if character then
+		raycastParams.FilterDescendantsInstances = { character }
+	end
+
+	local ray = camera:ScreenPointToRay(screenPosition.X, screenPosition.Y)
+	local result = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, raycastParams)
+	if not result or not isBuildTarget(result.Instance) then
+		return
+	end
+
+	-- Half a cell out along the face normal lands in the empty cell beside the clicked face.
+	local cellSize = BlockPlacementClientService:GetCellSize()
+	local cellCenter = Grid.snapToCell(result.Position + result.Normal * (cellSize / 2), cellSize)
+	BlockPlacementNetwork.PlaceBlock:FireServer(blockType.Name, cellCenter)
+end
+
+local function onInputBegan(input: InputObject, gameProcessedEvent: boolean)
+	if gameProcessedEvent then
+		return
+	end
+
+	if input.UserInputType == Enum.UserInputType.MouseButton1 then
+		requestPlacementAt(Vector2.new(input.Position.X, input.Position.Y))
+		return
+	end
+
+	local index = table.find(NUMBER_KEYS, input.KeyCode)
+	if index and index <= #BlockPlacementClientService:GetBlockTypes() then
+		selectedIndex = index
+	end
+end
+
+local function onTouchTapInWorld(position: Vector2, processedByUI: boolean)
+	if processedByUI then
+		return
+	end
+
+	requestPlacementAt(position)
+end
+
+function BlockPlacementClientService:Init()
+	UserInputService.InputBegan:Connect(onInputBegan)
+	-- TouchTapInWorld skips drags, so swiping the camera on a phone places nothing.
+	UserInputService.TouchTapInWorld:Connect(onTouchTapInWorld)
+end
+
+return BlockPlacementClientService
