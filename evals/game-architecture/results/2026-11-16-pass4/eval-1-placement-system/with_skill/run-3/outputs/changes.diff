index 0000000..bb621d6
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau
@@ -0,0 +1,30 @@
+--[[
+	Types shared by the block placement services and the setups that configure them.
+]]
+
+export type BlockType = {
+	Name: string,
+	DisplayName: string,
+	Color: Color3,
+	Material: Enum.Material,
+	Transparency: number,
+}
+
+export type Rules = {
+	-- World height of the lowest allowed block bottom.
+	FloorHeight: number,
+	-- Studs from the character's root part to the center of the target cell.
+	MaxDistance: number,
+	MaxPlacementsPerSecond: number,
+}
+
+export type RejectReason =
+	"UnknownBlockType"
+	| "InvalidPosition"
+	| "BelowFloor"
+	| "RateLimited"
+	| "NoCharacter"
+	| "TooFar"
+	| "Occupied"
+
+return {}
