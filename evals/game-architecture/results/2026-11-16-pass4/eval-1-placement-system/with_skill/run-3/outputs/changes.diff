diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
new file mode 100644
index 0000000..5412667
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
@@ -0,0 +1,178 @@
+--[[
+	Checks every placement request from clients and places the blocks that pass.
+]]
+
+local Players = game:GetService("Players")
+
+local BlockPlacementNetwork = require("./BlockPlacementNetwork")
+local BlockPlacementSharedService = require("./BlockPlacementSharedService")
+local Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+local BlockPlacementTypes = require("./BlockPlacementTypes")
+
+type BlockType = BlockPlacementTypes.BlockType
+type RejectReason = BlockPlacementTypes.RejectReason
+type Rules = BlockPlacementTypes.Rules
+
+-- Studs a requested position may sit from its cell's center, to absorb float error in the
+-- client's grid math.
+local CELL_CENTER_TOLERANCE = 0.01
+local RATE_WINDOW_SECONDS = 1
+
+local BlockPlacementServerService = setmetatable({}, BlockPlacementSharedService)
+
+local rules: Rules? = nil
+local blocksFolder: Folder? = nil
+local blocksByCell: { [Vector3]: BasePart? } = {}
+local placementTimesByPlayer: { [Player]: { number }? } = {}
+local rejectedCallbacks: { (Player, RejectReason) -> () } = {}
+
+local function reject(player: Player, reason: RejectReason)
+	for _, callback in rejectedCallbacks do
+		task.spawn(callback, player, reason)
+	end
+end
+
+local function hasPlacementsLeft(player: Player, now: number, maxPlacements: number): boolean
+	local times = placementTimesByPlayer[player]
+	if not times then
+		return true
+	end
+
+	local cutoff = now - RATE_WINDOW_SECONDS
+	while times[1] and times[1] <= cutoff do
+		table.remove(times, 1)
+	end
+
+	return #times < maxPlacements
+end
+
+local function recordPlacement(player: Player, now: number)
+	local times = placementTimesByPlayer[player]
+	if times then
+		table.insert(times, now)
+	else
+		placementTimesByPlayer[player] = { now }
+	end
+end
+
+local function createBlock(blockType: BlockType, cellCenter: Vector3, cellSize: number)
+	local block = Instance.new("Part")
+	block.Name = blockType.Name
+	block.Anchored = true
+	block.Size = Vector3.one * cellSize
+	block.Position = cellCenter
+	block.Color = blockType.Color
+	block.Material = blockType.Material
+	block.Transparency = blockType.Transparency
+	block.TopSurface = Enum.SurfaceType.Smooth
+	block.BottomSurface = Enum.SurfaceType.Smooth
+	block:AddTag(BlockPlacementSharedService.PlacedBlockTag)
+	block.Parent = blocksFolder
+
+	blocksByCell[cellCenter] = block
+	block.Destroying:Once(function()
+		if blocksByCell[cellCenter] == block then
+			blocksByCell[cellCenter] = nil
+		end
+	end)
+end
+
+local function onPlaceBlock(player: Player, blockTypeName: unknown, position: unknown)
+	assert(rules, "Placement rules are not set; call SetRules from a setup")
+
+	if typeof(blockTypeName) ~= "string" then
+		reject(player, "UnknownBlockType")
+		return
+	end
+	local blockType = BlockPlacementServerService:GetBlockType(blockTypeName)
+	if not blockType then
+		reject(player, "UnknownBlockType")
+		return
+	end
+
+	if typeof(position) ~= "Vector3" then
+		reject(player, "InvalidPosition")
+		return
+	end
+	local cellSize = BlockPlacementServerService:GetCellSize()
+	local cellCenter = Grid.snapToCell(position, cellSize)
+	-- Written as "not <=" so NaN and infinite components, whose offset is NaN, fail it too
+	if not ((cellCenter - position).Magnitude <= CELL_CENTER_TOLERANCE) then
+		reject(player, "InvalidPosition")
+		return
+	end
+
+	if cellCenter.Y - cellSize / 2 < rules.FloorHeight - CELL_CENTER_TOLERANCE then
+		reject(player, "BelowFloor")
+		return
+	end
+
+	local now = os.clock()
+	if not hasPlacementsLeft(player, now, rules.MaxPlacementsPerSecond) then
+		reject(player, "RateLimited")
+		return
+	end
+
+	local character = player.Character
+	local rootPart = character and character.PrimaryPart
+	if not rootPart then
+		reject(player, "NoCharacter")
+		return
+	end
+	if (rootPart.Position - cellCenter).Magnitude > rules.MaxDistance then
+		reject(player, "TooFar")
+		return
+	end
+
+	if blocksByCell[cellCenter] then
+		reject(player, "Occupied")
+		return
+	end
+
+	recordPlacement(player, now)
+	createBlock(blockType, cellCenter, cellSize)
+end
+
+local function onPlayerRemoving(player: Player)
+	placementTimesByPlayer[player] = nil
+end
+
+--[[
+	Sets the limits every placement request is checked against. Requests that arrive before
+	this is called error.
+]]
+function BlockPlacementServerService:SetRules(newRules: Rules)
+	assert(newRules.MaxDistance > 0, "MaxDistance must be positive")
+	assert(newRules.MaxPlacementsPerSecond > 0, "MaxPlacementsPerSecond must be positive")
+	rules = newRules
+end
+
+--[[
+	Lets players place blocks against the part.
+]]
+function BlockPlacementServerService:AddBuildSurface(part: BasePart)
+	part:AddTag(BlockPlacementSharedService.BuildSurfaceTag)
+end
+
+--[[
+	Calls the callback in a new thread each time the server turns down a placement request.
+]]
+function BlockPlacementServerService:OnPlacementRejected(callback: (
+	player: Player,
+	reason: RejectReason
+) -> ())
+	table.insert(rejectedCallbacks, callback)
+end
+
+function BlockPlacementServerService:Init()
+	local folder = Instance.new("Folder")
+	folder.Name = "PlacedBlocks"
+	folder.Parent = workspace
+	blocksFolder = folder
+
+	BlockPlacementNetwork.PlaceBlock.OnServerEvent:Connect(onPlaceBlock)
+	Players.PlayerRemoving:Connect(onPlayerRemoving)
+end
+
+return BlockPlacementServerService
