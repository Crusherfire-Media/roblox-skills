+--[[
+	Makes the baseplate buildable and sets this game's placement limits.
+]]
+
+local BlockPlacementServerService = require("../SystemPackage/BlockPlacementServerService")
+
+local MAX_DISTANCE = 64
+local MAX_PLACEMENTS_PER_SECOND = 10
+
+local BlockPlacementServerSetup = {}
+
+function BlockPlacementServerSetup:Init()
+	local baseplate = workspace:FindFirstChild("Baseplate")
+	assert(baseplate and baseplate:IsA("BasePart"), "Workspace needs a Baseplate part")
+
+	BlockPlacementServerService:AddBuildSurface(baseplate)
+	BlockPlacementServerService:SetRules({
+		FloorHeight = baseplate.Position.Y + baseplate.Size.Y / 2,
+		MaxDistance = MAX_DISTANCE,
+		MaxPlacementsPerSecond = MAX_PLACEMENTS_PER_SECOND,
+	})
+end
+
+return BlockPlacementServerSetup
