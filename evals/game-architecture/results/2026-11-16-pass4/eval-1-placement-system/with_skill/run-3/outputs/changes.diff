index 0000000..6074513
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementSharedService.luau
@@ -0,0 +1,51 @@
+--[[
+	Block types and grid size for block placement, read by both realms. A setup provides them
+	with SetBlockTypes.
+]]
+
+local BlockPlacementTypes = require("./BlockPlacementTypes")
+
+type BlockType = BlockPlacementTypes.BlockType
+
+local BlockPlacementSharedService = {
+	BuildSurfaceTag = "BuildSurface",
+	PlacedBlockTag = "PlacedBlock",
+}
+BlockPlacementSharedService.__index = BlockPlacementSharedService
+
+local blockTypes: { BlockType } = {}
+local blockTypesByName: { [string]: BlockType? } = {}
+local cellSize: number? = nil
+
+--[[
+	Sets the placeable block types, in selection order, and the edge length of a grid cell
+	in studs.
+]]
+function BlockPlacementSharedService:SetBlockTypes(
+	newBlockTypes: { BlockType },
+	newCellSize: number
+)
+	assert(newCellSize > 0, "Cell size must be positive")
+
+	blockTypes = newBlockTypes
+	blockTypesByName = {}
+	for _, blockType in newBlockTypes do
+		blockTypesByName[blockType.Name] = blockType
+	end
+	cellSize = newCellSize
+end
+
+function BlockPlacementSharedService:GetBlockTypes(): { BlockType }
+	return blockTypes
+end
+
+function BlockPlacementSharedService:GetBlockType(name: string): BlockType?
+	return blockTypesByName[name]
+end
+
+function BlockPlacementSharedService:GetCellSize(): number
+	assert(cellSize, "Cell size is not set; call SetBlockTypes from a setup")
+	return cellSize
+end
+
+return BlockPlacementSharedService
diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau
