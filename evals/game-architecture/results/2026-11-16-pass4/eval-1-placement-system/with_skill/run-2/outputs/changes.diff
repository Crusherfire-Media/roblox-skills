index 0000000..05a8847
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementClientService.luau
@@ -0,0 +1,108 @@
+--[[
+	Turns clicks, taps, and number keys into placement requests. The server checks every
+	request, so nothing here is trusted.
+]]
+
+local Players = game:GetService("Players")
+local UserInputService = game:GetService("UserInputService")
+local Workspace = workspace
+
+local BlockPlacementNetwork = require("./BlockPlacementNetwork")
+local BlockPlacementSharedService = require("./BlockPlacementSharedService")
+local BlockPlacementTypes = require("./BlockPlacementTypes")
+
+type BlockType = BlockPlacementTypes.BlockType
+
+local RAY_LENGTH = 1000
+
+-- In block type order: the first key selects the first registered block type.
+local SELECT_KEYS = {
+	Enum.KeyCode.One,
+	Enum.KeyCode.Two,
+	Enum.KeyCode.Three,
+	Enum.KeyCode.Four,
+	Enum.KeyCode.Five,
+	Enum.KeyCode.Six,
+	Enum.KeyCode.Seven,
+	Enum.KeyCode.Eight,
+	Enum.KeyCode.Nine,
+}
+
+local selectedIndex = 1
+
+local BlockPlacementClientService = setmetatable({}, BlockPlacementSharedService)
+
+local function requestPlacementAt(screenRay: Ray)
+	local blockType = BlockPlacementClientService:GetSelectedBlockType()
+	if not blockType then
+		return
+	end
+
+	local raycastParams = RaycastParams.new()
+	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
+	local character = Players.LocalPlayer.Character
+	if character then
+		raycastParams.FilterDescendantsInstances = { character }
+	end
+
+	local result =
+		Workspace:Raycast(screenRay.Origin, screenRay.Direction * RAY_LENGTH, raycastParams)
+	if not result or not BlockPlacementClientService:IsPlacementSurface(result.Instance) then
+		return
+	end
+
+	local cellCenter = BlockPlacementClientService:GetAdjacentCell(result.Position, result.Normal)
+	if not cellCenter then
+		return
+	end
+
+	BlockPlacementNetwork.PlaceBlock:FireServer(blockType.Name, cellCenter)
+end
+
+local function onInputBegan(input: InputObject, gameProcessedEvent: boolean)
+	if gameProcessedEvent then
+		return
+	end
+
+	if input.UserInputType == Enum.UserInputType.MouseButton1 then
+		local camera = Workspace.CurrentCamera
+		-- InputObject.Position leaves out the top bar inset, which ScreenPointToRay expects.
+		requestPlacementAt(camera:ScreenPointToRay(input.Position.X, input.Position.Y))
+		return
+	end
+
+	local keyIndex = table.find(SELECT_KEYS, input.KeyCode)
+	if keyIndex then
+		BlockPlacementClientService:SelectBlockType(keyIndex)
+	end
+end
+
+local function onTouchTapInWorld(position: Vector2, processedByUi: boolean)
+	if processedByUi then
+		return
+	end
+
+	-- Tap positions include the top bar inset, unlike InputObject.Position.
+	requestPlacementAt(Workspace.CurrentCamera:ViewportPointToRay(position.X, position.Y))
+end
+
+--[[
+	Selects the block type at this position in the registered order. Does nothing for an
+	index with no block type.
+]]
+function BlockPlacementClientService:SelectBlockType(index: number)
+	if self:GetBlockTypes()[index] then
+		selectedIndex = index
+	end
+end
+
+function BlockPlacementClientService:GetSelectedBlockType(): BlockType?
+	return self:GetBlockTypes()[selectedIndex]
+end
+
+function BlockPlacementClientService:Init()
+	UserInputService.InputBegan:Connect(onInputBegan)
+	UserInputService.TouchTapInWorld:Connect(onTouchTapInWorld)
+end
+
+return BlockPlacementClientService
