+--[[
+	Feeds this game's block catalog and baseplate to block placement, on the server and on
+	each client.
+]]
+
+local Workspace = workspace
+
+local BlockPlacementSharedService = require("../SystemPackage/BlockPlacementSharedService")
+local BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+
+local FLOOR_NAME = "Baseplate"
+
+local BlockPlacementSetup = {}
+
+function BlockPlacementSetup:Init()
+	BlockPlacementSharedService:RegisterBlockTypes(BlockTypes.List)
+	BlockPlacementSharedService:RegisterBlockSize(BlockTypes.BlockSize)
+
+	-- With streaming on, the baseplate may not have reached the client yet.
+	task.spawn(function()
+		local floor = Workspace:WaitForChild(FLOOR_NAME)
+		if floor:IsA("BasePart") then
+			BlockPlacementSharedService:RegisterFloor(floor)
+		end
+	end)
+end
+
+return BlockPlacementSetup
