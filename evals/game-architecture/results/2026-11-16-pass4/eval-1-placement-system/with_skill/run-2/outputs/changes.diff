diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementSharedService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementSharedService.luau
new file mode 100644
index 0000000..de0bf8b
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementSharedService.luau
@@ -0,0 +1,100 @@
+--[[
+	Block placement state and grid rules that the server and the client both use. A setup
+	registers the block types, the block size, and the floor; until it does, nothing can be
+	placed.
+]]
+
+local CollectionService = game:GetService("CollectionService")
+
+local Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+local BlockPlacementTypes = require("./BlockPlacementTypes")
+
+type BlockType = BlockPlacementTypes.BlockType
+
+local PLACED_BLOCK_TAG = "PlacedBlock"
+
+local blockTypes: { BlockType } = {}
+local blockTypesByName: { [string]: BlockType? } = {}
+local blockSize: number? = nil
+local floor: BasePart? = nil
+
+local BlockPlacementSharedService = {}
+BlockPlacementSharedService.__index = BlockPlacementSharedService
+BlockPlacementSharedService.PlacedBlockTag = PLACED_BLOCK_TAG
+
+--[[
+	Sets the placeable block types. Their order is the order the number keys select them in.
+]]
+function BlockPlacementSharedService:RegisterBlockTypes(newBlockTypes: { BlockType })
+	blockTypes = table.clone(newBlockTypes)
+	table.clear(blockTypesByName)
+	for _, blockType in blockTypes do
+		blockTypesByName[blockType.Name] = blockType
+	end
+end
+
+--[[
+	Sets the edge length of every block, in studs. Blocks snap to a grid of this size.
+]]
+function BlockPlacementSharedService:RegisterBlockSize(size: number)
+	assert(size > 0 and size < math.huge, "Block size must be a positive finite number")
+	blockSize = size
+end
+
+--[[
+	Sets the part players build on. No block may go below its top face.
+]]
+function BlockPlacementSharedService:RegisterFloor(part: BasePart)
+	floor = part
+end
+
+function BlockPlacementSharedService:GetBlockTypes(): { BlockType }
+	return blockTypes
+end
+
+function BlockPlacementSharedService:GetBlockType(name: string): BlockType?
+	return blockTypesByName[name]
+end
+
+function BlockPlacementSharedService:GetBlockSize(): number?
+	return blockSize
+end
+
+--[[
+	Returns the height of the floor's top face, or nil before a floor is registered. Assumes the
+	floor is not rotated.
+]]
+function BlockPlacementSharedService:GetFloorTop(): number?
+	if not floor then
+		return nil
+	end
+
+	return floor.Position.Y + floor.Size.Y / 2
+end
+
+--[[
+	Whether a block may be placed against this instance: the floor or a placed block.
+]]
+function BlockPlacementSharedService:IsPlacementSurface(instance: Instance): boolean
+	return instance == floor or CollectionService:HasTag(instance, PLACED_BLOCK_TAG)
+end
+
+--[[
+	Returns the center of the cell next to a clicked face, given the hit position and the
+	face's normal, or nil before a block size is registered.
+]]
+function BlockPlacementSharedService:GetAdjacentCell(
+	hitPosition: Vector3,
+	normal: Vector3
+): Vector3?
+	if not blockSize then
+		return nil
+	end
+
+	-- Stepping half a cell off the face lands well inside the neighboring cell, so float
+	-- error at the face boundary can't snap back into the clicked cell.
+	return Grid.snapToCell(hitPosition + normal * (blockSize / 2), blockSize)
+end
+
+return BlockPlacementSharedService
diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau
new file mode 100644
index 0000000..d6dbdb5
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau
@@ -0,0 +1,22 @@
+--[[
+	Types shared by the block placement modules.
+]]
+
+-- Game catalogs may hold more fields than these.
+export type BlockType = {
+	Name: string,
+	Color: Color3,
+	Material: Enum.Material,
+	Transparency: number,
+}
+
+export type RejectReason =
+	"UnknownBlockType"
+	| "InvalidPosition"
+	| "BelowFloor"
+	| "Occupied"
+	| "NoCharacter"
+	| "TooFar"
+	| "RateLimited"
+
+return {}
