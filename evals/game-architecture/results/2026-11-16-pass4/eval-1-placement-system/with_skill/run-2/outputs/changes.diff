diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
new file mode 100644
index 0000000..160afe6
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
@@ -0,0 +1,222 @@
+--[[
+	Checks every placement request from clients and places the blocks that pass.
+]]
+
+local Players = game:GetService("Players")
+local Workspace = workspace
+
+local Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+local BlockPlacementNetwork = require("./BlockPlacementNetwork")
+local BlockPlacementSharedService = require("./BlockPlacementSharedService")
+local BlockPlacementTypes = require("./BlockPlacementTypes")
+
+type BlockType = BlockPlacementTypes.BlockType
+type RejectReason = BlockPlacementTypes.RejectReason
+type RejectedCallback = (player: Player, reason: RejectReason) -> ()
+
+local MAX_PLACE_DISTANCE = 64
+local MAX_PLACEMENTS_PER_WINDOW = 10
+local RATE_WINDOW_SECONDS = 1
+local BLOCKS_FOLDER_NAME = "PlacedBlocks"
+-- Studs trimmed from each side of a cell before checking it for parts, so parts that only
+-- touch a face (the floor, neighboring blocks) don't count as filling it.
+local OVERLAP_MARGIN = 0.1
+
+local occupiedCells: { [string]: BasePart? } = {}
+local recentPlacementTimes: { [Player]: { number }? } = {}
+local rejectedCallbacks: { RejectedCallback } = {}
+local blocksFolder: Folder? = nil
+
+local BlockPlacementServerService = setmetatable({}, BlockPlacementSharedService)
+
+local function getCellKey(cellCenter: Vector3, blockSize: number): string
+	-- Integer cell indices, so float error in a center can't split one cell in two.
+	return string.format(
+		"%d,%d,%d",
+		math.floor(cellCenter.X / blockSize),
+		math.floor(cellCenter.Y / blockSize),
+		math.floor(cellCenter.Z / blockSize)
+	)
+end
+
+local function isFiniteVector(vector: Vector3): boolean
+	for _, component in { vector.X, vector.Y, vector.Z } do
+		-- component ~= component catches NaN, which passes every range check
+		if component ~= component or math.abs(component) == math.huge then
+			return false
+		end
+	end
+
+	return true
+end
+
+--[[
+	Whether any part, a character included, sits inside the cell.
+]]
+local function isCellBlockedInWorld(cellCenter: Vector3, blockSize: number): boolean
+	local boxSize = Vector3.one * (blockSize - OVERLAP_MARGIN * 2)
+	return #Workspace:GetPartBoundsInBox(CFrame.new(cellCenter), boxSize) > 0
+end
+
+local function getBlocksFolder(): Folder
+	if blocksFolder and blocksFolder.Parent then
+		return blocksFolder
+	end
+
+	local folder = Instance.new("Folder")
+	folder.Name = BLOCKS_FOLDER_NAME
+	folder.Parent = Workspace
+	blocksFolder = folder
+	return folder
+end
+
+--[[
+	Records this request and returns whether it fits within the player's rate limit. Every
+	request counts, rejected ones included, so spamming bad requests also hits the limit.
+]]
+local function consumeRateLimit(player: Player): boolean
+	local now = os.clock()
+	local times = recentPlacementTimes[player] or {}
+	recentPlacementTimes[player] = times
+
+	while times[1] and now - times[1] >= RATE_WINDOW_SECONDS do
+		table.remove(times, 1)
+	end
+
+	if #times >= MAX_PLACEMENTS_PER_WINDOW then
+		return false
+	end
+
+	table.insert(times, now)
+	return true
+end
+
+local function getCharacterPosition(player: Player): Vector3?
+	local character = player.Character
+	if not character then
+		return nil
+	end
+
+	local rootPart = character:FindFirstChild("HumanoidRootPart")
+	if not rootPart or not rootPart:IsA("BasePart") then
+		return nil
+	end
+
+	return rootPart.Position
+end
+
+local function reject(player: Player, reason: RejectReason)
+	for _, callback in rejectedCallbacks do
+		task.spawn(callback, player, reason)
+	end
+end
+
+local function createBlock(blockType: BlockType, cellCenter: Vector3, blockSize: number): Part
+	local block = Instance.new("Part")
+	block.Name = blockType.Name
+	block.Anchored = true
+	block.Size = Vector3.one * blockSize
+	block.CFrame = CFrame.new(cellCenter)
+	block.Color = blockType.Color
+	block.Material = blockType.Material
+	block.Transparency = blockType.Transparency
+	block.TopSurface = Enum.SurfaceType.Smooth
+	block.BottomSurface = Enum.SurfaceType.Smooth
+	block:SetAttribute("BlockType", blockType.Name)
+	block:AddTag(BlockPlacementSharedService.PlacedBlockTag)
+	return block
+end
+
+local function onPlaceBlock(player: Player, blockTypeName: unknown, cellCenter: unknown)
+	if not consumeRateLimit(player) then
+		reject(player, "RateLimited")
+		return
+	end
+
+	if typeof(blockTypeName) ~= "string" then
+		reject(player, "UnknownBlockType")
+		return
+	end
+
+	local blockType = BlockPlacementServerService:GetBlockType(blockTypeName)
+	if not blockType then
+		reject(player, "UnknownBlockType")
+		return
+	end
+
+	local blockSize = BlockPlacementServerService:GetBlockSize()
+	if typeof(cellCenter) ~= "Vector3" or not blockSize or not isFiniteVector(cellCenter) then
+		reject(player, "InvalidPosition")
+		return
+	end
+
+	-- A center off the grid would let blocks overlap their neighbors.
+	if not Grid.snapToCell(cellCenter, blockSize):FuzzyEq(cellCenter, 1e-3) then
+		reject(player, "InvalidPosition")
+		return
+	end
+
+	local floorTop = BlockPlacementServerService:GetFloorTop()
+	if not floorTop then
+		reject(player, "InvalidPosition")
+		return
+	end
+
+	if cellCenter.Y - blockSize / 2 < floorTop - 1e-3 then
+		reject(player, "BelowFloor")
+		return
+	end
+
+	local characterPosition = getCharacterPosition(player)
+	if not characterPosition then
+		reject(player, "NoCharacter")
+		return
+	end
+
+	if (cellCenter - characterPosition).Magnitude > MAX_PLACE_DISTANCE then
+		reject(player, "TooFar")
+		return
+	end
+
+	local cellKey = getCellKey(cellCenter, blockSize)
+	if occupiedCells[cellKey] or isCellBlockedInWorld(cellCenter, blockSize) then
+		reject(player, "Occupied")
+		return
+	end
+
+	local block = createBlock(blockType, cellCenter, blockSize)
+	occupiedCells[cellKey] = block
+	block.Destroying:Connect(function()
+		if occupiedCells[cellKey] == block then
+			occupiedCells[cellKey] = nil
+		end
+	end)
+	block.Parent = getBlocksFolder()
+end
+
+local function onPlayerRemoving(player: Player)
+	recentPlacementTimes[player] = nil
+end
+
+--[[
+	Calls the callback with the player and the reason each time a placement request is
+	rejected. Returns a function that disconnects it.
+]]
+function BlockPlacementServerService:OnPlacementRejected(callback: RejectedCallback): () -> ()
+	table.insert(rejectedCallbacks, callback)
+
+	return function()
+		local index = table.find(rejectedCallbacks, callback)
+		if index then
+			table.remove(rejectedCallbacks, index)
+		end
+	end
+end
+
+function BlockPlacementServerService:Init()
+	BlockPlacementNetwork.PlaceBlock.OnServerEvent:Connect(onPlaceBlock)
+	Players.PlayerRemoving:Connect(onPlayerRemoving)
+end
+
+return BlockPlacementServerService
