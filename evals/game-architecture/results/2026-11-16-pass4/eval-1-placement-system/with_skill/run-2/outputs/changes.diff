@@ -0,0 +1,22 @@
+--[[
+	Tells a player with a notification when they try to place a block too far away.
+]]
+
+local BlockPlacementServerService = require("../SystemPackage/BlockPlacementServerService")
+local NotificationServerService = require(
+	"@game/ServerScriptService/Modules/Systems/Core/NotificationSystem/SystemPackage/NotificationServerService"
+)
+
+local TOO_FAR_MESSAGE = "That spot is too far away to build."
+
+local BlockPlacementNotificationMediator = {}
+
+function BlockPlacementNotificationMediator:Init()
+	BlockPlacementServerService:OnPlacementRejected(function(player, reason)
+		if reason == "TooFar" then
+			NotificationServerService:Notify(player, TOO_FAR_MESSAGE)
+		end
+	end)
+end
+
+return BlockPlacementNotificationMediator
