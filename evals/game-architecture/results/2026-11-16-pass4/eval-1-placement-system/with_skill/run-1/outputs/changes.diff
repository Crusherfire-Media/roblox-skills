index 0000000..9142393
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementClientService.luau
@@ -0,0 +1,96 @@
+--[[
+	Turns clicks and taps on the floor or a placed block into placement requests, and number keys
+	into the selected block type.
+]]
+
+local Players = game:GetService("Players")
+local UserInputService = game:GetService("UserInputService")
+
+local BlockPlacementNetwork = require("./BlockPlacementNetwork")
+local BlockPlacementSharedService = require("./BlockPlacementSharedService")
+local Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+local RAY_LENGTH = 1000
+-- In hotbar order: the first key selects the first registered block type.
+local SELECT_KEYS = {
+	Enum.KeyCode.One,
+	Enum.KeyCode.Two,
+	Enum.KeyCode.Three,
+	Enum.KeyCode.Four,
+	Enum.KeyCode.Five,
+	Enum.KeyCode.Six,
+	Enum.KeyCode.Seven,
+	Enum.KeyCode.Eight,
+	Enum.KeyCode.Nine,
+}
+
+local BlockPlacementClientService = setmetatable({}, BlockPlacementSharedService)
+
+local selectedIndex = 1
+
+local function isPlaceableSurface(part: BasePart): boolean
+	return part == BlockPlacementClientService:GetFloor()
+		or part:HasTag(BlockPlacementSharedService.BlockTag)
+end
+
+-- Input positions exclude the top bar inset, which ScreenPointToRay expects.
+local function placeAtScreenPoint(screenPoint: Vector2)
+	local camera = workspace.CurrentCamera
+	local blockType = BlockPlacementClientService:GetBlockTypes()[selectedIndex]
+	if not camera or not blockType then
+		return
+	end
+
+	local raycastParams = RaycastParams.new()
+	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
+	local character = Players.LocalPlayer.Character
+	if character then
+		raycastParams.FilterDescendantsInstances = { character }
+	end
+
+	local ray = camera:ScreenPointToRay(screenPoint.X, screenPoint.Y)
+	local result = workspace:Raycast(ray.Origin, ray.Direction * RAY_LENGTH, raycastParams)
+	if not result or not result.Instance:IsA("BasePart") then
+		return
+	end
+	if not isPlaceableSurface(result.Instance) then
+		return
+	end
+
+	-- Half a block out along the normal lands inside the neighboring cell, never on its edge.
+	local size = BlockPlacementClientService:GetBlockSize()
+	local cellCenter = Grid.snapToCell(result.Position + result.Normal * (size / 2), size)
+	BlockPlacementNetwork.PlaceBlock:FireServer(blockType.Name, cellCenter)
+end
+
+local function onInputBegan(input: InputObject, isProcessed: boolean)
+	if isProcessed then
+		return
+	end
+
+	if input.UserInputType == Enum.UserInputType.MouseButton1 then
+		placeAtScreenPoint(Vector2.new(input.Position.X, input.Position.Y))
+		return
+	end
+
+	local keyIndex = table.find(SELECT_KEYS, input.KeyCode)
+	if keyIndex and keyIndex <= #BlockPlacementClientService:GetBlockTypes() then
+		selectedIndex = keyIndex
+	end
+end
+
+-- TouchTapInWorld fires only for taps, so a drag that turns the camera never places a block.
+local function onTouchTapInWorld(position: Vector2, isProcessedByUi: boolean)
+	if isProcessedByUi then
+		return
+	end
+
+	placeAtScreenPoint(position)
+end
+
+function BlockPlacementClientService:Init()
+	UserInputService.InputBegan:Connect(onInputBegan)
+	UserInputService.TouchTapInWorld:Connect(onTouchTapInWorld)
+end
+
+return BlockPlacementClientService
