index 0000000..27079ca
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementSharedService.luau
@@ -0,0 +1,58 @@
+--[[
+	Placement settings both realms read. A setup registers the block types, the block size, and
+	the floor; registration can happen at any time, and later calls replace earlier ones.
+]]
+
+local BlockPlacementTypes = require("./BlockPlacementTypes")
+
+type BlockType = BlockPlacementTypes.BlockType
+
+local BlockPlacementSharedService = {}
+BlockPlacementSharedService.__index = BlockPlacementSharedService
+
+-- Tag on every placed block, so clients can tell blocks from other parts.
+BlockPlacementSharedService.BlockTag = "PlacedBlock"
+
+local blockTypes: { BlockType } = {}
+local blockTypesByName: { [string]: BlockType? } = {}
+local blockSize = 4
+local floor: BasePart? = nil
+
+--[[
+	Sets the placeable block types, in hotbar order, and the edge length of a block in studs.
+]]
+function BlockPlacementSharedService:RegisterBlockTypes(types: { BlockType }, size: number)
+	assert(size > 0, "Block size must be positive")
+
+	blockTypes = table.clone(types)
+	blockTypesByName = {}
+	for _, blockType in blockTypes do
+		blockTypesByName[blockType.Name] = blockType
+	end
+	blockSize = size
+end
+
+--[[
+	Sets the part players build on. No block may sit below its top surface.
+]]
+function BlockPlacementSharedService:RegisterFloor(part: BasePart)
+	floor = part
+end
+
+function BlockPlacementSharedService:GetBlockTypes(): { BlockType }
+	return blockTypes
+end
+
+function BlockPlacementSharedService:GetBlockType(name: string): BlockType?
+	return blockTypesByName[name]
+end
+
+function BlockPlacementSharedService:GetBlockSize(): number
+	return blockSize
+end
+
+function BlockPlacementSharedService:GetFloor(): BasePart?
+	return floor
+end
+
+return BlockPlacementSharedService
diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementTypes.luau
