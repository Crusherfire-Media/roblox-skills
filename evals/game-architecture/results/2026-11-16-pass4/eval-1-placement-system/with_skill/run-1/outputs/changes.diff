+--[[
+	Gives block placement this game's block types and the baseplate to build on, on both realms.
+]]
+
+local BlockPlacementSharedService = require("../SystemPackage/BlockPlacementSharedService")
+local BlockTypes = require("@game/ServerScriptService/Modules/Catalogs/BlockTypes")
+
+local _BlockPlacementSetup = {}
+
+function _BlockPlacementSetup:Init()
+	BlockPlacementSharedService:RegisterBlockTypes(BlockTypes.List, BlockTypes.BlockSize)
+
+	task.spawn(function()
+		local baseplate = workspace:WaitForChild("Baseplate") :: BasePart
+		BlockPlacementSharedService:RegisterFloor(baseplate)
+	end)
+end
+
+return _BlockPlacementSetup
