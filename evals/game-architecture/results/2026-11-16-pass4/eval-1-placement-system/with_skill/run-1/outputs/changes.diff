diff --git a/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
new file mode 100644
index 0000000..8fc7477
--- /dev/null
+++ b/src/ServerScriptService/Modules/Systems/Gameplay/BlockPlacementSystem/SystemPackage/BlockPlacementServerService.luau
@@ -0,0 +1,194 @@
+--[[
+	Checks each placement request from a client and places the block when every check passes.
+]]
+
+local Players = game:GetService("Players")
+
+local BlockPlacementNetwork = require("./BlockPlacementNetwork")
+local BlockPlacementSharedService = require("./BlockPlacementSharedService")
+local BlockPlacementTypes = require("./BlockPlacementTypes")
+local Grid = require("@game/ServerScriptService/Modules/Utilities/Grid")
+
+local MAX_PLACE_DISTANCE = 64
+local MAX_PLACEMENTS_PER_SECOND = 10
+-- Requests farther out than this are nonsense, so they never reach the grid math.
+local MAX_COORDINATE = 100000
+local ALIGNMENT_TOLERANCE = 0.001
+-- Shrinks the overlap box so parts that only touch a face of the cell don't count as filling it.
+local OVERLAP_MARGIN = 0.1
+
+type BlockType = BlockPlacementTypes.BlockType
+type RejectReason = BlockPlacementTypes.RejectReason
+
+local BlockPlacementServerService = setmetatable({}, BlockPlacementSharedService)
+
+local blocksFolder: Folder? = nil
+local occupiedCells: { [string]: BasePart? } = {}
+local recentRequestTimes: { [Player]: { number }? } = {}
+local rejectedCallbacks: { (Player, RejectReason) -> () } = {}
+
+local function isSaneCoordinate(value: number): boolean
+	return math.abs(value) <= MAX_COORDINATE
+end
+
+local function getCellKey(cellCenter: Vector3, size: number): string
+	local x = math.floor(cellCenter.X / size)
+	local y = math.floor(cellCenter.Y / size)
+	local z = math.floor(cellCenter.Z / size)
+	return `{x},{y},{z}`
+end
+
+-- A sliding one-second window, so no span of one second ever holds more than the limit.
+local function tryRecordRequest(player: Player): boolean
+	local now = os.clock()
+	local times = recentRequestTimes[player] or {}
+	recentRequestTimes[player] = times
+
+	while times[1] and now - times[1] >= 1 do
+		table.remove(times, 1)
+	end
+	if #times >= MAX_PLACEMENTS_PER_SECOND then
+		return false
+	end
+
+	table.insert(times, now)
+	return true
+end
+
+local function reject(player: Player, reason: RejectReason)
+	for _, callback in rejectedCallbacks do
+		task.spawn(callback, player, reason)
+	end
+end
+
+local function getCharacterPosition(player: Player): Vector3?
+	local character = player.Character
+	local rootPart = if character then character.PrimaryPart else nil
+	if not rootPart then
+		return nil
+	end
+
+	return rootPart.Position
+end
+
+local function isCellFilled(cellCenter: Vector3, size: number, floor: BasePart): boolean
+	if occupiedCells[getCellKey(cellCenter, size)] then
+		return true
+	end
+
+	local overlapParams = OverlapParams.new()
+	overlapParams.FilterType = Enum.RaycastFilterType.Exclude
+	overlapParams.FilterDescendantsInstances = { floor }
+	local boxSize = Vector3.one * (size - OVERLAP_MARGIN)
+	local parts = workspace:GetPartBoundsInBox(CFrame.new(cellCenter), boxSize, overlapParams)
+	return #parts > 0
+end
+
+local function createBlock(blockType: BlockType, cellCenter: Vector3, size: number): BasePart
+	local block = Instance.new("Part")
+	block.Name = blockType.Name
+	block.Anchored = true
+	block.Size = Vector3.one * size
+	block.Position = cellCenter
+	block.Color = blockType.Color
+	block.Material = blockType.Material
+	block.Transparency = blockType.Transparency
+	block.TopSurface = Enum.SurfaceType.Smooth
+	block.BottomSurface = Enum.SurfaceType.Smooth
+	block:SetAttribute("BlockType", blockType.Name)
+	block:AddTag(BlockPlacementSharedService.BlockTag)
+	return block
+end
+
+local function onPlaceBlock(player: Player, blockTypeName: unknown, cellCenter: unknown)
+	if not tryRecordRequest(player) then
+		reject(player, "RateLimited")
+		return
+	end
+
+	-- NaN fails every comparison, so the range check in isSaneCoordinate rejects it too.
+	if
+		typeof(blockTypeName) ~= "string"
+		or typeof(cellCenter) ~= "Vector3"
+		or not isSaneCoordinate(cellCenter.X)
+		or not isSaneCoordinate(cellCenter.Y)
+		or not isSaneCoordinate(cellCenter.Z)
+	then
+		reject(player, "InvalidRequest")
+		return
+	end
+
+	local blockType = BlockPlacementServerService:GetBlockType(blockTypeName)
+	if not blockType then
+		reject(player, "UnknownBlockType")
+		return
+	end
+
+	local size = BlockPlacementServerService:GetBlockSize()
+	local snappedCenter = Grid.snapToCell(cellCenter, size)
+	if (snappedCenter - cellCenter).Magnitude > ALIGNMENT_TOLERANCE then
+		reject(player, "InvalidRequest")
+		return
+	end
+
+	local floor = BlockPlacementServerService:GetFloor()
+	if not floor then
+		reject(player, "NotReady")
+		return
+	end
+
+	local floorTop = floor.Position.Y + floor.Size.Y / 2
+	if snappedCenter.Y - size / 2 < floorTop - ALIGNMENT_TOLERANCE then
+		reject(player, "BelowFloor")
+		return
+	end
+
+	local characterPosition = getCharacterPosition(player)
+	if not characterPosition then
+		reject(player, "NoCharacter")
+		return
+	end
+	if (snappedCenter - characterPosition).Magnitude > MAX_PLACE_DISTANCE then
+		reject(player, "TooFar")
+		return
+	end
+
+	if isCellFilled(snappedCenter, size, floor) then
+		reject(player, "Occupied")
+		return
+	end
+
+	local cellKey = getCellKey(snappedCenter, size)
+	local block = createBlock(blockType, snappedCenter, size)
+	occupiedCells[cellKey] = block
+	block.Destroying:Once(function()
+		if occupiedCells[cellKey] == block then
+			occupiedCells[cellKey] = nil
+		end
+	end)
+	block.Parent = blocksFolder
+end
+
+--[[
+	Calls the callback whenever the server turns down a placement request.
+]]
+function BlockPlacementServerService:OnPlacementRejected(callback: (
+	player: Player,
+	reason: RejectReason
+) -> ())
+	table.insert(rejectedCallbacks, callback)
+end
+
+function BlockPlacementServerService:Init()
+	local folder = Instance.new("Folder")
+	folder.Name = "PlacedBlocks"
+	folder.Parent = workspace
+	blocksFolder = folder
+
+	BlockPlacementNetwork.PlaceBlock.OnServerEvent:Connect(onPlaceBlock)
+	Players.PlayerRemoving:Connect(function(player)
+		recentRequestTimes[player] = nil
+	end)
+end
+
+return BlockPlacementServerService
