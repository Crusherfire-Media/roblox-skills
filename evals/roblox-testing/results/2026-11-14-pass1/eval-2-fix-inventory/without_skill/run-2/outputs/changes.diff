diff --git a/src/ServerScriptService/Tests/Specs/Inventory/BlockInventory.spec.luau b/src/ServerScriptService/Tests/Specs/Inventory/BlockInventory.spec.luau
new file mode 100644
index 0000000..172b9c2
--- /dev/null
+++ b/src/ServerScriptService/Tests/Specs/Inventory/BlockInventory.spec.luau
@@ -0,0 +1,51 @@
+local ServerScriptService = game:GetService("ServerScriptService")
+
+local JestGlobals = require(ServerScriptService.Tests.Packages.JestGlobals)
+local BlockInventory = require(ServerScriptService.Inventory.BlockInventory)
+
+local describe = JestGlobals.describe
+local expect = JestGlobals.expect
+local it = JestGlobals.it
+
+describe("BlockInventory.take", function()
+	it("takes blocks when the inventory holds enough", function()
+		local inventory = BlockInventory.new({ Brick = 2 })
+
+		expect(BlockInventory.take(inventory, "Brick", 1)).toBe(true)
+		expect(BlockInventory.count(inventory, "Brick")).toBe(1)
+	end)
+
+	it("refuses to take more than the inventory holds", function()
+		local inventory = BlockInventory.new({ Brick = 1 })
+
+		expect(BlockInventory.take(inventory, "Brick", 2)).toBe(false)
+		expect(BlockInventory.count(inventory, "Brick")).toBe(1)
+	end)
+
+	it("stops at zero for a block type that was given", function()
+		local inventory = BlockInventory.new({ Brick = 1 })
+
+		expect(BlockInventory.take(inventory, "Brick", 1)).toBe(true)
+		expect(BlockInventory.take(inventory, "Brick", 1)).toBe(false)
+		expect(BlockInventory.count(inventory, "Brick")).toBe(0)
+	end)
+
+	-- Regression: new players could place one Window (absent from the starter kit), leaving the
+	-- Window count at -1.
+	it("refuses to take a block type the inventory was never given", function()
+		local inventory = BlockInventory.new({ Brick = 20, Dirt = 20, Grass = 10, Wood = 10 })
+
+		expect(BlockInventory.take(inventory, "Window", 1)).toBe(false)
+		expect(BlockInventory.count(inventory, "Window")).toBe(0)
+
+		expect(BlockInventory.take(inventory, "Window", 1)).toBe(false)
+		expect(BlockInventory.count(inventory, "Window")).toBe(0)
+	end)
+
+	it("refuses to take from an empty inventory", function()
+		local inventory = BlockInventory.new()
+
+		expect(BlockInventory.take(inventory, "Window", 1)).toBe(false)
+		expect(BlockInventory.count(inventory, "Window")).toBe(0)
+	end)
+end)
