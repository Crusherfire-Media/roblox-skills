@@ -0,0 +1,31 @@
+--!strict
+const JestGlobals = require("@game/ServerScriptService/Tests/Packages/JestGlobals")
+const describe = JestGlobals.describe
+const expect = JestGlobals.expect
+const it = JestGlobals.it
+
+const BlockInventory = require("@game/ServerScriptService/Inventory/BlockInventory")
+
+type TakeRow = {
+	Case: string,
+	Held: number?,
+	WasTaken: boolean,
+	Left: number,
+}
+
+const TAKE_ROWS: { TakeRow } = {
+	{ Case = "a type it was never given", Held = nil, WasTaken = false, Left = 0 },
+	{ Case = "fewer than asked", Held = 2, WasTaken = false, Left = 2 },
+	{ Case = "exactly as many as asked", Held = 3, WasTaken = true, Left = 0 },
+}
+
+describe("BlockInventory", function()
+	it.each(TAKE_ROWS)("takes blocks only when it holds enough: $Case", function(row: TakeRow)
+		const inventory = BlockInventory.new({ Window = row.Held })
+
+		const wasTaken = BlockInventory.take(inventory, "Window", 3)
+
+		expect(wasTaken).toBe(row.WasTaken)
+		expect(BlockInventory.count(inventory, "Window")).toBe(row.Left)
+	end)
+end)
