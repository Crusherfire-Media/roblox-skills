+++ b/src/ServerScriptService/Tests/Specs/Inventory/BlockInventory.spec.luau
@@ -0,0 +1,39 @@
+--!strict
+const JestGlobals = require("@game/ServerScriptService/Tests/Packages/JestGlobals")
+const describe = JestGlobals.describe
+const expect = JestGlobals.expect
+const it = JestGlobals.it
+
+const BlockInventory = require("@game/ServerScriptService/Inventory/BlockInventory")
+
+type RefusalRow = {
+	Case: string,
+	Held: number?,
+	Amount: number,
+	Left: number,
+}
+
+const REFUSAL_ROWS: { RefusalRow } = {
+	{ Case = "a type the inventory never held", Held = nil, Amount = 1, Left = 0 },
+	{ Case = "more than the inventory holds", Held = 2, Amount = 3, Left = 2 },
+}
+
+describe("BlockInventory", function()
+	it.each(REFUSAL_ROWS)("refuses to take $Case and changes nothing", function(row: RefusalRow)
+		local inventory = BlockInventory.new({ Window = row.Held })
+
+		local wasTaken = BlockInventory.take(inventory, "Window", row.Amount)
+
+		expect(wasTaken).toBe(false)
+		expect(BlockInventory.count(inventory, "Window")).toBe(row.Left)
+	end)
+
+	it("takes the last blocks of a type, leaving zero", function()
+		local inventory = BlockInventory.new({ Brick = 1 })
+
+		local wasTaken = BlockInventory.take(inventory, "Brick", 1)
+
+		expect(wasTaken).toBe(true)
+		expect(BlockInventory.count(inventory, "Brick")).toBe(0)
+	end)
+end)
