@@ -0,0 +1,21 @@
+--!strict
+const JestGlobals = require("@game/ServerScriptService/Tests/Packages/JestGlobals")
+const describe = JestGlobals.describe
+const expect = JestGlobals.expect
+const it = JestGlobals.it
+
+const BlockInventory = require("@game/ServerScriptService/Inventory/BlockInventory")
+
+describe("BlockInventory", function()
+	it.each({
+		{ Case = "a type it was never given", Counts = { Brick = 5 }, Name = "Window" },
+		{ Case = "a type it has none left of", Counts = { Brick = 0 }, Name = "Brick" },
+	})("refuses to take $Case and leaves its count at 0", function(row)
+		local inventory = BlockInventory.new(row.Counts)
+
+		local wasTaken = BlockInventory.take(inventory, row.Name, 1)
+
+		expect(wasTaken).toBe(false)
+		expect(BlockInventory.count(inventory, row.Name)).toBe(0)
+	end)
+end)
