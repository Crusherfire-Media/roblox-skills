diff --git a/.github/workflows/specs.yml b/.github/workflows/specs.yml
new file mode 100644
index 0000000..f9ad451
--- /dev/null
+++ b/.github/workflows/specs.yml
@@ -0,0 +1,206 @@
+# Runs the Jest specs (src/ServerScriptService/Tests/Specs) on every pull request.
+#
+# 1. Build the place from ci.project.json with Rojo. ci.project.json is default.project.json
+#    plus ServerScriptService.LoadStringEnabled, which Jest needs in Open Cloud.
+# 2. Upload the build to the dedicated CI place as a Saved (unpublished) version.
+# 3. Run ci/run-specs.luau against exactly that version through the Open Cloud Luau Execution
+#    API, print the task logs, and fail unless the task COMPLETEs with success = true.
+#
+# Required repository secrets:
+#   ROBLOX_UNIVERSE_ID  universe ID of the CI experience
+#   ROBLOX_PLACE_ID     place ID of the CI place in that universe
+#   ROBLOX_API_KEY      Open Cloud API key with these permissions, limited to the CI experience:
+#                         - universe-places:write (Place Publishing: upload versions)
+#                         - universe.place.luau-execution-session:read and :write
+#
+# Pull requests from forks get no secrets, so this job fails for them with a clear message.
+
+name: Specs
+
+on:
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+# A new push to a PR replaces that PR's run that is still going. Each run pins the place version
+# it uploaded, so runs from different PRs can't test each other's builds.
+concurrency:
+  group: specs-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+env:
+  OPEN_CLOUD: https://apis.roblox.com
+  PLACE_FILE: build/ci.rbxl
+
+jobs:
+  specs:
+    name: Jest specs (Open Cloud)
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    steps:
+      - name: Check secrets
+        env:
+          ROBLOX_UNIVERSE_ID: ${{ secrets.ROBLOX_UNIVERSE_ID }}
+          ROBLOX_PLACE_ID: ${{ secrets.ROBLOX_PLACE_ID }}
+          ROBLOX_API_KEY: ${{ secrets.ROBLOX_API_KEY }}
+        run: |
+          missing=0
+          for name in ROBLOX_UNIVERSE_ID ROBLOX_PLACE_ID ROBLOX_API_KEY; do
+            if [ -z "${!name}" ]; then
+              echo "::error::Repository secret $name is not set (or not available to this run, e.g. a PR from a fork)."
+              missing=1
+            fi
+          done
+          exit $missing
+
+      - uses: actions/checkout@v4
+
+      # Installs the tools pinned in rokit.toml (rojo, pesde, lune, ...).
+      - name: Install Rokit tools
+        uses: CompeyDev/setup-rokit@v0.1.2
+        with:
+          cache: true
+
+      - name: Install packages
+        run: pesde install --locked
+
+      # ci.project.json is a copy of default.project.json. Fail if the two differ by anything
+      # other than the name and LoadStringEnabled, so the CI build can't drift from the real one.
+      - name: Check ci.project.json matches default.project.json
+        run: |
+          expected=$(jq -S '.name = "eval-sandbox-ci"
+            | .tree.ServerScriptService["$properties"].LoadStringEnabled = true' default.project.json)
+          actual=$(jq -S . ci.project.json)
+          if [ "$expected" != "$actual" ]; then
+            echo "::error file=ci.project.json::ci.project.json has drifted from default.project.json. It should match it except for name and ServerScriptService.\$properties.LoadStringEnabled = true."
+            diff <(echo "$expected") <(echo "$actual") || true
+            exit 1
+          fi
+
+      - name: Build place
+        run: |
+          mkdir -p build
+          rojo build ci.project.json --output "$PLACE_FILE"
+
+      - name: Upload place version
+        id: upload
+        env:
+          ROBLOX_UNIVERSE_ID: ${{ secrets.ROBLOX_UNIVERSE_ID }}
+          ROBLOX_PLACE_ID: ${{ secrets.ROBLOX_PLACE_ID }}
+          ROBLOX_API_KEY: ${{ secrets.ROBLOX_API_KEY }}
+        run: |
+          set -euo pipefail
+          # "Saved" makes a new version without publishing it to live servers.
+          response=$(curl --silent --show-error --fail-with-body \
+            --retry 5 --retry-delay 15 \
+            -X POST \
+            -H "x-api-key: $ROBLOX_API_KEY" \
+            -H "Content-Type: application/octet-stream" \
+            -H "Accept: application/json" \
+            --data-binary "@$PLACE_FILE" \
+            "$OPEN_CLOUD/universes/v1/$ROBLOX_UNIVERSE_ID/places/$ROBLOX_PLACE_ID/versions?versionType=Saved")
+          version=$(jq -er '.versionNumber' <<<"$response")
+          echo "Uploaded place version $version"
+          echo "version=$version" >> "$GITHUB_OUTPUT"
+
+      - name: Run specs
+        env:
+          ROBLOX_UNIVERSE_ID: ${{ secrets.ROBLOX_UNIVERSE_ID }}
+          ROBLOX_PLACE_ID: ${{ secrets.ROBLOX_PLACE_ID }}
+          ROBLOX_API_KEY: ${{ secrets.ROBLOX_API_KEY }}
+          PLACE_VERSION: ${{ steps.upload.outputs.version }}
+        run: |
+          set -euo pipefail
+
+          api() {
+            # curl retries 408/429/5xx on its own. --fail-with-body prints the error body.
+            curl --silent --show-error --fail-with-body \
+              --retry 5 --retry-delay 15 \
+              -H "x-api-key: $ROBLOX_API_KEY" \
+              -H "Accept: application/json" \
+              "$@"
+          }
+
+          # Create the task, pinned to the version this run uploaded. 300s is the API's maximum.
+          body=$(jq -n --rawfile script ci/run-specs.luau '{script: $script, timeout: "300s"}')
+          task=$(api -X POST -H "Content-Type: application/json" --data "$body" \
+            "$OPEN_CLOUD/cloud/v2/universes/$ROBLOX_UNIVERSE_ID/places/$ROBLOX_PLACE_ID/versions/$PLACE_VERSION/luau-execution-session-tasks")
+          task_path=$(jq -er '.path' <<<"$task")
+          echo "Created task $task_path"
+
+          # Poll until the task finishes. The task times out after 5 minutes. The extra time
+          # here covers waiting in the queue.
+          deadline=$((SECONDS + 600))
+          while :; do
+            task=$(api "$OPEN_CLOUD/cloud/v2/$task_path")
+            state=$(jq -r '.state' <<<"$task")
+            case "$state" in
+              COMPLETE|FAILED|CANCELLED) break ;;
+            esac
+            if [ "$SECONDS" -ge "$deadline" ]; then
+              echo "::error::Timed out waiting for the Luau task (last state: $state)."
+              exit 1
+            fi
+            sleep 5
+          done
+          echo "Task finished with state $state"
+
+          # Print the task logs (Jest's reporter output), following pagination.
+          echo "::group::Task logs"
+          page_token=""
+          while :; do
+            url="$OPEN_CLOUD/cloud/v2/$task_path/logs?maxPageSize=10000"
+            if [ -n "$page_token" ]; then
+              url="$url&pageToken=$(jq -rn --arg t "$page_token" '$t|@uri')"
+            fi
+            logs=$(api "$url") || { echo "(could not fetch logs)"; break; }
+            jq -r '.luauExecutionSessionTaskLogs[]?.messages[]?' <<<"$logs"
+            page_token=$(jq -r '.nextPageToken // empty' <<<"$logs")
+            [ -z "$page_token" ] && break
+          done
+          echo "::endgroup::"
+
+          if [ "$state" != "COMPLETE" ]; then
+            code=$(jq -r '.error.code // "unknown"' <<<"$task")
+            message=$(jq -r '.error.message // "no message"' <<<"$task")
+            echo "::error::Luau task $state ($code): $message"
+            {
+              echo "## Jest specs: runner error"
+              echo
+              echo "Task state \`$state\`, error \`$code\`:"
+              echo
+              echo '```'
+              echo "$message"
+              echo '```'
+            } >> "$GITHUB_STEP_SUMMARY"
+            exit 1
+          fi
+
+          summary=$(jq -c '.output.results[0] // empty' <<<"$task")
+          if [ -z "$summary" ] || [ "$(jq -r 'type' <<<"$summary")" != "object" ]; then
+            echo "::error::The Luau task completed but didn't return a summary table."
+            exit 1
+          fi
+
+          jq -r '
+            "## Jest specs: " + (if .success then "passed" else "FAILED" end),
+            "",
+            "| Suites | Tests | Passed | Failed | Skipped | Todo |",
+            "|---|---|---|---|---|---|",
+            "| \(.numTotalTestSuites // 0) | \(.numTotalTests // 0) | \(.numPassedTests // 0) | \(.numFailedTests // 0) | \(.numPendingTests // 0) | \(.numTodoTests // 0) |",
+            "",
+            (if .reason then "**\(.reason)**\n" else empty end),
+            ((.failures // [])[] | "### ❌ \(.test)\n`\(.suite)`\n\n```\n\(.message)\n```\n"),
+            (if (.omittedFailures // 0) > 0 then "_…and \(.omittedFailures) more failure(s); see the job log._" else empty end)
+          ' <<<"$summary" >> "$GITHUB_STEP_SUMMARY"
+
+          # Repeat each failure as an annotation on the PR's checks page.
+          jq -r '(.failures // [])[] | "::error title=Spec failed::\(.test) (\(.suite))"' <<<"$summary"
+
+          if [ "$(jq -r '.success' <<<"$summary")" != "true" ]; then
+            echo "::error::$(jq -r '.reason // "Specs failed."' <<<"$summary")"
+            exit 1
+          fi
+          echo "All specs passed."
