diff --git a/ci/run-specs.luau b/ci/run-specs.luau
new file mode 100644
index 0000000..0fdfa80
--- /dev/null
+++ b/ci/run-specs.luau
@@ -0,0 +1,135 @@
+--[[
+	Runs the Jest specs in ServerScriptService.Tests.Specs. .github/workflows/specs.yml sends this
+	file as the `script` of an Open Cloud Luau Execution task, against a place version built from
+	ci.project.json.
+
+	How results get back to the workflow:
+	  * Jest's reporter output goes to print(), so it shows up in the task logs, which the workflow
+	    prints.
+	  * The script returns one summary table. Open Cloud serializes it to JSON as
+	    `output.results[1]`. The workflow passes only when the task state is COMPLETE and
+	    `success` is true.
+	  * If the runner itself breaks (for example the build has no Tests folder, or Jest's promise
+	    rejects), the script raises an error, the task ends in state FAILED, and the workflow
+	    fails.
+
+	Notes:
+	  * Open Cloud tasks have no debug.loadmodule. Recent Jest Roblox versions fall back to loading
+	    modules from Script.Source, which needs ServerScriptService.LoadStringEnabled. Only
+	    ci.project.json turns that on, never default.project.json.
+	  * Finding no spec files counts as a failure. A build that silently left out the specs
+	    should not pass CI.
+]]
+
+local ServerScriptService = game:GetService("ServerScriptService")
+
+-- No ANSI colour codes in the logs: GitHub's log viewer would show them as raw escape codes.
+_G.NOCOLOR = true
+
+local MAX_REPORTED_FAILURES = 50
+local MAX_MESSAGE_LENGTH = 4000
+
+local function findRequired(parent: Instance, name: string): Instance
+	local child = parent:FindFirstChild(name)
+	if child == nil then
+		error(
+			`CI place is missing {parent:GetFullName()}.{name}. Build the place from ci.project.json `
+				.. "after running `pesde install`.",
+			0
+		)
+	end
+	return child
+end
+
+local function clean(message: any): string
+	local text = string.gsub(tostring(message), "\27%[[%d;]*m", "")
+	if #text > MAX_MESSAGE_LENGTH then
+		text = string.sub(text, 1, MAX_MESSAGE_LENGTH) .. "\n... (truncated)"
+	end
+	return text
+end
+
+local Tests = findRequired(ServerScriptService, "Tests")
+local Packages = findRequired(Tests, "Packages")
+local Specs = findRequired(Tests, "Specs")
+findRequired(Specs, "jest.config")
+
+local Jest = require(findRequired(Packages, "Jest")) :: any
+
+local status, result = Jest.runCLI(Specs, {
+	ci = true, -- don't write new snapshots; missing snapshots fail
+	verbose = true, -- list every test in the logs
+}, { Specs }):awaitStatus()
+
+if status ~= "Resolved" then
+	error(`Jest did not finish ({status}): {clean(result)}`, 0)
+end
+
+local aggregated = result.results
+
+local failures = {}
+local omittedFailures = 0
+
+local function addFailure(suite: string, test: string, message: string)
+	if #failures >= MAX_REPORTED_FAILURES then
+		omittedFailures += 1
+		return
+	end
+	table.insert(failures, { suite = suite, test = test, message = clean(message) })
+end
+
+for _, suiteResult in aggregated.testResults or {} do
+	local suite = tostring(suiteResult.testFilePath)
+
+	-- The suite failed before any test could run (for example a syntax error or an error at the
+	-- top level of the spec module).
+	if suiteResult.testExecError ~= nil then
+		local execError = suiteResult.testExecError
+		addFailure(
+			suite,
+			"(suite failed to run)",
+			suiteResult.failureMessage or execError.message or tostring(execError)
+		)
+	end
+
+	for _, assertion in suiteResult.testResults or {} do
+		if assertion.status == "failed" then
+			addFailure(
+				suite,
+				tostring(assertion.fullName),
+				table.concat(assertion.failureMessages or {}, "\n")
+			)
+		end
+	end
+end
+
+local summary = {
+	success = aggregated.success == true,
+	reason = nil :: string?,
+	numTotalTestSuites = aggregated.numTotalTestSuites,
+	numFailedTestSuites = aggregated.numFailedTestSuites,
+	numRuntimeErrorTestSuites = aggregated.numRuntimeErrorTestSuites,
+	numTotalTests = aggregated.numTotalTests,
+	numPassedTests = aggregated.numPassedTests,
+	numFailedTests = aggregated.numFailedTests,
+	numPendingTests = aggregated.numPendingTests,
+	numTodoTests = aggregated.numTodoTests,
+	failures = failures,
+	omittedFailures = omittedFailures,
+}
+
+if (aggregated.numTotalTestSuites or 0) == 0 then
+	summary.success = false
+	summary.reason = "No spec files were found (expected ModuleScripts named *.spec under "
+		.. "ServerScriptService.Tests.Specs)."
+elseif not summary.success then
+	summary.reason = `{aggregated.numFailedTests or 0} test(s) failed, `
+		.. `{aggregated.numFailedTestSuites or 0} suite(s) failed.`
+end
+
+print(
+	`[run-specs] success={summary.success} suites={summary.numTotalTestSuites} `
+		.. `tests={summary.numTotalTests} failed={summary.numFailedTests}`
+)
+
+return summary
