index 0000000..b8a5de6
--- /dev/null
+++ b/.github/workflows/specs.yml
@@ -0,0 +1,179 @@
+# Runs the Jest specs (src/ServerScriptService/Tests/Specs) on Roblox for every pull request:
+#   1. install the Rokit tools and the pesde packages (from the lockfiles),
+#   2. build the place with Rojo from ci.project.json (default.project.json plus LoadStringEnabled),
+#   3. save it as a new version of the CI place through Open Cloud,
+#   4. run ci/run-specs.luau against that exact version with the Luau Execution API,
+#   5. print the task logs and fail unless every spec passed.
+#
+# Repository secrets:
+#   ROBLOX_UNIVERSE_ID  universe of the dedicated CI place
+#   ROBLOX_PLACE_ID     the CI place (never point this at a live game: every run saves over it)
+#   ROBLOX_API_KEY      Open Cloud key with, for that universe:
+#                         universe-places:write                            (save place versions)
+#                         universe.place.luau-execution-session:write      (create tasks)
+#                         universe.place.luau-execution-session:read       (poll tasks, read logs)
+#
+# Pull requests from forks don't get repository secrets, so this job fails for them with a
+# message saying so. Don't switch to pull_request_target to work around that: it would run
+# untrusted code with the API key.
+
+name: Specs
+
+on:
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: specs-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+jobs:
+  specs:
+    name: Jest specs (Open Cloud)
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    env:
+      ROBLOX_UNIVERSE_ID: ${{ secrets.ROBLOX_UNIVERSE_ID }}
+      ROBLOX_PLACE_ID: ${{ secrets.ROBLOX_PLACE_ID }}
+      ROBLOX_API_KEY: ${{ secrets.ROBLOX_API_KEY }}
+    steps:
+      - name: Check secrets
+        run: |
+          missing=0
+          for name in ROBLOX_UNIVERSE_ID ROBLOX_PLACE_ID ROBLOX_API_KEY; do
+            if [ -z "${!name}" ]; then
+              echo "::error::Secret $name is not set (secrets aren't available to pull requests from forks)."
+              missing=1
+            fi
+          done
+          exit "$missing"
+
+      - uses: actions/checkout@v4
+
+      - name: Install Rokit tools
+        uses: CompeyDev/setup-rokit@v0.1.2
+        with:
+          token: ${{ github.token }}
+
+      - name: Install packages
+        run: pesde install --locked
+
+      - name: Build CI place
+        run: |
+          # The CI build is default.project.json with ServerScriptService.LoadStringEnabled on.
+          # Open Cloud servers don't offer debug.loadmodule, so Jest falls back to loadstring to
+          # load each spec in isolation. Generating this file keeps it from drifting from the
+          # real project; it must sit beside default.project.json so the relative paths resolve.
+          jq '.name += "-ci"
+            | .tree.ServerScriptService["$properties"] =
+                ((.tree.ServerScriptService["$properties"] // {}) + {"LoadStringEnabled": true})' \
+            default.project.json > ci.project.json
+          mkdir -p build
+          rojo build ci.project.json --output build/ci.rbxl
+
+      - name: Upload CI place version
+        id: upload
+        run: |
+          response=$(curl --silent --show-error --fail-with-body --retry 3 \
+            --request POST \
+            "https://apis.roblox.com/universes/v1/${ROBLOX_UNIVERSE_ID}/places/${ROBLOX_PLACE_ID}/versions?versionType=Saved" \
+            --header "x-api-key: ${ROBLOX_API_KEY}" \
+            --header "Content-Type: application/octet-stream" \
+            --data-binary @build/ci.rbxl) || { echo "::error::Place upload failed: $response"; exit 1; }
+          version=$(jq -r '.versionNumber' <<<"$response")
+          if [ -z "$version" ] || [ "$version" = "null" ]; then
+            echo "::error::Unexpected upload response: $response"
+            exit 1
+          fi
+          echo "Saved CI place version $version"
+          echo "version=$version" >> "$GITHUB_OUTPUT"
+
+      - name: Run specs
+        env:
+          PLACE_VERSION: ${{ steps.upload.outputs.version }}
+        run: |
+          set -euo pipefail
+          api="https://apis.roblox.com/cloud/v2"
+
+          call() { # call METHOD URL [JSON_BODY]
+            local args=(--silent --show-error --fail-with-body --retry 3
+              --request "$1" "$2" --header "x-api-key: ${ROBLOX_API_KEY}")
+            if [ $# -ge 3 ]; then
+              args+=(--header "Content-Type: application/json" --data "$3")
+            fi
+            curl "${args[@]}"
+          }
+
+          # Pin the task to the version just saved, so concurrent runs from other pull requests
+          # (which save over the same place) can't change what this run tests.
+          body=$(jq -n --rawfile script ci/run-specs.luau '{script: $script, timeout: "300s"}')
+          task=$(call POST \
+            "$api/universes/${ROBLOX_UNIVERSE_ID}/places/${ROBLOX_PLACE_ID}/versions/${PLACE_VERSION}/luau-execution-session-tasks" \
+            "$body") || { echo "::error::Creating the Luau execution task failed: $task"; exit 1; }
+          task_path=$(jq -r '.path' <<<"$task")
+          echo "Task: $task_path"
+
+          # Tasks can sit QUEUED for a while before the 300 s execution timeout starts.
+          deadline=$(( $(date +%s) + 900 ))
+          while :; do
+            task=$(call GET "$api/$task_path") \
+              || { echo "::error::Polling the task failed: $task"; exit 1; }
+            state=$(jq -r '.state' <<<"$task")
+            case "$state" in
+              COMPLETE|FAILED|CANCELLED) break ;;
+            esac
+            if [ "$(date +%s)" -ge "$deadline" ]; then
+              echo "::error::Task still $state after 15 minutes; giving up."
+              exit 1
+            fi
+            sleep 5
+          done
+          echo "Task finished: $state"
+
+          echo "::group::Task logs"
+          page_token=""
+          while :; do
+            logs=$(call GET "$api/$task_path/logs?maxPageSize=10000${page_token:+&pageToken=$page_token}") \
+              || { echo "Could not fetch logs: $logs"; break; }
+            jq -r '.luauExecutionSessionTaskLogs[]?.messages[]?' <<<"$logs"
+            page_token=$(jq -r '.nextPageToken // empty' <<<"$logs")
+            [ -n "$page_token" ] || break
+          done
+          echo "::endgroup::"
+
+          if [ "$state" != "COMPLETE" ]; then
+            message=$(jq -r '.error.message // "no error message"' <<<"$task")
+            echo "::error::Luau execution task $state: $message"
+            exit 1
+          fi
+
+          # run-specs.luau returns a single JSON string.
+          summary=$(jq -r '.output.results[0]' <<<"$task")
+          if ! jq -e . >/dev/null 2>&1 <<<"$summary"; then
+            echo "::error::Task returned no usable result: $(jq -c '.output' <<<"$task")"
+            exit 1
+          fi
+
+          jq -r '"Tests: \(.numPassedTests) passed, \(.numFailedTests) failed, \(.numPendingTests) skipped, \(.numTodoTests) todo, \(.numTotalTests) total (\(.numTotalTestSuites) suites, \(.numFailedTestSuites) failed)"' <<<"$summary"
+
+          # One annotation per failing test, plus a job summary.
+          jq -r '.failures[] | "::error title=\(.test | gsub("[\r\n:,]"; " "))::\(.file)%0A\(.message | gsub("%"; "%25") | gsub("\r"; "%0D") | gsub("\n"; "%0A"))"' <<<"$summary"
+          {
+            echo "## Jest specs"
+            jq -r '"**\(.numPassedTests)** passed, **\(.numFailedTests)** failed, \(.numPendingTests) skipped, \(.numTotalTests) total"' <<<"$summary"
+            jq -r '.failures[] | "\n### ❌ \(.test)\n`\(.file)`\n\n```\n\(.message)\n```"' <<<"$summary"
+            jq -r 'select(.omittedFailures > 0) | "\n…and \(.omittedFailures) more failures (see the task logs)."' <<<"$summary"
+          } >> "$GITHUB_STEP_SUMMARY"
+
+          if [ "$(jq -r '.numTotalTests' <<<"$summary")" = "0" ]; then
+            echo "::error::No tests ran. Specs must be ModuleScripts named *.spec under ServerScriptService.Tests.Specs."
+            exit 1
+          fi
+          if [ "$(jq -r '.success' <<<"$summary")" != "true" ]; then
+            echo "::error::Specs failed."
+            exit 1
+          fi
+          echo "All specs passed."
