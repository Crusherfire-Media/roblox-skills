+`testMatch` picks up every ModuleScript named `*.spec`. Specs run in Studio, or on Roblox through
+CI. Locally, check them with the commands below like any other file.
+
+### CI
+
+`.github/workflows/specs.yml` runs the specs on every pull request and fails it if any spec
+fails or no spec runs. It builds the place, saves it as a new version of a dedicated CI place
+through Open Cloud, and runs `ci/run-specs.luau` against that version with the Luau Execution API.
+It needs the repository secrets `ROBLOX_UNIVERSE_ID`, `ROBLOX_PLACE_ID`, and `ROBLOX_API_KEY` (an
+Open Cloud key with `universe-places:write` and `universe.place.luau-execution-session:read`
+and `:write` on that universe). Pull requests from forks don't get the secrets, so the job fails for them.
+
+The CI build is `default.project.json` with `ServerScriptService.LoadStringEnabled` turned on,
+because Jest falls back to `loadstring` on Open Cloud servers. The workflow generates it as
+`ci.project.json` (gitignored); keep `LoadStringEnabled` off in the real game.
 
 ## Checks
 
diff --git a/ci/run-specs.luau b/ci/run-specs.luau
new file mode 100644
index 0000000..77fae5b
--- /dev/null
+++ b/ci/run-specs.luau
@@ -0,0 +1,110 @@
+--[[
+	Runs the Jest specs in ServerScriptService.Tests.Specs. This file is sent as the `script` of an
+	Open Cloud Luau Execution task (see .github/workflows/specs.yml); it is not part of the place.
+
+	Jest's normal console output (colored, since Jest detects Open Cloud) goes to the task logs,
+	which the workflow prints. The script returns one value: a JSON string summarising the run. The
+	workflow decodes it and fails the job unless `success` is true and at least one test ran.
+
+	The script raises an error (so the task ends FAILED) only if Jest can't run at all: the test
+	folders are missing, neither debug.loadmodule nor loadstring is available, or runCLI rejects.
+	Jest rejects when it finds no specs, too.
+]]
+
+local HttpService = game:GetService("HttpService")
+local ServerScriptService = game:GetService("ServerScriptService")
+
+local MAX_FAILURES_REPORTED = 50
+local MAX_MESSAGE_LENGTH = 4000
+
+local function waitForChild(parent: Instance, name: string): Instance
+	local child = parent:WaitForChild(name, 30)
+	if child == nil then
+		error(`{parent:GetFullName()}.{name} not found. Was the place built from ci.project.json?`)
+	end
+	return child
+end
+
+local Tests = waitForChild(ServerScriptService, "Tests")
+local Specs = waitForChild(Tests, "Specs")
+local Packages = waitForChild(Tests, "Packages")
+
+-- Jest loads each spec in isolation with debug.loadmodule when it can, and with loadstring
+-- otherwise. Open Cloud servers don't expose loadmodule, so loadstring has to work, which needs
+-- ServerScriptService.LoadStringEnabled. The CI build turns it on; check here so a misconfigured
+-- place gives a clear error instead of a failure inside Jest.
+local hasLoadModule = pcall((debug :: any).loadmodule, Instance.new("ModuleScript"))
+if not hasLoadModule then
+	local ok, chunk = pcall(loadstring, "return true")
+	if not ok or chunk == nil then
+		error(
+			"Jest needs debug.loadmodule or loadstring, and neither is available. "
+				.. "Build the CI place with ServerScriptService.LoadStringEnabled = true (ci.project.json)."
+		)
+	end
+end
+
+local ANSI_PATTERN = "\27%[[%d;]*m"
+
+local function clean(message: any): string
+	local text = string.gsub(tostring(message), ANSI_PATTERN, "")
+	if #text > MAX_MESSAGE_LENGTH then
+		text = string.sub(text, 1, MAX_MESSAGE_LENGTH) .. "\n... (truncated)"
+	end
+	return text
+end
+
+local function pathOf(testFilePath: any): string
+	if typeof(testFilePath) == "Instance" then
+		return testFilePath:GetFullName()
+	end
+	return tostring(testFilePath)
+end
+
+local Jest = require(Packages:FindFirstChild("Jest") :: ModuleScript) :: any
+
+-- ci = true keeps Jest from writing new snapshots, like `jest --ci`.
+local status, output = Jest.runCLI(Specs, { ci = true, verbose = true }, { Specs }):awaitStatus()
+if status ~= "Resolved" then
+	error(`Jest did not finish ({status}): {tostring(output)}`)
+end
+
+local results = output.results
+
+local failures = {}
+local omittedFailures = 0
+local function addFailure(file: string, test: string, message: string)
+	if #failures >= MAX_FAILURES_REPORTED then
+		omittedFailures += 1
+		return
+	end
+	table.insert(failures, { file = file, test = test, message = message })
+end
+
+for _, suite in results.testResults do
+	local file = pathOf(suite.testFilePath)
+	if suite.testExecError ~= nil then
+		-- The spec module itself errored (syntax error, failed require, error outside a test).
+		local execError = suite.testExecError
+		addFailure(file, "(suite failed to run)", clean(execError.message or suite.failureMessage or execError))
+	end
+	for _, test in suite.testResults do
+		if test.status == "failed" then
+			addFailure(file, test.fullName, clean(table.concat(test.failureMessages, "\n")))
+		end
+	end
+end
+
+return HttpService:JSONEncode({
+	success = results.success == true,
+	numTotalTests = results.numTotalTests,
+	numPassedTests = results.numPassedTests,
+	numFailedTests = results.numFailedTests,
+	numPendingTests = results.numPendingTests,
+	numTodoTests = results.numTodoTests,
+	numTotalTestSuites = results.numTotalTestSuites,
+	numFailedTestSuites = results.numFailedTestSuites,
+	numRuntimeErrorTestSuites = results.numRuntimeErrorTestSuites,
+	failures = failures,
+	omittedFailures = omittedFailures,
+})
