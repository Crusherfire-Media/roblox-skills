new file mode 100644
index 0000000..3579b76
--- /dev/null
+++ b/ci/run-specs.luau
@@ -0,0 +1,125 @@
+--!strict
+--[[
+	Runs the Jest specs in ServerScriptService.Tests.Specs and returns a summary table.
+
+	This file is not part of the place. .github/workflows/specs.yml sends its contents as the
+	`script` of an Open Cloud Luau Execution task, which runs it on a headless server of the
+	uploaded CI place version. The task's `output.results[1]` is the table returned at the
+	bottom; the workflow fails the pull request unless `passed` is true.
+
+	The script only errors (making the task FAILED) when it can't load Jest or find the specs.
+	Spec failures and Jest crashes are reported through the returned table instead, so the
+	workflow can tell them apart.
+]]
+
+-- Open Cloud task scripts can't call debug.loadmodule (in Studio it sits behind the
+-- FFlagEnableLoadModule flag). This global makes Jest Roblox's module registry fall back to
+-- plain `require`. Consequence: modules required by specs are cached across spec files
+-- instead of being re-loaded fresh for each file, and jest.resetModules() / jest.mock()
+-- of ModuleScripts can't isolate them the way they do in Studio.
+-- It must be set before Jest is required.
+(_G :: any).__NO_LOADMODULE__ = true
+
+local ServerScriptService = game:GetService("ServerScriptService")
+
+local Tests = ServerScriptService:WaitForChild("Tests", 30)
+assert(Tests, "ServerScriptService.Tests is missing from the CI place build")
+local Specs = Tests:WaitForChild("Specs", 30)
+assert(Specs, "ServerScriptService.Tests.Specs is missing from the CI place build")
+local TestPackages = Tests:WaitForChild("Packages", 30)
+assert(TestPackages, "ServerScriptService.Tests.Packages is missing; did `pesde install` run before `rojo build`?")
+local JestModule = TestPackages:WaitForChild("Jest", 30)
+assert(JestModule, "ServerScriptService.Tests.Packages.Jest is missing")
+
+local Jest = require(JestModule) :: any
+
+-- Jest prints ANSI escape codes; strip them from text that goes into the returned table.
+local function stripAnsi(text: string): string
+	return (string.gsub(text, "\27%[[%d;]*m", ""))
+end
+
+local function truncate(text: string, maxLength: number): string
+	if #text <= maxLength then
+		return text
+	end
+	return string.sub(text, 1, maxLength) .. "\n... (truncated)"
+end
+
+-- `ci = true` keeps Jest from writing new snapshots (it can't write files here anyway).
+local ok, status, result = pcall(function()
+	return Jest.runCLI(Specs, { ci = true, verbose = true }, { Specs }):awaitStatus()
+end)
+
+if not ok or status ~= "Resolved" then
+	-- runCLI threw or its promise rejected: Jest itself broke (bad config, a spec that errors
+	-- while Jest collects it, and so on).
+	local message = if ok then tostring(result) else tostring(status)
+	print("Jest did not finish:\n" .. message)
+	return {
+		passed = false,
+		error = truncate(stripAnsi(message), 4000),
+	}
+end
+
+local aggregated = result.results
+
+local failures = {}
+for _, suite in aggregated.testResults or {} do
+	local suitePath = tostring(suite.testFilePath)
+	if suite.testExecError ~= nil then
+		local execError = suite.testExecError
+		local message = if typeof(execError) == "table" then execError.message else execError
+		table.insert(failures, {
+			suite = suitePath,
+			test = "(suite failed to run)",
+			message = truncate(stripAnsi(tostring(message)), 2000),
+		})
+	end
+	for _, assertion in suite.testResults or {} do
+		if assertion.status == "failed" then
+			local messages = {}
+			for _, failureMessage in assertion.failureMessages or {} do
+				table.insert(messages, stripAnsi(tostring(failureMessage)))
+			end
+			table.insert(failures, {
+				suite = suitePath,
+				test = tostring(assertion.fullName),
+				message = truncate(table.concat(messages, "\n"), 2000),
+			})
+		end
+	end
+end
+
+local numTotalTestSuites = aggregated.numTotalTestSuites or 0
+local numFailedTests = aggregated.numFailedTests or 0
+local numFailedTestSuites = aggregated.numFailedTestSuites or 0
+local numRuntimeErrorTestSuites = aggregated.numRuntimeErrorTestSuites or 0
+
+-- Finding no specs counts as a failure: it usually means the specs didn't make it into the
+-- build or testMatch stopped matching, and a green check would hide that.
+local passed = aggregated.success == true
+	and numTotalTestSuites > 0
+	and numFailedTests == 0
+	and numFailedTestSuites == 0
+	and numRuntimeErrorTestSuites == 0
+
+local errorMessage = nil
+if numTotalTestSuites == 0 then
+	errorMessage = "Jest found no spec files under ServerScriptService.Tests.Specs (testMatch: **/*.spec)."
+	print(errorMessage)
+end
+
+return {
+	passed = passed,
+	error = errorMessage,
+	numTotalTestSuites = numTotalTestSuites,
+	numPassedTestSuites = aggregated.numPassedTestSuites or 0,
+	numFailedTestSuites = numFailedTestSuites,
+	numRuntimeErrorTestSuites = numRuntimeErrorTestSuites,
+	numTotalTests = aggregated.numTotalTests or 0,
+	numPassedTests = aggregated.numPassedTests or 0,
+	numFailedTests = numFailedTests,
+	numPendingTests = aggregated.numPendingTests or 0,
+	numTodoTests = aggregated.numTodoTests or 0,
+	failures = failures,
+}
