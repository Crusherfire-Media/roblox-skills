+++ b/.github/workflows/specs.yml
@@ -0,0 +1,205 @@
+# Runs the Jest specs (src/ServerScriptService/Tests/Specs) on every pull request.
+#
+# 1. Build the place with Rojo (default.project.json, which includes ServerScriptService.Tests).
+# 2. Publish the build as a new version of a dedicated CI place.
+# 3. Run ci/run-specs.luau against exactly that version through the Open Cloud Luau Execution
+#    API, print the task's logs (Jest's output), and fail unless the script reports `passed`.
+#
+# Repository secrets:
+#   ROBLOX_UNIVERSE_ID  universe of the CI place
+#   ROBLOX_PLACE_ID     the CI place (it gets overwritten by every run; don't point this at a real game)
+#   ROBLOX_API_KEY      Open Cloud API key with, for that universe:
+#                         universe-places:write                        (publish place versions)
+#                         universe.place.luau-execution-session:write  (create tasks)
+#                         universe.place.luau-execution-session:read   (read task state and logs)
+#
+# Secrets aren't passed to workflows triggered by pull requests from forks, so those runs fail
+# at the "Check secrets" step.
+
+name: Specs
+
+on:
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: specs-${{ github.event.pull_request.number || github.ref }}
+  cancel-in-progress: true
+
+env:
+  # Luau Execution task timeout. Open Cloud caps this (300s at the time of writing).
+  TASK_TIMEOUT: 300s
+  PLACE_FILE: build/ci.rbxl
+
+jobs:
+  specs:
+    name: Jest specs
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+    env:
+      ROBLOX_UNIVERSE_ID: ${{ secrets.ROBLOX_UNIVERSE_ID }}
+      ROBLOX_PLACE_ID: ${{ secrets.ROBLOX_PLACE_ID }}
+      ROBLOX_API_KEY: ${{ secrets.ROBLOX_API_KEY }}
+
+    steps:
+      - name: Check secrets
+        run: |
+          missing=0
+          for name in ROBLOX_UNIVERSE_ID ROBLOX_PLACE_ID ROBLOX_API_KEY; do
+            if [ -z "${!name}" ]; then
+              echo "::error::Repository secret $name is not set (or unavailable to this run, e.g. a pull request from a fork)."
+              missing=1
+            fi
+          done
+          exit "$missing"
+
+      - uses: actions/checkout@v4
+
+      - name: Install Rokit
+        run: |
+          curl -sSf https://raw.githubusercontent.com/rojo-rbx/rokit/main/scripts/install.sh | bash
+          echo "$HOME/.rokit/bin" >> "$GITHUB_PATH"
+
+      - name: Install tools (rokit.toml)
+        env:
+          GITHUB_TOKEN: ${{ github.token }}
+        run: |
+          # Authenticated GitHub API calls avoid the shared-runner rate limit on tool downloads.
+          rokit authenticate github --token "$GITHUB_TOKEN" || echo "::warning::rokit authenticate failed; continuing unauthenticated"
+          rokit install --no-trust-check
+
+      - name: Install packages (pesde)
+        # The root pesde.toml lists test_packages as a workspace member, so this installs both
+        # roblox_packages/ and test_packages/roblox_packages/ (Jest).
+        run: pesde install --locked
+
+      - name: Build place
+        run: |
+          mkdir -p "$(dirname "$PLACE_FILE")"
+          rojo build default.project.json --output "$PLACE_FILE"
+
+      - name: Publish to CI place
+        id: publish
+        run: |
+          set -euo pipefail
+          response=$(curl -sS --fail-with-body --retry 3 --retry-all-errors \
+            -X POST "https://apis.roblox.com/universes/v1/${ROBLOX_UNIVERSE_ID}/places/${ROBLOX_PLACE_ID}/versions?versionType=Published" \
+            -H "x-api-key: ${ROBLOX_API_KEY}" \
+            -H "Content-Type: application/octet-stream" \
+            --data-binary "@${PLACE_FILE}") || {
+              echo "::error::Publishing the CI place failed: $response"
+              exit 1
+            }
+          version=$(jq -r '.versionNumber // empty' <<<"$response")
+          if [ -z "$version" ]; then
+            echo "::error::Unexpected publish response: $response"
+            exit 1
+          fi
+          echo "Published CI place version $version"
+          echo "version=$version" >> "$GITHUB_OUTPUT"
+
+      - name: Run specs (Open Cloud Luau Execution)
+        env:
+          PLACE_VERSION: ${{ steps.publish.outputs.version }}
+        run: |
+          set -euo pipefail
+          api="https://apis.roblox.com/cloud/v2"
+
+          # GET with a few retries for transient errors and rate limiting (429).
+          get() {
+            curl -sS --fail-with-body --retry 5 --retry-all-errors --retry-delay 3 \
+              -H "x-api-key: ${ROBLOX_API_KEY}" "$1"
+          }
+
+          # Target the version just published, so concurrent runs from other pull requests
+          # can't swap the place out from under this one.
+          body=$(jq -n --rawfile script ci/run-specs.luau --arg timeout "$TASK_TIMEOUT" \
+            '{script: $script, timeout: $timeout}')
+          task=$(curl -sS --fail-with-body \
+            -X POST "${api}/universes/${ROBLOX_UNIVERSE_ID}/places/${ROBLOX_PLACE_ID}/versions/${PLACE_VERSION}/luau-execution-session-tasks" \
+            -H "x-api-key: ${ROBLOX_API_KEY}" \
+            -H "Content-Type: application/json" \
+            --data "$body") || {
+              echo "::error::Creating the Luau Execution task failed: $task"
+              exit 1
+            }
+          task_path=$(jq -r '.path // empty' <<<"$task")
+          if [ -z "$task_path" ]; then
+            echo "::error::Unexpected task creation response: $task"
+            exit 1
+          fi
+          echo "Task: $task_path"
+
+          # Poll until the task leaves QUEUED/PROCESSING. Allow queue time on top of the task timeout.
+          timeout_seconds=${TASK_TIMEOUT%s}
+          deadline=$(( $(date +%s) + timeout_seconds + 600 ))
+          state=$(jq -r '.state' <<<"$task")
+          while [ "$state" = "QUEUED" ] || [ "$state" = "PROCESSING" ] || [ "$state" = "STATE_UNSPECIFIED" ]; do
+            if [ "$(date +%s)" -ge "$deadline" ]; then
+              echo "::error::Timed out waiting for the Luau Execution task (last state: $state)"
+              exit 1
+            fi
+            sleep 5
+            task=$(get "${api}/${task_path}")
+            state=$(jq -r '.state' <<<"$task")
+            echo "State: $state"
+          done
+
+          # Print the task's logs: Jest's reporter output, including failure diffs.
+          echo "::group::Task logs (Jest output)"
+          page_token=""
+          while :; do
+            url="${api}/${task_path}/logs?maxPageSize=10000"
+            if [ -n "$page_token" ]; then
+              url="${url}&pageToken=${page_token}"
+            fi
+            logs=$(get "$url") || { echo "::warning::Could not fetch task logs"; break; }
+            jq -r '.luauExecutionSessionTaskLogs[]?.messages[]?' <<<"$logs"
+            page_token=$(jq -r '.nextPageToken // empty' <<<"$logs")
+            [ -n "$page_token" ] || break
+          done
+          echo "::endgroup::"
+
+          if [ "$state" != "COMPLETE" ]; then
+            message=$(jq -r '.error.message // "no error message"' <<<"$task")
+            echo "::error::Luau Execution task ended in state $state: $message"
+            {
+              echo "## Specs: task $state"
+              echo
+              echo '```'
+              echo "$message"
+              echo '```'
+            } >> "$GITHUB_STEP_SUMMARY"
+            exit 1
+          fi
+
+          summary=$(jq '.output.results[0] // {}' <<<"$task")
+
+          # Annotate each failing test and write a job summary.
+          jq -r '.failures[]? | "::error title=\(.test | gsub("[\r\n:,]"; " "))::\(.suite)%0A\(.message | gsub("%"; "%25") | gsub("\r"; "%0D") | gsub("\n"; "%0A"))"' <<<"$summary"
+          {
+            echo "## Jest specs"
+            echo
+            jq -r '"| | Passed | Failed | Total |\n|---|---|---|---|\n| Suites | \(.numPassedTestSuites // 0) | \((.numFailedTestSuites // 0)) | \(.numTotalTestSuites // 0) |\n| Tests | \(.numPassedTests // 0) | \(.numFailedTests // 0) | \(.numTotalTests // 0) |"' <<<"$summary"
+            if jq -e '.error' <<<"$summary" >/dev/null; then
+              echo
+              echo '```'
+              jq -r '.error' <<<"$summary"
+              echo '```'
+            fi
+            if jq -e '(.failures // []) | length > 0' <<<"$summary" >/dev/null; then
+              echo
+              echo "### Failures"
+              jq -r '.failures[] | "\n**\(.test)** (`\(.suite)`)\n\n```\n\(.message)\n```"' <<<"$summary"
+            fi
+          } >> "$GITHUB_STEP_SUMMARY"
+
+          if [ "$(jq -r '.passed' <<<"$summary")" != "true" ]; then
+            error=$(jq -r '.error // empty' <<<"$summary")
+            echo "::error::Specs failed. ${error}"
+            exit 1
+          fi
+          echo "All specs passed: $(jq -r '"\(.numPassedTests) tests in \(.numTotalTestSuites) suites"' <<<"$summary")"
