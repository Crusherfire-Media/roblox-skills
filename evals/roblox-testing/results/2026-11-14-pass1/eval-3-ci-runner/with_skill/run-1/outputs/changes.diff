+# Runs the Jest specs in src/ServerScriptService/Tests/Specs on every pull request.
+#
+# The job builds the place with Rojo, uploads it as a new saved version of a
+# dedicated CI place, and runs ci/run-specs.luau in that exact version through
+# Open Cloud Luau Execution. The script errors when any spec fails, which ends
+# the task FAILED and fails this job.
+#
+# Repository secrets:
+#   ROBLOX_UNIVERSE_ID  the CI experience (keep it separate from the live game:
+#                       DataStore calls made by specs reach its real stores)
+#   ROBLOX_PLACE_ID     the CI place in that experience
+#   ROBLOX_API_KEY      Open Cloud key with universe-places:write and
+#                       universe.place.luau-execution-session read + write
+#
+# Pull requests from forks get no secrets, so this job fails on them.
+
+name: Specs
+
+on:
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  specs:
+    runs-on: ubuntu-latest
+    timeout-minutes: 20
+
+    # One Luau Execution task at a time per branch: task creation is rate
+    # limited per API key owner, so a newer push cancels the older run.
+    concurrency:
+      group: luau-execution-${{ github.ref }}
+      cancel-in-progress: true
+
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Install tools (rokit.toml)
+        uses: CompeyDev/setup-rokit@v0.1.2
+        with:
+          cache: true
+
+      - name: Install packages
+        run: pesde install --locked
+
+      # The CI build differs from default.project.json in one property: Jest
+      # loads modules with loadstring, which a game server allows only with
+      # ServerScriptService.LoadStringEnabled. It is derived here instead of
+      # committed so the dev and live places never get loadstring and the two
+      # project files can't drift apart.
+      - name: Write ci.project.json
+        run: |
+          jq '.tree.ServerScriptService["$properties"].LoadStringEnabled = true' \
+            default.project.json > ci.project.json
+
+      - name: Build place
+        run: |
+          mkdir -p build
+          rojo build ci.project.json -o build/ci.rbxl
+
+      - name: Run specs in the CI place
+        env:
+          ROBLOX_API_KEY: ${{ secrets.ROBLOX_API_KEY }}
+          ROBLOX_UNIVERSE_ID: ${{ secrets.ROBLOX_UNIVERSE_ID }}
+          ROBLOX_PLACE_ID: ${{ secrets.ROBLOX_PLACE_ID }}
+        run: python3 ci/luau_execution.py --place-file build/ci.rbxl --script ci/run-specs.luau
