+# Runs the Jest specs in src/ServerScriptService/Tests/Specs on every pull
+# request: builds the place with Rojo, saves it as a new version of the CI
+# place, and runs ci/run-specs.luau there through Open Cloud Luau Execution.
+#
+# Secrets: ROBLOX_UNIVERSE_ID and ROBLOX_PLACE_ID of a CI place in its own
+# experience (specs can reach that experience's real DataStores), and
+# ROBLOX_API_KEY with the universe-places:write and
+# universe.place.luau-execution-session:write scopes for that experience.
+# Pull requests from forks get no secrets, so this job fails for them.
+name: Specs
+
+on:
+  pull_request:
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  specs:
+    runs-on: ubuntu-latest
+    # Covers tool install plus the 8 minute poll deadline in run_luau_task.py.
+    timeout-minutes: 20
+    # Open Cloud allows 5 task creations per minute per key owner and 10
+    # unfinished tasks per place, so a newer push cancels the older run.
+    concurrency:
+      group: luau-execution-${{ github.ref }}
+      cancel-in-progress: true
+    steps:
+      - uses: actions/checkout@v4
+
+      - name: Install Rokit
+        run: |
+          curl -sSf https://raw.githubusercontent.com/rojo-rbx/rokit/main/scripts/install.sh | bash
+          echo "$HOME/.rokit/bin" >> "$GITHUB_PATH"
+
+      - name: Install tools from rokit.toml
+        env:
+          # Avoids GitHub API rate limits when Rokit downloads releases.
+          GITHUB_TOKEN: ${{ github.token }}
+        run: rokit install --no-trust-check
+
+      - name: Install packages
+        # Installs the workspace member test_packages (Jest) as well.
+        run: pesde install --locked
+
+      - name: Write the CI project file
+        # LoadStringEnabled lets Jest load modules on the game server the task
+        # runs on. It is set only in this generated copy so the real game
+        # keeps loadstring off.
+        run: |
+          jq '.tree.ServerScriptService["$properties"].LoadStringEnabled = true' \
+            default.project.json > ci.project.json
+
+      - name: Build the place
+        run: |
+          mkdir -p build
+          rojo build ci.project.json -o build/ci.rbxl
+
+      - name: Run specs in the CI place
+        env:
+          ROBLOX_API_KEY: ${{ secrets.ROBLOX_API_KEY }}
+          ROBLOX_UNIVERSE_ID: ${{ secrets.ROBLOX_UNIVERSE_ID }}
+          ROBLOX_PLACE_ID: ${{ secrets.ROBLOX_PLACE_ID }}
+        run: python3 ci/run_luau_task.py build/ci.rbxl ci/run-specs.luau
