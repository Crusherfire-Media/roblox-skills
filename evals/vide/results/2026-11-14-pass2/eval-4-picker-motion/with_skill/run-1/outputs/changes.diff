+	for index, blockType in BlockTypes.List do
+		if blockType.Name == name then
+			return index
+		end
+	end
+	return 1
+end
+
 export type BlockPickerProps = {
 	Selected: () -> string,
 	Select: (name: string) -> (),
+	-- The present source from show(); the picker sits below the screen while it is false.
+	Present: () -> boolean,
