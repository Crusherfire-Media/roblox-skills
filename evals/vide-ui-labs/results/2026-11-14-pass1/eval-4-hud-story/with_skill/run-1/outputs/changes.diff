@@ -0,0 +1,46 @@
+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const BuildModeHudView = require("@game/StarterPlayer/StarterPlayerScripts/BuildModeHudView")
+
+const blockTypeNames = {}
+for _, blockType in BlockTypes.List do
+	table.insert(blockTypeNames, blockType.Name)
+end
+
+const CONTROLS = {
+	SelectedBlock = UILabs.Ordered(UILabs.Choose(blockTypeNames, 1), 1),
+	-- Display names run up to 20 characters; try one that long to check truncation.
+	PlayerName = UILabs.Ordered(UILabs.String("Builder"), 2),
+	PlacedCount = UILabs.Ordered(UILabs.Number(12, 0, nil, 1), 3),
+}
+
+type StoryProps = {
+	controls: {
+		SelectedBlock: () -> string,
+		PlayerName: () -> string,
+		PlacedCount: () -> number,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const controls = props.controls
+
+	return BuildModeHudView({
+		PlayerName = controls.PlayerName,
+		BlockType = controls.SelectedBlock,
+		PlacedCount = controls.PlacedCount,
+	})
+end
+
+return {
+	summary = "The build mode HUD panel. In game it also blurs the world, zooms the camera, "
+		.. "and plays a sound; the story shows only the panel.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
