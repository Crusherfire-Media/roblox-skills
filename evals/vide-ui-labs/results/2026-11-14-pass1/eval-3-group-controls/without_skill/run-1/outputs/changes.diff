+-- Controls are keyed by name, so without explicit orders UI Labs lists them
+-- in table iteration order, which changes between reloads.
+local Ordered = UILabs.Ordered
+
+-- UILabs.ControlGroup in Luau takes no order argument, but the panel reads
+-- an Order field on the group, so set it here.
+local function group(order: number, controls: { [string]: any })
+	local controlGroup = UILabs.ControlGroup(controls)
+	controlGroup.Order = order
+	return controlGroup
+end
