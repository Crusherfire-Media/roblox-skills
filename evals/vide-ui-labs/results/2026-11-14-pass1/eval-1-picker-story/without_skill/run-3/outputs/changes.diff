diff --git a/src/ServerScriptService/Stories/BlockPicker.story.luau b/src/ServerScriptService/Stories/BlockPicker.story.luau
new file mode 100644
index 0000000..7a7a8bf
--- /dev/null
+++ b/src/ServerScriptService/Stories/BlockPicker.story.luau
@@ -0,0 +1,54 @@
+--[[
+	UI Labs story for the block picker.
+
+	Controls:
+	- Title: the picker's title text. Type anything, including a very long title, to check truncation.
+	- Selected: which block type is selected. Changing it moves the outline.
+
+	Clicking a tile in the preview selects it, the same as in game. The Selected control doesn't
+	follow clicks (UI Labs controls are one-way), but changing the control again re-selects from it.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local StarterPlayer = game:GetService("StarterPlayer")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local UILabs = require(ReplicatedStorage.Packages.UILabs)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local BlockPicker = require(StarterPlayer.StarterPlayerScripts.BlockPicker)
+
+local source = Vide.source
+local effect = Vide.effect
+
+local blockNames = {}
+for index, blockType in BlockTypes.List do
+	blockNames[index] = blockType.Name
+end
+
+local controls = {
+	Title = "Blocks",
+	Selected = UILabs.Choose(blockNames),
+}
+
+return UILabs.CreateVideStory({
+	vide = Vide,
+	controls = controls,
+}, function(props)
+	local selectedControl: () -> string = props.controls.Selected
+	local title: () -> string = props.controls.Title
+
+	-- Local selection so tile clicks work; follows the control whenever the control changes.
+	local selected = source(selectedControl())
+	effect(function()
+		selected(selectedControl())
+	end)
+
+	return BlockPicker({
+		Title = title,
+		Selected = selected,
+		Select = function(name: string)
+			selected(name)
+		end,
+	})
+end)
