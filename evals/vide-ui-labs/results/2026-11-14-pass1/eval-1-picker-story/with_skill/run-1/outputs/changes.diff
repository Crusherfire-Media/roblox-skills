diff --git a/src/ServerScriptService/Stories/BlockPicker.story.luau b/src/ServerScriptService/Stories/BlockPicker.story.luau
new file mode 100644
index 0000000..80d881a
--- /dev/null
+++ b/src/ServerScriptService/Stories/BlockPicker.story.luau
@@ -0,0 +1,62 @@
+--!strict
+
+const BlockPicker = require("@game/StarterPlayer/StarterPlayerScripts/BlockPicker")
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const create = Vide.create
+const indexes = Vide.indexes
+const source = Vide.source
+
+const BLOCK_NAMES = {}
+for index, blockType in BlockTypes.List do
+	BLOCK_NAMES[index] = blockType.Name
+end
+
+const CONTROLS = {
+	Title = UILabs.Ordered("Blocks", 1),
+	-- Picking a block here starts the picker over from that selection, so a
+	-- tile clicked in the preview stays selected until this changes.
+	Selected = UILabs.Ordered(UILabs.Choose(BLOCK_NAMES, 1), 2),
+}
+
+type StoryProps = {
+	controls: {
+		Title: () -> string,
+		Selected: () -> string,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const controls = props.controls
+
+	return create("Frame")({
+		Name = "BlockPickerStory",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundTransparency = 1,
+
+		indexes(function()
+			return { [controls.Selected()] = true }
+		end, function(_, initialName: string)
+			const selected = source(initialName)
+
+			return BlockPicker({
+				Title = controls.Title,
+				Selected = selected,
+				Select = function(name: string)
+					print(`Selected {name}`)
+					selected(name)
+				end,
+			})
+		end),
+	})
+end
+
+return {
+	summary = "The block picker. Click a tile to select it, as in game.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
