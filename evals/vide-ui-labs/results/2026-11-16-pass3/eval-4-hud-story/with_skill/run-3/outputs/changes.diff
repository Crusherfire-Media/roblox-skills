diff --git a/src/StarterPlayer/StarterPlayerScripts/BuildModeHudView.luau b/src/StarterPlayer/StarterPlayerScripts/BuildModeHudView.luau
new file mode 100644
index 0000000..7fc9797
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BuildModeHudView.luau
@@ -0,0 +1,118 @@
+--!strict
+--[[
+	The build mode HUD panel: the player's name, the selected block type, and
+	how many blocks they have placed. Everything it shows comes in through
+	props, so it touches nothing outside its own frame and can render in a
+	story. BuildModeHud connects it to the game.
+]]
+
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Vide = require(ReplicatedStorage.Packages.Vide)
+
+const create = Vide.create
+const read = Vide.read
+
+const PANEL_SIZE = Vector2.new(240, 96)
+const PANEL_MARGIN = 16
+const PANEL_PADDING = 10
+const PANEL_COLOR = Color3.fromRGB(28, 28, 34)
+const TEXT_COLOR = Color3.fromRGB(240, 240, 240)
+const MUTED_TEXT_COLOR = Color3.fromRGB(180, 180, 190)
+const SWATCH_SIZE = 16
+
+const BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+
+export type Props = {
+	PlayerName: string | () -> string,
+	BlockType: BlockTypes.BlockType | () -> BlockTypes.BlockType,
+	PlacedCount: number | () -> number,
+}
+
+local function buildModeHudView(props: Props): Frame
+	return create("Frame")({
+		Name = "BuildModeHud",
+		Position = UDim2.fromOffset(PANEL_MARGIN, PANEL_MARGIN),
+		Size = UDim2.fromOffset(PANEL_SIZE.X, PANEL_SIZE.Y),
+		BackgroundColor3 = PANEL_COLOR,
+		BackgroundTransparency = 0.2,
+
+		create("UICorner")({ CornerRadius = UDim.new(0, 8) }),
+		create("UIPadding")({
+			PaddingLeft = UDim.new(0, PANEL_PADDING),
+			PaddingRight = UDim.new(0, PANEL_PADDING),
+			PaddingTop = UDim.new(0, PANEL_PADDING),
+			PaddingBottom = UDim.new(0, PANEL_PADDING),
+		}),
+		create("UIListLayout")({
+			FillDirection = Enum.FillDirection.Vertical,
+			Padding = UDim.new(0, 6),
+		}),
+
+		create("TextLabel")({
+			Name = "PlayerName",
+			LayoutOrder = 1,
+			Size = UDim2.new(1, 0, 0, 22),
+			BackgroundTransparency = 1,
+			Font = Enum.Font.GothamBold,
+			TextSize = 18,
+			TextColor3 = TEXT_COLOR,
+			TextXAlignment = Enum.TextXAlignment.Left,
+			TextTruncate = Enum.TextTruncate.AtEnd,
+			Text = function()
+				return `{read(props.PlayerName)} is building`
+			end,
+		}),
+		create("Frame")({
+			Name = "Selected",
+			LayoutOrder = 2,
+			Size = UDim2.new(1, 0, 0, 20),
+			BackgroundTransparency = 1,
+
+			create("UIListLayout")({
+				FillDirection = Enum.FillDirection.Horizontal,
+				VerticalAlignment = Enum.VerticalAlignment.Center,
+				Padding = UDim.new(0, 6),
+			}),
+
+			create("Frame")({
+				Name = "Swatch",
+				LayoutOrder = 1,
+				Size = UDim2.fromOffset(SWATCH_SIZE, SWATCH_SIZE),
+				BackgroundColor3 = function()
+					return read(props.BlockType).Color
+				end,
+
+				create("UICorner")({ CornerRadius = UDim.new(0, 4) }),
+			}),
+			create("TextLabel")({
+				Name = "BlockName",
+				LayoutOrder = 2,
+				Size = UDim2.new(1, -(SWATCH_SIZE + 6), 1, 0),
+				BackgroundTransparency = 1,
+				Font = Enum.Font.Gotham,
+				TextSize = 16,
+				TextColor3 = MUTED_TEXT_COLOR,
+				TextXAlignment = Enum.TextXAlignment.Left,
+				Text = function()
+					return read(props.BlockType).DisplayName
+				end,
+			}),
+		}),
+		create("TextLabel")({
+			Name = "PlacedCount",
+			LayoutOrder = 3,
+			Size = UDim2.new(1, 0, 0, 20),
+			BackgroundTransparency = 1,
+			Font = Enum.Font.Gotham,
+			TextSize = 16,
+			TextColor3 = MUTED_TEXT_COLOR,
+			TextXAlignment = Enum.TextXAlignment.Left,
+			Text = function()
+				return `Placed: {read(props.PlacedCount)}`
+			end,
+		}),
+	})
+end
+
+return buildModeHudView
