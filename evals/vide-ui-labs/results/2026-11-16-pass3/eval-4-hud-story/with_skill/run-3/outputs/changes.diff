+++ b/src/ServerScriptService/Stories/BuildModeHudView.story.luau
@@ -0,0 +1,48 @@
+--!strict
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const BuildModeHudView = require("@game/StarterPlayer/StarterPlayerScripts/BuildModeHudView")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local blockNames = {}
+for _, blockType in BlockTypes.List do
+	table.insert(blockNames, blockType.Name)
+end
+
+const CONTROLS = {
+	-- Every block type, in hotbar order.
+	Block = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+	-- Roblox display names run up to 20 characters.
+	PlayerName = UILabs.Ordered(UILabs.String("Builder"), 2),
+	PlacedCount = UILabs.Ordered(UILabs.Slider(0, 0, 10000, 1), 3),
+}
+
+type StoryProps = {
+	controls: {
+		Block: () -> string,
+		PlayerName: () -> string,
+		PlacedCount: () -> number,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps): Frame
+	const controls = props.controls
+
+	return BuildModeHudView({
+		PlayerName = controls.PlayerName,
+		BlockType = function()
+			return BlockTypes.ByName[controls.Block()]
+		end,
+		PlacedCount = controls.PlacedCount,
+	})
+end
+
+return {
+	summary = "The build mode HUD panel. In game it also blurs the world, zooms the camera, and "
+		.. "plays a sound; the story shows the panel only.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
