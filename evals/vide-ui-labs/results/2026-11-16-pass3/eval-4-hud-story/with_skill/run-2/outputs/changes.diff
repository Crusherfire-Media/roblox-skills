+--!strict
+--[[
+	The build mode HUD panel without the blur, camera zoom, and open sound the
+	game adds around it.
+]]
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const BuildModeHudView = require("@game/StarterPlayer/StarterPlayerScripts/BuildModeHudView")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const blockNames = {}
+for _, blockType in BlockTypes.List do
+	table.insert(blockNames, blockType.Name)
+end
+
+const CONTROLS = {
+	SelectedBlock = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+	-- Roblox display names run up to 20 characters.
+	PlayerName = UILabs.Ordered("BuilderBob", 2),
+	PlacedCount = UILabs.Ordered(UILabs.Number(0, 0, 999999, 1), 3),
+}
+
+type StoryProps = {
+	controls: {
+		SelectedBlock: () -> string,
+		PlayerName: () -> string,
+		PlacedCount: () -> number,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps): Frame
+	const controls = props.controls
+
+	return BuildModeHudView({
+		PlayerName = controls.PlayerName,
+		SelectedBlock = controls.SelectedBlock,
+		PlacedCount = controls.PlacedCount,
+	})
+end
+
+return {
+	summary = "The build mode HUD panel: player name, selected block, and placed count.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
