@@ -0,0 +1,35 @@
+--[[
+	UI Labs story for the build mode HUD. Renders only BuildModeHudView, so opening it does not blur
+	Lighting, change the camera, play a sound, or listen to game remotes. Everything it creates lives
+	under the UI Labs target and is destroyed when the story closes.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local StarterPlayer = game:GetService("StarterPlayer")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local BuildModeHudView = require(StarterPlayer.StarterPlayerScripts.BuildModeHudView)
+local UILabs = require(ReplicatedStorage.Packages.UILabs)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local blockNames = {}
+for _, blockType in BlockTypes.List do
+	table.insert(blockNames, blockType.Name)
+end
+
+local controls = {
+	selectedBlock = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+	playerName = UILabs.Ordered(UILabs.String("Builder"), 2),
+	placedCount = UILabs.Ordered(UILabs.Number(0, 0, nil, 1), 3),
+}
+
+return UILabs.CreateVideStory({
+	vide = Vide,
+	controls = controls,
+}, function(props: UILabs.VideProps)
+	return BuildModeHudView({
+		playerName = props.controls.playerName,
+		selected = props.controls.selectedBlock,
+		placedCount = props.controls.placedCount,
+	})
+end)
