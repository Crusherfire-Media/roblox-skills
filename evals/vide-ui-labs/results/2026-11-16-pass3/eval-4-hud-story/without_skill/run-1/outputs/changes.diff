diff --git a/src/StarterPlayer/StarterPlayerScripts/BuildModeHudView.luau b/src/StarterPlayer/StarterPlayerScripts/BuildModeHudView.luau
new file mode 100644
index 0000000..9536d23
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BuildModeHudView.luau
@@ -0,0 +1,122 @@
+--[[
+	The look of the build mode HUD: a panel in the top-left corner with the player's name, the
+	selected block type, and how many blocks they have placed. It only draws what it is given and has
+	no side effects (no blur, camera, sound, or game signals), so stories can render it in edit mode.
+	BuildModeHud wires it up to the game.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local create = Vide.create
+
+local PANEL_SIZE = Vector2.new(240, 96)
+local PANEL_MARGIN = 16
+local PANEL_PADDING = 10
+local PANEL_COLOR = Color3.fromRGB(28, 28, 34)
+local TEXT_COLOR = Color3.fromRGB(240, 240, 240)
+local MUTED_TEXT_COLOR = Color3.fromRGB(180, 180, 190)
+local SWATCH_SIZE = 16
+
+export type Props = {
+	-- Display name of the player who is building.
+	playerName: () -> string,
+	-- Name of the selected block type, a key of BlockTypes.ByName.
+	selected: () -> string,
+	-- Blocks placed since build mode opened.
+	placedCount: () -> number,
+}
+
+local function buildModeHudView(props: Props): Frame
+	local function selectedType(): BlockTypes.BlockType
+		return BlockTypes.ByName[props.selected()]
+	end
+
+	return create("Frame")({
+		Name = "BuildModeHud",
+		Position = UDim2.fromOffset(PANEL_MARGIN, PANEL_MARGIN),
+		Size = UDim2.fromOffset(PANEL_SIZE.X, PANEL_SIZE.Y),
+		BackgroundColor3 = PANEL_COLOR,
+		BackgroundTransparency = 0.2,
+
+		create("UICorner")({ CornerRadius = UDim.new(0, 8) }),
+		create("UIPadding")({
+			PaddingLeft = UDim.new(0, PANEL_PADDING),
+			PaddingRight = UDim.new(0, PANEL_PADDING),
+			PaddingTop = UDim.new(0, PANEL_PADDING),
+			PaddingBottom = UDim.new(0, PANEL_PADDING),
+		}),
+		create("UIListLayout")({
+			FillDirection = Enum.FillDirection.Vertical,
+			Padding = UDim.new(0, 6),
+		}),
+
+		create("TextLabel")({
+			Name = "PlayerName",
+			LayoutOrder = 1,
+			Size = UDim2.new(1, 0, 0, 22),
+			BackgroundTransparency = 1,
+			Font = Enum.Font.GothamBold,
+			TextSize = 18,
+			TextColor3 = TEXT_COLOR,
+			TextXAlignment = Enum.TextXAlignment.Left,
+			TextTruncate = Enum.TextTruncate.AtEnd,
+			Text = function()
+				return `{props.playerName()} is building`
+			end,
+		}),
+		create("Frame")({
+			Name = "Selected",
+			LayoutOrder = 2,
+			Size = UDim2.new(1, 0, 0, 20),
+			BackgroundTransparency = 1,
+
+			create("UIListLayout")({
+				FillDirection = Enum.FillDirection.Horizontal,
+				VerticalAlignment = Enum.VerticalAlignment.Center,
+				Padding = UDim.new(0, 6),
+			}),
+
+			create("Frame")({
+				Name = "Swatch",
+				LayoutOrder = 1,
+				Size = UDim2.fromOffset(SWATCH_SIZE, SWATCH_SIZE),
+				BackgroundColor3 = function()
+					return selectedType().Color
+				end,
+
+				create("UICorner")({ CornerRadius = UDim.new(0, 4) }),
+			}),
+			create("TextLabel")({
+				Name = "BlockName",
+				LayoutOrder = 2,
+				Size = UDim2.new(1, -(SWATCH_SIZE + 6), 1, 0),
+				BackgroundTransparency = 1,
+				Font = Enum.Font.Gotham,
+				TextSize = 16,
+				TextColor3 = MUTED_TEXT_COLOR,
+				TextXAlignment = Enum.TextXAlignment.Left,
+				Text = function()
+					return selectedType().DisplayName
+				end,
+			}),
+		}),
+		create("TextLabel")({
+			Name = "PlacedCount",
+			LayoutOrder = 3,
+			Size = UDim2.new(1, 0, 0, 20),
+			BackgroundTransparency = 1,
+			Font = Enum.Font.Gotham,
+			TextSize = 16,
+			TextColor3 = MUTED_TEXT_COLOR,
+			TextXAlignment = Enum.TextXAlignment.Left,
+			Text = function()
+				return `Placed: {props.placedCount()}`
+			end,
+		}),
+	})
+end
+
+return buildModeHudView
