+++ b/src/ServerScriptService/Stories/BuildModeHud.story.luau
@@ -0,0 +1,39 @@
+--[[
+	UI Labs story for the build mode HUD. It mounts only BuildModeHudView, the side-effect-free panel,
+	so opening it does not blur Lighting, change the Studio camera, play a sound or wait for remotes.
+	Everything it creates lives under the UI Labs target and is destroyed with the story.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local StarterPlayer = game:GetService("StarterPlayer")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local UILabs = require(ReplicatedStorage.Packages.UILabs)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local BuildModeHudView = require(StarterPlayer.StarterPlayerScripts.BuildModeHudView)
+
+local blockNames = {}
+for _, blockType in BlockTypes.List do
+	table.insert(blockNames, blockType.Name)
+end
+
+local controls = {
+	SelectedBlock = UILabs.Choose(blockNames),
+	-- Roblox display names can be up to 20 characters; use the field to try longer ones too.
+	PlayerName = UILabs.String("Builder"),
+	PlacedCount = UILabs.Number(0, 0, nil, 1, true, 1),
+}
+
+return UILabs.CreateVideStory({
+	vide = Vide,
+	controls = controls,
+}, function(props: UILabs.VideProps)
+	local controlSources = props.controls
+
+	return BuildModeHudView({
+		playerName = controlSources.PlayerName,
+		selectedBlock = controlSources.SelectedBlock,
+		placedCount = controlSources.PlacedCount,
+	})
+end)
