diff --git a/src/ServerScriptService/Stories/BlockPicker.story.luau b/src/ServerScriptService/Stories/BlockPicker.story.luau
new file mode 100644
index 0000000..d78a2ff
--- /dev/null
+++ b/src/ServerScriptService/Stories/BlockPicker.story.luau
@@ -0,0 +1,51 @@
+--!strict
+const BlockPicker = require("@game/StarterPlayer/StarterPlayerScripts/BlockPicker")
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const effect = Vide.effect
+const source = Vide.source
+
+const BLOCK_NAMES = {}
+for index, blockType in BlockTypes.List do
+	BLOCK_NAMES[index] = blockType.Name
+end
+
+const CONTROLS = {
+	-- Tile clicks in the preview also change the selection.
+	Block = UILabs.Ordered(UILabs.Choose(BLOCK_NAMES), 1),
+	Title = UILabs.Ordered(UILabs.String("Blocks"), 2),
+}
+
+type StoryProps = {
+	controls: {
+		Block: () -> string,
+		Title: () -> string,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const controls = props.controls
+
+	const selected = source(controls.Block())
+	effect(function()
+		selected(controls.Block())
+	end)
+
+	return BlockPicker({
+		Title = controls.Title,
+		Selected = selected,
+		Select = function(name: string)
+			selected(name)
+		end,
+	})
+end
+
+return {
+	summary = "The block picker with every block type. Click a tile to select it.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
