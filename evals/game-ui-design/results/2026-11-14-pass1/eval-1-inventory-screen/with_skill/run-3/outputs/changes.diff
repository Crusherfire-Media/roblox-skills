+--!strict
+--[[
+	Colors and fonts shared by the block inventory UI. Text colors pass 4.5:1
+	contrast on the surfaces they sit on.
+]]
+
+const BUILDER_SANS = "rbxasset://fonts/families/BuilderSans.json"
+
+local Module = {}
+
+Module.BoldFont = Font.new(BUILDER_SANS, Enum.FontWeight.Bold)
+Module.RegularFont = Font.new(BUILDER_SANS, Enum.FontWeight.Medium)
+
+Module.Colors = table.freeze({
+	Backdrop = Color3.fromRGB(0, 0, 0),
+	Panel = Color3.fromRGB(28, 32, 46),
+	PanelStroke = Color3.fromRGB(78, 86, 114),
+	Tile = Color3.fromRGB(50, 56, 78),
+	TileHover = Color3.fromRGB(68, 76, 104),
+	TilePressed = Color3.fromRGB(40, 45, 62),
+	TileUnavailable = Color3.fromRGB(38, 40, 50),
+	LockedSwatch = Color3.fromRGB(92, 94, 104),
+	Button = Color3.fromRGB(62, 70, 96),
+	ButtonHover = Color3.fromRGB(80, 90, 122),
+	ButtonPressed = Color3.fromRGB(48, 54, 74),
+	KeyCap = Color3.fromRGB(20, 22, 32),
+	Text = Color3.fromRGB(245, 246, 250),
+	TextMuted = Color3.fromRGB(176, 182, 198),
+	Selected = Color3.fromRGB(255, 205, 60),
+	SelectedMark = Color3.fromRGB(30, 24, 6),
+	Focus = Color3.fromRGB(255, 255, 255),
+})
+
+return table.freeze(Module)
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/inventoryButton.luau b/src/StarterPlayer/StarterPlayerScripts/UI/inventoryButton.luau
new file mode 100644
index 0000000..9619337
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/inventoryButton.luau
@@ -0,0 +1,214 @@
+--!strict
+--[[
+	The HUD button that opens the block inventory. It shows the block being
+	built with, so it also tells the player which block they will place. Touch
+	layouts get a square button in the top right corner, clear of the thumbstick
+	and jump button; other layouts get a wider chip at the bottom center with
+	the key or gamepad button that opens it.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const changed = Vide.changed
+const create = Vide.create
+const show = Vide.show
+const source = Vide.source
+
+const keyHint = require("./Components/keyHint")
+const Theme = require("./Theme")
+
+const EDGE_MARGIN = 16
+const DESKTOP_BOTTOM_MARGIN = 24
+const CORNER_RADIUS = 16
+const STROKE = 2
+const SWATCH_SIZE = 40
+const SWATCH_RADIUS = 8
+const PRESS_SINK = 2
+const TOUCH_SIZE = 80
+const TOUCH_SWATCH_TOP = 10
+const TOUCH_LABEL_TOP = 54
+const TOUCH_LABEL_HEIGHT = 20
+const TOUCH_LABEL_TEXT_SIZE = 16
+const DESKTOP_SIZE = Vector2.new(240, 64)
+const DESKTOP_PADDING = 12
+const DESKTOP_TEXT_LEFT = 64
+const DESKTOP_TITLE_TOP = 9
+const DESKTOP_TITLE_HEIGHT = 22
+const DESKTOP_TITLE_TEXT_SIZE = 20
+const DESKTOP_SUBTITLE_TOP = 33
+const DESKTOP_SUBTITLE_HEIGHT = 20
+const DESKTOP_SUBTITLE_TEXT_SIZE = 16
+const HINT_SIZE = 36
+const HINT_TEXT_SIZE = 18
+
+const InventoryTypes = require("./InventoryTypes")
+
+type BlockEntry = InventoryTypes.BlockEntry
+
+export type ButtonLayout = "Touch" | "Desktop"
+
+export type InventoryButtonProps = {
+	Layout: () -> ButtonLayout,
+	-- Nil hides the hint, as on touch.
+	HintKeyCode: () -> Enum.KeyCode?,
+	SelectedEntry: () -> BlockEntry?,
+	BackgroundTransparency: () -> number,
+	Activated: () -> (),
+}
+
+local function swatch(props: {
+	Entry: () -> BlockEntry?,
+	AnchorPoint: Vector2,
+	Position: UDim2,
+}): Frame
+	return create("Frame")({
+		Name = "Swatch",
+		AnchorPoint = props.AnchorPoint,
+		Position = props.Position,
+		Size = UDim2.fromOffset(SWATCH_SIZE, SWATCH_SIZE),
+		BackgroundColor3 = function()
+			local entry = props.Entry()
+			return if entry then entry.Color else Theme.Colors.Tile
+		end,
+
+		create("UICorner")({ CornerRadius = UDim.new(0, SWATCH_RADIUS) }),
+		create("UIStroke")({
+			Color = Theme.Colors.KeyCap,
+			Thickness = STROKE,
+		}),
+	})
+end
+
+local function touchContent(props: InventoryButtonProps): Frame
+	return create("Frame")({
+		Name = "TouchContent",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundTransparency = 1,
+
+		swatch({
+			Entry = props.SelectedEntry,
+			AnchorPoint = Vector2.new(0.5, 0),
+			Position = UDim2.new(0.5, 0, 0, TOUCH_SWATCH_TOP),
+		}),
+		create("TextLabel")({
+			Name = "Label",
+			Position = UDim2.fromOffset(0, TOUCH_LABEL_TOP),
+			Size = UDim2.new(1, 0, 0, TOUCH_LABEL_HEIGHT),
+			BackgroundTransparency = 1,
+			FontFace = Theme.BoldFont,
+			TextSize = TOUCH_LABEL_TEXT_SIZE,
+			TextColor3 = Theme.Colors.Text,
+			TextTruncate = Enum.TextTruncate.AtEnd,
+			Text = "Blocks",
+		}),
+	})
+end
+
+local function desktopContent(props: InventoryButtonProps): Frame
+	local textWidth = -(DESKTOP_TEXT_LEFT + HINT_SIZE + 2 * DESKTOP_PADDING)
+
+	return create("Frame")({
+		Name = "DesktopContent",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundTransparency = 1,
+
+		swatch({
+			Entry = props.SelectedEntry,
+			AnchorPoint = Vector2.new(0, 0.5),
+			Position = UDim2.new(0, DESKTOP_PADDING, 0.5, 0),
+		}),
+		create("TextLabel")({
+			Name = "Title",
+			Position = UDim2.fromOffset(DESKTOP_TEXT_LEFT, DESKTOP_TITLE_TOP),
+			Size = UDim2.new(1, textWidth, 0, DESKTOP_TITLE_HEIGHT),
+			BackgroundTransparency = 1,
+			FontFace = Theme.BoldFont,
+			TextSize = DESKTOP_TITLE_TEXT_SIZE,
+			TextColor3 = Theme.Colors.Text,
+			TextXAlignment = Enum.TextXAlignment.Left,
+			TextTruncate = Enum.TextTruncate.AtEnd,
+			Text = "Blocks",
+		}),
+		create("TextLabel")({
+			Name = "SelectedBlock",
+			Position = UDim2.fromOffset(DESKTOP_TEXT_LEFT, DESKTOP_SUBTITLE_TOP),
+			Size = UDim2.new(1, textWidth, 0, DESKTOP_SUBTITLE_HEIGHT),
+			BackgroundTransparency = 1,
+			FontFace = Theme.RegularFont,
+			TextSize = DESKTOP_SUBTITLE_TEXT_SIZE,
+			TextColor3 = Theme.Colors.TextMuted,
+			TextXAlignment = Enum.TextXAlignment.Left,
+			TextTruncate = Enum.TextTruncate.AtEnd,
+			Text = function()
+				local entry = props.SelectedEntry()
+				return if entry then entry.DisplayName else ""
+			end,
+		}),
+		keyHint({
+			KeyCode = function()
+				return props.HintKeyCode() or Enum.KeyCode.B
+			end,
+			Size = HINT_SIZE,
+			TextSize = HINT_TEXT_SIZE,
+			AnchorPoint = Vector2.new(1, 0.5),
+			Position = UDim2.new(1, -DESKTOP_PADDING, 0.5, 0),
+			Visible = function()
+				return props.HintKeyCode() ~= nil
+			end,
+		}),
+	})
+end
+
+local function inventoryButton(props: InventoryButtonProps): TextButton
+	local guiState = source(Enum.GuiState.Idle)
+
+	local function isTouch(): boolean
+		return props.Layout() == "Touch"
+	end
+
+	return create("TextButton")({
+		Name = "InventoryButton",
+		Text = "",
+		AnchorPoint = function()
+			return if isTouch() then Vector2.new(1, 0) else Vector2.new(0.5, 1)
+		end,
+		Position = function()
+			local sink = if guiState() == Enum.GuiState.Press then PRESS_SINK else 0
+			return if isTouch()
+				then UDim2.new(1, -EDGE_MARGIN, 0, EDGE_MARGIN + sink)
+				else UDim2.new(0.5, 0, 1, -DESKTOP_BOTTOM_MARGIN + sink)
+		end,
+		Size = function()
+			return if isTouch()
+				then UDim2.fromOffset(TOUCH_SIZE, TOUCH_SIZE)
+				else UDim2.fromOffset(DESKTOP_SIZE.X, DESKTOP_SIZE.Y)
+		end,
+		BackgroundColor3 = function()
+			local state = guiState()
+			if state == Enum.GuiState.Press then
+				return Theme.Colors.ButtonPressed
+			elseif state == Enum.GuiState.Hover then
+				return Theme.Colors.ButtonHover
+			end
+			return Theme.Colors.Panel
+		end,
+		BackgroundTransparency = props.BackgroundTransparency,
+		Activated = props.Activated,
+
+		changed("GuiState", guiState),
+		create("UICorner")({ CornerRadius = UDim.new(0, CORNER_RADIUS) }),
+		create("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			Color = Theme.Colors.PanelStroke,
+			Thickness = STROKE,
+		}),
+
+		show(isTouch, function()
+			return touchContent(props)
+		end, function()
+			return desktopContent(props)
+		end),
+	})
+end
+
+return inventoryButton
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/inventoryPanel.luau b/src/StarterPlayer/StarterPlayerScripts/UI/inventoryPanel.luau
new file mode 100644
index 0000000..8172bd5
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/inventoryPanel.luau
@@ -0,0 +1,619 @@
+--!strict
+--[[
+	The block inventory panel: every block type with how many the player has,
+	which are locked and the level that unlocks them, and a line of details for
+	the block under the pointer, under gamepad focus, or last refused. Picking an
+	available block calls Pick, and the caller closes the panel.
+]]
+
+const ContextActionService = game:GetService("ContextActionService")
+const GuiService = game:GetService("GuiService")
+const RunService = game:GetService("RunService")
+const UserInputService = game:GetService("UserInputService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const changed = Vide.changed
+const cleanup = Vide.cleanup
+const create = Vide.create
+const derive = Vide.derive
+const effect = Vide.effect
+const indexes = Vide.indexes
+const source = Vide.source
+const spring = Vide.spring
+
+const blockTile = require("./Components/blockTile")
+const keyHint = require("./Components/keyHint")
+const Screen = require("./Screen")
+const Theme = require("./Theme")
+const TileMetrics = require("./Components/TileMetrics")
+
+const CLOSE_ACTION = "CloseBlockInventory"
+const COLUMNS = 5
+const EDGE_PADDING = 16
+const MINIMUM_FIT_SCALE = 0.5
+const SLIDE_DISTANCE = 24
+const OPEN_PERIOD = 0.25
+const GAMEPAD_HINTS_WIDTH = 230
+const GAMEPAD_HINT_SIZE = 36
+const GAMEPAD_HINT_TEXT_SIZE = 18
+const PICK_HINT_WIDTH = 56
+const CLOSE_HINT_WIDTH = 70
+const CLOSE_TEXT_SIZE = 36
+const BUTTON_RADIUS = 12
+const PANEL_STROKE = 2
+const FOCUS_STROKE = 3
+const FOCUS_OUTSET = 4
+const INFO_GAP = 8
+const CENTER = Vector2.new(0.5, 0.5)
+
+const InventoryTypes = require("./InventoryTypes")
+
+type BlockEntry = InventoryTypes.BlockEntry
+type PickResult = InventoryTypes.PickResult
+type InputKind = InventoryTypes.InputKind
+type PanelMetrics = {
+	Tile: TileMetrics.TileMetrics,
+	Gap: number,
+	Padding: number,
+	CornerRadius: number,
+	HeaderHeight: number,
+	TitleWidth: number,
+	TitleTextSize: number,
+	CloseSize: number,
+	InfoTextSize: number,
+	-- 0 puts the details line in the header instead of a footer.
+	FooterHeight: number,
+}
+
+export type InventoryPanelProps = {
+	Entries: () -> { BlockEntry },
+	Level: () -> number,
+	SelectedName: () -> string,
+	IsCompact: () -> boolean,
+	Input: () -> InputKind,
+	IsReducedMotion: () -> boolean,
+	-- The backdrop's transparency once open, after the player's settings.
+	BackdropTransparency: () -> number,
+	Present: () -> boolean,
+	Pick: (name: string) -> PickResult,
+	Close: () -> (),
+}
+
+const REGULAR: PanelMetrics = table.freeze({
+	Tile = TileMetrics.Regular,
+	Gap = 12,
+	Padding = 20,
+	CornerRadius = 20,
+	HeaderHeight = 56,
+	TitleWidth = 200,
+	TitleTextSize = 32,
+	CloseSize = 56,
+	InfoTextSize = 20,
+	FooterHeight = 48,
+})
+
+-- Sized to fit a 667 by 375 phone below the topbar without shrinking.
+const COMPACT: PanelMetrics = table.freeze({
+	Tile = TileMetrics.Compact,
+	Gap = 10,
+	Padding = 12,
+	CornerRadius = 16,
+	HeaderHeight = 48,
+	TitleWidth = 100,
+	TitleTextSize = 26,
+	CloseSize = 48,
+	InfoTextSize = 16,
+	FooterHeight = 0,
+})
+
+local function rowCount(entries: { BlockEntry }): number
+	return math.max(1, math.ceil(#entries / COLUMNS))
+end
+
+local function gridSize(metrics: PanelMetrics, rows: number): Vector2
+	local tile = metrics.Tile.Size
+	return Vector2.new(
+		COLUMNS * tile + (COLUMNS - 1) * metrics.Gap,
+		rows * tile + (rows - 1) * metrics.Gap
+	)
+end
+
+local function panelSize(metrics: PanelMetrics, rows: number): Vector2
+	local grid = gridSize(metrics, rows)
+	local footer = if metrics.FooterHeight > 0 then metrics.Gap + metrics.FooterHeight else 0
+	return Vector2.new(
+		grid.X + metrics.Padding * 2,
+		metrics.Padding * 2 + metrics.HeaderHeight + metrics.Gap + grid.Y + footer
+	)
+end
+
+local function fitScale(designSize: () -> Vector2): () -> number
+	return function(): number
+		local design = designSize()
+		local usable = Screen.usableSize()
+		local fit = math.min(
+			(usable.X - EDGE_PADDING * 2) / design.X,
+			(usable.Y - EDGE_PADDING * 2) / design.Y
+		)
+		return math.clamp(fit, MINIMUM_FIT_SCALE, 1)
+	end
+end
+
+local function infoLabel(props: {
+	Text: () -> string,
+	TextSize: () -> number,
+	Position: UDim2 | () -> UDim2,
+	Size: () -> UDim2,
+	Visible: boolean | () -> boolean,
+}): GuiObject
+	return create("TextLabel")({
+		Name = "Details",
+		BackgroundTransparency = 1,
+		FontFace = Theme.RegularFont,
+		TextColor3 = Theme.Colors.Text,
+		TextXAlignment = Enum.TextXAlignment.Left,
+		TextWrapped = true,
+		TextTruncate = Enum.TextTruncate.AtEnd,
+		Text = props.Text,
+		TextSize = props.TextSize,
+		Position = props.Position,
+		Size = props.Size,
+		Visible = props.Visible,
+	})
+end
+
+local function hintLabel(props: {
+	Text: string,
+	Width: number,
+	LayoutOrder: number,
+	TextSize: () -> number,
+}): TextLabel
+	return create("TextLabel")({
+		Name = `{props.Text}Hint`,
+		LayoutOrder = props.LayoutOrder,
+		Size = UDim2.new(0, props.Width, 1, 0),
+		TextXAlignment = Enum.TextXAlignment.Left,
+		BackgroundTransparency = 1,
+		FontFace = Theme.BoldFont,
+		TextColor3 = Theme.Colors.Text,
+		TextTruncate = Enum.TextTruncate.AtEnd,
+		TextSize = props.TextSize,
+		Text = props.Text,
+	})
+end
+
+local function gamepadHints(props: { TextSize: () -> number, Visible: () -> boolean }): GuiObject
+	return create("Frame")({
+		Name = "GamepadHints",
+		AnchorPoint = Vector2.new(1, 0.5),
+		Position = UDim2.fromScale(1, 0.5),
+		Size = UDim2.new(0, GAMEPAD_HINTS_WIDTH, 1, 0),
+		BackgroundTransparency = 1,
+		Visible = props.Visible,
+
+		create("UIListLayout")({
+			FillDirection = Enum.FillDirection.Horizontal,
+			HorizontalAlignment = Enum.HorizontalAlignment.Right,
+			VerticalAlignment = Enum.VerticalAlignment.Center,
+			Padding = UDim.new(0, INFO_GAP),
+		}),
+		keyHint({
+			KeyCode = function()
+				return Enum.KeyCode.ButtonA
+			end,
+			Size = GAMEPAD_HINT_SIZE,
+			TextSize = GAMEPAD_HINT_TEXT_SIZE,
+			LayoutOrder = 1,
+		}),
+		hintLabel({
+			Text = "Pick",
+			Width = PICK_HINT_WIDTH,
+			LayoutOrder = 2,
+			TextSize = props.TextSize,
+		}),
+		keyHint({
+			KeyCode = function()
+				return Enum.KeyCode.ButtonB
+			end,
+			Size = GAMEPAD_HINT_SIZE,
+			TextSize = GAMEPAD_HINT_TEXT_SIZE,
+			LayoutOrder = 3,
+		}),
+		hintLabel({
+			Text = "Close",
+			Width = CLOSE_HINT_WIDTH,
+			LayoutOrder = 4,
+			TextSize = props.TextSize,
+		}),
+	})
+end
+
+local function closeButton(props: {
+	Metrics: () -> PanelMetrics,
+	SelectionImage: GuiObject,
+	Activated: () -> (),
+}): TextButton
+	local guiState = source(Enum.GuiState.Idle)
+
+	return create("TextButton")({
+		Name = "Close",
+		AnchorPoint = Vector2.new(1, 0.5),
+		Position = UDim2.fromScale(1, 0.5),
+		Size = function()
+			local size = props.Metrics().CloseSize
+			return UDim2.fromOffset(size, size)
+		end,
+		BackgroundColor3 = function()
+			local state = guiState()
+			if state == Enum.GuiState.Press then
+				return Theme.Colors.ButtonPressed
+			elseif state == Enum.GuiState.Hover then
+				return Theme.Colors.ButtonHover
+			end
+			return Theme.Colors.Button
+		end,
+		FontFace = Theme.BoldFont,
+		TextColor3 = Theme.Colors.Text,
+		TextSize = CLOSE_TEXT_SIZE,
+		Text = "×",
+		SelectionImageObject = props.SelectionImage,
+		-- Keeps first gamepad focus on the tiles.
+		SelectionOrder = 100,
+		Activated = props.Activated,
+
+		changed("GuiState", guiState),
+		create("UICorner")({ CornerRadius = UDim.new(0, BUTTON_RADIUS) }),
+	})
+end
+
+local function inventoryPanel(props: InventoryPanelProps): Frame
+	local metrics = derive(function(): PanelMetrics
+		return if props.IsCompact() then COMPACT else REGULAR
+	end)
+	local rows = derive(function(): number
+		return rowCount(props.Entries())
+	end)
+	local function designSize(): Vector2
+		return panelSize(metrics(), rows())
+	end
+	local openProgress = spring(function()
+		return if props.Present() then 1 else 0
+	end, OPEN_PERIOD)
+	local detailName = source(nil :: string?)
+
+	-- The panel stays through its exit animation; presses then must do nothing.
+	local function isShown(): boolean
+		return props.Present()
+	end
+
+	local function closeIfShown()
+		if isShown() then
+			props.Close()
+		end
+	end
+
+	local selectionImage = create("Frame")({
+		Name = "FocusRing",
+		BackgroundTransparency = 1,
+		Position = UDim2.fromOffset(-FOCUS_OUTSET, -FOCUS_OUTSET),
+		Size = UDim2.new(1, 2 * FOCUS_OUTSET, 1, 2 * FOCUS_OUTSET),
+
+		create("UICorner")({
+			CornerRadius = function()
+				return UDim.new(0, metrics().Tile.CornerRadius + FOCUS_OUTSET)
+			end,
+		}),
+		create("UIStroke")({
+			Color = Theme.Colors.Focus,
+			Thickness = FOCUS_STROKE,
+		}),
+	})
+	cleanup(selectionImage)
+
+	local function findEntry(name: string): BlockEntry?
+		for _, entry in props.Entries() do
+			if entry.Name == name then
+				return entry
+			end
+		end
+		return nil
+	end
+
+	local function detailText(): string
+		local name = detailName()
+		local entry = if name then findEntry(name) else nil
+		if not entry then
+			local input = props.Input()
+			if input == "Touch" then
+				return "Tap a block to build with it."
+			elseif input == "Gamepad" then
+				return "Pick a block to build with it."
+			end
+			return "Click a block, or press its number key."
+		end
+
+		if not entry.IsUnlocked then
+			return `🔒 Reach level {entry.UnlockLevel} to unlock {entry.DisplayName}. `
+				.. `You're level {props.Level()}.`
+		elseif entry.Count <= 0 then
+			return `You have no {entry.DisplayName} yet. Collect some to build with it.`
+		elseif entry.Name == props.SelectedName() then
+			return `Building with {entry.DisplayName}. You have {entry.Count}.`
+		end
+		return `{entry.DisplayName}: you have {entry.Count}.`
+	end
+
+	local grid = create("Frame")({
+		Name = "Grid",
+		BackgroundTransparency = 1,
+		Position = function()
+			local current = metrics()
+			return UDim2.fromOffset(0, current.HeaderHeight + current.Gap)
+		end,
+		Size = function()
+			local size = gridSize(metrics(), rows())
+			return UDim2.fromOffset(size.X, size.Y)
+		end,
+
+		create("UIGridLayout")({
+			CellSize = function()
+				local size = metrics().Tile.Size
+				return UDim2.fromOffset(size, size)
+			end,
+			CellPadding = function()
+				local gap = metrics().Gap
+				return UDim2.fromOffset(gap, gap)
+			end,
+			FillDirectionMaxCells = COLUMNS,
+		}),
+
+		indexes(props.Entries, function(entry: () -> BlockEntry, index: number)
+			local name = entry().Name
+
+			return blockTile({
+				Entry = entry,
+				Metrics = function()
+					return metrics().Tile
+				end,
+				IsSelected = function()
+					return props.SelectedName() == name
+				end,
+				ShowsHotkey = function()
+					return props.Input() == "KeyboardAndMouse"
+				end,
+				IsReducedMotion = props.IsReducedMotion,
+				LayoutOrder = index,
+				SelectionImage = selectionImage,
+				Activated = function(): boolean
+					if not isShown() then
+						return true
+					end
+					if props.Pick(name) == "Picked" then
+						return true
+					end
+					detailName(name)
+					return false
+				end,
+				HighlightChanged = function(isHighlighted: boolean)
+					if isHighlighted then
+						detailName(name)
+					elseif detailName() == name then
+						detailName(nil)
+					end
+				end,
+			})
+		end),
+	})
+
+	local panel = create("Frame")({
+		Name = "Panel",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundColor3 = Theme.Colors.Panel,
+		Active = true,
+		SelectionGroup = true,
+		SelectionBehaviorUp = Enum.SelectionBehavior.Stop,
+		SelectionBehaviorDown = Enum.SelectionBehavior.Stop,
+		SelectionBehaviorLeft = Enum.SelectionBehavior.Stop,
+		SelectionBehaviorRight = Enum.SelectionBehavior.Stop,
+
+		create("UICorner")({
+			CornerRadius = function()
+				return UDim.new(0, metrics().CornerRadius)
+			end,
+		}),
+		create("UIStroke")({
+			Color = Theme.Colors.PanelStroke,
+			Thickness = PANEL_STROKE,
+		}),
+		create("UIPadding")({
+			PaddingTop = function()
+				return UDim.new(0, metrics().Padding)
+			end,
+			PaddingBottom = function()
+				return UDim.new(0, metrics().Padding)
+			end,
+			PaddingLeft = function()
+				return UDim.new(0, metrics().Padding)
+			end,
+			PaddingRight = function()
+				return UDim.new(0, metrics().Padding)
+			end,
+		}),
+
+		create("Frame")({
+			Name = "Header",
+			BackgroundTransparency = 1,
+			Size = function()
+				return UDim2.new(1, 0, 0, metrics().HeaderHeight)
+			end,
+
+			create("TextLabel")({
+				Name = "Title",
+				BackgroundTransparency = 1,
+				Size = function()
+					return UDim2.new(0, metrics().TitleWidth, 1, 0)
+				end,
+				FontFace = Theme.BoldFont,
+				TextColor3 = Theme.Colors.Text,
+				TextXAlignment = Enum.TextXAlignment.Left,
+				TextTruncate = Enum.TextTruncate.AtEnd,
+				TextSize = function()
+					return metrics().TitleTextSize
+				end,
+				Text = "Blocks",
+			}),
+			infoLabel({
+				Text = detailText,
+				TextSize = function()
+					return metrics().InfoTextSize
+				end,
+				Position = function()
+					return UDim2.fromOffset(metrics().TitleWidth + INFO_GAP, 0)
+				end,
+				Size = function()
+					local current = metrics()
+					local taken = current.TitleWidth + current.CloseSize + 2 * INFO_GAP
+					return UDim2.new(1, -taken, 1, 0)
+				end,
+				Visible = function()
+					return metrics().FooterHeight == 0
+				end,
+			}),
+			closeButton({
+				Metrics = metrics,
+				SelectionImage = selectionImage,
+				Activated = closeIfShown,
+			}),
+		}),
+
+		grid,
+
+		create("Frame")({
+			Name = "Footer",
+			BackgroundTransparency = 1,
+			AnchorPoint = Vector2.new(0, 1),
+			Position = UDim2.fromScale(0, 1),
+			Size = function()
+				return UDim2.new(1, 0, 0, metrics().FooterHeight)
+			end,
+			Visible = function()
+				return metrics().FooterHeight > 0
+			end,
+
+			infoLabel({
+				Text = detailText,
+				TextSize = function()
+					return metrics().InfoTextSize
+				end,
+				Position = UDim2.new(),
+				Size = function()
+					local reserved = if props.Input() == "Gamepad" then GAMEPAD_HINTS_WIDTH else 0
+					return UDim2.new(1, -reserved, 1, 0)
+				end,
+				Visible = true,
+			}),
+			gamepadHints({
+				TextSize = function()
+					return metrics().InfoTextSize
+				end,
+				Visible = function()
+					return props.Input() == "Gamepad"
+				end,
+			}),
+		}),
+	})
+
+	if RunService:IsRunning() then
+		-- Deferred, so the panel is on screen before it takes focus.
+		effect(function()
+			if not (props.Present() and props.Input() == "Gamepad") then
+				return
+			end
+			cleanup(task.defer(function()
+				local selected = GuiService.SelectedObject
+				if not (selected and selected:IsDescendantOf(panel)) then
+					GuiService:Select(grid)
+				end
+			end))
+		end)
+
+		local function isBackHeld(): boolean
+			for _, gamepad in UserInputService:GetConnectedGamepads() do
+				if UserInputService:IsGamepadButtonDown(gamepad, Enum.KeyCode.ButtonB) then
+					return true
+				end
+			end
+			return false
+		end
+
+		-- Roblox's own B clears gamepad focus, which may run before the binding
+		-- below. Focus also clears when the player touches the mouse or screen,
+		-- which must not close the panel, hence the button check.
+		cleanup(GuiService:GetPropertyChangedSignal("SelectedObject"):Connect(function()
+			local selected = GuiService.SelectedObject
+			if not (selected and selected:IsDescendantOf(panel)) and isBackHeld() then
+				props.Close()
+			end
+		end))
+
+		local function onCloseAction(
+			_: string,
+			inputState: Enum.UserInputState
+		): Enum.ContextActionResult
+			if inputState == Enum.UserInputState.Begin then
+				props.Close()
+			end
+			return Enum.ContextActionResult.Sink
+		end
+		ContextActionService:BindActionAtPriority(
+			CLOSE_ACTION,
+			onCloseAction,
+			false,
+			Enum.ContextActionPriority.High.Value,
+			Enum.KeyCode.ButtonB
+		)
+		cleanup(function()
+			ContextActionService:UnbindAction(CLOSE_ACTION)
+		end)
+	end
+
+	return create("Frame")({
+		Name = "InventoryOverlay",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundTransparency = 1,
+
+		create("TextButton")({
+			Name = "Backdrop",
+			Size = UDim2.fromScale(1, 1),
+			Text = "",
+			BackgroundColor3 = Theme.Colors.Backdrop,
+			BackgroundTransparency = function()
+				return 1 - (1 - props.BackdropTransparency()) * openProgress()
+			end,
+			Selectable = false,
+			Activated = closeIfShown,
+		}),
+
+		create("Frame")({
+			Name = "PanelDock",
+			AnchorPoint = CENTER,
+			BackgroundTransparency = 1,
+			Position = function()
+				local slide = if props.IsReducedMotion()
+					then 0
+					else (1 - openProgress()) * SLIDE_DISTANCE
+				return UDim2.new(0.5, 0, 0.5, math.round(slide))
+			end,
+			Size = function()
+				local size = designSize()
+				return UDim2.fromOffset(size.X, size.Y)
+			end,
+
+			create("UIScale")({ Scale = fitScale(designSize) }),
+			panel,
+		}),
+	})
+end
+
+return inventoryPanel
