+--!strict
+--[[
+	Sizes of a block tile, in UI units, for the regular and compact (phone)
+	inventory layouts.
+]]
+
+export type TileMetrics = {
+	Size: number,
+	CornerRadius: number,
+	SwatchSize: number,
+	SwatchTop: number,
+	NameTop: number,
+	NameHeight: number,
+	NameTextSize: number,
+	StatusTop: number,
+	StatusHeight: number,
+	StatusTextSize: number,
+	BadgeSize: number,
+	BadgeInset: number,
+	BadgeTextSize: number,
+}
+
+const REGULAR: TileMetrics = table.freeze({
+	Size = 120,
+	CornerRadius = 14,
+	SwatchSize = 48,
+	SwatchTop = 10,
+	NameTop = 64,
+	NameHeight = 22,
+	NameTextSize = 20,
+	StatusTop = 88,
+	StatusHeight = 22,
+	StatusTextSize = 20,
+	BadgeSize = 26,
+	BadgeInset = 6,
+	BadgeTextSize = 18,
+})
+
+const COMPACT: TileMetrics = table.freeze({
+	Size = 96,
+	CornerRadius = 12,
+	SwatchSize = 36,
+	SwatchTop = 8,
+	NameTop = 48,
+	NameHeight = 18,
+	NameTextSize = 16,
+	StatusTop = 68,
+	StatusHeight = 20,
+	StatusTextSize = 18,
+	BadgeSize = 22,
+	BadgeInset = 5,
+	BadgeTextSize = 15,
+})
+
+return table.freeze({
+	Regular = REGULAR,
+	Compact = COMPACT,
+})
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/blockTile.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/blockTile.luau
new file mode 100644
index 0000000..c8280bf
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/blockTile.luau
@@ -0,0 +1,306 @@
+--!strict
+--[[
+	One block type in the inventory grid: its color, its name, and how many the
+	player has, or a lock and the level that unlocks it. The block being built
+	with gets a yellow outline and a check mark, so selection never relies on
+	color alone.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const changed = Vide.changed
+const create = Vide.create
+const source = Vide.source
+const spring = Vide.spring
+
+const Theme = require("../Theme")
+
+const SHAKE_VELOCITY = 500
+const SHAKE_PERIOD = 0.25
+const SHAKE_DAMPING = 0.3
+const PRESS_SINK = 2
+const LOCKED_TINT = 0.7
+const EMPTY_SWATCH_TRANSPARENCY = 0.55
+const SWATCH_RADIUS = 10
+const SWATCH_STROKE = 2
+const SELECTED_STROKE = 4
+const CHECK_STROKE = 3
+const LABEL_INSET = 4
+const LOCK_ICON_SCALE = 0.6
+const COUNT_ABBREVIATE_AT = 10000
+
+const InventoryTypes = require("../InventoryTypes")
+const TileMetrics = require("./TileMetrics")
+
+type BlockEntry = InventoryTypes.BlockEntry
+type Metrics = TileMetrics.TileMetrics
+
+export type BlockTileProps = {
+	Entry: () -> BlockEntry,
+	Metrics: () -> Metrics,
+	IsSelected: () -> boolean,
+	ShowsHotkey: () -> boolean,
+	IsReducedMotion: () -> boolean,
+	LayoutOrder: number,
+	SelectionImage: GuiObject?,
+	-- Returns whether the pick was accepted; a refused pick shakes the tile.
+	Activated: () -> boolean,
+	HighlightChanged: (isHighlighted: boolean) -> (),
+}
+
+local function formatCount(count: number): string
+	if count < COUNT_ABBREVIATE_AT then
+		return tostring(count)
+	end
+	return `{math.floor(count / 1000)}K`
+end
+
+local function isAvailable(entry: BlockEntry): boolean
+	return entry.IsUnlocked and entry.Count > 0
+end
+
+local function checkMark(props: { Metrics: () -> Metrics, Visible: () -> boolean }): Frame
+	-- Drawn from two bars, since a check glyph is missing from some fonts.
+	return create("Frame")({
+		Name = "CheckBadge",
+		AnchorPoint = Vector2.new(1, 0),
+		Position = function()
+			local inset = props.Metrics().BadgeInset
+			return UDim2.new(1, -inset, 0, inset)
+		end,
+		Size = function()
+			local size = props.Metrics().BadgeSize
+			return UDim2.fromOffset(size, size)
+		end,
+		BackgroundColor3 = Theme.Colors.Selected,
+		Visible = props.Visible,
+
+		create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+		create("Frame")({
+			Name = "Short",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.36, 0.56),
+			Size = UDim2.new(0.3, 0, 0, CHECK_STROKE),
+			Rotation = 45,
+			BackgroundColor3 = Theme.Colors.SelectedMark,
+		}),
+		create("Frame")({
+			Name = "Long",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.57, 0.48),
+			Size = UDim2.new(0.5, 0, 0, CHECK_STROKE),
+			Rotation = -45,
+			BackgroundColor3 = Theme.Colors.SelectedMark,
+		}),
+	})
+end
+
+local function blockTile(props: BlockTileProps): TextButton
+	local guiState = source(Enum.GuiState.Idle)
+	local isFocused = source(false)
+	local hasPointer = false
+	local hasFocus = false
+	local shakeOffset, shakeControl = spring(function()
+		return 0
+	end, SHAKE_PERIOD, SHAKE_DAMPING)
+
+	local function reportHighlight()
+		props.HighlightChanged(hasPointer or hasFocus)
+	end
+
+	local function textColor(): Color3
+		return if isAvailable(props.Entry()) then Theme.Colors.Text else Theme.Colors.TextMuted
+	end
+
+	return create("TextButton")({
+		Name = `Tile{props.Entry().Name}`,
+		-- A grid's CellSize overrides this.
+		Size = UDim2.fromScale(1, 1),
+		Text = "",
+		LayoutOrder = props.LayoutOrder,
+		SelectionImageObject = props.SelectionImage,
+		-- Gamepad focus starts on the block being built with.
+		SelectionOrder = function()
+			return if props.IsSelected() then 0 else props.LayoutOrder
+		end,
+		BackgroundColor3 = function()
+			local state = guiState()
+			if not isAvailable(props.Entry()) then
+				return Theme.Colors.TileUnavailable
+			elseif state == Enum.GuiState.Press then
+				return Theme.Colors.TilePressed
+			elseif state == Enum.GuiState.Hover or isFocused() then
+				return Theme.Colors.TileHover
+			end
+			return Theme.Colors.Tile
+		end,
+
+		Activated = function()
+			if props.Activated() then
+				return
+			end
+			if not props.IsReducedMotion() then
+				shakeControl({ velocity = SHAKE_VELOCITY })
+			end
+		end,
+		MouseEnter = function()
+			hasPointer = true
+			reportHighlight()
+		end,
+		MouseLeave = function()
+			hasPointer = false
+			reportHighlight()
+		end,
+		SelectionGained = function()
+			hasFocus = true
+			isFocused(true)
+			reportHighlight()
+		end,
+		SelectionLost = function()
+			hasFocus = false
+			isFocused(false)
+			reportHighlight()
+		end,
+
+		changed("GuiState", guiState),
+
+		create("UICorner")({
+			CornerRadius = function()
+				return UDim.new(0, props.Metrics().CornerRadius)
+			end,
+		}),
+		create("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			BorderStrokePosition = Enum.BorderStrokePosition.Inner,
+			Color = Theme.Colors.Selected,
+			Thickness = SELECTED_STROKE,
+			Enabled = props.IsSelected,
+		}),
+
+		create("Frame")({
+			Name = "Content",
+			Size = UDim2.fromScale(1, 1),
+			BackgroundTransparency = 1,
+			Position = function()
+				local sink = if guiState() == Enum.GuiState.Press then PRESS_SINK else 0
+				return UDim2.fromOffset(math.round(shakeOffset()), sink)
+			end,
+
+			create("Frame")({
+				Name = "Swatch",
+				AnchorPoint = Vector2.new(0.5, 0),
+				Position = function()
+					return UDim2.new(0.5, 0, 0, props.Metrics().SwatchTop)
+				end,
+				Size = function()
+					local size = props.Metrics().SwatchSize
+					return UDim2.fromOffset(size, size)
+				end,
+				BackgroundColor3 = function()
+					local entry = props.Entry()
+					return if entry.IsUnlocked
+						then entry.Color
+						else entry.Color:Lerp(Theme.Colors.LockedSwatch, LOCKED_TINT)
+				end,
+				BackgroundTransparency = function()
+					local entry = props.Entry()
+					return if entry.IsUnlocked and entry.Count <= 0
+						then EMPTY_SWATCH_TRANSPARENCY
+						else 0
+				end,
+
+				create("UICorner")({ CornerRadius = UDim.new(0, SWATCH_RADIUS) }),
+				create("UIStroke")({
+					Color = Theme.Colors.KeyCap,
+					Thickness = SWATCH_STROKE,
+				}),
+				create("TextLabel")({
+					Name = "Lock",
+					Size = UDim2.fromScale(1, 1),
+					BackgroundTransparency = 1,
+					Text = "🔒",
+					TextSize = function()
+						return math.round(props.Metrics().SwatchSize * LOCK_ICON_SCALE)
+					end,
+					Visible = function()
+						return not props.Entry().IsUnlocked
+					end,
+				}),
+			}),
+
+			create("TextLabel")({
+				Name = "BlockName",
+				Position = function()
+					return UDim2.fromOffset(LABEL_INSET, props.Metrics().NameTop)
+				end,
+				Size = function()
+					return UDim2.new(1, -2 * LABEL_INSET, 0, props.Metrics().NameHeight)
+				end,
+				BackgroundTransparency = 1,
+				FontFace = Theme.BoldFont,
+				TextSize = function()
+					return props.Metrics().NameTextSize
+				end,
+				TextColor3 = textColor,
+				TextTruncate = Enum.TextTruncate.AtEnd,
+				Text = function()
+					return props.Entry().DisplayName
+				end,
+			}),
+
+			create("TextLabel")({
+				Name = "Status",
+				Position = function()
+					return UDim2.fromOffset(LABEL_INSET, props.Metrics().StatusTop)
+				end,
+				Size = function()
+					return UDim2.new(1, -2 * LABEL_INSET, 0, props.Metrics().StatusHeight)
+				end,
+				BackgroundTransparency = 1,
+				FontFace = Theme.BoldFont,
+				TextSize = function()
+					return props.Metrics().StatusTextSize
+				end,
+				TextColor3 = textColor,
+				TextTruncate = Enum.TextTruncate.AtEnd,
+				Text = function()
+					local entry = props.Entry()
+					return if entry.IsUnlocked
+						then formatCount(entry.Count)
+						else `Level {entry.UnlockLevel}`
+				end,
+			}),
+
+			create("TextLabel")({
+				Name = "Hotkey",
+				Position = function()
+					local inset = props.Metrics().BadgeInset
+					return UDim2.fromOffset(inset, inset)
+				end,
+				Size = function()
+					local size = props.Metrics().BadgeSize
+					return UDim2.fromOffset(size, size)
+				end,
+				BackgroundColor3 = Theme.Colors.KeyCap,
+				FontFace = Theme.BoldFont,
+				TextSize = function()
+					return props.Metrics().BadgeTextSize
+				end,
+				TextColor3 = Theme.Colors.Text,
+				Text = function()
+					return props.Entry().Hotkey
+				end,
+				Visible = props.ShowsHotkey,
+
+				create("UICorner")({ CornerRadius = UDim.new(0, SWATCH_RADIUS / 2) }),
+			}),
+
+			checkMark({
+				Metrics = props.Metrics,
+				Visible = props.IsSelected,
+			}),
+		}),
+	})
+end
+
+return blockTile
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/keyHint.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/keyHint.luau
new file mode 100644
index 0000000..e0c1ebf
--- /dev/null
