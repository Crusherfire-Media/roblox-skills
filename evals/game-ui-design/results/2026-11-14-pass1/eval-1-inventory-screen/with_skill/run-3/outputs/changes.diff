@@ -0,0 +1,66 @@
+--!strict
+--[[
+	Sample block inventories for the inventory stories, built from the real
+	block catalog and unlock levels so a new or renamed block shows up here.
+]]
+
+const BlockInventory = require("@game/StarterPlayer/StarterPlayerScripts/BlockInventory")
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+-- Keep in step with HOTKEYS in UI/InventoryState.
+const HOTKEYS = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" }
+const HUGE_COUNT = 123456
+const LONG_NAME_SUFFIX = " Super Long Name"
+
+const InventoryTypes = require("@game/StarterPlayer/StarterPlayerScripts/UI/InventoryTypes")
+
+type BlockEntry = InventoryTypes.BlockEntry
+
+export type Stock = "Typical" | "Empty" | "Huge"
+
+export type SampleOptions = {
+	Level: number,
+	Stock: Stock,
+	HasLongNames: boolean,
+}
+
+local Module = {}
+
+Module.Stocks = { "Typical", "Empty", "Huge" }
+Module.Inputs = { "Touch", "KeyboardAndMouse", "Gamepad" }
+
+local function sampleCount(stock: Stock, index: number): number
+	if stock == "Empty" then
+		return 0
+	elseif stock == "Huge" then
+		return HUGE_COUNT
+	end
+	-- Every fourth block is empty, so the empty state shows beside full ones.
+	return if index % 4 == 0 then 0 else index * 23
+end
+
+function Module.entries(options: SampleOptions): { BlockEntry }
+	local entries = {}
+	for index, blockType in BlockTypes.List do
+		local unlockLevel = BlockInventory.getUnlockLevel(blockType.Name)
+		local displayName = blockType.DisplayName
+		if options.HasLongNames then
+			displayName ..= LONG_NAME_SUFFIX
+		end
+		table.insert(
+			entries,
+			table.freeze({
+				Name = blockType.Name,
+				DisplayName = displayName,
+				Color = blockType.Color,
+				Count = sampleCount(options.Stock, index),
+				UnlockLevel = unlockLevel,
+				IsUnlocked = options.Level >= unlockLevel,
+				Hotkey = HOTKEYS[index] or "",
+			})
+		)
+	end
+	return table.freeze(entries)
+end
+
+return Module
diff --git a/src/ServerScriptService/Stories/Inventory/blockTile.story.luau b/src/ServerScriptService/Stories/Inventory/blockTile.story.luau
new file mode 100644
index 0000000..8c16ae8
--- /dev/null
+++ b/src/ServerScriptService/Stories/Inventory/blockTile.story.luau
@@ -0,0 +1,125 @@
+--!strict
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const create = Vide.create
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const blockTile = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/blockTile")
+const TileMetrics = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/TileMetrics")
+
+const CONTROLS = {
+	Block = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Position in the block catalog.
+			Index = UILabs.Ordered(UILabs.Slider(1, 1, #BlockTypes.List, 1), 1),
+			Count = UILabs.Ordered(UILabs.Slider(48, 0, 50000, 1), 2),
+			HasLongName = UILabs.Ordered(false, 3),
+		}),
+		1
+	),
+	State = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsUnlocked = UILabs.Ordered(true, 1),
+			UnlockLevel = UILabs.Ordered(UILabs.Slider(6, 1, 20, 1), 2),
+			IsSelected = UILabs.Ordered(false, 3),
+		}),
+		2
+	),
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsCompact = UILabs.Ordered(false, 1),
+			ShowsHotkey = UILabs.Ordered(true, 2),
+		}),
+		3
+	),
+	Motion = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsReducedMotion = UILabs.Ordered(false, 1),
+		}),
+		4
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Block: {
+			Index: () -> number,
+			Count: () -> number,
+			HasLongName: () -> boolean,
+		},
+		State: {
+			IsUnlocked: () -> boolean,
+			UnlockLevel: () -> number,
+			IsSelected: () -> boolean,
+		},
+		Layout: {
+			IsCompact: () -> boolean,
+			ShowsHotkey: () -> boolean,
+		},
+		Motion: {
+			IsReducedMotion: () -> boolean,
+		},
+	},
+}
+
+local function story(props: StoryProps)
+	local block = props.controls.Block
+	local state = props.controls.State
+	local layout = props.controls.Layout
+
+	local function entry()
+		local blockType = BlockTypes.List[block.Index()] or BlockTypes.List[1]
+		return table.freeze({
+			Name = blockType.Name,
+			DisplayName = if block.HasLongName()
+				then `{blockType.DisplayName} Super Long Name`
+				else blockType.DisplayName,
+			Color = blockType.Color,
+			Count = block.Count(),
+			UnlockLevel = state.UnlockLevel(),
+			IsUnlocked = state.IsUnlocked(),
+			Hotkey = tostring(block.Index() % 10),
+		})
+	end
+
+	local function metrics()
+		return if layout.IsCompact() then TileMetrics.Compact else TileMetrics.Regular
+	end
+
+	return create("Frame")({
+		Name = "TileHolder",
+		AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.5),
+		BackgroundTransparency = 1,
+		Size = function()
+			local size = metrics().Size
+			return UDim2.fromOffset(size, size)
+		end,
+
+		blockTile({
+			Entry = entry,
+			Metrics = metrics,
+			IsSelected = state.IsSelected,
+			ShowsHotkey = layout.ShowsHotkey,
+			IsReducedMotion = props.controls.Motion.IsReducedMotion,
+			LayoutOrder = 1,
+			Activated = function(): boolean
+				local current = entry()
+				local isAccepted = current.IsUnlocked and current.Count > 0
+				print(`{current.Name} pick {if isAccepted then "accepted" else "refused"}`)
+				return isAccepted
+			end,
+			HighlightChanged = function(isHighlighted: boolean)
+				print(`highlighted: {isHighlighted}`)
+			end,
+		}),
+	})
+end
+
+return {
+	summary = "One block tile: available, empty, locked, selected, and compact.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
diff --git a/src/ServerScriptService/Stories/Inventory/inventoryButton.story.luau b/src/ServerScriptService/Stories/Inventory/inventoryButton.story.luau
new file mode 100644
index 0000000..ecdb019
--- /dev/null
+++ b/src/ServerScriptService/Stories/Inventory/inventoryButton.story.luau
@@ -0,0 +1,89 @@
+--!strict
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const create = Vide.create
+
+const InventorySamples = require("./InventorySamples")
+const inventoryButton = require("@game/StarterPlayer/StarterPlayerScripts/UI/inventoryButton")
+
+const HINTS = {
+	None = "None",
+	Keyboard = "Keyboard",
+	Gamepad = "Gamepad",
+}
+
+const CONTROLS = {
+	Content = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Position in the block catalog of the block being built with.
+			BlockIndex = UILabs.Ordered(UILabs.Slider(1, 1, 10, 1), 1),
+			HasLongNames = UILabs.Ordered(false, 2),
+		}),
+		1
+	),
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Layout = UILabs.Ordered(UILabs.Choose({ "Touch", "Desktop" }), 1),
+			Hint = UILabs.Ordered(UILabs.Choose({ HINTS.Keyboard, HINTS.Gamepad, HINTS.None }), 2),
+		}),
+		2
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Content: {
+			BlockIndex: () -> number,
+			HasLongNames: () -> boolean,
+		},
+		Layout: {
+			Layout: () -> "Touch" | "Desktop",
+			Hint: () -> string,
+		},
+	},
+}
+
+local function story(props: StoryProps)
+	local content = props.controls.Content
+
+	return create("Frame")({
+		Name = "HudArea",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundTransparency = 1,
+
+		inventoryButton({
+			Layout = props.controls.Layout.Layout,
+			HintKeyCode = function(): Enum.KeyCode?
+				local hint = props.controls.Layout.Hint()
+				if hint == HINTS.Keyboard then
+					return Enum.KeyCode.B
+				elseif hint == HINTS.Gamepad then
+					return Enum.KeyCode.ButtonY
+				end
+				return nil
+			end,
+			SelectedEntry = function()
+				local entries = InventorySamples.entries({
+					Level = 1,
+					Stock = "Typical",
+					HasLongNames = content.HasLongNames(),
+				})
+				return entries[content.BlockIndex()]
+			end,
+			BackgroundTransparency = function()
+				return 0.1
+			end,
+			Activated = function()
+				print("open inventory")
+			end,
+		}),
+	})
+end
+
+return {
+	summary = "The HUD button that opens the inventory, in its touch and desktop layouts.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
diff --git a/src/ServerScriptService/Stories/Inventory/inventoryPanel.story.luau b/src/ServerScriptService/Stories/Inventory/inventoryPanel.story.luau
new file mode 100644
index 0000000..07c2158
--- /dev/null
+++ b/src/ServerScriptService/Stories/Inventory/inventoryPanel.story.luau
@@ -0,0 +1,111 @@
+--!strict
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const source = Vide.source
+
+const InventorySamples = require("./InventorySamples")
+const inventoryPanel = require("@game/StarterPlayer/StarterPlayerScripts/UI/inventoryPanel")
+
+const CONTROLS = {
+	Inventory = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Level = UILabs.Ordered(UILabs.Slider(3, 1, 20, 1), 1),
+			Stock = UILabs.Ordered(UILabs.Choose(InventorySamples.Stocks), 2),
+			HasLongNames = UILabs.Ordered(false, 3),
+		}),
+		1
+	),
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Input = UILabs.Ordered(UILabs.Choose(InventorySamples.Inputs), 1),
+			IsCompact = UILabs.Ordered(false, 2),
+		}),
+		2
+	),
+	Motion = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsReducedMotion = UILabs.Ordered(false, 1),
+		}),
+		3
+	),
+	Preview = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- 0 is the player's fully opaque Background Transparency setting.
+			BackdropTransparency = UILabs.Ordered(UILabs.Slider(0.45, 0, 1, 0.05), 1),
+		}),
+		4
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Inventory: {
+			Level: () -> number,
+			Stock: () -> InventorySamples.Stock,
+			HasLongNames: () -> boolean,
+		},
+		Layout: {
+			Input: () -> "Touch" | "KeyboardAndMouse" | "Gamepad",
+			IsCompact: () -> boolean,
+		},
+		Motion: {
+			IsReducedMotion: () -> boolean,
+		},
+		Preview: {
+			BackdropTransparency: () -> number,
+		},
+	},
+}
+
+local function story(props: StoryProps)
+	local inventory = props.controls.Inventory
+	local selectedName = source("Brick")
+
+	local function entries()
+		return InventorySamples.entries({
+			Level = inventory.Level(),
+			Stock = inventory.Stock(),
+			HasLongNames = inventory.HasLongNames(),
+		})
+	end
+
+	return inventoryPanel({
+		Entries = entries,
+		Level = inventory.Level,
+		SelectedName = selectedName,
+		IsCompact = props.controls.Layout.IsCompact,
+		Input = props.controls.Layout.Input,
+		IsReducedMotion = props.controls.Motion.IsReducedMotion,
+		BackdropTransparency = props.controls.Preview.BackdropTransparency,
+		Present = function()
+			return true
+		end,
+		Pick = function(name: string)
+			for _, entry in entries() do
+				if entry.Name ~= name then
+					continue
+				end
+				if not entry.IsUnlocked then
+					return "Locked"
+				elseif entry.Count <= 0 then
+					return "Empty"
+				end
+				selectedName(name)
+				print(`picked {name}; the game closes the panel here`)
+				return "Picked"
+			end
+			return "Locked"
+		end,
+		Close = function()
+			print("close")
+		end,
+	})
+end
+
+return {
+	summary = "The block inventory panel with sample stock, every input, and the phone layout.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
