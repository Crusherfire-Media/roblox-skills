@@ -0,0 +1,88 @@
+--!strict
+--[[
+	The input that triggers an action: the console's own glyph for a gamepad
+	button, or a key cap for a keyboard key.
+]]
+
+const UserInputService = game:GetService("UserInputService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const create = Vide.create
+
+const Theme = require("../Theme")
+
+const KEY_CAP_RADIUS = 6
+const KEY_CAP_STROKE = 2
+
+export type KeyHintProps = {
+	KeyCode: () -> Enum.KeyCode,
+	Size: number,
+	TextSize: number,
+	AnchorPoint: Vector2?,
+	Position: UDim2?,
+	LayoutOrder: number?,
+	Visible: (() -> boolean)?,
+}
+
+local function isGamepadKey(keyCode: Enum.KeyCode): boolean
+	local name = keyCode.Name
+	return string.sub(name, 1, 6) == "Button" or string.sub(name, 1, 4) == "DPad"
+end
+
+local function keyHint(props: KeyHintProps): Frame
+	return create("Frame")({
+		Name = "KeyHint",
+		AnchorPoint = props.AnchorPoint,
+		Position = props.Position,
+		LayoutOrder = props.LayoutOrder,
+		Visible = props.Visible,
+		Size = UDim2.fromOffset(props.Size, props.Size),
+		BackgroundTransparency = 1,
+
+		create("ImageLabel")({
+			Name = "Glyph",
+			Size = UDim2.fromScale(1, 1),
+			BackgroundTransparency = 1,
+			ScaleType = Enum.ScaleType.Fit,
+			-- The engine picks Xbox or PlayStation art for the connected pad.
+			Image = function()
+				local keyCode = props.KeyCode()
+				return if isGamepadKey(keyCode)
+					then UserInputService:GetImageForKeyCode(keyCode)
+					else ""
+			end,
+			Visible = function()
+				return isGamepadKey(props.KeyCode())
+			end,
+		}),
+
+		create("TextLabel")({
+			Name = "KeyCap",
+			Size = UDim2.fromScale(1, 1),
+			BackgroundColor3 = Theme.Colors.KeyCap,
+			FontFace = Theme.BoldFont,
+			TextSize = props.TextSize,
+			TextColor3 = Theme.Colors.Text,
+			-- Follows the player's keyboard layout.
+			Text = function()
+				local keyCode = props.KeyCode()
+				return if isGamepadKey(keyCode)
+					then ""
+					else UserInputService:GetStringForKeyCode(keyCode)
+			end,
+			Visible = function()
+				return not isGamepadKey(props.KeyCode())
+			end,
+
+			create("UICorner")({ CornerRadius = UDim.new(0, KEY_CAP_RADIUS) }),
+			create("UIStroke")({
+				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+				Color = Theme.Colors.TextMuted,
+				Thickness = KEY_CAP_STROKE,
+			}),
+		}),
+	})
+end
+
+return keyHint
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau
new file mode 100644
index 0000000..ddc99c5
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau
@@ -0,0 +1,156 @@
+--!strict
+--[[
+	Mounts the block inventory UI (the HUD button and the panel), connects it to
+	BlockInventory and BlockPlacer, and binds the keys that open and close it.
+	The design is in docs/inventory-screen.md.
+]]
+
+const ContextActionService = game:GetService("ContextActionService")
+const GuiService = game:GetService("GuiService")
+const Players = game:GetService("Players")
+const RunService = game:GetService("RunService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const create = Vide.create
+const effect = Vide.effect
+const mount = Vide.mount
+const root = Vide.root
+const show = Vide.show
+
+const BlockPlacer = require("../BlockPlacer")
+const inventoryButton = require("./inventoryButton")
+const inventoryPanel = require("./inventoryPanel")
+const InventoryState = require("./InventoryState")
+const Screen = require("./Screen")
+
+const TOGGLE_ACTION = "ToggleBlockInventory"
+const DISPLAY_ORDER = 10
+const BUTTON_TRANSPARENCY = 0.1
+const BACKDROP_TRANSPARENCY = 0.45
+-- Seconds the panel stays after closing, for its exit animation.
+const PANEL_EXIT_TIME = 0.2
+
+const InventoryTypes = require("./InventoryTypes")
+
+type InputKind = InventoryTypes.InputKind
+type PickResult = InventoryTypes.PickResult
+
+Vide.strict = RunService:IsStudio()
+
+local Module = {}
+
+local hasStarted = false
+
+local function inputKind(): InputKind
+	if Screen.isTouch() then
+		return "Touch"
+	elseif Screen.isGamepad() then
+		return "Gamepad"
+	end
+	return "KeyboardAndMouse"
+end
+
+local function close()
+	InventoryState:Close()
+end
+
+local function app()
+	return create("ScreenGui")({
+		Name = "BlockInventory",
+		DisplayOrder = DISPLAY_ORDER,
+		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
+
+		create("UIScale")({ Scale = Screen.uiScale }),
+
+		inventoryButton({
+			Layout = function()
+				return if Screen.isTouchLayout() then "Touch" else "Desktop"
+			end,
+			HintKeyCode = function(): Enum.KeyCode?
+				local input = inputKind()
+				if input == "Gamepad" then
+					return Enum.KeyCode.ButtonY
+				elseif input == "KeyboardAndMouse" then
+					return Enum.KeyCode.B
+				end
+				return nil
+			end,
+			SelectedEntry = InventoryState.selectedEntry,
+			BackgroundTransparency = function()
+				return Screen.transparency(BUTTON_TRANSPARENCY)
+			end,
+			Activated = function()
+				InventoryState:Toggle()
+			end,
+		}),
+
+		show(InventoryState.isOpen, function(_, present)
+			return inventoryPanel({
+				Entries = InventoryState.entries,
+				Level = InventoryState.level,
+				SelectedName = InventoryState.selectedName,
+				IsCompact = Screen.isPhone,
+				Input = inputKind,
+				IsReducedMotion = Screen.isReducedMotion,
+				BackdropTransparency = function()
+					return Screen.transparency(BACKDROP_TRANSPARENCY)
+				end,
+				Present = present,
+				Pick = function(name: string): PickResult
+					local result = InventoryState:Pick(name)
+					if result == "Picked" then
+						close()
+					end
+					-- The equality check above widens the literal union to string.
+					return result :: PickResult
+				end,
+				Close = close,
+			}),
+				PANEL_EXIT_TIME
+		end),
+	})
+end
+
+local function onToggleAction(_: string, inputState: Enum.UserInputState): Enum.ContextActionResult
+	if inputState == Enum.UserInputState.Begin then
+		InventoryState:Toggle()
+	end
+	return Enum.ContextActionResult.Sink
+end
+
+--[[
+	Builds the UI and binds B and the gamepad's Y to open and close the panel.
+	Does not yield; the UI appears once PlayerGui exists.
+]]
+function Module:Start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	ContextActionService:BindAction(
+		TOGGLE_ACTION,
+		onToggleAction,
+		false,
+		Enum.KeyCode.B,
+		Enum.KeyCode.ButtonY
+	)
+
+	-- Session-long side effects of the panel being open.
+	root(function()
+		effect(function()
+			local isOpen = InventoryState.isOpen()
+			-- The panel covers the jump button, and taps there must reach tiles.
+			GuiService.TouchControlsEnabled = not isOpen
+			BlockPlacer.setEnabled(not isOpen)
+		end)
+	end)
+
+	task.spawn(function()
+		local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
+		mount(app, playerGui)
+	end)
+end
+
+return Module
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryState.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryState.luau
new file mode 100644
index 0000000..1559b42
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryState.luau
@@ -0,0 +1,128 @@
+--!strict
+--[[
+	Vide sources for the block inventory UI, kept in step with BlockInventory
+	and BlockPlacer, plus whether the inventory panel is open.
+]]
+
+const RunService = game:GetService("RunService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const batch = Vide.batch
+const source = Vide.source
+
+const BlockInventory = require("../BlockInventory")
+const BlockPlacer = require("../BlockPlacer")
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+-- Keep in step with NUMBER_KEYS in BlockPlacer.
+const HOTKEYS = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" }
+
+const InventoryTypes = require("./InventoryTypes")
+
+type BlockEntry = InventoryTypes.BlockEntry
+type PickResult = InventoryTypes.PickResult
+
+local Module = {}
+
+local function buildEntries(): { BlockEntry }
+	local entries = {}
+	for index, blockType in BlockTypes.List do
+		local name = blockType.Name
+		table.insert(
+			entries,
+			table.freeze({
+				Name = name,
+				DisplayName = blockType.DisplayName,
+				Color = blockType.Color,
+				Count = BlockInventory.getCount(name),
+				UnlockLevel = BlockInventory.getUnlockLevel(name),
+				IsUnlocked = BlockInventory.isUnlocked(name),
+				Hotkey = HOTKEYS[index] or "",
+			})
+		)
+	end
+	return table.freeze(entries)
+end
+
+local entries = source(buildEntries())
+local level = source(BlockInventory.getLevel())
+local selectedName = source(BlockPlacer.getBlockType())
+local isOpen = source(false)
+
+--[[
+	Every block type in hotbar order, with the player's count and lock state.
+]]
+function Module.entries(): { BlockEntry }
+	return entries()
+end
+
+function Module.level(): number
+	return level()
+end
+
+--[[
+	The name of the block type BlockPlacer builds with.
+]]
+function Module.selectedName(): string
+	return selectedName()
+end
+
+function Module.findEntry(name: string): BlockEntry?
+	for _, entry in entries() do
+		if entry.Name == name then
+			return entry
+		end
+	end
+	return nil
+end
+
+function Module.selectedEntry(): BlockEntry?
+	return Module.findEntry(selectedName())
+end
+
+function Module.isOpen(): boolean
+	return isOpen()
+end
+
+function Module:Open()
+	isOpen(true)
+end
+
+function Module:Close()
+	isOpen(false)
+end
+
+function Module:Toggle()
+	isOpen(not isOpen())
+end
+
+--[[
+	Builds with the block type if the player has unlocked it and holds at least
+	one; otherwise changes nothing and says why.
+]]
+function Module:Pick(name: string): PickResult
+	if not BlockInventory.isUnlocked(name) then
+		return "Locked"
+	end
+	if BlockInventory.getCount(name) <= 0 then
+		return "Empty"
+	end
+	BlockPlacer.setBlockType(name)
+	return "Picked"
+end
+
+if RunService:IsRunning() then
+	BlockInventory.Changed:Connect(function()
+		batch(function()
+			entries(buildEntries())
+			level(BlockInventory.getLevel())
+		end)
+	end)
+
+	BlockPlacer.BlockTypeChanged:Connect(function(name: string)
+		selectedName(name)
+	end)
+end
+
+return Module
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryTypes.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryTypes.luau
new file mode 100644
index 0000000..b78348a
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryTypes.luau
@@ -0,0 +1,20 @@
+--!strict
+--[[
+	Types shared by the block inventory UI, its state, and its stories.
+]]
+
+export type BlockEntry = {
+	Name: string,
+	DisplayName: string,
+	Color: Color3,
+	Count: number,
+	UnlockLevel: number,
+	IsUnlocked: boolean,
+	Hotkey: string,
+}
+
+export type PickResult = "Picked" | "Locked" | "Empty"
+
+export type InputKind = "Touch" | "KeyboardAndMouse" | "Gamepad"
+
+return {}
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Screen.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Screen.luau
new file mode 100644
index 0000000..c533b3e
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Screen.luau
@@ -0,0 +1,151 @@
+--!strict
+--[[
+	Facts about the player's screen, kept as Vide sources so layouts follow the
+	live device: the viewport, the topbar inset, the primary input, the display
+	size class, and the player's background transparency and reduced motion
+	settings. Getters read sources, so pass them to properties as bindings.
+]]
+
+const GuiService = game:GetService("GuiService")
+const RunService = game:GetService("RunService")
+const UserInputService = game:GetService("UserInputService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const batch = Vide.batch
+const source = Vide.source
+
+const REFERENCE_SHORT_SIDE = 1080
+const MINIMUM_SCALE = 1
+const MAXIMUM_SCALE = 3
+const LARGE_DISPLAY_BOOST = 1.25
+const PHONE_SHORT_SIDE = 600
+const FALLBACK_VIEWPORT = Vector2.new(1920, 1080)
+
+local Module = {}
+
+local realViewport = source(FALLBACK_VIEWPORT)
+local realInset = source(Vector2.zero)
+local preferredInput = source(Enum.PreferredInput.KeyboardAndMouse :: Enum.PreferredInput)
+local isLargeDisplay = source(false)
+local preferredTransparency = source(1)
+local isReducedMotion = source(false)
+local viewportConnection: RBXScriptConnection? = nil
+
+local function refresh()
+	local camera = workspace.CurrentCamera
+	local topLeftInset = GuiService:GetGuiInset()
+	-- One batch, so a device switch reruns each binding once.
+	batch(function()
+		-- ViewportSize can read (1, 1) before the first frame, which would pass
+		-- for a tiny phone.
+		if camera and camera.ViewportSize.X > 1 and camera.ViewportSize.Y > 1 then
+			realViewport(camera.ViewportSize)
+		end
+		realInset(topLeftInset)
+		preferredInput(UserInputService.PreferredInput)
+		isLargeDisplay(GuiService.ViewportDisplaySize == Enum.DisplaySize.Large)
+		preferredTransparency(GuiService.PreferredTransparency)
+		isReducedMotion(GuiService.ReducedMotionEnabled)
+	end)
+end
+
+local function watchCamera()
+	if viewportConnection then
+		viewportConnection:Disconnect()
+	end
+	local camera = workspace.CurrentCamera
+	if camera then
+		viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
+	end
+	refresh()
+end
+
+--[[
+	How much the whole UI grows on this screen. Bind it to a UIScale under every
+	ScreenGui the game builds.
+]]
+function Module.uiScale(): number
+	local view = realViewport()
+	local boost = if isLargeDisplay() then LARGE_DISPLAY_BOOST else 1
+	return math.clamp(
+		math.min(view.X, view.Y) / REFERENCE_SHORT_SIDE * boost,
+		MINIMUM_SCALE,
+		MAXIMUM_SCALE
+	)
+end
+
+--[[
+	The viewport in UI units.
+]]
+function Module.viewport(): Vector2
+	return realViewport() / Module.uiScale()
+end
+
+--[[
+	The part of the viewport below the Roblox topbar, in UI units.
+]]
+function Module.usableSize(): Vector2
+	local view = Module.viewport()
+	return Vector2.new(view.X, view.Y - realInset().Y / Module.uiScale())
+end
+
+--[[
+	Whether touch is the primary input, which is when Roblox shows its touch
+	controls.
+]]
+function Module.isTouch(): boolean
+	return preferredInput() == Enum.PreferredInput.Touch
+end
+
+function Module.isGamepad(): boolean
+	return preferredInput() == Enum.PreferredInput.Gamepad
+end
+
+function Module.isKeyboardAndMouse(): boolean
+	return preferredInput() == Enum.PreferredInput.KeyboardAndMouse
+end
+
+--[[
+	A short side under about 600 UI units: a phone held sideways, or a desktop
+	window dragged that small.
+]]
+function Module.isPhone(): boolean
+	local view = Module.viewport()
+	return math.min(view.X, view.Y) < PHONE_SHORT_SIDE
+end
+
+--[[
+	Whether HUD pieces should use their touch layout: the touch controls are up,
+	or the screen is too small for the desktop layout.
+]]
+function Module.isTouchLayout(): boolean
+	return Module.isTouch() or Module.isPhone()
+end
+
+--[[
+	A designed background transparency adjusted by the player's Background
+	Transparency setting, which runs from 1 (as designed) to 0 (fully opaque).
+]]
+function Module.transparency(designed: number): number
+	return designed * preferredTransparency()
+end
+
+function Module.isReducedMotion(): boolean
+	return isReducedMotion()
+end
+
+-- Edit-mode loads (stories, specs) would keep each copy alive through these.
+if RunService:IsRunning() then
+	watchCamera()
+	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
+	GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(refresh)
+	GuiService:GetPropertyChangedSignal("ViewportDisplaySize"):Connect(refresh)
+	GuiService:GetPropertyChangedSignal("PreferredTransparency"):Connect(refresh)
+	GuiService:GetPropertyChangedSignal("ReducedMotionEnabled"):Connect(refresh)
+	UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(refresh)
+else
+	refresh()
+end
+
+return Module
