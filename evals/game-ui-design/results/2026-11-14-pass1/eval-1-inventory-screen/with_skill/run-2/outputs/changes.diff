+--!strict
+--[[
+	The block inventory panel: a header with the player's level, a status line,
+	and a close button, over a grid with one tile per block type. Pressing an
+	unlocked tile picks it; pressing a locked one says what level unlocks it.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockTile = require("./BlockTile")
+const InventoryTypes = require("../InventoryTypes")
+const Theme = require("../Theme")
+
+const create = Vide.create
+const derive = Vide.derive
+const indexes = Vide.indexes
+const read = Vide.read
+const source = Vide.source
+const spring = Vide.spring
+
+const COLUMNS = 5
+const PANEL_RADIUS = 16
+const PANEL_STROKE = 2
+const CLOSE_RADIUS = 10
+const CLOSE_BAR_SIZE = Vector2.new(4, 22)
+const HEADER_GAP = 12
+const PILL_HEIGHT = 28
+const DEFAULT_STATUS = "Pick a block to build with"
+-- Must match the number keys BlockPlacer binds to the block types, in order.
+const KEY_LABELS = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" }
+
+type PanelMetrics = {
+	Tile: BlockTile.TileMetrics,
+	Padding: number,
+	HeaderHeight: number,
+	GridGap: number,
+	TileGap: number,
+	CloseSize: number,
+	TitleWidth: number,
+	PillWidth: number,
+	TitleTextSize: number,
+	StatusTextSize: number,
+}
+
+export type InventoryPanelProps = {
+	Entries: () -> { InventoryTypes.BlockEntry },
+	Level: number | () -> number,
+	SelectedName: string | () -> string,
+	IsCompact: boolean | () -> boolean,
+	ShowKeyHints: boolean | () -> boolean,
+	IsReducedMotion: boolean | () -> boolean,
+	-- The player's background transparency setting; 1 keeps the design's
+	-- transparency, 0 makes backgrounds opaque.
+	TransparencyScale: number | () -> number,
+	Picked: (name: string) -> (),
+	CloseRequested: () -> (),
+	-- Called once, with the tile of the block in use, as the panel builds.
+	FocusSelected: ((GuiObject) -> ())?,
+}
+
+const REGULAR: PanelMetrics = table.freeze({
+	Tile = BlockTile.Regular,
+	Padding = 20,
+	HeaderHeight = 52,
+	GridGap = 14,
+	TileGap = 12,
+	CloseSize = 52,
+	TitleWidth = 110,
+	PillWidth = 96,
+	TitleTextSize = Theme.TextSizes.Title,
+	StatusTextSize = Theme.TextSizes.Body,
+})
+
+const COMPACT: PanelMetrics = table.freeze({
+	Tile = BlockTile.Compact,
+	Padding = 12,
+	HeaderHeight = 44,
+	GridGap = 12,
+	TileGap = 8,
+	CloseSize = 44,
+	TitleWidth = 96,
+	PillWidth = 84,
+	TitleTextSize = 26,
+	StatusTextSize = Theme.TextSizes.Caption,
+})
+
+local Module = {}
+
+local function metricsFor(isCompact: boolean): PanelMetrics
+	return if isCompact then COMPACT else REGULAR
+end
+
+--[[
+	The panel's design size in UI units, for the screen to fit it to the
+	room it has.
+]]
+function Module.panelSize(isCompact: boolean, entryCount: number): Vector2
+	const metrics = metricsFor(isCompact)
+	const tile = metrics.Tile.Size
+	const columns = math.min(COLUMNS, math.max(entryCount, 1))
+	const rows = math.max(math.ceil(entryCount / COLUMNS), 1)
+	const gridWidth = columns * tile.X + (columns - 1) * metrics.TileGap
+	const gridHeight = rows * tile.Y + (rows - 1) * metrics.TileGap
+	return Vector2.new(
+		gridWidth + metrics.Padding * 2,
+		metrics.Padding * 2 + metrics.HeaderHeight + metrics.GridGap + gridHeight
+	)
+end
+
+local function closeButton(props: {
+	Size: () -> number,
+	Activated: () -> (),
+}): TextButton
+	local isHovered = source(false)
+	local isFocused = source(false)
+
+	return create("TextButton")({
+		Name = "CloseButton",
+		LayoutOrder = 4,
+		Size = function()
+			const size = props.Size()
+			return UDim2.fromOffset(size, size)
+		end,
+		Text = "",
+		BackgroundColor3 = function()
+			return if isHovered() or isFocused()
+				then Theme.Colors.CloseHover
+				else Theme.Colors.Close
+		end,
+		Selectable = true,
+		Activated = props.Activated,
+		-- MouseMovement only, since touch fires MouseEnter without a matching
+		-- MouseLeave and would leave the hover look stuck.
+		InputBegan = function(input: InputObject)
+			if input.UserInputType == Enum.UserInputType.MouseMovement then
+				isHovered(true)
+			end
+		end,
+		InputEnded = function(input: InputObject)
+			if input.UserInputType == Enum.UserInputType.MouseMovement then
+				isHovered(false)
+			end
+		end,
+		SelectionGained = function()
+			isFocused(true)
+		end,
+		SelectionLost = function()
+			isFocused(false)
+		end,
+
+		create("UICorner")({ CornerRadius = UDim.new(0, CLOSE_RADIUS) }),
+		create("UIStroke")({
+			Color = Theme.Colors.Focus,
+			Thickness = 3,
+			Enabled = isFocused,
+		}),
+		create("Frame")({
+			Name = "BarA",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0.5),
+			Size = UDim2.fromOffset(CLOSE_BAR_SIZE.X, CLOSE_BAR_SIZE.Y),
+			Rotation = 45,
+			BackgroundColor3 = Theme.Colors.Text,
+
+			create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+		}),
+		create("Frame")({
+			Name = "BarB",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0.5),
+			Size = UDim2.fromOffset(CLOSE_BAR_SIZE.X, CLOSE_BAR_SIZE.Y),
+			Rotation = -45,
+			BackgroundColor3 = Theme.Colors.Text,
+
+			create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+		}),
+	})
+end
+
+local function inventoryPanel(props: InventoryPanelProps): Frame
+	local status = source(nil :: string?)
+
+	const metrics = derive(function(): PanelMetrics
+		return metricsFor(read(props.IsCompact) == true)
+	end)
+
+	const entryCount = derive(function(): number
+		return #props.Entries()
+	end)
+
+	const statusColor = spring(function(): Color3
+		return if status() then Theme.Colors.Text else Theme.Colors.MutedText
+	end, Theme.Motion.HoverPeriod)
+
+	local function onTileActivated(entry: InventoryTypes.BlockEntry)
+		if entry.IsUnlocked then
+			status(nil)
+			props.Picked(entry.Name)
+		else
+			status(`{entry.DisplayName} unlocks at level {entry.UnlockLevel}`)
+		end
+	end
+
+	return create("Frame")({
+		Name = "InventoryPanel",
+		Size = function()
+			const size = Module.panelSize(read(props.IsCompact) == true, entryCount())
+			return UDim2.fromOffset(size.X, size.Y)
+		end,
+		BackgroundColor3 = Theme.Colors.Panel,
+		BackgroundTransparency = function()
+			return 0.04 * read(props.TransparencyScale)
+		end,
+		-- Takes presses on the panel's own background, so they never reach
+		-- the backdrop behind it and close the panel.
+		Active = true,
+		SelectionGroup = true,
+		SelectionBehaviorUp = Enum.SelectionBehavior.Stop,
+		SelectionBehaviorDown = Enum.SelectionBehavior.Stop,
+		SelectionBehaviorLeft = Enum.SelectionBehavior.Stop,
+		SelectionBehaviorRight = Enum.SelectionBehavior.Stop,
+
+		create("UICorner")({ CornerRadius = UDim.new(0, PANEL_RADIUS) }),
+		create("UIStroke")({
+			Color = Theme.Colors.PanelStroke,
+			Thickness = PANEL_STROKE,
+		}),
+		create("UIPadding")({
+			PaddingTop = function()
+				return UDim.new(0, metrics().Padding)
+			end,
+			PaddingBottom = function()
+				return UDim.new(0, metrics().Padding)
+			end,
+			PaddingLeft = function()
+				return UDim.new(0, metrics().Padding)
+			end,
+			PaddingRight = function()
+				return UDim.new(0, metrics().Padding)
+			end,
+		}),
+
+		create("Frame")({
+			Name = "Header",
+			Size = function()
+				return UDim2.new(1, 0, 0, metrics().HeaderHeight)
+			end,
+			BackgroundTransparency = 1,
+
+			create("UIListLayout")({
+				FillDirection = Enum.FillDirection.Horizontal,
+				VerticalAlignment = Enum.VerticalAlignment.Center,
+				Padding = UDim.new(0, HEADER_GAP),
+			}),
+
+			create("TextLabel")({
+				Name = "Title",
+				LayoutOrder = 1,
+				Size = function()
+					return UDim2.new(0, metrics().TitleWidth, 1, 0)
+				end,
+				BackgroundTransparency = 1,
+				FontFace = Theme.BoldFont,
+				Text = "Blocks",
+				TextSize = function()
+					return metrics().TitleTextSize
+				end,
+				TextColor3 = Theme.Colors.Text,
+				TextXAlignment = Enum.TextXAlignment.Left,
+				TextTruncate = Enum.TextTruncate.AtEnd,
+			}),
+
+			create("TextLabel")({
+				Name = "LevelPill",
+				LayoutOrder = 2,
+				Size = function()
+					return UDim2.fromOffset(metrics().PillWidth, PILL_HEIGHT)
+				end,
+				BackgroundColor3 = Theme.Colors.Tile,
+				FontFace = Theme.BoldFont,
+				Text = function()
+					return `Level {read(props.Level)}`
+				end,
+				TextSize = Theme.TextSizes.Caption,
+				TextColor3 = Theme.Colors.Text,
+				TextTruncate = Enum.TextTruncate.AtEnd,
+
+				create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+			}),
+
+			create("TextLabel")({
+				Name = "Status",
+				LayoutOrder = 3,
+				Size = UDim2.fromScale(0, 1),
+				BackgroundTransparency = 1,
+				FontFace = Theme.Font,
+				Text = function()
+					return status() or DEFAULT_STATUS
+				end,
+				TextSize = function()
+					return metrics().StatusTextSize
+				end,
+				TextColor3 = statusColor,
+				TextXAlignment = Enum.TextXAlignment.Left,
+				TextWrapped = true,
+				TextTruncate = Enum.TextTruncate.AtEnd,
+
+				create("UIFlexItem")({ FlexMode = Enum.UIFlexMode.Fill }),
+			}),
+
+			closeButton({
+				Size = function()
+					return metrics().CloseSize
+				end,
+				Activated = props.CloseRequested,
+			}),
+		}),
+
+		create("Frame")({
+			Name = "Grid",
+			Position = function()
+				const current = metrics()
+				return UDim2.fromOffset(0, current.HeaderHeight + current.GridGap)
+			end,
+			Size = function()
+				const current = metrics()
+				return UDim2.new(1, 0, 1, -(current.HeaderHeight + current.GridGap))
+			end,
+			BackgroundTransparency = 1,
+
+			create("UIGridLayout")({
+				CellSize = function()
+					const size = metrics().Tile.Size
+					return UDim2.fromOffset(size.X, size.Y)
+				end,
+				CellPadding = function()
+					const gap = metrics().TileGap
+					return UDim2.fromOffset(gap, gap)
+				end,
+				FillDirectionMaxCells = COLUMNS,
+				HorizontalAlignment = Enum.HorizontalAlignment.Center,
+			}),
+
+			indexes(props.Entries, function(entry, index: number)
+				const name = entry().Name
+				const isSelected = function(): boolean
+					return read(props.SelectedName) == entry().Name
+				end
+				-- Builders run in a stable scope, so this reads the block in use
+				-- at the moment the panel opens.
+				const focus = if props.FocusSelected and read(props.SelectedName) == name
+					then props.FocusSelected
+					else nil
+
+				return BlockTile.new({
+					Entry = entry,
+					IsSelected = isSelected,
+					KeyLabel = KEY_LABELS[index],
+					ShowKeyHint = props.ShowKeyHints,
+					IsCompact = props.IsCompact,
+					IsReducedMotion = props.IsReducedMotion,
+					LayoutOrder = index,
+					Activated = function()
+						onTileActivated(entry())
+					end,
+					Focus = focus,
+				})
+			end),
+		}),
+	})
+end
+
+Module.Regular = REGULAR
+Module.Compact = COMPACT
+Module.new = inventoryPanel
+
+return Module
