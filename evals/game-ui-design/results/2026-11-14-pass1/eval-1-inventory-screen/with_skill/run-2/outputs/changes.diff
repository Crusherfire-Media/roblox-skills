diff --git a/src/ServerScriptService/Stories/Inventory/BlockTile.story.luau b/src/ServerScriptService/Stories/Inventory/BlockTile.story.luau
new file mode 100644
index 0000000..ad44b62
--- /dev/null
+++ b/src/ServerScriptService/Stories/Inventory/BlockTile.story.luau
@@ -0,0 +1,127 @@
+--!strict
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+const BlockTile = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile")
+const LockIcon = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/LockIcon")
+
+const create = Vide.create
+
+local blockNames = {}
+for _, blockType in BlockTypes.List do
+	table.insert(blockNames, blockType.Name)
+end
+
+const CONTROLS = {
+	Block = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Name = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+			Count = UILabs.Ordered(UILabs.Number(48, 0, 1e7, 1), 2),
+			LongName = UILabs.Ordered(false, 3),
+		}),
+		1
+	),
+	State = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsUnlocked = UILabs.Ordered(true, 1),
+			UnlockLevel = UILabs.Ordered(UILabs.Slider(6, 1, 20, 1), 2),
+			IsSelected = UILabs.Ordered(false, 3),
+		}),
+		2
+	),
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsCompact = UILabs.Ordered(false, 1),
+			ShowKeyHint = UILabs.Ordered(true, 2),
+			IsReducedMotion = UILabs.Ordered(false, 3),
+		}),
+		3
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Block: {
+			Name: () -> string,
+			Count: () -> number,
+			LongName: () -> boolean,
+		},
+		State: {
+			IsUnlocked: () -> boolean,
+			UnlockLevel: () -> number,
+			IsSelected: () -> boolean,
+		},
+		Layout: {
+			IsCompact: () -> boolean,
+			ShowKeyHint: () -> boolean,
+			IsReducedMotion: () -> boolean,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const block = props.controls.Block
+	const state = props.controls.State
+	const layout = props.controls.Layout
+
+	local function tileSize(): UDim2
+		const size = if layout.IsCompact() then BlockTile.Compact.Size else BlockTile.Regular.Size
+		return UDim2.fromOffset(size.X, size.Y)
+	end
+
+	return create("Frame")({
+		Name = "Backdrop",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundColor3 = Color3.fromRGB(32, 36, 48),
+
+		create("UIListLayout")({
+			FillDirection = Enum.FillDirection.Horizontal,
+			HorizontalAlignment = Enum.HorizontalAlignment.Center,
+			VerticalAlignment = Enum.VerticalAlignment.Center,
+			Padding = UDim.new(0, 32),
+		}),
+
+		create("Frame")({
+			Name = "TileCell",
+			Size = tileSize,
+			BackgroundTransparency = 1,
+
+			BlockTile.new({
+				Entry = function()
+					const blockType = BlockTypes.ByName[block.Name()]
+					return {
+						Name = blockType.Name,
+						DisplayName = if block.LongName()
+							then `{blockType.DisplayName} Supreme Deluxe`
+							else blockType.DisplayName,
+						Color = blockType.Color,
+						Transparency = blockType.Transparency,
+						Count = block.Count(),
+						UnlockLevel = state.UnlockLevel(),
+						IsUnlocked = state.IsUnlocked(),
+					}
+				end,
+				IsSelected = state.IsSelected,
+				KeyLabel = "1",
+				ShowKeyHint = layout.ShowKeyHint,
+				IsCompact = layout.IsCompact,
+				IsReducedMotion = layout.IsReducedMotion,
+				Activated = function()
+					print("Tile pressed")
+				end,
+			}),
+		}),
+
+		LockIcon.new({}),
+	})
+end
+
+return {
+	summary = "One inventory tile in every state, beside the lock icon it uses.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
diff --git a/src/ServerScriptService/Stories/Inventory/InventoryButton.story.luau b/src/ServerScriptService/Stories/Inventory/InventoryButton.story.luau
new file mode 100644
index 0000000..5d2f841
--- /dev/null
+++ b/src/ServerScriptService/Stories/Inventory/InventoryButton.story.luau
@@ -0,0 +1,111 @@
+--!strict
+const UserInputService = game:GetService("UserInputService")
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+const InventoryButton =
+	require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryButton")
+
+const create = Vide.create
+
+local blockNames = {}
+for _, blockType in BlockTypes.List do
+	table.insert(blockNames, blockType.Name)
+end
+
+const CONTROLS = {
+	Block = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Name = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+			LongName = UILabs.Ordered(false, 2),
+		}),
+		1
+	),
+	Input = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Hint = UILabs.Ordered(UILabs.Choose({ "Key", "Gamepad", "None" }), 1),
+		}),
+		2
+	),
+	Look = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsReducedMotion = UILabs.Ordered(false, 1),
+			-- 1 is the design's transparency; 0 is fully opaque.
+			TransparencyScale = UILabs.Ordered(UILabs.Slider(1, 0, 1, 0.1), 2),
+		}),
+		3
+	),
+	Preview = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Background = UILabs.Ordered(Color3.fromRGB(110, 140, 90), 1),
+		}),
+		4
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Block: {
+			Name: () -> string,
+			LongName: () -> boolean,
+		},
+		Input: {
+			Hint: () -> InventoryButton.OpenHint,
+		},
+		Look: {
+			IsReducedMotion: () -> boolean,
+			TransparencyScale: () -> number,
+		},
+		Preview: {
+			Background: () -> Color3,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const block = props.controls.Block
+	const look = props.controls.Look
+
+	return create("Frame")({
+		Name = "Backdrop",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundColor3 = props.controls.Preview.Background,
+
+		create("UIListLayout")({
+			HorizontalAlignment = Enum.HorizontalAlignment.Center,
+			VerticalAlignment = Enum.VerticalAlignment.Center,
+		}),
+
+		InventoryButton.new({
+			Selected = function()
+				const blockType = BlockTypes.ByName[block.Name()]
+				return {
+					DisplayName = if block.LongName()
+						then `{blockType.DisplayName} Supreme Deluxe`
+						else blockType.DisplayName,
+					Color = blockType.Color,
+					Transparency = blockType.Transparency,
+				}
+			end,
+			Hint = props.controls.Input.Hint,
+			KeyText = "B",
+			GamepadImage = UserInputService:GetImageForKeyCode(Enum.KeyCode.ButtonY),
+			IsReducedMotion = look.IsReducedMotion,
+			TransparencyScale = look.TransparencyScale,
+			Activated = function()
+				print("Open inventory")
+			end,
+		}),
+	})
+end
+
+return {
+	summary = "The HUD button that opens the block inventory, with each input's open hint.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
diff --git a/src/ServerScriptService/Stories/Inventory/InventoryPanel.story.luau b/src/ServerScriptService/Stories/Inventory/InventoryPanel.story.luau
new file mode 100644
index 0000000..c3fd37e
--- /dev/null
+++ b/src/ServerScriptService/Stories/Inventory/InventoryPanel.story.luau
@@ -0,0 +1,148 @@
+--!strict
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+const BlockInventory = require("@game/StarterPlayer/StarterPlayerScripts/BlockInventory")
+const InventoryPanel =
+	require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryPanel")
+const InventoryTypes = require("@game/StarterPlayer/StarterPlayerScripts/UI/InventoryTypes")
+
+const create = Vide.create
+const source = Vide.source
+
+const LONG_NAME_SUFFIX = " Supreme Deluxe"
+
+const CONTROLS = {
+	Inventory = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Level = UILabs.Ordered(UILabs.Slider(3, 1, 12, 1), 1),
+			-- Sample uses BlockInventory's sample counts.
+			Counts = UILabs.Ordered(UILabs.Choose({ "Sample", "Empty", "Huge" }), 2),
+			-- 1 is the first block type in BlockTypes.
+			SelectedIndex = UILabs.Ordered(UILabs.Slider(1, 1, #BlockTypes.List, 1), 3),
+			LongNames = UILabs.Ordered(false, 4),
+		}),
+		1
+	),
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsCompact = UILabs.Ordered(false, 1),
+			ShowKeyHints = UILabs.Ordered(true, 2),
+		}),
+		2
+	),
+	Look = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsReducedMotion = UILabs.Ordered(false, 1),
+			-- 1 is the design's transparency; 0 is the player's fully opaque
+			-- setting.
+			TransparencyScale = UILabs.Ordered(UILabs.Slider(1, 0, 1, 0.1), 2),
+		}),
+		3
+	),
+	Preview = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Background = UILabs.Ordered(Color3.fromRGB(110, 140, 90), 1),
+		}),
+		4
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Inventory: {
+			Level: () -> number,
+			Counts: () -> string,
+			SelectedIndex: () -> number,
+			LongNames: () -> boolean,
+		},
+		Layout: {
+			IsCompact: () -> boolean,
+			ShowKeyHints: () -> boolean,
+		},
+		Look: {
+			IsReducedMotion: () -> boolean,
+			TransparencyScale: () -> number,
+		},
+		Preview: {
+			Background: () -> Color3,
+		},
+	},
+	target: Frame,
+}
+
+local function countFor(mode: string, name: string, index: number): number
+	if mode == "Empty" then
+		return 0
+	elseif mode == "Huge" then
+		return index * 123457
+	end
+	return BlockInventory.getCount(name)
+end
+
+local function story(props: StoryProps)
+	const inventory = props.controls.Inventory
+	const layout = props.controls.Layout
+	const look = props.controls.Look
+	local pickedName = source(nil :: string?)
+
+	local function entries(): { InventoryTypes.BlockEntry }
+		const level = inventory.Level()
+		const mode = inventory.Counts()
+		const suffix = if inventory.LongNames() then LONG_NAME_SUFFIX else ""
+		local list = {}
+		for index, blockType in BlockTypes.List do
+			const unlockLevel = BlockInventory.getUnlockLevel(blockType.Name)
+			table.insert(list, {
+				Name = blockType.Name,
+				DisplayName = blockType.DisplayName .. suffix,
+				Color = blockType.Color,
+				Transparency = blockType.Transparency,
+				Count = countFor(mode, blockType.Name, index),
+				UnlockLevel = unlockLevel,
+				IsUnlocked = level >= unlockLevel,
+			})
+		end
+		return list
+	end
+
+	return create("Frame")({
+		Name = "Backdrop",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundColor3 = props.controls.Preview.Background,
+
+		create("UIListLayout")({
+			HorizontalAlignment = Enum.HorizontalAlignment.Center,
+			VerticalAlignment = Enum.VerticalAlignment.Center,
+		}),
+
+		InventoryPanel.new({
+			Entries = entries,
+			Level = inventory.Level,
+			SelectedName = function()
+				return pickedName() or BlockTypes.List[inventory.SelectedIndex()].Name
+			end,
+			IsCompact = layout.IsCompact,
+			ShowKeyHints = layout.ShowKeyHints,
+			IsReducedMotion = look.IsReducedMotion,
+			TransparencyScale = look.TransparencyScale,
+			Picked = function(name: string)
+				print(`Picked {name}`)
+				pickedName(name)
+			end,
+			CloseRequested = function()
+				print("Close requested")
+			end,
+		}),
+	})
+end
+
+return {
+	summary = "The block inventory panel in its regular and compact layouts, with locked, "
+		.. "empty, selected, and long-name tiles.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
