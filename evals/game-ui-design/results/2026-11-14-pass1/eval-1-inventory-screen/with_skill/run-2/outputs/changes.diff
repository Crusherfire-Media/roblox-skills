diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile.luau
new file mode 100644
index 0000000..3d342bd
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile.luau
@@ -0,0 +1,330 @@
+--!strict
+--[[
+	One block type in the inventory grid: its color, name, and count, or a lock
+	and the level that unlocks it. The whole tile is one button.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const InventoryTypes = require("../InventoryTypes")
+const Theme = require("../Theme")
+const formatCount = require("../formatCount")
+const LockIcon = require("./LockIcon")
+
+const action = Vide.action
+const create = Vide.create
+const derive = Vide.derive
+const read = Vide.read
+const source = Vide.source
+const spring = Vide.spring
+
+const TILE_RADIUS = 12
+const SWATCH_RADIUS = 8
+const SELECTED_STROKE = 3
+const FOCUS_OUTSET = 5
+const FOCUS_STROKE = 3
+const KEY_HINT_SIZE = 18
+const KEY_HINT_INSET = Vector2.new(6, 4)
+const USING_PILL_SIZE = Vector2.new(60, 22)
+const PRESSED_SCALE = 0.94
+-- Offset units per second pushed into the shake spring when a locked tile is
+-- pressed.
+const SHAKE_IMPULSE = 320
+const SHAKE_PERIOD = 0.2
+const SHAKE_DAMPING = 0.3
+const CENTER = Vector2.new(0.5, 0.5)
+const CENTER_POSITION = UDim2.fromScale(0.5, 0.5)
+
+export type TileMetrics = {
+	Size: Vector2,
+	SwatchSize: number,
+	NameTextSize: number,
+	CountTextSize: number,
+	Spacing: number,
+}
+
+export type BlockTileProps = {
+	Entry: () -> InventoryTypes.BlockEntry,
+	IsSelected: () -> boolean,
+	-- The number key that picks this block, shown while ShowKeyHint is true.
+	KeyLabel: string?,
+	ShowKeyHint: boolean | () -> boolean,
+	IsCompact: boolean | () -> boolean,
+	IsReducedMotion: boolean | () -> boolean,
+	LayoutOrder: number?,
+	Activated: () -> (),
+	-- Called once with the tile's button, for the screen to move focus to it.
+	Focus: ((GuiObject) -> ())?,
+}
+
+const REGULAR: TileMetrics = table.freeze({
+	Size = Vector2.new(104, 120),
+	SwatchSize = 56,
+	NameTextSize = 20,
+	CountTextSize = 18,
+	Spacing = 4,
+})
+
+const COMPACT: TileMetrics = table.freeze({
+	Size = Vector2.new(96, 102),
+	SwatchSize = 44,
+	NameTextSize = 18,
+	CountTextSize = 16,
+	Spacing = 2,
+})
+
+local function isPointerPress(input: InputObject): boolean
+	return input.UserInputType == Enum.UserInputType.MouseButton1
+		or input.UserInputType == Enum.UserInputType.Touch
+		or input.KeyCode == Enum.KeyCode.ButtonA
+end
+
+local function blockTile(props: BlockTileProps): TextButton
+	local isHovered = source(false)
+	local isFocused = source(false)
+	local isPressed = source(false)
+
+	const metrics = derive(function(): TileMetrics
+		return if read(props.IsCompact) then COMPACT else REGULAR
+	end)
+
+	local function isLocked(): boolean
+		return not props.Entry().IsUnlocked
+	end
+
+	const faceColor = spring(function(): Color3
+		if isLocked() then
+			return Theme.Colors.TileLocked
+		elseif props.IsSelected() then
+			return Theme.Colors.TileSelected
+		elseif isHovered() or isFocused() then
+			return Theme.Colors.TileHover
+		end
+		return Theme.Colors.Tile
+	end, Theme.Motion.HoverPeriod)
+
+	const pressScale = spring(function(): number
+		return if isPressed() and not read(props.IsReducedMotion) then PRESSED_SCALE else 1
+	end, Theme.Motion.PressPeriod, Theme.Motion.PressDamping)
+
+	const shakePosition, shake = spring(function(): UDim2
+		return CENTER_POSITION
+	end, SHAKE_PERIOD, SHAKE_DAMPING)
+
+	local function onActivated()
+		if isLocked() and not read(props.IsReducedMotion) then
+			shake({ impulse = UDim2.fromOffset(SHAKE_IMPULSE, 0) })
+		end
+		props.Activated()
+	end
+
+	local function onInputBegan(input: InputObject)
+		if input.UserInputType == Enum.UserInputType.MouseMovement then
+			isHovered(true)
+		elseif isPointerPress(input) then
+			isPressed(true)
+		end
+	end
+
+	local function onInputEnded(input: InputObject)
+		if input.UserInputType == Enum.UserInputType.MouseMovement then
+			isHovered(false)
+			isPressed(false)
+		elseif isPointerPress(input) then
+			isPressed(false)
+		end
+	end
+
+	local function textColor(): Color3
+		return if isLocked() then Theme.Colors.LockedText else Theme.Colors.Text
+	end
+
+	return create("TextButton")({
+		Name = `Tile{props.Entry().Name}`,
+		LayoutOrder = props.LayoutOrder,
+		Text = "",
+		BackgroundTransparency = 1,
+		Selectable = true,
+		-- The tile draws its own focus ring, which stays clear of the
+		-- selected outline.
+		SelectionImageObject = create("Frame")({ BackgroundTransparency = 1 }),
+
+		Activated = onActivated,
+		InputBegan = onInputBegan,
+		InputEnded = onInputEnded,
+		SelectionGained = function()
+			isFocused(true)
+		end,
+		SelectionLost = function()
+			isFocused(false)
+		end,
+
+		create("Frame")({
+			Name = "FocusRing",
+			AnchorPoint = CENTER,
+			Position = shakePosition,
+			Size = UDim2.new(1, FOCUS_OUTSET * 2, 1, FOCUS_OUTSET * 2),
+			BackgroundTransparency = 1,
+			Visible = isFocused,
+
+			create("UICorner")({ CornerRadius = UDim.new(0, TILE_RADIUS + FOCUS_OUTSET) }),
+			create("UIStroke")({
+				Color = Theme.Colors.Focus,
+				Thickness = FOCUS_STROKE,
+			}),
+		}),
+
+		create("Frame")({
+			Name = "Face",
+			AnchorPoint = CENTER,
+			Position = shakePosition,
+			Size = UDim2.fromScale(1, 1),
+			BackgroundColor3 = faceColor,
+
+			create("UIScale")({ Scale = pressScale }),
+			create("UICorner")({ CornerRadius = UDim.new(0, TILE_RADIUS) }),
+			create("UIStroke")({
+				Color = Theme.Colors.Accent,
+				Thickness = SELECTED_STROKE,
+				Enabled = props.IsSelected,
+			}),
+
+			create("TextLabel")({
+				Name = "KeyHint",
+				Position = UDim2.fromOffset(KEY_HINT_INSET.X, KEY_HINT_INSET.Y),
+				Size = UDim2.fromOffset(KEY_HINT_SIZE, KEY_HINT_SIZE),
+				BackgroundTransparency = 1,
+				FontFace = Theme.BoldFont,
+				Text = props.KeyLabel or "",
+				TextSize = Theme.TextSizes.Badge,
+				TextColor3 = Theme.Colors.MutedText,
+				Visible = function()
+					return props.KeyLabel ~= nil and read(props.ShowKeyHint) == true
+				end,
+			}),
+
+			create("TextLabel")({
+				Name = "UsingPill",
+				AnchorPoint = CENTER,
+				Position = UDim2.fromScale(0.5, 0),
+				Size = UDim2.fromOffset(USING_PILL_SIZE.X, USING_PILL_SIZE.Y),
+				BackgroundColor3 = Theme.Colors.Accent,
+				FontFace = Theme.BoldFont,
+				Text = "Using",
+				TextSize = Theme.TextSizes.Badge,
+				TextColor3 = Theme.Colors.AccentText,
+				Visible = props.IsSelected,
+				ZIndex = 2,
+
+				create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+			}),
+
+			create("Frame")({
+				Name = "Content",
+				Size = UDim2.fromScale(1, 1),
+				BackgroundTransparency = 1,
+
+				create("UIListLayout")({
+					FillDirection = Enum.FillDirection.Vertical,
+					HorizontalAlignment = Enum.HorizontalAlignment.Center,
+					VerticalAlignment = Enum.VerticalAlignment.Center,
+					Padding = function()
+						return UDim.new(0, metrics().Spacing)
+					end,
+				}),
+
+				create("Frame")({
+					Name = "Swatch",
+					LayoutOrder = 1,
+					Size = function()
+						const size = metrics().SwatchSize
+						return UDim2.fromOffset(size, size)
+					end,
+					BackgroundColor3 = function()
+						return props.Entry().Color
+					end,
+					BackgroundTransparency = function()
+						const entry = props.Entry()
+						return if entry.IsUnlocked then entry.Transparency * 0.5 else 0.65
+					end,
+
+					create("UICorner")({ CornerRadius = UDim.new(0, SWATCH_RADIUS) }),
+					create("UIStroke")({
+						Color = Theme.Colors.SwatchStroke,
+						Thickness = 2,
+					}),
+					create("Frame")({
+						Name = "LockHolder",
+						Size = UDim2.fromScale(1, 1),
+						BackgroundTransparency = 1,
+						Visible = isLocked,
+
+						LockIcon.new({
+							AnchorPoint = CENTER,
+							Position = CENTER_POSITION,
+						}),
+					}),
+				}),
+
+				create("TextLabel")({
+					Name = "BlockName",
+					LayoutOrder = 2,
+					Size = function()
+						return UDim2.new(1, -8, 0, metrics().NameTextSize + 4)
+					end,
+					BackgroundTransparency = 1,
+					FontFace = Theme.BoldFont,
+					Text = function()
+						return props.Entry().DisplayName
+					end,
+					TextSize = function()
+						return metrics().NameTextSize
+					end,
+					TextColor3 = textColor,
+					TextTruncate = Enum.TextTruncate.AtEnd,
+				}),
+
+				create("TextLabel")({
+					Name = "Count",
+					LayoutOrder = 3,
+					Size = function()
+						return UDim2.new(1, -8, 0, metrics().CountTextSize + 4)
+					end,
+					BackgroundTransparency = 1,
+					FontFace = Theme.Font,
+					Text = function()
+						const entry = props.Entry()
+						return if entry.IsUnlocked
+							then `x{formatCount(entry.Count)}`
+							else `Level {entry.UnlockLevel}`
+					end,
+					TextSize = function()
+						return metrics().CountTextSize
+					end,
+					TextColor3 = function()
+						const entry = props.Entry()
+						if not entry.IsUnlocked then
+							return Theme.Colors.LockedText
+						end
+						return if entry.Count > 0 then Theme.Colors.Text else Theme.Colors.MutedText
+					end,
+					TextTruncate = Enum.TextTruncate.AtEnd,
+				}),
+			}),
+		}),
+
+		props.Focus and action(function(instance: Instance)
+			if props.Focus and instance:IsA("GuiObject") then
+				props.Focus(instance)
+			end
+		end),
+	})
+end
+
+local Module = {}
+
+Module.Regular = REGULAR
+Module.Compact = COMPACT
+Module.new = blockTile
+
+return Module
