index 0000000..29789a5
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/formatCount.luau
@@ -0,0 +1,20 @@
+--!strict
+--[[
+	Formats a block count for a tile: exact below 1,000, then about three
+	significant digits with K or M, so the label width stays stable.
+]]
+local function formatCount(count: number): string
+	if count < 1000 then
+		return tostring(math.max(math.floor(count), 0))
+	end
+	if count < 1e6 then
+		const thousands = count / 1e3
+		return if thousands < 100
+			then `{math.floor(thousands * 10) / 10}K`
+			else `{math.floor(thousands)}K`
+	end
+	const millions = count / 1e6
+	return if millions < 100 then `{math.floor(millions * 10) / 10}M` else `{math.floor(millions)}M`
+end
+
+return formatCount
