@@ -0,0 +1,78 @@
+--!strict
+--[[
+	A padlock drawn from frames, so locked items get a shape cue beside their
+	color and the game needs no image asset for it.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const Theme = require("../Theme")
+
+const create = Vide.create
+
+const WIDTH = 28
+const BODY_HEIGHT = 18
+const SHACKLE_SIZE = 18
+const SHACKLE_THICKNESS = 4
+const KEYHOLE_SIZE = Vector2.new(4, 8)
+
+export type LockIconProps = {
+	AnchorPoint: Vector2?,
+	Position: UDim2?,
+	Color: Color3?,
+}
+
+local function lockIcon(props: LockIconProps): Frame
+	const color = props.Color or Theme.Colors.Lock
+
+	return create("Frame")({
+		Name = "LockIcon",
+		AnchorPoint = props.AnchorPoint,
+		Position = props.Position,
+		Size = UDim2.fromOffset(WIDTH, BODY_HEIGHT + SHACKLE_SIZE / 2 + SHACKLE_THICKNESS),
+		BackgroundTransparency = 1,
+		ZIndex = 2,
+
+		create("Frame")({
+			Name = "Shackle",
+			AnchorPoint = Vector2.new(0.5, 0),
+			Position = UDim2.new(0.5, 0, 0, SHACKLE_THICKNESS / 2),
+			Size = UDim2.fromOffset(SHACKLE_SIZE - SHACKLE_THICKNESS, SHACKLE_SIZE),
+			BackgroundTransparency = 1,
+
+			create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+			create("UIStroke")({
+				Color = color,
+				Thickness = SHACKLE_THICKNESS,
+			}),
+		}),
+
+		create("Frame")({
+			Name = "Body",
+			AnchorPoint = Vector2.new(0.5, 1),
+			Position = UDim2.fromScale(0.5, 1),
+			Size = UDim2.fromOffset(WIDTH, BODY_HEIGHT),
+			BackgroundColor3 = color,
+			-- Drawn over the shackle so only its top arc shows.
+			ZIndex = 2,
+
+			create("UICorner")({ CornerRadius = UDim.new(0, 4) }),
+			create("Frame")({
+				Name = "Keyhole",
+				AnchorPoint = Vector2.new(0.5, 0.5),
+				Position = UDim2.fromScale(0.5, 0.5),
+				Size = UDim2.fromOffset(KEYHOLE_SIZE.X, KEYHOLE_SIZE.Y),
+				BackgroundColor3 = Theme.Colors.SwatchStroke,
+				ZIndex = 3,
+
+				create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+			}),
+		}),
+	})
+end
+
+local Module = {}
+
+Module.new = lockIcon
+
+return Module
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau
new file mode 100644
index 0000000..a10a201
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau
@@ -0,0 +1,362 @@
+--!strict
+--[[
+	Connects the block inventory UI to the game: BlockInventory's counts and
+	locks, BlockPlacer's block in use, and the keys and controller buttons that
+	open and close the panel. docs/inventory-screen.md has the design.
+]]
+
+const ContextActionService = game:GetService("ContextActionService")
+const GuiService = game:GetService("GuiService")
+const Players = game:GetService("Players")
+const RunService = game:GetService("RunService")
+const UserInputService = game:GetService("UserInputService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+const BlockInventory = require("../BlockInventory")
+const BlockPlacer = require("../BlockPlacer")
+const InventoryButton = require("./Components/InventoryButton")
+const InventoryPanel = require("./Components/InventoryPanel")
+const InventoryTypes = require("./InventoryTypes")
+const Screen = require("./Screen")
+const Theme = require("./Theme")
+
+const batch = Vide.batch
+const cleanup = Vide.cleanup
+const create = Vide.create
+const derive = Vide.derive
+const effect = Vide.effect
+const mount = Vide.mount
+const show = Vide.show
+const source = Vide.source
+const spring = Vide.spring
+
+Vide.strict = RunService:IsStudio()
+
+const TOGGLE_ACTION = "ToggleBlockInventory"
+const CLOSE_ACTION = "CloseBlockInventory"
+const TOGGLE_KEY = Enum.KeyCode.B
+const TOGGLE_BUTTON = Enum.KeyCode.ButtonY
+const CLOSE_BUTTON = Enum.KeyCode.ButtonB
+const DISPLAY_ORDER = 5
+const EDGE_PADDING = 16
+const MINIMUM_FIT_SCALE = 0.5
+const HUD_MARGIN = 16
+const PHONE_HUD_MARGIN = 12
+-- Lower on tablets, where mid-height on the edge is a long reach from the
+-- hands; still well above the jump button.
+const TABLET_HUD_HEIGHT = 0.6
+const BACKDROP_TRANSPARENCY = 0.45
+const SLIDE_DISTANCE = 24
+
+local Module = {}
+
+local isOpen = source(false)
+local entries = source({} :: { InventoryTypes.BlockEntry })
+local level = source(1)
+local selectedName = source(BlockTypes.List[1].Name)
+local shouldFocusOnOpen = false
+local selectionBeforeOpen: GuiObject? = nil
+local hasStarted = false
+
+local function readEntries(): { InventoryTypes.BlockEntry }
+	local list = {}
+	for _, blockType in BlockTypes.List do
+		const name = blockType.Name
+		table.insert(
+			list,
+			table.freeze({
+				Name = name,
+				DisplayName = blockType.DisplayName,
+				Color = blockType.Color,
+				Transparency = blockType.Transparency,
+				Count = BlockInventory.getCount(name),
+				UnlockLevel = BlockInventory.getUnlockLevel(name),
+				IsUnlocked = BlockInventory.isUnlocked(name),
+			})
+		)
+	end
+	return list
+end
+
+local function refreshInventory()
+	batch(function()
+		entries(readEntries())
+		level(BlockInventory.getLevel())
+	end)
+end
+
+--[[
+	shouldFocus moves gamepad and keyboard focus onto the block in use, for
+	players who opened the panel without pointing at it.
+]]
+local function open(shouldFocus: boolean)
+	if isOpen() then
+		return
+	end
+	shouldFocusOnOpen = shouldFocus
+	selectionBeforeOpen = GuiService.SelectedObject
+	isOpen(true)
+end
+
+local function close()
+	if not isOpen() then
+		return
+	end
+	isOpen(false)
+
+	if shouldFocusOnOpen then
+		const previous = selectionBeforeOpen
+		GuiService.SelectedObject = if previous and previous:IsDescendantOf(game)
+			then previous
+			else nil
+	end
+	selectionBeforeOpen = nil
+end
+
+local function onPicked(name: string)
+	BlockPlacer.setBlockType(name)
+	close()
+end
+
+local function focusTile(tile: GuiObject)
+	if not shouldFocusOnOpen then
+		return
+	end
+	-- The tile is not parented under PlayerGui until the panel finishes
+	-- building, and only a visible object can take selection.
+	task.defer(function()
+		if isOpen() and tile:IsDescendantOf(game) then
+			GuiService.SelectedObject = tile
+		end
+	end)
+end
+
+local function onToggleAction(
+	_actionName: string,
+	inputState: Enum.UserInputState,
+	_input: InputObject
+): Enum.ContextActionResult
+	if inputState ~= Enum.UserInputState.Begin then
+		return Enum.ContextActionResult.Pass
+	end
+	if isOpen() then
+		close()
+	else
+		open(true)
+	end
+	return Enum.ContextActionResult.Sink
+end
+
+local function onCloseAction(
+	_actionName: string,
+	inputState: Enum.UserInputState,
+	_input: InputObject
+): Enum.ContextActionResult
+	if inputState == Enum.UserInputState.Begin then
+		close()
+	end
+	return Enum.ContextActionResult.Sink
+end
+
+local function fitScale(designSize: () -> Vector2): () -> number
+	return function(): number
+		const design = designSize()
+		const usable = Screen.usableSize()
+		const fit = math.min(
+			(usable.X - EDGE_PADDING * 2) / design.X,
+			(usable.Y - EDGE_PADDING * 2) / design.Y
+		)
+		return math.clamp(fit, MINIMUM_FIT_SCALE, 1)
+	end
+end
+
+local function openHint(): InventoryButton.OpenHint
+	const kind = Screen.inputKind()
+	if kind == "KeyboardAndMouse" then
+		return "Key"
+	elseif kind == "Gamepad" then
+		return "Gamepad"
+	end
+	return "None"
+end
+
+local function app()
+	const selectedBlock = derive(function()
+		return BlockTypes.ByName[selectedName()]
+	end)
+
+	local function designSize(): Vector2
+		return InventoryPanel.panelSize(Screen.isPhone(), #entries())
+	end
+
+	local function usesSideButton(): boolean
+		return Screen.isTouch() or Screen.isPhone()
+	end
+
+	cleanup(BlockInventory.Changed:Connect(refreshInventory))
+	cleanup(BlockPlacer.BlockTypeChanged:Connect(function(name: string)
+		selectedName(name)
+		-- A number key picks a block while the panel is open, which ends
+		-- the visit the same way a tap on a tile does.
+		close()
+	end))
+
+	ContextActionService:BindAction(TOGGLE_ACTION, onToggleAction, false, TOGGLE_KEY, TOGGLE_BUTTON)
+	cleanup(function()
+		ContextActionService:UnbindAction(TOGGLE_ACTION)
+	end)
+
+	effect(function()
+		if not isOpen() then
+			return
+		end
+		-- Above Roblox's own B, which would otherwise only leave UI navigation
+		-- and keep the panel up.
+		ContextActionService:BindActionAtPriority(
+			CLOSE_ACTION,
+			onCloseAction,
+			false,
+			Enum.ContextActionPriority.High.Value,
+			CLOSE_BUTTON
+		)
+		cleanup(function()
+			ContextActionService:UnbindAction(CLOSE_ACTION)
+		end)
+	end)
+
+	effect(function()
+		const isPanelOpen = isOpen()
+		-- The panel covers the middle of the screen, where a stray thumbstick
+		-- touch or world tap would otherwise move the character or place a
+		-- block.
+		GuiService.TouchControlsEnabled = not isPanelOpen
+		BlockPlacer.setEnabled(not isPanelOpen)
+	end)
+
+	return create("ScreenGui")({
+		Name = "BlockInventory",
+		DisplayOrder = DISPLAY_ORDER,
+		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
+
+		create("UIScale")({ Scale = Screen.uiScale }),
+
+		create("Frame")({
+			Name = "HudDock",
+			Size = UDim2.fromOffset(InventoryButton.Size, InventoryButton.Size),
+			BackgroundTransparency = 1,
+			AnchorPoint = function()
+				return if usesSideButton() then Vector2.new(1, 0.5) else Vector2.new(0.5, 1)
+			end,
+			Position = function()
+				if Screen.isPhone() then
+					return UDim2.new(1, -PHONE_HUD_MARGIN, 0.5, 0)
+				elseif Screen.isTouch() then
+					return UDim2.new(1, -HUD_MARGIN, TABLET_HUD_HEIGHT, 0)
+				end
+				return UDim2.new(0.5, 0, 1, -HUD_MARGIN)
+			end,
+
+			InventoryButton.new({
+				Selected = selectedBlock,
+				Hint = openHint,
+				KeyText = UserInputService:GetStringForKeyCode(TOGGLE_KEY),
+				GamepadImage = function()
+					-- Rerun on an input change, when the controller type may
+					-- have changed too.
+					Screen.inputKind()
+					return UserInputService:GetImageForKeyCode(TOGGLE_BUTTON)
+				end,
+				IsReducedMotion = Screen.isReducedMotion,
+				TransparencyScale = Screen.preferredTransparency,
+				Activated = function()
+					if isOpen() then
+						close()
+					else
+						open(GuiService.SelectedObject ~= nil)
+					end
+				end,
+			}),
+		}),
+
+		show(isOpen, function(_, present)
+			const slide = spring(function(): number
+				return if present() or Screen.isReducedMotion() then 0 else SLIDE_DISTANCE
+			end, Theme.Motion.PanelPeriod)
+
+			const backdropTransparency = spring(function(): number
+				return if present()
+					then BACKDROP_TRANSPARENCY * Screen.preferredTransparency()
+					else 1
+			end, Theme.Motion.PanelPeriod)
+
+			return create("Frame")({
+				Name = "Overlay",
+				Size = UDim2.fromScale(1, 1),
+				BackgroundTransparency = 1,
+				ZIndex = 2,
+
+				create("TextButton")({
+					Name = "Backdrop",
+					Size = UDim2.fromScale(1, 1),
+					BackgroundColor3 = Theme.Colors.Backdrop,
+					BackgroundTransparency = backdropTransparency,
+					Text = "",
+					Selectable = false,
+					Activated = close,
+				}),
+
+				create("Frame")({
+					Name = "PanelDock",
+					AnchorPoint = Vector2.new(0.5, 0.5),
+					Position = function()
+						return UDim2.new(0.5, 0, 0.5, math.round(slide()))
+					end,
+					Size = function()
+						const size = designSize()
+						return UDim2.fromOffset(size.X, size.Y)
+					end,
+					BackgroundTransparency = 1,
+
+					create("UIScale")({ Scale = fitScale(designSize) }),
+
+					InventoryPanel.new({
+						Entries = entries,
+						Level = level,
+						SelectedName = selectedName,
+						IsCompact = Screen.isPhone,
+						ShowKeyHints = function()
+							return Screen.inputKind() == "KeyboardAndMouse"
+						end,
+						IsReducedMotion = Screen.isReducedMotion,
+						TransparencyScale = Screen.preferredTransparency,
+						Picked = onPicked,
+						CloseRequested = close,
+						FocusSelected = focusTile,
+					}),
+				}),
+			})
+		end),
+	})
+end
+
+--[[
+	Mounts the inventory HUD button and panel and binds their keys. Yields
+	until PlayerGui exists.
+]]
+function Module:StartAsync()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	refreshInventory()
+	selectedName(BlockPlacer.getBlockType())
+
+	const playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
+	mount(app, playerGui)
+end
+
+return Module
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryTypes.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryTypes.luau
new file mode 100644
index 0000000..11e499c
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryTypes.luau
@@ -0,0 +1,17 @@
+--!strict
+--[[
+	Shapes the inventory UI passes around. Components take these through
+	props, so stories can build them without the game running.
+]]
+
+export type BlockEntry = {
+	Name: string,
+	DisplayName: string,
+	Color: Color3,
+	Transparency: number,
+	Count: number,
+	UnlockLevel: number,
+	IsUnlocked: boolean,
+}
+
+return {}
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Screen.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Screen.luau
new file mode 100644
index 0000000..1604082
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Screen.luau
@@ -0,0 +1,171 @@
+--!strict
+--[[
+	Facts about the player's screen and settings, as Vide sources, so layout
+	follows a device change, a new input, or a settings change while the UI is
+	up. Every ScreenGui the game builds binds a UIScale to Screen.uiScale.
+]]
+
+const GuiService = game:GetService("GuiService")
+const RunService = game:GetService("RunService")
+const UserInputService = game:GetService("UserInputService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const batch = Vide.batch
+const source = Vide.source
+
+const REFERENCE_SHORT_SIDE = 1080
+const MINIMUM_SCALE = 1
+const MAXIMUM_SCALE = 3
+const LARGE_DISPLAY_BOOST = 1.25
+const PHONE_SHORT_SIDE = 600
+const FALLBACK_VIEWPORT = Vector2.new(1920, 1080)
+
+export type InputKind = "Touch" | "KeyboardAndMouse" | "Gamepad"
+
+export type SimulatedScreen = {
+	Size: Vector2,
+	Inset: Vector2?,
+	Input: InputKind?,
+	IsLargeDisplay: boolean?,
+}
+
+local Module = {}
+
+local realViewport = source(FALLBACK_VIEWPORT)
+local realInset = source(Vector2.zero)
+local inputKind = source("KeyboardAndMouse" :: InputKind)
+local isLargeDisplay = source(false)
+local isReducedMotion = source(false)
+local preferredTransparency = source(1)
+local isSimulating = false
+local viewportConnection: RBXScriptConnection? = nil
+
+local function readInputKind(): InputKind
+	const preferred = UserInputService.PreferredInput
+	if preferred == Enum.PreferredInput.Touch then
+		return "Touch"
+	elseif preferred == Enum.PreferredInput.Gamepad then
+		return "Gamepad"
+	end
+	return "KeyboardAndMouse"
+end
+
+local function refresh()
+	if isSimulating then
+		return
+	end
+
+	const camera = workspace.CurrentCamera
+	const topLeftInset = GuiService:GetGuiInset()
+	batch(function()
+		-- ViewportSize can read (1, 1) before the first frame, which would
+		-- pass for a tiny phone.
+		if camera and camera.ViewportSize.X > 1 and camera.ViewportSize.Y > 1 then
+			realViewport(camera.ViewportSize)
+		end
+		realInset(topLeftInset)
+		inputKind(readInputKind())
+		isLargeDisplay(GuiService.ViewportDisplaySize == Enum.DisplaySize.Large)
+		isReducedMotion(GuiService.ReducedMotionEnabled)
+		preferredTransparency(GuiService.PreferredTransparency)
+	end)
+end
+
+local function watchCamera()
+	if viewportConnection then
+		viewportConnection:Disconnect()
+	end
+	const camera = workspace.CurrentCamera
+	if camera then
+		viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
+	end
+	refresh()
+end
+
+--[[
+	How much the whole UI grows on this screen: the short side over 1080,
+	clamped to 1..3, with a quarter more on a TV.
+]]
+function Module.uiScale(): number
+	const view = realViewport()
+	const boost = if isLargeDisplay() then LARGE_DISPLAY_BOOST else 1
+	return math.clamp(
+		math.min(view.X, view.Y) / REFERENCE_SHORT_SIDE * boost,
+		MINIMUM_SCALE,
+		MAXIMUM_SCALE
+	)
+end
+
+--[[
+	The part of the viewport below the Roblox topbar, in UI units.
+]]
+function Module.usableSize(): Vector2
+	const scale = Module.uiScale()
+	const view = realViewport() / scale
+	return Vector2.new(view.X, view.Y - realInset().Y / scale)
+end
+
+function Module.inputKind(): InputKind
+	return inputKind()
+end
+
+--[[
+	Whether touch is the primary input, which is when Roblox shows its
+	thumbstick and jump button.
+]]
+function Module.isTouch(): boolean
+	return inputKind() == "Touch"
+end
+
+function Module.isPhone(): boolean
+	const usable = Module.usableSize()
+	return math.min(usable.X, usable.Y) < PHONE_SHORT_SIDE
+end
+
+function Module.isReducedMotion(): boolean
+	return isReducedMotion()
+end
+
+--[[
+	The player's background transparency setting: 1 by default, 0 when they
+	want fully opaque backgrounds. Multiply each BackgroundTransparency by it.
+]]
+function Module.preferredTransparency(): number
+	return preferredTransparency()
+end
+
+--[[
+	Replaces the live readings with the given screen, for a story or a spec.
+	Pass nil to go back to them.
+]]
+function Module:Simulate(screen: SimulatedScreen?)
+	isSimulating = screen ~= nil
+	if not screen then
+		refresh()
+		return
+	end
+
+	batch(function()
+		realViewport(screen.Size)
+		realInset(screen.Inset or Vector2.zero)
+		inputKind(screen.Input or "KeyboardAndMouse")
+		isLargeDisplay(screen.IsLargeDisplay == true)
+	end)
+end
+
+-- Stories load a fresh copy of this module on every reload, and a connection
+-- would keep each copy alive until Studio closes.
+if RunService:IsRunning() then
+	watchCamera()
+	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
+	GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(refresh)
+	GuiService:GetPropertyChangedSignal("ViewportDisplaySize"):Connect(refresh)
+	GuiService:GetPropertyChangedSignal("ReducedMotionEnabled"):Connect(refresh)
+	GuiService:GetPropertyChangedSignal("PreferredTransparency"):Connect(refresh)
+	UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(refresh)
+else
+	refresh()
+end
+
+return Module
