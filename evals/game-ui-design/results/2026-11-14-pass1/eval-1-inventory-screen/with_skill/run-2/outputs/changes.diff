+--!strict
+--[[
+	The HUD button that opens the block inventory. It shows the block in use,
+	and the key or controller button that opens it on those inputs.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const Theme = require("../Theme")
+
+const create = Vide.create
+const read = Vide.read
+const source = Vide.source
+const spring = Vide.spring
+
+const BUTTON_SIZE = 88
+const BUTTON_RADIUS = 16
+const SWATCH_SIZE = 40
+const SWATCH_RADIUS = 8
+const NAME_HEIGHT = 22
+const CONTENT_GAP = 4
+const BADGE_SIZE = 28
+const GAMEPAD_GLYPH_SIZE = 32
+const BADGE_OFFSET = -8
+const PRESSED_SCALE = 0.92
+const BACKPLATE_TRANSPARENCY = 0.15
+
+export type OpenHint = "Key" | "Gamepad" | "None"
+
+export type SelectedBlock = {
+	DisplayName: string,
+	Color: Color3,
+	Transparency: number,
+}
+
+export type InventoryButtonProps = {
+	Selected: () -> SelectedBlock,
+	Hint: OpenHint | () -> OpenHint,
+	KeyText: string,
+	-- An image from UserInputService:GetImageForKeyCode, so the glyph
+	-- matches the player's controller.
+	GamepadImage: string | () -> string,
+	IsReducedMotion: boolean | () -> boolean,
+	TransparencyScale: number | () -> number,
+	Activated: () -> (),
+}
+
+local function isPointerPress(input: InputObject): boolean
+	return input.UserInputType == Enum.UserInputType.MouseButton1
+		or input.UserInputType == Enum.UserInputType.Touch
+end
+
+local function inventoryButton(props: InventoryButtonProps): TextButton
+	local isPressed = source(false)
+	local isHovered = source(false)
+	local isFocused = source(false)
+
+	const pressScale = spring(function(): number
+		return if isPressed() and not read(props.IsReducedMotion) then PRESSED_SCALE else 1
+	end, Theme.Motion.PressPeriod, Theme.Motion.PressDamping)
+
+	return create("TextButton")({
+		Name = "InventoryButton",
+		Size = UDim2.fromOffset(BUTTON_SIZE, BUTTON_SIZE),
+		Text = "",
+		BackgroundTransparency = 1,
+		Selectable = true,
+		SelectionImageObject = create("Frame")({ BackgroundTransparency = 1 }),
+
+		Activated = props.Activated,
+		InputBegan = function(input: InputObject)
+			if input.UserInputType == Enum.UserInputType.MouseMovement then
+				isHovered(true)
+			elseif isPointerPress(input) then
+				isPressed(true)
+			end
+		end,
+		InputEnded = function(input: InputObject)
+			if input.UserInputType == Enum.UserInputType.MouseMovement then
+				isHovered(false)
+				isPressed(false)
+			elseif isPointerPress(input) then
+				isPressed(false)
+			end
+		end,
+		SelectionGained = function()
+			isFocused(true)
+		end,
+		SelectionLost = function()
+			isFocused(false)
+		end,
+
+		create("Frame")({
+			Name = "Face",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0.5),
+			Size = UDim2.fromScale(1, 1),
+			BackgroundColor3 = function()
+				return if isHovered() then Theme.Colors.TileHover else Theme.Colors.Panel
+			end,
+			BackgroundTransparency = function()
+				return BACKPLATE_TRANSPARENCY * read(props.TransparencyScale)
+			end,
+
+			create("UIScale")({ Scale = pressScale }),
+			create("UICorner")({ CornerRadius = UDim.new(0, BUTTON_RADIUS) }),
+			create("UIStroke")({
+				Color = function()
+					return if isFocused() then Theme.Colors.Focus else Theme.Colors.PanelStroke
+				end,
+				Thickness = function()
+					return if isFocused() then 3 else 2
+				end,
+			}),
+
+			create("Frame")({
+				Name = "Content",
+				Size = UDim2.fromScale(1, 1),
+				BackgroundTransparency = 1,
+
+				create("UIListLayout")({
+					FillDirection = Enum.FillDirection.Vertical,
+					HorizontalAlignment = Enum.HorizontalAlignment.Center,
+					VerticalAlignment = Enum.VerticalAlignment.Center,
+					Padding = UDim.new(0, CONTENT_GAP),
+				}),
+
+				create("Frame")({
+					Name = "Swatch",
+					LayoutOrder = 1,
+					Size = UDim2.fromOffset(SWATCH_SIZE, SWATCH_SIZE),
+					BackgroundColor3 = function()
+						return props.Selected().Color
+					end,
+					BackgroundTransparency = function()
+						return props.Selected().Transparency * 0.5
+					end,
+
+					create("UICorner")({ CornerRadius = UDim.new(0, SWATCH_RADIUS) }),
+					create("UIStroke")({
+						Color = Theme.Colors.SwatchStroke,
+						Thickness = 2,
+					}),
+				}),
+
+				create("TextLabel")({
+					Name = "BlockName",
+					LayoutOrder = 2,
+					Size = UDim2.new(1, -8, 0, NAME_HEIGHT),
+					BackgroundTransparency = 1,
+					FontFace = Theme.BoldFont,
+					Text = function()
+						return props.Selected().DisplayName
+					end,
+					TextSize = Theme.TextSizes.Caption + 2,
+					TextColor3 = Theme.Colors.Text,
+					TextTruncate = Enum.TextTruncate.AtEnd,
+				}),
+			}),
+		}),
+
+		create("TextLabel")({
+			Name = "KeyHint",
+			Position = UDim2.fromOffset(BADGE_OFFSET, BADGE_OFFSET),
+			Size = UDim2.fromOffset(BADGE_SIZE, BADGE_SIZE),
+			BackgroundColor3 = Theme.Colors.KeyCap,
+			FontFace = Theme.BoldFont,
+			Text = props.KeyText,
+			TextSize = Theme.TextSizes.Caption,
+			TextColor3 = Theme.Colors.KeyCapText,
+			Visible = function()
+				return read(props.Hint) == "Key"
+			end,
+			ZIndex = 2,
+
+			create("UICorner")({ CornerRadius = UDim.new(0, 6) }),
+		}),
+
+		create("ImageLabel")({
+			Name = "GamepadHint",
+			Position = UDim2.fromOffset(BADGE_OFFSET, BADGE_OFFSET),
+			Size = UDim2.fromOffset(GAMEPAD_GLYPH_SIZE, GAMEPAD_GLYPH_SIZE),
+			BackgroundTransparency = 1,
+			Image = props.GamepadImage,
+			ScaleType = Enum.ScaleType.Fit,
+			Visible = function()
+				return read(props.Hint) == "Gamepad"
+			end,
+			ZIndex = 2,
+		}),
+	})
+end
+
+local Module = {}
+
+Module.Size = BUTTON_SIZE
+Module.new = inventoryButton
+
+return Module
