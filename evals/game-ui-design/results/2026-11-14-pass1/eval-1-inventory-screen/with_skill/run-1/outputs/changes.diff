--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/formatCount.luau
@@ -0,0 +1,20 @@
+--!strict
+--[[
+	Formats a block count short enough for a tile's corner: 999, 9999, then
+	12K, 1.2M, 34M.
+]]
+
+local function formatCount(count: number): string
+	if count < 10_000 then
+		return tostring(math.floor(count))
+	elseif count < 1_000_000 then
+		return `{math.floor(count / 1_000)}K`
+	end
+	const millions = count / 1_000_000
+	if millions < 10 then
+		return `{math.floor(millions * 10) / 10}M`
+	end
+	return `{math.floor(millions)}M`
+end
+
+return formatCount
