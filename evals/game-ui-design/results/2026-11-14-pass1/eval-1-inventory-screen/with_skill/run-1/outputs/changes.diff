+--!strict
+--[[
+	A padlock drawn from frames, so it needs no uploaded image and stays
+	sharp at every UI scale.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const Theme = require("../Theme")
+
+const create = Vide.create
+const read = Vide.read
+
+const CENTER = Vector2.new(0.5, 0.5)
+
+export type LockIconProps = {
+	Size: number | () -> number,
+	Position: UDim2?,
+	AnchorPoint: Vector2?,
+}
+
+local function lockIcon(props: LockIconProps): Frame
+	local function size(): number
+		return read(props.Size)
+	end
+
+	return create("Frame")({
+		Name = "LockIcon",
+		BackgroundTransparency = 1,
+		AnchorPoint = props.AnchorPoint or CENTER,
+		Position = props.Position or UDim2.fromScale(0.5, 0.5),
+		Size = function()
+			return UDim2.fromOffset(size(), size())
+		end,
+
+		create("Frame")({
+			Name = "Shackle",
+			BackgroundTransparency = 1,
+			AnchorPoint = Vector2.new(0.5, 0),
+			Position = UDim2.fromScale(0.5, 0),
+			Size = UDim2.fromScale(0.56, 0.6),
+
+			create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+			create("UIStroke")({
+				Color = Theme.Text,
+				Thickness = function()
+					return math.max(2, math.round(size() * 0.12))
+				end,
+			}),
+		}),
+
+		create("Frame")({
+			Name = "Body",
+			BackgroundColor3 = Theme.Text,
+			AnchorPoint = Vector2.new(0.5, 1),
+			Position = UDim2.fromScale(0.5, 1),
+			Size = UDim2.fromScale(0.82, 0.56),
+
+			create("UICorner")({ CornerRadius = UDim.new(0.18, 0) }),
+			create("UIStroke")({
+				Color = Theme.TextOutline,
+				Thickness = 1,
+			}),
+
+			create("Frame")({
+				Name = "Keyhole",
+				BackgroundColor3 = Theme.LockShade,
+				AnchorPoint = CENTER,
+				Position = UDim2.fromScale(0.5, 0.5),
+				Size = UDim2.fromScale(0.16, 0.4),
+
+				create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+			}),
+		}),
+	})
+end
+
+return lockIcon
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryState.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryState.luau
new file mode 100644
index 0000000..93ff6fb
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryState.luau
@@ -0,0 +1,135 @@
+--!strict
+--[[
+	What the inventory screen shows, as Vide sources fed from BlockInventory
+	and BlockPlacer, plus whether the screen is open. Components read these;
+	only this module writes them.
+]]
+
+const GuiService = game:GetService("GuiService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+const BlockInventory = require("../BlockInventory")
+const BlockPlacer = require("../BlockPlacer")
+
+const batch = Vide.batch
+const source = Vide.source
+
+local Module = {}
+
+local function readCounts(): { [string]: number }
+	local counts = {}
+	for _, blockType in BlockTypes.List do
+		counts[blockType.Name] = BlockInventory.getCount(blockType.Name)
+	end
+	return table.freeze(counts)
+end
+
+local counts = source(readCounts())
+local level = source(BlockInventory.getLevel())
+local selectedName = source(BlockPlacer.getBlockType())
+local isOpen = source(false)
+local hasStarted = false
+local selectionBeforeOpen: GuiObject? = nil
+
+function Module.count(name: string): number
+	return counts()[name] or 0
+end
+
+function Module.level(): number
+	return level()
+end
+
+function Module.isUnlocked(name: string): boolean
+	return level() >= BlockInventory.getUnlockLevel(name)
+end
+
+function Module.unlockLevel(name: string): number
+	return BlockInventory.getUnlockLevel(name)
+end
+
+function Module.selectedName(): string
+	return selectedName()
+end
+
+function Module.isOpen(): boolean
+	return isOpen()
+end
+
+--[[
+	Picks the block to build with. Returns false, and changes nothing, when
+	the block is still locked.
+]]
+function Module.pick(name: string): boolean
+	if not BlockInventory.isUnlocked(name) then
+		return false
+	end
+	BlockPlacer.setBlockType(name)
+	return true
+end
+
+function Module.open()
+	if isOpen() then
+		return
+	end
+	selectionBeforeOpen = GuiService.SelectedObject
+	isOpen(true)
+end
+
+--[[
+	Closes the screen and gives gamepad focus back to whatever had it before
+	the screen opened, if that is still on screen.
+]]
+function Module.close()
+	if not isOpen() then
+		return
+	end
+	isOpen(false)
+
+	const previous = selectionBeforeOpen
+	selectionBeforeOpen = nil
+	if previous and previous:IsDescendantOf(game) and previous.Visible then
+		GuiService.SelectedObject = previous
+	else
+		GuiService.SelectedObject = nil
+	end
+end
+
+function Module.toggle()
+	if isOpen() then
+		Module.close()
+	else
+		Module.open()
+	end
+end
+
+--[[
+	Starts following BlockInventory and BlockPlacer. Call once from client
+	startup.
+]]
+function Module.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	BlockInventory.Changed:Connect(function()
+		batch(function()
+			counts(readCounts())
+			level(BlockInventory.getLevel())
+		end)
+	end)
+	BlockPlacer.BlockTypeChanged:Connect(function(name: string)
+		selectedName(name)
+	end)
+
+	batch(function()
+		counts(readCounts())
+		level(BlockInventory.getLevel())
+		selectedName(BlockPlacer.getBlockType())
+	end)
+end
+
+return Module
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryUI.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryUI.luau
new file mode 100644
index 0000000..c01b8c9
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryUI.luau
@@ -0,0 +1,248 @@
+--!strict
+--[[
+	Mounts the block inventory: the Blocks button on the HUD and the
+	inventory screen it opens. Connects the view components to
+	InventoryState and Screen, binds the open and close keys, and turns off
+	touch movement and block placing while the screen is open.
+]]
+
+const ContextActionService = game:GetService("ContextActionService")
+const GuiService = game:GetService("GuiService")
+const Players = game:GetService("Players")
+const RunService = game:GetService("RunService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+const BlockPlacer = require("../BlockPlacer")
+const BlocksButton = require("./Components/BlocksButton")
+const InventoryMetrics = require("./Components/InventoryMetrics")
+const InventoryPanel = require("./Components/InventoryPanel")
+const InventoryState = require("./InventoryState")
+const Screen = require("./Screen")
+
+Vide.strict = RunService:IsStudio()
+
+const cleanup = Vide.cleanup
+const create = Vide.create
+const effect = Vide.effect
+const mount = Vide.mount
+const root = Vide.root
+const show = Vide.show
+const spring = Vide.spring
+
+const TOGGLE_ACTION = "ToggleBlockInventory"
+const CLOSE_ACTION = "CloseBlockInventory"
+const EDGE_PADDING = 12
+const MINIMUM_FIT_SCALE = 0.6
+const BACKDROP_TRANSPARENCY = 0.45
+const ENTRANCE_SLIDE = 32
+const ENTRANCE_PERIOD = 0.25
+const CENTER = Vector2.new(0.5, 0.5)
+
+local Module = {}
+
+local hasStarted = false
+
+local function designSize(): Vector2
+	const metrics = if Screen.isPhone() then InventoryMetrics.Compact else InventoryMetrics.Regular
+	return InventoryMetrics.panelSize(metrics, #BlockTypes.List)
+end
+
+--[[
+	Shrinks the panel to fit the room below the topbar, never above its
+	authored size, and never below the scale where its text stops fitting.
+]]
+local function fitScale(): number
+	const design = designSize()
+	const usable = Screen.usableSize()
+	const fit =
+		math.min((usable.X - EDGE_PADDING * 2) / design.X, (usable.Y - EDGE_PADDING * 2) / design.Y)
+	return math.clamp(fit, MINIMUM_FIT_SCALE, 1)
+end
+
+local function selectDefaultTile(panel: GuiObject, tiles: { [string]: ImageButton })
+	const current = GuiService.SelectedObject
+	if current and current:IsDescendantOf(panel) then
+		return
+	end
+	const tile = tiles[InventoryState.selectedName()]
+	if tile and tile:IsDescendantOf(game) then
+		GuiService.SelectedObject = tile
+	end
+end
+
+local function inventoryDock(present: () -> boolean)
+	const tiles: { [string]: ImageButton } = {}
+
+	const slide = spring(function()
+		return if present() or Screen.isReducedMotion() then 0 else ENTRANCE_SLIDE
+	end, ENTRANCE_PERIOD)
+	const backdropTransparency = spring(function()
+		return if present() then Screen.backgroundTransparency(BACKDROP_TRANSPARENCY) else 1
+	end, ENTRANCE_PERIOD)
+
+	const panel = InventoryPanel({
+		Blocks = BlockTypes.List,
+		Count = InventoryState.count,
+		IsUnlocked = InventoryState.isUnlocked,
+		UnlockLevel = InventoryState.unlockLevel,
+		PickedName = InventoryState.selectedName,
+		Level = InventoryState.level,
+		Input = Screen.input,
+		IsCompact = Screen.isPhone,
+		IsReducedMotion = Screen.isReducedMotion,
+		BackgroundTransparency = Screen.backgroundTransparency,
+		Pick = function(name: string)
+			InventoryState.pick(name)
+		end,
+		Close = InventoryState.close,
+		TileBuilt = function(name: string, tile: ImageButton)
+			tiles[name] = tile
+		end,
+	})
+
+	-- Focus moves to the picked tile when the screen opens on a gamepad, and
+	-- when a gamepad is picked up while it is open. The tiles are parented
+	-- only after this scope returns, so the selection waits a frame.
+	effect(function()
+		if Screen.input() == "Gamepad" then
+			cleanup(task.defer(selectDefaultTile, panel, tiles))
+		end
+	end)
+
+	return create("Frame")({
+		Name = "InventoryDock",
+		BackgroundTransparency = 1,
+		Size = UDim2.fromScale(1, 1),
+
+		create("TextButton")({
+			Name = "Backdrop",
+			AnchorPoint = CENTER,
+			Position = UDim2.fromScale(0.5, 0.5),
+			-- Oversized so it also covers the topbar strip and notch insets
+			-- outside this ScreenGui's safe area.
+			Size = UDim2.fromScale(3, 3),
+			BackgroundColor3 = Color3.new(0, 0, 0),
+			BackgroundTransparency = backdropTransparency,
+			Selectable = false,
+			Text = "",
+			Activated = InventoryState.close,
+		}),
+
+		create("Frame")({
+			Name = "PanelDock",
+			BackgroundTransparency = 1,
+			AnchorPoint = CENTER,
+			Position = function()
+				return UDim2.new(0.5, 0, 0.5, math.round(slide()))
+			end,
+			Size = function()
+				const size = designSize()
+				return UDim2.fromOffset(size.X, size.Y)
+			end,
+
+			create("UIScale")({ Scale = fitScale }),
+			panel,
+		}),
+	})
+end
+
+local function hud()
+	return create("ScreenGui")({
+		Name = "BlockHud",
+		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
+
+		create("UIScale")({ Scale = Screen.uiScale }),
+		BlocksButton({
+			BlockType = function()
+				return BlockTypes.ByName[InventoryState.selectedName()]
+			end,
+			Count = function()
+				return InventoryState.count(InventoryState.selectedName())
+			end,
+			Input = Screen.input,
+			BackgroundTransparency = Screen.backgroundTransparency,
+			Activated = InventoryState.toggle,
+		}),
+	})
+end
+
+local function inventoryScreen()
+	return create("ScreenGui")({
+		Name = "BlockInventory",
+		DisplayOrder = 10,
+		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
+
+		create("UIScale")({ Scale = Screen.uiScale }),
+		show(InventoryState.isOpen, function(_, present)
+			return inventoryDock(present)
+		end),
+	})
+end
+
+local function onToggleAction(_: string, state: Enum.UserInputState): Enum.ContextActionResult
+	if state == Enum.UserInputState.Begin then
+		InventoryState.toggle()
+	end
+	return Enum.ContextActionResult.Sink
+end
+
+local function onCloseAction(_: string, state: Enum.UserInputState): Enum.ContextActionResult
+	if state == Enum.UserInputState.Begin then
+		InventoryState.close()
+	end
+	return Enum.ContextActionResult.Sink
+end
+
+--[[
+	Mounts the inventory UI into the player's PlayerGui. Yields until
+	PlayerGui exists, so call it from client startup before anything that
+	should wait for the UI.
+]]
+function Module.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	InventoryState.start()
+
+	const playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
+	mount(hud, playerGui)
+	mount(inventoryScreen, playerGui)
+
+	ContextActionService:BindAction(
+		TOGGLE_ACTION,
+		onToggleAction,
+		false,
+		Enum.KeyCode.B,
+		Enum.KeyCode.ButtonY
+	)
+
+	root(function()
+		effect(function()
+			const isOpen = InventoryState.isOpen()
+			-- The screen covers the thumbstick and jump button, and taps
+			-- around it close it instead of placing a block.
+			GuiService.TouchControlsEnabled = not isOpen
+			BlockPlacer.setEnabled(not isOpen)
+
+			if isOpen then
+				ContextActionService:BindActionAtPriority(
+					CLOSE_ACTION,
+					onCloseAction,
+					false,
+					Enum.ContextActionPriority.High.Value,
+					Enum.KeyCode.ButtonB
+				)
+				cleanup(function()
+					ContextActionService:UnbindAction(CLOSE_ACTION)
+				end)
+			end
+		end)
+	end)
+end
+
+return Module
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Screen.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Screen.luau
new file mode 100644
index 0000000..fcbf5fd
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Screen.luau
@@ -0,0 +1,139 @@
+--!strict
+--[[
+	Facts about the player's screen and input, kept as Vide sources so layout
+	follows them live: the viewport, the topbar inset, the primary input, and
+	the player's reduced motion and transparency settings. UI reads the screen
+	only through this module.
+]]
+
+const GuiService = game:GetService("GuiService")
+const RunService = game:GetService("RunService")
+const UserInputService = game:GetService("UserInputService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const batch = Vide.batch
+const source = Vide.source
+
+const REFERENCE_SHORT_SIDE = 1080
+const MINIMUM_SCALE = 1
+const MAXIMUM_SCALE = 3
+const LARGE_DISPLAY_BOOST = 1.25
+const PHONE_SHORT_SIDE = 600
+const FALLBACK_VIEWPORT = Vector2.new(1920, 1080)
+
+export type Input = "Touch" | "Gamepad" | "KeyboardAndMouse"
+
+local Module = {}
+
+local realViewport = source(FALLBACK_VIEWPORT)
+local realInset = source(Vector2.zero)
+local preferredInput = source("KeyboardAndMouse" :: Input)
+local isLargeDisplay = source(false)
+local isReducedMotion = source(false)
+local preferredTransparency = source(1)
+local viewportConnection: RBXScriptConnection? = nil
+
+local function readInput(): Input
+	const input = UserInputService.PreferredInput
+	if input == Enum.PreferredInput.Touch then
+		return "Touch"
+	elseif input == Enum.PreferredInput.Gamepad then
+		return "Gamepad"
+	end
+	return "KeyboardAndMouse"
+end
+
+local function refresh()
+	const camera = workspace.CurrentCamera
+	batch(function()
+		-- ViewportSize can read (1, 1) before the first frame, which would
+		-- pass for a tiny phone, so the fallback stays until a real size
+		-- arrives.
+		if camera and camera.ViewportSize.X > 1 and camera.ViewportSize.Y > 1 then
+			realViewport(camera.ViewportSize)
+		end
+		realInset(GuiService:GetGuiInset())
+		preferredInput(readInput())
+		isLargeDisplay(GuiService.ViewportDisplaySize == Enum.DisplaySize.Large)
+		isReducedMotion(GuiService.ReducedMotionEnabled)
+		preferredTransparency(GuiService.PreferredTransparency)
+	end)
+end
+
+local function watchCamera()
+	if viewportConnection then
+		viewportConnection:Disconnect()
+	end
+	const camera = workspace.CurrentCamera
+	if camera then
+		viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
+	end
+	refresh()
+end
+
+--[[
+	How much the whole UI grows on this screen. Bind it to a UIScale under
+	every ScreenGui the game builds.
+]]
+function Module.uiScale(): number
+	const view = realViewport()
+	const boost = if isLargeDisplay() then LARGE_DISPLAY_BOOST else 1
+	return math.clamp(
+		math.min(view.X, view.Y) / REFERENCE_SHORT_SIDE * boost,
+		MINIMUM_SCALE,
+		MAXIMUM_SCALE
+	)
+end
+
+--[[
+	The part of the viewport below the Roblox topbar, in UI units.
+]]
+function Module.usableSize(): Vector2
+	const scale = Module.uiScale()
+	const view = realViewport() / scale
+	return Vector2.new(view.X, view.Y - realInset().Y / scale)
+end
+
+--[[
+	A short side under about 600 UI units: a phone, or a window dragged that
+	small.
+]]
+function Module.isPhone(): boolean
+	const view = realViewport() / Module.uiScale()
+	return math.min(view.X, view.Y) < PHONE_SHORT_SIDE
+end
+
+--[[
+	Roblox's pick of the player's primary input. Touch means its thumbstick
+	and jump button are on screen.
+]]
+function Module.input(): Input
+	return preferredInput()
+end
+
+function Module.isReducedMotion(): boolean
+	return isReducedMotion()
+end
+
+--[[
+	Turns a background transparency into the one to draw, following the
+	player's Background Transparency setting (1 by default, 0 for opaque).
+]]
+function Module.backgroundTransparency(base: number): number
+	return base * preferredTransparency()
+end
+
+if RunService:IsRunning() then
+	watchCamera()
+	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
+	GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(refresh)
+	GuiService:GetPropertyChangedSignal("ViewportDisplaySize"):Connect(refresh)
+	GuiService:GetPropertyChangedSignal("ReducedMotionEnabled"):Connect(refresh)
+	GuiService:GetPropertyChangedSignal("PreferredTransparency"):Connect(refresh)
+	UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(refresh)
+else
+	refresh()
+end
+
+return Module
