+					TextColor3 = Theme.Text,
+					TextXAlignment = Enum.TextXAlignment.Left,
+					TextTruncate = Enum.TextTruncate.AtEnd,
+					Text = function()
+						const blockType = detailBlock()
+						if not props.IsUnlocked(blockType.Name) then
+							return `{blockType.DisplayName}  (locked)`
