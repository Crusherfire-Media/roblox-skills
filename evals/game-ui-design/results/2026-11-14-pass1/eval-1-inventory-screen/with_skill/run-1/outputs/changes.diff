diff --git a/src/ServerScriptService/Stories/Inventory/BlockTile.story.luau b/src/ServerScriptService/Stories/Inventory/BlockTile.story.luau
new file mode 100644
index 0000000..0cd3636
--- /dev/null
+++ b/src/ServerScriptService/Stories/Inventory/BlockTile.story.luau
@@ -0,0 +1,123 @@
+--!strict
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+const BlockTile = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile")
+const InventoryMetrics =
+	require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryMetrics")
+
+const create = Vide.create
+
+local function blockNames(): { string }
+	const names = {}
+	for _, blockType in BlockTypes.List do
+		table.insert(names, blockType.Name)
+	end
+	return names
+end
+
+const CONTROLS = {
+	Block = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Name = UILabs.Ordered(UILabs.Choose(blockNames()), 1),
+			Count = UILabs.Ordered(UILabs.Slider(48, 0, 2_000_000, 1), 2),
+		}),
+		1
+	),
+	State = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsPicked = UILabs.Ordered(false, 1),
+			IsLocked = UILabs.Ordered(false, 2),
+			UnlockLevel = UILabs.Ordered(UILabs.Slider(10, 2, 99, 1), 3),
+			-- Empty hides the number-key badge, as on touch and gamepad.
+			KeyLabel = UILabs.Ordered("1", 4),
+		}),
+		2
+	),
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsCompact = UILabs.Ordered(false, 1),
+		}),
+		3
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Block: {
+			Name: () -> string,
+			Count: () -> number,
+		},
+		State: {
+			IsPicked: () -> boolean,
+			IsLocked: () -> boolean,
+			UnlockLevel: () -> number,
+			KeyLabel: () -> string,
+		},
+		Layout: {
+			IsCompact: () -> boolean,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const block = props.controls.Block
+	const state = props.controls.State
+
+	local function metrics()
+		return if props.controls.Layout.IsCompact()
+			then InventoryMetrics.Compact
+			else InventoryMetrics.Regular
+	end
+
+	-- Keyed by block name, so choosing another block builds a fresh tile.
+	return Vide.indexes(function()
+		return { [block.Name()] = true }
+	end, function(_, name: string)
+		return create("Frame")({
+			BackgroundTransparency = 1,
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0.5),
+			Size = function()
+				const size = metrics().TileSize
+				return UDim2.fromOffset(size.X, size.Y)
+			end,
+
+			create("UIGridLayout")({
+				CellSize = function()
+					const size = metrics().TileSize
+					return UDim2.fromOffset(size.X, size.Y)
+				end,
+			}),
+
+			BlockTile({
+				BlockType = BlockTypes.ByName[name],
+				LayoutOrder = 1,
+				Count = block.Count,
+				IsLocked = state.IsLocked,
+				UnlockLevel = state.UnlockLevel,
+				IsPicked = state.IsPicked,
+				KeyLabel = function()
+					const label = state.KeyLabel()
+					return if label == "" then nil else label
+				end,
+				Metrics = metrics,
+				Activated = function()
+					print(`Tile {name} activated`)
+				end,
+			}),
+		})
+	end)
+end
+
+return {
+	summary = "One inventory tile in each state: picked, locked with its unlock level, empty, "
+		.. "and huge counts.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
