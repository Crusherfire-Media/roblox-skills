diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile.luau
new file mode 100644
index 0000000..bd8b63f
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile.luau
@@ -0,0 +1,308 @@
+--!strict
+--[[
+	One block type in the inventory grid: a color swatch, its name, and how
+	many the player has. A locked tile shows a padlock and the level that
+	unlocks it; the picked tile has a thick yellow outline and a "Picked"
+	tag, so neither state relies on color alone.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+const InventoryMetrics = require("./InventoryMetrics")
+const LockIcon = require("./LockIcon")
+const Theme = require("../Theme")
+const formatCount = require("../formatCount")
+
+const action = Vide.action
+const changed = Vide.changed
+const create = Vide.create
+const read = Vide.read
+const source = Vide.source
+const spring = Vide.spring
+
+type BlockType = BlockTypes.BlockType
+type Metrics = InventoryMetrics.Metrics
+
+const PICKED_STROKE = 4
+const SWATCH_STROKE = 2
+const PRESS_SINK = 3
+const SHAKE_IMPULSE = 900
+const BADGE_PADDING = 6
+
+export type BlockTileProps = {
+	BlockType: BlockType,
+	LayoutOrder: number,
+	Count: number | () -> number,
+	IsLocked: boolean | () -> boolean,
+	UnlockLevel: number | () -> number,
+	IsPicked: boolean | () -> boolean,
+	-- The number key that picks this block, shown only while it is set.
+	KeyLabel: (string | () -> string?)?,
+	Metrics: Metrics | () -> Metrics,
+	IsReducedMotion: (boolean | () -> boolean)?,
+	Activated: () -> (),
+	HighlightChanged: ((isHighlighted: boolean) -> ())?,
+	Built: ((tile: ImageButton) -> ())?,
+}
+
+local function blockTile(props: BlockTileProps): ImageButton
+	const blockType = props.BlockType
+	const guiState = source(Enum.GuiState.Idle)
+
+	local function metrics(): Metrics
+		return read(props.Metrics)
+	end
+	local function isLocked(): boolean
+		return read(props.IsLocked)
+	end
+	local function isPicked(): boolean
+		return read(props.IsPicked)
+	end
+	local function keyLabel(): string?
+		return read(props.KeyLabel)
+	end
+
+	const shakeOffset, shake = spring(function()
+		return 0
+	end, 0.3, 0.2)
+	const sink = spring(function()
+		return if guiState() == Enum.GuiState.Press then PRESS_SINK else 0
+	end, 0.12, 0.6)
+
+	local function onActivated()
+		if isLocked() and not read(props.IsReducedMotion) then
+			shake({ impulse = SHAKE_IMPULSE })
+		end
+		props.Activated()
+	end
+
+	local function setHighlighted(isHighlighted: boolean)
+		if props.HighlightChanged then
+			props.HighlightChanged(isHighlighted)
+		end
+	end
+
+	return create("ImageButton")({
+		Name = blockType.Name,
+		LayoutOrder = props.LayoutOrder,
+		Selectable = true,
+		BackgroundColor3 = function()
+			const state = guiState()
+			if isLocked() then
+				return Theme.TileLocked
+			elseif state == Enum.GuiState.Press then
+				return Theme.TilePressed
+			elseif state == Enum.GuiState.Hover then
+				return Theme.TileHover
+			end
+			return Theme.Tile
+		end,
+
+		Activated = onActivated,
+		MouseEnter = function()
+			setHighlighted(true)
+		end,
+		MouseLeave = function()
+			setHighlighted(false)
+		end,
+		SelectionGained = function()
+			setHighlighted(true)
+		end,
+		SelectionLost = function()
+			setHighlighted(false)
+		end,
+
+		changed("GuiState", guiState),
+		props.Built and action(function(instance)
+			(props.Built :: (ImageButton) -> ())(instance :: ImageButton)
+		end),
+
+		create("UICorner")({
+			CornerRadius = function()
+				return UDim.new(0, metrics().TileCornerRadius)
+			end,
+		}),
+		create("UIStroke")({
+			Color = Theme.Accent,
+			Thickness = PICKED_STROKE,
+			BorderStrokePosition = Enum.BorderStrokePosition.Inner,
+			Enabled = isPicked,
+		}),
+
+		create("Frame")({
+			Name = "Face",
+			BackgroundTransparency = 1,
+			Size = UDim2.fromScale(1, 1),
+			Position = function()
+				return UDim2.fromOffset(math.round(shakeOffset()), math.round(sink()))
+			end,
+
+			create("Frame")({
+				Name = "Swatch",
+				AnchorPoint = Vector2.new(0.5, 0),
+				Position = function()
+					return UDim2.new(0.5, 0, 0, metrics().SwatchTop)
+				end,
+				Size = function()
+					const size = metrics().SwatchSize
+					return UDim2.fromOffset(size, size)
+				end,
+				BackgroundColor3 = blockType.Color,
+				BackgroundTransparency = blockType.Transparency * 0.5,
+
+				create("UICorner")({ CornerRadius = UDim.new(0.18, 0) }),
+				create("UIStroke")({
+					Color = blockType.Color:Lerp(Color3.new(0, 0, 0), 0.45),
+					Thickness = SWATCH_STROKE,
+					BorderStrokePosition = Enum.BorderStrokePosition.Inner,
+				}),
+
+				create("Frame")({
+					Name = "LockShade",
+					BackgroundColor3 = Theme.LockShade,
+					BackgroundTransparency = 0.3,
+					Size = UDim2.fromScale(1, 1),
+					Visible = isLocked,
+
+					create("UICorner")({ CornerRadius = UDim.new(0.18, 0) }),
+					LockIcon({
+						Size = function()
+							return metrics().LockSize
+						end,
+					}),
+				}),
+
+				create("TextLabel")({
+					Name = "Count",
+					BackgroundTransparency = 1,
+					AnchorPoint = Vector2.new(1, 1),
+					Position = UDim2.new(1, 8, 1, 6),
+					AutomaticSize = Enum.AutomaticSize.XY,
+					Size = function()
+						return UDim2.fromOffset(0, metrics().CountTextSize)
+					end,
+					Font = Theme.Font,
+					TextSize = function()
+						return metrics().CountTextSize
+					end,
+					TextColor3 = function()
+						return if read(props.Count) > 0 then Theme.Text else Theme.TextDim
+					end,
+					TextStrokeColor3 = Theme.TextOutline,
+					TextStrokeTransparency = 0,
+					Text = function()
+						return `x{formatCount(read(props.Count))}`
+					end,
+					Visible = function()
+						return not isLocked()
+					end,
+				}),
+
+				create("TextLabel")({
+					Name = "UnlockLevel",
+					BackgroundColor3 = Theme.LockShade,
+					AnchorPoint = Vector2.new(1, 1),
+					Position = UDim2.new(1, 10, 1, 8),
+					AutomaticSize = Enum.AutomaticSize.XY,
+					Size = function()
+						return UDim2.fromOffset(0, metrics().BadgeTextSize)
+					end,
+					Font = Theme.Font,
+					TextSize = function()
+						return metrics().BadgeTextSize
+					end,
+					TextColor3 = Theme.Text,
+					Text = function()
+						return `Lv {read(props.UnlockLevel)}`
+					end,
+					Visible = isLocked,
+					ZIndex = 2,
+
+					create("UICorner")({ CornerRadius = UDim.new(0, 6) }),
+					create("UIPadding")({
+						PaddingLeft = UDim.new(0, BADGE_PADDING),
+						PaddingRight = UDim.new(0, BADGE_PADDING),
+						PaddingTop = UDim.new(0, 2),
+						PaddingBottom = UDim.new(0, 2),
+					}),
+				}),
+			}),
+
+			create("TextLabel")({
+				Name = "BlockName",
+				BackgroundTransparency = 1,
+				Position = function()
+					const sizes = metrics()
+					return UDim2.fromOffset(4, sizes.SwatchTop + sizes.SwatchSize + 6)
+				end,
+				Size = function()
+					return UDim2.new(1, -8, 0, metrics().NameTextSize + 6)
+				end,
+				Font = Theme.Font,
+				TextSize = function()
+					return metrics().NameTextSize
+				end,
+				TextColor3 = function()
+					return if isLocked() then Theme.TextDim else Theme.Text
+				end,
+				TextTruncate = Enum.TextTruncate.AtEnd,
+				Text = blockType.DisplayName,
+			}),
+
+			create("TextLabel")({
+				Name = "Key",
+				BackgroundColor3 = Theme.LockShade,
+				BackgroundTransparency = 0.2,
+				Position = UDim2.fromOffset(BADGE_PADDING, BADGE_PADDING),
+				Size = function()
+					const size = metrics().BadgeTextSize + 6
+					return UDim2.fromOffset(size, size)
+				end,
+				Font = Theme.Font,
+				TextSize = function()
+					return metrics().BadgeTextSize
+				end,
+				TextColor3 = Theme.Text,
+				Text = function()
+					return keyLabel() or ""
+				end,
+				Visible = function()
+					return keyLabel() ~= nil
+				end,
+
+				create("UICorner")({ CornerRadius = UDim.new(0, 6) }),
+			}),
+		}),
+
+		create("TextLabel")({
+			Name = "PickedTag",
+			BackgroundColor3 = Theme.Accent,
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0),
+			AutomaticSize = Enum.AutomaticSize.XY,
+			Size = function()
+				return UDim2.fromOffset(0, metrics().BadgeTextSize)
+			end,
+			Font = Theme.Font,
+			TextSize = function()
+				return metrics().BadgeTextSize
+			end,
+			TextColor3 = Theme.AccentText,
+			Text = "Picked",
+			Visible = isPicked,
+			ZIndex = 2,
+
+			create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+			create("UIPadding")({
+				PaddingLeft = UDim.new(0, BADGE_PADDING + 2),
+				PaddingRight = UDim.new(0, BADGE_PADDING + 2),
+				PaddingTop = UDim.new(0, 1),
+				PaddingBottom = UDim.new(0, 1),
+			}),
+		}),
+	})
+end
+
+return blockTile
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlocksButton.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlocksButton.luau
new file mode 100644
index 0000000..9eb1929
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlocksButton.luau
@@ -0,0 +1,175 @@
+--!strict
+--[[
+	The HUD button that opens the inventory screen. It shows the block the
+	player is building with and how many they have, so the HUD answers "what
+	am I placing?" without opening anything, and the key or gamepad button
+	that opens it for the current input.
+]]
+
+const UserInputService = game:GetService("UserInputService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const Theme = require("../Theme")
+const formatCount = require("../formatCount")
+
+const changed = Vide.changed
+const create = Vide.create
+const read = Vide.read
+const source = Vide.source
+const spring = Vide.spring
+const switch = Vide.switch
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const Screen = require("../Screen")
+
+type BlockType = BlockTypes.BlockType
+type Input = Screen.Input
+
+const BUTTON_SIZE = Vector2.new(88, 92)
+const SWATCH_SIZE = 46
+const LABEL_TEXT_SIZE = 20
+const COUNT_TEXT_SIZE = 18
+const HINT_SIZE = 28
+const PRESS_SINK = 3
+const BACKGROUND_TRANSPARENCY = 0.15
+
+export type BlocksButtonProps = {
+	BlockType: BlockType | () -> BlockType,
+	Count: number | () -> number,
+	Input: Input | () -> Input,
+	BackgroundTransparency: ((base: number) -> number)?,
+	Activated: () -> (),
+}
+
+local function blocksButton(props: BlocksButtonProps): TextButton
+	const guiState = source(Enum.GuiState.Idle)
+	const sink = spring(function()
+		return if guiState() == Enum.GuiState.Press then PRESS_SINK else 0
+	end, 0.12, 0.6)
+
+	local function blockType(): BlockType
+		return read(props.BlockType)
+	end
+
+	return create("TextButton")({
+		Name = "BlocksButton",
+		AnchorPoint = Vector2.new(1, 0),
+		Position = UDim2.new(1, -16, 0, 16),
+		Size = UDim2.fromOffset(BUTTON_SIZE.X, BUTTON_SIZE.Y),
+		Selectable = true,
+		BackgroundColor3 = function()
+			return if guiState() == Enum.GuiState.Idle then Theme.Panel else Theme.TileHover
+		end,
+		BackgroundTransparency = function()
+			const base = BACKGROUND_TRANSPARENCY
+			return if props.BackgroundTransparency then props.BackgroundTransparency(base) else base
+		end,
+		Text = "",
+		Activated = props.Activated,
+
+		changed("GuiState", guiState),
+		create("UICorner")({ CornerRadius = UDim.new(0, 16) }),
+		create("UIStroke")({
+			Color = Theme.Text,
+			Thickness = 2,
+			Transparency = 0.6,
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			BorderStrokePosition = Enum.BorderStrokePosition.Inner,
+		}),
+
+		create("Frame")({
+			Name = "Face",
+			BackgroundTransparency = 1,
+			Size = UDim2.fromScale(1, 1),
+			Position = function()
+				return UDim2.fromOffset(0, math.round(sink()))
+			end,
+
+			create("Frame")({
+				Name = "Swatch",
+				AnchorPoint = Vector2.new(0.5, 0),
+				Position = UDim2.new(0.5, 0, 0, 10),
+				Size = UDim2.fromOffset(SWATCH_SIZE, SWATCH_SIZE),
+				BackgroundColor3 = function()
+					return blockType().Color
+				end,
+
+				create("UICorner")({ CornerRadius = UDim.new(0.18, 0) }),
+				create("UIStroke")({
+					Color = function()
+						return blockType().Color:Lerp(Color3.new(0, 0, 0), 0.45)
+					end,
+					Thickness = 2,
+					BorderStrokePosition = Enum.BorderStrokePosition.Inner,
+				}),
+
+				create("TextLabel")({
+					Name = "Count",
+					BackgroundTransparency = 1,
+					AnchorPoint = Vector2.new(1, 1),
+					Position = UDim2.new(1, 10, 1, 6),
+					AutomaticSize = Enum.AutomaticSize.XY,
+					Size = UDim2.fromOffset(0, COUNT_TEXT_SIZE),
+					Font = Theme.Font,
+					TextSize = COUNT_TEXT_SIZE,
+					TextColor3 = Theme.Text,
+					TextStrokeColor3 = Theme.TextOutline,
+					TextStrokeTransparency = 0,
+					Text = function()
+						return `x{formatCount(read(props.Count))}`
+					end,
+				}),
+			}),
+
+			create("TextLabel")({
+				Name = "Label",
+				BackgroundTransparency = 1,
+				AnchorPoint = Vector2.new(0.5, 1),
+				Position = UDim2.new(0.5, 0, 1, -8),
+				Size = UDim2.new(1, -8, 0, LABEL_TEXT_SIZE + 4),
+				Font = Theme.Font,
+				TextSize = LABEL_TEXT_SIZE,
+				TextColor3 = Theme.Text,
+				Text = "Blocks",
+			}),
+		}),
+
+		create("Frame")({
+			Name = "Hint",
+			BackgroundTransparency = 1,
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromOffset(4, 4),
+			Size = UDim2.fromOffset(HINT_SIZE, HINT_SIZE),
+			ZIndex = 2,
+
+			switch(function()
+				return read(props.Input)
+			end)({
+				KeyboardAndMouse = function(): GuiObject
+					return create("TextLabel")({
+						BackgroundColor3 = Theme.Tile,
+						Size = UDim2.fromScale(1, 1),
+						Font = Theme.Font,
+						TextSize = 18,
+						TextColor3 = Theme.Text,
+						Text = "B",
+
+						create("UICorner")({ CornerRadius = UDim.new(0, 6) }),
+						create("UIStroke")({ Color = Theme.Text, Thickness = 1 }),
+					})
+				end,
+				Gamepad = function(): GuiObject
+					return create("ImageLabel")({
+						BackgroundTransparency = 1,
+						Size = UDim2.fromScale(1, 1),
+						Image = UserInputService:GetImageForKeyCode(Enum.KeyCode.ButtonY),
+						ScaleType = Enum.ScaleType.Fit,
+					})
+				end,
+			}),
+		}),
+	})
+end
+
+return blocksButton
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryMetrics.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryMetrics.luau
new file mode 100644
index 0000000..f950b68
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryMetrics.luau
@@ -0,0 +1,100 @@
+--!strict
+--[[
+	Sizes for the inventory panel's two layouts, in UI units (authored for a
+	screen 1080 tall). Regular fits tablets, PCs, and TVs; Compact fits a
+	phone held sideways (about 667 by 317 below the topbar) at full size.
+]]
+
+export type Metrics = {
+	Columns: number,
+	Padding: number,
+	Gap: number,
+	CornerRadius: number,
+	TitleHeight: number,
+	TitleTextSize: number,
+	CloseSize: number,
+	TileSize: Vector2,
+	TileCornerRadius: number,
+	SwatchSize: number,
+	SwatchTop: number,
+	NameTextSize: number,
+	CountTextSize: number,
+	BadgeTextSize: number,
+	LockSize: number,
+	DetailHeight: number,
+	DetailTitleTextSize: number,
+	DetailBodyTextSize: number,
+	HintTextSize: number,
+	HintGlyphSize: number,
+}
+
+const REGULAR: Metrics = table.freeze({
+	Columns = 5,
+	Padding = 20,
+	Gap = 12,
+	CornerRadius = 20,
+	TitleHeight = 56,
+	TitleTextSize = 36,
+	CloseSize = 56,
+	TileSize = Vector2.new(120, 140),
+	TileCornerRadius = 14,
+	SwatchSize = 76,
+	SwatchTop = 16,
+	NameTextSize = 24,
+	CountTextSize = 22,
+	BadgeTextSize = 16,
+	LockSize = 36,
+	DetailHeight = 72,
+	DetailTitleTextSize = 26,
+	DetailBodyTextSize = 22,
+	HintTextSize = 20,
+	HintGlyphSize = 32,
+})
+
+const COMPACT: Metrics = table.freeze({
+	Columns = 5,
+	Padding = 10,
+	Gap = 8,
+	CornerRadius = 14,
+	TitleHeight = 44,
+	TitleTextSize = 28,
+	CloseSize = 44,
+	TileSize = Vector2.new(98, 86),
+	TileCornerRadius = 10,
+	SwatchSize = 46,
+	SwatchTop = 8,
+	NameTextSize = 18,
+	CountTextSize = 18,
+	BadgeTextSize = 14,
+	LockSize = 24,
+	DetailHeight = 46,
+	DetailTitleTextSize = 20,
+	DetailBodyTextSize = 18,
+	HintTextSize = 16,
+	HintGlyphSize = 26,
+})
+
+local Module = {
+	Regular = REGULAR,
+	Compact = COMPACT,
+}
+
+--[[
+	The panel's full size for the given layout and number of block types.
+]]
+function Module.panelSize(metrics: Metrics, blockCount: number): Vector2
+	const rows = math.ceil(blockCount / metrics.Columns)
+	const gridWidth = metrics.Columns * metrics.TileSize.X + (metrics.Columns - 1) * metrics.Gap
+	const gridHeight = rows * metrics.TileSize.Y + (rows - 1) * metrics.Gap
+	return Vector2.new(
+		metrics.Padding * 2 + gridWidth,
+		metrics.Padding * 2
+			+ metrics.TitleHeight
+			+ metrics.Gap
+			+ gridHeight
+			+ metrics.Gap
+			+ metrics.DetailHeight
+	)
+end
+
+return table.freeze(Module)
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryPanel.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryPanel.luau
new file mode 100644
index 0000000..1f731e3
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryPanel.luau
@@ -0,0 +1,539 @@
+--!strict
+--[[
+	The inventory screen's panel: a title row with the player's level and a
+	close button, a grid with every block type, and a detail strip that
+	explains the hovered, focused, or last tapped block in words. Hover only
+	previews what a tap or gamepad focus also shows.
+]]
+
+const UserInputService = game:GetService("UserInputService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockTile = require("./BlockTile")
+const InventoryMetrics = require("./InventoryMetrics")
+const LockIcon = require("./LockIcon")
+const Theme = require("../Theme")
+const formatCount = require("../formatCount")
+
+const changed = Vide.changed
+const create = Vide.create
+const derive = Vide.derive
+const read = Vide.read
+const show = Vide.show
+const source = Vide.source
+const switch = Vide.switch
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const Screen = require("../Screen")
+
+type BlockType = BlockTypes.BlockType
+type Input = Screen.Input
+type Metrics = InventoryMetrics.Metrics
+
+const PANEL_TRANSPARENCY = 0.04
+const DETAIL_TRANSPARENCY = 0.2
+const CLOSE_PRESS_SINK = 2
+const KEY_LABELS = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" }
+
+export type InventoryPanelProps = {
+	Blocks: { BlockType },
+	Count: (name: string) -> number,
+	IsUnlocked: (name: string) -> boolean,
+	UnlockLevel: (name: string) -> number,
+	PickedName: string | () -> string,
+	Level: number | () -> number,
+	Input: Input | () -> Input,
+	IsCompact: boolean | () -> boolean,
+	IsReducedMotion: (boolean | () -> boolean)?,
+	-- Maps a design background transparency to the one to draw, for the
+	-- player's Background Transparency setting.
+	BackgroundTransparency: ((base: number) -> number)?,
+	Pick: (name: string) -> (),
+	Close: () -> (),
+	TileBuilt: ((name: string, tile: ImageButton) -> ())?,
+}
+
+local function statusText(props: InventoryPanelProps, blockType: BlockType, input: Input): string
+	const name = blockType.Name
+	if not props.IsUnlocked(name) then
+		return `Unlocks at level {props.UnlockLevel(name)}.`
+	end
+
+	const isPicked = read(props.PickedName) == name
+	const count = props.Count(name)
+	if isPicked and count == 0 then
+		return "Picked. Collect some to build!"
+	elseif isPicked then
+		return "You are building with this."
+	elseif count == 0 then
+		return "You have none. Collect some!"
+	elseif input == "Touch" then
+		return "Tap to build with it."
+	elseif input == "Gamepad" then
+		return "Press A to build with it."
+	end
+	return "Click to build with it."
+end
+
+local function hint(metrics: () -> Metrics, keyContent: Instance, text: string, order: number)
+	return create("Frame")({
+		Name = text,
+		BackgroundTransparency = 1,
+		AutomaticSize = Enum.AutomaticSize.X,
+		Size = function()
+			return UDim2.fromOffset(0, metrics().HintGlyphSize)
+		end,
+		LayoutOrder = order,
+
+		create("UIListLayout")({
+			FillDirection = Enum.FillDirection.Horizontal,
+			VerticalAlignment = Enum.VerticalAlignment.Center,
+			Padding = UDim.new(0, 6),
+		}),
+		keyContent,
+		create("TextLabel")({
+			BackgroundTransparency = 1,
+			AutomaticSize = Enum.AutomaticSize.X,
+			Size = function()
+				return UDim2.fromOffset(0, metrics().HintGlyphSize)
+			end,
+			LayoutOrder = 2,
+			Font = Theme.Font,
+			TextSize = function()
+				return metrics().HintTextSize
+			end,
+			TextColor3 = Theme.TextDim,
+			Text = text,
+		}),
+	})
+end
+
+local function hintRow(hints: { Frame }): Frame
+	return create("Frame")({
+		Name = "HintRow",
+		BackgroundTransparency = 1,
+		Size = UDim2.fromScale(1, 1),
+
+		create("UIListLayout")({
+			FillDirection = Enum.FillDirection.Horizontal,
+			HorizontalAlignment = Enum.HorizontalAlignment.Right,
+			VerticalAlignment = Enum.VerticalAlignment.Center,
+			Padding = UDim.new(0, 16),
+		}),
+		hints,
+	})
+end
+
+local function keyGlyph(metrics: () -> Metrics, keyCode: Enum.KeyCode)
+	return create("ImageLabel")({
+		BackgroundTransparency = 1,
+		Size = function()
+			const size = metrics().HintGlyphSize
+			return UDim2.fromOffset(size, size)
+		end,
+		LayoutOrder = 1,
+		Image = UserInputService:GetImageForKeyCode(keyCode),
+		ScaleType = Enum.ScaleType.Fit,
+	})
+end
+
+local function keyCap(metrics: () -> Metrics, text: string)
+	return create("TextLabel")({
+		BackgroundColor3 = Theme.Tile,
+		AutomaticSize = Enum.AutomaticSize.X,
+		Size = function()
+			return UDim2.fromOffset(metrics().HintGlyphSize, metrics().HintGlyphSize)
+		end,
+		LayoutOrder = 1,
+		Font = Theme.Font,
+		TextSize = function()
+			return metrics().HintTextSize
+		end,
+		TextColor3 = Theme.Text,
+		Text = text,
+
+		create("UICorner")({ CornerRadius = UDim.new(0, 6) }),
+		create("UIPadding")({
+			PaddingLeft = UDim.new(0, 8),
+			PaddingRight = UDim.new(0, 8),
+		}),
+	})
+end
+
+local function inventoryPanel(props: InventoryPanelProps): Frame
+	const metrics = derive(function(): Metrics
+		return if read(props.IsCompact) then InventoryMetrics.Compact else InventoryMetrics.Regular
+	end)
+	local function input(): Input
+		return read(props.Input)
+	end
+	local function transparency(base: number): number
+		return if props.BackgroundTransparency then props.BackgroundTransparency(base) else base
+	end
+
+	const highlightedName = source(nil :: string?)
+	const tappedName = source(nil :: string?)
+	const closeState = source(Enum.GuiState.Idle)
+
+	const blocksByName: { [string]: BlockType? } = {}
+	for _, blockType in props.Blocks do
+		blocksByName[blockType.Name] = blockType
+	end
+
+	const detailBlock = derive(function(): BlockType
+		const name = highlightedName() or tappedName() or read(props.PickedName)
+		return blocksByName[name] or props.Blocks[1]
+	end)
+
+	local function panelSize(): Vector2
+		return InventoryMetrics.panelSize(metrics(), #props.Blocks)
+	end
+
+	const tiles = {}
+	for index, blockType in props.Blocks do
+		const name = blockType.Name
+		table.insert(
+			tiles,
+			BlockTile({
+				BlockType = blockType,
+				LayoutOrder = index,
+				Count = function()
+					return props.Count(name)
+				end,
+				IsLocked = function()
+					return not props.IsUnlocked(name)
+				end,
+				UnlockLevel = function()
+					return props.UnlockLevel(name)
+				end,
+				IsPicked = function()
+					return read(props.PickedName) == name
+				end,
+				KeyLabel = function()
+					return if input() == "KeyboardAndMouse" then KEY_LABELS[index] else nil
+				end,
+				Metrics = metrics,
