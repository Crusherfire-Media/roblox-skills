+						return `{blockType.DisplayName}  x{formatCount(props.Count(blockType.Name))}`
+					end,
+				}),
+
+				create("TextLabel")({
+					Name = "Status",
+					BackgroundTransparency = 1,
+					Size = function()
+						return UDim2.new(1, 0, 0, metrics().DetailBodyTextSize + 2)
+					end,
+					LayoutOrder = 2,
+					Font = Theme.BodyFont,
+					TextSize = function()
+						return metrics().DetailBodyTextSize
+					end,
+					TextColor3 = Theme.TextDim,
+					TextXAlignment = Enum.TextXAlignment.Left,
+					TextWrapped = true,
+					AutomaticSize = Enum.AutomaticSize.Y,
+					Text = function()
+						return statusText(props, detailBlock(), input())
+					end,
+				}),
+			}),
+
+			create("Frame")({
+				Name = "Hints",
+				BackgroundTransparency = 1,
+				AnchorPoint = Vector2.new(1, 0.5),
+				Position = UDim2.fromScale(1, 0.5),
+				Size = UDim2.fromScale(0.36, 1),
+
+				switch(input)({
+					Gamepad = function()
+						return hintRow({
