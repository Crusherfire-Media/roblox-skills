+					end
+				end,
+				Built = if props.TileBuilt
+					then function(tile: ImageButton)
+						(props.TileBuilt :: (string, ImageButton) -> ())(name, tile)
+					end
+					else nil,
+			})
+		)
+	end
+
+	return create("Frame")({
