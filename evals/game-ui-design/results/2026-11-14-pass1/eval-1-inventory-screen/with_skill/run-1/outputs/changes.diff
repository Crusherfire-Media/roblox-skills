+--!strict
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+const BlocksButton = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/BlocksButton")
+
+const create = Vide.create
+
+local function blockNames(): { string }
+	const names = {}
+	for _, blockType in BlockTypes.List do
+		table.insert(names, blockType.Name)
+	end
+	return names
+end
+
+const CONTROLS = {
+	Block = UILabs.Ordered(UILabs.Choose(blockNames()), 1),
+	Count = UILabs.Ordered(UILabs.Slider(48, 0, 2_000_000, 1), 2),
+	Input = UILabs.Ordered(UILabs.Choose({ "Touch", "KeyboardAndMouse", "Gamepad" }), 3),
+}
+
+type StoryProps = {
+	controls: {
+		Block: () -> string,
+		Count: () -> number,
+		Input: () -> any,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const controls = props.controls
+
+	return create("Frame")({
+		BackgroundColor3 = Color3.fromRGB(90, 120, 90),
+		Size = UDim2.fromScale(1, 1),
+
+		BlocksButton({
+			BlockType = function()
+				return BlockTypes.ByName[controls.Block()] or BlockTypes.List[1]
+			end,
+			Count = controls.Count,
+			Input = controls.Input,
+			Activated = function()
+				print("Blocks button pressed")
+			end,
+		}),
+	})
+end
+
+return {
+	summary = "The HUD button that opens the block inventory, with the open key for each input.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
diff --git a/src/ServerScriptService/Stories/Inventory/InventoryPanel.story.luau b/src/ServerScriptService/Stories/Inventory/InventoryPanel.story.luau
new file mode 100644
index 0000000..af54ef3
--- /dev/null
+++ b/src/ServerScriptService/Stories/Inventory/InventoryPanel.story.luau
@@ -0,0 +1,120 @@
+--!strict
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+const InventoryPanel =
+	require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryPanel")
+
+const create = Vide.create
+const source = Vide.source
+
+-- Every third block type locks, at levels 4, 7, and 10.
+const UNLOCK_STEP = 3
+
+const CONTROLS = {
+	Player = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Level = UILabs.Ordered(UILabs.Slider(3, 1, 12, 1), 1),
+			IsEmpty = UILabs.Ordered(false, 2),
+			-- Shows five-digit and larger counts in the corners.
+			HasHugeCounts = UILabs.Ordered(false, 3),
+		}),
+		1
+	),
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsCompact = UILabs.Ordered(false, 1),
+			Input = UILabs.Ordered(UILabs.Choose({ "Touch", "KeyboardAndMouse", "Gamepad" }), 2),
+		}),
+		2
+	),
+	Preview = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsReducedMotion = UILabs.Ordered(false, 1),
+		}),
+		3
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Player: {
+			Level: () -> number,
+			IsEmpty: () -> boolean,
+			HasHugeCounts: () -> boolean,
+		},
+		Layout: {
+			IsCompact: () -> boolean,
+			Input: () -> any,
+		},
+		Preview: {
+			IsReducedMotion: () -> boolean,
+		},
+	},
+	target: Frame,
+}
+
+local function unlockLevel(name: string): number
+	const index = table.find(BlockTypes.List, BlockTypes.ByName[name]) or 1
+	return if index % UNLOCK_STEP == 0 then index + 1 else 1
+end
+
+local function story(props: StoryProps)
+	const player = props.controls.Player
+	const layout = props.controls.Layout
+	const pickedName = source(BlockTypes.List[1].Name)
+
+	local function count(name: string): number
+		if player.IsEmpty() then
+			return 0
+		end
+		const index = table.find(BlockTypes.List, BlockTypes.ByName[name]) or 1
+		const base = if player.HasHugeCounts() then 12_345 * index else index * 11
+		return if index == 4 then 0 else base
+	end
+
+	local function isUnlocked(name: string): boolean
+		return player.Level() >= unlockLevel(name)
+	end
+
+	return create("Frame")({
+		BackgroundColor3 = Color3.fromRGB(90, 120, 90),
+		Size = UDim2.fromScale(1, 1),
+
+		create("Frame")({
+			BackgroundTransparency = 1,
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0.5),
+			AutomaticSize = Enum.AutomaticSize.XY,
+
+			InventoryPanel({
+				Blocks = BlockTypes.List,
+				Count = count,
+				IsUnlocked = isUnlocked,
+				UnlockLevel = unlockLevel,
+				PickedName = pickedName,
+				Level = player.Level,
+				Input = layout.Input,
+				IsCompact = layout.IsCompact,
+				IsReducedMotion = props.controls.Preview.IsReducedMotion,
+				Pick = function(name: string)
+					pickedName(name)
+				end,
+				Close = function()
+					print("Close pressed")
+				end,
+			}),
+		}),
+	})
+end
+
+return {
+	summary = "The block inventory panel: picked, locked, empty, and huge-count tiles, "
+		.. "in the regular and phone layouts, with hints for each input.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
