diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/BlockPreview.luau b/src/StarterPlayer/StarterPlayerScripts/UI/BlockPreview.luau
new file mode 100644
index 0000000..a4d1a13
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/BlockPreview.luau
@@ -0,0 +1,65 @@
+--[[
+	A small 3D cube of a block type, so players see its material (brick, glass, grass) and not only
+	its color.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local Props = require(script.Parent.Props)
+
+local create = Vide.create
+
+type BlockType = BlockTypes.BlockType
+
+local CAMERA_POSITION = Vector3.new(3.1, 2.5, 3.1)
+
+local function BlockPreview(props: {
+	blockType: () -> BlockType,
+	dimmed: (() -> boolean)?,
+	[any]: any,
+})
+	local dimmed = props.dimmed or function()
+		return false
+	end
+
+	local camera = create("Camera")({
+		FieldOfView = 40,
+		CFrame = CFrame.lookAt(CAMERA_POSITION, Vector3.zero),
+	})
+
+	return create("ViewportFrame")(Props.merge({
+		BackgroundTransparency = 1,
+		CurrentCamera = camera,
+		Ambient = Color3.fromRGB(160, 160, 170),
+		LightColor = Color3.fromRGB(255, 255, 255),
+		LightDirection = Vector3.new(-1, -2, -0.5),
+		ImageColor3 = function()
+			return if dimmed() then Color3.fromRGB(90, 90, 100) else Color3.new(1, 1, 1)
+		end,
+		ImageTransparency = function()
+			return if dimmed() then 0.35 else 0
+		end,
+
+		camera,
+		create("Part")({
+			Anchored = true,
+			Size = Vector3.one * 2,
+			CFrame = CFrame.new(),
+			Color = function()
+				return props.blockType().Color
+			end,
+			Material = function()
+				return props.blockType().Material
+			end,
+			-- Keep see-through blocks visible against the dark panel.
+			Transparency = function()
+				return math.min(props.blockType().Transparency, 0.35)
+			end,
+		}),
+	}, props, { "blockType", "dimmed" }))
+end
+
+return BlockPreview
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/BlockTile.luau b/src/StarterPlayer/StarterPlayerScripts/UI/BlockTile.luau
new file mode 100644
index 0000000..6a3649a
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/BlockTile.luau
@@ -0,0 +1,213 @@
+--[[
+	One block type in the inventory grid: a 3D preview, its name, and how many the player has, or a
+	padlock and the level that unlocks it. The whole tile is one button, so a tap, a click, or the
+	controller's A button on it all pick the block. The grid layout sizes it.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local BlockPreview = require(script.Parent.BlockPreview)
+local InputHint = require(script.Parent.InputHint)
+local InventoryState = require(script.Parent.InventoryState)
+local Motion = require(script.Parent.Motion)
+local Theme = require(script.Parent.Theme)
+
+local create = Vide.create
+local source = Vide.source
+local derive = Vide.derive
+
+type BlockType = BlockTypes.BlockType
+
+-- Keys BlockPlacer already maps to the hotbar slots, shown on the tile as a shortcut.
+local SLOT_KEYS = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" }
+local MAX_SHOWN_COUNT = 999
+
+local function formatCount(count: number): string
+	if count > MAX_SHOWN_COUNT then
+		return `×{MAX_SHOWN_COUNT}+`
+	end
+	return `×{count}`
+end
+
+local function BlockTile(props: {
+	blockType: BlockType,
+	layoutOrder: number,
+	onButton: (TextButton) -> (),
+})
+	local name = props.blockType.Name
+	local hovered = source(false)
+	local gamepadFocused = source(false)
+
+	local unlocked = derive(function()
+		return InventoryState.isUnlocked(name, InventoryState.inventory())
+	end)
+	local count = derive(function()
+		return InventoryState.inventory().counts[name] or 0
+	end)
+	local isSelected = derive(function()
+		return InventoryState.selected() == name
+	end)
+	local focused = derive(function()
+		return hovered() or gamepadFocused()
+	end)
+	local scale = Motion.spring(function()
+		return if focused() then 1.06 else 1
+	end, 0.18)
+
+	local statusText = derive(function()
+		if not unlocked() then
+			return `🔒 Level {InventoryState.getUnlockLevel(name)}`
+		end
+		return formatCount(count())
+	end)
+
+	local button = create("TextButton")({
+		Name = name,
+		LayoutOrder = props.layoutOrder,
+		Text = "",
+		AutoButtonColor = false,
+		Selectable = true,
+		BackgroundColor3 = function()
+			return if unlocked() then Theme.Tile else Theme.TileLocked
+		end,
+		-- Our own focus ring replaces the default controller selection box.
+		SelectionImageObject = create("Frame")({ BackgroundTransparency = 1 }),
+
+		Activated = function()
+			InventoryState.choose(name)
+		end,
+		MouseEnter = function()
+			hovered(true)
+		end,
+		MouseLeave = function()
+			hovered(false)
+		end,
+		SelectionGained = function()
+			gamepadFocused(true)
+		end,
+		SelectionLost = function()
+			gamepadFocused(false)
+		end,
+
+		create("UICorner")({ CornerRadius = Theme.Corner }),
+		create("UIScale")({ Scale = scale }),
+		create("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			Color = function()
+				if isSelected() then
+					return Theme.Selected
+				elseif focused() then
+					return Theme.Focus
+				end
+				return Theme.TileStroke
+			end,
+			Thickness = function()
+				return if isSelected() or focused() then 4 else 1.5
+			end,
+		}),
+		create("UIPadding")({
+			PaddingTop = UDim.new(0, 8),
+			PaddingBottom = UDim.new(0, 6),
+			PaddingLeft = UDim.new(0, 6),
+			PaddingRight = UDim.new(0, 6),
+		}),
+
+		BlockPreview({
+			blockType = function()
+				return props.blockType
+			end,
+			dimmed = function()
+				return not unlocked()
+			end,
+			Name = "Preview",
+			Size = UDim2.new(1, 0, 1, -42),
+
+			create("TextLabel")({
+				Name = "Padlock",
+				AnchorPoint = Vector2.new(0.5, 0.5),
+				Position = UDim2.fromScale(0.5, 0.5),
+				Size = UDim2.fromOffset(40, 40),
+				BackgroundTransparency = 1,
+				Text = "🔒",
+				TextSize = 34,
+				Visible = function()
+					return not unlocked()
+				end,
+			}),
+		}),
+
+		create("TextLabel")({
+			Name = "BlockName",
+			AnchorPoint = Vector2.new(0, 1),
+			Position = UDim2.new(0, 0, 1, -20),
+			Size = UDim2.new(1, 0, 0, 22),
+			BackgroundTransparency = 1,
+			FontFace = Theme.FontBold,
+			TextSize = 19,
+			TextTruncate = Enum.TextTruncate.AtEnd,
+			TextColor3 = function()
+				return if unlocked() then Theme.Text else Theme.TextDim
+			end,
+			Text = props.blockType.DisplayName,
+		}),
+
+		create("TextLabel")({
+			Name = "Status",
+			AnchorPoint = Vector2.new(0, 1),
+			Position = UDim2.fromScale(0, 1),
+			Size = UDim2.new(1, 0, 0, 20),
+			BackgroundTransparency = 1,
+			FontFace = Theme.FontBold,
+			TextSize = 17,
+			TextColor3 = function()
+				if not unlocked() then
+					return Theme.Warning
+				elseif count() == 0 then
+					return Theme.TextEmpty
+				end
+				return Theme.TextDim
+			end,
+			Text = statusText,
+		}),
+
+		create("Frame")({
+			Name = "SelectedBadge",
+			AnchorPoint = Vector2.new(1, 0),
+			Position = UDim2.new(1, 2, 0, -4),
+			Size = UDim2.fromOffset(28, 28),
+			BackgroundColor3 = Theme.Selected,
+			Visible = isSelected,
+
+			create("UICorner")({ CornerRadius = UDim.new(1, 0) }),
+			create("TextLabel")({
+				Size = UDim2.fromScale(1, 1),
+				BackgroundTransparency = 1,
+				FontFace = Theme.FontHeavy,
+				TextSize = 20,
+				TextColor3 = Theme.Chip,
+				Text = "✓",
+			}),
+		}),
+
+		-- Only on unlocked tiles: the hint shouldn't invite players to pick a block they can't use.
+		if SLOT_KEYS[props.layoutOrder]
+			then create("Frame")({
+				Name = "KeyHint",
+				Position = UDim2.fromOffset(-2, -4),
+				Size = UDim2.fromOffset(22, 22),
+				BackgroundTransparency = 1,
+				Visible = unlocked,
+
+				InputHint({ key = SLOT_KEYS[props.layoutOrder], size = 22 }),
+			})
+			else nil,
+	})
+
+	props.onButton(button)
+	return button
+end
+
+return BlockTile
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InputHint.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InputHint.luau
new file mode 100644
index 0000000..e715e1b
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InputHint.luau
@@ -0,0 +1,78 @@
+--[[
+	A small chip naming the key or controller button for an action: the key's letter while the
+	player uses keyboard and mouse, the platform's own button glyph (Xbox or PlayStation) while they
+	use a controller, and nothing on touch, where the thing itself is what you tap.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local UserInputService = game:GetService("UserInputService")
+
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local InventoryState = require(script.Parent.InventoryState)
+local Props = require(script.Parent.Props)
+local Theme = require(script.Parent.Theme)
+
+local create = Vide.create
+
+local function InputHint(props: {
+	key: string?,
+	button: Enum.KeyCode?,
+	size: number?,
+	[any]: any,
+})
+	local size = props.size or 24
+	-- Looked up again on each switch to the controller, which may be a different brand by then.
+	local glyph = Vide.derive(function()
+		if InventoryState.inputMode() == "Gamepad" and props.button then
+			return UserInputService:GetImageForKeyCode(props.button)
+		end
+		return ""
+	end)
+
+	local function mode()
+		local current = InventoryState.inputMode()
+		if current == "KeyboardMouse" and props.key then
+			return "Key"
+		elseif current == "Gamepad" and glyph() ~= "" then
+			return "Button"
+		end
+		return "None"
+	end
+
+	return create("Frame")(Props.merge({
+		Name = "InputHint",
+		Size = UDim2.fromOffset(size, size),
+		BackgroundColor3 = Theme.Chip,
+		BackgroundTransparency = function()
+			return if mode() == "Key" then 0.1 else 1
+		end,
+		Visible = function()
+			return mode() ~= "None"
+		end,
+
+		create("UICorner")({ CornerRadius = UDim.new(0, 6) }),
+		create("TextLabel")({
+			Size = UDim2.fromScale(1, 1),
+			BackgroundTransparency = 1,
+			FontFace = Theme.FontBold,
+			TextSize = math.floor(size * 0.7),
+			TextColor3 = Theme.Text,
+			Text = props.key or "",
+			Visible = function()
+				return mode() == "Key"
+			end,
+		}),
+		create("ImageLabel")({
+			Size = UDim2.fromScale(1, 1),
+			BackgroundTransparency = 1,
+			Image = glyph,
+			ScaleType = Enum.ScaleType.Fit,
+			Visible = function()
+				return mode() == "Button"
+			end,
+		}),
+	}, props, { "key", "button", "size" }))
+end
+
+return InputHint
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel.luau
new file mode 100644
index 0000000..47add29
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel.luau
@@ -0,0 +1,273 @@
+--[[
+	The inventory window: a header with the player's level and a close button, a scrolling grid of
+	every block type, and a footer that says how to pick a block on the current input device (or why
+	the last block couldn't be picked).
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local BlockTile = require(script.Parent.BlockTile)
+local InputHint = require(script.Parent.InputHint)
+local InventoryState = require(script.Parent.InventoryState)
+local Motion = require(script.Parent.Motion)
+local Theme = require(script.Parent.Theme)
+
+local create = Vide.create
+local derive = Vide.derive
+
+local HEADER_HEIGHT = 56
+local FOOTER_HEIGHT = 36
+local GRID_PADDING = 8
+local SCROLLBAR_WIDTH = 8
+-- Tile height as a multiple of its width.
+local TILE_ASPECT = 1.2
+
+local FOOTER_TEXT = {
+	Touch = "Tap a block to build with it",
+	KeyboardMouse = "Click a block to build with it  ·  E to close",
+	Gamepad = "",
+}
+
+local function FooterLabel(text: string, layoutOrder: number)
+	return create("TextLabel")({
+		LayoutOrder = layoutOrder,
+		AutomaticSize = Enum.AutomaticSize.X,
+		Size = UDim2.fromOffset(0, 28),
+		BackgroundTransparency = 1,
+		FontFace = Theme.FontBold,
+		TextSize = 18,
+		TextColor3 = Theme.TextDim,
+		Text = text,
+	})
+end
+
+local function InventoryPanel(
+	props: {
+		-- Size of the safe area of the screen, in pixels.
+		screenSize: () -> Vector2,
+		-- UIScale for the current screen; panel sizes below are in design units.
+		uiScale: () -> number,
+		onTileButton: (name: string, button: TextButton) -> (),
+	}
+)
+	local panelSize = derive(function()
+		local screen = props.screenSize() / props.uiScale()
+		return Vector2.new(
+			math.floor(math.min(screen.X * 0.94, Theme.MaxPanelSize.X)),
+			math.floor(math.min(screen.Y * 0.94, Theme.MaxPanelSize.Y))
+		)
+	end)
+
+	local cellSize = derive(function()
+		local gridWidth = panelSize().X - Theme.Padding * 2 - GRID_PADDING * 2 - SCROLLBAR_WIDTH
+		local columns = math.floor((gridWidth + Theme.Gap) / (Theme.MinTileWidth + Theme.Gap))
+		columns = math.clamp(columns, 2, Theme.MaxColumns)
+		local width = math.floor((gridWidth - (columns - 1) * Theme.Gap) / columns)
+		return UDim2.fromOffset(width, math.floor(width * TILE_ASPECT))
+	end)
+
+	local pop = Motion.spring(function()
+		return if InventoryState.isOpen() then 1 else 0.9
+	end, 0.22, 0.7)
+
+	local tiles = {}
+	for index, blockType in BlockTypes.List do
+		tiles[index] = BlockTile({
+			blockType = blockType,
+			layoutOrder = index,
+			onButton = function(button)
+				props.onTileButton(blockType.Name, button)
+			end,
+		})
+	end
+
+	local showGamepadHints = derive(function()
+		return InventoryState.inputMode() == "Gamepad" and InventoryState.message() == nil
+	end)
+
+	return create("Frame")({
+		Name = "Panel",
+		AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.5),
+		Size = function()
+			return UDim2.fromOffset(panelSize().X, panelSize().Y)
+		end,
+		BackgroundColor3 = Theme.Panel,
+		-- Swallows clicks so they don't fall through to the backdrop, which closes the screen.
+		Active = true,
+		Visible = InventoryState.isOpen,
+		-- Keep controller navigation inside the panel while it is open.
+		SelectionGroup = true,
+		SelectionBehaviorUp = Enum.SelectionBehavior.Stop,
+		SelectionBehaviorDown = Enum.SelectionBehavior.Stop,
+		SelectionBehaviorLeft = Enum.SelectionBehavior.Stop,
+		SelectionBehaviorRight = Enum.SelectionBehavior.Stop,
+
+		create("UIScale")({
+			Scale = function()
+				return props.uiScale() * pop()
+			end,
+		}),
+		create("UICorner")({ CornerRadius = UDim.new(0, 20) }),
+		create("UIStroke")({ Color = Theme.PanelStroke, Thickness = 2 }),
+
+		-- Header
+		create("Frame")({
+			Name = "Header",
+			Position = UDim2.fromOffset(Theme.Padding, Theme.Padding),
+			Size = UDim2.new(1, -Theme.Padding * 2, 0, HEADER_HEIGHT),
+			BackgroundTransparency = 1,
+
+			create("UIListLayout")({
+				FillDirection = Enum.FillDirection.Horizontal,
+				VerticalAlignment = Enum.VerticalAlignment.Center,
+				Padding = UDim.new(0, 12),
+			}),
+			create("TextLabel")({
+				Name = "Title",
+				LayoutOrder = 1,
+				AutomaticSize = Enum.AutomaticSize.X,
+				Size = UDim2.fromScale(0, 1),
+				BackgroundTransparency = 1,
+				FontFace = Theme.FontHeavy,
+				TextSize = 32,
+				TextColor3 = Theme.Text,
+				Text = "My Blocks",
+			}),
+			create("TextLabel")({
+				Name = "Level",
+				LayoutOrder = 2,
+				AutomaticSize = Enum.AutomaticSize.X,
+				Size = UDim2.fromOffset(0, 34),
+				BackgroundColor3 = Theme.Chip,
