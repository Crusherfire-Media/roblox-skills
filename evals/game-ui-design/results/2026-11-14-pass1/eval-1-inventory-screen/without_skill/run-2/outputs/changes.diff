index 0000000..83e47ab
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Theme.luau
@@ -0,0 +1,43 @@
+--[[
+	Colors, fonts and sizes shared by the inventory UI. Sizes are design units: each top-level
+	element carries a UIScale, so one unit is one point on a phone and grows on big screens.
+]]
+
+local Theme = table.freeze({
