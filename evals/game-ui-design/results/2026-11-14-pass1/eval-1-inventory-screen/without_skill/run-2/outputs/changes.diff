+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Motion.luau
@@ -0,0 +1,19 @@
+--[[
+	Springs that switch themselves off for players who turned on Reduced Motion in Roblox settings.
+]]
+
+local GuiService = game:GetService("GuiService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local Motion = {}
+
+function Motion.spring<T>(target: () -> T, period: number?, dampingRatio: number?): () -> T
+	if GuiService.ReducedMotionEnabled then
+		return target
+	end
+	return (Vide.spring(target, period or 0.2, dampingRatio or 0.75))
+end
+
+return Motion
