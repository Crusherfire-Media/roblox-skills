diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau
new file mode 100644
index 0000000..612ee5f
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau
@@ -0,0 +1,182 @@
+--[[
+	Mounts the inventory screen into PlayerGui and binds its keys and controller buttons. See
+	docs/inventory-screen.md for how it behaves on each input device.
+]]
+
+local ContextActionService = game:GetService("ContextActionService")
+local GuiService = game:GetService("GuiService")
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local UserInputService = game:GetService("UserInputService")
+
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local InventoryPanel = require(script.Parent.InventoryPanel)
+local InventoryState = require(script.Parent.InventoryState)
+local OpenButton = require(script.Parent.OpenButton)
+local Theme = require(script.Parent.Theme)
+
+local create = Vide.create
+local source = Vide.source
+local derive = Vide.derive
+local effect = Vide.effect
+
+local TOGGLE_ACTION = "InventoryToggle"
+local CLOSE_ACTION = "InventoryClose"
+local ACTION_PRIORITY = Enum.ContextActionPriority.High.Value
+
+local InventoryScreen = {}
+
+local function bindInput()
+	ContextActionService:BindActionAtPriority(TOGGLE_ACTION, function(_, inputState)
+		if inputState == Enum.UserInputState.Begin then
+			InventoryState.toggle()
+		end
+		return Enum.ContextActionResult.Sink
+	end, false, ACTION_PRIORITY, Enum.KeyCode.E, Enum.KeyCode.ButtonY)
+
+	-- B only means "close" while the screen is open, so it is bound only then.
+	effect(function()
+		if InventoryState.isOpen() then
+			ContextActionService:BindActionAtPriority(CLOSE_ACTION, function(_, inputState)
+				if inputState == Enum.UserInputState.Begin then
+					InventoryState.close()
+				end
+				return Enum.ContextActionResult.Sink
+			end, false, ACTION_PRIORITY, Enum.KeyCode.ButtonB)
+		else
+			ContextActionService:UnbindAction(CLOSE_ACTION)
+		end
+	end)
+
+	Vide.cleanup(function()
+		ContextActionService:UnbindAction(TOGGLE_ACTION)
+		ContextActionService:UnbindAction(CLOSE_ACTION)
+	end)
+end
+
+--[[
+	Controllers have no pointer, so while the screen is open on a controller something in it must
+	hold the selection: the tile of the block in use, so A on open re-picks it and the D-pad starts
+	from there. On close the selection is cleared, or A would keep pressing an invisible tile.
+]]
+local function manageGamepadSelection(screenGui: ScreenGui, tiles: { [string]: TextButton })
+	effect(function()
+		local isOpen = InventoryState.isOpen()
+		local usingGamepad = InventoryState.inputMode() == "Gamepad"
+		-- Deferred so the panel is already visible; hidden objects can't be selected.
+		task.defer(function()
+			local current = GuiService.SelectedObject
+			local ours = current ~= nil and current:IsDescendantOf(screenGui)
+			if isOpen and usingGamepad and not ours then
+				GuiService.SelectedObject = tiles[InventoryState.selected()]
+			elseif not isOpen and ours then
+				GuiService.SelectedObject = nil
+			end
+		end)
+	end)
+
+	-- Roblox's own controller navigation clears the selection on B. If it got the press before
+	-- our binding did, the player still meant "close". The input type is read fresh, not from
+	-- inputMode, so grabbing the mouse (which also drops the selection) doesn't close the screen.
+	local connection = GuiService:GetPropertyChangedSignal("SelectedObject"):Connect(function()
+		local lastInput = UserInputService:GetLastInputType()
+		if
+			GuiService.SelectedObject == nil
+			and InventoryState.isOpen()
+			and lastInput.Name:sub(1, 7) == "Gamepad"
+		then
+			InventoryState.close()
+		end
+	end)
+	Vide.cleanup(function()
+		connection:Disconnect()
+	end)
+end
+
+local function App(playerGui: PlayerGui)
+	local screenSize = source(Vector2.new(800, 450))
+	local uiScale = derive(function()
+		return math.clamp(screenSize().Y / Theme.ReferenceHeight, Theme.MinScale, Theme.MaxScale)
+	end)
+	local tiles: { [string]: TextButton } = {}
+
+	bindInput()
+
+	local backdrop = create("ScreenGui")({
+		Name = "InventoryBackdrop",
+		DisplayOrder = 10,
+		ScreenInsets = Enum.ScreenInsets.None,
+		ResetOnSpawn = false,
+		Enabled = InventoryState.isOpen,
+		Parent = playerGui,
+
+		create("TextButton")({
+			Name = "Backdrop",
+			Size = UDim2.fromScale(1, 1),
+			BackgroundColor3 = Theme.Backdrop,
+			BackgroundTransparency = Theme.BackdropTransparency,
+			Text = "",
+			Selectable = false,
+			-- Frees the mouse from first person and shift lock while the screen is open.
+			Modal = true,
+			Activated = InventoryState.close,
+		}),
+	})
+
+	local screen = create("ScreenGui")({
+		Name = "InventoryScreen",
+		DisplayOrder = 11,
+		-- Keeps the button and panel clear of notches, rounded corners and the Roblox top bar.
+		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
+		ResetOnSpawn = false,
+		Parent = playerGui,
+
+		Vide.changed("AbsoluteSize", screenSize),
+
+		OpenButton({ uiScale = uiScale }),
+		InventoryPanel({
+			screenSize = screenSize,
+			uiScale = uiScale,
+			onTileButton = function(name, button)
+				tiles[name] = button
+			end,
+		}),
+	}) :: ScreenGui
+
+	manageGamepadSelection(screen, tiles)
+
+	Vide.cleanup(function()
+		InventoryState.close()
+		backdrop:Destroy()
+		screen:Destroy()
+	end)
+end
+
+local current: (() -> ())? = nil
+
+--[[
+	Builds the screen and binds its input. Returns a function that removes it again. Calling it
+	while the screen is already up returns the same function.
+]]
+function InventoryScreen.start(): () -> ()
+	local existing = current
+	if existing then
+		return existing
+	end
+	InventoryState.start()
+	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui") :: PlayerGui
+	local stop = Vide.root(function()
+		App(playerGui)
+	end)
+	local function unmount()
+		if current == unmount then
+			current = nil
+			stop()
+		end
+	end
+	current = unmount
+	return unmount
+end
+
+return InventoryScreen
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryState.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryState.luau
new file mode 100644
index 0000000..aeb3fb4
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryState.luau
@@ -0,0 +1,168 @@
+--[[
+	Vide sources for the inventory screen, kept in step with BlockInventory and BlockPlacer, plus
+	the actions the screen performs (open, close, choose a block). Components read from here and
+	never talk to BlockInventory or BlockPlacer directly.
+]]
+
+local GuiService = game:GetService("GuiService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local UserInputService = game:GetService("UserInputService")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local BlockInventory = require(script.Parent.Parent.BlockInventory)
+local BlockPlacer = require(script.Parent.Parent.BlockPlacer)
+
+local source = Vide.source
+
+-- How long a "this block is locked" message stays up, in seconds.
+local MESSAGE_SECONDS = 2.5
+
+export type InputMode = "Touch" | "KeyboardMouse" | "Gamepad"
+
+export type Snapshot = {
+	level: number,
+	counts: { [string]: number },
+}
+
+local InventoryState = {}
+
+local function takeSnapshot(): Snapshot
+	local counts = {}
+	for _, blockType in BlockTypes.List do
+		counts[blockType.Name] = BlockInventory.getCount(blockType.Name)
+	end
+	return { level = BlockInventory.getLevel(), counts = counts }
+end
+
+local function inputModeFor(inputType: Enum.UserInputType): InputMode?
+	if inputType == Enum.UserInputType.Touch then
+		return "Touch"
+	elseif inputType.Name:sub(1, 7) == "Gamepad" then
+		return "Gamepad"
+	elseif
+		inputType == Enum.UserInputType.Keyboard
+		or inputType == Enum.UserInputType.TextInput
+		or inputType.Name:sub(1, 5) == "Mouse"
+	then
+		return "KeyboardMouse"
+	end
+	-- Focus, gyro and the like say nothing about how the player is playing.
+	return nil
+end
+
+local function initialInputMode(): InputMode
+	local fromLastInput = inputModeFor(UserInputService:GetLastInputType())
+	if fromLastInput then
+		return fromLastInput
+	elseif GuiService:IsTenFootInterface() then
+		return "Gamepad"
+	elseif UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
+		return "Touch"
+	end
+	return "KeyboardMouse"
+end
+
+InventoryState.isOpen = source(false)
+InventoryState.inventory = source(takeSnapshot())
+InventoryState.selected = source(BlockPlacer.getBlockType())
+InventoryState.inputMode = source(initialInputMode() :: InputMode)
+-- A short message shown in the panel footer, such as why a block can't be picked.
+InventoryState.message = source(nil :: string?)
+
+local placerWasEnabled = true
+local messageToken = 0
+
+function InventoryState.isUnlocked(name: string, snapshot: Snapshot): boolean
+	return snapshot.level >= BlockInventory.getUnlockLevel(name)
+end
+
+function InventoryState.getUnlockLevel(name: string): number
+	return BlockInventory.getUnlockLevel(name)
+end
+
+function InventoryState.showMessage(text: string)
+	messageToken += 1
+	local token = messageToken
+	InventoryState.message(text)
+	task.delay(MESSAGE_SECONDS, function()
+		if messageToken == token then
+			InventoryState.message(nil)
+		end
+	end)
+end
+
+function InventoryState.open()
+	if InventoryState.isOpen() then
+		return
+	end
+	-- Taps and clicks on the dimmed world shouldn't build anything while the screen is up.
+	placerWasEnabled = BlockPlacer.isEnabled()
+	BlockPlacer.setEnabled(false)
+	InventoryState.isOpen(true)
+end
+
+function InventoryState.close()
+	if not InventoryState.isOpen() then
+		return
+	end
+	messageToken += 1
+	InventoryState.message(nil)
+	InventoryState.isOpen(false)
+	BlockPlacer.setEnabled(placerWasEnabled)
+end
+
+function InventoryState.toggle()
+	if InventoryState.isOpen() then
+		InventoryState.close()
+	else
+		InventoryState.open()
+	end
+end
+
+--[[
+	Builds with the block type and closes the screen, or explains why it can't if the block is
+	still locked. Blocks the player has none of can still be picked.
+]]
+function InventoryState.choose(name: string)
+	local blockType = BlockTypes.ByName[name]
+	if not BlockInventory.isUnlocked(name) then
+		InventoryState.showMessage(
+			`🔒 {blockType.DisplayName} unlocks at Level {BlockInventory.getUnlockLevel(name)}`
+		)
+		return
+	end
+	BlockPlacer.setBlockType(name)
+	InventoryState.close()
+end
+
+local hasStarted = false
+
+--[[
+	Starts following BlockInventory, BlockPlacer and the player's input device. Safe to call more
+	than once.
+]]
+function InventoryState.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	BlockInventory.Changed:Connect(function()
+		InventoryState.inventory(takeSnapshot())
+	end)
+	BlockPlacer.BlockTypeChanged:Connect(function(name: string)
+		InventoryState.selected(name)
+	end)
+	UserInputService.LastInputTypeChanged:Connect(function(inputType)
+		local mode = inputModeFor(inputType)
+		if mode then
+			InventoryState.inputMode(mode)
+		end
+	end)
+	-- The Roblox menu (Esc, or the Roblox button) takes over the screen; get out of its way.
+	GuiService.MenuOpened:Connect(InventoryState.close)
+end
+
+return InventoryState
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Motion.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Motion.luau
