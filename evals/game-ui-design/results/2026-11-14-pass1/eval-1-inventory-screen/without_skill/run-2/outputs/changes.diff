+--[[
+	The always-visible button that opens the inventory. It shows the block the player is building
+	with and how many they have left, so it doubles as a "current block" display. It sits at the
+	right edge, halfway up, clear of the phone thumbstick (bottom left) and jump button (bottom
+	right).
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local BlockPreview = require(script.Parent.BlockPreview)
+local InputHint = require(script.Parent.InputHint)
+local InventoryState = require(script.Parent.InventoryState)
+local Theme = require(script.Parent.Theme)
+
+local create = Vide.create
+local source = Vide.source
+
+local SIZE = 84
+
+local function OpenButton(props: { uiScale: () -> number })
+	local hovered = source(false)
+
+	return create("TextButton")({
+		Name = "OpenInventory",
+		AnchorPoint = Vector2.new(1, 0.5),
+		Position = UDim2.new(1, -12, 0.5, -30),
+		Size = UDim2.fromOffset(SIZE, SIZE + 20),
+		BackgroundColor3 = Theme.Panel,
+		BackgroundTransparency = 0.1,
+		Text = "",
+		-- Controller players open the screen with Y; don't park the selection here.
+		Selectable = false,
+		Visible = function()
+			return not InventoryState.isOpen()
+		end,
+		Activated = InventoryState.open,
+		MouseEnter = function()
+			hovered(true)
+		end,
+		MouseLeave = function()
+			hovered(false)
+		end,
+
+		create("UIScale")({ Scale = props.uiScale }),
+		create("UICorner")({ CornerRadius = Theme.Corner }),
+		create("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			Color = function()
+				return if hovered() then Theme.Focus else Theme.PanelStroke
+			end,
+			Thickness = 2,
+		}),
+
+		BlockPreview({
+			blockType = function()
+				return BlockTypes.ByName[InventoryState.selected()]
+			end,
+			Position = UDim2.fromOffset(10, 6),
+			Size = UDim2.fromOffset(SIZE - 20, SIZE - 26),
+		}),
+		create("TextLabel")({
+			Name = "Count",
+			AnchorPoint = Vector2.new(1, 0),
+			Position = UDim2.new(1, -6, 0, SIZE - 34),
+			AutomaticSize = Enum.AutomaticSize.X,
+			Size = UDim2.fromOffset(0, 22),
+			BackgroundColor3 = Theme.Chip,
+			FontFace = Theme.FontBold,
+			TextSize = 16,
+			TextColor3 = function()
+				local inventory = InventoryState.inventory()
+				return if (inventory.counts[InventoryState.selected()] or 0) == 0
+					then Theme.TextEmpty
+					else Theme.Text
+			end,
+			Text = function()
+				return `×{InventoryState.inventory().counts[InventoryState.selected()] or 0}`
+			end,
+
+			create("UICorner")({ CornerRadius = UDim.new(1, 0) }),
+			create("UIPadding")({
+				PaddingLeft = UDim.new(0, 6),
+				PaddingRight = UDim.new(0, 6),
+			}),
+		}),
+		create("TextLabel")({
+			Name = "Label",
+			AnchorPoint = Vector2.new(0, 1),
+			Position = UDim2.new(0, 0, 1, -6),
+			Size = UDim2.new(1, 0, 0, 22),
+			BackgroundTransparency = 1,
+			FontFace = Theme.FontHeavy,
+			TextSize = 19,
+			TextColor3 = Theme.Text,
+			Text = "Blocks",
+		}),
+		InputHint({
+			key = "E",
+			button = Enum.KeyCode.ButtonY,
+			size = 26,
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromOffset(4, 4),
+		}),
+	})
+end
+
+return OpenButton
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Props.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Props.luau
new file mode 100644
index 0000000..48fcb31
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Props.luau
@@ -0,0 +1,24 @@
+--[[
+	Lets a component accept ordinary instance properties and children (Position, LayoutOrder, extra
+	children) alongside its own options.
+]]
+
+local Props = {}
+
+--[[
+	Copies every entry of `props` whose key isn't in `own` onto `base`, so the caller's properties
+	win, and appends the caller's children after base's own. Returns `base`.
+]]
+function Props.merge(base: { [any]: any }, props: { [any]: any }, own: { string }): { [any]: any }
+	for key, value in props do
+		if type(key) == "string" and not table.find(own, key) then
+			base[key] = value
+		end
+	end
+	for _, child in ipairs(props) do
+		table.insert(base, child)
+	end
+	return base
+end
+
+return Props
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Theme.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Theme.luau
