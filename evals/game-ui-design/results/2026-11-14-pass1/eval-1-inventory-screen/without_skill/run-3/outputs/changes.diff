index 0000000..a483b38
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InputMode.luau
@@ -0,0 +1,43 @@
+--[[
+	Sorts Roblox input types into the three ways players drive the UI, so components can show the
+	right hints (keycaps, controller glyphs or nothing) for the device the player last touched.
+]]
+
+export type InputMode = "Touch" | "KeyboardMouse" | "Gamepad"
+
+local GAMEPADS = {
+	[Enum.UserInputType.Gamepad1] = true,
+	[Enum.UserInputType.Gamepad2] = true,
+	[Enum.UserInputType.Gamepad3] = true,
+	[Enum.UserInputType.Gamepad4] = true,
+	[Enum.UserInputType.Gamepad5] = true,
+	[Enum.UserInputType.Gamepad6] = true,
+	[Enum.UserInputType.Gamepad7] = true,
+	[Enum.UserInputType.Gamepad8] = true,
+}
+
+local InputMode = {}
+
+--[[
+	Returns the mode for an input type, or nil for input types that say nothing about the device
+	(focus changes, text input and the like), so callers can keep the previous mode.
+]]
+function InputMode.fromInputType(inputType: Enum.UserInputType): InputMode?
+	if GAMEPADS[inputType] then
+		return "Gamepad"
+	elseif inputType == Enum.UserInputType.Touch then
+		return "Touch"
+	elseif
+		inputType == Enum.UserInputType.Keyboard
+		or inputType == Enum.UserInputType.MouseButton1
+		or inputType == Enum.UserInputType.MouseButton2
+		or inputType == Enum.UserInputType.MouseButton3
+		or inputType == Enum.UserInputType.MouseMovement
+		or inputType == Enum.UserInputType.MouseWheel
+	then
+		return "KeyboardMouse"
+	end
+	return nil
+end
+
+return InputMode
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryApp.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryApp.luau
new file mode 100644
index 0000000..8cb8aa6
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryApp.luau
@@ -0,0 +1,297 @@
+--[[
+	Mounts the block inventory UI and owns its state and controls. See docs/inventory-screen.md for
+	the design.
+
+	- Open or close: the Blocks button, B on a keyboard, Y on a controller.
+	- Close: the X button, tapping or clicking outside the panel, B on a controller.
+	- Pick: tap, click or press A on a block. Picking closes the screen. Locked and empty blocks
+	  can't be picked; pressing one shows why in the footer.
+
+	Placing blocks in the world is turned off while the screen is open, so a stray tap never
+	places a block behind the panel.
+]]
+
+local ContextActionService = game:GetService("ContextActionService")
+local GuiService = game:GetService("GuiService")
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local UserInputService = game:GetService("UserInputService")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local BlockInventory = require(script.Parent.Parent.BlockInventory)
+local BlockPlacer = require(script.Parent.Parent.BlockPlacer)
+local InputMode = require(script.Parent.InputMode)
+local InventoryPanel = require(script.Parent.Components.InventoryPanel)
+local OpenButton = require(script.Parent.Components.OpenButton)
+
+local create = Vide.create
+local source = Vide.source
+local effect = Vide.effect
+local cleanup = Vide.cleanup
+local action = Vide.action
+
+local TOGGLE_KEY = Enum.KeyCode.B
+local TOGGLE_KEY_TEXT = "B"
+local TOGGLE_GAMEPAD_BUTTON = Enum.KeyCode.ButtonY
+local CLOSE_GAMEPAD_BUTTON = Enum.KeyCode.ButtonB
+-- Matches the number keys BlockPlacer listens to, in block order.
+local KEY_TEXTS = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" }
+local MESSAGE_SECONDS = 3
+
+local TOGGLE_ACTION = "ToggleBlockInventory"
+local CLOSE_ACTION = "CloseBlockInventory"
+
+local function initialInputMode(): InputMode.InputMode
+	local fromLast = InputMode.fromInputType(UserInputService:GetLastInputType())
+	if fromLast then
+		return fromLast
+	elseif UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
+		return "Touch"
+	elseif UserInputService.GamepadEnabled and not UserInputService.KeyboardEnabled then
+		return "Gamepad"
+	end
+	return "KeyboardMouse"
+end
+
+local function App()
+	local isOpen = source(false)
+	local mode = source(initialInputMode())
+	local selectedName = source(BlockPlacer.getBlockType())
+	local message: Vide.Source<string?> = source(nil :: string?)
+	-- Bumped whenever BlockInventory changes, so anything that reads it re-renders.
+	local revision = source(0)
+
+	local screenGui: ScreenGui? = nil
+	local tiles: { [string]: GuiObject } = {}
+	local placerWasEnabled = true
+	local messageToken = 0
+
+	local function count(name: string): number
+		revision()
+		return BlockInventory.getCount(name)
+	end
+	local function isUnlocked(name: string): boolean
+		revision()
+		return BlockInventory.isUnlocked(name)
+	end
+	local function level(): number
+		revision()
+		return BlockInventory.getLevel()
+	end
+
+	local function showMessage(text: string)
+		messageToken += 1
+		local token = messageToken
+		message(text)
+		task.delay(MESSAGE_SECONDS, function()
+			if messageToken == token then
+				message(nil)
+			end
+		end)
+	end
+
+	local function isCursorInScreen(): boolean
+		local selected = GuiService.SelectedObject
+		return selected ~= nil and screenGui ~= nil and selected:IsDescendantOf(screenGui)
+	end
+
+	local function moveCursorToSelectedBlock()
+		local tile = tiles[selectedName()]
+		if tile then
+			GuiService.SelectedObject = tile
+		end
+	end
+
+	local function open()
+		if isOpen() then
+			return
+		end
+		placerWasEnabled = BlockPlacer.isEnabled()
+		BlockPlacer.setEnabled(false)
+		messageToken += 1
+		message(nil)
+		isOpen(true)
+		if mode() == "Gamepad" then
+			moveCursorToSelectedBlock()
+		end
+	end
+
+	local function close()
+		if not isOpen() then
+			return
+		end
+		isOpen(false)
+		BlockPlacer.setEnabled(placerWasEnabled)
+		if isCursorInScreen() then
+			GuiService.SelectedObject = nil
+		end
+	end
+
+	local function toggle()
+		if isOpen() then
+			close()
+		else
+			open()
+		end
+	end
+
+	local function pick(name: string)
+		local blockType = BlockTypes.ByName[name]
+		if not BlockInventory.isUnlocked(name) then
+			local unlockLevel = BlockInventory.getUnlockLevel(name)
+			showMessage(`{blockType.DisplayName} unlocks at level {unlockLevel}. Keep building!`)
+			return
+		end
+		if BlockInventory.getCount(name) <= 0 then
+			showMessage(`You don't have any {blockType.DisplayName} yet. Go collect some!`)
+			return
+		end
+		BlockPlacer.setBlockType(name)
+		close()
+	end
+
+	cleanup(BlockInventory.Changed:Connect(function()
+		revision(revision() + 1)
+	end))
+
+	cleanup(BlockPlacer.BlockTypeChanged:Connect(function(name: string)
+		selectedName(name)
+	end))
+
+	cleanup(UserInputService.LastInputTypeChanged:Connect(function(inputType)
+		local newMode = InputMode.fromInputType(inputType)
+		if not newMode or newMode == mode() then
+			return
+		end
+		-- Update the mode first so the SelectedObject handler below sees it.
+		mode(newMode)
+		if not isOpen() then
+			return
+		end
+		if newMode == "Gamepad" then
+			-- Picked up a controller with the screen open: put the cursor on the blocks.
+			if not isCursorInScreen() then
+				moveCursorToSelectedBlock()
+			end
+		elseif isCursorInScreen() then
+			-- Went back to touch or mouse: hide the controller cursor.
+			GuiService.SelectedObject = nil
+		end
+	end))
+
+	-- Roblox clears the controller cursor when B is pressed in menus. If that happens while the
+	-- screen is open on a controller, treat it as closing the screen.
+	cleanup(GuiService:GetPropertyChangedSignal("SelectedObject"):Connect(function()
+		if isOpen() and mode() == "Gamepad" and GuiService.SelectedObject == nil then
+			close()
+		end
+	end))
+
+	ContextActionService:BindActionAtPriority(
+		TOGGLE_ACTION,
+		function(_, inputState)
+			if inputState == Enum.UserInputState.Begin then
+				toggle()
+			end
+			return Enum.ContextActionResult.Sink
+		end,
+		false,
+		Enum.ContextActionPriority.High.Value,
+		TOGGLE_KEY,
+		TOGGLE_GAMEPAD_BUTTON
+	)
+	cleanup(function()
+		ContextActionService:UnbindAction(TOGGLE_ACTION)
+	end)
+
+	-- B on a controller closes the screen, bound only while it's open so B stays free otherwise.
+	effect(function()
+		if not isOpen() then
+			return
+		end
+		ContextActionService:BindActionAtPriority(
+			CLOSE_ACTION,
+			function(_, inputState)
+				if inputState == Enum.UserInputState.Begin then
+					task.defer(close)
+				end
+				return Enum.ContextActionResult.Sink
+			end,
+			false,
+			Enum.ContextActionPriority.High.Value,
+			CLOSE_GAMEPAD_BUTTON
+		)
+		cleanup(function()
+			ContextActionService:UnbindAction(CLOSE_ACTION)
+		end)
+	end)
+
+	cleanup(function()
+		if isOpen() then
+			BlockPlacer.setEnabled(placerWasEnabled)
+		end
+	end)
+
+	return create("ScreenGui")({
+		Name = "BlockInventory",
+		ResetOnSpawn = false,
+		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
+		-- Keeps the UI clear of notches, rounded corners and the Roblox top bar.
+		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
+		DisplayOrder = 5,
+
+		action(function(instance)
+			screenGui = instance :: ScreenGui
+		end),
+
+		OpenButton({
+			selectedName = selectedName,
+			count = count,
+			isOpen = isOpen,
+			mode = mode,
+			toggleKeyText = TOGGLE_KEY_TEXT,
+			toggleGamepadButton = TOGGLE_GAMEPAD_BUTTON,
+			onActivated = open,
+		}),
+
+		InventoryPanel({
+			isOpen = isOpen,
+			mode = mode,
+			level = level,
+			selectedName = selectedName,
+			message = message,
+			count = count,
+			unlockLevel = BlockInventory.getUnlockLevel,
+			isUnlocked = isUnlocked,
+			keyTexts = KEY_TEXTS,
+			toggleKeyText = TOGGLE_KEY_TEXT,
+			onPick = pick,
+			onClose = close,
+			onTileCreated = function(name, tile)
+				tiles[name] = tile
+			end,
+		}),
+	})
+end
+
+local InventoryApp = {}
+
+local hasStarted = false
+
+--[[
+	Mounts the inventory UI into the local player's PlayerGui and binds its controls. Safe to call
+	more than once; only the first call does anything.
+]]
+function InventoryApp.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
+	Vide.mount(App, playerGui)
+end
+
+return InventoryApp
