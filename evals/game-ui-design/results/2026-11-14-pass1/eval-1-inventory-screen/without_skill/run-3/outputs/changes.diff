+--[[
+	The always-on button that opens the inventory. It sits at the bottom centre of the screen,
+	between the phone thumbstick (bottom left) and jump button (bottom right), and shows the block
+	the player is building with, so it doubles as a "what am I holding" indicator. The key or
+	controller button that also opens it is drawn in its corner.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local BlockSwatch = require(script.Parent.BlockSwatch)
+local ButtonGlyph = require(script.Parent.ButtonGlyph)
+local InputMode = require(script.Parent.Parent.InputMode)
+local Theme = require(script.Parent.Parent.Theme)
+
+local create = Vide.create
+local source = Vide.source
+local spring = Vide.spring
+
+export type Props = {
+	selectedName: () -> string,
+	count: (name: string) -> number,
+	isOpen: () -> boolean,
+	mode: () -> InputMode.InputMode,
+	toggleKeyText: string,
+	toggleGamepadButton: Enum.KeyCode,
+	onActivated: () -> (),
+}
+
+local function OpenButton(props: Props)
+	local isPressed = source(false)
+	local scale = spring(function()
+		return if isPressed() then 0.92 else 1
+	end, 0.12, 0.6)
+
+	return create("TextButton")({
+		Name = "OpenInventoryButton",
+		AnchorPoint = Vector2.new(0.5, 1),
+		Position = UDim2.new(0.5, 0, 1, -12),
+		Size = UDim2.fromOffset(Theme.OPEN_BUTTON_SIZE, Theme.OPEN_BUTTON_SIZE),
+		BackgroundColor3 = Theme.Panel,
+		BackgroundTransparency = 0.1,
+		Text = "",
+		AutoButtonColor = false,
+		-- The controller opens the inventory with its own button; keep the cursor off this one.
+		Selectable = false,
+		Visible = function()
+			return not props.isOpen()
+		end,
+
+		InputBegan = function(input: InputObject)
+			if
+				input.UserInputType == Enum.UserInputType.Touch
+				or input.UserInputType == Enum.UserInputType.MouseButton1
+			then
+				isPressed(true)
+			end
+		end,
+		InputEnded = function()
+			isPressed(false)
+		end,
+		MouseLeave = function()
+			isPressed(false)
+		end,
+		Activated = function()
+			props.onActivated()
+		end,
+
+		create("UIScale")({ Scale = scale }),
+		create("UICorner")({ CornerRadius = UDim.new(0, 16) }),
+		create("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			Color = Theme.Selected,
+			Thickness = 3,
+		}),
+
+		BlockSwatch({
+			blockType = function()
+				return BlockTypes.ByName[props.selectedName()]
+			end,
+			AnchorPoint = Vector2.new(0.5, 0),
+			Position = UDim2.new(0.5, 0, 0, 8),
+			Size = UDim2.new(1, -30, 1, -38),
+		}),
+
+		create("TextLabel")({
+			Name = "Count",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.new(0.5, 0, 0, 8 + (Theme.OPEN_BUTTON_SIZE - 38) / 2),
+			Size = UDim2.fromOffset(Theme.OPEN_BUTTON_SIZE - 30, 24),
+			BackgroundTransparency = 1,
+			Font = Theme.FontHeavy,
+			Text = function()
+				local count = props.count(props.selectedName())
+				return if count > 999 then "999+" else tostring(count)
+			end,
+			TextColor3 = Theme.Text,
+			TextStrokeTransparency = 0.3,
+			TextSize = Theme.TEXT_BODY,
+		}),
+
+		create("TextLabel")({
+			Name = "Label",
+			AnchorPoint = Vector2.new(0.5, 1),
+			Position = UDim2.new(0.5, 0, 1, -4),
+			Size = UDim2.new(1, 0, 0, 22),
+			BackgroundTransparency = 1,
+			Font = Theme.FontHeavy,
+			Text = "Blocks",
+			TextColor3 = Theme.Text,
+			TextSize = Theme.TEXT_BODY,
+		}),
+
+		ButtonGlyph({
+			mode = props.mode,
+			keyText = props.toggleKeyText,
+			gamepadButton = props.toggleGamepadButton,
+			size = 26,
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromOffset(Theme.OPEN_BUTTON_SIZE - 4, 4),
+			ZIndex = 2,
+		}),
+	})
+end
+
+return OpenButton
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InputMode.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InputMode.luau
