+			end,
+		})
+	end
+
+	return create("Frame")({
+		Name = "Inventory",
+		BackgroundTransparency = 1,
+		Size = UDim2.fromScale(1, 1),
+		Visible = props.isOpen,
+		ZIndex = 10,
+
+		-- Tapping or clicking anywhere outside the panel closes it.
+		create("TextButton")({
+			Name = "Backdrop",
