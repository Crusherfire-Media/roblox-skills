+			BackgroundTransparency = 0.45,
+			Text = "",
+			AutoButtonColor = false,
+			Selectable = false,
+			Activated = function()
+				props.onClose()
+			end,
+		}),
+
+		-- A button so clicks and taps on the panel never fall through to the backdrop or world.
+		create("TextButton")({
+			Name = "Panel",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0.5),
+			Size = UDim2.new(1, -24, 1, -24),
+			BackgroundColor3 = Theme.Panel,
+			Text = "",
+			AutoButtonColor = false,
+			Selectable = false,
+			-- Frees the mouse while the panel is open, even in first person or shift lock.
+			Modal = props.isOpen,
+
+			create("UISizeConstraint")({ MaxSize = Theme.PANEL_MAX_SIZE }),
+			create("UIScale")({ Scale = panelScale }),
+			create("UICorner")({ CornerRadius = UDim.new(0, 18) }),
+			create("UIStroke")({
+				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+				Color = Theme.PanelStroke,
+				Thickness = 3,
+			}),
+			create("UIPadding")({
+				PaddingTop = UDim.new(0, Theme.PANEL_PADDING),
+				PaddingBottom = UDim.new(0, Theme.PANEL_PADDING),
+				PaddingLeft = UDim.new(0, Theme.PANEL_PADDING),
+				PaddingRight = UDim.new(0, Theme.PANEL_PADDING),
+			}),
+
+			create("Frame")({
+				Name = "Header",
+				BackgroundTransparency = 1,
+				Size = UDim2.new(1, 0, 0, Theme.HEADER_HEIGHT),
+
+				create("TextLabel")({
+					Name = "Title",
+					BackgroundTransparency = 1,
+					Size = UDim2.new(1, -(Theme.MIN_TOUCH_TARGET + 8), 0, 34),
+					Font = Theme.FontHeavy,
+					Text = "My Blocks",
+					TextColor3 = Theme.Text,
+					TextSize = Theme.TEXT_TITLE,
+					TextXAlignment = Enum.TextXAlignment.Left,
+				}),
+
+				create("TextLabel")({
+					Name = "Level",
+					Position = UDim2.fromOffset(0, 34),
+					BackgroundTransparency = 1,
+					Size = UDim2.new(1, -(Theme.MIN_TOUCH_TARGET + 8), 0, 22),
+					Font = Theme.Font,
+					Text = function()
+						return `You are level {props.level()}`
+					end,
+					TextColor3 = Theme.Locked,
+					TextSize = Theme.TEXT_BODY,
+					TextXAlignment = Enum.TextXAlignment.Left,
+				}),
+
+				create("TextButton")({
+					Name = "Close",
+					AnchorPoint = Vector2.new(1, 0),
+					Position = UDim2.fromScale(1, 0),
+					Size = UDim2.fromOffset(Theme.MIN_TOUCH_TARGET, Theme.MIN_TOUCH_TARGET),
+					BackgroundColor3 = Theme.Slot,
+					Font = Theme.FontHeavy,
+					Text = "X",
+					TextColor3 = Theme.Text,
+					TextSize = Theme.TEXT_TITLE,
+					AutoButtonColor = true,
+					-- Controller players close with B; keep the cursor on the blocks.
+					Selectable = false,
+					Activated = function()
+						props.onClose()
+					end,
+
+					create("UICorner")({ CornerRadius = UDim.new(0, 12) }),
+					ButtonGlyph({
+						mode = props.mode,
+						keyText = props.toggleKeyText,
+						gamepadButton = Enum.KeyCode.ButtonB,
+						size = 24,
+						AnchorPoint = Vector2.new(1, 0.5),
+						Position = UDim2.new(0, -8, 0.5, 0),
+					}),
+				}),
+			}),
+
+			create("ScrollingFrame")({
+				Name = "Grid",
+				Position = UDim2.fromOffset(0, Theme.HEADER_HEIGHT),
+				Size = UDim2.new(1, 0, 1, -(Theme.HEADER_HEIGHT + Theme.FOOTER_HEIGHT)),
+				BackgroundTransparency = 1,
+				BorderSizePixel = 0,
+				CanvasSize = UDim2.new(),
+				AutomaticCanvasSize = Enum.AutomaticSize.Y,
+				ScrollingDirection = Enum.ScrollingDirection.Y,
+				ScrollBarThickness = 8,
+				ScrollBarImageColor3 = Theme.TextDim,
+				VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
+				Selectable = false,
+				-- Keeps the controller cursor inside the grid while the panel is open.
+				SelectionGroup = true,
+				SelectionBehaviorUp = Enum.SelectionBehavior.Stop,
+				SelectionBehaviorDown = Enum.SelectionBehavior.Stop,
+				SelectionBehaviorLeft = Enum.SelectionBehavior.Stop,
+				SelectionBehaviorRight = Enum.SelectionBehavior.Stop,
+
+				changed("AbsoluteWindowSize", function(size: Vector2)
+					-- Leave room for the padding below so focus outlines aren't clipped.
+					gridSize(size - Vector2.new(12, 12))
+				end),
+
+				create("UIPadding")({
+					PaddingTop = UDim.new(0, 6),
+					PaddingBottom = UDim.new(0, 6),
+					PaddingLeft = UDim.new(0, 6),
+					PaddingRight = UDim.new(0, 6),
+				}),
+				create("UIGridLayout")({
+					CellPadding = UDim2.fromOffset(Theme.GAP, Theme.GAP),
+					CellSize = function()
+						local size = cellSize()
+						return UDim2.fromOffset(size.X, size.Y)
+					end,
+					FillDirection = Enum.FillDirection.Horizontal,
+					HorizontalAlignment = Enum.HorizontalAlignment.Center,
+					SortOrder = Enum.SortOrder.LayoutOrder,
+				}),
+
+				tiles,
+			}),
+
+			create("Frame")({
+				Name = "Footer",
+				AnchorPoint = Vector2.new(0, 1),
+				Position = UDim2.fromScale(0, 1),
+				Size = UDim2.new(1, 0, 0, Theme.FOOTER_HEIGHT),
+				BackgroundTransparency = 1,
+
+				HintRow(props),
+
+				create("TextLabel")({
+					Name = "Message",
+					BackgroundTransparency = 1,
+					Size = UDim2.fromScale(1, 1),
+					Font = Theme.FontHeavy,
+					Text = function()
+						return props.message() or ""
+					end,
+					TextColor3 = Theme.Message,
+					TextScaled = true,
+					Visible = function()
+						return props.message() ~= nil
+					end,
+
+					create("UITextSizeConstraint")({
+						MinTextSize = Theme.TEXT_SMALL,
+						MaxTextSize = Theme.TEXT_LARGE,
+					}),
+				}),
+			}),
+		}),
+	})
+end
+
+return InventoryPanel
