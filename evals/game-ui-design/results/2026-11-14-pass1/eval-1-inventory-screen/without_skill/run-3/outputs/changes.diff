diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockSwatch.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockSwatch.luau
new file mode 100644
index 0000000..ea5662f
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockSwatch.luau
@@ -0,0 +1,70 @@
+--[[
+	A small picture of a block: a rounded square in the block's colour with light shading so it
+	reads as a cube face. See-through blocks (Window, Ice) stay see-through.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local create = Vide.create
+
+export type Props = {
+	-- The block type to draw, or a function returning one so the swatch can follow the selection.
+	blockType: BlockTypes.BlockType | () -> BlockTypes.BlockType,
+	-- Draws the block greyed out, for locked blocks.
+	dimmed: (() -> boolean)?,
+	Size: UDim2?,
+	Position: UDim2?,
+	AnchorPoint: Vector2?,
+	ZIndex: number?,
+}
+
+local GREY = Color3.fromRGB(90, 92, 104)
+
+local function BlockSwatch(props: Props)
+	local function getBlockType(): BlockTypes.BlockType
+		local value = props.blockType
+		if type(value) == "function" then
+			return value()
+		end
+		return value :: BlockTypes.BlockType
+	end
+	local function isDimmed(): boolean
+		return if props.dimmed then props.dimmed() else false
+	end
+
+	local frame = create("Frame")({
+		Name = "Swatch",
+		Size = props.Size or UDim2.fromScale(1, 1),
+		Position = props.Position or UDim2.new(),
+		AnchorPoint = props.AnchorPoint or Vector2.zero,
+		ZIndex = props.ZIndex or 1,
+		BackgroundColor3 = function()
+			local color = getBlockType().Color
+			return if isDimmed() then color:Lerp(GREY, 0.75) else color
+		end,
+		BackgroundTransparency = function()
+			-- Keep see-through blocks visible against the dark panel.
+			return getBlockType().Transparency * 0.5
+		end,
+
+		create("UIAspectRatioConstraint")({ AspectRatio = 1 }),
+		create("UICorner")({ CornerRadius = UDim.new(0.18, 0) }),
+		create("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			Color = Color3.new(0, 0, 0),
+			Transparency = 0.6,
+			Thickness = 2,
+		}),
+		create("UIGradient")({
+			Rotation = 90,
+			Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(150, 150, 150)),
+		}),
+	})
+
+	return frame
+end
+
+return BlockSwatch
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile.luau
new file mode 100644
index 0000000..9588535
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile.luau
@@ -0,0 +1,222 @@
+--[[
+	One block type in the inventory grid. Everything a player needs is drawn on the tile itself, so
+	nothing depends on hovering (phones can't hover):
+
+	- the block, its name and how many the player has;
+	- a lock and the unlock level instead of the count while the block is locked;
+	- a green outline and tick on the block the player is building with;
+	- a white outline on the tile the mouse is over or the controller cursor is on;
+	- the number key that picks it, when the player is on keyboard and mouse.
+
+	Pressing the tile (tap, click, or A on a controller) calls onPick, also for locked and empty
+	blocks, so the screen can explain why they can't be picked.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local BlockSwatch = require(script.Parent.BlockSwatch)
+local ButtonGlyph = require(script.Parent.ButtonGlyph)
+local InputMode = require(script.Parent.Parent.InputMode)
+local Theme = require(script.Parent.Parent.Theme)
+
+local create = Vide.create
+local source = Vide.source
+local spring = Vide.spring
+local action = Vide.action
+
+export type Props = {
+	blockType: BlockTypes.BlockType,
+	layoutOrder: number,
+	-- Text of the number key that picks this block, e.g. "1".
+	keyText: string,
+	count: () -> number,
+	unlockLevel: number,
+	isUnlocked: () -> boolean,
+	isSelected: () -> boolean,
+	mode: () -> InputMode.InputMode,
+	onPick: () -> (),
+	-- Receives the tile's button so the screen can move the controller cursor to it.
+	onCreated: (GuiObject) -> (),
+}
+
+-- Hides Roblox's default controller selection box; the tile draws its own focus outline.
+local NO_SELECTION_IMAGE = Instance.new("Frame")
+NO_SELECTION_IMAGE.BackgroundTransparency = 1
+NO_SELECTION_IMAGE.Size = UDim2.fromScale(0, 0)
+
+local function formatCount(count: number): string
+	if count > 999 then
+		return "999+"
+	end
+	return `x{count}`
+end
+
+local function BlockTile(props: Props)
+	local isHovered = source(false)
+	local isCursorOn = source(false)
+
+	local function isFocused(): boolean
+		return isHovered() or isCursorOn()
+	end
+
+	local scale = spring(function()
+		return if isFocused() then 1.05 else 1
+	end, 0.15, 0.7)
+
+	local function isLocked(): boolean
+		return not props.isUnlocked()
+	end
+
+	return create("TextButton")({
+		Name = props.blockType.Name,
+		LayoutOrder = props.layoutOrder,
+		Text = "",
+		AutoButtonColor = false,
+		Selectable = true,
+		SelectionImageObject = NO_SELECTION_IMAGE,
+		BackgroundColor3 = function()
+			return if isLocked() then Theme.SlotLocked else Theme.Slot
+		end,
+
+		MouseEnter = function()
+			isHovered(true)
+		end,
+		MouseLeave = function()
+			isHovered(false)
+		end,
+		SelectionGained = function()
+			isCursorOn(true)
+		end,
+		SelectionLost = function()
+			isCursorOn(false)
+		end,
+		Activated = function()
+			props.onPick()
+		end,
+
+		action(function(instance)
+			props.onCreated(instance :: GuiObject)
+		end),
+
+		create("UIScale")({ Scale = scale }),
+		create("UICorner")({ CornerRadius = UDim.new(0, 12) }),
+		create("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			Color = function()
+				if isFocused() then
+					return Theme.Focus
+				elseif props.isSelected() then
+					return Theme.Selected
+				end
+				return Theme.SlotStroke
+			end,
+			Thickness = function()
+				return if isFocused() or props.isSelected() then 4 else 2
+			end,
+		}),
+		create("UIPadding")({
+			PaddingTop = UDim.new(0, 6),
+			PaddingBottom = UDim.new(0, 4),
+			PaddingLeft = UDim.new(0, 4),
+			PaddingRight = UDim.new(0, 4),
+		}),
+
+		BlockSwatch({
+			blockType = props.blockType,
+			dimmed = isLocked,
+			AnchorPoint = Vector2.new(0.5, 0),
+			Position = UDim2.fromScale(0.5, 0),
+			Size = UDim2.fromScale(1, 0.54),
+		}),
+
+		-- Lock over the swatch while the block is locked.
+		create("TextLabel")({
+			Name = "Lock",
+			AnchorPoint = Vector2.new(0.5, 0),
+			Position = UDim2.fromScale(0.5, 0),
+			Size = UDim2.fromScale(1, 0.54),
+			BackgroundTransparency = 1,
+			Font = Theme.FontHeavy,
+			Text = "🔒",
+			TextScaled = true,
+			TextColor3 = Theme.Locked,
+			ZIndex = 2,
+			Visible = isLocked,
+
+			create("UITextSizeConstraint")({ MaxTextSize = 34 }),
+		}),
+
+		create("TextLabel")({
+			Name = "BlockName",
+			Position = UDim2.fromScale(0, 0.56),
+			Size = UDim2.fromScale(1, 0.22),
+			BackgroundTransparency = 1,
+			Font = Theme.Font,
+			Text = props.blockType.DisplayName,
+			TextScaled = true,
+			TextColor3 = function()
+				return if isLocked() then Theme.TextMuted else Theme.Text
+			end,
+
+			create("UITextSizeConstraint")({ MinTextSize = 12, MaxTextSize = Theme.TEXT_BODY }),
+		}),
+
+		create("TextLabel")({
+			Name = "Status",
+			Position = UDim2.fromScale(0, 0.78),
+			Size = UDim2.fromScale(1, 0.22),
+			BackgroundTransparency = 1,
+			Font = Theme.FontHeavy,
+			TextScaled = true,
+			Text = function()
+				if isLocked() then
+					return `Level {props.unlockLevel}`
+				end
+				local count = props.count()
+				return if count > 0 then formatCount(count) else "None yet"
+			end,
+			TextColor3 = function()
+				if isLocked() then
+					return Theme.Locked
+				end
+				return if props.count() > 0 then Theme.Text else Theme.TextDim
+			end,
+
+			create("UITextSizeConstraint")({ MinTextSize = 12, MaxTextSize = Theme.TEXT_BODY }),
+		}),
+
+		-- Tick on the block the player builds with.
+		create("TextLabel")({
+			Name = "SelectedTick",
+			AnchorPoint = Vector2.new(1, 0),
+			Position = UDim2.new(1, 2, 0, -4),
+			Size = UDim2.fromOffset(26, 26),
+			BackgroundColor3 = Theme.Selected,
+			Font = Theme.FontHeavy,
+			Text = "✓",
+			TextColor3 = Color3.new(0, 0, 0),
+			TextSize = 20,
+			ZIndex = 3,
+			Visible = props.isSelected,
+
+			create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+		}),
+
+		ButtonGlyph({
+			mode = function()
+				-- Number keys skip blocks the player can't build with, so don't advertise them there.
+				local canPick = props.isUnlocked() and props.count() > 0
+				return if canPick then props.mode() else "Touch"
+			end,
+			keyText = props.keyText,
+			size = 22,
+			Position = UDim2.new(0, -2, 0, -4),
+			ZIndex = 3,
+		}),
+	})
+end
+
+return BlockTile
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/ButtonGlyph.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/ButtonGlyph.luau
new file mode 100644
index 0000000..de34dce
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/ButtonGlyph.luau
@@ -0,0 +1,91 @@
+--[[
+	The key or controller button that triggers an action, drawn for the player's current device: a
+	keycap on keyboard and mouse, the platform's own button image on a controller (so Xbox and
+	PlayStation pads both look right), and nothing on touch, where players just tap.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local UserInputService = game:GetService("UserInputService")
+
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local InputMode = require(script.Parent.Parent.InputMode)
+local Theme = require(script.Parent.Parent.Theme)
+
+local create = Vide.create
+
+export type Props = {
+	mode: () -> InputMode.InputMode,
+	-- Text on the keycap for keyboard and mouse, or nil for no keyboard hint.
+	keyText: string?,
+	-- Controller button to show, or nil for no controller hint.
+	gamepadButton: Enum.KeyCode?,
+	size: number?,
+	Position: UDim2?,
+	AnchorPoint: Vector2?,
+	LayoutOrder: number?,
+	ZIndex: number?,
+}
+
+local function ButtonGlyph(props: Props)
+	local size = props.size or 28
+	local gamepadImage = if props.gamepadButton
+		then UserInputService:GetImageForKeyCode(props.gamepadButton)
+		else ""
+
+	local showKeycap = function()
+		return props.mode() == "KeyboardMouse" and props.keyText ~= nil
+	end
+	local showGamepad = function()
+		return props.mode() == "Gamepad" and props.gamepadButton ~= nil
+	end
+
+	return create("Frame")({
+		Name = "ButtonGlyph",
+		BackgroundTransparency = 1,
+		AutomaticSize = Enum.AutomaticSize.X,
+		Size = UDim2.fromOffset(size, size),
+		Position = props.Position or UDim2.new(),
+		AnchorPoint = props.AnchorPoint or Vector2.zero,
+		LayoutOrder = props.LayoutOrder or 0,
+		ZIndex = props.ZIndex or 1,
+		Visible = function()
+			return showKeycap() or showGamepad()
+		end,
+
+		create("TextLabel")({
+			Name = "Keycap",
+			AutomaticSize = Enum.AutomaticSize.X,
+			Size = UDim2.fromOffset(size, size),
+			BackgroundColor3 = Theme.Keycap,
+			Font = Theme.Font,
+			Text = props.keyText or "",
+			TextColor3 = Theme.Text,
+			TextSize = math.floor(size * 0.62),
+			ZIndex = props.ZIndex or 1,
+			Visible = showKeycap,
+
+			create("UICorner")({ CornerRadius = UDim.new(0, 6) }),
+			create("UIStroke")({
+				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+				Color = Theme.TextDim,
+				Thickness = 1,
+			}),
+			create("UIPadding")({
+				PaddingLeft = UDim.new(0, 6),
+				PaddingRight = UDim.new(0, 6),
+			}),
+		}),
+
+		create("ImageLabel")({
+			Name = "GamepadButton",
+			Size = UDim2.fromOffset(size, size),
+			BackgroundTransparency = 1,
+			Image = gamepadImage,
+			ZIndex = props.ZIndex or 1,
+			Visible = showGamepad,
+		}),
+	})
+end
+
+return ButtonGlyph
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryPanel.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryPanel.luau
new file mode 100644
index 0000000..025ded8
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryPanel.luau
@@ -0,0 +1,375 @@
+--[[
+	The inventory screen: a dimmed backdrop and a centred panel with a header (title, player level,
+	close button), a grid of every block type and a footer that shows controls for the current
+	device or a short message after a failed pick.
+
+	The grid works out its column count and tile size from the space it has, so all ten blocks fit
+	without scrolling on a landscape phone, a portrait phone gets bigger tiles in fewer columns,
+	and anything smaller scrolls instead of shrinking tiles below a comfortable touch size.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local BlockTile = require(script.Parent.BlockTile)
+local ButtonGlyph = require(script.Parent.ButtonGlyph)
+local InputMode = require(script.Parent.Parent.InputMode)
+local Theme = require(script.Parent.Parent.Theme)
+
+local create = Vide.create
+local source = Vide.source
+local derive = Vide.derive
+local spring = Vide.spring
+local changed = Vide.changed
+
+export type Props = {
+	isOpen: () -> boolean,
+	mode: () -> InputMode.InputMode,
+	level: () -> number,
+	selectedName: () -> string,
+	message: () -> string?,
+	count: (name: string) -> number,
+	unlockLevel: (name: string) -> number,
+	isUnlocked: (name: string) -> boolean,
+	keyTexts: { string },
+	toggleKeyText: string,
+	onPick: (name: string) -> (),
+	onClose: () -> (),
+	onTileCreated: (name: string, tile: GuiObject) -> (),
+}
+
+local MAX_COLUMNS = 5
+
+local function computeCellSize(available: Vector2): Vector2
+	local gap = Theme.GAP
+	local blockCount = #BlockTypes.List
+
+	local columns = math.floor((available.X + gap) / (Theme.MIN_TILE_WIDTH + gap))
+	columns = math.clamp(columns, 2, MAX_COLUMNS)
+	local rows = math.ceil(blockCount / columns)
+
+	-- The grid is zero-sized until its first layout, so keep both sizes at their minimums.
+	local width = math.floor((available.X - gap * (columns - 1)) / columns)
+	width = math.clamp(width, Theme.MIN_TILE_WIDTH, Theme.MAX_TILE_WIDTH)
+
+	-- Fill the height when possible so nothing scrolls, but never go below a comfortable size.
+	local heightToFit = math.floor((available.Y - gap * (rows - 1)) / rows)
+	local maxHeight = math.max(Theme.MIN_TILE_HEIGHT, math.floor(width * 1.2))
+	local height = math.clamp(heightToFit, Theme.MIN_TILE_HEIGHT, maxHeight)
+
+	return Vector2.new(width, height)
+end
+
+local function HintRow(props: Props)
+	local function hint(order: number, glyph: Instance, label: string)
+		return create("Frame")({
+			Name = label,
+			LayoutOrder = order,
+			BackgroundTransparency = 1,
+			AutomaticSize = Enum.AutomaticSize.X,
+			Size = UDim2.new(0, 0, 1, 0),
+			Visible = function()
+				return props.mode() ~= "Touch"
+			end,
+
+			create("UIListLayout")({
+				FillDirection = Enum.FillDirection.Horizontal,
+				VerticalAlignment = Enum.VerticalAlignment.Center,
+				Padding = UDim.new(0, 6),
+				SortOrder = Enum.SortOrder.LayoutOrder,
+			}),
+			glyph,
+			create("TextLabel")({
+				LayoutOrder = 2,
+				BackgroundTransparency = 1,
+				AutomaticSize = Enum.AutomaticSize.X,
+				Size = UDim2.new(0, 0, 1, 0),
+				Font = Theme.Font,
+				Text = label,
+				TextColor3 = Theme.TextMuted,
+				TextSize = Theme.TEXT_BODY,
+			}),
+		})
+	end
+
+	return create("Frame")({
+		Name = "Hints",
+		BackgroundTransparency = 1,
+		Size = UDim2.fromScale(1, 1),
+		Visible = function()
+			return props.message() == nil
+		end,
+
+		create("UIListLayout")({
+			FillDirection = Enum.FillDirection.Horizontal,
+			HorizontalAlignment = Enum.HorizontalAlignment.Center,
+			VerticalAlignment = Enum.VerticalAlignment.Center,
+			Padding = UDim.new(0, 18),
+			SortOrder = Enum.SortOrder.LayoutOrder,
+		}),
+
+		-- Touch: one plain sentence, no buttons to learn.
+		create("TextLabel")({
+			Name = "TouchHint",
+			LayoutOrder = 0,
+			BackgroundTransparency = 1,
+			AutomaticSize = Enum.AutomaticSize.X,
+			Size = UDim2.new(0, 0, 1, 0),
+			Font = Theme.Font,
+			Text = "Tap a block to build with it",
+			TextColor3 = Theme.TextMuted,
+			TextSize = Theme.TEXT_BODY,
+			Visible = function()
+				return props.mode() == "Touch"
+			end,
+		}),
+
+		hint(
+			1,
+			ButtonGlyph({
+				mode = props.mode,
+				keyText = `{props.keyTexts[1]}-{props.keyTexts[#props.keyTexts]}`,
+				gamepadButton = Enum.KeyCode.ButtonA,
+				LayoutOrder = 1,
+			}),
+			"Pick"
+		),
+		hint(
+			2,
+			ButtonGlyph({
+				mode = props.mode,
+				keyText = props.toggleKeyText,
+				gamepadButton = Enum.KeyCode.ButtonB,
+				LayoutOrder = 1,
+			}),
+			"Close"
+		),
+	})
+end
+
+local function InventoryPanel(props: Props)
+	local gridSize = source(Vector2.zero)
+	local cellSize = derive(function()
+		return computeCellSize(gridSize())
+	end)
+
+	local panelScale = spring(function()
+		return if props.isOpen() then 1 else 0.9
+	end, 0.18, 0.65)
+
+	local tiles = {}
+	for index, blockType in BlockTypes.List do
+		local name = blockType.Name
+		tiles[index] = BlockTile({
+			blockType = blockType,
+			layoutOrder = index,
+			keyText = props.keyTexts[index],
+			count = function()
+				return props.count(name)
+			end,
+			unlockLevel = props.unlockLevel(name),
+			isUnlocked = function()
