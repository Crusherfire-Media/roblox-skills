@@ -0,0 +1,420 @@
+--[[
+	The inventory screen: a dimmed backdrop and a centred panel with the player's level, a grid of
+	every block type, and an info bar that explains the tile in focus and which buttons to press.
+
+	Returns two ScreenGuis. The backdrop covers the whole screen, notch included; the panel stays
+	inside the device safe area.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Vide = require(ReplicatedStorage.Packages.Vide)
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+
+local BlockInventory = require(script.Parent.Parent.Parent.BlockInventory)
+local BlockTile = require(script.Parent.BlockTile)
+local Format = require(script.Parent.Parent.Format)
+local InventoryState = require(script.Parent.Parent.InventoryState)
+local Theme = require(script.Parent.Parent.Theme)
+
+local create = Vide.create
+local source = Vide.source
+local derive = Vide.derive
+local spring = Vide.spring
+local changed = Vide.changed
+local switch = Vide.switch
+
+-- Inner padding of the grid. Leaves room for a focused tile to grow and for its outline.
+local GRID_PADDING = 8
+
+export type Props = {
+	onChoose: (name: string) -> (),
+	onClose: () -> (),
+}
+
+local function corner(radius: number)
+	return create("UICorner")({ CornerRadius = UDim.new(0, radius) })
+end
+
+local function ButtonGlyph(keyCode: Enum.KeyCode, layoutOrder: number)
+	return create("ImageLabel")({
+		LayoutOrder = layoutOrder,
+		Size = UDim2.fromOffset(28, 28),
+		BackgroundTransparency = 1,
+		-- Reread when the input mode changes, so a newly connected controller shows its own art.
+		Image = function()
+			InventoryState.inputMode()
+			return Format.buttonImage(keyCode)
+		end,
+	})
+end
+
+local function HintLabel(text: string, layoutOrder: number)
+	return create("TextLabel")({
+		LayoutOrder = layoutOrder,
+		Size = UDim2.fromOffset(0, 28),
+		AutomaticSize = Enum.AutomaticSize.X,
+		BackgroundTransparency = 1,
+		FontFace = Theme.BodyFont,
+		TextSize = 18,
+		TextColor3 = Theme.TextDim,
+		Text = text,
+	})
+end
+
+local function Keycap(key: string, layoutOrder: number)
+	return create("TextLabel")({
+		LayoutOrder = layoutOrder,
+		Size = UDim2.fromOffset(28, 28),
+		BackgroundColor3 = Theme.Header,
+		FontFace = Theme.Font,
+		TextSize = 16,
+		TextColor3 = Theme.Text,
+		Text = key,
+		corner(6),
+		create("UIStroke")({ Color = Theme.TextDim, Thickness = 1 }),
+	})
+end
+
+type Info = { text: string, isLocked: boolean }
+
+-- What the info bar says about one block type.
+local function describe(name: string): Info
+	local blockType = BlockTypes.ByName[name]
+	if not BlockInventory.isUnlocked(name) then
+		local unlockLevel = BlockInventory.getUnlockLevel(name)
+		local level = BlockInventory.getLevel()
+		return {
+			text = `🔒 {blockType.DisplayName} unlocks at level {unlockLevel}. You're level {level}.`,
+			isLocked = true,
+		}
+	end
+
+	local count = BlockInventory.getCount(name)
+	local amount = if count == 0
+		then "you don't have any yet"
+		elseif count == 1 then "1 block"
+		else `{count} blocks`
+	if InventoryState.selectedName() == name then
+		return {
+			text = `{blockType.DisplayName}: {amount}. You're building with this one.`,
+			isLocked = false,
+		}
+	end
+	return { text = `{blockType.DisplayName}: {amount}.`, isLocked = false }
+end
+
+local DEFAULT_INFO = {
+	Touch = "Tap a block to build with it.",
+	KeyboardMouse = "Click a block to build with it.",
+	Gamepad = "Choose a block to build with.",
+}
+
+local function InventoryScreen(props: Props)
+	local isOpen = InventoryState.isOpen
+	local inputMode = InventoryState.inputMode
+
+	local gridWindow = source(Vector2.zero)
+	local cellSize = derive(function()
+		local window = gridWindow()
+		local width = window.X - GRID_PADDING * 2
+		local height = window.Y - GRID_PADDING * 2
+		local gap = Theme.TileGap
+
+		local columns =
+			math.clamp(math.floor((width + gap) / (Theme.TileMinWidth + gap)), 1, Theme.MaxColumns)
+		local cellWidth = math.floor((width - gap * (columns - 1)) / columns)
+		-- Prefer two rows that fit without scrolling; scroll only when even that is too short.
+		local cellHeight = math.clamp(
+			math.floor(math.min(cellWidth * 1.05, (height - gap) / 2)),
+			Theme.TileMinHeight,
+			Theme.TileMaxHeight
+		)
+		return UDim2.fromOffset(math.max(cellWidth, Theme.TileMinWidth), cellHeight)
+	end)
+
+	local panelScale = spring(function()
+		return if isOpen() then 1 else 0.85
+	end, 0.25, 0.65)
+
+	local info = derive(function(): Info
+		InventoryState.revision()
+		local focused = InventoryState.focusedName()
+		if focused then
+			return describe(focused)
+		end
+		return { text = DEFAULT_INFO[inputMode()], isLocked = false }
+	end)
+
+	local tiles = {}
+	for slot, blockType in BlockTypes.List do
+		tiles[slot] = BlockTile({
+			blockType = blockType,
+			slot = slot,
+			onChoose = props.onChoose,
+		})
+	end
+
+	local backdrop = create("ScreenGui")({
+		Name = "BlockInventoryBackdrop",
+		ResetOnSpawn = false,
+		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
+		ScreenInsets = Enum.ScreenInsets.None,
+		DisplayOrder = 10,
+		Enabled = isOpen,
+
+		create("TextButton")({
+			Name = "Backdrop",
+			Size = UDim2.fromScale(1, 1),
+			BackgroundColor3 = Theme.Backdrop,
+			BackgroundTransparency = Theme.BackdropTransparency,
+			AutoButtonColor = false,
+			Selectable = false,
+			Text = "",
+			-- Frees the mouse from shift lock and first person so the panel can be clicked.
+			Modal = true,
+			Activated = props.onClose,
+		}),
+	})
+
+	local panelGui = create("ScreenGui")({
+		Name = "BlockInventory",
+		ResetOnSpawn = false,
+		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
+		ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets,
+		DisplayOrder = 11,
+		Enabled = isOpen,
+
+		create("Frame")({
+			Name = "Panel",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0.5),
+			Size = UDim2.fromScale(0.94, 0.94),
+			BackgroundColor3 = Theme.Panel,
+			-- Stops clicks and taps on the panel from reaching the backdrop and closing it.
+			Active = true,
+			-- Keeps controller selection inside the panel while it is open.
+			SelectionGroup = true,
+			SelectionBehaviorUp = Enum.SelectionBehavior.Stop,
+			SelectionBehaviorDown = Enum.SelectionBehavior.Stop,
+			SelectionBehaviorLeft = Enum.SelectionBehavior.Stop,
+			SelectionBehaviorRight = Enum.SelectionBehavior.Stop,
+
+			create("UISizeConstraint")({ MaxSize = Vector2.new(760, 520) }),
+			create("UIScale")({ Scale = panelScale }),
+			corner(20),
+			create("UIStroke")({ Color = Theme.PanelStroke, Thickness = 4 }),
+
+			create("Frame")({
+				Name = "Header",
+				Size = UDim2.new(1, 0, 0, Theme.HeaderHeight),
+				BackgroundColor3 = Theme.Header,
+
+				corner(20),
+				create("UIPadding")({
+					PaddingLeft = UDim.new(0, 16),
+					PaddingRight = UDim.new(0, 6),
+				}),
+
+				create("Frame")({
+					Name = "Titles",
+					Size = UDim2.new(1, -(Theme.TouchTarget + 48), 1, 0),
+					BackgroundTransparency = 1,
+
+					create("UIListLayout")({
+						FillDirection = Enum.FillDirection.Horizontal,
+						VerticalAlignment = Enum.VerticalAlignment.Center,
+						Padding = UDim.new(0, 12),
+						SortOrder = Enum.SortOrder.LayoutOrder,
+					}),
+					create("TextLabel")({
+						Name = "Title",
+						LayoutOrder = 1,
+						Size = UDim2.fromOffset(0, 36),
+						AutomaticSize = Enum.AutomaticSize.X,
+						BackgroundTransparency = 1,
+						FontFace = Theme.Font,
+						TextSize = 30,
+						TextColor3 = Theme.Text,
+						Text = "My Blocks",
+					}),
+					create("TextLabel")({
+						Name = "Level",
+						LayoutOrder = 2,
+						Size = UDim2.fromOffset(0, 30),
+						AutomaticSize = Enum.AutomaticSize.X,
+						BackgroundColor3 = Theme.LevelPill,
+						FontFace = Theme.Font,
+						TextSize = 20,
+						TextColor3 = Theme.TextShadow,
+						Text = function()
+							InventoryState.revision()
+							return `Level {BlockInventory.getLevel()}`
+						end,
+						corner(15),
+						create("UIPadding")({
+							PaddingLeft = UDim.new(0, 12),
+							PaddingRight = UDim.new(0, 12),
+						}),
+					}),
+				}),
+
+				create("Frame")({
+					Name = "CloseArea",
+					AnchorPoint = Vector2.new(1, 0.5),
+					Position = UDim2.fromScale(1, 0.5),
+					Size = UDim2.fromOffset(0, Theme.TouchTarget),
+					AutomaticSize = Enum.AutomaticSize.X,
+					BackgroundTransparency = 1,
+
+					create("UIListLayout")({
+						FillDirection = Enum.FillDirection.Horizontal,
+						HorizontalAlignment = Enum.HorizontalAlignment.Right,
+						VerticalAlignment = Enum.VerticalAlignment.Center,
+						Padding = UDim.new(0, 6),
+						SortOrder = Enum.SortOrder.LayoutOrder,
+					}),
+					create("ImageLabel")({
+						Name = "CloseGlyph",
+						LayoutOrder = 1,
+						Size = UDim2.fromOffset(32, 32),
+						BackgroundTransparency = 1,
+						Image = function()
+							inputMode()
+							return Format.buttonImage(Enum.KeyCode.ButtonB)
+						end,
+						Visible = function()
+							return inputMode() == "Gamepad"
+						end,
+					}),
+					create("TextButton")({
+						Name = "Close",
+						LayoutOrder = 2,
+						Size = UDim2.fromOffset(Theme.TouchTarget, Theme.TouchTarget),
+						BackgroundColor3 = Theme.CloseButton,
+						FontFace = Theme.Font,
+						TextSize = 26,
+						TextColor3 = Theme.Text,
+						Text = "✕",
+						-- Controller players close with B, so the selection only moves between tiles.
+						Selectable = false,
+						Activated = props.onClose,
+						corner(14),
+						create("UIStroke")({
+							ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+							Color = Theme.PanelStroke,
+							Thickness = 2,
+						}),
+					}),
+				}),
+			}),
+
+			create("ScrollingFrame")({
+				Name = "Grid",
+				Position = UDim2.fromOffset(0, Theme.HeaderHeight),
+				Size = UDim2.new(1, 0, 1, -(Theme.HeaderHeight + Theme.FooterHeight)),
+				BackgroundTransparency = 1,
+				BorderSizePixel = 0,
+				Selectable = false,
+				ScrollingDirection = Enum.ScrollingDirection.Y,
+				CanvasSize = UDim2.new(),
+				AutomaticCanvasSize = Enum.AutomaticSize.Y,
+				ScrollBarThickness = 6,
+				ScrollBarImageColor3 = Theme.TextDim,
+
+				changed("AbsoluteWindowSize", gridWindow),
+
+				create("UIPadding")({
+					PaddingTop = UDim.new(0, GRID_PADDING),
+					PaddingBottom = UDim.new(0, GRID_PADDING),
+					PaddingLeft = UDim.new(0, GRID_PADDING),
+					PaddingRight = UDim.new(0, GRID_PADDING),
+				}),
+				create("UIGridLayout")({
+					CellSize = cellSize,
+					CellPadding = UDim2.fromOffset(Theme.TileGap, Theme.TileGap),
+					HorizontalAlignment = Enum.HorizontalAlignment.Center,
+					SortOrder = Enum.SortOrder.LayoutOrder,
+				}),
+
+				tiles,
+			}),
+
+			create("Frame")({
+				Name = "InfoBar",
+				AnchorPoint = Vector2.new(0, 1),
+				Position = UDim2.fromScale(0, 1),
+				Size = UDim2.new(1, 0, 0, Theme.FooterHeight),
+				BackgroundTransparency = 1,
+
+				create("UIPadding")({
+					PaddingLeft = UDim.new(0, 16),
+					PaddingRight = UDim.new(0, 16),
+					PaddingBottom = UDim.new(0, 6),
+				}),
+				create("UIListLayout")({
+					FillDirection = Enum.FillDirection.Horizontal,
+					VerticalAlignment = Enum.VerticalAlignment.Center,
+					Padding = UDim.new(0, 16),
+					SortOrder = Enum.SortOrder.LayoutOrder,
+				}),
+
+				create("TextLabel")({
+					Name = "Info",
+					LayoutOrder = 1,
+					Size = UDim2.fromScale(1, 1),
+					BackgroundTransparency = 1,
+					FontFace = Theme.BodyFont,
+					TextScaled = true,
+					TextXAlignment = Enum.TextXAlignment.Left,
+					TextColor3 = function()
+						return if info().isLocked then Theme.Locked else Theme.Text
+					end,
+					Text = function()
+						return info().text
+					end,
+					create("UITextSizeConstraint")({ MinTextSize = 12, MaxTextSize = 20 }),
+					create("UIFlexItem")({ FlexMode = Enum.UIFlexMode.Shrink }),
+				}),
+
+				create("Frame")({
+					Name = "Controls",
+					LayoutOrder = 2,
+					Size = UDim2.fromScale(0, 1),
+					AutomaticSize = Enum.AutomaticSize.X,
+					BackgroundTransparency = 1,
+
+					create("UIListLayout")({
+						FillDirection = Enum.FillDirection.Horizontal,
+						VerticalAlignment = Enum.VerticalAlignment.Center,
+						Padding = UDim.new(0, 6),
+						SortOrder = Enum.SortOrder.LayoutOrder,
+					}),
+
+					-- Touch players get no hints here: they have the big close button and can tap
+					-- outside the panel.
+					switch(inputMode)({
+						Gamepad = function()
+							return {
+								ButtonGlyph(Enum.KeyCode.ButtonA, 1),
+								HintLabel("Choose", 2),
+								ButtonGlyph(Enum.KeyCode.ButtonB, 3),
+								HintLabel("Close", 4),
+							}
+						end,
+						KeyboardMouse = function()
+							return {
+								Keycap("B", 1),
+								HintLabel("Close", 2),
+							}
+						end,
+					}),
+				}),
+			}),
+		}),
+	})
+
+	return { backdrop, panelGui }
+end
+
+return InventoryScreen
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Format.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Format.luau
