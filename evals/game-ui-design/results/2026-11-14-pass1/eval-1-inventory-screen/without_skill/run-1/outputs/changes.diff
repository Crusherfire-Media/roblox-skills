diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile.luau
new file mode 100644
index 0000000..97b2db6
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/BlockTile.luau
@@ -0,0 +1,299 @@
+--[[
+	One block type in the inventory grid: a swatch of the block, its name and how many the player
+	has. Locked types are dimmed with a padlock and the level that unlocks them. The block being
+	built with gets a gold outline and a tick.
+
+	Pressing an unlocked tile calls onChoose. Pressing a locked tile shakes it and shows why it is
+	locked in the screen's info bar instead.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Vide = require(ReplicatedStorage.Packages.Vide)
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+
+local BlockInventory = require(script.Parent.Parent.Parent.BlockInventory)
+local Format = require(script.Parent.Parent.Format)
+local InventoryState = require(script.Parent.Parent.InventoryState)
+local Theme = require(script.Parent.Parent.Theme)
+
+local create = Vide.create
+local source = Vide.source
+local derive = Vide.derive
+local spring = Vide.spring
+local action = Vide.action
+
+-- Sideways kick given to a locked tile when it is pressed, in pixels per second.
+local SHAKE_IMPULSE = 420
+
+export type Props = {
+	blockType: BlockTypes.BlockType,
+	-- Position in the hotbar, 1 to 10. Slot 10 is the 0 key.
+	slot: number,
+	onChoose: (name: string) -> (),
+}
+
+local function corner(radius: number)
+	return create("UICorner")({ CornerRadius = UDim.new(0, radius) })
+end
+
+local function BlockTile(props: Props)
+	local blockType = props.blockType
+	local name = blockType.Name
+	local unlockLevel = BlockInventory.getUnlockLevel(name)
+
+	local count = derive(function()
+		InventoryState.revision()
+		return BlockInventory.getCount(name)
+	end)
+	local isLocked = derive(function()
+		InventoryState.revision()
+		return not BlockInventory.isUnlocked(name)
+	end)
+	local isEquipped = derive(function()
+		return InventoryState.selectedName() == name
+	end)
+
+	local isHovered = source(false)
+	local isGamepadSelected = source(false)
+	local isFocused = derive(function()
+		return isGamepadSelected()
+			or (isHovered() and InventoryState.inputMode() == "KeyboardMouse")
+	end)
+
+	local scale = spring(function()
+		return if isFocused() then 1.06 else 1
+	end, 0.18, 0.7)
+	local shake, shakeSettings = spring(function()
+		return 0
+	end, 0.3, 0.25)
+
+	local function focus()
+		InventoryState.focusedName(name)
+	end
+	local function unfocus()
+		if InventoryState.focusedName() == name then
+			InventoryState.focusedName(nil)
+		end
+	end
+
+	local function onActivated()
+		if isLocked() then
+			shakeSettings({ impulse = SHAKE_IMPULSE })
+			focus()
+			return
+		end
+		props.onChoose(name)
+	end
+
+	return create("TextButton")({
+		Name = name,
+		LayoutOrder = props.slot,
+		Text = "",
+		AutoButtonColor = false,
+		Selectable = true,
+		-- The tile draws its own focus outline, so hide Roblox's default selection box.
+		SelectionImageObject = create("Frame")({ BackgroundTransparency = 1 }),
+		BackgroundColor3 = function()
+			if isLocked() then
+				return Theme.TileLocked
+			end
+			return if isFocused() then Theme.TileHover else Theme.Tile
+		end,
+
+		Activated = onActivated,
+		MouseEnter = function()
+			isHovered(true)
+			if InventoryState.inputMode() == "KeyboardMouse" then
+				focus()
+			end
+		end,
+		MouseLeave = function()
+			isHovered(false)
+			unfocus()
+		end,
+		SelectionGained = function()
+			isGamepadSelected(true)
+			focus()
+		end,
+		SelectionLost = function()
+			isGamepadSelected(false)
+			unfocus()
+		end,
+
+		action(function(instance)
+			InventoryState.tileButtons[name] = instance :: GuiObject
+		end),
+
+		corner(14),
+		create("UIScale")({ Scale = scale }),
+		create("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			Color = function()
+				if isEquipped() then
+					return Theme.Equipped
+				end
+				return if isFocused() then Theme.Focus else Theme.PanelStroke
+			end,
+			Thickness = function()
+				if isEquipped() then
+					return 4
+				end
+				return if isFocused() then 3 else 2
+			end,
+		}),
+
+		-- Everything inside moves together when a locked tile shakes.
+		create("Frame")({
+			Name = "Content",
+			BackgroundTransparency = 1,
+			Size = UDim2.fromScale(1, 1),
+			Position = function()
+				return UDim2.fromOffset(shake(), 0)
+			end,
+
+			create("Frame")({
+				Name = "Swatch",
+				AnchorPoint = Vector2.new(0.5, 0),
+				Position = UDim2.new(0.5, 0, 0, 10),
+				Size = UDim2.new(1, -24, 1, -48),
+				BackgroundColor3 = blockType.Color,
+				BackgroundTransparency = blockType.Transparency * 0.6,
+
+				create("UIAspectRatioConstraint")({ AspectRatio = 1 }),
+				corner(8),
+				create("UIStroke")({
+					Color = blockType.Color:Lerp(Color3.new(0, 0, 0), 0.45),
+					Thickness = 3,
+				}),
+				create("UIGradient")({
+					Rotation = 90,
+					Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170)),
+				}),
+
+				create("TextLabel")({
+					Name = "Count",
+					AnchorPoint = Vector2.new(1, 1),
+					Position = UDim2.new(1, 8, 1, 6),
+					Size = UDim2.fromOffset(0, 26),
+					AutomaticSize = Enum.AutomaticSize.X,
+					BackgroundColor3 = Theme.TextShadow,
+					BackgroundTransparency = 0.15,
+					FontFace = Theme.Font,
+					TextSize = 20,
+					TextColor3 = function()
+						return if count() > 0 then Theme.Text else Theme.TextDim
+					end,
+					Text = function()
+						return Format.count(count())
+					end,
+					Visible = function()
+						return not isLocked()
+					end,
+					ZIndex = 2,
+
+					corner(13),
+					create("UIPadding")({
+						PaddingLeft = UDim.new(0, 8),
+						PaddingRight = UDim.new(0, 8),
+					}),
+				}),
+			}),
+
+			create("TextLabel")({
+				Name = "DisplayName",
+				AnchorPoint = Vector2.new(0.5, 1),
+				Position = UDim2.new(0.5, 0, 1, -8),
+				Size = UDim2.new(1, -12, 0, 22),
+				BackgroundTransparency = 1,
+				FontFace = Theme.Font,
+				TextSize = 18,
+				TextColor3 = Theme.Text,
+				TextTruncate = Enum.TextTruncate.AtEnd,
+				Text = blockType.DisplayName,
+			}),
+
+			-- Number key that selects this block, shown only to keyboard players.
+			create("TextLabel")({
+				Name = "Hotkey",
+				Position = UDim2.fromOffset(6, 6),
+				Size = UDim2.fromOffset(22, 22),
+				BackgroundColor3 = Theme.TextShadow,
+				BackgroundTransparency = 0.3,
+				FontFace = Theme.BodyFont,
+				TextSize = 15,
+				TextColor3 = Theme.TextDim,
+				Text = tostring(props.slot % 10),
+				Visible = function()
+					return InventoryState.inputMode() == "KeyboardMouse" and not isLocked()
+				end,
+				ZIndex = 3,
+				corner(6),
+			}),
+
+			create("TextLabel")({
+				Name = "EquippedTick",
+				AnchorPoint = Vector2.new(1, 0),
+				Position = UDim2.new(1, -6, 0, 6),
+				Size = UDim2.fromOffset(26, 26),
+				BackgroundColor3 = Theme.Equipped,
+				FontFace = Theme.Font,
+				TextSize = 18,
+				TextColor3 = Theme.TextShadow,
+				Text = "✓",
+				Visible = isEquipped,
+				ZIndex = 3,
+				corner(13),
+			}),
+
+			create("Frame")({
+				Name = "LockedCover",
+				Size = UDim2.fromScale(1, 1),
+				BackgroundColor3 = Theme.Backdrop,
+				BackgroundTransparency = 0.35,
+				Visible = isLocked,
+				ZIndex = 4,
+
+				corner(14),
+				create("UIListLayout")({
+					FillDirection = Enum.FillDirection.Vertical,
+					HorizontalAlignment = Enum.HorizontalAlignment.Center,
+					VerticalAlignment = Enum.VerticalAlignment.Center,
+					Padding = UDim.new(0, 2),
+					SortOrder = Enum.SortOrder.LayoutOrder,
+				}),
+				create("TextLabel")({
+					LayoutOrder = 1,
+					Size = UDim2.new(1, 0, 0, 34),
+					BackgroundTransparency = 1,
+					TextSize = 30,
+					Text = "🔒",
+					ZIndex = 4,
+				}),
+				create("TextLabel")({
+					LayoutOrder = 2,
+					Size = UDim2.new(1, -8, 0, 22),
+					BackgroundTransparency = 1,
+					FontFace = Theme.Font,
+					TextSize = 18,
+					TextColor3 = Theme.Text,
+					Text = `Level {unlockLevel}`,
+					ZIndex = 4,
+				}),
+				create("TextLabel")({
+					LayoutOrder = 3,
+					Size = UDim2.new(1, -8, 0, 18),
+					BackgroundTransparency = 1,
+					FontFace = Theme.BodyFont,
+					TextSize = 14,
+					TextColor3 = Theme.TextDim,
+					TextTruncate = Enum.TextTruncate.AtEnd,
+					Text = blockType.DisplayName,
+					ZIndex = 4,
+				}),
+			}),
+		}),
+	})
+end
+
+return BlockTile
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryButton.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryButton.luau
new file mode 100644
index 0000000..bab829e
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/InventoryButton.luau
@@ -0,0 +1,193 @@
+--[[
+	Always-visible button at the bottom centre of the screen that shows the block being built with
+	and how many are left, and opens the inventory screen. Bottom centre stays clear of the mobile
+	thumbstick (bottom left) and jump button (bottom right).
+
+	It also shows the shortcut for the current input: the B key, or the controller's Y button.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Vide = require(ReplicatedStorage.Packages.Vide)
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+
+local BlockInventory = require(script.Parent.Parent.Parent.BlockInventory)
+local Format = require(script.Parent.Parent.Format)
+local InventoryState = require(script.Parent.Parent.InventoryState)
+local Theme = require(script.Parent.Parent.Theme)
+
+local create = Vide.create
+local derive = Vide.derive
+local source = Vide.source
+local spring = Vide.spring
+local switch = Vide.switch
+
+local BUTTON_HEIGHT = 64
+
+export type Props = {
+	onOpen: () -> (),
+}
+
+local function corner(radius: number)
+	return create("UICorner")({ CornerRadius = UDim.new(0, radius) })
+end
+
+local function InventoryButton(props: Props)
+	local inputMode = InventoryState.inputMode
+	local selected = derive(function()
+		return BlockTypes.ByName[InventoryState.selectedName()]
+	end)
+	local count = derive(function()
+		InventoryState.revision()
+		return BlockInventory.getCount(InventoryState.selectedName())
+	end)
+
+	local isPressed = source(false)
+	local scale = spring(function()
+		return if isPressed() then 0.94 else 1
+	end, 0.15, 0.7)
+
+	return create("ScreenGui")({
+		Name = "BlockHud",
+		ResetOnSpawn = false,
+		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
+		ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets,
+		DisplayOrder = 5,
+		Enabled = function()
+			return not InventoryState.isOpen()
+		end,
+
+		create("TextButton")({
+			Name = "OpenInventory",
+			AnchorPoint = Vector2.new(0.5, 1),
+			Position = UDim2.new(0.5, 0, 1, -12),
+			Size = UDim2.fromOffset(0, BUTTON_HEIGHT),
+			AutomaticSize = Enum.AutomaticSize.X,
+			BackgroundColor3 = Theme.Panel,
+			BackgroundTransparency = 0.1,
+			AutoButtonColor = false,
+			-- Controller players open the screen with Y, so the button never takes selection.
+			Selectable = false,
+			Text = "",
+
+			Activated = props.onOpen,
+			InputBegan = function(input: InputObject)
+				if
+					input.UserInputType == Enum.UserInputType.MouseButton1
+					or input.UserInputType == Enum.UserInputType.Touch
+				then
+					isPressed(true)
+				end
+			end,
+			InputEnded = function()
+				isPressed(false)
+			end,
+
+			corner(18),
+			create("UIScale")({ Scale = scale }),
+			create("UIStroke")({
+				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+				Color = Theme.PanelStroke,
+				Thickness = 3,
+			}),
+			create("UIPadding")({
+				PaddingLeft = UDim.new(0, 8),
+				PaddingRight = UDim.new(0, 14),
+			}),
+			create("UIListLayout")({
+				FillDirection = Enum.FillDirection.Horizontal,
+				VerticalAlignment = Enum.VerticalAlignment.Center,
+				Padding = UDim.new(0, 10),
+				SortOrder = Enum.SortOrder.LayoutOrder,
+			}),
+
+			create("Frame")({
+				Name = "Swatch",
+				LayoutOrder = 1,
+				Size = UDim2.fromOffset(48, 48),
+				BackgroundColor3 = function()
+					return selected().Color
+				end,
+				BackgroundTransparency = function()
+					return selected().Transparency * 0.6
+				end,
+
+				corner(8),
+				create("UIStroke")({
+					Color = Theme.Equipped,
+					Thickness = 3,
+				}),
+				create("UIGradient")({
+					Rotation = 90,
+					Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(170, 170, 170)),
+				}),
+			}),
+
+			create("Frame")({
+				Name = "Labels",
+				LayoutOrder = 2,
+				Size = UDim2.fromOffset(0, 48),
+				AutomaticSize = Enum.AutomaticSize.X,
+				BackgroundTransparency = 1,
+
+				create("UIListLayout")({
+					FillDirection = Enum.FillDirection.Vertical,
+					VerticalAlignment = Enum.VerticalAlignment.Center,
+					SortOrder = Enum.SortOrder.LayoutOrder,
+				}),
+				create("TextLabel")({
+					LayoutOrder = 1,
+					Size = UDim2.fromOffset(0, 24),
+					AutomaticSize = Enum.AutomaticSize.X,
+					BackgroundTransparency = 1,
+					FontFace = Theme.Font,
+					TextSize = 22,
+					TextColor3 = Theme.Text,
+					TextXAlignment = Enum.TextXAlignment.Left,
+					Text = "Blocks",
+				}),
+				create("TextLabel")({
+					LayoutOrder = 2,
+					Size = UDim2.fromOffset(0, 20),
+					AutomaticSize = Enum.AutomaticSize.X,
+					BackgroundTransparency = 1,
+					FontFace = Theme.BodyFont,
+					TextSize = 17,
+					TextColor3 = Theme.TextDim,
+					TextXAlignment = Enum.TextXAlignment.Left,
+					Text = function()
+						return `{selected().DisplayName} x{Format.count(count())}`
+					end,
+				}),
+			}),
+
+			switch(inputMode)({
+				KeyboardMouse = function()
+					return create("TextLabel")({
+						Name = "Shortcut",
+						LayoutOrder = 3,
+						Size = UDim2.fromOffset(30, 30),
+						BackgroundColor3 = Theme.Header,
+						FontFace = Theme.Font,
+						TextSize = 18,
+						TextColor3 = Theme.Text,
+						Text = "B",
+						corner(6),
+						create("UIStroke")({ Color = Theme.TextDim, Thickness = 1 }),
+					})
+				end,
+				Gamepad = function()
+					return create("ImageLabel")({
+						Name = "Shortcut",
+						LayoutOrder = 3,
+						Size = UDim2.fromOffset(34, 34),
+						BackgroundTransparency = 1,
+						Image = Format.buttonImage(Enum.KeyCode.ButtonY),
+					})
+				end,
+			}),
+		}),
+	})
+end
+
+return InventoryButton
