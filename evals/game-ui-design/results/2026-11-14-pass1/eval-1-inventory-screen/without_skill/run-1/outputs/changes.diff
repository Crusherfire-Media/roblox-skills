@@ -0,0 +1,30 @@
+--[[
+	Text helpers for the inventory UI.
+]]
+
+local UserInputService = game:GetService("UserInputService")
+
+local Format = {}
+
+--[[
+	Short count for a tile badge: 999, 1.2K, 15K.
+]]
+function Format.count(count: number): string
+	if count >= 10000 then
+		return `{math.floor(count / 1000)}K`
+	elseif count >= 1000 then
+		return `{math.floor(count / 100) / 10}K`
+	end
+	return tostring(count)
+end
+
+--[[
+	The image Roblox uses for a gamepad button on the connected controller (Xbox, PlayStation and so
+	on), or "" if there isn't one.
+]]
+function Format.buttonImage(keyCode: Enum.KeyCode): string
+	local ok, image = pcall(UserInputService.GetImageForKeyCode, UserInputService, keyCode)
+	return if ok and typeof(image) == "string" then image else ""
+end
+
+return Format
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryState.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryState.luau
new file mode 100644
index 0000000..f78aa22
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryState.luau
@@ -0,0 +1,105 @@
+--[[
+	Vide sources the inventory UI reads: whether the screen is open, which kind of input the player
+	used last, the selected block type, and a revision number that ticks whenever BlockInventory
+	changes. Call start() once before mounting any UI that reads them.
+]]
+
+local GuiService = game:GetService("GuiService")
+local UserInputService = game:GetService("UserInputService")
+
+local Vide = require(game:GetService("ReplicatedStorage").Packages.Vide)
+
+local BlockInventory = require(script.Parent.Parent.BlockInventory)
+local BlockPlacer = require(script.Parent.Parent.BlockPlacer)
+
+local source = Vide.source
+
+export type InputMode = "Touch" | "KeyboardMouse" | "Gamepad"
+
+local GAMEPAD_INPUTS = {
+	[Enum.UserInputType.Gamepad1] = true,
+	[Enum.UserInputType.Gamepad2] = true,
+	[Enum.UserInputType.Gamepad3] = true,
+	[Enum.UserInputType.Gamepad4] = true,
+	[Enum.UserInputType.Gamepad5] = true,
+	[Enum.UserInputType.Gamepad6] = true,
+	[Enum.UserInputType.Gamepad7] = true,
+	[Enum.UserInputType.Gamepad8] = true,
+}
+
+local KEYBOARD_MOUSE_INPUTS = {
+	[Enum.UserInputType.Keyboard] = true,
+	[Enum.UserInputType.MouseButton1] = true,
+	[Enum.UserInputType.MouseButton2] = true,
+	[Enum.UserInputType.MouseButton3] = true,
+	[Enum.UserInputType.MouseWheel] = true,
+	[Enum.UserInputType.MouseMovement] = true,
+}
+
+-- Returns nil for input types that say nothing about the device, such as Focus or Accelerometer.
+local function modeFor(inputType: Enum.UserInputType): InputMode?
+	if GAMEPAD_INPUTS[inputType] then
+		return "Gamepad"
+	elseif inputType == Enum.UserInputType.Touch then
+		return "Touch"
+	elseif KEYBOARD_MOUSE_INPUTS[inputType] then
+		return "KeyboardMouse"
+	end
+	return nil
+end
+
+local function guessInitialMode(): InputMode
+	local fromLast = modeFor(UserInputService:GetLastInputType())
+	if fromLast then
+		return fromLast
+	end
+	if GuiService:IsTenFootInterface() then
+		return "Gamepad"
+	end
+	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
+		return "Touch"
+	end
+	return "KeyboardMouse"
+end
+
+local InventoryState = {}
+
+InventoryState.isOpen = source(false)
+InventoryState.inputMode = source(guessInitialMode() :: InputMode)
+-- Read this inside a derive or effect to rerun it whenever counts or the player's level change.
+InventoryState.revision = source(0)
+InventoryState.selectedName = source(BlockPlacer.getBlockType())
+-- The tile the player is pointing at, has selected with a controller, or last tapped.
+InventoryState.focusedName = source(nil :: string?)
+
+--[[
+	The tile button for each block type, filled in as tiles are created. The controller uses it to
+	move gamepad selection onto a tile.
+]]
+InventoryState.tileButtons = {} :: { [string]: GuiObject }
+
+local hasStarted = false
+
+function InventoryState.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	UserInputService.LastInputTypeChanged:Connect(function(inputType)
+		local mode = modeFor(inputType)
+		if mode and mode ~= InventoryState.inputMode() then
+			InventoryState.inputMode(mode)
+		end
+	end)
+
+	BlockInventory.Changed:Connect(function()
+		InventoryState.revision(InventoryState.revision() + 1)
+	end)
+
+	BlockPlacer.BlockTypeChanged:Connect(function(name: string)
+		InventoryState.selectedName(name)
+	end)
+end
+
+return InventoryState
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryUI.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryUI.luau
new file mode 100644
index 0000000..8295a93
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryUI.luau
@@ -0,0 +1,194 @@
+--[[
+	Mounts the block inventory UI and handles opening, closing and choosing a block.
+
+	Open: tap or click the Blocks button, press B on a keyboard, or press Y on a controller.
+	Close: the ✕ button, tapping or clicking outside the panel, B on a keyboard, or B on a
+	controller. Choosing an unlocked block also closes the screen.
+
+	While the screen is open, clicking or tapping places no blocks.
+]]
+
+local ContextActionService = game:GetService("ContextActionService")
+local GuiService = game:GetService("GuiService")
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Vide = require(ReplicatedStorage.Packages.Vide)
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+
+local BlockInventory = require(script.Parent.Parent.BlockInventory)
+local BlockPlacer = require(script.Parent.Parent.BlockPlacer)
+local InventoryButton = require(script.Parent.Components.InventoryButton)
+local InventoryScreen = require(script.Parent.Components.InventoryScreen)
+local InventoryState = require(script.Parent.InventoryState)
+
+local TOGGLE_ACTION = "ToggleBlockInventory"
+local CLOSE_ACTION = "CloseBlockInventory"
+
+local InventoryUI = {}
+
+local isOpen = InventoryState.isOpen
+local inputMode = InventoryState.inputMode
+local wasPlacingEnabled = true
+local hasStarted = false
+
+local function isTileButton(object: GuiObject?): boolean
+	if not object then
+		return false
+	end
+	for _, button in InventoryState.tileButtons do
+		if button == object then
+			return true
+		end
+	end
+	return false
+end
+
+-- Puts controller selection on the block being built with, so A picks it straight away.
+local function selectTileForGamepad()
+	if not isOpen() or inputMode() ~= "Gamepad" then
+		return
+	end
+	if isTileButton(GuiService.SelectedObject) then
+		return
+	end
+	local button = InventoryState.tileButtons[InventoryState.selectedName()]
+		or InventoryState.tileButtons[BlockTypes.List[1].Name]
+	if button then
+		GuiService.SelectedObject = button
+	end
+end
+
+local function clearTileSelection()
+	if isTileButton(GuiService.SelectedObject) then
+		GuiService.SelectedObject = nil
+	end
+end
+
+local function onCloseAction(
+	_: string,
+	inputState: Enum.UserInputState,
+	_: InputObject
+): Enum.ContextActionResult
+	if inputState ~= Enum.UserInputState.Begin or not isOpen() then
+		return Enum.ContextActionResult.Pass
+	end
+	InventoryUI.close()
+	return Enum.ContextActionResult.Sink
+end
+
+function InventoryUI.open()
+	if isOpen() then
+		return
+	end
+	wasPlacingEnabled = BlockPlacer.isEnabled()
+	BlockPlacer.setEnabled(false)
+	InventoryState.focusedName(nil)
+	isOpen(true)
+
+	-- Above the default priority so B closes the screen instead of only clearing the selection.
+	ContextActionService:BindActionAtPriority(
+		CLOSE_ACTION,
+		onCloseAction,
+		false,
+		Enum.ContextActionPriority.High.Value,
+		Enum.KeyCode.ButtonB
+	)
+	-- Wait a frame so the ScreenGui is enabled before selection moves into it.
+	task.defer(selectTileForGamepad)
+end
+
+function InventoryUI.close()
+	if not isOpen() then
+		return
+	end
+	isOpen(false)
+	ContextActionService:UnbindAction(CLOSE_ACTION)
+	clearTileSelection()
+	InventoryState.focusedName(nil)
+	BlockPlacer.setEnabled(wasPlacingEnabled)
+end
+
+function InventoryUI.toggle()
+	if isOpen() then
+		InventoryUI.close()
+	else
+		InventoryUI.open()
+	end
+end
+
+--[[
+	Builds with the block type and closes the screen. Locked types are refused; the tile explains
+	why before it gets here.
+]]
+function InventoryUI.choose(name: string)
+	if not BlockInventory.isUnlocked(name) then
+		return
+	end
+	BlockPlacer.setBlockType(name)
+	InventoryUI.close()
+end
+
+local function onToggleAction(
+	_: string,
+	inputState: Enum.UserInputState,
+	_: InputObject
+): Enum.ContextActionResult
+	if inputState ~= Enum.UserInputState.Begin then
+		return Enum.ContextActionResult.Pass
+	end
+	InventoryUI.toggle()
+	return Enum.ContextActionResult.Sink
+end
+
+--[[
+	Mounts the UI into the local player's PlayerGui and binds the open and close controls. Call it
+	once, before BlockPlacer.start(), which yields.
+]]
+function InventoryUI.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	InventoryState.start()
+
+	local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
+	Vide.mount(function()
+		-- Keep controller selection in step with the input the player is using while open.
+		Vide.effect(function()
+			if not isOpen() then
+				return
+			end
+			if inputMode() == "Gamepad" then
+				task.defer(selectTileForGamepad)
+			else
+				clearTileSelection()
+			end
+		end)
+
+		return {
+			InventoryButton({ onOpen = InventoryUI.open }),
+			InventoryScreen({ onChoose = InventoryUI.choose, onClose = InventoryUI.close }),
+		}
+	end, playerGui)
+
+	-- If Roblox clears the selection while a controller player has the screen open (for example
+	-- when B is handled before our binding), close the screen rather than leave it stuck open with
+	-- nothing selected.
+	GuiService:GetPropertyChangedSignal("SelectedObject"):Connect(function()
+		if isOpen() and inputMode() == "Gamepad" and GuiService.SelectedObject == nil then
+			InventoryUI.close()
+		end
+	end)
+
+	ContextActionService:BindAction(
+		TOGGLE_ACTION,
+		onToggleAction,
+		false,
+		Enum.KeyCode.B,
+		Enum.KeyCode.ButtonY
+	)
+end
+
+return InventoryUI
