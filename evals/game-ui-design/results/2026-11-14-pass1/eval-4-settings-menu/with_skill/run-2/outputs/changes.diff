new file mode 100644
index 0000000..5c1a3ce
--- /dev/null
+++ b/src/ServerScriptService/Stories/Components/button.story.luau
@@ -0,0 +1,73 @@
+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const button = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/button")
+
+const CONTROLS = {
+	Content = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Try a long label to check the button grows with its text.
+			Text = UILabs.Ordered("Settings", 1),
+		}),
+		1
+	),
+	State = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Disabled = UILabs.Ordered(false, 1),
+			-- Shows the Y glyph beside the text.
+			IsGamepad = UILabs.Ordered(false, 2),
+		}),
+		2
+	),
+	Look = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Style = UILabs.Ordered(UILabs.Choose({ "Neutral", "Danger" }), 1),
+		}),
+		3
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Content: { Text: () -> string },
+		State: {
+			Disabled: () -> boolean,
+			IsGamepad: () -> boolean,
+		},
+		Look: { Style: () -> string },
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const controls = props.controls
+
+	-- The style decides colors once, so a new choice rebuilds the button.
+	return Vide.indexes(function()
+		return { [controls.Look.Style()] = true }
+	end, function(_, style: string)
+		const instance = button({
+			Name = "StoryButton",
+			Text = controls.Content.Text,
+			Style = if style == "Danger" then "Danger" else "Neutral",
+			Disabled = controls.State.Disabled,
+			GlyphKeyCode = Enum.KeyCode.ButtonY,
+			IsGamepad = controls.State.IsGamepad,
+			Activated = function()
+				print("Button activated")
+			end,
+		})
+		instance.AnchorPoint = Vector2.new(0.5, 0.5)
+		instance.Position = UDim2.fromScale(0.5, 0.5)
+		return instance
+	end)
+end
+
+return {
+	summary = "The shared button in each style and state, with the gamepad glyph.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
diff --git a/src/ServerScriptService/Stories/Components/settingsPanel.story.luau b/src/ServerScriptService/Stories/Components/settingsPanel.story.luau
new file mode 100644
index 0000000..02cbccb
--- /dev/null
+++ b/src/ServerScriptService/Stories/Components/settingsPanel.story.luau
@@ -0,0 +1,99 @@
+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const settingsPanel =
+	require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/settingsPanel")
+
+const source = Vide.source
+
+type DeleteStatus = settingsPanel.DeleteStatus
+type SettingsPage = settingsPanel.SettingsPage
+
+const CONTROLS = {
+	State = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Where the story starts; the panel's own buttons move between
+			-- pages after that. Changing either control starts the story over.
+			Page = UILabs.Ordered(UILabs.Choose({ "Main", "ConfirmDelete" }), 1),
+			DeleteStatus = UILabs.Ordered(UILabs.Choose({ "None", "Deleted", "NotReady" }), 2),
+		}),
+		1
+	),
+	Input = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Shows the B glyph on the button that B presses.
+			IsGamepad = UILabs.Ordered(false, 1),
+		}),
+		2
+	),
+}
+
+type StoryProps = {
+	controls: {
+		State: {
+			Page: () -> string,
+			DeleteStatus: () -> string,
+		},
+		Input: { IsGamepad: () -> boolean },
+	},
+	target: Frame,
+}
+
+local function toDeleteStatus(value: string): DeleteStatus
+	if value == "Deleted" then
+		return "Deleted"
+	elseif value == "NotReady" then
+		return "NotReady"
+	else
+		return "None"
+	end
+end
+
+local function story(props: StoryProps)
+	const controls = props.controls
+
+	return Vide.indexes(function()
+		return { [`{controls.State.Page()}/{controls.State.DeleteStatus()}`] = true }
+	end, function()
+		const startPage: SettingsPage = if controls.State.Page() == "ConfirmDelete"
+			then "ConfirmDelete"
+			else "Main"
+		const page = source(startPage)
+		const deleteStatus = source(toDeleteStatus(controls.State.DeleteStatus()))
+		const musicVolume = source(0.5)
+		const effectsVolume = source(0.8)
+
+		return settingsPanel({
+			Page = page,
+			MusicVolume = musicVolume,
+			SetMusicVolume = musicVolume,
+			EffectsVolume = effectsVolume,
+			SetEffectsVolume = effectsVolume,
+			DeleteStatus = deleteStatus,
+			IsGamepad = controls.Input.IsGamepad,
+			Close = function()
+				print("Close")
+			end,
+			RequestDelete = function()
+				page("ConfirmDelete")
+			end,
+			ConfirmDelete = function()
+				print("Delete my blocks")
+				deleteStatus("Deleted")
+				page("Main")
+			end,
+			CancelDelete = function()
+				page("Main")
+			end,
+		})
+	end)
+end
+
+return {
+	summary = "The settings panel's main and delete-confirmation pages.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
diff --git a/src/ServerScriptService/Stories/Components/volumeRow.story.luau b/src/ServerScriptService/Stories/Components/volumeRow.story.luau
