+
+-- Above the 44 thumb floor, because children miss small targets far more
+-- often than adults.
+Module.ButtonHeight = 56
+Module.CornerRadius = 12
+Module.Gap = 12
+Module.PanelPadding = 20
+Module.FocusStroke = 4
