+--!strict
+--[[
+	Colors, fonts, and sizes shared by the game's UI. Sizes are UI units,
+	authored for a screen 1080 pixels tall (see Screen).
+
+	Text colors keep at least 4.5:1 contrast against the surface they sit on.
+	Panels stay fully opaque: players found see-through menus hard to read
+	over the world.
+]]
+
+local Module = {}
+
+Module.Colors = table.freeze({
+	Backdrop = Color3.fromRGB(0, 0, 0),
+	Panel = Color3.fromRGB(28, 31, 38),
+	PanelStroke = Color3.fromRGB(86, 92, 108),
+	Divider = Color3.fromRGB(64, 69, 82),
+	Text = Color3.fromRGB(255, 255, 255),
+	TextMuted = Color3.fromRGB(200, 205, 214),
+	Focus = Color3.fromRGB(255, 214, 10),
+	Track = Color3.fromRGB(64, 69, 82),
+	TrackFill = Color3.fromRGB(82, 156, 255),
+
+	Neutral = Color3.fromRGB(58, 63, 76),
+	NeutralHover = Color3.fromRGB(74, 80, 96),
+	NeutralPressed = Color3.fromRGB(44, 48, 58),
+	Danger = Color3.fromRGB(176, 38, 32),
+	DangerHover = Color3.fromRGB(196, 50, 42),
+	DangerPressed = Color3.fromRGB(140, 28, 24),
+	Disabled = Color3.fromRGB(44, 48, 58),
+	DisabledText = Color3.fromRGB(150, 155, 166),
+})
+
+Module.Fonts = table.freeze({
