+++ b/src/ServerScriptService/Stories/Components/volumeRow.story.luau
@@ -0,0 +1,69 @@
+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const volumeRow = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/volumeRow")
+
+const create = Vide.create
+const source = Vide.source
+
+const CONTROLS = {
+	Content = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Try a long label to check it wraps instead of spilling.
+			Label = UILabs.Ordered("Sound effects", 1),
+		}),
+		1
+	),
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- In UI units; the settings panel gives its rows 640.
+			Width = UILabs.Ordered(UILabs.Slider(640, 400, 900, 10), 1),
+		}),
+		2
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Content: { Label: () -> string },
+		Layout: { Width: () -> number },
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const controls = props.controls
+	const value = source(0.8)
+
+	return create("Frame")({
+		Name = "RowFrame",
+		AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.5),
+		AutomaticSize = Enum.AutomaticSize.Y,
+		BackgroundColor3 = Color3.fromRGB(28, 31, 38),
+		Size = function()
+			return UDim2.fromOffset(controls.Layout.Width(), 0)
+		end,
+
+		-- The label is read once, so a new label rebuilds the row.
+		Vide.indexes(function()
+			return { [controls.Content.Label()] = true }
+		end, function(_, label: string)
+			return volumeRow({
+				Name = "StoryRow",
+				Label = label,
+				Value = value,
+				SetValue = value,
+			})
+		end),
+	})
+end
+
+return {
+	summary = "A volume row: drag or tap the bar, or step with minus and plus.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
