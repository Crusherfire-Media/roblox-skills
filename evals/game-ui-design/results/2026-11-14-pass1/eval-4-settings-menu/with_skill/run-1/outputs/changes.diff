+--!strict
+--[[
+	Colors, fonts, and sizes shared by the game's menus. Sizes are UI units,
+	authored for a screen 1080 pixels tall.
+]]
+
+const Screen = require("./Screen")
+
+local Module = {}
+
+-- Text colors keep 4.5:1 or more against Panel and every button color.
+Module.Colors = table.freeze({
+	Backdrop = Color3.fromRGB(0, 0, 0),
+	Panel = Color3.fromRGB(28, 32, 44),
+	PanelStroke = Color3.fromRGB(92, 100, 124),
+	Text = Color3.fromRGB(255, 255, 255),
+	SubtleText = Color3.fromRGB(200, 205, 216),
+	SuccessText = Color3.fromRGB(150, 230, 160),
+	-- 3:1 against Secondary, the floor for inactive controls.
+	DisabledText = Color3.fromRGB(150, 156, 170),
+	Secondary = Color3.fromRGB(58, 64, 82),
+	SecondaryHover = Color3.fromRGB(74, 82, 104),
+	SecondaryPress = Color3.fromRGB(44, 48, 62),
+	Danger = Color3.fromRGB(176, 36, 36),
+	DangerHover = Color3.fromRGB(200, 48, 48),
+	DangerPress = Color3.fromRGB(140, 28, 28),
+	Track = Color3.fromRGB(70, 76, 96),
+	Fill = Color3.fromRGB(96, 170, 255),
+	Focus = Color3.fromRGB(255, 214, 64),
+})
+
+Module.Fonts = table.freeze({
+	Body = Enum.Font.BuilderSans,
+	Medium = Enum.Font.BuilderSansMedium,
+	Bold = Enum.Font.BuilderSansBold,
+})
+
+Module.TextSizes = table.freeze({
+	Title = 30,
+	Body = 22,
+	Caption = 20,
+})
+
+-- 56 keeps thumb targets above 44 when a panel shrinks to fit a phone.
+Module.TouchTarget = 56
+Module.CornerRadius = UDim.new(0, 12)
+
+-- Backgrounds follow the player's Roblox transparency setting.
+function Module.backgroundTransparency(base: number): () -> number
+	return function()
+		return base * Screen.preferredTransparency()
+	end
+end
+
+return Module
