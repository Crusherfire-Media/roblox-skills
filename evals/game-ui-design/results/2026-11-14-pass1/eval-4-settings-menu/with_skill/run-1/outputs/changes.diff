diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/App.luau b/src/StarterPlayer/StarterPlayerScripts/UI/App.luau
new file mode 100644
index 0000000..04152bc
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/App.luau
@@ -0,0 +1,193 @@
+--!strict
+--[[
+	The game's on-screen UI: a Settings button and the settings menu it opens.
+	Connects the menu to GameAudio and BlockPlacer.
+]]
+
+const ContextActionService = game:GetService("ContextActionService")
+const GuiService = game:GetService("GuiService")
+const RunService = game:GetService("RunService")
+const UserInputService = game:GetService("UserInputService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockPlacer = require("../BlockPlacer")
+const GameAudio = require("../GameAudio")
+const Screen = require("./Screen")
+const Theme = require("./Theme")
+const button = require("./Components/button")
+const settingsMenu = require("./Components/settingsMenu")
+
+Vide.strict = RunService:IsStudio()
+
+const cleanup = Vide.cleanup
+const create = Vide.create
+const effect = Vide.effect
+const mount = Vide.mount
+const show = Vide.show
+const source = Vide.source
+
+const TOGGLE_ACTION = "ToggleSettings"
+const BACK_ACTION = "SettingsBack"
+-- Above Roblox's default bindings, so B closes the menu instead of only
+-- leaving UI navigation.
+const BACK_PRIORITY = Enum.ContextActionPriority.High.Value
+const TOGGLE_KEY = Enum.KeyCode.ButtonY
+const OPEN_BUTTON_SIZE = Vector2.new(150, Theme.TouchTarget)
+const GLYPH_SIZE = 40
+const EDGE_OFFSET = 16
+
+local Module = {}
+
+local function app()
+	const isOpen = source(false)
+	const musicVolume = source(GameAudio.getMusicVolume())
+	const effectsVolume = source(GameAudio.getEffectsVolume())
+	local openButton: TextButton? = nil
+	local backHandler: (() -> ())? = nil
+
+	local function focus(target: GuiObject?)
+		if target and Screen.isGamepad() then
+			GuiService.SelectedObject = target
+		end
+	end
+
+	local wasNavigatingUI = false
+
+	local function close()
+		if not isOpen() then
+			return
+		end
+		isOpen(false)
+		-- A player who opened with Y goes straight back to playing; one who
+		-- navigated to the Settings button gets their place back.
+		if wasNavigatingUI then
+			focus(openButton)
+		else
+			GuiService.SelectedObject = nil
+		end
+	end
+
+	local function toggle()
+		if isOpen() then
+			close()
+		else
+			wasNavigatingUI = GuiService.SelectedObject ~= nil
+			isOpen(true)
+		end
+	end
+
+	ContextActionService:BindAction(TOGGLE_ACTION, function(_, inputState)
+		if inputState == Enum.UserInputState.Begin then
+			toggle()
+		end
+		return Enum.ContextActionResult.Pass
+	end, false, TOGGLE_KEY)
+	cleanup(function()
+		ContextActionService:UnbindAction(TOGGLE_ACTION)
+	end)
+
+	effect(function()
+		const menuIsOpen = isOpen()
+		-- The menu is modal: no walking with touch controls and no placing
+		-- blocks behind it. The menu has its own Close button for touch.
+		GuiService.TouchControlsEnabled = not menuIsOpen
+		BlockPlacer.setEnabled(not menuIsOpen)
+		if not menuIsOpen then
+			return
+		end
+
+		ContextActionService:BindActionAtPriority(BACK_ACTION, function(_, inputState)
+			if inputState ~= Enum.UserInputState.Begin then
+				return Enum.ContextActionResult.Pass
+			end
+			if backHandler then
+				backHandler()
+			end
+			return Enum.ContextActionResult.Sink
+		end, false, BACK_PRIORITY, Enum.KeyCode.ButtonB)
+		cleanup(function()
+			ContextActionService:UnbindAction(BACK_ACTION)
+		end)
+	end)
+
+	return create("ScreenGui")({
+		Name = "GameUI",
+		ScreenInsets = Enum.ScreenInsets.CoreUISafeInsets,
+		DisplayOrder = 10,
+
+		create("UIScale")({ Scale = Screen.uiScale }),
+
+		create("Frame")({
+			Name = "OpenSettings",
+			AnchorPoint = Vector2.new(1, 0),
+			Position = UDim2.new(1, -EDGE_OFFSET, 0, EDGE_OFFSET),
+			Size = UDim2.fromOffset(0, OPEN_BUTTON_SIZE.Y),
+			AutomaticSize = Enum.AutomaticSize.X,
+			BackgroundTransparency = 1,
+
+			create("UIListLayout")({
+				FillDirection = Enum.FillDirection.Horizontal,
+				VerticalAlignment = Enum.VerticalAlignment.Center,
+				Padding = UDim.new(0, 8),
+			}),
+
+			-- Tells controller players which button opens the menu.
+			create("ImageLabel")({
+				Name = "ControllerHint",
+				LayoutOrder = 1,
+				Size = UDim2.fromOffset(GLYPH_SIZE, GLYPH_SIZE),
+				BackgroundTransparency = 1,
+				-- Read again each time the player switches to a gamepad.
+				Image = function()
+					Screen.isGamepad()
+					return UserInputService:GetImageForKeyCode(TOGGLE_KEY)
+				end,
+				Visible = Screen.isGamepad,
+			}),
+
+			button({
+				Name = "Settings",
+				LayoutOrder = 2,
+				Size = UDim2.fromOffset(OPEN_BUTTON_SIZE.X, OPEN_BUTTON_SIZE.Y),
+				Text = "Settings",
+				Activated = toggle,
+				Ref = function(instance)
+					openButton = instance
+				end,
+			}),
+		}),
+
+		show(isOpen, function(_, present)
+			return settingsMenu({
+				MusicVolume = musicVolume,
+				SetMusicVolume = function(volume)
+					GameAudio.setMusicVolume(volume)
+					musicVolume(GameAudio.getMusicVolume())
+				end,
+				EffectsVolume = effectsVolume,
+				SetEffectsVolume = function(volume)
+					GameAudio.setEffectsVolume(volume)
+					effectsVolume(GameAudio.getEffectsVolume())
+				end,
+				ClearBlocks = BlockPlacer.clearMyBlocks,
+				Close = close,
+				IsPresent = present,
+				Focus = focus,
+				SetBackHandler = function(handler)
+					backHandler = handler
+				end,
+			})
+		end),
+	})
+end
+
+--[[
+	Builds the UI into the player's PlayerGui. Call once, before anything that
+	yields, so the Settings button shows as soon as the player joins.
+]]
+function Module.mount(playerGui: PlayerGui)
+	mount(app, playerGui)
+end
+
+return Module
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/button.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/button.luau
new file mode 100644
index 0000000..293c13e
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/button.luau
@@ -0,0 +1,117 @@
+--!strict
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const Theme = require("../Theme")
+
+const action = Vide.action
+const changed = Vide.changed
+const create = Vide.create
+const read = Vide.read
+const source = Vide.source
+
+export type Variant = "Secondary" | "Danger"
+
+export type ButtonProps = {
+	Name: string,
+	Text: string | () -> string,
+	Activated: () -> (),
+	Size: UDim2,
+	Variant: Variant?,
+	TextSize: number?,
+	LayoutOrder: number?,
+	-- A disabled button keeps its place and gamepad focus but ignores presses.
+	IsDisabled: (boolean | () -> boolean)?,
+	-- Receives the button once it is built, to give it gamepad focus later.
+	Ref: ((TextButton) -> ())?,
+}
+
+const COLORS = table.freeze({
+	Secondary = table.freeze({
+		Idle = Theme.Colors.Secondary,
+		Hover = Theme.Colors.SecondaryHover,
+		Press = Theme.Colors.SecondaryPress,
+	}),
+	Danger = table.freeze({
+		Idle = Theme.Colors.Danger,
+		Hover = Theme.Colors.DangerHover,
+		Press = Theme.Colors.DangerPress,
+	}),
+})
+
+const FOCUS_STROKE_THICKNESS = 3
+
+--[[
+	A text button for mouse, touch, keyboard, and gamepad. It changes color on
+	hover and press without animating, and draws a yellow outline while it has
+	gamepad focus.
+]]
+local function button(props: ButtonProps): TextButton
+	const palette = COLORS[props.Variant or "Secondary"]
+	const guiState = source(Enum.GuiState.Idle)
+	const isSelected = source(false)
+
+	local function isDisabled(): boolean
+		return read(props.IsDisabled) == true
+	end
+
+	return create("TextButton")({
+		Name = props.Name,
+		Size = props.Size,
+		LayoutOrder = props.LayoutOrder or 0,
+		Text = props.Text,
+		Font = Theme.Fonts.Bold,
+		TextSize = props.TextSize or Theme.TextSizes.Body,
+		TextColor3 = function()
+			return if isDisabled() then Theme.Colors.DisabledText else Theme.Colors.Text
+		end,
+		TextWrapped = true,
+		Selectable = true,
+		-- The UIStroke below is the focus cue, so Roblox's own outline is hidden.
+		SelectionImageObject = create("Frame")({
+			Name = "NoSelectionImage",
+			BackgroundTransparency = 1,
+		}),
+		BackgroundColor3 = function()
+			const state = guiState()
+			if isDisabled() then
+				return Theme.Colors.Secondary
+			elseif state == Enum.GuiState.Press then
+				return palette.Press
+			elseif state == Enum.GuiState.Hover or isSelected() then
+				return palette.Hover
+			end
+			return palette.Idle
+		end,
+		Activated = function()
+			if not isDisabled() then
+				props.Activated()
+			end
+		end,
+		SelectionGained = function()
+			isSelected(true)
+		end,
+		SelectionLost = function()
+			isSelected(false)
+		end,
+
+		create("UICorner")({ CornerRadius = Theme.CornerRadius }),
+		create("UIPadding")({
+			PaddingLeft = UDim.new(0, 12),
+			PaddingRight = UDim.new(0, 12),
+		}),
+		create("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			Color = Theme.Colors.Focus,
+			Thickness = FOCUS_STROKE_THICKNESS,
+			Enabled = isSelected,
+		}),
+
+		changed("GuiState", guiState),
+		props.Ref and action(function(instance)
+			(props.Ref :: (TextButton) -> ())(instance :: TextButton)
+		end),
+	}) :: TextButton
+end
+
+return button
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/confirmDialog.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/confirmDialog.luau
new file mode 100644
index 0000000..d547dab
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/confirmDialog.luau
@@ -0,0 +1,118 @@
+--!strict
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const Theme = require("../Theme")
+const button = require("./button")
+
+const create = Vide.create
+
+export type ConfirmDialogProps = {
+	Title: string,
+	Message: string,
+	CancelText: string,
+	ConfirmText: string,
+	Canceled: () -> (),
+	Confirmed: () -> (),
+	-- The safe option, which takes gamepad focus when the dialog opens.
+	CancelRef: ((TextButton) -> ())?,
+}
+
+const WIDTH = 480
+const PADDING = 24
+const BUTTON_WIDTH = 200
+
+--[[
+	A dialog for an action that can't be undone. The safe option comes first,
+	and the dialog keeps gamepad focus inside itself.
+]]
+local function confirmDialog(props: ConfirmDialogProps): Frame
+	return create("Frame")({
+		Name = "ConfirmDialog",
+		AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.5),
+		Size = UDim2.fromOffset(WIDTH, 0),
+		AutomaticSize = Enum.AutomaticSize.Y,
+		BackgroundColor3 = Theme.Colors.Panel,
+		-- Always opaque, so the text never sits over the world.
+		BackgroundTransparency = 0,
+		Active = true,
+		SelectionGroup = true,
+		SelectionBehaviorUp = Enum.SelectionBehavior.Stop,
+		SelectionBehaviorDown = Enum.SelectionBehavior.Stop,
+		SelectionBehaviorLeft = Enum.SelectionBehavior.Stop,
+		SelectionBehaviorRight = Enum.SelectionBehavior.Stop,
+
+		create("UICorner")({ CornerRadius = Theme.CornerRadius }),
+		create("UIStroke")({ Color = Theme.Colors.PanelStroke, Thickness = 2 }),
+		create("UIPadding")({
+			PaddingTop = UDim.new(0, PADDING),
+			PaddingBottom = UDim.new(0, PADDING),
+			PaddingLeft = UDim.new(0, PADDING),
+			PaddingRight = UDim.new(0, PADDING),
+		}),
+		create("UIListLayout")({
+			Padding = UDim.new(0, 16),
+			HorizontalAlignment = Enum.HorizontalAlignment.Center,
+		}),
+
+		create("TextLabel")({
+			Name = "Title",
+			LayoutOrder = 1,
+			Size = UDim2.fromScale(1, 0),
+			AutomaticSize = Enum.AutomaticSize.Y,
+			BackgroundTransparency = 1,
+			Text = props.Title,
+			Font = Theme.Fonts.Bold,
+			TextSize = Theme.TextSizes.Title,
+			TextColor3 = Theme.Colors.Text,
+			TextWrapped = true,
+		}),
+
+		create("TextLabel")({
+			Name = "Message",
+			LayoutOrder = 2,
+			Size = UDim2.fromScale(1, 0),
+			AutomaticSize = Enum.AutomaticSize.Y,
+			BackgroundTransparency = 1,
+			Text = props.Message,
+			Font = Theme.Fonts.Body,
+			TextSize = Theme.TextSizes.Body,
+			TextColor3 = Theme.Colors.SubtleText,
+			TextWrapped = true,
+		}),
+
+		create("Frame")({
+			Name = "Actions",
+			LayoutOrder = 3,
+			Size = UDim2.fromScale(1, 0),
+			AutomaticSize = Enum.AutomaticSize.Y,
+			BackgroundTransparency = 1,
+
+			create("UIListLayout")({
+				FillDirection = Enum.FillDirection.Horizontal,
+				HorizontalAlignment = Enum.HorizontalAlignment.Center,
+				Padding = UDim.new(0, 16),
+			}),
+
+			button({
+				Name = "Cancel",
+				LayoutOrder = 1,
+				Size = UDim2.fromOffset(BUTTON_WIDTH, Theme.TouchTarget),
+				Text = props.CancelText,
+				Activated = props.Canceled,
+				Ref = props.CancelRef,
+			}),
+			button({
+				Name = "Confirm",
+				LayoutOrder = 2,
+				Size = UDim2.fromOffset(BUTTON_WIDTH, Theme.TouchTarget),
+				Variant = "Danger",
+				Text = props.ConfirmText,
