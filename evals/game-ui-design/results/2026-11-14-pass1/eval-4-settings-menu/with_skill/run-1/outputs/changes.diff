+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const settingsMenu = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/settingsMenu")
+
+const CONTROLS = {
+	-- Starting volumes; changing one starts the story over.
+	Volume = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Music = UILabs.Ordered(UILabs.Slider(0.5, 0, 1, 0.1), 1),
+			Effects = UILabs.Ordered(UILabs.Slider(0.8, 0, 1, 0.1), 2),
+		}),
+		1
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Volume: {
+			Music: () -> number,
+			Effects: () -> number,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const volume = props.controls.Volume
+
+	return Vide.indexes(function()
+		return { [`{volume.Music()}|{volume.Effects()}`] = true }
+	end, function()
+		const music = Vide.source(volume.Music())
+		const effects = Vide.source(volume.Effects())
+
+		return settingsMenu({
+			MusicVolume = music,
+			SetMusicVolume = function(value)
+				music(value)
+			end,
+			EffectsVolume = effects,
+			SetEffectsVolume = function(value)
+				effects(value)
+			end,
+			ClearBlocks = function()
+				print("ClearBlocks")
+			end,
+			Close = function()
+				print("Close")
+			end,
+		})
+	end)
+end
+
+return {
+	summary = "The settings menu: volumes and deleting every block, with its confirmation.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
