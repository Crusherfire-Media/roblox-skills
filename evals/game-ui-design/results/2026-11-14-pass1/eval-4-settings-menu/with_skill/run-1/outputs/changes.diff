+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const volumeSlider = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/volumeSlider")
+
+const CONTROLS = {
+	-- Try a long label to check wrapping.
+	Label = UILabs.Ordered("Sound effects", 1),
+	-- The starting value; changing it starts the story over.
+	StartValue = UILabs.Ordered(UILabs.Slider(0.5, 0, 1, 0.1), 2),
+	Width = UILabs.Ordered(UILabs.Slider(552, 400, 900, 8), 3),
+}
+
+type StoryProps = {
+	controls: {
+		Label: () -> string,
+		StartValue: () -> number,
+		Width: () -> number,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const controls = props.controls
+
+	return Vide.indexes(function()
+		return { [`{controls.Label()}|{controls.StartValue()}`] = true }
+	end, function()
+		const value = Vide.source(controls.StartValue())
+
+		return Vide.create("Frame")({
+			Name = "StoryFrame",
+			Size = function()
+				return UDim2.fromOffset(controls.Width(), 0)
+			end,
+			AutomaticSize = Enum.AutomaticSize.Y,
+			BackgroundColor3 = Color3.fromRGB(28, 32, 44),
+
+			volumeSlider({
+				Name = "Volume",
+				Label = controls.Label(),
+				Value = value,
+				SetValue = function(newValue)
+					value(newValue)
+				end,
+			}),
+		})
+	end)
+end
+
+return {
+	summary = "One volume row: step buttons, a draggable bar, and the percentage.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
