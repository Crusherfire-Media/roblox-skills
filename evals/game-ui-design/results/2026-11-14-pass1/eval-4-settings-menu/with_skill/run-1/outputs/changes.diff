@@ -0,0 +1,66 @@
+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const confirmDialog =
+	require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/confirmDialog")
+
+const CONTROLS = {
+	Content = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Title = UILabs.Ordered("Delete all your blocks?", 1),
+			Message = UILabs.Ordered("Every block you built will be gone for good.", 2),
+			CancelText = UILabs.Ordered("Keep blocks", 3),
+			ConfirmText = UILabs.Ordered("Delete blocks", 4),
+		}),
+		1
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Content: {
+			Title: () -> string,
+			Message: () -> string,
+			CancelText: () -> string,
+			ConfirmText: () -> string,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const content = props.controls.Content
+
+	-- The dialog reads its text once, so rebuild when any of it changes.
+	return Vide.indexes(function()
+		const parts = {
+			content.Title(),
+			content.Message(),
+			content.CancelText(),
+			content.ConfirmText(),
+		}
+		return { [table.concat(parts, "|")] = true }
+	end, function()
+		return confirmDialog({
+			Title = content.Title(),
+			Message = content.Message(),
+			CancelText = content.CancelText(),
+			ConfirmText = content.ConfirmText(),
+			Canceled = function()
+				print("Canceled")
+			end,
+			Confirmed = function()
+				print("Confirmed")
+			end,
+		})
+	end)
+end
+
+return {
+	summary = "The confirmation shown before deleting every block a player built.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
