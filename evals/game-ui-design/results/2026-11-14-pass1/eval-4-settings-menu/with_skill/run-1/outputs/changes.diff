+++ b/src/ServerScriptService/Stories/Components/button.story.luau
@@ -0,0 +1,71 @@
+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const button = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/button")
+
+const CONTROLS = {
+	Content = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Text = UILabs.Ordered("Delete all", 1),
+			Variant = UILabs.Ordered(UILabs.Choose({ "Secondary", "Danger" }), 2),
+		}),
+		1
+	),
+	State = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsDisabled = UILabs.Ordered(false, 1),
+		}),
+		2
+	),
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Width = UILabs.Ordered(UILabs.Slider(180, 56, 400, 4), 1),
+		}),
+		3
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Content: {
+			Text: () -> string,
+			Variant: () -> "Secondary" | "Danger",
+		},
+		State: {
+			IsDisabled: () -> boolean,
+		},
+		Layout: {
+			Width: () -> number,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const controls = props.controls
+
+	-- Variant and Width are read once by the button, so rebuild on change.
+	return Vide.indexes(function()
+		return { [`{controls.Content.Variant()}|{controls.Layout.Width()}`] = true }
+	end, function()
+		return button({
+			Name = "StoryButton",
+			Size = UDim2.fromOffset(controls.Layout.Width(), 56),
+			Text = controls.Content.Text,
+			Variant = controls.Content.Variant(),
+			IsDisabled = controls.State.IsDisabled,
+			Activated = function()
+				print("Button activated")
+			end,
+		})
+	end)
+end
+
+return {
+	summary = "The shared menu button in each variant, enabled and disabled.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
diff --git a/src/ServerScriptService/Stories/Components/confirmDialog.story.luau b/src/ServerScriptService/Stories/Components/confirmDialog.story.luau
