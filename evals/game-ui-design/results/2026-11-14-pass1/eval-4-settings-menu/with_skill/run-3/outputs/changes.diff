@@ -0,0 +1,66 @@
+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const volumeSlider = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/volumeSlider")
+
+const create = Vide.create
+const indexes = Vide.indexes
+const source = Vide.source
+
+const CONTROLS = {
+	Label = UILabs.Ordered("Sound effects", 1),
+	-- Changing it starts the slider over at the new value.
+	StartValue = UILabs.Ordered(UILabs.Slider(0.5, 0, 1, 0.05), 2),
+	Width = UILabs.Ordered(UILabs.Slider(512, 240, 640, 4), 3),
+}
+
+type StoryProps = {
+	controls: {
+		Label: () -> string,
+		StartValue: () -> number,
+		Width: () -> number,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local controls = props.controls
+
+	return create("Frame")({
+		Name = "VolumeSliderStory",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundColor3 = Color3.fromRGB(30, 33, 38),
+
+		create("UIListLayout")({
+			HorizontalAlignment = Enum.HorizontalAlignment.Center,
+			VerticalAlignment = Enum.VerticalAlignment.Center,
+		}),
+
+		indexes(function()
+			return { [controls.StartValue()] = true }
+		end, function(_, startValue: number)
+			local value = source(startValue)
+
+			return volumeSlider({
+				Label = controls.Label,
+				Value = value,
+				SetValue = function(newValue: number)
+					print(`Volume set to {newValue}`)
+					value(newValue)
+				end,
+				Size = function()
+					return UDim2.fromOffset(controls.Width(), 92)
+				end,
+			})
+		end),
+	})
+end
+
+return {
+	summary = "A volume slider; drag or tap the track, or use the step buttons.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
