+--!strict
+--[[
+	Colors, fonts, and text sizes shared by the game's UI. Every text color
+	passes 4.5:1 contrast against the surface it sits on, and every surface
+	behind text is opaque, so text reads over any part of the world.
+]]
+
+const Theme = {
+	-- Surfaces
+	Panel = Color3.fromRGB(30, 33, 38),
+	Scrim = Color3.fromRGB(0, 0, 0),
+	Track = Color3.fromRGB(58, 63, 71),
+	-- 4.4:1 against Track, past the 3:1 a non-text graphic needs.
+	TrackFill = Color3.fromRGB(110, 168, 255),
+	Knob = Color3.fromRGB(245, 245, 245),
+	Outline = Color3.fromRGB(80, 86, 96),
+
+	-- 13:1 on Panel
+	Text = Color3.fromRGB(245, 245, 245),
+	-- 9:1 on Panel
+	TextMuted = Color3.fromRGB(190, 195, 204),
+
+	-- Text passes 4.5:1 on every button color below except Disabled, which
+	-- keeps the 3:1 an inactive control needs.
+	Neutral = Color3.fromRGB(58, 63, 71),
+	NeutralHover = Color3.fromRGB(74, 80, 90),
+	NeutralPressed = Color3.fromRGB(44, 48, 54),
+	Danger = Color3.fromRGB(179, 38, 30),
+	DangerHover = Color3.fromRGB(200, 52, 42),
+	DangerPressed = Color3.fromRGB(140, 28, 22),
+	Disabled = Color3.fromRGB(46, 49, 55),
+	TextDisabled = Color3.fromRGB(130, 135, 144),
+
+	Font = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Medium),
+	FontBold = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold),
+
+	-- In UI units for a 1080-tall screen; a TV's 1.25 scale lifts body text
+	-- past the 26 px console floor.
+	TitleTextSize = 32,
+	BodyTextSize = 24,
+	ButtonTextSize = 24,
+
+	CornerRadius = UDim.new(0, 12),
+	ButtonCornerRadius = UDim.new(0, 10),
+}
+
+return table.freeze(Theme)
