diff --git a/src/ServerScriptService/Stories/Components/menuButton.story.luau b/src/ServerScriptService/Stories/Components/menuButton.story.luau
new file mode 100644
index 0000000..03a8a84
--- /dev/null
+++ b/src/ServerScriptService/Stories/Components/menuButton.story.luau
@@ -0,0 +1,109 @@
+--!strict
+
+const UserInputService = game:GetService("UserInputService")
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const menuButton = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/menuButton")
+
+const create = Vide.create
+
+const CONTROLS = {
+	Content = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Text = UILabs.Ordered("Delete my blocks", 1),
+			-- Shows the gamepad Y glyph beside the text.
+			HasIcon = UILabs.Ordered(false, 2),
+		}),
+		1
+	),
+	State = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsDisabled = UILabs.Ordered(false, 1),
+		}),
+		2
+	),
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Width = UILabs.Ordered(UILabs.Slider(256, 56, 480, 4), 1),
+			Height = UILabs.Ordered(UILabs.Slider(56, 44, 96, 4), 2),
+		}),
+		3
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Content: {
+			Text: () -> string,
+			HasIcon: () -> boolean,
+		},
+		State: {
+			IsDisabled: () -> boolean,
+		},
+		Layout: {
+			Width: () -> number,
+			Height: () -> number,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local controls = props.controls
+
+	local function size(): UDim2
+		return UDim2.fromOffset(controls.Layout.Width(), controls.Layout.Height())
+	end
+
+	local function icon(): string?
+		return if controls.Content.HasIcon()
+			then UserInputService:GetImageForKeyCode(Enum.KeyCode.ButtonY)
+			else nil
+	end
+
+	return create("Frame")({
+		Name = "MenuButtonStory",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundColor3 = Color3.fromRGB(30, 33, 38),
+
+		create("UIListLayout")({
+			Padding = UDim.new(0, 16),
+			HorizontalAlignment = Enum.HorizontalAlignment.Center,
+			VerticalAlignment = Enum.VerticalAlignment.Center,
+		}),
+
+		menuButton({
+			Name = "Neutral",
+			LayoutOrder = 1,
+			Text = controls.Content.Text,
+			Icon = icon,
+			Size = size,
+			Disabled = controls.State.IsDisabled,
+			Activated = function()
+				print("Neutral button activated")
+			end,
+		}),
+
+		menuButton({
+			Name = "Danger",
+			LayoutOrder = 2,
+			Style = "Danger",
+			Text = controls.Content.Text,
+			Icon = icon,
+			Size = size,
+			Disabled = controls.State.IsDisabled,
+			Activated = function()
+				print("Danger button activated")
+			end,
+		}),
+	})
+end
+
+return {
+	summary = "The menu button in both styles, with and without a gamepad glyph.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
diff --git a/src/ServerScriptService/Stories/Components/settingsPanel.story.luau b/src/ServerScriptService/Stories/Components/settingsPanel.story.luau
new file mode 100644
index 0000000..8d07cfa
--- /dev/null
+++ b/src/ServerScriptService/Stories/Components/settingsPanel.story.luau
@@ -0,0 +1,92 @@
+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const settingsPanel =
+	require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/settingsPanel")
+
+const create = Vide.create
+const indexes = Vide.indexes
+const source = Vide.source
+
+const CONTROLS = {
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Side by side, for short phone screens.
+			IsCompact = UILabs.Ordered(false, 1),
+			-- The room the panel fits into, in UI units; below its size it shrinks.
+			RoomWidth = UILabs.Ordered(UILabs.Slider(1920, 320, 1920, 10), 2),
+			RoomHeight = UILabs.Ordered(UILabs.Slider(1080, 240, 1080, 10), 3),
+		}),
+		1
+	),
+	Volume = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Changing either starts the panel over.
+			Music = UILabs.Ordered(UILabs.Slider(0.5, 0, 1, 0.1), 1),
+			Effects = UILabs.Ordered(UILabs.Slider(0.8, 0, 1, 0.1), 2),
+		}),
+		2
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Layout: {
+			IsCompact: () -> boolean,
+			RoomWidth: () -> number,
+			RoomHeight: () -> number,
+		},
+		Volume: {
+			Music: () -> number,
+			Effects: () -> number,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local layout = props.controls.Layout
+	local volume = props.controls.Volume
+
+	return create("Frame")({
+		Name = "SettingsPanelStory",
+		Size = UDim2.fromScale(1, 1),
+		-- A bright backdrop, like sky or baseplate, to judge the panel against.
+		BackgroundColor3 = Color3.fromRGB(150, 200, 240),
+
+		indexes(function()
+			return { [`{volume.Music()}/{volume.Effects()}`] = true }
+		end, function()
+			local musicVolume = source(volume.Music())
+			local effectsVolume = source(volume.Effects())
+
+			return settingsPanel({
+				IsCompact = layout.IsCompact,
+				Room = function()
+					return Vector2.new(layout.RoomWidth(), layout.RoomHeight())
+				end,
+				AnchorPoint = Vector2.new(0.5, 0.5),
+				Position = UDim2.fromScale(0.5, 0.5),
+				MusicVolume = musicVolume,
+				SetMusicVolume = musicVolume,
+				EffectsVolume = effectsVolume,
+				SetEffectsVolume = effectsVolume,
+				DeleteBlocks = function()
+					print("Delete blocks")
+				end,
+				Close = function()
+					print("Close")
+				end,
+			})
+		end),
+	})
+end
+
+return {
+	summary = "The settings panel in both layouts, including the delete confirmation.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
