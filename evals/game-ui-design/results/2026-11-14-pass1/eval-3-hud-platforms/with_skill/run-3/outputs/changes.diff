+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local StarterPlayer = game:GetService("StarterPlayer")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Hud = require(StarterPlayer.StarterPlayerScripts.UI.Hud)
+local UILabs = require(ReplicatedStorage.Packages.UILabs)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local create = Vide.create
+local source = Vide.source
+
+local Screen = require(StarterPlayer.StarterPlayerScripts.UI.Screen)
+
+type Input = Screen.Input
+type Layout = Screen.Layout
+
+local CONTROLS = {
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Layout = UILabs.Ordered(UILabs.Choose({ "Desktop", "Phone", "Tablet", "Gamepad" }), 1),
+			-- Picks the prompts: key labels, controller glyphs, or none.
+			Input = UILabs.Ordered(UILabs.Choose({ "KeyboardAndMouse", "Touch", "Gamepad" }), 2),
+		}),
+		1
+	),
+	State = UILabs.Ordered(
+		UILabs.ControlGroup({
+			BuildMode = UILabs.Ordered(true, 1),
+			Coins = UILabs.Ordered(UILabs.Slider(250, 0, 1000000, 50), 2),
+		}),
+		2
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Layout: {
+			Layout: () -> string,
+			Input: () -> string,
+		},
+		State: {
+			BuildMode: () -> boolean,
+			Coins: () -> number,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local layout = props.controls.Layout
+	local state = props.controls.State
+	local selected = source(BlockTypes.List[1].Name)
+
+	return create("Frame")({
+		Name = "HudPreview",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundTransparency = 1,
+
+		Hud({
+			Selected = selected,
+			Select = function(name: string)
+				selected(name)
+			end,
+			BuildMode = state.BuildMode,
+			ToggleBuildMode = function()
+				print("build mode toggled")
+			end,
+			Coins = state.Coins,
+			OpenInventory = function()
+				print("inventory opened")
+			end,
+			Layout = layout.Layout :: () -> Layout,
+			Input = layout.Input :: () -> Input,
+			Viewport = Screen.viewport,
+			JumpButtonClearance = Screen.jumpButtonClearance,
+		}),
+	})
+end
+
+return {
+	summary = "The HUD in each layout and input. Touch layouts place the hotbar from "
+		.. "Studio's viewport size, not the preview frame's.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
