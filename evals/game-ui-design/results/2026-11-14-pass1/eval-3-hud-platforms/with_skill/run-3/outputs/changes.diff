+--!strict
+--[[
+	Live facts about the player's screen and input, as Vide sources, so UI
+	follows a window resize, a device switch, or a controller picked up
+	mid-session. Each getter reads sources: pass it to a property as a binding
+	or call it inside one. Sizes are in UI units (offsets authored for a screen
+	1080 tall, before the root UIScale).
+]]
+
+local GuiService = game:GetService("GuiService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local RunService = game:GetService("RunService")
+local UserInputService = game:GetService("UserInputService")
+
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local batch = Vide.batch
+local source = Vide.source
+
+local REFERENCE_SHORT_SIDE = 1080
+local MINIMUM_SCALE = 1
+local MAXIMUM_SCALE = 3
+local LARGE_DISPLAY_BOOST = 1.25
+local PHONE_SHORT_SIDE = 600
+local FALLBACK_VIEWPORT = Vector2.new(1920, 1080)
+
+-- The default PlayerModule's jump button, in real pixels in from the right
+-- edge (X) and up from the bottom edge (Y). It switches to the large layout
+-- above this short side.
+local SMALL_TOUCH_SHORT_SIDE = 500
+local SMALL_JUMP_CLEARANCE = Vector2.new(95, 90)
+local LARGE_JUMP_CLEARANCE = Vector2.new(170, 210)
+
+export type Input = "KeyboardAndMouse" | "Touch" | "Gamepad"
+export type Layout = "Desktop" | "Phone" | "Tablet" | "Gamepad"
+
+local Module = {}
+
+local realViewport = source(FALLBACK_VIEWPORT)
+local preferredInput = source("KeyboardAndMouse" :: Input)
+local isLargeDisplay = source(false)
+local gamepadRevision = source(0)
+local viewportConnection: RBXScriptConnection? = nil
+
+local function onGamepadChanged()
+	gamepadRevision(gamepadRevision() + 1)
+end
+
+-- Fires on every switch between mouse and keyboard too, so only a change to
+-- a gamepad counts.
+local function onLastInputTypeChanged(inputType: Enum.UserInputType)
+	if string.find(inputType.Name, "^Gamepad") then
+		onGamepadChanged()
+	end
+end
+
+local function readInput(): Input
+	local preferred = UserInputService.PreferredInput
+	if preferred == Enum.PreferredInput.Touch then
+		return "Touch"
+	elseif
+		preferred == Enum.PreferredInput.Gamepad
+		or preferred == Enum.PreferredInput.MicroGamepad
+	then
+		return "Gamepad"
+	else
+		return "KeyboardAndMouse"
+	end
+end
+
+local function refresh()
+	local camera = workspace.CurrentCamera
+	batch(function()
+		-- ViewportSize can read (1, 1) before the first frame, which would
+		-- pass for a tiny phone.
+		if camera and camera.ViewportSize.X > 1 and camera.ViewportSize.Y > 1 then
+			realViewport(camera.ViewportSize)
+		end
+		preferredInput(readInput())
+		isLargeDisplay(GuiService.ViewportDisplaySize == Enum.DisplaySize.Large)
+	end)
+end
+
+local function watchCamera()
+	if viewportConnection then
+		viewportConnection:Disconnect()
+	end
+	local camera = workspace.CurrentCamera
+	if camera then
+		viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
+	end
+	refresh()
+end
+
+--[[
+	How much the whole UI grows on this screen: 1 up to 1080p, more on larger
+	screens, and a quarter more on a TV. Bind it to a UIScale directly under
+	every ScreenGui the game builds.
+]]
+function Module.uiScale(): number
+	local view = realViewport()
+	local boost = if isLargeDisplay() then LARGE_DISPLAY_BOOST else 1
+	return math.clamp(
+		math.min(view.X, view.Y) / REFERENCE_SHORT_SIDE * boost,
+		MINIMUM_SCALE,
+		MAXIMUM_SCALE
+	)
+end
+
+function Module.viewport(): Vector2
+	return realViewport() / Module.uiScale()
+end
+
+--[[
+	The player's primary input as Roblox picks it. Touch means Roblox shows
+	its thumbstick and jump button.
+]]
+function Module.input(): Input
+	return preferredInput()
+end
+
+function Module.isPhone(): boolean
+	local view = Module.viewport()
+	return math.min(view.X, view.Y) < PHONE_SHORT_SIDE
+end
+
+--[[
+	Which HUD arrangement fits. A screen too small for the desktop or gamepad
+	layout gets the phone one whatever the input, which covers a phone with a
+	controller and a desktop window dragged small.
+]]
+function Module.layout(): Layout
+	local input = preferredInput()
+	if Module.isPhone() then
+		return "Phone"
+	elseif input == "Touch" then
+		return "Tablet"
+	elseif input == "Gamepad" then
+		return "Gamepad"
+	else
+		return "Desktop"
+	end
+end
+
+--[[
+	How far the touch jump button reaches in from the right edge (X) and up
+	from the bottom edge (Y). These are the default PlayerModule's numbers, not
+	a live reading, so keep a margin around them.
+]]
+function Module.jumpButtonClearance(): Vector2
+	local view = realViewport()
+	local clearance = if math.min(view.X, view.Y) <= SMALL_TOUCH_SHORT_SIDE
+		then SMALL_JUMP_CLEARANCE
+		else LARGE_JUMP_CLEARANCE
+	return clearance / Module.uiScale()
+end
+
+--[[
+	The button glyph for a gamepad KeyCode, for the kind of controller the
+	player is using, or "" when Roblox has none. Follows the player switching
+	controllers.
+]]
+function Module.glyphImage(keyCode: Enum.KeyCode): string
+	gamepadRevision()
+	return UserInputService:GetImageForKeyCode(keyCode)
+end
+
+-- UI Labs loads a fresh copy of this module on every reload, and each copy's
+-- connections would keep it alive, so edit mode reads the screen once.
+if RunService:IsRunning() then
+	watchCamera()
+	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
+	GuiService:GetPropertyChangedSignal("ViewportDisplaySize"):Connect(refresh)
+	UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(refresh)
+	UserInputService.GamepadConnected:Connect(onGamepadChanged)
+	UserInputService.GamepadDisconnected:Connect(onGamepadChanged)
+	UserInputService.LastInputTypeChanged:Connect(onLastInputTypeChanged)
+else
+	refresh()
+end
+
+return Module
