+--!strict
+
+local UserInputService = game:GetService("UserInputService")
+
+local UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+local Hud = require("@game/StarterPlayer/StarterPlayerScripts/UI/Hud")
+
+local create = Vide.create
+local source = Vide.source
+
+local CONTROLS = {
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Layout = UILabs.Ordered(UILabs.Choose({ "Desktop", "Gamepad", "Touch" }), 1),
+			-- Small matches phones up to 500 pixels on the short side.
+			TouchControlsSize = UILabs.Ordered(UILabs.Choose({ "Small", "Large" }), 2),
+			-- The screen width the HUD lays out for, in UI units. Below about
+			-- 900 (desktop) or 1230 (gamepad) the corner buttons move up.
+			ViewportWidth = UILabs.Ordered(UILabs.Slider(1920, 600, 2560, 10), 3),
+		}),
+		1
+	),
+	Player = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Coins = UILabs.Ordered(UILabs.Slider(250, 0, 1000000, 50), 1),
+			-- The player's background transparency setting; 0 is opaque.
+			PanelTransparency = UILabs.Ordered(UILabs.Slider(1, 0, 1, 0.1), 2),
+		}),
+		2
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Layout: {
+			Layout: () -> Hud.HudLayout,
+			TouchControlsSize: () -> Hud.TouchControlsSize,
+			ViewportWidth: () -> number,
+		},
+		Player: {
+			Coins: () -> number,
+			PanelTransparency: () -> number,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local layout = props.controls.Layout
+	local player = props.controls.Player
+	local selected = source(BlockTypes.List[1].Name)
+	local buildMode = source(true)
+
+	return create("Frame")({
+		Name = "HudPreview",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundTransparency = 1,
+
+		Hud({
+			Layout = layout.Layout,
+			ViewportWidth = layout.ViewportWidth,
+			TouchControlsSize = layout.TouchControlsSize,
+			PanelTransparency = player.PanelTransparency,
+			Selected = selected,
+			Select = function(name: string)
+				selected(name)
+			end,
+			BuildMode = buildMode,
+			SetBuildMode = function(enabled: boolean)
+				buildMode(enabled)
+			end,
+			Coins = player.Coins,
+			OpenInventory = function()
+				print("Inventory opened")
+			end,
+			KeyboardKeys = { BuildMode = Enum.KeyCode.B, Inventory = Enum.KeyCode.I },
+			GamepadKeys = {
+				PreviousBlock = Enum.KeyCode.ButtonL1,
+				NextBlock = Enum.KeyCode.ButtonR1,
+				BuildMode = Enum.KeyCode.ButtonX,
+				Inventory = Enum.KeyCode.ButtonY,
+			},
+			GetGlyph = function(keyCode: Enum.KeyCode): string
+				return UserInputService:GetImageForKeyCode(keyCode)
+			end,
+		}),
+	})
+end
+
+return {
+	summary = "The HUD in its desktop, gamepad, and touch layouts.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
