+--!strict
+
+local UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+local Hud = require("@game/StarterPlayer/StarterPlayerScripts/UI/Hud")
+
+local create = Vide.create
+
+local blockNames = {}
+for _, blockType in BlockTypes.List do
+	table.insert(blockNames, blockType.Name)
+end
+
+local CONTROLS = {
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Layout = UILabs.Ordered(UILabs.Choose({ "Desktop", "Touch", "Gamepad" }), 1),
+		}),
+		1
+	),
+	State = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Selected = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+			BuildMode = UILabs.Ordered(true, 2),
+			Coins = UILabs.Ordered(UILabs.Slider(250, 0, 1000000, 1), 3),
+		}),
+		2
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Layout: {
+			Layout: () -> Hud.Layout,
+		},
+		State: {
+			Selected: () -> string,
+			BuildMode: () -> boolean,
+			Coins: () -> number,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local state = props.controls.State
+
+	return create("Frame")({
+		Name = "HudPreview",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundColor3 = Color3.fromRGB(110, 150, 190),
+
+		Hud({
+			Layout = props.controls.Layout.Layout,
+			Selected = state.Selected,
+			Select = function(name: string)
+				print(`selected {name}`)
+			end,
+			BuildMode = state.BuildMode,
+			ToggleBuildMode = function()
+				print("build mode toggled")
+			end,
+			Coins = state.Coins,
+			OpenInventory = function()
+				print("inventory opened")
+			end,
+			Keys = {
+				PreviousBlock = Enum.KeyCode.ButtonL1,
+				NextBlock = Enum.KeyCode.ButtonR1,
+				BuildMode = { Keyboard = Enum.KeyCode.B, Gamepad = Enum.KeyCode.ButtonY },
+				Inventory = { Keyboard = Enum.KeyCode.I, Gamepad = Enum.KeyCode.ButtonX },
+			},
+		}),
+	})
+end
+
+return {
+	summary = "The in-game HUD in its desktop, touch, and gamepad layouts. Touch placement "
+		.. "follows Studio's viewport size, not the preview frame.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
