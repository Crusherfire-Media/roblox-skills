+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Screen.luau
@@ -0,0 +1,119 @@
+--!strict
+--[[
+	Live facts about the player's screen and input, as Vide sources. Players
+	switch device or input mid-session (a controller picked up on PC, a tablet
+	rotated), so UI binds to these instead of reading the engine once.
+]]
+
+local GuiService = game:GetService("GuiService")
+local RunService = game:GetService("RunService")
+local UserInputService = game:GetService("UserInputService")
+
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local batch = Vide.batch
+local source = Vide.source
+
+local REFERENCE_SHORT_SIDE = 1080
+local MINIMUM_SCALE = 1
+local MAXIMUM_SCALE = 3
+-- TVs are read from a couch 8 to 10 feet away.
+local LARGE_DISPLAY_BOOST = 1.25
+local FALLBACK_VIEWPORT = Vector2.new(1920, 1080)
+
+export type Input = "KeyboardAndMouse" | "Touch" | "Gamepad"
+
+local realViewport = source(FALLBACK_VIEWPORT)
+local preferredInput = source("KeyboardAndMouse" :: Input)
+local isLargeDisplay = source(false)
+local preferredTransparency = source(1)
+local viewportConnection: RBXScriptConnection? = nil
+
+local function readInput(): Input
+	local input = UserInputService.PreferredInput
+	if input == Enum.PreferredInput.Touch then
+		return "Touch"
+	elseif input == Enum.PreferredInput.Gamepad then
+		return "Gamepad"
+	end
+	return "KeyboardAndMouse"
+end
+
+local function refresh()
+	local camera = workspace.CurrentCamera
+	batch(function()
+		-- ViewportSize can read (1, 1) before the first frame, which would
+		-- pass for a tiny phone.
+		if camera and camera.ViewportSize.X > 1 and camera.ViewportSize.Y > 1 then
+			realViewport(camera.ViewportSize)
+		end
+		preferredInput(readInput())
+		isLargeDisplay(GuiService.ViewportDisplaySize == Enum.DisplaySize.Large)
+		preferredTransparency(GuiService.PreferredTransparency)
+	end)
+end
+
+local function watchCamera()
+	if viewportConnection then
+		viewportConnection:Disconnect()
+	end
+	local camera = workspace.CurrentCamera
+	if camera then
+		viewportConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
+	end
+	refresh()
+end
+
+local Module = {}
+
+--[[
+	How much the whole UI grows on this screen. UI is authored for a screen
+	1080 tall and never shrinks below 1; bind this to one UIScale per
+	ScreenGui.
+]]
+function Module.uiScale(): number
+	local view = realViewport()
+	local boost = if isLargeDisplay() then LARGE_DISPLAY_BOOST else 1
+	return math.clamp(
+		math.min(view.X, view.Y) / REFERENCE_SHORT_SIDE * boost,
+		MINIMUM_SCALE,
+		MAXIMUM_SCALE
+	)
+end
+
+--[[
+	The viewport in UI units, after the root UIScale.
+]]
+function Module.viewport(): Vector2
+	return realViewport() / Module.uiScale()
+end
+
+--[[
+	The player's primary input as Roblox picks it. Roblox shows its
+	thumbstick and jump button when this is Touch.
+]]
+function Module.input(): Input
+	return preferredInput()
+end
+
+--[[
+	The player's background transparency setting: 1 by default, 0 for fully
+	opaque. Multiply each BackgroundTransparency by it.
+]]
+function Module.preferredTransparency(): number
+	return preferredTransparency()
+end
+
+-- In edit mode (stories, specs) each fresh copy of this module would be kept
+-- alive by its connections.
+if RunService:IsRunning() then
+	watchCamera()
+	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
+	GuiService:GetPropertyChangedSignal("ViewportDisplaySize"):Connect(refresh)
+	GuiService:GetPropertyChangedSignal("PreferredTransparency"):Connect(refresh)
+	UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(refresh)
+else
+	refresh()
+end
+
+return Module
