diff --git a/src/StarterPlayer/StarterPlayerScripts/Controls.luau b/src/StarterPlayer/StarterPlayerScripts/Controls.luau
new file mode 100644
index 0000000..7cff142
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/Controls.luau
@@ -0,0 +1,24 @@
+--[[
+	The HUD's key and button bindings. Main.client binds them and the HUD reads them for its
+	prompts, so changing a binding here changes both. Number keys for picking a block live in
+	BlockPlacer.
+
+	Gamepad buttons left free on purpose: A (jump), thumbsticks (move and camera), Select/View
+	(Roblox uses it to toggle UI navigation), Start/Menu (Roblox menu), and the triggers, which are
+	left for controller block placement.
+]]
+
+local Controls = table.freeze({
+	Keyboard = table.freeze({
+		BuildMode = Enum.KeyCode.B,
+		Inventory = Enum.KeyCode.I,
+	}),
+	Gamepad = table.freeze({
+		BuildMode = Enum.KeyCode.ButtonX,
+		Inventory = Enum.KeyCode.ButtonY,
+		PreviousBlock = Enum.KeyCode.ButtonL1,
+		NextBlock = Enum.KeyCode.ButtonR1,
+	}),
+})
+
+return Controls
diff --git a/src/StarterPlayer/StarterPlayerScripts/InputMode.luau b/src/StarterPlayer/StarterPlayerScripts/InputMode.luau
new file mode 100644
index 0000000..37bc6e6
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/InputMode.luau
@@ -0,0 +1,36 @@
+--[[
+	Which kind of input the player is using right now, so UI can show the right prompts and
+	layout. Follows UserInputService.PreferredInput, which Roblox updates as the player switches
+	input mid-session (picking up a controller on PC, touching the screen on a laptop) and which
+	ignores noise such as phone gyro readings.
+]]
+
+local UserInputService = game:GetService("UserInputService")
+
+export type InputMode = "KeyboardMouse" | "Touch" | "Gamepad"
+
+local InputMode = {}
+
+function InputMode.get(): InputMode
+	local preferred = UserInputService.PreferredInput
+	if preferred == Enum.PreferredInput.Touch then
+		return "Touch"
+	elseif
+		preferred == Enum.PreferredInput.Gamepad
+		or preferred == Enum.PreferredInput.MicroGamepad
+	then
+		return "Gamepad"
+	end
+	return "KeyboardMouse"
+end
+
+--[[
+	Calls the callback with the new mode whenever it changes.
+]]
+function InputMode.observe(callback: (mode: InputMode) -> ()): RBXScriptConnection
+	return UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(function()
+		callback(InputMode.get())
+	end)
+end
+
+return InputMode
