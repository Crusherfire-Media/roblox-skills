 type BlockType = BlockTypes.BlockType
+type Mode = InputMode.Mode
 
-local SLOT_SIZE = 40
-local SLOT_GAP = 4
 local KEY_LABELS = { "1", "2", "3", "4", "5", "6", "7", "8", "9", "0" }
 local SELECTED_COLOR = Color3.fromRGB(255, 200, 60)
 local IDLE_STROKE_COLOR = Color3.fromRGB(20, 20, 24)
 local PANEL_COLOR = Color3.fromRGB(28, 28, 34)
 local TEXT_COLOR = Color3.fromRGB(240, 240, 240)
+local BUILD_ON_COLOR = Color3.fromRGB(60, 140, 70)
+
+-- Keys and buttons shown in hints. Main.client.luau binds the same ones.
+local GAMEPAD_PREVIOUS_BLOCK = Enum.KeyCode.ButtonL1
+local GAMEPAD_NEXT_BLOCK = Enum.KeyCode.ButtonR1
+local GAMEPAD_BUILD_MODE = Enum.KeyCode.ButtonY
+local GAMEPAD_INVENTORY = Enum.KeyCode.ButtonX
+
+-- Apple and Google both recommend touch targets of at least 44 points.
+local MIN_TOUCH_TARGET = 44
+local MAX_TOUCH_SLOT = 56
 
 export type HudProps = {
 	Selected: () -> string,
 	Select: (name: string) -> (),
 	BuildMode: () -> boolean,
+	ToggleBuildMode: () -> (),
 	Coins: () -> number,
 	OpenInventory: () -> (),
+	InputMode: () -> Mode,
+	-- Size of the ScreenGui the HUD is mounted in.
+	ScreenSize: () -> Vector2,
+}
+
+--[[
+	Every size and offset that depends on the input mode or screen size. Offsets are in pixels
+	from the screen edges.
+]]
+type Layout = {
+	SlotSize: number,
+	SlotGap: number,
+	Padding: number,
+	Columns: number,
+	HotbarWidth: number,
+	HotbarHeight: number,
+	-- Distance from the bottom of the screen to the bottom of the hotbar.
+	HotbarBottom: number,
+	MarginX: number,
+	MarginY: number,
+	TextSize: number,
+	KeyTextSize: number,
+	-- Height of a glyph or button next to text.
+	ControlHeight: number,
+	-- Touch only: distance from the bottom of the screen to the bottom of the button stack.
+	TouchStackBottom: number,
+	TouchButtonWidth: number,
 }
 
+local function hotbarSize(
+	slotSize: number,
+	gap: number,
+	padding: number,
+	columns: number
+): (number, number)
+	local rows = math.ceil(#BlockTypes.List / columns)
+	return columns * slotSize + (columns - 1) * gap + 2 * padding,
+		rows * slotSize + (rows - 1) * gap + 2 * padding
+end
+
+local function finish(layout: Layout): Layout
+	layout.HotbarWidth, layout.HotbarHeight =
+		hotbarSize(layout.SlotSize, layout.SlotGap, layout.Padding, layout.Columns)
+	return layout
+end
+
+-- The PC layout is fixed so it stays exactly as it was before the HUD supported other inputs.
+local function keyboardMouseLayout(): Layout
+	return finish({
+		SlotSize = 40,
+		SlotGap = 4,
+		Padding = 6,
+		Columns = #BlockTypes.List,
+		HotbarWidth = 0,
+		HotbarHeight = 0,
+		HotbarBottom = 16,
+		MarginX = 16,
+		MarginY = 16,
+		TextSize = 14,
+		KeyTextSize = 12,
+		ControlHeight = 28,
+		TouchStackBottom = 0,
+		TouchButtonWidth = 0,
+	})
+end
+
+--[[
+	Roblox's default touch controls put a thumbstick in the bottom left and a jump button in the
+	bottom right, sized by the screen's shorter side. These numbers mirror the default
+	TouchThumbstick and TouchJump modules so the HUD stays clear of both.
+]]
+local function touchLayout(screen: Vector2): Layout
+	local isSmallScreen = math.min(screen.X, screen.Y) <= 500
+	local jumpSize = if isSmallScreen then 70 else 120
+	local jumpTop = if isSmallScreen then jumpSize + 20 else jumpSize * 1.75
+	local jumpReserve = jumpSize * 1.5 - 10
+	local thumbstickSize = if isSmallScreen then 70 else 120
+	local thumbstickReserve = if isSmallScreen
+		then thumbstickSize * 1.5 - 10
+		else thumbstickSize * 1.5
+	local sideReserve = math.max(jumpReserve, thumbstickReserve) + 12
+
+	local gap = 6
+	local padding = 6
+	local available = screen.X - 2 * sideReserve
+	local count = #BlockTypes.List
+
+	-- One row if the slots fit at a comfortable size, otherwise two rows.
+	local columns = count
+	local slotSize = math.floor((available - 2 * padding - (columns - 1) * gap) / columns)
+	if slotSize < MIN_TOUCH_TARGET then
+		columns = math.ceil(count / 2)
+		slotSize = math.floor((available - 2 * padding - (columns - 1) * gap) / columns)
+	end
+	slotSize = math.clamp(slotSize, MIN_TOUCH_TARGET, MAX_TOUCH_SLOT)
+
+	-- If even two rows don't fit between the controls (a portrait phone), lift the hotbar above them.
+	local width = hotbarSize(slotSize, gap, padding, columns)
+	local hotbarBottom = if width <= available then 16 else jumpTop + 12
+
+	return finish({
+		SlotSize = slotSize,
+		SlotGap = gap,
+		Padding = padding,
+		Columns = columns,
+		HotbarWidth = 0,
+		HotbarHeight = 0,
+		HotbarBottom = hotbarBottom,
+		MarginX = 16,
+		MarginY = 16,
+		TextSize = if isSmallScreen then 16 else 18,
+		KeyTextSize = 12,
+		ControlHeight = if isSmallScreen then MIN_TOUCH_TARGET else 52,
+		TouchStackBottom = jumpTop + 12,
+		TouchButtonWidth = if isSmallScreen then 112 else 140,
+	})
+end
+
+--[[
+	Read from across a room, so everything scales up with the screen height (1.5x at 1080p), and
+	everything stays inside a 5% margin for TVs that crop their edges.
+]]
+local function gamepadLayout(screen: Vector2): Layout
+	local scale = math.clamp(screen.Y / 720, 1, 1.5)
+	local gap = math.round(4 * scale)
+	local padding = math.round(6 * scale)
+	local marginX = math.max(math.round(16 * scale), math.round(screen.X * 0.05))
+	local marginY = math.max(math.round(16 * scale), math.round(screen.Y * 0.05))
+	local controlHeight = math.round(32 * scale)
+	local count = #BlockTypes.List
+
+	-- Shrink the slots if the hotbar and its bumper glyphs would run off a narrow window.
+	local available = screen.X - 2 * marginX - 2 * (controlHeight + gap)
+	local fitted = math.floor((available - 2 * padding - (count - 1) * gap) / count)
+	local slotSize = math.max(math.min(math.round(44 * scale), fitted), 32)
+
+	return finish({
+		SlotSize = slotSize,
+		SlotGap = gap,
+		Padding = padding,
+		Columns = count,
+		HotbarWidth = 0,
+		HotbarHeight = 0,
+		HotbarBottom = marginY,
+		MarginX = marginX,
+		MarginY = marginY,
+		TextSize = math.round(16 * scale),
+		KeyTextSize = math.round(12 * scale),
+		ControlHeight = controlHeight,
+		TouchStackBottom = 0,
+		TouchButtonWidth = 0,
+	})
+end
+
+local function computeLayout(mode: Mode, screen: Vector2): Layout
+	if mode == "Touch" then
+		return touchLayout(screen)
+	elseif mode == "Gamepad" then
+		return gamepadLayout(screen)
+	end
+	return keyboardMouseLayout()
+end
