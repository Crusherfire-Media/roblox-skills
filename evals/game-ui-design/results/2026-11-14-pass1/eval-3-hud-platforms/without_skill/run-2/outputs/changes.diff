+++ b/src/StarterPlayer/StarterPlayerScripts/InputMode.luau
@@ -0,0 +1,133 @@
+--[[
+	Tracks which kind of input the player is using right now: keyboard and mouse, touch, or a
+	gamepad. It follows the most recent real input, so a PC player who picks up a controller (or a
+	tablet player who plugs in a keyboard) switches mode as soon as they press something.
+
+	Small mouse nudges and thumbstick drift are ignored, so a resting controller or a bumped desk
+	doesn't make the HUD flicker between layouts.
+]]
+
+local GuiService = game:GetService("GuiService")
+local UserInputService = game:GetService("UserInputService")
+
+export type Mode = "KeyboardMouse" | "Touch" | "Gamepad"
+
+-- Mouse movement smaller than this, in pixels per event, doesn't count as using the mouse.
+local MOUSE_MOVE_THRESHOLD = 3
+-- Thumbstick deflection below this (0 to 1) doesn't count as using the gamepad.
+local THUMBSTICK_THRESHOLD = 0.3
+
+local GAMEPAD_INPUT_TYPES = {
+	[Enum.UserInputType.Gamepad1] = true,
+	[Enum.UserInputType.Gamepad2] = true,
+	[Enum.UserInputType.Gamepad3] = true,
+	[Enum.UserInputType.Gamepad4] = true,
+	[Enum.UserInputType.Gamepad5] = true,
+	[Enum.UserInputType.Gamepad6] = true,
+	[Enum.UserInputType.Gamepad7] = true,
+	[Enum.UserInputType.Gamepad8] = true,
+}
+
+local KEYBOARD_MOUSE_INPUT_TYPES = {
+	[Enum.UserInputType.Keyboard] = true,
+	[Enum.UserInputType.MouseButton1] = true,
+	[Enum.UserInputType.MouseButton2] = true,
+	[Enum.UserInputType.MouseButton3] = true,
+	[Enum.UserInputType.MouseWheel] = true,
+}
+
+local InputMode = {}
+
+local function modeForInputType(inputType: Enum.UserInputType): Mode?
+	if inputType == Enum.UserInputType.Touch then
+		return "Touch"
+	elseif GAMEPAD_INPUT_TYPES[inputType] then
+		return "Gamepad"
+	elseif
+		KEYBOARD_MOUSE_INPUT_TYPES[inputType] or inputType == Enum.UserInputType.MouseMovement
+	then
+		return "KeyboardMouse"
+	end
+	-- Focus, TextInput, Gyro, Accelerometer and so on say nothing about how the player plays.
+	return nil
+end
+
+--[[
+	The mode to fall back to when there's no recent input to go by: at startup, and when the last
+	gamepad disconnects.
+]]
+local function deviceDefaultMode(): Mode
+	if GuiService:IsTenFootInterface() then
+		return "Gamepad"
+	elseif UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
+		return "Touch"
+	elseif UserInputService.GamepadEnabled and not UserInputService.MouseEnabled then
+		return "Gamepad"
+	end
+	return "KeyboardMouse"
+end
+
+local function initialMode(): Mode
+	if GuiService:IsTenFootInterface() then
+		return "Gamepad"
+	end
+	return modeForInputType(UserInputService:GetLastInputType()) or deviceDefaultMode()
+end
+
+local current: Mode = initialMode()
+local changedEvent = Instance.new("BindableEvent")
+
+--[[
+	Fires with the new mode whenever it changes.
+]]
+InputMode.Changed = changedEvent.Event
+
+function InputMode.get(): Mode
+	return current
+end
+
+local function set(mode: Mode)
+	if mode == current then
+		return
+	end
+	current = mode
+	changedEvent:Fire(mode)
+end
+
+UserInputService.InputBegan:Connect(function(input: InputObject)
+	local mode = modeForInputType(input.UserInputType)
+	if mode then
+		set(mode)
+	end
+end)
+
+UserInputService.InputChanged:Connect(function(input: InputObject)
+	local inputType = input.UserInputType
+	if inputType == Enum.UserInputType.MouseMovement then
+		if input.Delta.Magnitude >= MOUSE_MOVE_THRESHOLD then
+			set("KeyboardMouse")
+		end
+	elseif inputType == Enum.UserInputType.MouseWheel then
+		set("KeyboardMouse")
+	elseif inputType == Enum.UserInputType.Touch then
+		set("Touch")
+	elseif GAMEPAD_INPUT_TYPES[inputType] then
+		local isStick = input.KeyCode == Enum.KeyCode.Thumbstick1
+			or input.KeyCode == Enum.KeyCode.Thumbstick2
+		if not isStick or input.Position.Magnitude >= THUMBSTICK_THRESHOLD then
+			set("Gamepad")
+		end
+	end
+end)
+
+UserInputService.GamepadDisconnected:Connect(function()
+	if current == "Gamepad" and #UserInputService:GetConnectedGamepads() == 0 then
+		-- On a console there's nothing else to switch to, so stay in gamepad mode there.
+		local fallback = deviceDefaultMode()
+		if fallback ~= "Gamepad" then
+			set(fallback)
+		end
+	end
+end)
+
+return InputMode
