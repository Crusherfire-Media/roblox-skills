+
+-- Tappable buttons stacked above the jump button, where the right thumb already rests.
+local function touchControls(props: HudProps, layout: () -> Layout): { Instance }
+	local function buttonSize()
+		return UDim2.fromOffset(layout().TouchButtonWidth, layout().ControlHeight)
+	end
+
+	return {
+		create("TextButton")({
+			Name = "BuildModeButton",
+			AnchorPoint = Vector2.new(1, 1),
+			Position = function()
+				return UDim2.new(1, -layout().MarginX, 1, -layout().TouchStackBottom)
+			end,
+			Size = buttonSize,
+			BackgroundColor3 = function()
+				return if props.BuildMode() then BUILD_ON_COLOR else PANEL_COLOR
+			end,
+			BackgroundTransparency = 0.15,
+			Font = Enum.Font.GothamBold,
+			TextSize = function()
