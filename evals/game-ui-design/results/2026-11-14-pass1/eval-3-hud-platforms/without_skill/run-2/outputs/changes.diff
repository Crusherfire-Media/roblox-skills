-	while the mouse is over it.
+	The in-game HUD: a hotbar of the ten block types along the bottom, the build mode control, the
+	inventory button, and the coin counter. It lays itself out for whichever input the player is
+	using right now and switches live when that changes:
+
+	- KeyboardMouse: the original PC layout. Number keys on the slots, [B] and [I] hints, and a
+	  slot's name in a tooltip while the mouse is over it.
+	- Touch: bigger slots fitted between the thumbstick and jump button (two rows on small phones),
+	  tappable Build and Inventory buttons stacked above the jump button, and the selected block's
+	  name above the hotbar since there's no hover.
+	- Gamepad: sized for a TV, kept inside a 5% safe margin, with LB/RB glyphs beside the hotbar
+	  and Y/X glyphs on the build and inventory hints. Glyphs come from the platform, so they match
+	  Xbox or PlayStation controllers.
 ]]
 
 local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local UserInputService = game:GetService("UserInputService")
 
 local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local InputMode = require(script.Parent.Parent.InputMode)
 local Vide = require(ReplicatedStorage.Packages.Vide)
 
 local create = Vide.create
