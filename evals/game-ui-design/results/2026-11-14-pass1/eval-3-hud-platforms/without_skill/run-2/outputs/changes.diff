 end)
 
+--[[
+	Controller buttons for the HUD. Hud.luau shows glyphs for these same buttons, so change both
+	together. ButtonA (jump) and the triggers are left free for movement and block placement.
+]]
+local function onPress(callback: () -> ())
+	return function(_: string, state: Enum.UserInputState): Enum.ContextActionResult
+		if state ~= Enum.UserInputState.Begin then
+			return Enum.ContextActionResult.Pass
