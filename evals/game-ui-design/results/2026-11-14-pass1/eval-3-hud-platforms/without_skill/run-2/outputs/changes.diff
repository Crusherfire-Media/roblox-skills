+	end
+end
+
+ContextActionService:BindAction(
+	"HudPreviousBlock",
+	onPress(function()
+		cycleBlockType(-1)
+	end),
+	false,
+	Enum.KeyCode.ButtonL1
+)
+ContextActionService:BindAction(
+	"HudNextBlock",
+	onPress(function()
+		cycleBlockType(1)
+	end),
+	false,
+	Enum.KeyCode.ButtonR1
+)
+ContextActionService:BindAction(
+	"HudToggleBuildMode",
+	onPress(toggleBuildMode),
+	false,
+	Enum.KeyCode.ButtonY
+)
+ContextActionService:BindAction(
+	"HudOpenInventory",
+	onPress(openInventory),
+	false,
+	Enum.KeyCode.ButtonX
+)
+
 mount(function()
 	return create("ScreenGui")({
 		Name = "HudGui",
 
+		changed("AbsoluteSize", function(size: Vector2)
+			screenSize(size)
+		end),
+
 		Hud({
 			Selected = selected,
 			Select = BlockPlacer.setBlockType,
 			BuildMode = buildMode,
+			ToggleBuildMode = toggleBuildMode,
 			Coins = coins,
