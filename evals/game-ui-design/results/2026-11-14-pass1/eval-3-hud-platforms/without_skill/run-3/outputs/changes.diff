+	elseif mode == "Touch" then
+		local gap, padding, margin = 4, 6, 12
+		local isSmallScreen = math.min(screen.X, screen.Y) <= SMALL_SCREEN_AXIS
+		local available = screen.X - 2 * (if isSmallScreen then TOUCH_SIDE_RESERVE else margin)
+		local columns = count
+		local slotSize = math.min(fitSlot(available, columns, gap, padding), MAX_TOUCH_SLOT)
