+			callback()
+		end
+		return Enum.ContextActionResult.Sink
+	end, false, GAMEPAD_ACTION_PRIORITY, keyCode)
+end
+
+bindGamepadAction("HudToggleBuildMode", Controls.Gamepad.ToggleBuildMode.KeyCode, toggleBuildMode)
+bindGamepadAction("HudOpenInventory", Controls.Gamepad.OpenInventory.KeyCode, openInventory)
+bindGamepadAction("HudPreviousBlock", Controls.Gamepad.PreviousBlock.KeyCode, function()
+	cycleBlockType(-1)
+end)
+bindGamepadAction("HudNextBlock", Controls.Gamepad.NextBlock.KeyCode, function()
+	cycleBlockType(1)
+end)
+
+InputMode.start()
+
 mount(function()
 	return create("ScreenGui")({
 		Name = "HudGui",
+		-- Otherwise the HUD is destroyed on respawn and this script, which runs once, never
