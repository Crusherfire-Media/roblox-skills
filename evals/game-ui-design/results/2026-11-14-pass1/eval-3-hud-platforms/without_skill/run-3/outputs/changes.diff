diff --git a/src/StarterPlayer/StarterPlayerScripts/Controls.luau b/src/StarterPlayer/StarterPlayerScripts/Controls.luau
new file mode 100644
index 0000000..7461e22
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/Controls.luau
@@ -0,0 +1,27 @@
+--[[
+	The keys and controller buttons for the HUD's actions, in one place so the input handling in
+	Main.client and the button prompts the HUD draws can't drift apart. Block placement with a
+	controller is bound elsewhere; keep these clear of whatever that uses.
+]]
+
+export type GamepadBinding = {
+	KeyCode: Enum.KeyCode,
+	-- Shown in place of the controller glyph if Roblox has no image for the button.
+	Label: string,
+}
+
+local Controls = {
+	Keyboard = table.freeze({
+		ToggleBuildMode = Enum.KeyCode.B,
+		OpenInventory = Enum.KeyCode.I,
+	}),
+
+	Gamepad = table.freeze({
+		ToggleBuildMode = table.freeze({ KeyCode = Enum.KeyCode.ButtonX, Label = "X" }) :: GamepadBinding,
+		OpenInventory = table.freeze({ KeyCode = Enum.KeyCode.ButtonY, Label = "Y" }) :: GamepadBinding,
+		PreviousBlock = table.freeze({ KeyCode = Enum.KeyCode.ButtonL1, Label = "LB" }) :: GamepadBinding,
+		NextBlock = table.freeze({ KeyCode = Enum.KeyCode.ButtonR1, Label = "RB" }) :: GamepadBinding,
+	}),
+}
+
+return table.freeze(Controls)
diff --git a/src/StarterPlayer/StarterPlayerScripts/InputMode.luau b/src/StarterPlayer/StarterPlayerScripts/InputMode.luau
new file mode 100644
index 0000000..3c2f55e
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/InputMode.luau
@@ -0,0 +1,145 @@
+--[[
+	Tracks which kind of input the player is using right now: keyboard and mouse, touch, or a
+	gamepad. It follows the player as they switch mid-session (picking up a controller on PC,
+	plugging a keyboard into a tablet), so UI can read InputMode.get() in a Vide scope and re-render.
+
+	A few guards keep it from flickering:
+	- Analog sticks and triggers only count once pushed past ANALOG_THRESHOLD, so a drifting stick
+	  on a controller lying on the desk doesn't pull a mouse player into gamepad mode.
+	- Mouse input right after a touch is ignored, since some touch devices report emulated mouse
+	  events alongside the touch.
+	- Focus, text input, and motion sensor events don't change the mode.
+]]
+
+local GuiService = game:GetService("GuiService")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local UserInputService = game:GetService("UserInputService")
+
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+export type Mode = "KeyboardMouse" | "Touch" | "Gamepad"
+
+local ANALOG_THRESHOLD = 0.5
+local TOUCH_MOUSE_GRACE_SECONDS = 1
+
+local GAMEPAD_TYPES: { [Enum.UserInputType]: true } = {
+	[Enum.UserInputType.Gamepad1] = true,
+	[Enum.UserInputType.Gamepad2] = true,
+	[Enum.UserInputType.Gamepad3] = true,
+	[Enum.UserInputType.Gamepad4] = true,
+	[Enum.UserInputType.Gamepad5] = true,
+	[Enum.UserInputType.Gamepad6] = true,
+	[Enum.UserInputType.Gamepad7] = true,
+	[Enum.UserInputType.Gamepad8] = true,
+}
+
+local MOUSE_TYPES: { [Enum.UserInputType]: true } = {
+	[Enum.UserInputType.MouseButton1] = true,
+	[Enum.UserInputType.MouseButton2] = true,
+	[Enum.UserInputType.MouseButton3] = true,
+	[Enum.UserInputType.MouseWheel] = true,
+	[Enum.UserInputType.MouseMovement] = true,
+}
+
+local ANALOG_KEYS: { [Enum.KeyCode]: true } = {
+	[Enum.KeyCode.Thumbstick1] = true,
+	[Enum.KeyCode.Thumbstick2] = true,
+	[Enum.KeyCode.ButtonL2] = true,
+	[Enum.KeyCode.ButtonR2] = true,
+}
+
+local InputMode = {}
+
+local function fallbackMode(): Mode
+	if GuiService:IsTenFootInterface() then
+		return "Gamepad"
+	end
+	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
+		return "Touch"
+	end
+	if
+		UserInputService.GamepadEnabled
+		and not UserInputService.KeyboardEnabled
+		and not UserInputService.MouseEnabled
+	then
+		return "Gamepad"
+	end
+	return "KeyboardMouse"
+end
+
+local function modeForType(inputType: Enum.UserInputType): Mode?
+	if inputType == Enum.UserInputType.Touch then
+		return "Touch"
+	elseif GAMEPAD_TYPES[inputType] then
+		return "Gamepad"
+	elseif inputType == Enum.UserInputType.Keyboard or MOUSE_TYPES[inputType] then
+		return "KeyboardMouse"
+	end
+	return nil
+end
+
+local mode = Vide.source(modeForType(UserInputService:GetLastInputType()) or fallbackMode())
+local lastTouchTime = -math.huge
+local hasStarted = false
+
+local function onInput(input: InputObject)
+	local inputType = input.UserInputType
+	local newMode = modeForType(inputType)
+	if not newMode then
+		return
+	end
+
+	if newMode == "Touch" then
+		lastTouchTime = os.clock()
+	elseif newMode == "Gamepad" then
+		if ANALOG_KEYS[input.KeyCode] and input.Position.Magnitude < ANALOG_THRESHOLD then
+			return
+		end
+	elseif MOUSE_TYPES[inputType] then
+		if os.clock() - lastTouchTime < TOUCH_MOUSE_GRACE_SECONDS then
+			return
+		end
+		if inputType == Enum.UserInputType.MouseMovement and input.Delta.Magnitude == 0 then
+			return
+		end
+	end
+
+	if mode() ~= newMode then
+		mode(newMode)
+	end
+end
+
+local function onGamepadDisconnected()
+	if mode() == "Gamepad" and #UserInputService:GetConnectedGamepads() == 0 then
+		local newMode = fallbackMode()
+		-- With no controller left, fall back to whatever else the device has.
+		if newMode == "Gamepad" then
+			return
+		end
+		mode(newMode)
+	end
+end
+
+--[[
+	The input mode the player is using now. Reading it inside a Vide scope subscribes to changes.
+]]
+function InputMode.get(): Mode
+	return mode()
+end
+
+--[[
+	Starts following the player's input. Safe to call more than once.
+]]
+function InputMode.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	-- gameProcessedEvent is ignored on purpose: input on GUI still says which device is in hand.
+	UserInputService.InputBegan:Connect(onInput)
+	UserInputService.InputChanged:Connect(onInput)
+	UserInputService.GamepadDisconnected:Connect(onGamepadDisconnected)
+end
+
+return InputMode
