+
 local FrameReport = {}
 
+local function addInterval(intervals: Intervals, startTick: number, endTick: number)
+	if endTick > startTick then
+		table.insert(intervals, startTick)
+		table.insert(intervals, endTick)
+	end
+end
+
+--[[
+	Length of the union of the intervals, so nested instances of one scope, nested Physics
+	scopes, and overlapping GPU scopes are not counted twice.
+]]
+local function unionLength(intervals: Intervals): number
+	local spans = {}
+	for index = 1, #intervals, 2 do
+		table.insert(spans, { intervals[index], intervals[index + 1] })
+	end
+	table.sort(spans, function(a, b)
+		return a[1] < b[1]
+	end)
+
+	local total = 0
+	local currentStart, currentEnd = 0, nil
+	for _, span in spans do
+		if currentEnd and span[1] <= currentEnd then
+			currentEnd = math.max(currentEnd, span[2])
+		else
+			if currentEnd then
+				total += currentEnd - currentStart
+			end
+			currentStart, currentEnd = span[1], span[2]
+		end
+	end
+	if currentEnd then
+		total += currentEnd - currentStart
+	end
+	return total
+end
