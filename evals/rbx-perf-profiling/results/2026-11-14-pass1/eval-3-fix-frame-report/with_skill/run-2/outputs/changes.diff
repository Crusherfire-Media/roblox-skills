+-- start1, end1, start2, end2, ...
+type Intervals = { number }
+
+type FrameData = {
+	Row: FrameRow,
+	ScopeIntervals: { [number]: Intervals? },
+	PhysicsIntervals: Intervals,
+	GpuIntervals: Intervals,
