+--[[
+	Yields for about two seconds while the MicroProfiler collects the report's frames. Errors if
+	a report is already running, since both would fight over the frame limit.
+]]
+function FrameReport.run(): Report
+	assert(not isRunning, "a frame report is already running")
+	isRunning = true
+
+	local ok, result = pcall(function()
+		local snapshot = captureSnapshotAsync()
+		local session = LibMP.Session.OpenFromBuffer(snapshot)
+		assert(session, "could not open the MicroProfiler snapshot")
+		local buildOk, report = pcall(buildReport, session)
+		session:Dispose()
+		if not buildOk then
+			error(report, 0)
+		end
+		return report
+	end)
+
+	isRunning = false
+	if not ok then
+		error(result, 0)
+	end
+	return result
+end
