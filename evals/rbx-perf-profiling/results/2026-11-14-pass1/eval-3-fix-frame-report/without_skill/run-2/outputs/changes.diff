+function FrameReport.run(): Report
+	assert(LibMP.Control:CaptureToSlotSync(SNAPSHOT_SLOT), "could not snapshot the MicroProfiler data")
+	local session = LibMP.Session.OpenFromSlot(SNAPSHOT_SLOT)
+	if not session or not session:IsValid() then
+		if session then
+			session:Dispose()
+		end
+		LibMP.Control:ResetSlot(SNAPSHOT_SLOT)
+		error("could not open the MicroProfiler snapshot")
+	end
+
+	local ok, result = pcall(buildReport, session)
+	session:Dispose()
+	LibMP.Control:ResetSlot(SNAPSHOT_SLOT)
+	if not ok then
+		error(result, 0)
+	end
+	return result
+end
