+function FrameReport.run(): Report
+	-- Snapshot the live data into a session we own. Capture keeps running, and FpsOverlay's
+	-- shared live session isn't touched or disposed.
+	local snapshot = LibMP.Control:CaptureToBufferSync()
+	assert(snapshot, "could not capture the MicroProfiler data")
+	local session = LibMP.Session.OpenFromBuffer(snapshot)
+	assert(session, "could not open the MicroProfiler snapshot")
+	if not session:IsValid() then
+		session:Dispose()
+		error("the MicroProfiler snapshot is not valid")
+	end
