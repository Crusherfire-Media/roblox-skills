+function FrameReport.run(): Report
+	-- Hold the data still while we read it. Capture is always turned back on afterwards, even if
+	-- reading fails, or the on-screen MicroProfiler and FpsOverlay stay frozen.
+	LibMP.Control:EnableCapture(false)
+
+	-- Use a session of our own: FpsOverlay keeps its session open for the whole run, so we must
+	-- not share it (disposing it would break the overlay).
+	local session = LibMP.Session.OpenFromLiveData()
+	if not session then
+		LibMP.Control:EnableCapture(true)
+		error("could not open the MicroProfiler data", 2)
+	end
+
+	local ok, result = pcall(buildReport, session)
+	session:Dispose()
+	LibMP.Control:EnableCapture(true)
+
+	if not ok then
+		error(result, 0)
+	end
+	return result
+end
