 local function placedList(props: PlacedListProps): Frame
+	-- Shared clock for every row's age text. Ticks once per frame, only while the panel is open.
+	local now = source(os.clock())
+	effect(function()
+		if not props.IsOpen() then
+			return
+		end
+		now(os.clock())
+		local connection = RunService.Heartbeat:Connect(function()
+			now(os.clock())
+		end)
+		cleanup(function()
+			connection:Disconnect()
+		end)
+	end)
+
+	local scrollY = source(0)
+	local viewportHeight = source(0)
+
+	-- Display index (1 = newest) of the first row that is at least partly visible. Derived so that
+	-- scrolling within a row does not recompute the visible rows.
+	local firstIndex = derive(function()
+		return math.max(1, math.floor(scrollY() / ROW_STRIDE) + 1)
+	end)
+
+	-- Enough slots to cover the viewport at any scroll offset.
+	local slotCount = derive(function()
+		return math.ceil(viewportHeight() / ROW_STRIDE) + 1
+	end)
+
+	-- The blocks shown by each slot, in slot order. Keyed by slot, so `indexes` reuses the same
+	-- row instances and only pushes the new block into each slot.
+	local visible = derive(function()
+		local placed = props.Placed()
+		local count = #placed
+		local first = firstIndex()
+		local last = math.min(count, first + slotCount() - 1)
+		local result = table.create(math.max(0, last - first + 1))
+		for displayIndex = first, last do
+			-- Newest first: display index 1 is the last block in the array.
+			table.insert(result, placed[count - displayIndex + 1])
+		end
+		return result
+	end)
+
+	local function slot(entry: () -> PlacedBlock, slotIndex: number): Frame
+		return row(entry, function()
+			return firstIndex() + slotIndex - 1
+		end, now)
+	end
+
