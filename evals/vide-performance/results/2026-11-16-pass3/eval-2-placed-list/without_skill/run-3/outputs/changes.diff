 local function placedList(props: PlacedListProps): Frame
+	-- Shared clock for every age label. Created before the rows so that, on opening, it is
+	-- refreshed before any row reads it.
+	local now = source(os.clock())
+	effect(function()
+		if not props.IsOpen() then
+			return
+		end
+		now(os.clock())
+		cleanup(RunService.Heartbeat:Connect(function()
+			now(os.clock())
+		end))
+	end)
+
+	local scrollY = source(0)
+	local viewportHeight = source(0)
+
+	local count = derive(function()
+		return #props.Placed()
+	end)
+
+	-- Slot range the viewport covers. Kept as separate number derives so scrolling within a row
+	-- does not rebuild the visible set.
+	local firstSlot = derive(function()
+		return math.max(0, math.floor(scrollY() / ROW_STRIDE) - OVERSCAN)
+	end)
+	local lastSlot = derive(function()
+		return math.min(
+			count() - 1,
+			math.floor((scrollY() + viewportHeight()) / ROW_STRIDE) + OVERSCAN
+		)
+	end)
+	-- Upper bound on how many slots can be visible at once; frames are keyed by slot % poolSize.
+	local poolSize = derive(function()
+		return math.floor(viewportHeight() / ROW_STRIDE) + 2 + 2 * OVERSCAN
+	end)
+
+	local visibleRows = derive(function(): { [number]: VisibleRow }
+		local rows = {}
+		if not props.IsOpen() then
+			return rows
+		end
+
+		local placed = props.Placed()
+		local n = #placed
+		local pool = poolSize()
+		for slot = firstSlot(), lastSlot() do
+			-- Slot 0 is the newest block.
+			local index = n - slot
+			rows[slot % pool] = {
+				Slot = slot,
+				Index = index,
+				Entry = placed[index],
+			}
+		end
+		return rows
+	end)
+
 	return create("Frame")({
 		Name = "PlacedList",
 		AnchorPoint = Vector2.new(1, 0.5),
