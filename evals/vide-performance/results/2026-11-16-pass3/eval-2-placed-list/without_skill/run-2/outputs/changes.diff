 local function placedList(props: PlacedListProps): Frame
+	-- One clock for the whole panel, ticking only while the panel is open.
+	local now = source(os.clock())
+	effect(function()
+		if not props.IsOpen() then
+			return
+		end
+		now(os.clock())
+		local connection = RunService.Heartbeat:Connect(function()
+			now(os.clock())
+		end)
+		cleanup(function()
+			connection:Disconnect()
+		end)
+	end)
+
+	local scrollY = source(0)
+	local windowHeight = source(0)
+
+	local count = derive(function()
+		return #props.Placed()
+	end)
+
+	-- Display position (0 = newest, at the top) of the first row that is at least partly visible.
+	local firstVisible = derive(function()
+		return math.max(0, math.floor(scrollY() / ROW_STRIDE))
+	end)
+
+	-- The blocks currently on screen, newest first, one per row slot. Empty while the panel is
+	-- closed so no rows exist then.
+	local visibleBlocks = derive(function(): { PlacedBlock }
+		if not props.IsOpen() then
+			return {}
+		end
+		local placed = props.Placed()
+		local total = #placed
+		local first = firstVisible()
+		local slotCount = math.ceil(windowHeight() / ROW_STRIDE) + 1
+		local blocks = table.create(slotCount)
+		for slot = 1, slotCount do
+			local displayIndex = first + slot - 1
+			if displayIndex >= total then
+				break
+			end
+			blocks[slot] = placed[total - displayIndex]
+		end
+		return blocks
+	end)
+
+	local function slotRow(entry: () -> PlacedBlock, slot: number): Frame
+		return row(entry, function()
+			return (firstVisible() + slot - 1) * ROW_STRIDE
+		end, now)
+	end
+
