 local function placedList(props: PlacedListProps): Frame
+	local canvasY = source(0)
+	local frameTick = source(0)
+
+	effect(function()
+		if not props.IsOpen() then
+			return
+		end
+		cleanup(RunService.PreRender:Connect(function()
+			frameTick(frameTick() + 1)
+		end))
+	end)
