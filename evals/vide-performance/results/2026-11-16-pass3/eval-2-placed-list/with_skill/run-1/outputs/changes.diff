+--!strict
+
+local BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+local PlacedList = require("@game/StarterPlayer/StarterPlayerScripts/PlacedList")
+local UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local derive = Vide.derive
+
+local CONTROLS = {
+	BlockCount = UILabs.Ordered(UILabs.Slider(2000, 0, 5000, 1), 1),
+	IsOpen = UILabs.Ordered(true, 2),
+}
+-- Seconds between sample placements, so ages span seconds and minutes.
+local PLACE_INTERVAL = 0.5
+-- Sample blocks fill rows of this many along X.
+local ROW_LENGTH = 32
+
+type StoryProps = {
+	controls: {
+		BlockCount: () -> number,
+		IsOpen: () -> boolean,
+	},
+	target: Frame,
+}
+
+local function samplePlaced(count: number): { PlacedList.PlacedBlock }
+	local blockSize = BlockTypes.BlockSize
+	local now = os.clock()
+	local placed = {}
+	for index = 1, count do
+		local blockType = BlockTypes.List[(index - 1) % #BlockTypes.List + 1]
+		table.insert(placed, {
+			Id = index,
+			BlockTypeName = blockType.Name,
+			Position = Vector3.new(
+				((index - 1) % ROW_LENGTH) * blockSize,
+				blockSize / 2,
+				(index - 1) // ROW_LENGTH * blockSize
+			),
+			PlacedAt = now - (count - index) * PLACE_INTERVAL,
+		})
+	end
+	return placed
+end
+
+local function story(props: StoryProps)
+	local placed = derive(function(): { PlacedList.PlacedBlock }
+		return samplePlaced(props.controls.BlockCount())
+	end)
+
+	return PlacedList({
+		Placed = placed,
+		IsOpen = props.controls.IsOpen,
+	})
+end
+
+return {
+	summary = "The placed blocks panel, from empty to a long session's worth of blocks.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
