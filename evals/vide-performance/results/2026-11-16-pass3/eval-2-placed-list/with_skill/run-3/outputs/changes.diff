+--[[
+	A pooled row showing the entry at <displayIndex>, where 1 is the newest. It hides while that
+	index is past the end of the list.
+]]
+local function row(
+	placed: () -> { PlacedBlock },
+	displayIndex: () -> number,
+	now: () -> number
+): Frame
+	local entry = derive(function(): PlacedBlock?
+		local list = placed()
+		return list[#list - displayIndex() + 1]
+	end)
