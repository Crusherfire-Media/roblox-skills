 --[[
 	Plays UI sounds for the local player.
+
+	A Sound instance has to load its asset before it can play, and every new instance starts
+	unloaded, even when the id was preloaded. Creating a Sound per cue is what made clicks late.
+	Instead, UI code declares which sounds it needs with `UiSounds.use` while its Vide scope is
+	alive. That keeps one loaded Sound per id, shared and reference-counted across screens.
+	When the last user goes away the Sound is destroyed, after it finishes any cue it is playing.
+
+	`UiSounds.play` only plays sounds that are already loaded. If a cue is not loaded yet, it
+	waits up to LATE_LIMIT seconds and then drops the cue, because a click that comes half a
+	second late is worse than none.
 ]]
 
+local ContentProvider = game:GetService("ContentProvider")
+local RunService = game:GetService("RunService")
 local SoundService = game:GetService("SoundService")
 
+local Vide = require(game:GetService("ReplicatedStorage").Packages.Vide)
+
+-- Longest a cue may wait for its sound to load before it is dropped.
+local LATE_LIMIT = 0.1
+
+type Entry = {
+	sound: Sound,
+	refs: number,
+}
+
+local entries: { [string]: Entry } = {}
+
 local UiSounds = {}
 
+local function destroyWhenQuiet(soundId: string, entry: Entry)
+	local function tryDestroy()
+		-- Someone may have retained the id again while we waited.
+		if entry.refs > 0 or entries[soundId] ~= entry then
+			return
+		end
+		entries[soundId] = nil
+		entry.sound:Destroy()
+	end
+
+	if entry.sound.IsPlaying then
+		entry.sound.Ended:Once(tryDestroy)
+	else
+		tryDestroy()
+	end
+end
+
+--[[
+	Keeps the sounds with <soundIds> loaded until the returned function is called.
+]]
+function UiSounds.retain(soundIds: { string }): () -> ()
+	for _, soundId in soundIds do
+		local entry = entries[soundId]
+		if entry then
+			entry.refs += 1
+		else
+			local sound = Instance.new("Sound")
+			sound.Name = soundId
+			sound.SoundId = soundId
+			sound.Parent = SoundService
+			entries[soundId] = { sound = sound, refs = 1 }
+			task.spawn(ContentProvider.PreloadAsync, ContentProvider, { sound })
+		end
+	end
+
+	local released = false
+	return function()
+		if released then
+			return
+		end
+		released = true
+		for _, soundId in soundIds do
+			local entry = entries[soundId]
+			if entry then
+				entry.refs -= 1
+				if entry.refs <= 0 then
+					destroyWhenQuiet(soundId, entry)
+				end
+			end
+		end
+	end
+end
+
+--[[
+	Keeps the sounds with <soundIds> loaded for the lifetime of the current Vide scope.
+	Call it from a component, ideally one that exists before the sounds are needed.
+]]
+function UiSounds.use(soundIds: { string })
+	Vide.cleanup(UiSounds.retain(soundIds))
+end
+
 --[[
-	Plays the sound with <soundId> once.
+	Plays the sound with <soundId> once. The id must be retained with `use` or `retain`.
 ]]
 function UiSounds.play(soundId: string)
-	local sound = Instance.new("Sound")
-	sound.SoundId = soundId
-	sound.Parent = SoundService
-	sound.Ended:Once(function()
-		sound:Destroy()
+	local entry = entries[soundId]
+	if not entry then
+		if RunService:IsStudio() then
+			warn(`UiSounds: {soundId} played without being retained; call UiSounds.use first`)
+		end
+		return
+	end
+
+	local sound = entry.sound
+	if sound.IsLoaded then
+		sound.TimePosition = 0
+		sound:Play()
+		return
+	end
+
+	-- Not loaded yet: play only if it loads within LATE_LIMIT.
+	local pressedAt = os.clock()
+	sound.Loaded:Once(function()
+		local late = os.clock() - pressedAt
+		if late <= LATE_LIMIT and sound.Parent then
+			sound.TimePosition = 0
+			sound:Play()
+		elseif RunService:IsStudio() then
+			warn(`UiSounds: dropped {soundId}, it loaded {math.round(late * 1000)} ms after the cue`)
+		end
 	end)
-	sound:Play()
 end
 
 return UiSounds
