@@ -1,22 +1,113 @@
 --[[
 	Plays UI sounds for the local player.
+
+	A sound can only play on time if its Sound instance has already loaded. Creating a new Sound per
+	play means every cue starts unloaded, and Sound:Play() on an unloaded sound waits for the load
+	and plays late, even when ContentProvider has the asset cached.
+
+	So sounds are held: UiSounds.hold(ids) keeps one loaded Sound per id in SoundService, and
+	returns a function that lets go of the hold. Holds are counted, so many screens can hold the
+	same click and it is destroyed only once none of them hold it. Hold a sound for as long as the
+	UI that plays it can be used, e.g. with Vide's cleanup:
+
+		cleanup(UiSounds.hold({ SoundIds.Click }))
+
+	UiSounds.play only plays held sounds. If the sound has not finished loading, it plays only if
+	the load finishes within LATE_TOLERANCE; a late cue is worse than a missing one.
 ]]
 
+local ContentProvider = game:GetService("ContentProvider")
+local RunService = game:GetService("RunService")
 local SoundService = game:GetService("SoundService")
 
+-- How late a cue may start, in seconds, if its sound is still loading when it is played.
+local LATE_TOLERANCE = 0.08
+
+type Entry = {
+	Sound: Sound,
+	Holds: number,
+}
+
+local entries: { [string]: Entry } = {}
+
 local UiSounds = {}
 
 --[[
-	Plays the sound with <soundId> once.
+	Loads the sounds with <soundIds> and keeps them loaded until the returned function is called.
+	Calling the returned function more than once does nothing.
+]]
+function UiSounds.hold(soundIds: { string }): () -> ()
+	local newSounds = {}
+	for _, soundId in soundIds do
+		local entry = entries[soundId]
+		if entry == nil then
+			local sound = Instance.new("Sound")
+			sound.Name = soundId
+			sound.SoundId = soundId
+			sound.Parent = SoundService
+			entry = { Sound = sound, Holds = 0 }
+			entries[soundId] = entry
+			table.insert(newSounds, sound)
+		end
+		entry.Holds += 1
+	end
+
+	if #newSounds > 0 then
+		task.spawn(function()
+			ContentProvider:PreloadAsync(newSounds)
+		end)
+	end
+
+	local released = false
+	return function()
+		if released then
+			return
+		end
+		released = true
+		for _, soundId in soundIds do
+			local entry = entries[soundId]
+			entry.Holds -= 1
+			if entry.Holds == 0 then
+				entries[soundId] = nil
+				entry.Sound:Destroy()
+			end
+		end
+	end
+end
+
+local function start(sound: Sound)
+	sound.TimePosition = 0
+	sound:Play()
+end
+
+--[[
+	Plays the sound with <soundId> once. The sound must be held with UiSounds.hold.
 ]]
 function UiSounds.play(soundId: string)
-	local sound = Instance.new("Sound")
-	sound.SoundId = soundId
-	sound.Parent = SoundService
-	sound.Ended:Once(function()
-		sound:Destroy()
+	local entry = entries[soundId]
+	if entry == nil then
+		if RunService:IsStudio() then
+			warn(`UiSounds.play: {soundId} is not held, so it is skipped. Hold it with UiSounds.hold.`)
+		end
+		return
+	end
+
+	local sound = entry.Sound
+	if sound.IsLoaded then
+		start(sound)
+		return
+	end
+
+	-- Still loading: play only if the load finishes soon enough to sound on time.
+	local playedAt = os.clock()
+	local connection = sound.Loaded:Once(function()
+		if os.clock() - playedAt <= LATE_TOLERANCE and entries[soundId] == entry then
+			start(sound)
+		end
+	end)
+	task.delay(LATE_TOLERANCE, function()
+		connection:Disconnect()
 	end)
-	sound:Play()
 end
 
