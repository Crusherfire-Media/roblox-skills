 local isBuildMode = source(false)
 
+--[[
+	The picker's sounds are only held around build mode. They start loading as soon as the player
+	shows intent to build (pointer over or pressing the Build button) so the open sound is ready when
+	the picker appears, stay loaded during build mode, and are let go PICKER_SOUNDS_LINGER seconds
+	after build mode ends (which also lets the close sound finish and covers quick re-toggles).
+]]
+local PICKER_SOUNDS = { SoundIds.PickerOpen, SoundIds.PickerClose }
+local PICKER_SOUNDS_LINGER = 30
+
+local releasePickerSounds: (() -> ())? = nil
+local pickerSoundsLinger: thread? = nil
+
+local function warmPickerSounds()
+	if pickerSoundsLinger then
+		task.cancel(pickerSoundsLinger)
+		pickerSoundsLinger = nil
+	end
+	if releasePickerSounds == nil then
+		releasePickerSounds = UiSounds.hold(PICKER_SOUNDS)
+	end
+end
+
+local function coolPickerSounds()
+	if releasePickerSounds == nil or isBuildMode() then
+		return
+	end
+	if pickerSoundsLinger then
+		task.cancel(pickerSoundsLinger)
+	end
+	pickerSoundsLinger = task.delay(PICKER_SOUNDS_LINGER, function()
+		pickerSoundsLinger = nil
+		if releasePickerSounds and not isBuildMode() then
+			releasePickerSounds()
+			releasePickerSounds = nil
+		end
+	end)
+end
+
 local function setBuildMode(enabled: boolean)
+	if enabled then
+		warmPickerSounds()
+	end
 	BlockPlacer.setEnabled(enabled)
 	isBuildMode(enabled)
+	if not enabled then
+		coolPickerSounds()
+	end
 end
 
