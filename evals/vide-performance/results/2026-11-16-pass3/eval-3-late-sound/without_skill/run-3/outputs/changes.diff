diff --git a/src/StarterPlayer/StarterPlayerScripts/UiSounds.luau b/src/StarterPlayer/StarterPlayerScripts/UiSounds.luau
index 96c3d10..6bf78d8 100644
--- a/src/StarterPlayer/StarterPlayerScripts/UiSounds.luau
+++ b/src/StarterPlayer/StarterPlayerScripts/UiSounds.luau
@@ -1,15 +1,97 @@
 --[[
 	Plays UI sounds for the local player.
+
+	A Sound has to load its asset before it can play, so a Sound made at the moment of a click plays
+	late. Instead, UI that plays a sound declares it with `UiSounds.use(soundId)` while it is built.
+	That keeps one loaded Sound per id for as long as anything is using it, and `UiSounds.play` then
+	plays that Sound straight away.
+
+	Uses are counted, so several screens can share a sound. When the last use goes away (its Vide
+	scope is cleaned up) the Sound is destroyed, after it finishes playing if it is playing.
 ]]
 
+local ContentProvider = game:GetService("ContentProvider")
+local RunService = game:GetService("RunService")
 local SoundService = game:GetService("SoundService")
 
+local Vide = require(game:GetService("ReplicatedStorage").Packages.Vide)
+
+local cleanup = Vide.cleanup
+
+type Entry = {
+	sound: Sound,
+	uses: number,
+}
+
+local entries: { [string]: Entry } = {}
+
 local UiSounds = {}
 
+local function destroyIfUnused(soundId: string, entry: Entry)
+	if entry.uses > 0 or entries[soundId] ~= entry then
+		return
+	end
+	entries[soundId] = nil
+	entry.sound:Destroy()
+end
+
 --[[
-	Plays the sound with <soundId> once.
+	Keeps the sound with <soundId> loaded until the current Vide scope is cleaned up. Call it while
+	building any UI that plays the sound, and early enough that it has loaded before it plays: for
+	a sound that plays as a screen opens, call it from whatever opens the screen.
+]]
+function UiSounds.use(soundId: string)
+	local entry = entries[soundId]
+	if entry then
+		entry.uses += 1
+	else
+		local sound = Instance.new("Sound")
+		sound.Name = soundId
+		sound.SoundId = soundId
+		sound.Parent = SoundService
+		entry = { sound = sound, uses = 1 }
+		entries[soundId] = entry
+		task.spawn(function()
+			ContentProvider:PreloadAsync({ sound })
+		end)
+	end
+
+	local released = false
+	cleanup(function()
+		if released then
+			return
+		end
+		released = true
+		entry.uses -= 1
+		if entry.uses > 0 then
+			return
+		end
+		if entry.sound.IsPlaying then
+			-- Let a sound played during cleanup (like a close sound) finish first.
+			entry.sound.Ended:Once(function()
+				destroyIfUnused(soundId, entry)
+			end)
+		else
+			destroyIfUnused(soundId, entry)
+		end
+	end)
+end
+
+--[[
+	Plays the sound with <soundId> from the start. The sound should be in use (see `UiSounds.use`);
+	if it isn't, it still plays, but late, because it has to load first.
 ]]
 function UiSounds.play(soundId: string)
+	local entry = entries[soundId]
+	if entry then
+		entry.sound.TimePosition = 0
+		entry.sound:Play()
+		return
+	end
+
+	if RunService:IsStudio() then
+		warn(`UiSounds.play: {soundId} is not in use, so it will play late. Call UiSounds.use for it.`)
+	end
 	local sound = Instance.new("Sound")
 	sound.SoundId = soundId
 	sound.Parent = SoundService
