 --[[
 	Plays UI sounds for the local player.
+
+	A sound's asset stays in memory only while some Sound references it, so a
+	cue played from a fresh Sound loads its asset first and plays late. Each
+	screen holds the sounds it plays while it can play them, and cues clone the
+	held copy. Holds are counted, so screens that share a sound share one copy.
 ]]
 
+local RunService = game:GetService("RunService")
 local SoundService = game:GetService("SoundService")
 
 local UiSounds = {}
 
+local cachedSounds: { [string]: Sound? } = {}
+local holdCounts: { [string]: number? } = {}
+local cacheFolder: Folder? = nil
+
+local function getCacheFolder(): Folder
+	local folder = cacheFolder
+	if folder then
+		return folder
+	end
+	local newFolder = Instance.new("Folder")
+	newFolder.Name = "UiSoundCache"
+	newFolder.Parent = SoundService
+	cacheFolder = newFolder
+	return newFolder
+end
+
+--[[
+	Keeps <soundId> cached until the returned release is called. Releasing twice
+	is harmless. Caches nothing while the game is not running.
+]]
+function UiSounds.hold(soundId: string): () -> ()
+	if not RunService:IsRunning() then
+		return function() end
+	end
+
+	holdCounts[soundId] = (holdCounts[soundId] or 0) + 1
+	if not cachedSounds[soundId] then
+		local sound = Instance.new("Sound")
+		sound.Name = soundId
+		sound.SoundId = soundId
+		sound.Parent = getCacheFolder()
+		cachedSounds[soundId] = sound
+	end
+
+	local isReleased = false
+	return function()
+		if isReleased then
+			return
+		end
+		isReleased = true
+		local count = (holdCounts[soundId] or 1) - 1
+		holdCounts[soundId] = if count > 0 then count else nil
+		if count > 0 then
+			return
+		end
+		-- Deferred, so a release followed at once by a new hold keeps the copy.
+		task.defer(function()
+			if holdCounts[soundId] then
+				return
+			end
+			local sound = cachedSounds[soundId]
+			cachedSounds[soundId] = nil
+			if sound then
+				sound:Destroy()
+			end
+		end)
+	end
+end
+
+function UiSounds.isCached(soundId: string): boolean
+	return cachedSounds[soundId] ~= nil
+end
+
 --[[
-	Plays the sound with <soundId> once.
+	Plays the sound with <soundId> once. It plays on time only while something
+	holds <soundId>.
 ]]
 function UiSounds.play(soundId: string)
-	local sound = Instance.new("Sound")
-	sound.SoundId = soundId
+	local cached = cachedSounds[soundId]
+	local sound: Sound
+	if cached then
+		sound = cached:Clone()
+	else
+		if RunService:IsStudio() then
+			warn(`UiSounds: {soundId} played with no hold, so it loads first and plays late`)
+		end
+		sound = Instance.new("Sound")
+		sound.SoundId = soundId
+	end
 	sound.Parent = SoundService
 	sound.Ended:Once(function()
 		sound:Destroy()
