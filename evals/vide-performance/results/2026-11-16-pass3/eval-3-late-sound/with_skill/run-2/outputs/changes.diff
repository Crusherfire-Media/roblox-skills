 --[[
 	Plays UI sounds for the local player.
+
+	A cue plays on time only while its sound is held: a Sound made when it is
+	cued loads its asset first and plays late. Screens hold the sounds they can
+	play, and holders of the same sound share one cached copy.
 ]]
 
+local RunService = game:GetService("RunService")
 local SoundService = game:GetService("SoundService")
 
+local cachedSounds: { [string]: Sound? } = {}
+local holdCounts: { [string]: number? } = {}
+local warnedSoundIds: { [string]: boolean? } = {}
+local cacheFolder: Folder? = nil
+
 local UiSounds = {}
 
+local function getCacheFolder(): Folder
+	local folder = cacheFolder
+	if not folder then
+		folder = Instance.new("Folder")
+		folder.Name = "UiSoundCache"
+		folder.Parent = SoundService
+		cacheFolder = folder
+	end
+	return folder
+end
+
+--[[
+	Keeps <soundId> cached until the returned release is called. Releasing
+	twice is harmless. Does nothing while the game is not running.
+]]
+function UiSounds.hold(soundId: string): () -> ()
+	if not RunService:IsRunning() then
+		return function() end
+	end
+
+	holdCounts[soundId] = (holdCounts[soundId] or 0) + 1
+	if not cachedSounds[soundId] then
+		local sound = Instance.new("Sound")
+		sound.SoundId = soundId
+		sound.Parent = getCacheFolder()
+		cachedSounds[soundId] = sound
+	end
+
+	local isReleased = false
+	return function()
+		if isReleased then
+			return
+		end
+		isReleased = true
+		local count = (holdCounts[soundId] or 1) - 1
+		holdCounts[soundId] = if count > 0 then count else nil
+		if count > 0 then
+			return
+		end
+		-- Deferred, so a release followed at once by a new hold, or a cue
+		-- played from the same cleanup, keeps the cached copy.
+		task.defer(function()
+			if holdCounts[soundId] then
+				return
+			end
+			local sound = cachedSounds[soundId]
+			cachedSounds[soundId] = nil
+			if sound then
+				sound:Destroy()
+			end
+		end)
+	end
+end
+
+--[[
+	Whether <soundId> is cached right now.
+]]
+function UiSounds.isCached(soundId: string): boolean
+	return cachedSounds[soundId] ~= nil
+end
+
 --[[
-	Plays the sound with <soundId> once.
+	Plays the sound with <soundId> once. Plays late unless something holds it.
 ]]
 function UiSounds.play(soundId: string)
-	local sound = Instance.new("Sound")
-	sound.SoundId = soundId
+	local cachedSound = cachedSounds[soundId]
+	local sound: Sound
+	if cachedSound then
+		sound = cachedSound:Clone()
+	else
+		if RunService:IsStudio() and not warnedSoundIds[soundId] then
+			warnedSoundIds[soundId] = true
+			warn(`UI sound {soundId} played without a hold, so it plays late`)
+		end
+		sound = Instance.new("Sound")
+		sound.SoundId = soundId
+	end
 	sound.Parent = SoundService
 	sound.Ended:Once(function()
 		sound:Destroy()
