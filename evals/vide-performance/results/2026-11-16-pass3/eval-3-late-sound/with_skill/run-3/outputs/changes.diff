@@ -1,17 +1,93 @@
 --[[
-	Plays UI sounds for the local player.
+	Plays UI sounds for the local player, from a cache of Sounds that UI keeps
+	held while it can play them. A Sound nothing keeps cached loads its asset
+	when cued, so it plays late.
 ]]
 
+local RunService = game:GetService("RunService")
 local SoundService = game:GetService("SoundService")
 
 local UiSounds = {}
 
+local cachedSounds: { [string]: Sound? } = {}
+local holdCounts: { [string]: number? } = {}
+local cacheFolder: Folder? = nil
+
+local function getCacheFolder(): Folder
+	if not cacheFolder then
+		local folder = Instance.new("Folder")
+		folder.Name = "UiSoundCache"
+		folder.Parent = SoundService
+		cacheFolder = folder
+	end
+	return cacheFolder :: Folder
+end
+
+--[[
+	Keeps <soundId> cached until the returned release is called. Holders share
+	one cached Sound, and the last release frees it. Releasing twice is
+	harmless. Caches nothing while the game is not running.
+]]
+function UiSounds.holdSound(soundId: string): () -> ()
+	if not RunService:IsRunning() then
+		return function() end
+	end
+
+	holdCounts[soundId] = (holdCounts[soundId] or 0) + 1
+	if not cachedSounds[soundId] then
+		local sound = Instance.new("Sound")
+		sound.Name = soundId
+		sound.SoundId = soundId
+		sound.Parent = getCacheFolder()
+		cachedSounds[soundId] = sound
+	end
+
+	local isReleased = false
+	return function()
+		if isReleased then
+			return
+		end
+		isReleased = true
+		local count = (holdCounts[soundId] or 1) - 1
+		holdCounts[soundId] = if count > 0 then count else nil
+		if count > 0 then
+			return
+		end
+		-- Deferred, so a new hold or a cue right after the last release (a
+		-- close sound played from the same cleanup) still finds the cached copy.
+		task.defer(function()
+			if holdCounts[soundId] then
+				return
+			end
+			local sound = cachedSounds[soundId]
+			cachedSounds[soundId] = nil
+			if sound then
+				sound:Destroy()
+			end
+		end)
+	end
+end
+
+--[[
+	Whether <soundId> is cached right now.
+]]
+function UiSounds.isCached(soundId: string): boolean
+	return cachedSounds[soundId] ~= nil
+end
+
 --[[
-	Plays the sound with <soundId> once.
+	Plays the sound with <soundId> once. It starts on time only while something
+	holds it with holdSound.
 ]]
 function UiSounds.play(soundId: string)
-	local sound = Instance.new("Sound")
-	sound.SoundId = soundId
+	local cachedSound = cachedSounds[soundId]
+	local sound: Sound
+	if cachedSound then
+		sound = cachedSound:Clone()
+	else
+		sound = Instance.new("Sound")
+		sound.SoundId = soundId
+	end
 	sound.Parent = SoundService
 	sound.Ended:Once(function()
 		sound:Destroy()
