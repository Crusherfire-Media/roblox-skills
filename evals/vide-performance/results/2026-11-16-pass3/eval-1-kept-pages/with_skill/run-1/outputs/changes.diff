+--[[
+	Every tab shown so far, each mapped to whether it is the one on show. Tabs never leave the
+	map, so `indexes` never destroys a page.
+]]
+local function visitedTabs(selectedTab: () -> Tab): () -> { [Tab]: boolean }
+	local visited: { [Tab]: boolean } = {}
+	return function(): { [Tab]: boolean }
+		local current = selectedTab()
+		visited[current] = true
+		local keys: { [Tab]: boolean } = {}
+		for tab in visited do
+			keys[tab] = tab == current
+		end
+		return keys
+	end
+end
+
+local function pages(props: BuildMenuProps, isMenuShowing: () -> boolean)
+	return indexes(visitedTabs(props.Tab), function(isOnShow: () -> boolean, tab: Tab): GuiObject
+		local isPageShowing = derive(function(): boolean
+			return isMenuShowing() and isOnShow()
+		end)
+		local page = showingContext(isPageShowing, function(): GuiObject
+			return tabPage(props, tab)
+		end)
+		effect(function()
+			page.Visible = isOnShow()
+		end)
+		return page
+	end)
+end
+
+--[[
+	The panel stays built after it closes. `Present` turning false slides it out, and it is hidden
+	once fully below the screen.
+]]
 local function buildMenu(props: BuildMenuProps): Frame
+	-- False until the panel is built, so the first open slides in like every later one.
+	local isBuilt = source(false)
+
 	-- 0 is in place; 1 is fully below the screen.
 	local slide = spring(function(): number
-		return if props.Present() then 0 else 1
+		return if isBuilt() and props.Present() then 0 else 1
 	end, SLIDE_SECONDS)
+	-- The spring settles on exactly 1, so this turns false only once the slide-out ends.
+	local isMenuShowing = derive(function(): boolean
+		return (isBuilt() and props.Present()) or slide() < 1
+	end)
 
 	local tabs = {}
 	for index, tab in TABS do
 		tabs[index] = tabButton(props, tab, index)
 	end
 
-	return create("Frame")({
+	local menu = create("Frame")({
 		Name = "BuildMenu",
 		AnchorPoint = Vector2.new(0.5, 0.5),
 		Position = function()
 			return UDim2.new(0.5, 0, 0.5 + slide(), slide() * PANEL_SIZE.Y)
 		end,
 		Size = UDim2.fromOffset(PANEL_SIZE.X, PANEL_SIZE.Y),
+		Visible = isMenuShowing,
 		BackgroundColor3 = PANEL_COLOR,
 		BackgroundTransparency = 0.1,
 
@@ -335,15 +423,11 @@ local function buildMenu(props: BuildMenuProps): Frame
 			Size = UDim2.new(1, 0, 1, -(TAB_HEIGHT + PANEL_PADDING)),
