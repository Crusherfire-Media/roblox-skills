+local function pageFor(props: BuildMenuProps, tab: Tab): GuiObject
+	if tab == "Colors" then
+		return colorsPage(props)
+	elseif tab == "Shapes" then
+		return shapesPage()
+	else
+		return blocksPage()
+	end
+end
+
+local function keptPage(props: BuildMenuProps, tab: Tab, isOnShow: () -> boolean): GuiObject
+	local page = showingScope(isOnShow, function(): GuiObject
+		return pageFor(props, tab)
+	end)
+
+	effect(function()
+		page.Visible = isOnShow()
+	end)
+
+	-- A rebuilt page opened scrolled to the top, so a kept one goes back there each time it opens.
+	if page:IsA("ScrollingFrame") then
+		effect(function()
+			if props.Present() and isOnShow() then
+				page.CanvasPosition = Vector2.zero
+			end
+		end)
+	end
+
+	return page
+end
+
+local function pages(props: BuildMenuProps)
+	-- Every tab visited so far, each mapped to whether it is the one on show. Keys never leave,
+	-- so indexes never destroys a page.
+	local visited: { [Tab]: boolean } = {}
+	local function pageKeys(): { [Tab]: boolean }
+		local current = props.Tab()
+		visited[current] = true
+		local keys: { [Tab]: boolean } = {}
+		for tab in visited do
+			keys[tab] = tab == current
+		end
+		return keys
+	end
+
+	return indexes(pageKeys, function(isOnShow: () -> boolean, tab: Tab): GuiObject
+		return keptPage(props, tab, isOnShow)
+	end)
+end
