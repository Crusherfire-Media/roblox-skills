+-- Keeps <connect>'s connection only while the UI it is built in is on screen.
+local function whileShowing(connect: () -> RBXScriptConnection)
+	local isShowing = showingContext()
+	effect(function()
+		if not isShowing() then
+			return
+		end
+		cleanup(connect())
+	end)
+end
+
+-- Builds UI with <build>, on screen only while <isOn> and the UI around it are.
+local function showingScope<T>(isOn: () -> boolean, build: () -> T): T
+	local isOuterShowing = showingContext()
+	local isScopeShowing = derive(function(): boolean
+		return isOuterShowing() and isOn()
+	end)
+	return showingContext(isScopeShowing, build)
+end
