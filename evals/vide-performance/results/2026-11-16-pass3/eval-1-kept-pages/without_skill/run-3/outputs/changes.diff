+--[[
+	Builds a tab's page the first time that tab is shown in an open menu, then keeps it alive and
+	only toggles its Visible. Rebuilding a page costs hundreds of instances (and a long frame), so
+	after the first visit switching tabs only flips a property.
+]]
+local function keptPage(
+	props: BuildMenuProps,
+	tab: Tab,
+	panelShown: () -> boolean,
+	build: (isPageShown: () -> boolean, isOnScreen: () -> boolean) -> GuiObject
+)
+	local function isPageShown(): boolean
+		return props.Tab() == tab
+	end
+	local function isOnScreen(): boolean
+		return panelShown() and isPageShown()
+	end
+
+	local built = source(false)
+	local hasBuilt = false
+	effect(function()
+		if not hasBuilt and props.Present() and isPageShown() then
+			hasBuilt = true
+			built(true)
+		end
+	end)
+
+	return show(built, function()
+		return build(isPageShown, isOnScreen)
+	end)
+end
+
 local function buildMenu(props: BuildMenuProps): Frame
 	-- 0 is in place; 1 is fully below the screen.
 	local slide = spring(function(): number
 		return if props.Present() then 0 else 1
 	end, SLIDE_SECONDS)
 
+	-- The panel stays mounted while closed; hide it once it has finished sliding out.
+	local function panelShown(): boolean
+		return props.Present() or slide() < 1
+	end
+
 	local tabs = {}
 	for index, tab in TABS do
 		tabs[index] = tabButton(props, tab, index)
@@ -301,6 +350,7 @@ local function buildMenu(props: BuildMenuProps): Frame
 
 	return create("Frame")({
 		Name = "BuildMenu",
+		Visible = panelShown,
 		AnchorPoint = Vector2.new(0.5, 0.5),
 		Position = function()
 			return UDim2.new(0.5, 0, 0.5 + slide(), slide() * PANEL_SIZE.Y)
@@ -335,13 +385,15 @@ local function buildMenu(props: BuildMenuProps): Frame
 			Size = UDim2.new(1, 0, 1, -(TAB_HEIGHT + PANEL_PADDING)),
 			BackgroundTransparency = 1,
 
-			switch(props.Tab)({
-				Blocks = blocksPage,
-				Colors = function()
-					return colorsPage(props)
-				end,
-				Shapes = shapesPage,
-			}),
+			keptPage(props, "Blocks", panelShown, function(isPageShown)
+				return blocksPage(isPageShown)
+			end),
+			keptPage(props, "Colors", panelShown, function(isPageShown, isOnScreen)
+				return colorsPage(props, isPageShown, isOnScreen)
+			end),
+			keptPage(props, "Shapes", panelShown, function(isPageShown)
+				return shapesPage(isPageShown)
+			end),
 		}),
 	})
 end
