+--[[
+	Builds a page the first time `shown` is true, then keeps it: afterwards being shown or hidden
+	only sets Visible. Each time it is shown again it scrolls back to the top, as a new page would.
+]]
+local function keptPage(shown: () -> boolean, build: () -> GuiObject): () -> GuiObject?
+	local visited = source(false)
+	effect(function()
+		if shown() then
+			visited(true)
+		end
+	end)
+
+	return show(visited, function()
+		local page = build()
+		effect(function()
+			local isShown = shown()
+			page.Visible = isShown
+			if isShown and page:IsA("ScrollingFrame") then
+				page.CanvasPosition = Vector2.zero
+			end
+		end)
+		return page
+	end)
+end
+
 local function buildMenu(props: BuildMenuProps): Frame
 	-- 0 is in place; 1 is fully below the screen.
 	local slide = spring(function(): number
 		return if props.Present() then 0 else 1
 	end, SLIDE_SECONDS)
 
+	-- The menu is kept after it closes, so hide it once it has fully slid out.
+	local panelVisible = derive(function()
+		return props.Present() or slide() ~= 1
+	end)
+
 	local tabs = {}
+	local pages = {}
+	local builders: { [Tab]: (shown: () -> boolean) -> GuiObject } = {
+		Blocks = blocksPage,
+		Colors = function(shown)
+			return colorsPage(props, shown)
+		end,
+		Shapes = shapesPage,
+	}
 	for index, tab in TABS do
 		tabs[index] = tabButton(props, tab, index)
+
+		local shown = derive(function()
+			return props.Tab() == tab and panelVisible()
+		end)
+		pages[index] = keptPage(shown, function()
+			return builders[tab](shown)
+		end)
 	end
 
 	return create("Frame")({
 		Name = "BuildMenu",
+		Visible = panelVisible,
 		AnchorPoint = Vector2.new(0.5, 0.5),
 		Position = function()
 			return UDim2.new(0.5, 0, 0.5 + slide(), slide() * PANEL_SIZE.Y)
@@ -335,13 +399,7 @@ local function buildMenu(props: BuildMenuProps): Frame
 			Size = UDim2.new(1, 0, 1, -(TAB_HEIGHT + PANEL_PADDING)),
 			BackgroundTransparency = 1,
 
-			switch(props.Tab)({
-				Blocks = blocksPage,
-				Colors = function()
-					return colorsPage(props)
-				end,
-				Shapes = shapesPage,
-			}),
+			pages,
 		}),
 	})
 end
