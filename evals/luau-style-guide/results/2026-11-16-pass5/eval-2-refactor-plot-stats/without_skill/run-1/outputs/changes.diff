+local roblox = require("@lune/roblox")
+local Vector3 = roblox.Vector3
+
+local Old = require("./Old")
+local New = require("../src/ReplicatedStorage/Shared/PlotStats")
+
+local function ser(v: any, seen: { [any]: boolean }?): string
+	seen = seen or {}
+	local t = typeof(v)
+	if t == "table" then
+		if (seen :: any)[v] then
+			return "<cycle>"
+		end
+		(seen :: any)[v] = true
+		local keys = {}
+		for k in v do
+			table.insert(keys, k)
+		end
+		table.sort(keys, function(a, b)
+			return tostring(a) < tostring(b)
+		end)
+		local parts = {}
+		for _, k in keys do
+			table.insert(parts, tostring(k) .. "=" .. ser(v[k], seen))
+		end
+		return "{" .. table.concat(parts, ",") .. "}"
+	elseif t == "number" then
+		if v ~= v then
+			return "nan"
+		end
+		if v == 0 and 1 / v < 0 then
+			return "-0"
+		end
+		return string.format("%.17g", v)
+	elseif t == "string" then
+		return string.format("%q", v)
+	end
+	return t .. ":" .. tostring(v)
+end
+
+local function run(f, ...)
+	local r = table.pack(pcall(f, ...))
+	return r
+end
+
+local checked, skipped, failures = 0, 0, 0
+local function check(label: string, oldF, newF, ...)
+	local o = run(oldF, ...)
+	if not o[1] then
+		skipped += 1
+		return
+	end
+	local n = run(newF, ...)
+	checked += 1
+	-- compare n (count of values) and serialized values; identity for tables
+	local same = n[1] and o.n == n.n
+	if same then
+		for i = 2, o.n do
+			if ser(o[i]) ~= ser(n[i]) then
+				same = false
+			end
+			if typeof(o[i]) == "table" and select(2, ...) == nil and false then
+				same = false
+			end
+		end
+	end
+	if not same then
+		failures += 1
+		if failures <= 20 then
+			print("MISMATCH", label)
+			print("  old:", o.n, ser({ table.unpack(o, 2, o.n) }))
+			print("  new:", n.n, ser({ table.unpack(n, 2, n.n) }))
+		end
+	end
+end
+
+local types = { "Brick", "Dirt", "Grass", "Window", "Wood", "Stone", "", 1, 2, 5, 6, 0, 1.5, true, nil }
+local ys = { 0, -2, -2.5, -10, 1, 3.7, 10.25, 99.95, 100, 1e6, -0.0, 0 / 0, math.huge, -math.huge, 0.05, 0.15 }
+
+local rng = Random.new(12345)
+local function randomBlock(): any
+	local r = rng:NextInteger(1, 40)
+	if r == 1 then
+		return "notablock"
+	end
+	local b: any = { Type = types[rng:NextInteger(1, #types)] }
+	if rng:NextInteger(1, 8) ~= 1 then
+		local y = ys[rng:NextInteger(1, #ys)]
+		if rng:NextInteger(1, 2) == 1 then
+			y = rng:NextNumber(-20, 500)
+		end
+		if rng:NextInteger(1, 3) == 1 then
+			b.Position = Vector3.new(1, y, 2)
+		else
+			b.Position = { X = 0, Y = y, Z = 0 }
+		end
+	end
+	return b
+end
+
+local function validBlock(): any
+	local names = { "Brick", "Dirt", "Grass", "Window", "Wood" }
+	return { Type = names[rng:NextInteger(1, 5)], Position = { Y = rng:NextNumber(-5, 300) } }
+end
+
+local lists = { {}, { {} }, { { Type = "Brick" } } }
+for _ = 1, 3000 do
+	local list = {}
+	local count = rng:NextInteger(0, if rng:NextInteger(1, 4) == 1 then 120 else 12)
+	local gen = if rng:NextInteger(1, 2) == 1 then validBlock else randomBlock
+	for i = 1, count do
+		list[i] = gen()
+	end
+	table.insert(lists, list)
+end
+-- exactly 50 / 51 blocks (discount boundary), all five types
+for _, n in { 49, 50, 51, 52, 200, 1000, 2000 } do
+	local list = {}
+	local names = { "Brick", "Dirt", "Grass", "Window", "Wood" }
+	for i = 1, n do
+		list[i] = { Type = names[(i % 5) + 1], Position = { Y = i * 0.37 } }
+	end
+	table.insert(lists, list)
+end
+
+for i, list in lists do
+	check("summarize#" .. i, Old.summarize, New.summarize, list)
+	check("getTallest#" .. i, Old.getTallest, New.getTallest, list)
+	-- getTallest must return the same block object (identity)
+	local okO, o = pcall(Old.getTallest, list)
+	local okN, n = pcall(New.getTallest, list)
+	if okO and (not okN or o ~= n) then
+		failures += 1
+		print("IDENTITY MISMATCH getTallest#" .. i)
+	end
+	local okS, sum = pcall(Old.summarize, list)
+	if okS then
+		check("format#" .. i, Old.format, New.format, sum)
+		check("formatShort#" .. i, Old.format, New.format, sum, true)
+		check("formatTruthy#" .. i, Old.format, New.format, sum, 1)
+		check("formatFalse#" .. i, Old.format, New.format, sum, false)
+	end
+end
+
+-- Direct format edge cases on hand-built summaries
+local nums = {
+	0, 1, -1, 2, 999, 1000, -1000, 1234.56, -1234.56, 999999, 1000000, 1234567, -1234567,
+	1e15, 1e16, 1e20, -0.0, 0.5, -0.5, 0.04, 0.05, 0.95, 1.05, 12345.678, 2 ^ 53, 0 / 0,
+	math.huge, -math.huge,
+}
+for _, total in nums do
+	for _, variety in { 0, 1, 2, 5, 1.5, -1 } do
+		for _, height in nums do
+			for _, score in { 0, 1, 1234, -98765, 1e7, 3.9, math.huge, 0 / 0 } do
+				local s = { Total = total, Variety = variety, Height = height, Score = score }
+				check("fmt", Old.format, New.format, s)
+				check("fmtShort", Old.format, New.format, s, true)
+			end
+		end
+	end
+end
+
+-- compare
+local cmpVals = { 0, 1, -1, 5, 0 / 0, math.huge }
+for _, as in cmpVals do
+	for _, at in cmpVals do
+		for _, bs in cmpVals do
+			for _, bt in cmpVals do
+				check(
+					"compare",
+					Old.compare,
+					New.compare,
+					{ Score = as, Total = at },
+					{ Score = bs, Total = bt }
+				)
+			end
+		end
+	end
+end
+
+-- non-table inputs
+for _, bad in { 5, "x", true } do
+	check("summarize-bad", Old.summarize, New.summarize, bad)
+end
+local okO, errO = pcall(Old.summarize, nil)
+local okN, errN = pcall(New.summarize, nil)
+print("summarize(nil) old:", okO, errO)
+print("summarize(nil) new:", okN, errN)
+
+print(string.format("checked=%d skipped(old errored)=%d failures=%d", checked, skipped, failures))
