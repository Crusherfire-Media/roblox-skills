+-- Whether a block should be counted: it has a position and a known type.
+-- The `Block` type says both fields are always set, but callers can pass
+-- half-built blocks, so check at runtime anyway.
+local function isCountable(block: Block): boolean
+	local position: Vector3? = block.Position
+	return position ~= nil and isKnownBlockType(block.Type)
+end
+
+-- Inserts thousands separators into the leading integer part of `text`,
+-- leaving anything after it (a fraction or exponent) untouched.
+-- "-1234567" -> "-1,234,567", "1e+20" -> "1e+20"
+local function addThousandsSeparators(text: string): string
+	local integerPart, rest = string.match(text, "^(%-?%d+)(.*)$")
+	assert(integerPart and rest, `cannot add separators to "{text}"`)
+
+	local grouped = integerPart
+	repeat
+		local replaced, replacements = string.gsub(grouped, "^(%-?%d+)(%d%d%d)", "%1,%2")
+		grouped = replaced
+	until replacements == 0
+
+	return grouped .. rest
+end
+
+-- Rounds down and adds thousands separators: 1234.9 -> "1,234".
+local function formatWholeNumber(n: number): string
+	return addThousandsSeparators(tostring(math.floor(n)))
+end
+
+-- One decimal place, no separators: 12 -> "12.0".
+local function formatOneDecimal(n: number): string
+	return string.format("%.1f", n)
+end
+
+local function pluralize(count: number, singular: string, plural: string): string
+	return if count == 1 then singular else plural
+end
