+-- The highest countable block (by center Y). On a tie, the earliest one wins.
+-- Returns nothing if there are no countable blocks.
+function PlotStats.getTallest(blocks: { Block }): Block?
+	local tallest: Block? = nil
+	for _, block in ipairs(blocks) do
+		if isCountable(block) and (tallest == nil or block.Position.Y > tallest.Position.Y) then
+			tallest = block
 		end
 	end
