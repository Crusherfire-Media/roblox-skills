+
+--[[
+	Whether `blockType` names a known block type.
+
+	Legacy quirk, kept on purpose: block types used to live in one table that
+	held both the ordered names (at indices 1..N) and the costs (keyed by name),
+	so a numeric `Type` from 1 to N also counted as "known". `getTallest` still
+	honors that. (`summarize` errors on such blocks, as it always has, because
+	they have no cost.)
+]]
+local function isKnownBlockType(blockType: unknown): boolean
+	if typeof(blockType) == "string" then
+		return COST_BY_TYPE[blockType] ~= nil
+	elseif typeof(blockType) == "number" then
+		return BLOCK_TYPES[blockType] ~= nil
