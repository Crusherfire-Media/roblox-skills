+-- Text for the plot sign.
+-- Full:  "1,234 blocks, 3 types, 12.0 studs tall, score 12,463"
+-- Short: "1,234 blocks"
+function PlotStats.format(summary: Summary, short: boolean?): string
+	local blockCount = formatWholeNumber(summary.Total)
+		.. " "
+		.. pluralize(summary.Total, "block", "blocks")
+	if short then
+		return blockCount
 	end
+
+	return blockCount
+		.. ", "
+		.. summary.Variety
+		.. " "
+		.. pluralize(summary.Variety, "type", "types")
+		.. ", "
+		.. formatOneDecimal(summary.Height)
+		.. " studs tall, score "
+		.. formatWholeNumber(summary.Score)
 end
 
