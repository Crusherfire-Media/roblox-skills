+--[[
+	Describes a summary for display. The short form gives only the block count,
+	as "1,234 blocks".
+]]
+function Module.format(summary: Summary, short: boolean?): string
+	local blockWord = if summary.Total == 1 then "block" else "blocks"
+	local blockText = `{formatWholeNumber(summary.Total)} {blockWord}`
+	if short then
+		return blockText
 	end
+
+	local typeWord = if summary.Variety == 1 then "type" else "types"
+	local heightText = string.format("%.1f", summary.Height)
+	local scoreText = formatWholeNumber(summary.Score)
+	return `{blockText}, {summary.Variety} {typeWord}, {heightText} studs tall, score {scoreText}`
 end
 
