+-- Whole numbers on the sign and leaderboard use thousands separators: 1,234,567
+local function formatWholeNumber(value: number): string
+	local digits = tostring(math.floor(value))
+	local integerPart, rest = string.match(digits, "^(%-?%d+)(.*)$")
+	if integerPart == nil or rest == nil then
+		error(`Cannot add thousands separators to {digits}`)
+	end
+
+	local separated = integerPart
+	local replacements = 0
+	repeat
+		separated, replacements = string.gsub(separated, "^(%-?%d+)(%d%d%d)", "%1,%2")
+	until replacements == 0
+	return separated .. rest
 end
 
