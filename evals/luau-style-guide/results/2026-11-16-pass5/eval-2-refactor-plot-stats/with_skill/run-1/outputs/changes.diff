+--[[
+	Returns the block whose center is highest, the first one on a tie, or no
+	values at all (not nil) when no block has a Position and a known Type.
+]]
+function Module.getTallest(blocks: { PlotBlock }): PlotBlock?
+	local tallest: PlotBlock? = nil
+	local tallestY = 0
+	-- ipairs, so blocks after a nil hole in the list are ignored
+	for _, block in ipairs(blocks) do
+		local position = block.Position
+		if position == nil or not isTallestCandidateType(block.Type) then
+			continue
+		end
+		if tallest == nil or position.Y > tallestY then
