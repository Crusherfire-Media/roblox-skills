+--[[
+	Returns the block with the highest center, the first one on a tie, or no
+	value at all when no block counts.
+]]
+function Module.getTallest(blocks: { Block }): Block?
+	local tallest: Block? = nil
+	local tallestY = 0
+	for _, block in ipairs(blocks) do
+		local position = block.Position
+		if position == nil or not isTallestCandidateType(block.Type) then
+			continue
+		end
+
+		if tallest == nil or position.Y > tallestY then
+			tallest = block
