+--[[
+	Formats a summary for display, such as
+	"1,204 blocks, 5 types, 38.0 studs tall, score 12,651". With `short`, only
+	the block count is shown: "1,204 blocks".
+]]
+function Module.format(summary: Summary, short: boolean?): string
+	local blockWord = if summary.Total == 1 then "block" else "blocks"
+	local totalText = formatWholeNumber(summary.Total) .. " " .. blockWord
+	if short then
+		return totalText
