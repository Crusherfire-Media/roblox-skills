+--------------------------------------------------------------------------------
+-- Number formatting
+--------------------------------------------------------------------------------
+
+-- Inserts commas into the leading integer part of a numeric string:
+-- "1234567" -> "1,234,567", "-1234.5" -> "-1,234.5".
+-- Strings with no leading integer (e.g. "inf", "nan") are returned unchanged.
+local function addThousandsSeparators(text: string): string
+	local integerPart, rest = string.match(text, "^(%-?%d+)(.*)$")
+	if integerPart == nil or rest == nil then
+		return text
 	end
