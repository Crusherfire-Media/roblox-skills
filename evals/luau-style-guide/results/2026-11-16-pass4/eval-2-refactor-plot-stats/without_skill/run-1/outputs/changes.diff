+
+	-- Each pass inserts one comma, working from the right.
+	local separated = integerPart
+	repeat
+		local updated, replacements = string.gsub(separated, "^(%-?%d+)(%d%d%d)", "%1,%2")
+		separated = updated
+	until replacements == 0
+
+	return separated .. rest
+end
+
+-- Rounds down to a whole number and adds thousands separators: 1234.9 -> "1,234".
+local function formatWholeNumber(value: number): string
+	return addThousandsSeparators(tostring(math.floor(value)))
+end
+
+-- One decimal place, no separators: 12 -> "12.0".
+local function formatOneDecimal(value: number): string
+	return string.format("%.1f", value)
+end
+
+local function pluralize(count: number, singular: string, plural: string): string
+	return if count == 1 then singular else plural
