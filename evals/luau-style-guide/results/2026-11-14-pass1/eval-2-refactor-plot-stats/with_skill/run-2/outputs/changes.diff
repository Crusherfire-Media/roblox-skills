+--[[
+	Returns the block with the highest Position.Y, the first one on a tie.
+	When no block qualifies it returns no values rather than nil, which
+	callers can observe through select("#", ...), so keep the bare return.
+]]
+function Module.getTallest(blocks: { Block }): Block?
+	local tallest: Block? = nil
+	local tallestY = 0
