+--[[
+	Describes the summary for the plot sign, such as
+	"1,204 blocks, 5 types, 38.0 studs tall, score 12,341". The short form is
+	only the block count, "1,204 blocks".
+]]
+function Module.format(summary: Summary, short: boolean?): string
+	local blockWord = if summary.Total == 1 then "block" else "blocks"
+	local blockText = `{formatWholeNumber(summary.Total)} {blockWord}`
+	if short then
+		return blockText
 	end
+
+	local typeWord = if summary.Variety == 1 then "type" else "types"
+	local typeText = `{summary.Variety} {typeWord}`
+	local heightText = `{string.format("%.1f", summary.Height)} studs tall`
+	local scoreText = `score {formatWholeNumber(summary.Score)}`
+	return `{blockText}, {typeText}, {heightText}, {scoreText}`
 end
 
