+local function addThousandsSeparators(numberText: string): string
+	local integerPart, rest = string.match(numberText, "^(%-?%d+)(.*)$")
+	-- "nan" and "inf" have no digits to group
+	if integerPart == nil or rest == nil then
+		return numberText
+	end
+
+	-- Each pass inserts only the rightmost missing comma
+	local grouped = integerPart
+	while true do
+		local replaced, replacementCount = string.gsub(grouped, "^(%-?%d+)(%d%d%d)", "%1,%2")
+		grouped = replaced
+		if replacementCount == 0 then
+			break
 		end
 	end
