+--[[
+	Returns the block with the highest center, keeping the first one on a tie.
+	Returns no values at all, not nil, when no block qualifies.
+]]
+function Module.getTallest(blocks: { Block }): Block?
+	local tallest: Block? = nil
+	local tallestY = 0
+	for _, block in ipairs(blocks) do
+		local position = block.Position
+		if position == nil or not isKnownType(block.Type) then
+			continue
+		end
+		if tallest == nil or position.Y > tallestY then
+			tallest = block
+			tallestY = position.Y
 		end
 	end
