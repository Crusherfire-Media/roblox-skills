+--------------------------------------------------------------------------------
+-- Number formatting
+--------------------------------------------------------------------------------
+
+-- Inserts commas between groups of three digits: "1234567" -> "1,234,567".
+-- Anything after the leading integer digits (a decimal part, an exponent) is
+-- left untouched.
+local function addThousandsSeparators(text: string): string
+	local integerPart, rest = string.match(text, "^(%-?%d+)(.*)$")
+	assert(integerPart ~= nil and rest ~= nil, `cannot add thousands separators to "{text}"`)
+
+	local grouped: string = integerPart
+	repeat
+		local replacements: number
+		grouped, replacements = string.gsub(grouped, "^(%-?%d+)(%d%d%d)", "%1,%2")
+	until replacements == 0
+
+	return grouped .. rest
+end
+
+-- Rounds down and adds thousands separators: 12345.9 -> "12,345".
+local function formatWholeNumber(n: number): string
+	return addThousandsSeparators(tostring(math.floor(n)))
+end
+
+-- One decimal place, no separators: 12.345 -> "12.3".
+local function formatOneDecimal(n: number): string
+	return string.format("%.1f", n)
+end
+
+local function pluralize(count: number, singular: string, plural: string): string
+	return if count == 1 then singular else plural
+end
