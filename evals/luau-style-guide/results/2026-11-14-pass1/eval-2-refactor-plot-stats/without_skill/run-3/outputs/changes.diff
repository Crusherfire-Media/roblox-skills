+export type Summary = {
+	-- Number of blocks of each type. Types with no blocks are absent.
+	Counts: { [string]: number },
+	-- Number of counted blocks.
+	Total: number,
+	-- Total build cost, after the bulk discount.
+	Cost: number,
+	-- Height of the top of the highest block, in studs (never below 0).
+	Height: number,
+	Score: number,
+	-- Number of distinct block types used.
+	Variety: number,
+}
+
+type BlockTypeInfo = {
+	Name: string,
+	Cost: number,
+}
+
+--------------------------------------------------------------------------------
+-- Configuration
+--------------------------------------------------------------------------------
+
+local BLOCK_TYPES: { BlockTypeInfo } = {
+	{ Name = "Brick", Cost = 5 },
+	{ Name = "Dirt", Cost = 2 },
+	{ Name = "Grass", Cost = 3 },
+	{ Name = "Window", Cost = 8 },
+	{ Name = "Wood", Cost = 4 },
+}
+
+-- Every block is assumed to be this tall, so its top is center Y + half this.
+local BLOCK_HEIGHT = 4
+
+-- Plots with more than this many blocks get the bulk discount on cost.
+local BULK_DISCOUNT_MIN_BLOCKS = 50
+local BULK_DISCOUNT_MULTIPLIER = 0.9
+
+local SCORE_PER_BLOCK = 10
+local SCORE_PER_STUD_OF_HEIGHT = 2
+local SCORE_PER_BLOCK_TYPE = 25
+-- Bonus for using every block type at least once.
+local SCORE_ALL_TYPES_BONUS = 100
+
+--------------------------------------------------------------------------------
+-- Derived lookups
+--------------------------------------------------------------------------------
+
+local COST_BY_TYPE: { [string]: number } = {}
+for _, info in BLOCK_TYPES do
+	COST_BY_TYPE[info.Name] = info.Cost
+end
+
+-- getTallest has always accepted a block whose Type is a position in the
+-- type list (1, 2, ...) as well as a type name, because the original code
+-- kept names and costs in one mixed table. Callers depend on getTallest's
+-- exact output, so that quirk is kept here and only here.
+local function isTallestCandidateType(blockType: any): boolean
+	return COST_BY_TYPE[blockType] ~= nil or (BLOCK_TYPES :: { any })[blockType] ~= nil
 end
 
