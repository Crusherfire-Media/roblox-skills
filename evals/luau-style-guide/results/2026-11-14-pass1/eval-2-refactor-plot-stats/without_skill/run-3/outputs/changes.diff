+-- Returns the block with the highest center. Ties go to the earliest block.
+-- Returns no value at all (not even nil) when no block qualifies.
+function PlotStats.getTallest(blocks: { Block }): Block?
+	local tallest: Block? = nil
+	local tallestY = 0
+
+	for _, block in ipairs(blocks) do
+		local position = block.Position
+		if position == nil or not isTallestCandidateType(block.Type) then
+			continue
+		end
+
+		if tallest == nil or position.Y > tallestY then
+			tallest = block
+			tallestY = position.Y
 		end
 	end
-	if best == nil then
+
+	if tallest == nil then
 		return
 	end
-	return best
+	return tallest
