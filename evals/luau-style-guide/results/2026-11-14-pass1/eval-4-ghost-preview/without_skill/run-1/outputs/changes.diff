+++ b/src/StarterPlayer/StarterPlayerScripts/GhostPreview.luau
@@ -0,0 +1,207 @@
+--!strict
+--[[
+	A see-through copy of a block that follows the mouse, snapped to the grid, so the player can
+	see where a click would place a block. It turns red where PlacementRules.check rejects the
+	cell and hides when the mouse points at the sky.
+
+	Usage:
+		local ghost = GhostPreview.new("Brick")
+		ghost:setBlockType("Wood")
+		local canPlace, position = ghost:getPlacement()
+		ghost:destroy()
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local RunService = game:GetService("RunService")
+local UserInputService = game:GetService("UserInputService")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local PlacementRules = require(ReplicatedStorage.Shared.PlacementRules)
+
+type BlockType = BlockTypes.BlockType
+
+export type Options = {
+	-- Transparency of the ghost, from 0 (opaque) to 1 (invisible). Defaults to 0.6.
+	Transparency: number?,
+	-- How far the mouse ray reaches, in studs. Defaults to 500.
+	RaycastDistance: number?,
+}
+
+local DEFAULT_TRANSPARENCY = 0.6
+local DEFAULT_RAYCAST_DISTANCE = 500
+local BLOCKED_COLOR = Color3.fromRGB(255, 60, 60)
+-- Shrinks the ghost a little so its faces don't z-fight with the blocks it touches.
+local SIZE_INSET = 0.05
+local PLACED_BLOCKS_FOLDER_NAME = "PlacedBlocks"
+
+local localPlayer = Players.LocalPlayer
+
+-- Each ghost binds its own render step, and those names must be unique.
+local nextBindingId = 0
+
+local GhostPreview = {}
+GhostPreview.__index = GhostPreview
+
+type Fields = {
+	_part: Part,
+	_blockType: BlockType,
+	_transparency: number,
+	_raycastDistance: number,
+	_raycastParams: RaycastParams,
+	_bindingName: string,
+	_visible: boolean,
+	_canPlace: boolean,
+	_reason: string?,
+	_position: Vector3?,
+	_destroyed: boolean,
+}
+
+export type GhostPreview = typeof(setmetatable({} :: Fields, GhostPreview))
+
+function GhostPreview.new(blockType: BlockType, options: Options?): GhostPreview
+	assert(BlockTypes.isBlockType(blockType), `unknown block type {blockType}`)
+
+	local transparency = if options and options.Transparency
+		then options.Transparency
+		else DEFAULT_TRANSPARENCY
+	local raycastDistance = if options and options.RaycastDistance
+		then options.RaycastDistance
+		else DEFAULT_RAYCAST_DISTANCE
+	assert(transparency >= 0 and transparency <= 1, "Transparency must be between 0 and 1")
+	assert(raycastDistance > 0, "RaycastDistance must be positive")
+
+	local part = Instance.new("Part")
+	part.Name = "GhostPreview"
+	part.Size = Vector3.one * (BlockTypes.BlockSize - SIZE_INSET)
+	part.Anchored = true
+	part.CanCollide = false
+	part.CanQuery = false
+	part.CanTouch = false
+	part.CastShadow = false
+	part.Transparency = 1 -- Hidden until the first frame finds a spot.
+
+	local raycastParams = RaycastParams.new()
+	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
+
+	nextBindingId += 1
+
+	local self = setmetatable(
+		{
+			_part = part,
+			_blockType = blockType,
+			_transparency = transparency,
+			_raycastDistance = raycastDistance,
+			_raycastParams = raycastParams,
+			_bindingName = `GhostPreview{nextBindingId}`,
+			_visible = false,
+			_canPlace = false,
+			_reason = nil,
+			_position = nil,
+			_destroyed = false,
+		} :: Fields,
+		GhostPreview
+	)
+
+	self:_applyStyle()
+	part.Parent = workspace
+
+	-- Run right after the camera moves so the ghost never lags a frame behind it.
+	RunService:BindToRenderStep(self._bindingName, Enum.RenderPriority.Camera.Value + 1, function()
+		self:_update()
+	end)
+
+	return self
+end
+
+-- Switches the ghost to another block type.
+function GhostPreview.setBlockType(self: GhostPreview, blockType: BlockType)
+	assert(not self._destroyed, "GhostPreview was destroyed")
+	assert(BlockTypes.isBlockType(blockType), `unknown block type {blockType}`)
+
+	self._blockType = blockType
+	self:_applyStyle()
+end
+
+--[[
+	Returns whether a block can go where the ghost is, and the center of that cell. The position
+	is nil when the mouse points at nothing. When the block can't go there, the third value is
+	PlacementRules.check's reason (or "NoBlocksFolder" before the server's folder exists).
+]]
+function GhostPreview.getPlacement(self: GhostPreview): (boolean, Vector3?, string?)
+	if self._destroyed or not self._visible then
+		return false, nil, nil
+	end
+	return self._canPlace, self._position, self._reason
+end
+
+-- Removes the ghost. Safe to call more than once.
+function GhostPreview.destroy(self: GhostPreview)
+	if self._destroyed then
+		return
+	end
+	self._destroyed = true
+	RunService:UnbindFromRenderStep(self._bindingName)
+	self._part:Destroy()
+end
+
+function GhostPreview._applyStyle(self: GhostPreview)
+	local style = BlockTypes.Styles[self._blockType]
+	self._part.Material = style.Material
+	self._part.Color = if self._canPlace then style.Color else BLOCKED_COLOR
+end
+
+function GhostPreview._setVisible(self: GhostPreview, visible: boolean)
+	if self._visible == visible then
+		return
+	end
+	self._visible = visible
+	self._part.Transparency = if visible then self._transparency else 1
+end
+
+function GhostPreview._update(self: GhostPreview)
+	local camera = workspace.CurrentCamera
+	if not camera then
+		self:_setVisible(false)
+		return
+	end
+
+	-- The character changes on respawn, so refresh the filter every frame.
+	local character = localPlayer.Character
+	self._raycastParams.FilterDescendantsInstances = if character
+		then { character, self._part }
+		else { self._part }
+
+	local mouseLocation = UserInputService:GetMouseLocation()
+	local ray = camera:ViewportPointToRay(mouseLocation.X, mouseLocation.Y)
+	local result =
+		workspace:Raycast(ray.Origin, ray.Direction * self._raycastDistance, self._raycastParams)
+	if not result then
+		self._position = nil
+		self:_setVisible(false)
+		return
+	end
+
+	-- Step half a block out from the surface so the snap lands in the cell in front of it.
+	local position =
+		PlacementRules.snap(result.Position + result.Normal * (BlockTypes.BlockSize / 2))
+
+	local canPlace, reason
+	local blocksFolder = workspace:FindFirstChild(PLACED_BLOCKS_FOLDER_NAME)
+	if blocksFolder then
+		canPlace, reason = PlacementRules.check(position, character, blocksFolder)
+	else
+		canPlace, reason = false, "NoBlocksFolder"
+	end
+
+	self._position = position
+	self._part.CFrame = CFrame.new(position)
+	if canPlace ~= self._canPlace then
+		self._canPlace = canPlace
+		self:_applyStyle()
+	end
+	self._reason = reason
+	self:_setVisible(true)
+end
+
+return GhostPreview
