+	-- The server only sends changes, so after a pause the previous sample can be
+	-- seconds old. Pin the old state to one batch before this one, or the ghost
+	-- would crawl across the whole pause instead of moving when the player did.
+	if last and time - last.Time > PAUSE_THRESHOLD then
+		table.insert(samples, { Time = time - BATCH_INTERVAL, State = last.State })
+	end
+	table.insert(samples, { Time = time, State = state })
