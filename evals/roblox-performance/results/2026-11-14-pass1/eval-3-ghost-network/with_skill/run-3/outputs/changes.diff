+local function drawRemoteGhost(ghost: RemoteGhost, renderTime: number)
+	local samples = ghost.Samples
+	local part = ghost.Part
+
+	-- Drop samples that are fully in the past, keeping the one being left.
+	while samples[2] and samples[2].Time <= renderTime do
+		table.remove(samples, 1)
+	end
+	local from = samples[1]
+	if not from or from.Time > renderTime or from.State.BlockIndex == 0 then
+		part.Transparency = 1
+		return
+	end
+
+	local position = GhostCodec.toPosition(from.State)
+	local to = samples[2]
+	if to and to.State.BlockIndex ~= 0 then
+		local alpha = (renderTime - from.Time) / (to.Time - from.Time)
+		position = position:Lerp(GhostCodec.toPosition(to.State), alpha)
+	end
+
+	if from.State.BlockIndex ~= ghost.BlockIndex then
+		ghost.BlockIndex = from.State.BlockIndex
+		applyBlockType(part, ghost.BlockIndex)
+	end
+	part.CFrame = CFrame.new(position)
+	part.Transparency = GHOST_TRANSPARENCY
+end
+
+local function onRenderStepped()
+	local state = getCursorState()
+	drawOwnGhost(state)
+	reportOwnGhost(state)
+
+	local renderDelay = (batchLatency or 0) + INTERPOLATION_DELAY
+	local renderTime = Workspace:GetServerTimeNow() - renderDelay
+	for _, ghost in remoteGhosts do
+		if ghost then
+			drawRemoteGhost(ghost, renderTime)
+		end
+	end
+end
+
+local function onCharacterAdded(character: Model)
+	raycastParams.FilterDescendantsInstances = { character }
+end
+
+local function onPlayerRemoving(player: Player)
+	local slot = player:GetAttribute(SLOT_ATTRIBUTE)
+	if typeof(slot) ~= "number" then
+		return
+	end
+	local ghost = remoteGhosts[slot]
+	if ghost then
+		ghost.Part:Destroy()
+		remoteGhosts[slot] = nil
+	end
+end
