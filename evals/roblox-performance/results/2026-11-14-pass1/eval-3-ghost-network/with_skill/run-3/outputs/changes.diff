index 0000000..3966f2d
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/GhostCodec.luau
@@ -0,0 +1,167 @@
+--[[
+	Wire format for ghost previews. Every read and write of the ghost buffers
+	lives here, so client and server cannot disagree about offsets.
+
+	A ghost state is a block type index (0 means hidden) and a grid cell in
+	integer cell coordinates. Cell (0, 0, 0) is the block centered at
+	(BlockSize / 2, BlockSize / 2, BlockSize / 2).
+
+	Client to server, one state (9 bytes):
+		u16 sequence, u8 block index, i16 x, i16 y, i16 z
+	Server to clients, a batch:
+		f64 server time, then per ghost (9 bytes each):
+		u16 slot, u8 block index, i16 x, i16 y, i16 z
+]]
+
+local BlockTypes = require(script.Parent.BlockTypes)
+
+local BLOCK_SIZE = BlockTypes.BlockSize
+local CELL_MIN = -32768
+local CELL_MAX = 32767
+local SEQUENCE_MODULO = 65536
+
+local STATE_SIZE = 7
+local MOVE_SIZE = 2 + STATE_SIZE
+local BATCH_HEADER_SIZE = 8
+local BATCH_ENTRY_SIZE = 2 + STATE_SIZE
+
+export type GhostState = {
+	BlockIndex: number,
+	X: number,
+	Y: number,
+	Z: number,
+}
+
+export type BatchEntry = {
+	Slot: number,
+	State: GhostState,
+}
+
+local GhostCodec = {}
+
+-- Seconds between server batches. Clients interpolate between batches, so a
+-- steady rate matters more than a high one.
+GhostCodec.BatchInterval = 1 / 20
+
+-- Keeps every batch under the 1,000 byte UnreliableRemoteEvent payload limit.
+GhostCodec.MaxEntriesPerBatch = 100
+
+GhostCodec.Hidden = table.freeze({ BlockIndex = 0, X = 0, Y = 0, Z = 0 }) :: GhostState
+
+local function writeState(data: buffer, offset: number, state: GhostState)
+	buffer.writeu8(data, offset, state.BlockIndex)
+	buffer.writei16(data, offset + 1, state.X)
+	buffer.writei16(data, offset + 3, state.Y)
+	buffer.writei16(data, offset + 5, state.Z)
+end
+
+local function readState(data: buffer, offset: number): GhostState?
+	local blockIndex = buffer.readu8(data, offset)
+	if blockIndex == 0 then
+		return GhostCodec.Hidden
+	end
+	if not BlockTypes.List[blockIndex] then
+		return nil
+	end
+	return {
+		BlockIndex = blockIndex,
+		X = buffer.readi16(data, offset + 1),
+		Y = buffer.readi16(data, offset + 3),
+		Z = buffer.readi16(data, offset + 5),
+	}
+end
+
+--[[
+	Returns the state for a block type shown in the cell holding a world
+	position, or the hidden state when the cell is outside the range the wire
+	format can carry.
+]]
+function GhostCodec.fromPosition(blockIndex: number, position: Vector3): GhostState
+	local x = math.floor(position.X / BLOCK_SIZE)
+	local y = math.floor(position.Y / BLOCK_SIZE)
+	local z = math.floor(position.Z / BLOCK_SIZE)
+	for _, value in { x, y, z } do
+		-- NaN fails both comparisons, so it is rejected here too.
+		if not (value >= CELL_MIN and value <= CELL_MAX) then
+			return GhostCodec.Hidden
+		end
+	end
+	return { BlockIndex = blockIndex, X = x, Y = y, Z = z }
+end
+
+function GhostCodec.toPosition(state: GhostState): Vector3
+	local half = BLOCK_SIZE / 2
+	return Vector3.new(
+		state.X * BLOCK_SIZE + half,
+		state.Y * BLOCK_SIZE + half,
+		state.Z * BLOCK_SIZE + half
+	)
+end
+
+function GhostCodec.isSame(a: GhostState, b: GhostState): boolean
+	if a.BlockIndex == 0 or b.BlockIndex == 0 then
+		return a.BlockIndex == b.BlockIndex
+	end
+	return a.BlockIndex == b.BlockIndex and a.X == b.X and a.Y == b.Y and a.Z == b.Z
+end
+
+--[[
+	True when sequence a was sent after sequence b, allowing for the counter
+	wrapping around at 65,536.
+]]
+function GhostCodec.isNewerSequence(a: number, b: number): boolean
+	local difference = (a - b) % SEQUENCE_MODULO
+	return difference ~= 0 and difference < SEQUENCE_MODULO / 2
+end
+
+function GhostCodec.nextSequence(sequence: number): number
+	return (sequence + 1) % SEQUENCE_MODULO
+end
+
+function GhostCodec.encodeMove(sequence: number, state: GhostState): buffer
+	local data = buffer.create(MOVE_SIZE)
+	buffer.writeu16(data, 0, sequence)
+	writeState(data, 2, state)
+	return data
+end
+
+--[[
+	Decodes a move sent by a client. Returns nil for anything malformed, since
+	the data comes from an untrusted client.
+]]
+function GhostCodec.decodeMove(data: unknown): (number?, GhostState?)
+	if typeof(data) ~= "buffer" or buffer.len(data) ~= MOVE_SIZE then
+		return nil, nil
+	end
+	local state = readState(data, 2)
+	if not state then
+		return nil, nil
+	end
+	return buffer.readu16(data, 0), state
+end
+
+function GhostCodec.encodeBatch(serverTime: number, entries: { BatchEntry }): buffer
+	local data = buffer.create(BATCH_HEADER_SIZE + #entries * BATCH_ENTRY_SIZE)
+	buffer.writef64(data, 0, serverTime)
+	for index, entry in entries do
+		local offset = BATCH_HEADER_SIZE + (index - 1) * BATCH_ENTRY_SIZE
+		buffer.writeu16(data, offset, entry.Slot)
+		writeState(data, offset + 2, entry.State)
+	end
+	return data
+end
+
+function GhostCodec.decodeBatch(data: buffer): (number, { BatchEntry })
+	local entries = {}
+	local count = (buffer.len(data) - BATCH_HEADER_SIZE) // BATCH_ENTRY_SIZE
+	for index = 1, count do
+		local offset = BATCH_HEADER_SIZE + (index - 1) * BATCH_ENTRY_SIZE
+		local state = readState(data, offset + 2)
+		if state then
+			table.insert(entries, { Slot = buffer.readu16(data, offset), State = state })
+		end
+	end
+	return buffer.readf64(data, 0), entries
+end
+
+return table.freeze(GhostCodec)
