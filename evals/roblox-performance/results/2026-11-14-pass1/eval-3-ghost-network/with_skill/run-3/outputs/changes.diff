+local function onGhostBatch(data: buffer)
+	local serverTime, entries = GhostCodec.decodeBatch(data)
+
+	local latency = Workspace:GetServerTimeNow() - serverTime
+	if batchLatency then
+		batchLatency += (latency - batchLatency) * LATENCY_SMOOTHING
+	else
+		batchLatency = latency
+	end
+
+	-- A batch can arrive after its player left, so only slots a current player
+	-- holds get a ghost; anything else would never be cleaned up.
+	local otherSlots: { [number]: boolean? } = {}
+	for _, player in Players:GetPlayers() do
+		local slot = player:GetAttribute(SLOT_ATTRIBUTE)
+		if player ~= localPlayer and typeof(slot) == "number" then
+			otherSlots[slot] = true
+		end
+	end
+
+	for _, entry in entries do
+		if otherSlots[entry.Slot] then
+			addSample(getRemoteGhost(entry.Slot), serverTime, entry.State)
+		end
+	end
+end
