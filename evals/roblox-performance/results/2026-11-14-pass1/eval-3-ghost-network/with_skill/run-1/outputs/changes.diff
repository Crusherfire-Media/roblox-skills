+++ b/src/ReplicatedStorage/Shared/GhostCodec.luau
@@ -0,0 +1,213 @@
+--!strict
+--[[
+	Packs ghost preview states into buffers for the GhostReport and GhostBatch remotes. A state is
+	the block type a builder has selected (none while their ghost is hidden) and the grid cell
+	under their cursor. On the wire the cell is three 16-bit grid indices and the block type is
+	its position in BlockTypes.List, so a state takes 7 bytes.
+]]
+
+const BlockTypes = require("./BlockTypes")
+
+const BLOCK_SIZE = BlockTypes.BlockSize
+const MIN_CELL_INDEX = -32768
+const MAX_CELL_INDEX = 32767
+-- A u8 block type index (0 while hidden), then three i16 cell indices.
+const STATE_SIZE = 7
+-- A u16 report sequence, then one state.
+const REPORT_SIZE = 2 + STATE_SIZE
+const REPORT_SEQUENCE_MODULUS = 65536
+-- A u32 batch sequence, then entries of an f64 UserId and one state.
+const BATCH_HEADER_SIZE = 4
+const BATCH_ENTRY_SIZE = 8 + STATE_SIZE
+
+export type GhostState = {
+	BlockType: BlockTypes.BlockType?,
+	Cell: Vector3,
+}
+
+export type Report = {
+	Sequence: number,
+	State: GhostState,
+}
+
+export type BatchEntry = {
+	UserId: number,
+	State: GhostState,
+}
+
+export type Batch = {
+	Sequence: number,
+	Entries: { BatchEntry },
+}
+
+local Module = {}
+
+--[[
+	The state of a ghost that is not shown.
+]]
+Module.Hidden = table.freeze({ Cell = Vector3.zero }) :: GhostState
+
+--[[
+	The most entries one batch may hold. It keeps a batch under the 1,000-byte payload limit of
+	an UnreliableRemoteEvent.
+]]
+Module.MaxBatchEntries = 60
+
+const indexByBlockType: { [BlockTypes.BlockType]: number } = {}
+for index, blockType in BlockTypes.List do
+	indexByBlockType[blockType] = index
+end
+
+local function toCellIndex(value: number): number
+	return math.floor(value / BLOCK_SIZE)
+end
+
+local function isCellIndexInRange(index: number): boolean
+	-- A NaN coordinate fails both comparisons, so it is never in range.
+	return index >= MIN_CELL_INDEX and index <= MAX_CELL_INDEX
+end
+
+local function fromCellIndex(index: number): number
+	return (index + 0.5) * BLOCK_SIZE
+end
+
+--[[
+	Writes a state at offset. A ghost whose cell is too far out to encode is written as hidden;
+	the buffer is already zeroed, so a hidden state needs no writes.
+]]
+local function writeState(data: buffer, offset: number, state: GhostState)
+	const blockType = state.BlockType
+	if not blockType then
+		return
+	end
+
+	const x = toCellIndex(state.Cell.X)
+	const y = toCellIndex(state.Cell.Y)
+	const z = toCellIndex(state.Cell.Z)
+	if not (isCellIndexInRange(x) and isCellIndexInRange(y) and isCellIndexInRange(z)) then
+		return
+	end
+
+	buffer.writeu8(data, offset, indexByBlockType[blockType])
+	buffer.writei16(data, offset + 1, x)
+	buffer.writei16(data, offset + 3, y)
+	buffer.writei16(data, offset + 5, z)
+end
+
+local function readState(data: buffer, offset: number): GhostState?
+	const index = buffer.readu8(data, offset)
+	if index == 0 then
+		return Module.Hidden
+	end
+
+	const blockType = BlockTypes.List[index]
+	if not blockType then
+		return nil
+	end
+
+	return {
+		BlockType = blockType,
+		Cell = Vector3.new(
+			fromCellIndex(buffer.readi16(data, offset + 1)),
+			fromCellIndex(buffer.readi16(data, offset + 3)),
+			fromCellIndex(buffer.readi16(data, offset + 5))
+		),
+	}
+end
+
+--[[
+	Whether two states show the same thing. Hidden states are equal whatever their cells.
+]]
+function Module.statesEqual(a: GhostState, b: GhostState): boolean
+	if a.BlockType ~= b.BlockType then
+		return false
+	end
+	return a.BlockType == nil or a.Cell == b.Cell
+end
+
+--[[
+	The report sequence that follows sequence. Report sequences wrap around at 65,536.
+]]
+function Module.nextReportSequence(sequence: number): number
+	return (sequence + 1) % REPORT_SEQUENCE_MODULUS
+end
+
+--[[
+	Whether sequence was sent after lastSequence. Unreliable remotes can deliver out of order,
+	so a report older than the last one applied is dropped.
+]]
+function Module.isNewerReport(sequence: number, lastSequence: number): boolean
+	const distance = (sequence - lastSequence) % REPORT_SEQUENCE_MODULUS
+	return distance > 0 and distance < REPORT_SEQUENCE_MODULUS / 2
+end
+
+function Module.encodeReport(sequence: number, state: GhostState): buffer
+	const data = buffer.create(REPORT_SIZE)
+	buffer.writeu16(data, 0, sequence)
+	writeState(data, 2, state)
+	return data
+end
+
+--[[
+	Reads a report sent by a client. Returns nil for anything that is not a well-formed report.
+]]
+function Module.decodeReport(data: unknown): Report?
+	if typeof(data) ~= "buffer" or buffer.len(data) ~= REPORT_SIZE then
+		return nil
+	end
+
+	const state = readState(data, 2)
+	if not state then
+		return nil
+	end
+
+	return {
+		Sequence = buffer.readu16(data, 0),
+		State = state,
+	}
+end
+
+function Module.encodeBatch(sequence: number, entries: { BatchEntry }): buffer
+	assert(#entries <= Module.MaxBatchEntries, "Too many entries for one ghost batch")
+
+	const data = buffer.create(BATCH_HEADER_SIZE + BATCH_ENTRY_SIZE * #entries)
+	buffer.writeu32(data, 0, sequence)
+	for index, entry in entries do
+		const offset = BATCH_HEADER_SIZE + BATCH_ENTRY_SIZE * (index - 1)
+		buffer.writef64(data, offset, entry.UserId)
+		writeState(data, offset + 8, entry.State)
+	end
+	return data
+end
+
+--[[
+	Reads a batch sent by the server. Returns nil when the buffer is malformed, and skips any
+	entry whose block type this client does not know.
+]]
+function Module.decodeBatch(data: unknown): Batch?
+	if typeof(data) ~= "buffer" then
+		return nil
+	end
+	const length = buffer.len(data)
+	if length < BATCH_HEADER_SIZE or (length - BATCH_HEADER_SIZE) % BATCH_ENTRY_SIZE ~= 0 then
+		return nil
+	end
+
+	const entries = {}
+	for offset = BATCH_HEADER_SIZE, length - 1, BATCH_ENTRY_SIZE do
+		const state = readState(data, offset + 8)
+		if state then
+			table.insert(entries, {
+				UserId = buffer.readf64(data, offset),
+				State = state,
+			})
+		end
+	end
+
+	return {
+		Sequence = buffer.readu32(data, 0),
+		Entries = entries,
+	}
+end
+
+return Module
