@@ -0,0 +1,212 @@
+--!strict
+--[[
+	The wire format for ghost previews, shared by the client and server ghost
+	scripts. Every read and write of these buffers stays in this module.
+
+	A ghost is a block type index and a grid cell. Cells travel as integer
+	cell indexes, not positions, so each axis fits an i16 with nothing lost.
+
+	Client to server, one ghost (8 bytes):
+		u8 sequence, u8 block type index, i16 x, i16 y, i16 z
+	Server to client, a batch:
+		u32 server tick, then per entry (15 bytes):
+		f64 user id, u8 block type index, i16 x, i16 y, i16 z
+]]
+
+local BlockTypes = require(script.Parent.BlockTypes)
+
+local BLOCK_SIZE = BlockTypes.BlockSize
+local CELL_MIN = -32768
+local CELL_MAX = 32767
+-- Block type index 0 means the ghost is hidden.
+local HIDDEN_INDEX = 0
+local SEQUENCE_COUNT = 256
+
+local STATE_SIZE = 8
+local BATCH_HEADER_SIZE = 4
+local ENTRY_SIZE = 15
+-- Keeps each batch under the 1,000-byte UnreliableRemoteEvent payload limit.
+local MAX_ENTRIES_PER_BATCH = 60
+
+export type Ghost = {
+	BlockTypeIndex: number,
+	X: number,
+	Y: number,
+	Z: number,
+}
+
+export type State = {
+	Sequence: number,
+	Ghost: Ghost,
+}
+
+export type Entry = {
+	UserId: number,
+	Ghost: Ghost,
+}
+
+local indexByName: { [string]: number? } = {}
+for index, blockType in BlockTypes.List do
+	indexByName[blockType.Name] = index
+end
+
+local Module = {}
+
+Module.HiddenGhost = table.freeze({
+	BlockTypeIndex = HIDDEN_INDEX,
+	X = 0,
+	Y = 0,
+	Z = 0,
+}) :: Ghost
+
+local function toCell(value: number): number
+	return math.floor(value / BLOCK_SIZE)
+end
+
+local function isCellInRange(value: number): boolean
+	-- Also false for NaN, which compares false with everything.
+	return value >= CELL_MIN and value <= CELL_MAX
+end
+
+local function readGhost(data: buffer, offset: number): Ghost
+	local blockTypeIndex = buffer.readu8(data, offset)
+	if blockTypeIndex == HIDDEN_INDEX then
+		return Module.HiddenGhost
+	end
+	return {
+		BlockTypeIndex = blockTypeIndex,
+		X = buffer.readi16(data, offset + 1),
+		Y = buffer.readi16(data, offset + 3),
+		Z = buffer.readi16(data, offset + 5),
+	}
+end
+
+local function writeGhost(data: buffer, offset: number, ghost: Ghost)
+	buffer.writeu8(data, offset, ghost.BlockTypeIndex)
+	buffer.writei16(data, offset + 1, ghost.X)
+	buffer.writei16(data, offset + 3, ghost.Y)
+	buffer.writei16(data, offset + 5, ghost.Z)
+end
+
+--[[
+	Returns the ghost for a block type placed at a world point: the grid cell
+	that contains the point. Returns the hidden ghost for an unknown block type
+	or a cell outside the range the wire format can carry.
+]]
+function Module.ghostAt(blockTypeName: string, point: Vector3): Ghost
+	local blockTypeIndex = indexByName[blockTypeName]
+	local x, y, z = toCell(point.X), toCell(point.Y), toCell(point.Z)
+	local isInRange = isCellInRange(x) and isCellInRange(y) and isCellInRange(z)
+	if not blockTypeIndex or not isInRange then
+		return Module.HiddenGhost
+	end
+	return {
+		BlockTypeIndex = blockTypeIndex,
+		X = x,
+		Y = y,
+		Z = z,
+	}
+end
+
+function Module.isHidden(ghost: Ghost): boolean
+	return ghost.BlockTypeIndex == HIDDEN_INDEX
+end
+
+function Module.isSameGhost(first: Ghost, second: Ghost): boolean
+	return first.BlockTypeIndex == second.BlockTypeIndex
+		and first.X == second.X
+		and first.Y == second.Y
+		and first.Z == second.Z
+end
+
+--[[
+	Returns the center of the ghost's cell, the same position BlockPlacement
+	snaps a placed block to.
+]]
+function Module.cellToPosition(ghost: Ghost): Vector3
+	local cell = Vector3.new(ghost.X, ghost.Y, ghost.Z)
+	return cell * BLOCK_SIZE + Vector3.one * (BLOCK_SIZE / 2)
+end
+
+function Module.getBlockType(ghost: Ghost): BlockTypes.BlockType?
+	return BlockTypes.List[ghost.BlockTypeIndex]
+end
+
+--[[
+	Whether sequence number `new` came after `old`, allowing for the numbers
+	wrapping around. Unreliable messages can arrive out of order.
+]]
+function Module.isNewerSequence(new: number, old: number): boolean
+	local difference = (new - old) % SEQUENCE_COUNT
+	return difference > 0 and difference < SEQUENCE_COUNT / 2
+end
+
+function Module.nextSequence(sequence: number): number
+	return (sequence + 1) % SEQUENCE_COUNT
+end
+
+function Module.encodeState(sequence: number, ghost: Ghost): buffer
+	local data = buffer.create(STATE_SIZE)
+	buffer.writeu8(data, 0, sequence)
+	writeGhost(data, 1, ghost)
+	return data
+end
+
+--[[
+	Decodes a ghost sent by a client. Returns nil for anything that is not a
+	well-formed ghost, so the server can pass client data straight in.
+]]
+function Module.decodeState(data: unknown): State?
+	if typeof(data) ~= "buffer" or buffer.len(data) ~= STATE_SIZE then
+		return nil
+	end
+	if buffer.readu8(data, 1) > #BlockTypes.List then
+		return nil
+	end
+	return {
+		Sequence = buffer.readu8(data, 0),
+		Ghost = readGhost(data, 1),
+	}
+end
+
+--[[
+	Packs entries into as few batches as fit the unreliable payload limit.
+]]
+function Module.encodeBatches(serverTick: number, entries: { Entry }): { buffer }
+	local batches = {}
+	for first = 1, #entries, MAX_ENTRIES_PER_BATCH do
+		local last = math.min(first + MAX_ENTRIES_PER_BATCH - 1, #entries)
+		local data = buffer.create(BATCH_HEADER_SIZE + (last - first + 1) * ENTRY_SIZE)
+		buffer.writeu32(data, 0, serverTick)
+
+		local offset = BATCH_HEADER_SIZE
+		for index = first, last do
+			local entry = entries[index]
+			buffer.writef64(data, offset, entry.UserId)
+			writeGhost(data, offset + 8, entry.Ghost)
+			offset += ENTRY_SIZE
+		end
+		table.insert(batches, data)
+	end
+	return batches
+end
+
+function Module.decodeBatch(data: buffer): (number, { Entry })
+	local entries = {}
+	local length = buffer.len(data)
+	if length < BATCH_HEADER_SIZE then
+		return 0, entries
+	end
+
+	local offset = BATCH_HEADER_SIZE
+	while offset + ENTRY_SIZE <= length do
+		table.insert(entries, {
+			UserId = buffer.readf64(data, offset),
+			Ghost = readGhost(data, offset + 8),
+		})
+		offset += ENTRY_SIZE
+	end
+	return buffer.readu32(data, 0), entries
+end
+
+return table.freeze(Module)
