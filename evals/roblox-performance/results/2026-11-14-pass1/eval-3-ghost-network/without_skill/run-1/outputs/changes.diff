diff --git a/src/ServerScriptService/Tests/Specs/GhostProtocol.spec.luau b/src/ServerScriptService/Tests/Specs/GhostProtocol.spec.luau
new file mode 100644
index 0000000..0e83bf3
--- /dev/null
+++ b/src/ServerScriptService/Tests/Specs/GhostProtocol.spec.luau
@@ -0,0 +1,79 @@
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local ServerScriptService = game:GetService("ServerScriptService")
+
+local JestGlobals = require(ServerScriptService.Tests.Packages.JestGlobals)
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local GhostProtocol = require(ReplicatedStorage.Shared.GhostProtocol)
+
+local describe = JestGlobals.describe
+local expect = JestGlobals.expect
+local it = JestGlobals.it
+
+describe("ghost states", function()
+	it("round-trips a block type and cell", function()
+		local cell = Vector3.new(-6, 2, 130)
+		local blockType, decodedCell =
+			GhostProtocol.decodeState(GhostProtocol.encodeState("Wood", cell))
+		expect(blockType).toBe(BlockTypes.ByName.Wood)
+		expect(decodedCell).toEqual(cell)
+	end)
+
+	it("encodes a missing cell or block type as hidden", function()
+		local blockType, cell = GhostProtocol.decodeState(GhostProtocol.encodeState("Brick", nil))
+		expect(blockType).toBeNil()
+		expect(cell).toBeNil()
+		blockType, cell =
+			GhostProtocol.decodeState(GhostProtocol.encodeState(nil, Vector3.new(2, 2, 2)))
+		expect(blockType).toBeNil()
+		expect(cell).toBeNil()
+	end)
+
+	it("encodes cells outside the grid range as hidden", function()
+		local blockType =
+			GhostProtocol.decodeState(GhostProtocol.encodeState("Brick", Vector3.new(1e6, 2, 2)))
+		expect(blockType).toBeNil()
+	end)
+
+	it("rejects malformed client states", function()
+		expect(GhostProtocol.isValidState(GhostProtocol.encodeState("Dirt", Vector3.new(2, 2, 2)))).toBe(
+			true
+		)
+		expect(GhostProtocol.isValidState("Dirt")).toBe(false)
+		expect(GhostProtocol.isValidState(buffer.create(GhostProtocol.STATE_SIZE + 1))).toBe(false)
+		local badType = buffer.create(GhostProtocol.STATE_SIZE)
+		buffer.writeu8(badType, 0, #BlockTypes.List + 1)
+		expect(GhostProtocol.isValidState(badType)).toBe(false)
+	end)
+end)
+
+describe("batches", function()
+	it("round-trips entries", function()
+		local data = GhostProtocol.encodeBatch({
+			{ userId = 1, state = GhostProtocol.encodeState("Grass", Vector3.new(2, 6, 2)) },
+			{ userId = -2, state = GhostProtocol.encodeState(nil, nil) },
+		})
+		local seen = {}
+		GhostProtocol.forEachInBatch(data, function(userId, blockType, cell)
+			table.insert(seen, { userId = userId, blockType = blockType, cell = cell })
+		end)
+		expect(#seen).toBe(2)
+		expect(seen[1].userId).toBe(1)
+		expect(seen[1].blockType).toBe(BlockTypes.ByName.Grass)
+		expect(seen[1].cell).toEqual(Vector3.new(2, 6, 2))
+		expect(seen[2].userId).toBe(-2)
+		expect(seen[2].blockType).toBeNil()
+	end)
+
+	it("ignores malformed batches", function()
+		local calls = 0
+		local function count()
+			calls += 1
+		end
+		GhostProtocol.forEachInBatch("nope", count)
+		GhostProtocol.forEachInBatch(buffer.create(1), count)
+		local truncated = buffer.create(3)
+		buffer.writeu16(truncated, 0, 1)
+		GhostProtocol.forEachInBatch(truncated, count)
+		expect(calls).toBe(0)
+	end)
+end)
