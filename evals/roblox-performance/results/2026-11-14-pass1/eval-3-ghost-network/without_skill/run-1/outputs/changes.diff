@@ -0,0 +1,139 @@
+--[[
+	Wire format and rates for ghost previews, shared by the server and client ghost scripts.
+
+	A ghost state is a 7-byte buffer: the block type's index in BlockTypes.List (u8, 0 means
+	hidden), then the cell's grid coordinates as three i16s. Grid coordinate k is the cell whose
+	centre is k * BlockSize + BlockSize / 2 on that axis, which covers about +-131,000 studs.
+
+	A batch is a u16 count followed by that many entries of UserId (f64) + ghost state.
+]]
+
+local BlockTypes = require(script.Parent.BlockTypes)
+
+local BLOCK_SIZE = BlockTypes.BlockSize
+local STATE_SIZE = 7
+local HEADER_SIZE = 2
+local ENTRY_SIZE = 8 + STATE_SIZE
+local MAX_BATCH_COUNT = 65535
+local GRID_MIN = -32768
+local GRID_MAX = 32767
+
+local indexByName: { [string]: number } = {}
+for index, blockType in BlockTypes.List do
+	indexByName[blockType.Name] = index
+end
+
+export type BatchEntry = {
+	userId: number,
+	state: buffer,
+}
+
+local GhostProtocol = {
+	-- Shortest time between two ghost updates from one client, in seconds.
+	SEND_INTERVAL = 1 / 20,
+	-- How often the server forwards the ghost updates it has collected, in seconds.
+	BROADCAST_INTERVAL = 1 / 20,
+	STATE_SIZE = STATE_SIZE,
+}
+
+local function toGrid(value: number): number
+	return math.round((value - BLOCK_SIZE / 2) / BLOCK_SIZE)
+end
+
+local function fromGrid(k: number): number
+	return k * BLOCK_SIZE + BLOCK_SIZE / 2
+end
+
+local function inGridRange(k: number): boolean
+	return k >= GRID_MIN and k <= GRID_MAX
+end
+
+--[[
+	Encodes a ghost state. Pass nil for blockTypeName or cell to hide the ghost. Cells too far out
+	to fit the format are encoded as hidden.
+]]
+function GhostProtocol.encodeState(blockTypeName: string?, cell: Vector3?): buffer
+	local state = buffer.create(STATE_SIZE) -- zero-filled, which reads as hidden
+	local typeIndex = if blockTypeName then indexByName[blockTypeName] else nil
+	if not typeIndex or not cell then
+		return state
+	end
+
+	local x, y, z = toGrid(cell.X), toGrid(cell.Y), toGrid(cell.Z)
+	if not (inGridRange(x) and inGridRange(y) and inGridRange(z)) then
+		return state
+	end
+
+	buffer.writeu8(state, 0, typeIndex)
+	buffer.writei16(state, 1, x)
+	buffer.writei16(state, 3, y)
+	buffer.writei16(state, 5, z)
+	return state
+end
+
+--[[
+	Reads the ghost state at offset. Returns nil, nil if the ghost is hidden.
+]]
+function GhostProtocol.decodeState(data: buffer, offset: number?): (BlockTypes.BlockType?, Vector3?)
+	local at = offset or 0
+	local blockType = BlockTypes.List[buffer.readu8(data, at)]
+	if not blockType then
+		return nil, nil
+	end
+	local cell = Vector3.new(
+		fromGrid(buffer.readi16(data, at + 1)),
+		fromGrid(buffer.readi16(data, at + 3)),
+		fromGrid(buffer.readi16(data, at + 5))
+	)
+	return blockType, cell
+end
+
+--[[
+	Whether a value sent by a client is a well-formed ghost state.
+]]
+function GhostProtocol.isValidState(value: unknown): boolean
+	if typeof(value) ~= "buffer" or buffer.len(value) ~= STATE_SIZE then
+		return false
+	end
+	return buffer.readu8(value, 0) <= #BlockTypes.List
+end
+
+function GhostProtocol.encodeBatch(entries: { BatchEntry }): buffer
+	local count = math.min(#entries, MAX_BATCH_COUNT)
+	local data = buffer.create(HEADER_SIZE + count * ENTRY_SIZE)
+	buffer.writeu16(data, 0, count)
+	for i = 1, count do
+		local entry = entries[i]
+		local offset = HEADER_SIZE + (i - 1) * ENTRY_SIZE
+		buffer.writef64(data, offset, entry.userId)
+		buffer.copy(data, offset + 8, entry.state, 0, STATE_SIZE)
+	end
+	return data
+end
+
+--[[
+	Calls callback with each entry of a batch. Does nothing if data isn't a well-formed batch.
+]]
+function GhostProtocol.forEachInBatch(
+	data: unknown,
+	callback: (
+		userId: number,
+		blockType: BlockTypes.BlockType?,
+		cell: Vector3?
+	) -> ()
+)
+	if typeof(data) ~= "buffer" or buffer.len(data) < HEADER_SIZE then
+		return
+	end
+	local count = buffer.readu16(data, 0)
+	if buffer.len(data) ~= HEADER_SIZE + count * ENTRY_SIZE then
+		return
+	end
+	for i = 1, count do
+		local offset = HEADER_SIZE + (i - 1) * ENTRY_SIZE
+		local blockType, cell = GhostProtocol.decodeState(data, offset + 8)
+		callback(buffer.readf64(data, offset), blockType, cell)
+	end
+end
+
+return table.freeze(GhostProtocol)
