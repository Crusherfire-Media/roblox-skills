new file mode 100644
index 0000000..1870807
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/GhostCodec.luau
@@ -0,0 +1,151 @@
+--[[
+	Wire format and timing shared by the ghost preview server and client scripts.
+
+	A ghost state is a block type index (0 means hidden) plus a grid cell, stored as three
+	signed 16-bit cell indices. Cell index i covers the cell whose centre is
+	(i + 0.5) * BlockSize studs on that axis.
+
+	Client -> server (GhostState): one 7-byte buffer
+		u8 typeIndex, i16 x, i16 y, i16 z
+	Server -> clients (GhostUpdates): a buffer of 8-byte entries, one per changed ghost
+		u8 slot, u8 typeIndex, i16 x, i16 y, i16 z
+	Each player's slot is in their "GhostSlot" attribute.
+]]
+
+local BlockTypes = require(script.Parent.BlockTypes)
+
+local BLOCK_SIZE = BlockTypes.BlockSize
+local MIN_INDEX = -32768
+local MAX_INDEX = 32767
+
+local GhostCodec = {}
+
+-- The most often a client sends its state, and the server sends batches.
+GhostCodec.SendRate = 20
+GhostCodec.SendInterval = 1 / GhostCodec.SendRate
+GhostCodec.StateSize = 7
+GhostCodec.EntrySize = 8
+GhostCodec.MaxSlots = 255
+GhostCodec.SlotAttribute = "GhostSlot"
+
+export type State = {
+	typeIndex: number,
+	x: number,
+	y: number,
+	z: number,
+}
+
+GhostCodec.Hidden = table.freeze({ typeIndex = 0, x = 0, y = 0, z = 0 }) :: State
+
+local typeIndexByName: { [string]: number } = {}
+for index, blockType in BlockTypes.List do
+	typeIndexByName[blockType.Name] = index
+end
+
+function GhostCodec.typeIndexOf(name: string): number?
+	return typeIndexByName[name]
+end
+
+function GhostCodec.blockTypeAt(typeIndex: number): BlockTypes.BlockType?
+	return BlockTypes.List[typeIndex]
+end
+
+--[[
+	Turns a cell centre position into a state, or the hidden state if the cell can't be encoded.
+]]
+function GhostCodec.fromCell(typeIndex: number, cell: Vector3): State
+	local x = math.floor(cell.X / BLOCK_SIZE)
+	local y = math.floor(cell.Y / BLOCK_SIZE)
+	local z = math.floor(cell.Z / BLOCK_SIZE)
+	if
+		x < MIN_INDEX
+		or x > MAX_INDEX
+		or y < MIN_INDEX
+		or y > MAX_INDEX
+		or z < MIN_INDEX
+		or z > MAX_INDEX
+	then
+		return GhostCodec.Hidden
+	end
+	return { typeIndex = typeIndex, x = x, y = y, z = z }
+end
+
+function GhostCodec.toCell(state: State): Vector3
+	return Vector3.new(
+		(state.x + 0.5) * BLOCK_SIZE,
+		(state.y + 0.5) * BLOCK_SIZE,
+		(state.z + 0.5) * BLOCK_SIZE
+	)
+end
+
+function GhostCodec.equals(a: State, b: State): boolean
+	if a.typeIndex == 0 and b.typeIndex == 0 then
+		return true
+	end
+	return a.typeIndex == b.typeIndex and a.x == b.x and a.y == b.y and a.z == b.z
+end
+
+function GhostCodec.encodeState(state: State): buffer
+	local payload = buffer.create(GhostCodec.StateSize)
+	buffer.writeu8(payload, 0, state.typeIndex)
+	buffer.writei16(payload, 1, state.x)
+	buffer.writei16(payload, 3, state.y)
+	buffer.writei16(payload, 5, state.z)
+	return payload
+end
+
+--[[
+	Reads a client's state, or returns nil if the payload is malformed.
+]]
+function GhostCodec.decodeState(payload: unknown): State?
+	if typeof(payload) ~= "buffer" or buffer.len(payload) ~= GhostCodec.StateSize then
+		return nil
+	end
+	local typeIndex = buffer.readu8(payload, 0)
+	if typeIndex ~= 0 and not BlockTypes.List[typeIndex] then
+		return nil
+	end
+	if typeIndex == 0 then
+		return GhostCodec.Hidden
+	end
+	return {
+		typeIndex = typeIndex,
+		x = buffer.readi16(payload, 1),
+		y = buffer.readi16(payload, 3),
+		z = buffer.readi16(payload, 5),
+	}
+end
+
+function GhostCodec.encodeBatch(entries: { { slot: number, state: State } }): buffer
+	local payload = buffer.create(#entries * GhostCodec.EntrySize)
+	for i, entry in entries do
+		local offset = (i - 1) * GhostCodec.EntrySize
+		buffer.writeu8(payload, offset, entry.slot)
+		buffer.writeu8(payload, offset + 1, entry.state.typeIndex)
+		buffer.writei16(payload, offset + 2, entry.state.x)
+		buffer.writei16(payload, offset + 4, entry.state.y)
+		buffer.writei16(payload, offset + 6, entry.state.z)
+	end
+	return payload
+end
+
+--[[
+	Calls `callback(slot, state)` for every entry in a batch from the server.
+]]
+function GhostCodec.forEachInBatch(payload: unknown, callback: (number, State) -> ())
+	if typeof(payload) ~= "buffer" then
+		return
+	end
+	local count = buffer.len(payload) // GhostCodec.EntrySize
+	for i = 0, count - 1 do
+		local offset = i * GhostCodec.EntrySize
+		callback(buffer.readu8(payload, offset), {
+			typeIndex = buffer.readu8(payload, offset + 1),
+			x = buffer.readi16(payload, offset + 2),
+			y = buffer.readi16(payload, offset + 4),
+			z = buffer.readi16(payload, offset + 6),
+		})
+	end
+end
+
+return table.freeze(GhostCodec)
