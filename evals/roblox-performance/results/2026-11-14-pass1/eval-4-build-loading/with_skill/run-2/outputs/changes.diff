+--[[
+	Builds this frame's share of a job into one detached Folder and parents it once, so the
+	frame's parts replicate together. Returns whether the job has blocks left.
+]]
+local function continueBuild(job: BuildJob): boolean
+	local chunk = Instance.new("Folder")
+	chunk.Name = "SavedBlocks"
+	local builtCount = 0
+	while job.NextIndex <= #job.Pending and canAffordBlocks(1) do
+		local pendingBlock = job.Pending[job.NextIndex]
+		job.NextIndex += 1
+		blocksLeftThisFrame -= 1
+		local part = createBlock(
+			pendingBlock.Type,
+			pendingBlock.Cell,
+			job.Plot.Owner.UserId,
+			pendingBlock.PlacedAt
+		)
+		part.Parent = chunk
+		builtCount += 1
+	end
+	if builtCount > 0 then
+		chunk.Parent = job.Plot.Folder
+	else
+		chunk:Destroy()
+	end
+	return job.NextIndex <= #job.Pending
+end
 
