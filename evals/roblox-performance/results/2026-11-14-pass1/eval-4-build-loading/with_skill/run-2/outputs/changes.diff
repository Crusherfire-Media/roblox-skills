+local function continueTeardown(job: TeardownJob): boolean
+	while job.NextIndex <= #job.Children do
+		local child = job.Children[job.NextIndex]
+		local cost = if child:IsA("Folder") then #child:GetChildren() else 1
+		-- A fresh frame always takes the next child, so a chunk larger than the frame's
