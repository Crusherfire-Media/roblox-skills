-local function loadBuild(player: Player, plotFolder: Folder, plotCorner: Vector3)
+local function loadBuild(player: Player, plot: Plot, plotCorner: Vector3)
 	local savedBlocks = SavedBuilds.load(player.UserId)
+	-- Once SavedBuilds reads a DataStore it yields, and the player can leave meanwhile.
+	if plots[player] ~= plot then
+		return
+	end
