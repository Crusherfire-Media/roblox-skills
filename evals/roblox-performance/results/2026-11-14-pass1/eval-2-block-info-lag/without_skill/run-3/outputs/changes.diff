+-- Block counts ------------------------------------------------------------------------------
+
+-- Children of the Blocks folder of each known type, keyed by type name.
+local counts: { [string]: number } = {}
+for _, blockType in BlockTypes.List do
+	counts[blockType.Name] = 0
+end
+-- All children of the Blocks folder, whatever they are.
+local totalCount = 0
+-- The name each child was counted under, so removal undoes exactly what adding did.
+local countedName: { [Instance]: string } = {}
+local countsDirty = true
+
+-- Spatial hash ------------------------------------------------------------------------------
+
+-- BaseParts in the Blocks folder, grouped by the BLOCK_SIZE grid cell their center falls in.
+local cells: { [Vector3]: { [BasePart]: true } } = {}
+local blockCell: { [BasePart]: Vector3 } = {}
+
+local function cellOf(position: Vector3): Vector3
+	return Vector3.new(
+		math.floor(position.X / BLOCK_SIZE),
+		math.floor(position.Y / BLOCK_SIZE),
+		math.floor(position.Z / BLOCK_SIZE)
+	)
+end
+
+local function onBlockAdded(child: Instance)
+	if countedName[child] then
+		return
+	end
+	totalCount += 1
+	countedName[child] = child.Name
+	if counts[child.Name] then
+		counts[child.Name] += 1
+	end
+	countsDirty = true
+
+	if child:IsA("BasePart") then
+		-- Blocks are anchored and never moved after placement, so the cell is fixed.
+		local cell = cellOf(child.Position)
+		local bucket = cells[cell]
+		if not bucket then
+			bucket = {}
+			cells[cell] = bucket
+		end
+		bucket[child] = true
+		blockCell[child] = cell
+	end
+end
+
+local function onBlockRemoved(child: Instance)
+	local name = countedName[child]
+	if not name then
+		return
+	end
+	countedName[child] = nil
+	totalCount -= 1
+	if counts[name] then
+		counts[name] -= 1
+	end
+	countsDirty = true
+
+	if child:IsA("BasePart") then
+		local cell = blockCell[child]
+		if cell then
+			blockCell[child] = nil
+			local bucket = cells[cell]
+			if bucket then
+				bucket[child] = nil
+				if next(bucket) == nil then
+					cells[cell] = nil
+				end
+			end
+		end
+	end
+end
+
+blocksFolder.ChildAdded:Connect(onBlockAdded)
+blocksFolder.ChildRemoved:Connect(onBlockRemoved)
+for _, child in blocksFolder:GetChildren() do
+	onBlockAdded(child)
+end
+
