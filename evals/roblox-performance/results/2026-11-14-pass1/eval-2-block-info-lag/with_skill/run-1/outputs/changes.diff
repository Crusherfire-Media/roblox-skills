+local raycastParams = RaycastParams.new()
+raycastParams.FilterType = Enum.RaycastFilterType.Exclude
+
+local countsByName: { [string]: number } = {}
+for _, blockType in BlockTypes.List do
+	countsByName[blockType.Name] = 0
+end
+local totalChildren = 0
+
+-- The name each child was counted under, so a removal undoes exactly what its add did.
+local countedNames: { [Instance]: string } = {}
+-- Blocks are anchored and snapped to the grid, so a block's cell is read once when it arrives.
+local blocksByCell: { [Vector3]: { BasePart } } = {}
+local cellByBlock: { [BasePart]: Vector3 } = {}
+
+local isTextStale = true
+local hoveredBlock: BasePart? = nil
+local hoveredName: string? = nil
+
+local function getCell(position: Vector3): Vector3
+	return Vector3.new(
+		math.floor(position.X / BLOCK_SIZE),
+		math.floor(position.Y / BLOCK_SIZE),
+		math.floor(position.Z / BLOCK_SIZE)
+	)
+end
+
+local function onChildAdded(child: Instance)
+	-- Children already counted from GetChildren can still arrive here as deferred events.
+	if countedNames[child] then
+		return
+	end
+
+	countedNames[child] = child.Name
+	totalChildren += 1
+	if countsByName[child.Name] then
+		countsByName[child.Name] += 1
+	end
+	isTextStale = true
+
+	if child:IsA("BasePart") then
+		local cell = getCell(child.Position)
+		local blocks = blocksByCell[cell]
+		if blocks then
+			table.insert(blocks, child)
+		else
+			blocksByCell[cell] = { child }
+		end
+		cellByBlock[child] = cell
+	end
+end
+
+local function onChildRemoved(child: Instance)
+	local countedName = countedNames[child]
+	if not countedName then
+		return
+	end
+
+	countedNames[child] = nil
+	totalChildren -= 1
+	if countsByName[countedName] then
+		countsByName[countedName] -= 1
+	end
+	isTextStale = true
+
+	if not child:IsA("BasePart") then
+		return
+	end
+	local cell = cellByBlock[child]
+	if cell then
+		cellByBlock[child] = nil
+		local blocks = blocksByCell[cell]
+		local index = table.find(blocks, child)
+		if index then
+			table.remove(blocks, index)
+		end
+		if #blocks == 0 then
+			blocksByCell[cell] = nil
+		end
+	end
+end
+
+local function onCharacterAdded(character: Model)
+	raycastParams.FilterDescendantsInstances = { character }
+end
+
