+local raycastParams = RaycastParams.new()
+raycastParams.FilterType = Enum.RaycastFilterType.Exclude
+local filteredCharacter: Model? = nil
+
+local counts: { [string]: number } = {}
+for _, blockType in BlockTypes.List do
+	counts[blockType.Name] = 0
+end
+local totalCount = 0
+local nextOrder = 0
+
+local records: { [Instance]: BlockRecord } = {}
+local grid: { [Vector3]: { [BasePart]: true }? } = {}
+
+local hovered: BasePart? = nil
+local isTextDirty = true
+local textPieces: { string } = {}
+
+local function getCell(position: Vector3): Vector3
+	return Vector3.new(
+		math.floor(position.X / GRID_CELL_SIZE),
+		math.floor(position.Y / GRID_CELL_SIZE),
+		math.floor(position.Z / GRID_CELL_SIZE)
+	)
+end
+
+local function onBlockAdded(block: Instance)
+	nextOrder += 1
+	local record: BlockRecord = {
+		Name = block.Name,
+		Position = Vector3.zero,
+		Cell = nil,
+		Order = nextOrder,
+	}
+	records[block] = record
+
+	totalCount += 1
+	if counts[record.Name] then
+		counts[record.Name] += 1
+	end
+
+	if block:IsA("BasePart") then
+		record.Position = block.Position
+		local cell = getCell(record.Position)
+		record.Cell = cell
+		local members = grid[cell]
+		if not members then
+			members = {}
+			grid[cell] = members
+		end
+		members[block] = true
+	end
+
+	isTextDirty = true
+end
+
+local function onBlockRemoved(block: Instance)
+	local record = records[block]
+	if not record then
+		return
+	end
+	records[block] = nil
+
+	totalCount -= 1
+	if counts[record.Name] then
+		counts[record.Name] -= 1
+	end
+
+	local cell = record.Cell
+	if cell then
+		local members = grid[cell]
+		if members then
+			members[block :: BasePart] = nil
+			if next(members) == nil then
+				grid[cell] = nil
+			end
+		end
+	end
+
+	isTextDirty = true
+end
+
+local function updateRaycastFilter()
+	local character = localPlayer.Character
+	if character == filteredCharacter then
+		return
+	end
+	filteredCharacter = character
+	raycastParams.FilterDescendantsInstances = if character then { character } else {}
+end
+
+--[[
+	Returns the block whose center is nearest the point under the mouse and closer than
+	HOVER_RADIUS, or nil.
+]]
 local function findHoveredBlock(): BasePart?
 	local camera = Workspace.CurrentCamera
 	if not camera then
 		return nil
 	end
 
+	updateRaycastFilter()
 	local mousePosition = UserInputService:GetMouseLocation()
 	local ray = camera:ViewportPointToRay(mousePosition.X, mousePosition.Y)
