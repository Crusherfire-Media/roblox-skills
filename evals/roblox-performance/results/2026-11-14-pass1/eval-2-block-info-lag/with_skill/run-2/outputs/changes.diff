+	local nearestOrder = math.huge
+	for x = minCell.X, maxCell.X do
+		for y = minCell.Y, maxCell.Y do
+			for z = minCell.Z, maxCell.Z do
+				local members = grid[Vector3.new(x, y, z)]
+				if not members then
+					continue
+				end
+				for block in members do
+					local record = records[block] :: BlockRecord
+					local distance = (record.Position - hitPosition).Magnitude
+					local isTieWonByOrder = nearest ~= nil
+						and distance == nearestDistance
+						and record.Order < nearestOrder
+					local isCloser = distance < nearestDistance or isTieWonByOrder
+					if isCloser then
+						nearest = block
+						nearestDistance = distance
+						nearestOrder = record.Order
+					end
+				end
 			end
 		end
 	end
 	return nearest
 end
 
