+-- Equal to the hover radius, so a query never spans more than three cells per axis.
+local GRID_CELL_SIZE = HOVER_RADIUS
+
+type BlockRecord = {
+	Name: string,
+	Position: Vector3,
+	Cell: Vector3?,
+	-- Join order, matching GetChildren order, breaks ties between equal distances.
+	Order: number,
+}
 
