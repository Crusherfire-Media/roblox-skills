+	local hitPosition = result.Position
+	local minCell = getCell(hitPosition - Vector3.one * HOVER_RADIUS)
+	local maxCell = getCell(hitPosition + Vector3.one * HOVER_RADIUS)
+
 	local nearest: BasePart? = nil
 	local nearestDistance = HOVER_RADIUS
