--- /dev/null
+++ b/src/ServerScriptService/Tests/Specs/GhostProtocol.spec.luau
@@ -0,0 +1,57 @@
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local ServerScriptService = game:GetService("ServerScriptService")
+
+local JestGlobals = require(ServerScriptService.Tests.Packages.JestGlobals)
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local GhostProtocol = require(ReplicatedStorage.Shared.GhostProtocol)
+
+local describe = JestGlobals.describe
+local expect = JestGlobals.expect
+local it = JestGlobals.it
+
+local size = BlockTypes.BlockSize
+
+describe("cells", function()
+	it("matches the placement grid", function()
+		local cell = GhostProtocol.cellFromPosition(Vector3.new(size * 1.5, -0.1, size * 3))
+		expect(cell).toEqual(Vector3.new(1, -1, 3))
+		expect(GhostProtocol.positionFromCell(cell)).toEqual(
+			Vector3.new(size * 1.5, -size / 2, size * 3.5)
+		)
+	end)
+end)
+
+describe("validate", function()
+	it("accepts a hidden ghost without a cell", function()
+		local state = GhostProtocol.validate(GhostProtocol.HIDDEN, nil)
+		expect(state and state.blockIndex).toBe(GhostProtocol.HIDDEN)
+	end)
+
+	it("accepts a real block type on a whole cell", function()
+		expect(GhostProtocol.validate(1, Vector3.new(2, 0, -5))).never.toBeNil()
+	end)
+
+	it("rejects bad input", function()
+		local nan = 0 / 0
+		expect(GhostProtocol.validate("Brick", Vector3.zero)).toBeNil()
+		expect(GhostProtocol.validate(#BlockTypes.List + 1, Vector3.zero)).toBeNil()
+		expect(GhostProtocol.validate(1, nil)).toBeNil()
+		expect(GhostProtocol.validate(1, Vector3.new(0.5, 0, 0))).toBeNil()
+		expect(GhostProtocol.validate(1, Vector3.new(nan, 0, 0))).toBeNil()
+		expect(GhostProtocol.validate(1, Vector3.new(math.huge, 0, 0))).toBeNil()
+	end)
+end)
+
+describe("encode and decodeEntry", function()
+	it("round-trips states", function()
+		local states = {
+			{ blockIndex = 2, cell = Vector3.new(-3, 0, 120) },
+			{ blockIndex = GhostProtocol.HIDDEN, cell = Vector3.zero },
+		}
+		local encoded = GhostProtocol.encode(states)
+		expect(buffer.len(encoded)).toBe(2 * GhostProtocol.ENTRY_SIZE)
+		expect(GhostProtocol.decodeEntry(encoded, 1)).toEqual(states[1])
+		expect(GhostProtocol.decodeEntry(encoded, 2)).toEqual(states[2])
+		expect(GhostProtocol.decodeEntry(encoded, 3)).toBeNil()
+	end)
+end)
