@@ -0,0 +1,110 @@
+--[[
+	Wire format for ghost previews, shared by GhostPreview.server and GhostPreview.client.
+
+	A ghost state is a block type index (0 means hidden) and a grid cell: integer coordinates on
+	the BlockTypes.BlockSize grid, so cell (0, 0, 0) is centred at (2, 2, 2) when the size is 4.
+
+	Client to server: GhostUpdate:FireServer(blockIndex: number, cell: Vector3?)
+	Server to clients: GhostUpdate:FireAllClients(players: { Player }, states: buffer), or
+	FireClient with the same arguments for a full snapshot. Entry i of `states` belongs to
+	players[i] and is ENTRY_SIZE bytes: u8 block index, then i32 x, y, z.
+]]
+
+local BlockTypes = require(script.Parent.BlockTypes)
+
+local BLOCK_SIZE = BlockTypes.BlockSize
+local ENTRY_SIZE = 13
+-- Cells further than this from the origin are treated as hidden. Vector3 components are 32-bit
+-- floats, which hold every integer up to 2^24 exactly.
+local MAX_CELL = 2 ^ 23
+
+export type GhostState = {
+	blockIndex: number,
+	cell: Vector3,
+}
+
+local GhostProtocol = {}
+
+GhostProtocol.REMOTE_NAME = "GhostUpdate"
+GhostProtocol.ENTRY_SIZE = ENTRY_SIZE
+GhostProtocol.HIDDEN = 0
+
+--[[
+	The grid cell holding a world position.
+]]
+function GhostProtocol.cellFromPosition(position: Vector3): Vector3
+	return Vector3.new(
+		math.floor(position.X / BLOCK_SIZE),
+		math.floor(position.Y / BLOCK_SIZE),
+		math.floor(position.Z / BLOCK_SIZE)
+	)
+end
+
+--[[
+	The world position of a grid cell's centre.
+]]
+function GhostProtocol.positionFromCell(cell: Vector3): Vector3
+	return (cell + Vector3.one * 0.5) * BLOCK_SIZE
+end
+
+local function isValidAxis(value: number): boolean
+	-- Rejects NaN (not equal to itself), infinities, fractions and huge values.
+	return value == value and math.abs(value) <= MAX_CELL and math.floor(value) == value
+end
+
+--[[
+	Checks values a client sent. Returns the state to show, where blockIndex 0 means hidden, or
+	nil if the message is malformed and should be ignored.
+]]
+function GhostProtocol.validate(blockIndex: unknown, cell: unknown): GhostState?
+	if typeof(blockIndex) ~= "number" then
+		return nil
+	end
+	if blockIndex == GhostProtocol.HIDDEN then
+		return { blockIndex = GhostProtocol.HIDDEN, cell = Vector3.zero }
+	end
+	if not BlockTypes.List[blockIndex] or typeof(cell) ~= "Vector3" then
+		return nil
+	end
+	if not (isValidAxis(cell.X) and isValidAxis(cell.Y) and isValidAxis(cell.Z)) then
+		return nil
+	end
+	return { blockIndex = blockIndex, cell = cell }
+end
+
+function GhostProtocol.encode(states: { GhostState }): buffer
+	local out = buffer.create(#states * ENTRY_SIZE)
+	for i, state in states do
+		local offset = (i - 1) * ENTRY_SIZE
+		buffer.writeu8(out, offset, state.blockIndex)
+		buffer.writei32(out, offset + 1, state.cell.X)
+		buffer.writei32(out, offset + 5, state.cell.Y)
+		buffer.writei32(out, offset + 9, state.cell.Z)
+	end
+	return out
+end
+
+--[[
+	Reads entry `index` (1-based) of an encoded buffer, or nil if it is out of range or holds a
+	block index that doesn't exist.
+]]
+function GhostProtocol.decodeEntry(states: buffer, index: number): GhostState?
+	local offset = (index - 1) * ENTRY_SIZE
+	if offset < 0 or offset + ENTRY_SIZE > buffer.len(states) then
+		return nil
+	end
+	local blockIndex = buffer.readu8(states, offset)
+	if blockIndex ~= GhostProtocol.HIDDEN and not BlockTypes.List[blockIndex] then
+		return nil
+	end
+	return {
+		blockIndex = blockIndex,
+		cell = Vector3.new(
+			buffer.readi32(states, offset + 1),
+			buffer.readi32(states, offset + 5),
+			buffer.readi32(states, offset + 9)
+		),
+	}
+end
+
+return table.freeze(GhostProtocol)
