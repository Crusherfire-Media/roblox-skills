--- /dev/null
+++ b/src/ReplicatedStorage/Shared/GhostPacket.luau
@@ -0,0 +1,117 @@
+--!strict
+--[[
+	Packs a ghost preview into the 9-byte buffer that travels client to server
+	and server to every other client:
+
+	| Offset | Type | Field |
+	|---|---|---|
+	| 0 | u16 | Sequence, wrapping |
+	| 2 | u8 | Index into BlockTypes.List, or 0 when the ghost is hidden |
+	| 3 | i16 x 3 | Grid cell X, Y, Z, counted in cells, not studs |
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+
+local SIZE = 9
+local SEQUENCE_RANGE = 65536
+local HIDDEN = 0
+local MIN_CELL = -32768
+local MAX_CELL = 32767
+local BLOCK_SIZE = BlockTypes.BlockSize
+
+export type Ghost = {
+	Sequence: number,
+	-- 0 when the ghost is hidden.
+	BlockIndex: number,
+	-- Center of the grid cell in studs, or nil when the ghost is hidden.
+	Cell: Vector3?,
+}
+
+local indexByName: { [string]: number? } = {}
+for index, blockType in BlockTypes.List do
+	indexByName[blockType.Name] = index
+end
+
+local function toCellIndex(stud: number): number
+	return math.floor(stud / BLOCK_SIZE)
+end
+
+local function toStud(cellIndex: number): number
+	return cellIndex * BLOCK_SIZE + BLOCK_SIZE / 2
+end
+
+local function isInRange(cellIndex: number): boolean
+	return cellIndex >= MIN_CELL and cellIndex <= MAX_CELL
+end
+
+local Module = {}
+
+Module.Hidden = HIDDEN
+
+function Module.getBlockIndex(blockTypeName: string): number
+	return indexByName[blockTypeName] or HIDDEN
+end
+
+--[[
+	Packs a ghost. A cell outside the i16 grid (over 131,000 studs from the
+	origin) is sent as hidden.
+]]
+function Module.encode(sequence: number, blockIndex: number, cell: Vector3?): buffer
+	local packet = buffer.create(SIZE)
+	buffer.writeu16(packet, 0, sequence % SEQUENCE_RANGE)
+	if not cell then
+		return packet
+	end
+
+	local x, y, z = toCellIndex(cell.X), toCellIndex(cell.Y), toCellIndex(cell.Z)
+	if not (isInRange(x) and isInRange(y) and isInRange(z)) then
+		return packet
+	end
+	buffer.writeu8(packet, 2, blockIndex)
+	buffer.writei16(packet, 3, x)
+	buffer.writei16(packet, 5, y)
+	buffer.writei16(packet, 7, z)
+	return packet
+end
+
+function Module.decode(packet: buffer): Ghost
+	local blockIndex = buffer.readu8(packet, 2)
+	local cell = nil
+	if blockIndex ~= HIDDEN then
+		cell = Vector3.new(
+			toStud(buffer.readi16(packet, 3)),
+			toStud(buffer.readi16(packet, 5)),
+			toStud(buffer.readi16(packet, 7))
+		)
+	end
+	return {
+		Sequence = buffer.readu16(packet, 0),
+		BlockIndex = blockIndex,
+		Cell = cell,
+	}
+end
+
+--[[
+	Checks a packet that came from a client. Every i16 is a legal cell, so
+	only the length and the block index can be wrong.
+]]
+function Module.isValid(packet: buffer): boolean
+	if buffer.len(packet) ~= SIZE then
+		return false
+	end
+	return buffer.readu8(packet, 2) <= #BlockTypes.List
+end
+
+--[[
+	Whether a sequence number came after the last one seen. Unreliable remotes
+	can deliver out of order, and the u16 wraps around about once an hour at
+	the full send rate.
+]]
+function Module.isNewer(sequence: number, lastSequence: number): boolean
+	local distance = (sequence - lastSequence) % SEQUENCE_RANGE
+	return distance ~= 0 and distance < SEQUENCE_RANGE / 2
+end
+
+return Module
