index 0000000..8cba3a3
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/GhostCodec.luau
@@ -0,0 +1,171 @@
+--!strict
+--[[
+	Packs ghost preview updates into buffers. A ghost is a block type index (0 when hidden)
+	and a grid cell given as whole-number cell indices, which fit in 16-bit integers.
+]]
+
+const BlockTypes = require("./BlockTypes")
+
+const HIDDEN = 0
+const CELL_LIMIT = 32767
+-- u32 sequence, u8 block type, 3 x i16 cell
+const CLIENT_STATE_SIZE = 11
+-- u32 server tick
+const BATCH_HEADER_SIZE = 4
+-- f64 user id, u8 block type, 3 x i16 cell
+const BATCH_ENTRY_SIZE = 15
+-- Keeps each batch under the 1,000-byte UnreliableRemoteEvent payload limit.
+const MAX_ENTRIES_PER_BATCH = 60
+
+export type GhostState = {
+	-- Index into BlockTypes.List, or 0 when the ghost is hidden.
+	BlockTypeIndex: number,
+	-- Whole-number cell indices. Ignored while hidden.
+	Cell: Vector3,
+}
+
+export type BatchEntry = {
+	UserId: number,
+	State: GhostState,
+}
+
+const indexByName: { [string]: number? } = {}
+for index, blockType in BlockTypes.List do
+	indexByName[blockType.Name] = index
+end
+
+const GhostCodec = {}
+
+-- Shortest time, in seconds, between two ghost updates from a client and between two batches
+-- from the server.
+GhostCodec.SendInterval = 1 / 20
+
+GhostCodec.Hidden = table.freeze({
+	BlockTypeIndex = HIDDEN,
+	Cell = Vector3.zero,
+}) :: GhostState
+
+function GhostCodec.getBlockTypeIndex(name: string): number?
+	return indexByName[name]
+end
+
+--[[
+	Returns the indices of the grid cell holding the position, or nil when the cell is too far
+	from the origin to encode.
+]]
+function GhostCodec.toCell(position: Vector3): Vector3?
+	const size = BlockTypes.BlockSize
+	const cell = Vector3.new(
+		math.floor(position.X / size),
+		math.floor(position.Y / size),
+		math.floor(position.Z / size)
+	)
+	if math.max(math.abs(cell.X), math.abs(cell.Y), math.abs(cell.Z)) > CELL_LIMIT then
+		return nil
+	end
+	return cell
+end
+
+function GhostCodec.getCellCenter(cell: Vector3): Vector3
+	const size = BlockTypes.BlockSize
+	return cell * size + Vector3.one * (size / 2)
+end
+
+function GhostCodec.isHidden(state: GhostState): boolean
+	return state.BlockTypeIndex == HIDDEN
+end
+
+function GhostCodec.isSameState(a: GhostState, b: GhostState): boolean
+	if a.BlockTypeIndex ~= b.BlockTypeIndex then
+		return false
+	end
+	return a.BlockTypeIndex == HIDDEN or a.Cell == b.Cell
+end
+
+local function writeState(data: buffer, offset: number, state: GhostState)
+	buffer.writeu8(data, offset, state.BlockTypeIndex)
+	buffer.writei16(data, offset + 1, state.Cell.X)
+	buffer.writei16(data, offset + 3, state.Cell.Y)
+	buffer.writei16(data, offset + 5, state.Cell.Z)
+end
+
+local function readState(data: buffer, offset: number): GhostState?
+	const blockTypeIndex = buffer.readu8(data, offset)
+	if blockTypeIndex == HIDDEN then
+		return GhostCodec.Hidden
+	end
+	if not BlockTypes.List[blockTypeIndex] then
+		return nil
+	end
+	return {
+		BlockTypeIndex = blockTypeIndex,
+		Cell = Vector3.new(
+			buffer.readi16(data, offset + 1),
+			buffer.readi16(data, offset + 3),
+			buffer.readi16(data, offset + 5)
+		),
+	}
+end
+
+function GhostCodec.encodeClientState(sequence: number, state: GhostState): buffer
+	const data = buffer.create(CLIENT_STATE_SIZE)
+	buffer.writeu32(data, 0, sequence)
+	writeState(data, 4, state)
+	return data
+end
+
+--[[
+	Reads an update sent by a client. Returns nil for both values when the data is not a
+	well-formed update.
+]]
+function GhostCodec.decodeClientState(data: unknown): (number?, GhostState?)
+	if typeof(data) ~= "buffer" or buffer.len(data) ~= CLIENT_STATE_SIZE then
+		return nil, nil
+	end
+	const state = readState(data, 4)
+	if not state then
+		return nil, nil
+	end
+	return buffer.readu32(data, 0), state
+end
+
+--[[
+	Packs entries into as few batches as the payload limit allows. Every batch carries the
+	tick, so a client can ignore an entry older than one it already applied.
+]]
+function GhostCodec.encodeBatches(tick: number, entries: { BatchEntry }): { buffer }
+	const batches = {}
+	for first = 1, #entries, MAX_ENTRIES_PER_BATCH do
+		const last = math.min(first + MAX_ENTRIES_PER_BATCH - 1, #entries)
+		const data = buffer.create(BATCH_HEADER_SIZE + (last - first + 1) * BATCH_ENTRY_SIZE)
+		buffer.writeu32(data, 0, tick)
+		local offset = BATCH_HEADER_SIZE
+		for index = first, last do
+			const entry = entries[index]
+			buffer.writef64(data, offset, entry.UserId)
+			writeState(data, offset + 8, entry.State)
+			offset += BATCH_ENTRY_SIZE
+		end
+		table.insert(batches, data)
+	end
+	return batches
+end
+
+function GhostCodec.decodeBatch(data: buffer): (number, { BatchEntry })
+	const entries = {}
+	const tick = buffer.readu32(data, 0)
+	const count = (buffer.len(data) - BATCH_HEADER_SIZE) // BATCH_ENTRY_SIZE
+	for index = 0, count - 1 do
+		const offset = BATCH_HEADER_SIZE + index * BATCH_ENTRY_SIZE
+		const state = readState(data, offset + 8)
+		if state then
+			table.insert(entries, {
+				UserId = buffer.readf64(data, offset),
+				State = state,
+			})
+		end
+	end
+	return tick, entries
+end
+
+return table.freeze(GhostCodec)
