+
+	if not cell then
+		ghost.Target = nil
+		ghost.Part.Transparency = 1
+		return
+	end
+	local isFarJump = (cell - ghost.Part.Position).Magnitude > SNAP_DISTANCE
+	if not ghost.Target or isFarJump then
+		ghost.Part.CFrame = CFrame.new(cell)
+	end
+	ghost.Target = cell
+	ghost.Part.Transparency = GhostNetwork.Transparency
+end
+
+local function onGhostBatch(batch: { any })
+	for index = 1, #batch, 3 do
+		local userId = batch[index]
+		local typeIndex = batch[index + 1]
+		local cell = batch[index + 2]
+		if userId == localPlayer.UserId then
+			continue
+		end
+		if typeof(userId) ~= "number" or typeof(typeIndex) ~= "number" then
+			continue
+		end
+		if BlockTypes.List[typeIndex] == nil then
+			continue
+		end
+		applyRemoteGhost(userId, typeIndex, if typeof(cell) == "Vector3" then cell else nil)
+	end
+end
+
+local function glideRemoteGhosts(deltaTime: number)
+	local alpha = 1 - math.exp(-GLIDE_RATE * deltaTime)
+	for _, ghost in remoteGhosts do
+		local target = ghost.Target
+		if not target then
+			continue
+		end
+		local position = ghost.Part.Position
+		if position == target then
+			continue
+		end
+
+		local nextPosition = position:Lerp(target, alpha)
+		if (target - nextPosition).Magnitude < 0.01 then
+			nextPosition = target
+		end
+		ghost.Part.CFrame = CFrame.new(nextPosition)
+	end
+end
+
+ghostUpdate.OnClientEvent:Connect(onGhostBatch)
+ghostSnapshot.OnClientEvent:Connect(onGhostBatch)
+ghostSnapshot:FireServer()
+
+Players.PlayerRemoving:Connect(function(player: Player)
+	local ghost = remoteGhosts[player.UserId]
+	if ghost then
+		ghost.Part:Destroy()
+		remoteGhosts[player.UserId] = nil
+	end
+end)
+
+RunService.RenderStepped:Connect(function(deltaTime: number)
+	updateOwnGhost()
+	glideRemoteGhosts(deltaTime)
 end)
