@@ -0,0 +1,36 @@
+--!strict
+--[[
+	Settings the ghost preview client and server share. A ghost state is a block
+	type index into BlockTypes.List and a cell center, or no cell while the ghost
+	is hidden.
+]]
+
+local BlockTypes = require("./BlockTypes")
+
+local BLOCK_SIZE = BlockTypes.BlockSize
+
+local GhostNetwork = {
+	-- Shortest time between two ghost updates from one sender, in seconds.
+	UpdateInterval = 0.05,
+	-- Updates are unreliable, so they can drop or arrive out of order. An
+	-- unchanged state is sent again SettleDelay after it last changed, then
+	-- every RefreshInterval, so a lost update heals without a sequence number.
+	SettleDelay = 0.3,
+	RefreshInterval = 2,
+	-- About 31 bytes per ghost keeps a batch under the 1,000 byte limit on
+	-- unreliable payloads.
+	MaxGhostsPerBatch = 24,
+	Transparency = 0.6,
+}
+
+-- Keep in sync with snapToCell in BlockPlacement.server, so ghosts sit in the
+-- cell a click places into.
+local function snapAxis(value: number): number
+	return math.floor(value / BLOCK_SIZE) * BLOCK_SIZE + BLOCK_SIZE / 2
+end
+
+function GhostNetwork.snapToCell(position: Vector3): Vector3
+	return Vector3.new(snapAxis(position.X), snapAxis(position.Y), snapAxis(position.Z))
+end
+
+return table.freeze(GhostNetwork)
