+--------------------------------------------------------------------------------
+-- Block tracking
+--------------------------------------------------------------------------------
+
+type BlockRecord = {
+	name: string,
+	-- Order the block was added in. Ties in hover distance go to the earlier block, as they did
+	-- when blocks were scanned in GetChildren order.
+	order: number,
+	-- Set only for BaseParts, the only blocks that can be hovered.
+	cell: Vector3?,
+	position: Vector3?,
+}
+
+local counts: { [string]: number } = {}
+for _, blockType in BlockTypes.List do
+	counts[blockType.Name] = 0
+end
+local totalCount = 0
+local nextOrder = 0
+
+local records: { [Instance]: BlockRecord } = {}
+-- Cell coordinates (in cells, not studs) to the BaseParts whose centers are in that cell.
+local cells: { [Vector3]: { BasePart } } = {}
+
+-- Set when the counts change; the panel text is rebuilt on the next frame.
+local countsDirty = true
+
+local function cellOf(position: Vector3): Vector3
+	return Vector3.new(
+		math.floor(position.X / CELL_SIZE),
+		math.floor(position.Y / CELL_SIZE),
+		math.floor(position.Z / CELL_SIZE)
+	)
+end
+
+local function onBlockAdded(child: Instance)
+	if records[child] then
+		return
+	end
+
+	nextOrder += 1
+	local record: BlockRecord = {
+		name = child.Name,
+		order = nextOrder,
+		cell = nil,
+		position = nil,
+	}
+
+	if child:IsA("BasePart") then
+		local position = child.Position
+		local cell = cellOf(position)
+		record.position = position
+		record.cell = cell
+		local bucket = cells[cell]
+		if bucket then
+			table.insert(bucket, child)
+		else
+			cells[cell] = { child }
+		end
+	end
+
+	records[child] = record
+	totalCount += 1
+	if counts[record.name] then
+		counts[record.name] += 1
+	end
+	countsDirty = true
+end
+
+local function onBlockRemoved(child: Instance)
+	local record = records[child]
+	if not record then
+		return
+	end
+	records[child] = nil
+
+	local cell = record.cell
+	if cell then
+		local bucket = cells[cell]
+		if bucket then
+			local index = table.find(bucket, child :: BasePart)
+			if index then
+				-- Order within a bucket doesn't matter; ties are settled by record.order.
+				local last = #bucket
+				bucket[index] = bucket[last]
+				bucket[last] = nil
+			end
+			if #bucket == 0 then
+				cells[cell] = nil
+			end
+		end
+	end
+
+	totalCount -= 1
+	if counts[record.name] then
+		counts[record.name] -= 1
+	end
+	countsDirty = true
+end
+
+blocksFolder.ChildAdded:Connect(onBlockAdded)
+blocksFolder.ChildRemoved:Connect(onBlockRemoved)
+for _, child in blocksFolder:GetChildren() do
+	onBlockAdded(child)
+end
+
+--------------------------------------------------------------------------------
+-- Hover
+--------------------------------------------------------------------------------
+
+local raycastParams = RaycastParams.new()
+raycastParams.FilterType = Enum.RaycastFilterType.Exclude
+
+local function updateRaycastFilter()
+	local character = localPlayer.Character
+	raycastParams.FilterDescendantsInstances = if character then { character } else {}
+end
+
+updateRaycastFilter()
+localPlayer.CharacterAdded:Connect(updateRaycastFilter)
+localPlayer.CharacterRemoving:Connect(function()
+	-- Character is still set while CharacterRemoving fires, so clear the filter after it changes.
+	task.defer(updateRaycastFilter)
+end)
