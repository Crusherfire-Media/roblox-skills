+-- Block counts, kept up to date as children come and go.
+
+local counts: { [string]: number } = {}
+for _, blockType in BlockTypes.List do
+	counts[blockType.Name] = 0
+end
+-- Every child of the folder, block or not, as the old "Total" counted them all.
+local totalChildren = 0
+-- The name each child was counted under, so removal undoes exactly what adding did.
+local countedName: { [Instance]: string } = {}
+local countsText = ""
+local countsDirty = true
+
+local function onChildAdded(child: Instance)
+	if countedName[child] ~= nil then
+		return
+	end
+	local name = child.Name
+	countedName[child] = name
+	totalChildren += 1
+	if counts[name] then
+		counts[name] += 1
+	end
+	countsDirty = true
+end
+
+local function onChildRemoved(child: Instance)
+	local name = countedName[child]
+	if name == nil then
+		return
+	end
+	countedName[child] = nil
+	totalChildren -= 1
+	if counts[name] then
+		counts[name] -= 1
+	end
+	countsDirty = true
+end
+
+blocksFolder.ChildAdded:Connect(onChildAdded)
+blocksFolder.ChildRemoved:Connect(onChildRemoved)
+for _, child in blocksFolder:GetChildren() do
+	onChildAdded(child)
+end
+
+local function rebuildCountsText()
+	local lines = table.create(#BlockTypes.List + 1)
+	for _, blockType in BlockTypes.List do
+		table.insert(lines, blockType.DisplayName .. ": " .. counts[blockType.Name])
+	end
+	table.insert(lines, "Total: " .. totalChildren)
+	countsText = table.concat(lines, "\n")
+	countsDirty = false
+end
