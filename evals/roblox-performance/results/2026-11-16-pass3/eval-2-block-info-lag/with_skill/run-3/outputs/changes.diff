+
+local function onChildAdded(child: Instance)
+	if countedNameByChild[child] then
+		return
+	end
+	local name = child.Name
+	countedNameByChild[child] = name
+	childCount += 1
+	if countsByName[name] then
+		countsByName[name] += 1
+	end
+	isTextDirty = true
+end
+
+local function onChildRemoved(child: Instance)
+	local name = countedNameByChild[child]
+	if not name then
+		return
+	end
+	countedNameByChild[child] = nil
+	childCount -= 1
+	if countsByName[name] then
+		countsByName[name] -= 1
+	end
+	isTextDirty = true
+end
