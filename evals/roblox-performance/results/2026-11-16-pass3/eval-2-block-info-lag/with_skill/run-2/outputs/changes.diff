+local raycastParams = RaycastParams.new()
+raycastParams.FilterType = Enum.RaycastFilterType.Exclude
+local filteredCharacter: Model? = nil
+
+local countsByName: { [string]: number? } = {}
+for _, blockType in BlockTypes.List do
+	countsByName[blockType.Name] = 0
+end
+local totalCount = 0
+local isTracked: { [Instance]: boolean? } = {}
+
+local blocksByCell: { [Vector3]: { BasePart }? } = {}
+local cellByBlock: { [BasePart]: Vector3? } = {}
+-- When each block joined the folder. Ties in hover distance go to the block that joined first,
+-- as they did when the folder's children were scanned in order.
+local joinOrderByBlock: { [BasePart]: number? } = {}
+local nextJoinOrder = 0
+
+local hoveredBlock: BasePart? = nil
+local isTextStale = true
+
+local function getCell(position: Vector3): Vector3
+	return Vector3.new(
+		math.floor(position.X / CELL_SIZE),
+		math.floor(position.Y / CELL_SIZE),
+		math.floor(position.Z / CELL_SIZE)
+	)
+end
+
+local function onChildAdded(child: Instance)
+	if isTracked[child] then
+		return
+	end
+	isTracked[child] = true
+	totalCount += 1
+	local count = countsByName[child.Name]
+	if count then
+		countsByName[child.Name] = count + 1
+	end
+	isTextStale = true
+
+	if child:IsA("BasePart") then
+		-- Placed blocks are anchored and never move, so their cell is read once here.
+		local cell = getCell(child.Position)
+		local blocks = blocksByCell[cell]
+		if blocks then
+			table.insert(blocks, child)
+		else
+			blocksByCell[cell] = { child }
+		end
+		cellByBlock[child] = cell
+		nextJoinOrder += 1
+		joinOrderByBlock[child] = nextJoinOrder
+	end
+end
+
+local function onChildRemoved(child: Instance)
+	if not isTracked[child] then
+		return
+	end
+	isTracked[child] = nil
+	totalCount -= 1
+	local count = countsByName[child.Name]
+	if count then
+		countsByName[child.Name] = count - 1
+	end
+	isTextStale = true
+
+	if child:IsA("BasePart") then
+		local cell = cellByBlock[child]
+		local blocks = if cell then blocksByCell[cell] else nil
+		if cell and blocks then
+			local index = table.find(blocks, child)
+			if index then
+				table.remove(blocks, index)
+			end
+			if #blocks == 0 then
+				blocksByCell[cell] = nil
+			end
+		end
+		cellByBlock[child] = nil
+		joinOrderByBlock[child] = nil
+	end
+end
+
