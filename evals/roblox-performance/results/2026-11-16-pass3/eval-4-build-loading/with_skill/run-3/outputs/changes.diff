+local function stepLoad(plot: Plot, allowance: number): (number, boolean)
+	local savedBlocks = plot.SavedBlocks
+	local cells = plot.Cells
+	local ownerId = plot.Owner.UserId
+	local used = 0
+	local index = plot.NextIndex
+	while index <= #savedBlocks do
+		if used >= allowance then
+			plot.NextIndex = index
+			return used, false
+		end
+		local cell = cells[index]
+		if cell then
+			local savedBlock = savedBlocks[index]
+			local blockType = BlockTypes.ByName[savedBlock.Type]
+			createBlock(plot.Folder, blockType, cell, ownerId, savedBlock.PlacedAt)
+			used += 1
