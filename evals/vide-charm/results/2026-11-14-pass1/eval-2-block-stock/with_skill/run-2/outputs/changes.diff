+--!strict
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local StarterPlayer = game:GetService("StarterPlayer")
+
+local BlockPicker = require(StarterPlayer.StarterPlayerScripts.BlockPicker)
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local UILabs = require(ReplicatedStorage.Packages.UILabs)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local source = Vide.source
+
+local CONTROLS = {
+	Stock = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Count for every block type except the first, which uses FirstCount.
+			Count = UILabs.Ordered(UILabs.Slider(20, 0, 999, 1), 1),
+			FirstCount = UILabs.Ordered(UILabs.Slider(0, 0, 999, 1), 2),
+		}),
+		1
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Stock: {
+			Count: () -> number,
+			FirstCount: () -> number,
+		},
+	},
+}
+
+local function story(props: StoryProps)
+	local stockControls = props.controls.Stock
+	local selected = source(BlockTypes.List[1].Name)
+
+	return BlockPicker({
+		Selected = selected,
+		Select = selected,
+		Stock = function()
+			local stock = {}
+			for index, blockType in BlockTypes.List do
+				stock[blockType.Name] = if index == 1
+					then stockControls.FirstCount()
+					else stockControls.Count()
+			end
+			return stock
+		end,
+	})
+end
+
+return {
+	summary = "The block hotbar with per-type stock counts, including empty block types.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
