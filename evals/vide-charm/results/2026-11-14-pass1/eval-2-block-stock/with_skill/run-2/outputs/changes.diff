diff --git a/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
new file mode 100644
index 0000000..e7f85e2
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
@@ -0,0 +1,61 @@
+--!strict
+--[[
+	The local player's stock of each block type, kept in a Charm signal and filled from the
+	server's StockChanged remote. A block type the server has not reported yet counts as 0.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Charm = require(ReplicatedStorage.Packages.Charm)
+
+local BlockStock = {}
+
+local getStock, setStock = Charm.signal({} :: { [string]: number? })
+local hasStarted = false
+
+--[[
+	Every block type's count, by block type name. A Charm getter: read it in Charm effects and
+	computed values, or bridge it into Vide with vide-charm.
+]]
+BlockStock.getStock = getStock
+
+--[[
+	How many of a block type the player has. Reads the signal, so it tracks inside Charm
+	effects and computed values.
+]]
+function BlockStock.getCount(name: string): number
+	return getStock()[name] or 0
+end
+
+local function onStockChanged(name: unknown, count: unknown)
+	if typeof(name) ~= "string" or typeof(count) ~= "number" then
+		return
+	end
+	if not BlockTypes.ByName[name] then
+		return
+	end
+
+	setStock(function(stock)
+		local nextStock = table.clone(stock)
+		nextStock[name] = count
+		return nextStock
+	end)
+end
+
+--[[
+	Finds the server's StockChanged remote and starts following it. Yields until the remote
+	exists, so call it after any UI is mounted or from its own thread.
+]]
+function BlockStock.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	local remote = ReplicatedStorage:WaitForChild("StockChanged")
+	assert(remote:IsA("RemoteEvent"), "StockChanged must be a RemoteEvent")
+	remote.OnClientEvent:Connect(onStockChanged)
+end
+
+return BlockStock
