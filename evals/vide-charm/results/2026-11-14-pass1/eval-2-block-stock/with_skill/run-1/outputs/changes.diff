diff --git a/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
new file mode 100644
index 0000000..808597c
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
@@ -0,0 +1,62 @@
+--!strict
+--[[
+	How many of each block type the local player has left, kept in a Charm
+	signal. The server owns the counts and sends each change through the
+	StockChanged remote; this module only mirrors them.
+]]
+
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Charm = require("@game/ReplicatedStorage/Packages/Charm")
+
+export type Stock = { [string]: number? }
+
+local Module = {}
+
+local getStock, setStock = Charm.signal({} :: Stock)
+local hasStarted = false
+
+--[[
+	Block type name to count. A Charm getter: read it in Charm effects and
+	computed values, or bridge it into Vide with vide-charm. A block type the
+	server has not reported yet is missing.
+]]
+Module.getStock = getStock
+
+--[[
+	The local player's count of one block type, or 0 before the server has
+	reported it.
+]]
+function Module:GetCount(blockTypeName: string): number
+	return getStock()[blockTypeName] or 0
+end
+
+local function onStockChanged(blockTypeName: unknown, count: unknown)
+	if typeof(blockTypeName) ~= "string" or typeof(count) ~= "number" then
+		return
+	end
+
+	setStock(function(stock)
+		local nextStock = table.clone(stock)
+		nextStock[blockTypeName] = count
+		return nextStock
+	end)
+end
+
+--[[
+	Starts mirroring the server's counts. Yields until the StockChanged remote
+	exists. Counts the server sent before this runs are queued by the remote
+	and arrive once it connects.
+]]
+function Module:StartAsync()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	const remote = ReplicatedStorage:WaitForChild("StockChanged")
+	assert(remote:IsA("RemoteEvent"), "StockChanged must be a RemoteEvent")
+	remote.OnClientEvent:Connect(onStockChanged)
+end
+
+return Module
