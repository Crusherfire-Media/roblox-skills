@@ -0,0 +1,60 @@
+--!strict
+
+const BlockPicker = require("@game/StarterPlayer/StarterPlayerScripts/BlockPicker")
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const source = Vide.source
+
+const STARTING_STOCK = 20
+
+local stockControls: { [string]: any } = {
+	-- Off shows the hotbar before the server has sent any counts.
+	IsReported = UILabs.Ordered(true, 1),
+}
+for index, blockType in BlockTypes.List do
+	stockControls[blockType.Name] =
+		UILabs.Ordered(UILabs.Slider(STARTING_STOCK, 0, 999, 1), index + 1)
+end
+
+const CONTROLS = {
+	Stock = UILabs.Ordered(UILabs.ControlGroup(stockControls), 1),
+}
+
+type StoryProps = {
+	controls: {
+		Stock: { [string]: () -> any },
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const stockControl = props.controls.Stock
+	const selected = source(BlockTypes.List[1].Name)
+
+	return BlockPicker({
+		Selected = selected,
+		Stock = function(): BlockPicker.Stock
+			if not stockControl.IsReported() then
+				return {}
+			end
+
+			local stock = {}
+			for _, blockType in BlockTypes.List do
+				stock[blockType.Name] = stockControl[blockType.Name]()
+			end
+			return stock
+		end,
+		Select = function(name: string)
+			selected(name)
+		end,
+	})
+end
+
+return {
+	summary = "The hotbar with per-tile counts, empty tiles, and the selected count.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
