diff --git a/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
new file mode 100644
index 0000000..4032bd4
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
@@ -0,0 +1,51 @@
+--!strict
+--[[
+	The local player's stock of each block type, kept in a Charm signal. The
+	server owns the counts and sends every change through StockChanged.
+]]
+
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Charm = require("@game/ReplicatedStorage/Packages/Charm")
+
+type Stock = { [string]: number? }
+
+local Module = {}
+
+local getStock, setStock = Charm.signal({} :: Stock)
+local hasStarted = false
+
+--[[
+	Counts by block type name, as a Charm getter. A block type the server has
+	not reported yet has no entry.
+]]
+Module.getStock = getStock
+
+function Module:GetCount(name: string): number
+	return getStock()[name] or 0
+end
+
+local function onStockChanged(name: string, count: number)
+	setStock(function(stock)
+		local nextStock = table.clone(stock)
+		nextStock[name] = count
+		return nextStock
+	end)
+end
+
+--[[
+	Listens to StockChanged. Yields until the remote exists; the counts the
+	server sends on join wait in the remote's queue until then.
+]]
+function Module:StartAsync()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	const remote = ReplicatedStorage:WaitForChild("StockChanged")
+	assert(remote:IsA("RemoteEvent"), "StockChanged must be a RemoteEvent")
+	remote.OnClientEvent:Connect(onStockChanged)
+end
+
+return Module
