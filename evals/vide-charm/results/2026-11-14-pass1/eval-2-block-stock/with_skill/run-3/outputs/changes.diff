+--!strict
+const BlockPicker = require("@game/StarterPlayer/StarterPlayerScripts/BlockPicker")
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const source = Vide.source
+
+const STARTING_STOCK = 20
+
+local stockControls = {}
+for index, blockType in BlockTypes.List do
+	stockControls[blockType.Name] = UILabs.Ordered(UILabs.Slider(STARTING_STOCK, 0, 99, 1), index)
+end
+
+const CONTROLS = {
+	-- Counts by block type; drag one to 0 to see its tile gray out.
+	Stock = UILabs.Ordered(UILabs.ControlGroup(stockControls), 1),
+}
+
+type StoryProps = {
+	controls: {
+		Stock: { [string]: () -> number },
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const selected = source(BlockTypes.List[1].Name)
+
+	return BlockPicker({
+		Selected = selected,
+		Select = selected,
+		Stock = function()
+			local stock = {}
+			for name, count in props.controls.Stock do
+				stock[name] = count()
+			end
+			return stock
+		end,
+	})
+end
+
+return {
+	summary = "The hotbar with a count on each tile and the selected block type's count above it.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
