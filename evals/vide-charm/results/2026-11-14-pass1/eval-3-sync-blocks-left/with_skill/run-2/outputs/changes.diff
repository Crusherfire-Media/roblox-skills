diff --git a/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau b/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau
new file mode 100644
index 0000000..de2a6e2
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau
@@ -0,0 +1,54 @@
+--!strict
+--[[
+	The local player's PlayerData, kept in step with the server through
+	CharmSync. Read-only on the client: the server overwrites any local change
+	with its next patch.
+]]
+
+const Players = game:GetService("Players")
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Charm = require("@game/ReplicatedStorage/Packages/Charm")
+const CharmSync = require("@game/ReplicatedStorage/Packages/CharmSync")
+
+const PlayerDataSync = require("@game/ReplicatedStorage/Shared/PlayerDataSync")
+
+type PlayerData = PlayerDataSync.PlayerData
+
+const Module = {}
+
+local getData, setData = Charm.signal(PlayerDataSync.DefaultData)
+local hasStarted = false
+
+--[[
+	Returns the local player's data. Reactive: Charm effects and Vide's
+	useSignalState follow it.
+]]
+function Module.getData(): PlayerData
+	return getData()
+end
+
+--[[
+	Starts syncing from the server. Yields until the server's remote exists, so
+	call it from its own thread.
+]]
+function Module:StartAsync()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	const remote = ReplicatedStorage:WaitForChild(PlayerDataSync.RemoteName)
+	assert(remote:IsA("RemoteEvent"), "PlayerDataSync must be a RemoteEvent")
+
+	CharmSync.client.addSignals({
+		[PlayerDataSync.getSyncKey(Players.LocalPlayer.UserId)] = setData,
+	})
+	remote.OnClientEvent:Connect(function(payloads: { CharmSync.SyncPayload })
+		CharmSync.client.patch(payloads)
+	end)
+	-- Fired after connecting, so the first payload is not missed.
+	remote:FireServer()
+end
+
+return Module
