diff --git a/src/ServerScriptService/PlayerData.luau b/src/ServerScriptService/PlayerData.luau
new file mode 100644
index 0000000..a357a5e
--- /dev/null
+++ b/src/ServerScriptService/PlayerData.luau
@@ -0,0 +1,104 @@
+--!strict
+--[[
+	Owns each player's PlayerData on the server and syncs it to that player's
+	client through CharmSync. The client fires the PlayerDataSync remote once it
+	is listening, and the server sends its data from then on.
+]]
+
+const Players = game:GetService("Players")
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Charm = require("@game/ReplicatedStorage/Packages/Charm")
+const CharmSync = require("@game/ReplicatedStorage/Packages/CharmSync")
+
+const PlayerDataSync = require("@game/ReplicatedStorage/Shared/PlayerDataSync")
+
+type PlayerData = PlayerDataSync.PlayerData
+
+const Module = {}
+
+local getAllData, setAllData = Charm.signal({} :: { [Player]: PlayerData? })
+local syncedPlayers: { [Player]: boolean? } = {}
+local hasStarted = false
+
+local function setPlayerData(player: Player, data: PlayerData?)
+	setAllData(function(allData)
+		local nextAllData = table.clone(allData)
+		nextAllData[player] = data
+		return nextAllData
+	end)
+end
+
+local function onPlayerAdded(player: Player)
+	if getAllData()[player] then
+		return
+	end
+	setPlayerData(player, PlayerDataSync.DefaultData)
+end
+
+local function onPlayerRemoving(player: Player)
+	CharmSync.server.removeClient(player)
+	syncedPlayers[player] = nil
+	setPlayerData(player, nil)
+end
+
+local function onClientReady(player: Player)
+	-- A second registration would build a new computed under the same key,
+	-- which CharmSync warns about.
+	if syncedPlayers[player] or not getAllData()[player] then
+		return
+	end
+	syncedPlayers[player] = true
+
+	CharmSync.server.addSignalsToClient(player, {
+		[PlayerDataSync.getSyncKey(player.UserId)] = Charm.computed(function()
+			return getAllData()[player]
+		end),
+	})
+end
+
+--[[
+	Returns the player's current data, or nil before they join or after they
+	leave.
+]]
+function Module.getData(player: Player): PlayerData?
+	return getAllData()[player]
+end
+
+--[[
+	Replaces the player's data with what `updater` returns. The data table is
+	frozen, so `updater` returns a changed copy. Returns false when the player
+	has no data.
+]]
+function Module:Update(player: Player, updater: (data: PlayerData) -> PlayerData): boolean
+	const data = getAllData()[player]
+	if not data then
+		return false
+	end
+	setPlayerData(player, updater(data))
+	return true
+end
+
+function Module:Start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	const remote = Instance.new("RemoteEvent")
+	remote.Name = PlayerDataSync.RemoteName
+	remote.Parent = ReplicatedStorage
+
+	CharmSync.server.connect(function(player: Player, payloads)
+		remote:FireClient(player, payloads)
+	end)
+
+	remote.OnServerEvent:Connect(onClientReady)
+	Players.PlayerAdded:Connect(onPlayerAdded)
+	Players.PlayerRemoving:Connect(onPlayerRemoving)
+	for _, player in Players:GetPlayers() do
+		onPlayerAdded(player)
+	end
+end
+
+return Module
