new file mode 100644
index 0000000..0b3b9e2
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/PlayerDataSync.luau
@@ -0,0 +1,29 @@
+--!strict
+--[[
+	The per-player data the server syncs to each client through CharmSync.
+	To sync another value, add a field to PlayerData and DefaultData.
+]]
+
+export type PlayerData = {
+	BlocksLeft: number,
+}
+
+const Module = {}
+
+-- The client shows this until the first sync arrives, so it must match what
+-- the server gives a new player.
+Module.DefaultData = table.freeze({
+	BlocksLeft = 50,
+}) :: PlayerData
+
+Module.RemoteName = "PlayerDataSync"
+
+--[[
+	The CharmSync key for one player's data. CharmSync shares one signal per
+	key across every client that syncs it, so each player needs their own key.
+]]
+function Module.getSyncKey(userId: number): string
+	return `PlayerData-{userId}`
+end
+
+return table.freeze(Module)
