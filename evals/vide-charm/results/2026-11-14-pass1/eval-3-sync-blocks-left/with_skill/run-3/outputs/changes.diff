diff --git a/src/ServerScriptService/PlayerData.luau b/src/ServerScriptService/PlayerData.luau
new file mode 100644
index 0000000..ba564c4
--- /dev/null
+++ b/src/ServerScriptService/PlayerData.luau
@@ -0,0 +1,112 @@
+--!strict
+--[[
+	Owns each player's PlayerData on the server, in one Charm signal per player, and syncs it
+	to that player's client with CharmSync. Other server code reads and changes it only through
+	this module.
+]]
+
+const Players = game:GetService("Players")
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Charm = require("@game/ReplicatedStorage/Packages/Charm")
+const CharmSync = require("@game/ReplicatedStorage/Packages/CharmSync")
+const PlayerDataSync = require("@game/ReplicatedStorage/Shared/PlayerDataSync")
+
+const MAX_BLOCKS_PER_PLAYER = 50
+
+type PlayerData = PlayerDataSync.PlayerData
+
+type PlayerState = {
+	Get: Charm.Getter<PlayerData>,
+	Set: Charm.Setter<PlayerData>,
+}
+
+const Module = {}
+
+local states: { [Player]: PlayerState? } = {}
+local hasStarted = false
+
+local function createDefaultData(): PlayerData
+	return {
+		BlocksLeft = MAX_BLOCKS_PER_PLAYER,
+	}
+end
+
+local function onPlayerAdded(player: Player)
+	if states[player] then
+		return
+	end
+
+	const get, set = Charm.signal(createDefaultData())
+	states[player] = {
+		Get = get,
+		Set = set,
+	}
+end
+
+local function onPlayerRemoving(player: Player)
+	CharmSync.server.removeClient(player)
+	states[player] = nil
+end
+
+local function onClientReady(player: Player)
+	const state = states[player]
+	if not state then
+		return
+	end
+
+	-- Safe to repeat: a key the client already has is not sent again.
+	CharmSync.server.addSignalsToClient(player, {
+		[PlayerDataSync.getSyncKey(player)] = state.Get,
+	})
+end
+
+--[[
+	Returns the player's current data, or nil when the player has left.
+]]
+function Module:Get(player: Player): PlayerData?
+	const state = states[player]
+	return if state then state.Get() else nil
+end
+
+--[[
+	Replaces the player's data with what updater returns, and syncs the change to their client.
+	The data table is frozen in Studio, so updater must return a new table, not edit the one it
+	receives. Does nothing when the player has left.
+]]
+function Module:Update(player: Player, updater: (data: PlayerData) -> PlayerData)
+	const state = states[player]
+	if not state then
+		return
+	end
+
+	state.Set(updater)
+end
+
+--[[
+	Creates the sync remote and starts tracking players. Call once, from the server's entry
+	script, before players can place blocks.
+]]
+function Module:Start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	const remote = Instance.new("RemoteEvent")
+	remote.Name = PlayerDataSync.RemoteName
+	remote.Parent = ReplicatedStorage
+
+	CharmSync.server.connect(function(player: Player, payloads: { CharmSync.SyncPayload })
+		remote:FireClient(player, payloads)
+	end)
+	remote.OnServerEvent:Connect(onClientReady)
+
+	Players.PlayerAdded:Connect(onPlayerAdded)
+	Players.PlayerRemoving:Connect(onPlayerRemoving)
+	for _, player in Players:GetPlayers() do
+		onPlayerAdded(player)
+	end
+end
+
+return Module
