+	-- 0 shows the empty state.
+	BlocksLeft = UILabs.Ordered(UILabs.Slider(50, 0, 50, 1), 1),
+	-- Off stands for the moment before the server's first sync, when the label hides.
+	IsSynced = UILabs.Ordered(true, 2),
+}
+
+type StoryProps = {
+	controls: {
+		BlocksLeft: () -> number,
+		IsSynced: () -> boolean,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	return BlocksLeftLabel({
+		BlocksLeft = function()
+			return if props.controls.IsSynced() then props.controls.BlocksLeft() else nil
