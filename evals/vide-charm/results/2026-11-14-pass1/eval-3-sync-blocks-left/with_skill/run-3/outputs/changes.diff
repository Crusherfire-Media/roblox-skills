--- /dev/null
+++ b/src/ReplicatedStorage/Shared/PlayerDataSync.luau
@@ -0,0 +1,24 @@
+--!strict
+--[[
+	The per-player data the server syncs to each player with CharmSync, shared by the server's
+	and the client's PlayerData modules. To sync another value, add a field to PlayerData and
+	give it a starting value in createDefaultData in ServerScriptService.PlayerData.
+]]
+
+export type PlayerData = {
+	BlocksLeft: number,
+}
+
+local Module = {}
+
+-- The client fires this remote once to ask for its data; the server sends payloads back on it.
+Module.RemoteName = "PlayerDataSync"
+
+--[[
+	CharmSync keys name one signal for every client, so each player's data needs its own key.
+]]
+function Module.getSyncKey(player: Player): string
+	return `PlayerData-{player.UserId}`
+end
+
+return Module
