new file mode 100644
index 0000000..cf5ba1b
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau
@@ -0,0 +1,65 @@
+--!strict
+--[[
+	A pill that shows how many more blocks the player may place, for the top of the hotbar.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const create = Vide.create
+const read = Vide.read
+
+const HEIGHT = 28
+const HORIZONTAL_PADDING = 12
+const TEXT_SIZE = 18
+const PANEL_COLOR = Color3.fromRGB(28, 28, 34)
+const TEXT_COLOR = Color3.fromRGB(255, 255, 255)
+const EMPTY_TEXT_COLOR = Color3.fromRGB(255, 110, 100)
+const FONT = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
+
+export type BlocksLeftLabelProps = {
+	-- nil until the server's first sync arrives, which hides the label.
+	BlocksLeft: (number | () -> number?)?,
+	LayoutOrder: number?,
+}
+
+local function formatBlocksLeft(blocksLeft: number): string
+	if blocksLeft <= 0 then
+		return "No blocks left"
+	elseif blocksLeft == 1 then
+		return "1 block left"
+	else
+		return `{blocksLeft} blocks left`
+	end
+end
+
+local function blocksLeftLabel(props: BlocksLeftLabelProps): TextLabel
+	return create("TextLabel")({
+		Name = "BlocksLeft",
+		LayoutOrder = props.LayoutOrder,
+		AutomaticSize = Enum.AutomaticSize.X,
+		Size = UDim2.fromOffset(0, HEIGHT),
+		BackgroundColor3 = PANEL_COLOR,
+		BackgroundTransparency = 0.2,
+		FontFace = FONT,
+		TextSize = TEXT_SIZE,
+		Visible = function()
+			return read(props.BlocksLeft) ~= nil
+		end,
+		Text = function()
+			const blocksLeft = read(props.BlocksLeft)
+			return if blocksLeft then formatBlocksLeft(blocksLeft) else ""
+		end,
+		TextColor3 = function()
+			const blocksLeft = read(props.BlocksLeft)
+			return if blocksLeft and blocksLeft <= 0 then EMPTY_TEXT_COLOR else TEXT_COLOR
+		end,
+
+		create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+		create("UIPadding")({
+			PaddingLeft = UDim.new(0, HORIZONTAL_PADDING),
+			PaddingRight = UDim.new(0, HORIZONTAL_PADDING),
+		}),
+	})
+end
+
+return blocksLeftLabel
