diff --git a/src/ReplicatedStorage/Shared/PlayerDataSync.luau b/src/ReplicatedStorage/Shared/PlayerDataSync.luau
new file mode 100644
index 0000000..f52fcf5
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/PlayerDataSync.luau
@@ -0,0 +1,28 @@
+--[[
+	The per-player data the server syncs to each player through CharmSync, shared so both sides
+	agree on its shape, its sync key, and the remotes it travels on.
+
+	To sync another value, add a field to PlayerData and give it a starting value in
+	ServerScriptService.PlayerData. The client receives it with no other changes.
+]]
+
+export type PlayerData = {
+	-- How many more blocks the player may place in this server.
+	BlocksLeft: number,
+}
+
+local PlayerDataSync = {
+	-- Server to client: CharmSync payloads.
+	SyncRemoteName = "PlayerDataSync",
+	-- Client to server: the client is listening and wants its first payload.
+	ReadyRemoteName = "PlayerDataReady",
+}
+
+--[[
+	A CharmSync key names one signal for every client, so each player's data needs its own key.
+]]
+function PlayerDataSync.keyFor(userId: number): string
+	return `PlayerData-{userId}`
+end
+
+return table.freeze(PlayerDataSync)
