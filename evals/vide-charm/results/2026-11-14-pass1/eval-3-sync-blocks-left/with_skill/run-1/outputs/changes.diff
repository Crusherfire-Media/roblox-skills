+for index, blockType in BlockTypes.List do
+	blockNames[index] = blockType.Name
+end
+
+local CONTROLS = {
+	BlocksLeft = UILabs.Ordered(UILabs.Slider(50, 0, 50, 1), 1),
+	-- Off shows the hotbar before the server's first sync, with the count hidden.
+	IsSynced = UILabs.Ordered(true, 2),
+	Selected = UILabs.Ordered(UILabs.Choose(blockNames), 3),
+}
+
+type StoryProps = {
+	controls: {
+		BlocksLeft: () -> number,
+		IsSynced: () -> boolean,
+		Selected: () -> string,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local controls = props.controls
+
+	return Hotbar({
+		BlocksLeft = function()
+			return if controls.IsSynced() then controls.BlocksLeft() else nil
+		end,
+		Selected = controls.Selected,
+		Select = function(name: string)
+			print(`Selected {name}`)
+		end,
+	})
+end
+
+return {
+	summary = "The blocks-left count above the block picker, at every count and before sync.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
