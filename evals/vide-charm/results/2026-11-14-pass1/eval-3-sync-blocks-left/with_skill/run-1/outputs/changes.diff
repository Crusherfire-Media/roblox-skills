diff --git a/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau b/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau
new file mode 100644
index 0000000..8397b5b
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau
@@ -0,0 +1,51 @@
+--[[
+	The local player's data, kept in a Charm signal that CharmSync fills from the server. Read it
+	with getData (bridge it into Vide UI with useSignalState); never set it, since the server's next
+	patch overwrites any client-side change.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local PlayerDataSync = require(ReplicatedStorage.Shared.PlayerDataSync)
+
+type PlayerData = PlayerDataSync.PlayerData
+
+local PlayerData = {}
+
+local getData, setData = Charm.signal(nil :: PlayerData?)
+local hasStarted = false
+
+--[[
+	Returns the local player's data, frozen, or nil until the server's first payload arrives.
+]]
+PlayerData.getData = getData :: () -> PlayerData?
+
+--[[
+	Starts receiving data from the server. Yields until the server's remotes exist, so call it after
+	any UI is mounted or from its own thread.
+]]
+function PlayerData.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	local syncRemote = ReplicatedStorage:WaitForChild(PlayerDataSync.SyncRemoteName)
+	assert(syncRemote:IsA("RemoteEvent"), "PlayerDataSync must be a RemoteEvent")
+	local readyRemote = ReplicatedStorage:WaitForChild(PlayerDataSync.ReadyRemoteName)
+	assert(readyRemote:IsA("RemoteEvent"), "PlayerDataReady must be a RemoteEvent")
+
+	CharmSync.client.addSignals({
+		[PlayerDataSync.keyFor(Players.LocalPlayer.UserId)] = setData,
+	})
+	syncRemote.OnClientEvent:Connect(function(payloads: { CharmSync.SyncPayload })
+		CharmSync.client.patch(payloads)
+	end)
+	-- Fired after connecting, so the first payload is not missed.
+	readyRemote:FireServer()
+end
+
+return PlayerData
