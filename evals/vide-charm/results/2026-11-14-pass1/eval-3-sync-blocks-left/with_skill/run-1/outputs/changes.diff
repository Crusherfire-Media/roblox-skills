diff --git a/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau b/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau
new file mode 100644
index 0000000..703121d
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau
@@ -0,0 +1,58 @@
+--[[
+	A pill showing how many more blocks the player may place. It turns red at zero.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local create = Vide.create
+
+local TEXT_SIZE = 20
+local PADDING_X = 12
+local PADDING_Y = 4
+local PANEL_COLOR = Color3.fromRGB(28, 28, 34)
+local TEXT_COLOR = Color3.fromRGB(255, 255, 255)
+local EMPTY_COLOR = Color3.fromRGB(255, 90, 90)
+
+export type BlocksLeftLabelProps = {
+	-- nil until the server's first sync, and the label stays hidden until then.
+	BlocksLeft: () -> number?,
+	LayoutOrder: number?,
+}
+
+local function formatBlocksLeft(count: number): string
+	return if count == 1 then "1 block left" else `{count} blocks left`
+end
+
+local function blocksLeftLabel(props: BlocksLeftLabelProps): TextLabel
+	return create("TextLabel")({
+		Name = "BlocksLeft",
+		LayoutOrder = props.LayoutOrder,
+		AutomaticSize = Enum.AutomaticSize.XY,
+		BackgroundColor3 = PANEL_COLOR,
+		BackgroundTransparency = 0.2,
+		FontFace = Font.fromEnum(Enum.Font.BuilderSansBold),
+		TextSize = TEXT_SIZE,
+		Visible = function()
+			return props.BlocksLeft() ~= nil
+		end,
+		Text = function()
+			local count = props.BlocksLeft()
+			return if count then formatBlocksLeft(count) else ""
+		end,
+		TextColor3 = function()
+			return if props.BlocksLeft() == 0 then EMPTY_COLOR else TEXT_COLOR
+		end,
+
+		create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+		create("UIPadding")({
+			PaddingLeft = UDim.new(0, PADDING_X),
+			PaddingRight = UDim.new(0, PADDING_X),
+			PaddingTop = UDim.new(0, PADDING_Y),
+			PaddingBottom = UDim.new(0, PADDING_Y),
+		}),
+	})
+end
+
+return blocksLeftLabel
