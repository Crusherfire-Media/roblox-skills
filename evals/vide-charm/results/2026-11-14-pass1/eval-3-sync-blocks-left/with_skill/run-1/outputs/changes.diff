diff --git a/src/ServerScriptService/PlayerData.luau b/src/ServerScriptService/PlayerData.luau
new file mode 100644
index 0000000..08bb343
--- /dev/null
+++ b/src/ServerScriptService/PlayerData.luau
@@ -0,0 +1,75 @@
+--[[
+	Owns each player's synced data on the server, in one Charm signal. Server code reads it with
+	getData and changes it with update; PlayerDataReplication sends every change to its player.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+local PlayerDataSync = require(ReplicatedStorage.Shared.PlayerDataSync)
+
+type PlayerData = PlayerDataSync.PlayerData
+
+-- How many blocks one player may place in a server.
+local MAX_BLOCKS_PER_PLAYER = 50
+
+local PlayerData = {}
+
+local getAllData, setAllData = Charm.signal({} :: { [Player]: PlayerData? })
+
+local function createData(): PlayerData
+	return {
+		BlocksLeft = MAX_BLOCKS_PER_PLAYER,
+	}
+end
+
+--[[
+	Returns the player's data, frozen, or nil before addPlayer and after removePlayer. Inside a
+	Charm computed or effect, the read is tracked.
+]]
+function PlayerData.getData(player: Player): PlayerData?
+	return getAllData()[player]
+end
+
+--[[
+	Gives the player fresh data. Does nothing when the player already has data.
+]]
+function PlayerData.addPlayer(player: Player)
+	setAllData(function(allData)
+		if allData[player] then
+			return allData
+		end
+		local nextAllData = table.clone(allData)
+		nextAllData[player] = createData()
+		return nextAllData
+	end)
+end
+
+function PlayerData.removePlayer(player: Player)
+	setAllData(function(allData)
+		if not allData[player] then
+			return allData
+		end
+		local nextAllData = table.clone(allData)
+		nextAllData[player] = nil
+		return nextAllData
+	end)
+end
+
+--[[
+	Replaces the player's data with what updater returns. The data passed in is frozen, so return
+	a changed copy. Does nothing for a player with no data.
+]]
+function PlayerData.update(player: Player, updater: (data: PlayerData) -> PlayerData)
+	setAllData(function(allData)
+		local data = allData[player]
+		if not data then
+			return allData
+		end
+		local nextAllData = table.clone(allData)
+		nextAllData[player] = updater(data)
+		return nextAllData
+	end)
+end
+
+return PlayerData
diff --git a/src/ServerScriptService/PlayerDataReplication.server.luau b/src/ServerScriptService/PlayerDataReplication.server.luau
new file mode 100644
index 0000000..852ff50
--- /dev/null
+++ b/src/ServerScriptService/PlayerDataReplication.server.luau
@@ -0,0 +1,57 @@
+--[[
+	Sends each player their own PlayerData through CharmSync. Once a client fires the ready remote,
+	it gets its full data on the next frame and only the changes after that.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local PlayerData = require(script.Parent.PlayerData)
+local PlayerDataSync = require(ReplicatedStorage.Shared.PlayerDataSync)
+
+local syncRemote = Instance.new("RemoteEvent")
+syncRemote.Name = PlayerDataSync.SyncRemoteName
+syncRemote.Parent = ReplicatedStorage
+
+local readyRemote = Instance.new("RemoteEvent")
+readyRemote.Name = PlayerDataSync.ReadyRemoteName
+readyRemote.Parent = ReplicatedStorage
+
+local syncedPlayers: { [Player]: true? } = {}
+
+local function onPlayerAdded(player: Player)
+	PlayerData.addPlayer(player)
+end
+
+local function onPlayerRemoving(player: Player)
+	syncedPlayers[player] = nil
+	CharmSync.server.removeClient(player)
+	PlayerData.removePlayer(player)
+end
+
+local function onClientReady(player: Player)
+	-- Subscribing the same key again with a new computed makes CharmSync warn.
+	if syncedPlayers[player] or not PlayerData.getData(player) then
+		return
+	end
+	syncedPlayers[player] = true
+
+	CharmSync.server.addSignalsToClient(player, {
+		[PlayerDataSync.keyFor(player.UserId)] = Charm.computed(function()
+			return PlayerData.getData(player)
+		end),
+	})
+end
+
+CharmSync.server.connect(function(player: Player, payloads: { CharmSync.SyncPayload })
+	syncRemote:FireClient(player, payloads)
+end)
+
+readyRemote.OnServerEvent:Connect(onClientReady)
+Players.PlayerAdded:Connect(onPlayerAdded)
+Players.PlayerRemoving:Connect(onPlayerRemoving)
+for _, player in Players:GetPlayers() do
+	onPlayerAdded(player)
+end
