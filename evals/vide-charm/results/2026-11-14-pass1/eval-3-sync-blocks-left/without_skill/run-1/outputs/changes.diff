diff --git a/src/ServerScriptService/PlayerStateServer.luau b/src/ServerScriptService/PlayerStateServer.luau
new file mode 100644
index 0000000..dc251a0
--- /dev/null
+++ b/src/ServerScriptService/PlayerStateServer.luau
@@ -0,0 +1,82 @@
+--[[
+	Server side of per-player state (see ReplicatedStorage.Shared.PlayerState). Holds each player's
+	state in a Charm signal and syncs it to that player's client with CharmSync. This is the source
+	of truth: clients only ever receive the state.
+
+	Requiring this module creates the sync RemoteEvent and starts syncing.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local PlayerState = require(ReplicatedStorage.Shared.PlayerState)
+
+type PlayerState = PlayerState.PlayerState
+
+type Entry = {
+	get: Charm.Getter<PlayerState>,
+	set: Charm.Setter<PlayerState>,
+}
+
+local PlayerStateServer = {}
+
+local entries: { [Player]: Entry } = {}
+
+local syncRemote = Instance.new("RemoteEvent")
+syncRemote.Name = PlayerState.RemoteName
+syncRemote.Parent = ReplicatedStorage
+
+local function entryFor(player: Player): Entry
+	local entry = entries[player]
+	if not entry then
+		local get, set = Charm.signal(PlayerState.Default)
+		entry = { get = get, set = set }
+		-- Remote events can arrive after a player has left. Their state is gone by then, so hand
+		-- back a throwaway entry rather than storing one that nothing would clean up.
+		if player.Parent == Players then
+			entries[player] = entry
+		end
+	end
+	return entry
+end
+
+--[[
+	Returns the player's current state. Don't mutate it; use update instead.
+]]
+function PlayerStateServer.get(player: Player): PlayerState
+	return entryFor(player).get()
+end
+
+--[[
+	Changes the player's state. The updater receives a shallow copy of the current state to change
+	in place, and the changes are synced to the player's client.
+]]
+function PlayerStateServer.update(player: Player, updater: (state: PlayerState) -> ())
+	entryFor(player).set(function(current: PlayerState): PlayerState
+		local nextState = table.clone(current)
+		updater(nextState)
+		return nextState
+	end)
+end
+
+syncRemote.OnServerEvent:Connect(function(player: Player)
+	if player.Parent ~= Players then
+		return
+	end
+	CharmSync.server.addSignalsToClient(player, {
+		[PlayerState.syncKey(player.UserId)] = entryFor(player).get,
+	})
+end)
+
+Players.PlayerRemoving:Connect(function(player: Player)
+	CharmSync.server.removeClient(player)
+	entries[player] = nil
+end)
+
+CharmSync.server.connect(function(player: Player, payloads: { CharmSync.SyncPayload })
+	syncRemote:FireClient(player, payloads)
+end)
+
+return PlayerStateServer
