diff --git a/src/StarterPlayer/StarterPlayerScripts/BlocksLeft.luau b/src/StarterPlayer/StarterPlayerScripts/BlocksLeft.luau
new file mode 100644
index 0000000..7576f74
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlocksLeft.luau
@@ -0,0 +1,47 @@
+--[[
+	A line of text just above the hotbar saying how many more blocks the player may place. Hidden
+	while the count is unknown.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local HotbarLayout = require(script.Parent.HotbarLayout)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local create = Vide.create
+
+-- Space between the top of the hotbar and the bottom of the text.
+local GAP = 6
+local TEXT_SIZE = 20
+local TEXT_COLOR = Color3.fromRGB(255, 255, 255)
+local STROKE_COLOR = Color3.fromRGB(28, 28, 34)
+
+export type BlocksLeftProps = {
+	-- The number of blocks left, or nil while it isn't known yet.
+	Count: () -> number?,
+}
+
+local function blocksLeft(props: BlocksLeftProps): TextLabel
+	return create("TextLabel")({
+		Name = "BlocksLeft",
+		AnchorPoint = Vector2.new(0.5, 1),
+		Position = UDim2.new(0.5, 0, 1, -(HotbarLayout.BottomMargin + HotbarLayout.Height + GAP)),
+		Size = UDim2.fromOffset(200, TEXT_SIZE),
+		BackgroundTransparency = 1,
+		Font = Enum.Font.GothamBold,
+		TextSize = TEXT_SIZE,
+		TextColor3 = TEXT_COLOR,
+		TextStrokeColor3 = STROKE_COLOR,
+		TextStrokeTransparency = 0.4,
+
+		Visible = function()
+			return props.Count() ~= nil
+		end,
+		Text = function()
+			local count = props.Count() or 0
+			return if count == 1 then "1 block left" else `{count} blocks left`
+		end,
+	})
+end
+
+return blocksLeft
