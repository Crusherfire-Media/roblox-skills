diff --git a/src/StarterPlayer/StarterPlayerScripts/PlayerStateClient.luau b/src/StarterPlayer/StarterPlayerScripts/PlayerStateClient.luau
new file mode 100644
index 0000000..b4f4d68
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/PlayerStateClient.luau
@@ -0,0 +1,51 @@
+--[[
+	Client side of per-player state (see ReplicatedStorage.Shared.PlayerState): a Charm signal that
+	mirrors the local player's state on the server. It is nil until the server's first sync
+	arrives. Read it with PlayerStateClient.get, which works in Charm effects and, through
+	VideCharm.useSignalState, in Vide UI.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local PlayerState = require(ReplicatedStorage.Shared.PlayerState)
+
+type PlayerState = PlayerState.PlayerState
+
+local PlayerStateClient = {}
+
+local getState, setState = Charm.signal(nil :: PlayerState?)
+local hasStarted = false
+
+--[[
+	Returns the local player's state, or nil before the server has sent it.
+]]
+PlayerStateClient.get = getState
+
+--[[
+	Starts receiving state from the server. Yields until the sync remote exists, so call it after
+	any UI is mounted or from its own thread.
+]]
+function PlayerStateClient.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	CharmSync.client.addSignals({
+		[PlayerState.syncKey(Players.LocalPlayer.UserId)] = setState,
+	})
+
+	local remote = ReplicatedStorage:WaitForChild(PlayerState.RemoteName)
+	assert(remote:IsA("RemoteEvent"), `{PlayerState.RemoteName} must be a RemoteEvent`)
+
+	remote.OnClientEvent:Connect(function(payloads: { CharmSync.SyncPayload })
+		CharmSync.client.patch(payloads)
+	end)
+	-- Tell the server we're listening; it then sends the full state, followed by changes.
+	remote:FireServer()
+end
+
+return PlayerStateClient
