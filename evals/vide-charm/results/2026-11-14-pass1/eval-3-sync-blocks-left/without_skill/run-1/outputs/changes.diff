+	TileSize = TILE_SIZE,
+	TileGap = 8,
+	TileRadius = 8,
+	PanelPadding = PANEL_PADDING,
+	-- Gap between the bottom of the screen and the bottom of the hotbar.
+	BottomMargin = 24,
+	-- Height of the hotbar panel, including its padding.
+	Height = TILE_SIZE + PANEL_PADDING * 2,
+})
