diff --git a/src/ReplicatedStorage/Shared/PlayerState.luau b/src/ReplicatedStorage/Shared/PlayerState.luau
new file mode 100644
index 0000000..b7db8e0
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/PlayerState.luau
@@ -0,0 +1,36 @@
+--[[
+	Per-player state that the server owns and syncs to that player's client with CharmSync. The
+	server keeps one Charm signal holding a PlayerState per player (see PlayerStateServer in
+	ServerScriptService), and the client mirrors its own (see PlayerStateClient in
+	StarterPlayerScripts).
+
+	To sync another per-player value, add a field to PlayerState and a starting value to Default.
+	Server code changes it with PlayerStateServer.update, and client code reads it from
+	PlayerStateClient.get. Values must be things a RemoteEvent can carry.
+]]
+
+export type PlayerState = {
+	-- How many more blocks the player may place in this server.
+	blocksLeft: number,
+}
+
+local PlayerState = {}
+
+-- Starting state for a player who just joined.
+PlayerState.Default = table.freeze({
+	blocksLeft = 0,
+}) :: PlayerState
+
+-- Name of the RemoteEvent in ReplicatedStorage that carries sync payloads. The client fires it
+-- once, with no arguments, when it is ready to receive them.
+PlayerState.RemoteName = "PlayerStateSync"
+
+--[[
+	The CharmSync key for one player's state. Keys must be unique per player, because the server
+	syncs a different signal for each player.
+]]
+function PlayerState.syncKey(userId: number): string
+	return `playerState-{userId}`
+end
+
+return table.freeze(PlayerState)
