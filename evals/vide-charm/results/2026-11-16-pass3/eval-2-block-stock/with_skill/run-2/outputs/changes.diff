diff --git a/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
new file mode 100644
index 0000000..6ee1805
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
@@ -0,0 +1,59 @@
+--!strict
+--[[
+	The local player's stock of each block type, as the server reports it
+	through the StockChanged remote. The server owns the counts; this module
+	only mirrors them.
+]]
+
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Charm = require("@game/ReplicatedStorage/Packages/Charm")
+
+const Module = {}
+
+-- A block type is missing until the server has sent its count.
+local getStock, setStock = Charm.signal({} :: { [string]: number? })
+local hasStarted = false
+
+--[[
+	Block type name to count. A Charm getter: read it in Charm effects and
+	computed values, or bridge it into Vide with vide-charm.
+]]
+Module.getStock = getStock
+
+--[[
+	How many of a block type the player has, or nil before the server has
+	said.
+]]
+function Module.getCount(name: string): number?
+	return getStock()[name]
+end
+
+local function onStockChanged(name: unknown, count: unknown)
+	if typeof(name) ~= "string" or typeof(count) ~= "number" then
+		return
+	end
+
+	setStock(function(stock)
+		const nextStock = table.clone(stock)
+		nextStock[name] = count
+		return nextStock
+	end)
+end
+
+--[[
+	Listens for the server's StockChanged remote. Yields until the remote
+	exists, so call it after any UI is mounted or from its own thread.
+]]
+function Module.startAsync(): ()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	const remote = ReplicatedStorage:WaitForChild("StockChanged")
+	assert(remote:IsA("RemoteEvent"), "StockChanged must be a RemoteEvent")
+	remote.OnClientEvent:Connect(onStockChanged)
+end
+
+return Module
