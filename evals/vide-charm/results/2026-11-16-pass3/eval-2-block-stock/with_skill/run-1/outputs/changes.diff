diff --git a/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
new file mode 100644
index 0000000..40258db
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
@@ -0,0 +1,60 @@
+--!strict
+--[[
+	The player's stock of each block type, as the server reports it through the StockChanged
+	remote. Held in a Charm signal that only the server's updates change.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Charm = require(ReplicatedStorage.Packages.Charm)
+
+local BlockStock = {}
+
+local getStock, setStock = Charm.signal({} :: { [string]: number? })
+local hasStarted = false
+
+--[[
+	Counts by block type name, missing for a block type the server has not reported yet. A Charm
+	getter: read it in Charm effects and computed values, or bridge it into Vide with vide-charm.
+]]
+BlockStock.getStock = getStock
+
+--[[
+	How many of a block type the player has, counting a block type not reported yet as none.
+]]
+function BlockStock.getCount(name: string): number
+	return getStock()[name] or 0
+end
+
+local function onStockChanged(blockTypeName: unknown, count: unknown)
+	if typeof(blockTypeName) ~= "string" or typeof(count) ~= "number" then
+		return
+	end
+	if not BlockTypes.ByName[blockTypeName] then
+		return
+	end
+
+	setStock(function(stock)
+		local nextStock = table.clone(stock)
+		nextStock[blockTypeName] = count
+		return nextStock
+	end)
+end
+
+--[[
+	Listens for the server's StockChanged remote. Yields until the remote exists; updates the
+	server fired before then are queued by Roblox and arrive once this connects.
+]]
+function BlockStock.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	local remote = ReplicatedStorage:WaitForChild("StockChanged")
+	assert(remote:IsA("RemoteEvent"), "StockChanged must be a RemoteEvent")
+	remote.OnClientEvent:Connect(onStockChanged)
+end
+
+return BlockStock
