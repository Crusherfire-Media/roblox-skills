+--!strict
+
+local BlockPicker = require("@game/StarterPlayer/StarterPlayerScripts/BlockPicker")
+local BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+local UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local effect = Vide.effect
+local source = Vide.source
+
+local STARTING_STOCK = 20
+local MAX_STOCK = 99
+
+local blockNames = {}
+local stockControls = {}
+for index, blockType in BlockTypes.List do
+	table.insert(blockNames, blockType.Name)
+	stockControls[blockType.Name] =
+		UILabs.Ordered(UILabs.Slider(STARTING_STOCK, 0, MAX_STOCK, 1), index)
+end
+
+local CONTROLS = {
+	Selection = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Tile clicks change the selection too.
+			Block = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+		}),
+		1
+	),
+	-- Counts per block type; 0 grays the tile out.
+	Stock = UILabs.Ordered(UILabs.ControlGroup(stockControls), 2),
+}
+
+type StoryProps = {
+	controls: {
+		Selection: {
+			Block: () -> string,
+		},
+		Stock: { [string]: () -> number },
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local controls = props.controls
+
+	local selected = source(controls.Selection.Block())
+	effect(function()
+		selected(controls.Selection.Block())
+	end)
+
+	return BlockPicker({
+		Selected = selected,
+		Stock = function()
+			local stock = {}
+			for name, count in controls.Stock do
+				stock[name] = count()
+			end
+			return stock
+		end,
+		Select = function(name: string)
+			selected(name)
+		end,
+	})
+end
+
+return {
+	summary = "The hotbar with each block type's stock, the selected type's count, and empty tiles.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
