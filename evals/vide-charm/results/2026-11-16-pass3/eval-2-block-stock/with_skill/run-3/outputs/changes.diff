diff --git a/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
new file mode 100644
index 0000000..7928ef0
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
@@ -0,0 +1,58 @@
+--!strict
+--[[
+	The local player's stock of each block type, as the server reports it
+	through the StockChanged remote. The server owns the counts; this module only
+	mirrors them in a Charm signal for the client to read.
+]]
+
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Charm = require("@game/ReplicatedStorage/Packages/Charm")
+
+export type Stock = { [string]: number? }
+
+const Module = {}
+
+const getStock, setStock = Charm.signal({} :: Stock)
+local hasStarted = false
+
+--[[
+	Block type names mapped to how many the player has left. A Charm getter: read
+	it in Charm effects and computed values, or bridge it into Vide with
+	vide-charm. A block type the server has not reported yet is missing.
+]]
+Module.getStock = getStock
+
+function Module:GetCount(blockTypeName: string): number
+	return getStock()[blockTypeName] or 0
+end
+
+local function onStockChanged(blockTypeName: unknown, count: unknown)
+	if typeof(blockTypeName) ~= "string" or typeof(count) ~= "number" then
+		return
+	end
+
+	setStock(function(stock)
+		const nextStock = table.clone(stock)
+		nextStock[blockTypeName] = count
+		return nextStock
+	end)
+end
+
+--[[
+	Listens for stock updates from the server. Yields until the StockChanged
+	remote exists. Updates the server sent before this runs are queued by Roblox
+	and arrive once the listener connects.
+]]
+function Module:StartAsync()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	const remote = ReplicatedStorage:WaitForChild("StockChanged")
+	assert(remote:IsA("RemoteEvent"), "StockChanged must be a RemoteEvent")
+	remote.OnClientEvent:Connect(onStockChanged)
+end
+
+return Module
