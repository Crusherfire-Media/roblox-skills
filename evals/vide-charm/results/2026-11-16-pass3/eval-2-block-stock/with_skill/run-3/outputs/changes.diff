@@ -0,0 +1,64 @@
+--!strict
+const BlockPicker = require("@game/StarterPlayer/StarterPlayerScripts/BlockPicker")
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const effect = Vide.effect
+const source = Vide.source
+
+const STARTING_STOCK = 20
+const MAX_STOCK = 99
+
+const blockNames = {}
+const stockControls = {}
+for index, blockType in BlockTypes.List do
+	blockNames[index] = blockType.Name
+	stockControls[blockType.Name] =
+		UILabs.Ordered(UILabs.Slider(STARTING_STOCK, 0, MAX_STOCK, 1), index)
+end
+
+const CONTROLS = {
+	Selected = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+	-- How many of each block type are left. At 0 the tile grays out.
+	Stock = UILabs.Ordered(UILabs.ControlGroup(stockControls), 2),
+}
+
+type StoryProps = {
+	controls: {
+		Selected: () -> string,
+		Stock: { [string]: () -> number },
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const controls = props.controls
+
+	-- Both the control and tile clicks change the selection.
+	const selected = source(controls.Selected())
+	effect(function()
+		selected(controls.Selected())
+	end)
+
+	return BlockPicker({
+		Selected = selected,
+		Stock = function()
+			const stock = {}
+			for name, count in controls.Stock do
+				stock[name] = count()
+			end
+			return stock
+		end,
+		Select = function(name: string)
+			selected(name)
+		end,
+	})
+end
+
+return {
+	summary = "The block hotbar, with each block type's stock and the selected type's count.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
