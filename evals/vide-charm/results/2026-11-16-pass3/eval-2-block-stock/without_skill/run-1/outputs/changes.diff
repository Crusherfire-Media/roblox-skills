diff --git a/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
new file mode 100644
index 0000000..96ea0cd
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
@@ -0,0 +1,67 @@
+--[[
+	The local player's stock of each block type, kept in a Charm signal. The server owns the real
+	counts and fires StockChanged(blockTypeName, count) whenever one changes, including once per
+	block type when the player joins; this module mirrors them.
+
+	A block type with no count yet (before the server's first update arrives) is missing from
+	the table, so callers can tell "unknown" apart from "none left".
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Charm = require(ReplicatedStorage.Packages.Charm)
+
+export type Stock = { [string]: number }
+
+local BlockStock = {}
+
+local getStock, setStock = Charm.signal({} :: Stock)
+local hasStarted = false
+
+--[[
+	Every known count, keyed by block type name. A Charm getter: read it in Charm effects and
+	computed values, or bridge it into Vide with vide-charm. The table is replaced, never mutated,
+	when a count changes.
+]]
+BlockStock.getStock = getStock
+
+--[[
+	How many of the block type the player has, or nil if the server hasn't said yet. Reading it
+	inside a Charm effect or computed value subscribes to the stock.
+]]
+function BlockStock.getCount(name: string): number?
+	return getStock()[name]
+end
+
+local function onStockChanged(name: unknown, count: unknown)
+	if typeof(name) ~= "string" or typeof(count) ~= "number" or not BlockTypes.ByName[name] then
+		return
+	end
+
+	setStock(function(stock)
+		if stock[name] == count then
+			return stock
+		end
+		local nextStock = table.clone(stock)
+		nextStock[name] = count
+		return nextStock
+	end)
+end
+
+--[[
+	Listens to the server's StockChanged remote. Yields until the remote exists. Updates the
+	server fires before this connects are queued by Roblox and delivered once it does.
+]]
+function BlockStock.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	local remote = ReplicatedStorage:WaitForChild("StockChanged")
+	assert(remote:IsA("RemoteEvent"), "StockChanged must be a RemoteEvent")
+	remote.OnClientEvent:Connect(onStockChanged)
+end
+
+return BlockStock
