+++ b/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau
@@ -0,0 +1,54 @@
+--!strict
+--[[
+	A pill that tells the player how many more blocks they can place. The text
+	turns red at zero.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const create = Vide.create
+
+const TEXT_SIZE = 18
+const PADDING_X = 12
+const PADDING_Y = 4
+const FONT = Font.fromEnum(Enum.Font.BuilderSansBold)
+const PANEL_COLOR = Color3.fromRGB(28, 28, 34)
+const TEXT_COLOR = Color3.fromRGB(255, 255, 255)
+const EMPTY_COLOR = Color3.fromRGB(255, 110, 90)
+
+export type BlocksLeftLabelProps = {
+	BlocksLeft: () -> number,
+	LayoutOrder: number?,
+}
+
+local function formatBlocksLeft(count: number): string
+	return if count == 1 then "1 block left" else `{count} blocks left`
+end
+
+local function blocksLeftLabel(props: BlocksLeftLabelProps): TextLabel
+	return create("TextLabel")({
+		Name = "BlocksLeft",
+		LayoutOrder = props.LayoutOrder,
+		AutomaticSize = Enum.AutomaticSize.XY,
+		BackgroundColor3 = PANEL_COLOR,
+		BackgroundTransparency = 0.2,
+		FontFace = FONT,
+		TextSize = TEXT_SIZE,
+		Text = function()
+			return formatBlocksLeft(props.BlocksLeft())
+		end,
+		TextColor3 = function()
+			return if props.BlocksLeft() > 0 then TEXT_COLOR else EMPTY_COLOR
+		end,
+
+		create("UICorner")({ CornerRadius = UDim.new(1, 0) }),
+		create("UIPadding")({
+			PaddingLeft = UDim.new(0, PADDING_X),
+			PaddingRight = UDim.new(0, PADDING_X),
+			PaddingTop = UDim.new(0, PADDING_Y),
+			PaddingBottom = UDim.new(0, PADDING_Y),
+		}),
+	})
+end
+
+return blocksLeftLabel
