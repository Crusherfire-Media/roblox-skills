diff --git a/src/StarterPlayer/StarterPlayerScripts/PlayerState.luau b/src/StarterPlayer/StarterPlayerScripts/PlayerState.luau
new file mode 100644
index 0000000..4fc47f8
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/PlayerState.luau
@@ -0,0 +1,46 @@
+--!strict
+--[[
+	The local player's PlayerState, a Charm signal that CharmSync fills from the
+	server. Read it with getState; only the server changes it, since the next
+	sync would overwrite a client-side write.
+]]
+
+const Players = game:GetService("Players")
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Charm = require("@game/ReplicatedStorage/Packages/Charm")
+const CharmSync = require("@game/ReplicatedStorage/Packages/CharmSync")
+
+const PlayerStateSync = require("@game/ReplicatedStorage/Shared/PlayerStateSync")
+
+local Module = {}
+
+local getState, setState = Charm.signal(PlayerStateSync.DefaultState)
+local hasStarted = false
+
+Module.getState = getState
+
+--[[
+	Starts receiving the local player's state from the server. Yields until the
+	server's remote exists, so call it after the UI is mounted.
+]]
+function Module:StartAsync()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	CharmSync.client.addSignals({
+		[PlayerStateSync.getKey(Players.LocalPlayer.UserId)] = setState,
+	})
+
+	const remote = ReplicatedStorage:WaitForChild(PlayerStateSync.RemoteName)
+	assert(remote:IsA("RemoteEvent"), "PlayerStateSync must be a RemoteEvent")
+
+	remote.OnClientEvent:Connect(function(payloads)
+		CharmSync.client.patch(payloads)
+	end)
+	remote:FireServer()
+end
+
+return Module
