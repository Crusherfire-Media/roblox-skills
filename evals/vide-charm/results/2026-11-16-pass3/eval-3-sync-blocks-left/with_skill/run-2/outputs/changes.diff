new file mode 100644
index 0000000..1ad7e50
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/PlayerStateSync.luau
@@ -0,0 +1,33 @@
+--!strict
+--[[
+	The per-player state the server syncs to each player's own client through
+	CharmSync. To sync another value, add a field to PlayerState and a default
+	to DEFAULT_STATE, then set it on the server with PlayerState:Update.
+]]
+
+const BlockTypes = require("./BlockTypes")
+
+export type PlayerState = {
+	BlocksLeft: number,
+}
+
+const DEFAULT_STATE: PlayerState = table.freeze({
+	BlocksLeft = BlockTypes.MaxBlocksPerPlayer,
+})
+
+local Module = {}
+
+-- The client fires this RemoteEvent once it is listening, and the server sends
+-- CharmSync payloads back through it.
+Module.RemoteName = "PlayerStateSync"
+Module.DefaultState = DEFAULT_STATE
+
+--[[
+	The CharmSync key for one player's state. CharmSync warns when one key names
+	different signals, so each player gets their own.
+]]
+function Module.getKey(userId: number): string
+	return `PlayerState-{userId}`
+end
+
+return table.freeze(Module)
