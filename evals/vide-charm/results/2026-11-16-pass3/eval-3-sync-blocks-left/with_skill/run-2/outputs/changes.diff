diff --git a/src/ServerScriptService/PlayerState.luau b/src/ServerScriptService/PlayerState.luau
new file mode 100644
index 0000000..8c5ea37
--- /dev/null
+++ b/src/ServerScriptService/PlayerState.luau
@@ -0,0 +1,64 @@
+--!strict
+--[[
+	Owns every player's PlayerState on the server, in one Charm signal.
+	SyncPlayerState.server.luau sends each player their own state.
+]]
+
+const Players = game:GetService("Players")
+
+const Charm = require("@game/ReplicatedStorage/Packages/Charm")
+
+const PlayerStateSync = require("@game/ReplicatedStorage/Shared/PlayerStateSync")
+
+type PlayerState = PlayerStateSync.PlayerState
+
+local Module = {}
+
+local getStates, setStates = Charm.signal({} :: { [Player]: PlayerState? })
+
+--[[
+	Returns the player's current state, or the defaults if nothing has changed
+	it yet. Reading it inside a Charm computed or effect tracks it.
+]]
+function Module:Get(player: Player): PlayerState
+	return getStates()[player] or PlayerStateSync.DefaultState
+end
+
+--[[
+	Returns a Charm getter that follows the player's state, for CharmSync.
+]]
+function Module:GetSignal(player: Player): () -> PlayerState
+	return Charm.computed(function()
+		return Module:Get(player)
+	end)
+end
+
+--[[
+	Replaces the player's state with what the updater returns. The state is
+	frozen, so the updater returns a changed copy.
+]]
+function Module:Update(player: Player, updater: (state: PlayerState) -> PlayerState)
+	-- Without this, an update after the player left would never be cleared.
+	if player.Parent ~= Players then
+		return
+	end
+
+	setStates(function(states)
+		local nextStates = table.clone(states)
+		nextStates[player] = updater(states[player] or PlayerStateSync.DefaultState)
+		return nextStates
+	end)
+end
+
+Players.PlayerRemoving:Connect(function(player: Player)
+	setStates(function(states)
+		if states[player] == nil then
+			return states
+		end
+		local nextStates = table.clone(states)
+		nextStates[player] = nil
+		return nextStates
+	end)
+end)
+
+return Module
diff --git a/src/ServerScriptService/SyncPlayerState.server.luau b/src/ServerScriptService/SyncPlayerState.server.luau
new file mode 100644
index 0000000..ac2ebb3
--- /dev/null
+++ b/src/ServerScriptService/SyncPlayerState.server.luau
@@ -0,0 +1,42 @@
+--!strict
+--[[
+	Sends each player their own PlayerState through CharmSync. The client fires
+	the remote once it is listening, so the full state it gets on the next sync
+	is never missed.
+]]
+
+const Players = game:GetService("Players")
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const CharmSync = require("@game/ReplicatedStorage/Packages/CharmSync")
+
+const PlayerState = require("./PlayerState")
+const PlayerStateSync = require("@game/ReplicatedStorage/Shared/PlayerStateSync")
+
+local remote = Instance.new("RemoteEvent")
+remote.Name = PlayerStateSync.RemoteName
+remote.Parent = ReplicatedStorage
+
+local syncedPlayers: { [Player]: true? } = {}
+
+local function onClientReady(player: Player)
+	if syncedPlayers[player] or player.Parent ~= Players then
+		return
+	end
+	syncedPlayers[player] = true
+
+	CharmSync.server.addSignalsToClient(player, {
+		[PlayerStateSync.getKey(player.UserId)] = PlayerState:GetSignal(player),
+	})
+end
+
+CharmSync.server.connect(function(player: Player, payloads)
+	remote:FireClient(player, payloads)
+end)
+
+remote.OnServerEvent:Connect(onClientReady)
+
+Players.PlayerRemoving:Connect(function(player: Player)
+	syncedPlayers[player] = nil
+	CharmSync.server.removeClient(player)
+end)
