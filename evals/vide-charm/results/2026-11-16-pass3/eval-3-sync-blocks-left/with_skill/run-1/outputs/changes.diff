diff --git a/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau b/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau
new file mode 100644
index 0000000..92a8150
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau
@@ -0,0 +1,63 @@
+--!strict
+--[[
+	A pill that reads "<n> blocks left", turning red once the player has none left.
+]]
+
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Vide = require(ReplicatedStorage.Packages.Vide)
+
+const create = Vide.create
+const read = Vide.read
+
+const HEIGHT = 32
+const HORIZONTAL_PADDING = 14
+const TEXT_SIZE = 20
+const PANEL_COLOR = Color3.fromRGB(28, 28, 34)
+const TEXT_COLOR = Color3.fromRGB(255, 255, 255)
+const EMPTY_COLOR = Color3.fromRGB(255, 95, 85)
+const FONT = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
+
+export type BlocksLeftLabelProps = {
+	BlocksLeft: number | () -> number,
+	LayoutOrder: number?,
+}
+
+local function blocksLeftLabel(props: BlocksLeftLabelProps): Frame
+	local function isEmpty()
+		return read(props.BlocksLeft) <= 0
+	end
+
+	return create("Frame")({
+		Name = "BlocksLeftLabel",
+		LayoutOrder = props.LayoutOrder,
+		AutomaticSize = Enum.AutomaticSize.X,
+		Size = UDim2.fromOffset(0, HEIGHT),
+		BackgroundColor3 = PANEL_COLOR,
+		BackgroundTransparency = 0.2,
+
+		create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+		create("UIPadding")({
+			PaddingLeft = UDim.new(0, HORIZONTAL_PADDING),
+			PaddingRight = UDim.new(0, HORIZONTAL_PADDING),
+		}),
+
+		create("TextLabel")({
+			Name = "Text",
+			AutomaticSize = Enum.AutomaticSize.X,
+			Size = UDim2.fromScale(0, 1),
+			BackgroundTransparency = 1,
+			FontFace = FONT,
+			TextSize = TEXT_SIZE,
+			TextColor3 = function()
+				return if isEmpty() then EMPTY_COLOR else TEXT_COLOR
+			end,
+			Text = function()
+				const count = read(props.BlocksLeft)
+				return if count == 1 then "1 block left" else `{count} blocks left`
+			end,
+		}),
+	})
+end
+
+return blocksLeftLabel
