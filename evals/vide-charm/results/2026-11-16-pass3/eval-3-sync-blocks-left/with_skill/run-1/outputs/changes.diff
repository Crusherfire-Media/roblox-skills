diff --git a/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau b/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau
new file mode 100644
index 0000000..db71183
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau
@@ -0,0 +1,47 @@
+--!strict
+--[[
+	The local player's synced data (Shared.SyncedPlayerData), filled by the server through
+	CharmSync. Read-only here: the server's next patch overwrites any client-side change.
+]]
+
+const Players = game:GetService("Players")
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Charm = require(ReplicatedStorage.Packages.Charm)
+const CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+
+const SyncedPlayerData = require(ReplicatedStorage.Shared.SyncedPlayerData)
+
+local Module = {}
+
+const getData, setData = Charm.signal(SyncedPlayerData.Default)
+
+Module.getData = getData
+
+local hasStarted = false
+
+--[[
+	Starts receiving the local player's data. Yields until the server's sync remotes exist.
+]]
+function Module.startAsync()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	CharmSync.client.addSignals({
+		[SyncedPlayerData.getSyncKey(Players.LocalPlayer.UserId)] = setData,
+	})
+
+	const syncRemote = ReplicatedStorage:WaitForChild(SyncedPlayerData.SyncRemoteName)
+	assert(syncRemote:IsA("RemoteEvent"), "PlayerData sync remote must be a RemoteEvent")
+	const readyRemote = ReplicatedStorage:WaitForChild(SyncedPlayerData.ReadyRemoteName)
+	assert(readyRemote:IsA("RemoteEvent"), "PlayerData ready remote must be a RemoteEvent")
+
+	syncRemote.OnClientEvent:Connect(function(payloads: { CharmSync.SyncPayload })
+		CharmSync.client.patch(payloads)
+	end)
+	readyRemote:FireServer()
+end
+
+return Module
