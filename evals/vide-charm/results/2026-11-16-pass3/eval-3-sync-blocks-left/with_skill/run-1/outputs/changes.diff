diff --git a/src/ServerScriptService/PlayerData.luau b/src/ServerScriptService/PlayerData.luau
new file mode 100644
index 0000000..a0e589e
--- /dev/null
+++ b/src/ServerScriptService/PlayerData.luau
@@ -0,0 +1,93 @@
+--!strict
+--[[
+	Owns each player's synced data (Shared.SyncedPlayerData) and sends every change to that
+	player's client with CharmSync.
+]]
+
+const Players = game:GetService("Players")
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Charm = require(ReplicatedStorage.Packages.Charm)
+const CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+
+const SyncedPlayerData = require(ReplicatedStorage.Shared.SyncedPlayerData)
+
+type Data = SyncedPlayerData.Data
+
+type PlayerSignal = {
+	Get: Charm.Getter<Data>,
+	Set: Charm.Setter<Data>,
+}
+
+const syncRemote = Instance.new("RemoteEvent")
+syncRemote.Name = SyncedPlayerData.SyncRemoteName
+syncRemote.Parent = ReplicatedStorage
+
+const readyRemote = Instance.new("RemoteEvent")
+readyRemote.Name = SyncedPlayerData.ReadyRemoteName
+readyRemote.Parent = ReplicatedStorage
+
+local Module = {}
+
+local signals: { [Player]: PlayerSignal? } = {}
+
+--[[
+	Returns the player's current data, or nil once the player has left.
+]]
+function Module.get(player: Player): Data?
+	const playerSignal = signals[player]
+	return if playerSignal then playerSignal.Get() else nil
+end
+
+--[[
+	Replaces the player's data with what updater returns. Data tables are frozen, so updater
+	returns a changed copy made with table.clone. Does nothing once the player has left.
+]]
+function Module.update(player: Player, updater: (data: Data) -> Data)
+	const playerSignal = signals[player]
+	if not playerSignal then
+		return
+	end
+	playerSignal.Set(updater)
+end
+
+local function onPlayerAdded(player: Player)
+	if signals[player] then
+		return
+	end
+	const get, set = Charm.signal(SyncedPlayerData.Default)
+	signals[player] = {
+		Get = get,
+		Set = set,
+	}
+end
+
+-- Waiting for the client's ready signal keeps the first payload, which holds the full data,
+-- from arriving before the client listens for it.
+local function onClientReady(player: Player)
+	const playerSignal = signals[player]
+	if not playerSignal then
+		return
+	end
+	CharmSync.server.addSignalsToClient(player, {
+		[SyncedPlayerData.getSyncKey(player.UserId)] = playerSignal.Get,
+	})
+end
+
+local function onPlayerRemoving(player: Player)
+	CharmSync.server.removeClient(player)
+	signals[player] = nil
+end
+
+CharmSync.server.connect(function(player: Player, payloads: { CharmSync.SyncPayload })
+	syncRemote:FireClient(player, payloads)
+end)
+
+readyRemote.OnServerEvent:Connect(onClientReady)
+Players.PlayerAdded:Connect(onPlayerAdded)
+Players.PlayerRemoving:Connect(onPlayerRemoving)
+for _, player in Players:GetPlayers() do
+	onPlayerAdded(player)
+end
+
+return Module
