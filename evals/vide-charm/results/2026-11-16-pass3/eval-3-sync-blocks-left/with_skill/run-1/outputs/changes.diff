+++ b/src/ReplicatedStorage/Shared/SyncedPlayerData.luau
@@ -0,0 +1,29 @@
+--!strict
+--[[
+	The per-player data the server syncs to each player's client through CharmSync. To sync
+	another value, add a field to Data and to DEFAULT.
+]]
+
+export type Data = {
+	BlocksLeft: number,
+}
+
+const DEFAULT: Data = table.freeze({
+	-- The per-player block limit; BlockPlacement refuses placements at 0.
+	BlocksLeft = 50,
+})
+
+local Module = {
+	Default = DEFAULT,
+	SyncRemoteName = "PlayerDataSync",
+	ReadyRemoteName = "PlayerDataReady",
+}
+
+--[[
+	CharmSync keys name one signal for every client, so each player's data needs its own key.
+]]
+function Module.getSyncKey(userId: number): string
+	return `PlayerData-{userId}`
+end
+
+return table.freeze(Module)
