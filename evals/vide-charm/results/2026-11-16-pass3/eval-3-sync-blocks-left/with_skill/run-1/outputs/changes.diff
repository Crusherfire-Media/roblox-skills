+--!strict
+--[[
+	The bottom-center HUD: the blocks-left count stacked above the block picker.
+]]
+
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const BlockPicker = require(script.Parent.BlockPicker)
+const BlocksLeftLabel = require(script.Parent.BlocksLeftLabel)
+const Vide = require(ReplicatedStorage.Packages.Vide)
+
+const create = Vide.create
+
+const BOTTOM_MARGIN = 24
+const GAP = 8
+
+export type HotbarProps = {
+	Selected: () -> string,
+	Select: (name: string) -> (),
+	BlocksLeft: number | () -> number,
+}
+
+local function hotbar(props: HotbarProps): Frame
+	return create("Frame")({
+		Name = "Hotbar",
+		AnchorPoint = Vector2.new(0.5, 1),
+		Position = UDim2.new(0.5, 0, 1, -BOTTOM_MARGIN),
+		AutomaticSize = Enum.AutomaticSize.XY,
+		BackgroundTransparency = 1,
+
+		create("UIListLayout")({
+			FillDirection = Enum.FillDirection.Vertical,
+			HorizontalAlignment = Enum.HorizontalAlignment.Center,
+			Padding = UDim.new(0, GAP),
+		}),
+
+		BlocksLeftLabel({
+			BlocksLeft = props.BlocksLeft,
+			LayoutOrder = 1,
+		}),
+		BlockPicker({
+			Selected = props.Selected,
+			Select = props.Select,
+			LayoutOrder = 2,
+		}),
+	})
+end
+
+return hotbar
