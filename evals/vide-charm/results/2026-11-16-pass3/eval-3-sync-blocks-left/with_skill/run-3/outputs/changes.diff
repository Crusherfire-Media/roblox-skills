diff --git a/src/ServerScriptService/PlayerDataStore.luau b/src/ServerScriptService/PlayerDataStore.luau
new file mode 100644
index 0000000..4289ecc
--- /dev/null
+++ b/src/ServerScriptService/PlayerDataStore.luau
@@ -0,0 +1,69 @@
+--!strict
+--[[
+	Holds every player's PlayerData in one Charm signal, from when they join until they leave.
+	Server scripts read and change it here, and PlayerDataSync sends each player their own entry.
+]]
+
+const Players = game:GetService("Players")
+
+const Charm = require("@game/ReplicatedStorage/Packages/Charm")
+const PlayerData = require("@game/ReplicatedStorage/Shared/PlayerData")
+
+type PlayerData = PlayerData.PlayerData
+
+const Module = {}
+
+local getAll, setAll = Charm.signal({} :: { [Player]: PlayerData? })
+
+--[[
+	Getter for every joined player's data, keyed by Player.
+]]
+Module.getAll = getAll
+
+--[[
+	Returns the player's data, or nil when they have not joined or have left.
+]]
+function Module:Get(player: Player): PlayerData?
+	return getAll()[player]
+end
+
+--[[
+	Replaces the player's data with what `updater` returns. Charm freezes the data, so `updater`
+	returns a changed copy instead of editing it. Does nothing for a player who has left.
+]]
+function Module:Update(player: Player, updater: (data: PlayerData) -> PlayerData)
+	setAll(function(all)
+		local data = all[player]
+		if not data then
+			return all
+		end
+
+		local nextAll = table.clone(all)
+		nextAll[player] = updater(data)
+		return nextAll
+	end)
+end
+
+local function onPlayerAdded(player: Player)
+	setAll(function(all)
+		local nextAll = table.clone(all)
+		nextAll[player] = PlayerData.new()
+		return nextAll
+	end)
+end
+
+local function onPlayerRemoving(player: Player)
+	setAll(function(all)
+		local nextAll = table.clone(all)
+		nextAll[player] = nil
+		return nextAll
+	end)
+end
+
+Players.PlayerAdded:Connect(onPlayerAdded)
+Players.PlayerRemoving:Connect(onPlayerRemoving)
+for _, player in Players:GetPlayers() do
+	onPlayerAdded(player)
+end
+
+return Module
diff --git a/src/ServerScriptService/PlayerDataSync.server.luau b/src/ServerScriptService/PlayerDataSync.server.luau
new file mode 100644
index 0000000..3fe4d79
--- /dev/null
+++ b/src/ServerScriptService/PlayerDataSync.server.luau
@@ -0,0 +1,49 @@
+--!strict
+--[[
+	Sends each player their own PlayerData with CharmSync. A client fires PlayerDataReady once it
+	listens on PlayerDataSync; it then gets its full data, followed by only what changes.
+]]
+
+const Players = game:GetService("Players")
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Charm = require("@game/ReplicatedStorage/Packages/Charm")
+const CharmSync = require("@game/ReplicatedStorage/Packages/CharmSync")
+const PlayerData = require("@game/ReplicatedStorage/Shared/PlayerData")
+const PlayerDataStore = require("./PlayerDataStore")
+
+const syncRemote = Instance.new("RemoteEvent")
+syncRemote.Name = PlayerData.SyncRemoteName
+syncRemote.Parent = ReplicatedStorage
+
+const readyRemote = Instance.new("RemoteEvent")
+readyRemote.Name = PlayerData.ReadyRemoteName
+readyRemote.Parent = ReplicatedStorage
+
+local syncedPlayers: { [Player]: boolean? } = {}
+
+local function onReady(player: Player)
+	-- A second ready would register a new computed under the same key, which CharmSync rejects.
+	if syncedPlayers[player] then
+		return
+	end
+	syncedPlayers[player] = true
+
+	CharmSync.server.addSignalsToClient(player, {
+		[PlayerData.getSyncKey(player)] = Charm.computed(function()
+			return PlayerDataStore.getAll()[player]
+		end),
+	})
+end
+
+local function onPlayerRemoving(player: Player)
+	syncedPlayers[player] = nil
+	CharmSync.server.removeClient(player)
+end
+
+CharmSync.server.connect(function(player: Player, payloads: { CharmSync.SyncPayload })
+	syncRemote:FireClient(player, payloads)
+end)
+
+readyRemote.OnServerEvent:Connect(onReady)
+Players.PlayerRemoving:Connect(onPlayerRemoving)
