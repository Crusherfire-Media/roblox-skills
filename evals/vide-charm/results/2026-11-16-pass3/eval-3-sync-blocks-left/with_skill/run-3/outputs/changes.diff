+		BlockPicker({
+			Selected = props.Selected,
+			Select = props.Select,
+			LayoutOrder = 2,
+		}),
+	})
+end
+
+return hotbar
diff --git a/src/StarterPlayer/StarterPlayerScripts/LocalPlayerData.luau b/src/StarterPlayer/StarterPlayerScripts/LocalPlayerData.luau
new file mode 100644
index 0000000..4e0ad97
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/LocalPlayerData.luau
@@ -0,0 +1,56 @@
+--!strict
+--[[
+	The local player's PlayerData, kept in step with the server by CharmSync. It is read-only on
+	the client: the server's next patch overwrites anything set here.
+]]
+
+const Players = game:GetService("Players")
+const ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+const Charm = require("@game/ReplicatedStorage/Packages/Charm")
+const CharmSync = require("@game/ReplicatedStorage/Packages/CharmSync")
+const PlayerData = require("@game/ReplicatedStorage/Shared/PlayerData")
+
+const Module = {}
+
+local getPlayerData, setPlayerData = Charm.signal(PlayerData.new())
+local hasStarted = false
+
+--[[
+	Getter for the local player's data. Holds the starting values until the server's first sync.
+]]
+Module.getPlayerData = getPlayerData
+
+local function findRemoteAsync(name: string): RemoteEvent
+	local remote = ReplicatedStorage:WaitForChild(name)
+	if not remote:IsA("RemoteEvent") then
+		error(`{name} must be a RemoteEvent`)
+	end
+	return remote
+end
+
+--[[
+	Starts receiving the local player's data. Yields until the server's remotes exist, so call it
+	after any UI is mounted or from its own thread.
+]]
+function Module.startAsync()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	CharmSync.client.addSignals({
+		[PlayerData.getSyncKey(Players.LocalPlayer)] = setPlayerData,
+	})
+
+	local syncRemote = findRemoteAsync(PlayerData.SyncRemoteName)
+	local readyRemote = findRemoteAsync(PlayerData.ReadyRemoteName)
+
+	-- Listen before firing ready, or the first payload, which holds the full data, can be missed.
+	syncRemote.OnClientEvent:Connect(function(payloads: { CharmSync.SyncPayload })
+		CharmSync.client.patch(payloads)
+	end)
+	readyRemote:FireServer()
+end
+
+return Module
