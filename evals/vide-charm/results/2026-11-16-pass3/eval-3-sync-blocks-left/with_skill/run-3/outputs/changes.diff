@@ -0,0 +1,57 @@
+--!strict
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const PlayerData = require("@game/ReplicatedStorage/Shared/PlayerData")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const Hotbar = require("@game/StarterPlayer/StarterPlayerScripts/Hotbar")
+
+const effect = Vide.effect
+const source = Vide.source
+
+const blockNames = {}
+for index, blockType in BlockTypes.List do
+	blockNames[index] = blockType.Name
+end
+
+const CONTROLS = {
+	BlocksLeft = UILabs.Ordered(
+		UILabs.Slider(PlayerData.MaxBlocksPerPlayer, 0, PlayerData.MaxBlocksPerPlayer, 1),
+		1
+	),
+	Selected = UILabs.Ordered(UILabs.Choose(blockNames), 2),
+}
+
+type StoryProps = {
+	controls: {
+		BlocksLeft: () -> number,
+		Selected: () -> string,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local controls = props.controls
+
+	-- The control and tile clicks both change the selection.
+	local selected = source(controls.Selected())
+	effect(function()
+		selected(controls.Selected())
+	end)
+
+	return Hotbar({
+		Selected = selected,
+		Select = function(name: string)
+			selected(name)
+		end,
+		BlocksLeft = controls.BlocksLeft,
+	})
+end
+
+return {
+	summary = "The blocks-left count above the block picker, from a full budget down to none.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
