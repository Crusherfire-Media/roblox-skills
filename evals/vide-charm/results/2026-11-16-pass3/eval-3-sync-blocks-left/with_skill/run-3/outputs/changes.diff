new file mode 100644
index 0000000..84d0fad
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/PlayerData.luau
@@ -0,0 +1,38 @@
+--!strict
+--[[
+	The per-player data the server syncs to that player's client with CharmSync. To sync another
+	value, add a field to PlayerData and its starting value to Module.new: the server's
+	PlayerDataStore and the client's LocalPlayerData both build from this.
+]]
+
+export type PlayerData = {
+	BlocksLeft: number,
+}
+
+-- How many blocks one player may place in a server.
+const MAX_BLOCKS_PER_PLAYER = 50
+
+const Module = {}
+
+Module.MaxBlocksPerPlayer = MAX_BLOCKS_PER_PLAYER
+Module.SyncRemoteName = "PlayerDataSync"
+Module.ReadyRemoteName = "PlayerDataReady"
+
+--[[
+	Returns the data a player starts with when they join.
+]]
+function Module.new(): PlayerData
+	return {
+		BlocksLeft = MAX_BLOCKS_PER_PLAYER,
+	}
+end
+
+--[[
+	Returns the CharmSync key for a player's data. Each player needs their own key, because
+	CharmSync sends a key's state to every client subscribed to it.
+]]
+function Module.getSyncKey(player: Player): string
+	return `PlayerData-{player.UserId}`
+end
+
+return Module
