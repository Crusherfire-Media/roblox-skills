diff --git a/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau b/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau
new file mode 100644
index 0000000..cbfbced
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau
@@ -0,0 +1,50 @@
+--!strict
+--[[
+	A pill that reads how many more blocks the player may place. The count turns red at zero.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const create = Vide.create
+const read = Vide.read
+
+const HEIGHT = 32
+const PADDING_X = 14
+const TEXT_SIZE = 20
+const FONT = Font.new("rbxasset://fonts/families/BuilderSans.json", Enum.FontWeight.Bold)
+const PANEL_COLOR = Color3.fromRGB(28, 28, 34)
+const TEXT_COLOR = Color3.fromRGB(255, 255, 255)
+const EMPTY_COLOR = Color3.fromRGB(255, 110, 100)
+
+export type BlocksLeftLabelProps = {
+	BlocksLeft: number | () -> number,
+	LayoutOrder: number?,
+}
+
+local function blocksLeftLabel(props: BlocksLeftLabelProps): TextLabel
+	return create("TextLabel")({
+		Name = "BlocksLeftLabel",
+		LayoutOrder = props.LayoutOrder,
+		Size = UDim2.fromOffset(0, HEIGHT),
+		AutomaticSize = Enum.AutomaticSize.X,
+		BackgroundColor3 = PANEL_COLOR,
+		BackgroundTransparency = 0.2,
+		FontFace = FONT,
+		TextSize = TEXT_SIZE,
+		Text = function()
+			local blocksLeft = read(props.BlocksLeft)
+			return if blocksLeft == 1 then "1 block left" else `{blocksLeft} blocks left`
+		end,
+		TextColor3 = function()
+			return if read(props.BlocksLeft) > 0 then TEXT_COLOR else EMPTY_COLOR
+		end,
+
+		create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+		create("UIPadding")({
+			PaddingLeft = UDim.new(0, PADDING_X),
+			PaddingRight = UDim.new(0, PADDING_X),
+		}),
+	})
+end
+
+return blocksLeftLabel
