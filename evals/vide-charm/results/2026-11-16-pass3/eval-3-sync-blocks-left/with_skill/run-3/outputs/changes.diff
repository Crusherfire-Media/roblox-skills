+--!strict
+--[[
+	The bottom-center HUD stack: the blocks-left count above the block picker.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockPicker = require("./BlockPicker")
+const BlocksLeftLabel = require("./BlocksLeftLabel")
+
+const create = Vide.create
+
+const BOTTOM_MARGIN = 24
+const GAP = 8
+
+export type HotbarProps = {
+	Selected: () -> string,
+	Select: (name: string) -> (),
+	BlocksLeft: number | () -> number,
+}
+
+local function hotbar(props: HotbarProps): Frame
+	return create("Frame")({
+		Name = "Hotbar",
+		AnchorPoint = Vector2.new(0.5, 1),
+		Position = UDim2.new(0.5, 0, 1, -BOTTOM_MARGIN),
+		Size = UDim2.fromOffset(0, 0),
+		AutomaticSize = Enum.AutomaticSize.XY,
+		BackgroundTransparency = 1,
+
+		create("UIListLayout")({
+			HorizontalAlignment = Enum.HorizontalAlignment.Center,
+			Padding = UDim.new(0, GAP),
