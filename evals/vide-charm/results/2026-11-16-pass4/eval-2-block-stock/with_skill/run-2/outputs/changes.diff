@@ -0,0 +1,77 @@
+local BlockPicker = require("@game/StarterPlayer/StarterPlayerScripts/BlockPicker")
+local BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+local UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local effect = Vide.effect
+local source = Vide.source
+
+-- Matches STARTING_STOCK in BlockPlacement.server.
+local STARTING_STOCK = 20
+
+local blockNames = {}
+local countControls = {}
+for index, blockType in BlockTypes.List do
+	table.insert(blockNames, blockType.Name)
+	-- The last block type starts empty, so the story opens showing a grayed tile.
+	local initial = if index == #BlockTypes.List then 0 else STARTING_STOCK
+	local slider = UILabs.Slider(initial, 0, STARTING_STOCK * 50, 1)
+	countControls[blockType.Name] = UILabs.Ordered(slider, index + 1)
+end
+-- Off is the moment after joining, before the server has sent any counts.
+countControls.IsKnown = UILabs.Ordered(true, 1)
+
+local hotbarControls = UILabs.ControlGroup({
+	Selected = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+})
+
+local CONTROLS = {
+	Hotbar = UILabs.Ordered(hotbarControls, 1),
+	Stock = UILabs.Ordered(UILabs.ControlGroup(countControls), 2),
+}
+
+type StoryProps = {
+	controls: {
+		Hotbar: {
+			Selected: () -> string,
+		},
+		Stock: { [string]: () -> any },
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local controls = props.controls
+
+	local selected = source(controls.Hotbar.Selected())
+	effect(function()
+		selected(controls.Hotbar.Selected())
+	end)
+
+	local function stock(): BlockPicker.Stock
+		if not controls.Stock.IsKnown() then
+			return {}
+		end
+
+		local counts = {}
+		for _, name in blockNames do
+			counts[name] = controls.Stock[name]()
+		end
+		return counts
+	end
+
+	return BlockPicker({
+		Selected = selected,
+		Stock = stock,
+		Select = function(name: string)
+			selected(name)
+		end,
+	})
+end
+
+return {
+	summary = "The block hotbar with stock counts, empty tiles, and the selected count.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
