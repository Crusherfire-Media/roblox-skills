@@ -0,0 +1,71 @@
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockPicker = require("@game/StarterPlayer/StarterPlayerScripts/BlockPicker")
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local UILabs = require(ReplicatedStorage.Packages.UILabs)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local effect = Vide.effect
+local source = Vide.source
+
+local MAX_STOCK = 999
+
+local blockNames = {}
+local stockControls = {}
+for index, blockType in BlockTypes.List do
+	blockNames[index] = blockType.Name
+	-- Every other block type starts empty, so both tile looks show at once.
+	local startingCount = if index % 2 == 0 then 0 else 20
+	stockControls[blockType.Name] =
+		UILabs.Ordered(UILabs.Slider(startingCount, 0, MAX_STOCK, 1), index)
+end
+
+local CONTROLS = {
+	Selection = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Block = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+		}),
+		1
+	),
+	Stock = UILabs.Ordered(UILabs.ControlGroup(stockControls), 2),
+}
+
+type StoryProps = {
+	controls: {
+		Selection: {
+			Block: () -> string,
+		},
+		Stock: { [string]: () -> number },
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local controls = props.controls
+
+	local selected = source(controls.Selection.Block())
+	effect(function()
+		selected(controls.Selection.Block())
+	end)
+
+	return BlockPicker({
+		Selected = selected,
+		Select = function(name: string)
+			selected(name)
+		end,
+		Stock = function()
+			local stock = {}
+			for name, count in controls.Stock do
+				stock[name] = count()
+			end
+			return stock
+		end,
+	})
+end
+
+return {
+	summary = "The block hotbar, with each block type's stock and the selected type's count.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
