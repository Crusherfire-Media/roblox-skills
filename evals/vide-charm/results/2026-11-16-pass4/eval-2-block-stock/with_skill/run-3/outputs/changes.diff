@@ -0,0 +1,85 @@
+--!strict
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockPicker = require("@game/StarterPlayer/StarterPlayerScripts/BlockPicker")
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local UILabs = require(ReplicatedStorage.Packages.UILabs)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local effect = Vide.effect
+local source = Vide.source
+
+local MAX_STOCK = 99
+
+local blockNames = {}
+local stockControls = {}
+for index, blockType in BlockTypes.List do
+	blockNames[index] = blockType.Name
+	-- The first type starts at 0 so the empty look shows without touching a control.
+	local initial = if index == 1 then 0 else 20
+	stockControls[blockType.Name] = UILabs.Ordered(UILabs.Slider(initial, 0, MAX_STOCK, 1), index)
+end
+
+local CONTROLS = {
+	Selection = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Block = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+		}),
+		1
+	),
+	Stock = UILabs.Ordered(UILabs.ControlGroup(stockControls), 2),
+	Preview = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Before the server's first StockChanged, no counts are shown.
+			IsSynced = UILabs.Ordered(true, 1),
+		}),
+		3
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Selection: {
+			Block: () -> string,
+		},
+		Stock: { [string]: () -> number },
+		Preview: {
+			IsSynced: () -> boolean,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local controls = props.controls
+
+	local selected = source(controls.Selection.Block())
+	effect(function()
+		selected(controls.Selection.Block())
+	end)
+
+	return BlockPicker({
+		Selected = selected,
+		Select = function(name: string)
+			selected(name)
+		end,
+		Counts = function()
+			local counts: { [string]: number? } = {}
+			if not controls.Preview.IsSynced() then
+				return counts
+			end
+			for name, count in controls.Stock do
+				counts[name] = count()
+			end
+			return counts
+		end,
+	})
+end
+
+return {
+	summary = "The block hotbar with each type's stock, including empty and unsynced states.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
