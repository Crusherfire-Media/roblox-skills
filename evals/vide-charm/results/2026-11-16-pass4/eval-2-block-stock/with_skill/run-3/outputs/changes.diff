diff --git a/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
new file mode 100644
index 0000000..4233c04
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
@@ -0,0 +1,60 @@
+--!strict
+--[[
+	Client copy of the player's block stock: how many of each block type they have left. The
+	server owns the counts and fires StockChanged(blockTypeName, count) whenever one changes; this
+	module only mirrors them in a Charm signal.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Charm = require(ReplicatedStorage.Packages.Charm)
+
+export type Stock = { [string]: number? }
+
+local BlockStock = {}
+
+local getStock, setStock = Charm.signal({} :: Stock)
+local hasStarted = false
+
+--[[
+	Counts by block type name. A type is missing until the server first sends its count. A Charm
+	getter: read it in Charm effects and computed values, or bridge it into Vide with vide-charm.
+]]
+BlockStock.getStock = getStock
+
+function BlockStock.getCount(name: string): number
+	return getStock()[name] or 0
+end
+
+local function onStockChanged(name: unknown, count: unknown)
+	if typeof(name) ~= "string" or not BlockTypes.ByName[name] then
+		return
+	end
+	if typeof(count) ~= "number" or count ~= count then
+		return
+	end
+
+	setStock(function(stock)
+		local nextStock = table.clone(stock)
+		nextStock[name] = count
+		return nextStock
+	end)
+end
+
+--[[
+	Listens to the server's StockChanged remote. Yields until the remote exists, so call it after
+	any UI is mounted or from its own thread.
+]]
+function BlockStock.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	local remote = ReplicatedStorage:WaitForChild("StockChanged")
+	assert(remote:IsA("RemoteEvent"), "StockChanged must be a RemoteEvent")
+	remote.OnClientEvent:Connect(onStockChanged)
+end
+
+return BlockStock
