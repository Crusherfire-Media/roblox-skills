diff --git a/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
new file mode 100644
index 0000000..3961353
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlockStock.luau
@@ -0,0 +1,64 @@
+--[[
+	Client copy of the player's block stock: how many of each block type they have left. The
+	server owns the real counts and fires StockChanged(blockTypeName, count) whenever one changes,
+	including once per block type when the player joins. Until a count arrives it reads as 0.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Charm = require(ReplicatedStorage.Packages.Charm)
+
+export type Stock = { [string]: number }
+
+local BlockStock = {}
+
+-- Treated as immutable: every change replaces the table, so Charm sees a new value.
+local getStock, setStock = Charm.signal({} :: Stock)
+local hasStarted = false
+
+--[[
+	Every block type's count, keyed by block type name. A Charm getter: read it in Charm effects
+	and computed values, or bridge it into Vide with vide-charm. Don't mutate the table.
+]]
+BlockStock.getStock = getStock
+
+--[[
+	How many of the named block type the player has left. Reading it inside a Charm effect or
+	computed value subscribes to the stock.
+]]
+function BlockStock.getCount(name: string): number
+	return getStock()[name] or 0
+end
+
+local function onStockChanged(name: unknown, count: unknown)
+	if typeof(name) ~= "string" or typeof(count) ~= "number" or not BlockTypes.ByName[name] then
+		return
+	end
+
+	setStock(function(current: Stock): Stock
+		if current[name] == count then
+			return current
+		end
+		local nextStock = table.clone(current)
+		nextStock[name] = count
+		return nextStock
+	end)
+end
+
+--[[
+	Finds the server's StockChanged remote and starts listening to it. Yields until the remote
+	exists. Events the server fires before this connects are queued by Roblox, not lost.
+]]
+function BlockStock.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	local remote = ReplicatedStorage:WaitForChild("StockChanged")
+	assert(remote:IsA("RemoteEvent"), "StockChanged must be a RemoteEvent")
+	remote.OnClientEvent:Connect(onStockChanged)
+end
+
+return BlockStock
