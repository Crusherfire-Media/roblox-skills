@@ -0,0 +1,70 @@
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local StarterPlayer = game:GetService("StarterPlayer")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local UILabs = require(ReplicatedStorage.Packages.UILabs)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local playerScripts = StarterPlayer.StarterPlayerScripts
+local BlockPicker = require(playerScripts.BlockPicker)
+local BlocksLeftLabel = require(playerScripts.BlocksLeftLabel)
+
+local create = Vide.create
+local effect = Vide.effect
+local source = Vide.source
+
+local blockNames = {}
+for _, blockType in BlockTypes.List do
+	table.insert(blockNames, blockType.Name)
+end
+
+local CONTROLS = {
+	-- The game starts players at 50; higher values check the label's width.
+	BlocksLeft = UILabs.Ordered(UILabs.Slider(50, 0, 999, 1), 1),
+	-- Off shows the moment before the server's first sync, when the count is unknown.
+	IsSynced = UILabs.Ordered(true, 2),
+	SelectedBlock = UILabs.Ordered(UILabs.Choose(blockNames), 3),
+}
+
+type StoryProps = {
+	controls: {
+		BlocksLeft: () -> number,
+		IsSynced: () -> boolean,
+		SelectedBlock: () -> string,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local controls = props.controls
+
+	local selected = source(controls.SelectedBlock())
+	effect(function()
+		selected(controls.SelectedBlock())
+	end)
+
+	return create("Frame")({
+		Name = "Screen",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundTransparency = 1,
+
+		BlocksLeftLabel({
+			BlocksLeft = function()
+				return if controls.IsSynced() then controls.BlocksLeft() else nil
+			end,
+		}),
+		BlockPicker({
+			Selected = selected,
+			Select = function(name: string)
+				selected(name)
+			end,
+		}),
+	})
+end
+
+return {
+	summary = "The blocks-left label above the hotbar, from full to none left.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
