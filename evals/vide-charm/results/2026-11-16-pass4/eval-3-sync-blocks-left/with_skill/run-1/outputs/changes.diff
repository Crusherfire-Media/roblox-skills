new file mode 100644
index 0000000..d84822a
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/SyncedPlayerData.luau
@@ -0,0 +1,25 @@
+--[[
+	The per-player data the server syncs to each player's own client through CharmSync. To sync
+	another value, add a field to PlayerData and give it a starting value in the server's
+	PlayerData module; the client then has it in ClientPlayerData.getData().
+]]
+
+export type PlayerData = {
+	-- How many more blocks the player may place in this server.
+	BlocksLeft: number,
+}
+
+-- The server fires it with CharmSync payloads; the client fires it with no arguments once it is
+-- ready to receive them.
+local REMOTE_NAME = "PlayerDataSync"
+
+local function getSyncKey(userId: number): string
+	return `PlayerData-{userId}`
+end
+
+local SyncedPlayerData = {
+	RemoteName = REMOTE_NAME,
+	getSyncKey = getSyncKey,
+}
+
+return table.freeze(SyncedPlayerData)
