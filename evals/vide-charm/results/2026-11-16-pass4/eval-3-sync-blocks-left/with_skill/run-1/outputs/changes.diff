diff --git a/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau b/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau
new file mode 100644
index 0000000..cd25fb0
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau
@@ -0,0 +1,59 @@
+--[[
+	A small label centered just above the hotbar that says how many more blocks the player may
+	place. It turns red at zero, and stays hidden until the count is known.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local HotbarLayout = require(script.Parent.HotbarLayout)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local create = Vide.create
+
+local GAP_ABOVE_HOTBAR = 8
+local TEXT_SIZE = 20
+local TEXT_COLOR = Color3.fromRGB(255, 255, 255)
+local EMPTY_TEXT_COLOR = Color3.fromRGB(255, 110, 100)
+
+export type BlocksLeftLabelProps = {
+	-- nil until the server's first sync.
+	BlocksLeft: () -> number?,
+}
+
+local function blocksLeftLabel(props: BlocksLeftLabelProps): TextLabel
+	return create("TextLabel")({
+		Name = "BlocksLeft",
+		AnchorPoint = Vector2.new(0.5, 1),
+		Position = UDim2.new(
+			0.5,
+			0,
+			1,
+			-(HotbarLayout.BottomMargin + HotbarLayout.PanelHeight + GAP_ABOVE_HOTBAR)
+		),
+		AutomaticSize = Enum.AutomaticSize.XY,
+		BackgroundColor3 = HotbarLayout.PanelColor,
+		BackgroundTransparency = 0.2,
+		FontFace = Font.fromEnum(Enum.Font.BuilderSansBold),
+		TextSize = TEXT_SIZE,
+		Visible = function()
+			return props.BlocksLeft() ~= nil
+		end,
+		Text = function()
+			local count = props.BlocksLeft() or 0
+			return if count == 1 then "1 block left" else `{count} blocks left`
+		end,
+		TextColor3 = function()
+			return if props.BlocksLeft() == 0 then EMPTY_TEXT_COLOR else TEXT_COLOR
+		end,
+
+		create("UICorner")({ CornerRadius = UDim.new(1, 0) }),
+		create("UIPadding")({
+			PaddingLeft = UDim.new(0, 12),
+			PaddingRight = UDim.new(0, 12),
+			PaddingTop = UDim.new(0, 4),
+			PaddingBottom = UDim.new(0, 4),
+		}),
+	})
+end
+
+return blocksLeftLabel
diff --git a/src/StarterPlayer/StarterPlayerScripts/ClientPlayerData.luau b/src/StarterPlayer/StarterPlayerScripts/ClientPlayerData.luau
new file mode 100644
index 0000000..d3da673
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/ClientPlayerData.luau
@@ -0,0 +1,47 @@
+--[[
+	The local player's PlayerData, synced from the server by CharmSync. UI reads it through
+	getData and never sets it: the server's next patch would overwrite a client-side change.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local SyncedPlayerData = require(ReplicatedStorage.Shared.SyncedPlayerData)
+
+type PlayerData = SyncedPlayerData.PlayerData
+
+local ClientPlayerData = {}
+
+-- nil until the server's first payload arrives.
+local getData, setData = Charm.signal(nil :: PlayerData?)
+local hasStarted = false
+
+ClientPlayerData.getData = getData
+
+--[[
+	Registers with CharmSync and asks the server for the data. Yields until the server's remote
+	exists, so call it after any UI is mounted or from its own thread.
+]]
+function ClientPlayerData.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	CharmSync.client.addSignals({
+		[SyncedPlayerData.getSyncKey(Players.LocalPlayer.UserId)] = setData,
+	})
+
+	local remote = ReplicatedStorage:WaitForChild(SyncedPlayerData.RemoteName)
+	assert(remote:IsA("RemoteEvent"), "PlayerDataSync must be a RemoteEvent")
+
+	-- Connected before asking, so the first payload is not missed.
+	remote.OnClientEvent:Connect(function(payloads: { CharmSync.SyncPayload })
+		CharmSync.client.patch(payloads)
+	end)
+	remote:FireServer()
+end
+
+return ClientPlayerData
