diff --git a/src/ServerScriptService/PlayerData.luau b/src/ServerScriptService/PlayerData.luau
new file mode 100644
index 0000000..139dec6
--- /dev/null
+++ b/src/ServerScriptService/PlayerData.luau
@@ -0,0 +1,77 @@
+--[[
+	Owns each player's PlayerData, one Charm signal per player, from when they join until they
+	leave. PlayerDataSync.server sends each signal to its player's client, so every change made
+	through update reaches that client.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+local SyncedPlayerData = require(ReplicatedStorage.Shared.SyncedPlayerData)
+
+-- How many blocks one player may place in a server.
+local MAX_BLOCKS_PER_PLAYER = 50
+
+type PlayerData = SyncedPlayerData.PlayerData
+
+type Entry = {
+	Get: Charm.Getter<PlayerData>,
+	Set: Charm.Setter<PlayerData>,
+}
+
+local entries: { [Player]: Entry? } = {}
+
+local PlayerData = {}
+
+--[[
+	Returns the Charm getter for a player's data, or nil once they have left.
+]]
+function PlayerData.getSignal(player: Player): Charm.Getter<PlayerData>?
+	local entry = entries[player]
+	return if entry then entry.Get else nil
+end
+
+function PlayerData.get(player: Player): PlayerData?
+	local entry = entries[player]
+	return if entry then entry.Get() else nil
+end
+
+--[[
+	Replaces a player's data with what update returns. Charm compares tables by reference and
+	freezes them in Studio, so update must return a new table (table.clone the one it gets).
+	Does nothing for a player who has left.
+]]
+function PlayerData.update(player: Player, update: (PlayerData) -> PlayerData)
+	local entry = entries[player]
+	if entry then
+		entry.Set(update)
+	end
+end
+
+local function onPlayerAdded(player: Player)
+	if entries[player] then
+		return
+	end
+
+	local initialData: PlayerData = {
+		BlocksLeft = MAX_BLOCKS_PER_PLAYER,
+	}
+	local get, set = Charm.signal(initialData)
+	entries[player] = {
+		Get = get,
+		Set = set,
+	}
+end
+
+Players.PlayerAdded:Connect(onPlayerAdded)
+-- Players who joined before this module was first required.
+for _, player in Players:GetPlayers() do
+	onPlayerAdded(player)
+end
+
+Players.PlayerRemoving:Connect(function(player: Player)
+	entries[player] = nil
+end)
+
+return PlayerData
diff --git a/src/ServerScriptService/PlayerDataSync.server.luau b/src/ServerScriptService/PlayerDataSync.server.luau
new file mode 100644
index 0000000..6c9a681
--- /dev/null
+++ b/src/ServerScriptService/PlayerDataSync.server.luau
@@ -0,0 +1,39 @@
+--[[
+	Sends each player their own PlayerData through CharmSync. A client fires the remote once it
+	has registered its signals; CharmSync then sends the full data once and only changes after
+	that.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local PlayerData = require(script.Parent.PlayerData)
+local SyncedPlayerData = require(ReplicatedStorage.Shared.SyncedPlayerData)
+
+local syncRemote = Instance.new("RemoteEvent")
+syncRemote.Name = SyncedPlayerData.RemoteName
+syncRemote.Parent = ReplicatedStorage
+
+CharmSync.server.connect(function(player: Player, payloads: { CharmSync.SyncPayload })
+	syncRemote:FireClient(player, payloads)
+end)
+
+local syncedPlayers: { [Player]: true? } = {}
+
+syncRemote.OnServerEvent:Connect(function(player: Player)
+	local getData = PlayerData.getSignal(player)
+	if syncedPlayers[player] or not getData then
+		return
+	end
+	syncedPlayers[player] = true
+
+	CharmSync.server.addSignalsToClient(player, {
+		[SyncedPlayerData.getSyncKey(player.UserId)] = getData,
+	})
+end)
+
+Players.PlayerRemoving:Connect(function(player: Player)
+	syncedPlayers[player] = nil
+	CharmSync.server.removeClient(player)
+end)
