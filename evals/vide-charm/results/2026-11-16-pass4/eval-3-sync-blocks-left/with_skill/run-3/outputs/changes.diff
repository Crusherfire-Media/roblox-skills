diff --git a/src/ServerScriptService/PlayerData.luau b/src/ServerScriptService/PlayerData.luau
new file mode 100644
index 0000000..66e7c52
--- /dev/null
+++ b/src/ServerScriptService/PlayerData.luau
@@ -0,0 +1,115 @@
+--!strict
+--[[
+	Server side of synced player data: holds each player's data in a Charm signal and syncs it to
+	that player's client with CharmSync. Other server scripts read it with get and change it with
+	update.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local SyncedPlayerData = require(ReplicatedStorage.Shared.SyncedPlayerData)
+
+type Data = SyncedPlayerData.Data
+
+type Entry = {
+	Get: Charm.Getter<Data>,
+	Set: Charm.Setter<Data>,
+}
+
+local PlayerData = {}
+
+local entries: { [Player]: Entry? } = {}
+local hasStarted = false
+
+--[[
+	Returns nil for a player who has left, so a late remote or update cannot recreate an entry that
+	PlayerRemoving already cleared.
+]]
+local function getEntry(player: Player): Entry?
+	local entry = entries[player]
+	if entry then
+		return entry
+	end
+	if player.Parent ~= Players then
+		return nil
+	end
+
+	local get, set = Charm.signal(SyncedPlayerData.createDefault())
+	local newEntry = {
+		Get = get,
+		Set = set,
+	}
+	entries[player] = newEntry
+	return newEntry
+end
+
+--[[
+	Returns nil for a player who has left.
+]]
+function PlayerData.get(player: Player): Data?
+	local entry = getEntry(player)
+	return if entry then entry.Get() else nil
+end
+
+local function removePlayer(player: Player)
+	CharmSync.server.removeClient(player)
+	entries[player] = nil
+end
+
+--[[
+	Replaces the player's data with what updater returns. Charm freezes stored tables, so updater
+	returns a changed copy instead of editing the one it receives. Does nothing for a player who
+	has left.
+]]
+function PlayerData.update(player: Player, updater: (data: Data) -> Data)
+	local entry = getEntry(player)
+	if entry then
+		entry.Set(updater)
+	end
+end
+
+--[[
+	Creates the sync remote and starts sending each player their data once their client asks for
+	it. Call once, from one server script.
+]]
+function PlayerData.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	local remote = Instance.new("RemoteEvent")
+	remote.Name = SyncedPlayerData.RemoteName
+	remote.Parent = ReplicatedStorage
+
+	CharmSync.server.connect(function(player: Player, payloads: { CharmSync.SyncPayload })
+		remote:FireClient(player, payloads)
+	end)
+
+	-- The client fires this once its listener is connected, so the first payload is not lost.
+	remote.OnServerEvent:Connect(function(player: Player)
+		local entry = getEntry(player)
+		if not entry then
+			return
+		end
+
+		-- A quick rejoin can arrive before the old Player's PlayerRemoving. CharmSync keeps the
+		-- first getter registered for a key, so drop the old one or the new client gets stale data.
+		for other in entries do
+			if other ~= player and other.UserId == player.UserId then
+				removePlayer(other)
+			end
+		end
+
+		CharmSync.server.addSignalsToClient(player, {
+			[SyncedPlayerData.getSyncKey(player.UserId)] = entry.Get,
+		})
+	end)
+
+	Players.PlayerRemoving:Connect(removePlayer)
+end
+
+return PlayerData
