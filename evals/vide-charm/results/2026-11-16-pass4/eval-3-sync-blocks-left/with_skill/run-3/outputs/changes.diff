diff --git a/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau b/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau
new file mode 100644
index 0000000..07252d0
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau
@@ -0,0 +1,44 @@
+--!strict
+--[[
+	Client side of synced player data: a Charm signal that CharmSync fills from the server. Read it
+	with getData, through useSignalState in UI. The server owns this data, so nothing here sets it.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local SyncedPlayerData = require(ReplicatedStorage.Shared.SyncedPlayerData)
+
+local PlayerData = {}
+
+local getData, setData = Charm.signal(SyncedPlayerData.createDefault())
+local hasStarted = false
+
+PlayerData.getData = getData
+
+--[[
+	Connects to the server's sync remote and asks it for this player's data. Yields until the
+	remote exists, so call it after any UI is mounted or from its own thread.
+]]
+function PlayerData.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	CharmSync.client.addSignals({
+		[SyncedPlayerData.getSyncKey(Players.LocalPlayer.UserId)] = setData,
+	})
+
+	local remote = ReplicatedStorage:WaitForChild(SyncedPlayerData.RemoteName)
+	assert(remote:IsA("RemoteEvent"), "PlayerDataSync must be a RemoteEvent")
+
+	remote.OnClientEvent:Connect(function(payloads: { CharmSync.SyncPayload })
+		CharmSync.client.patch(payloads)
+	end)
+	remote:FireServer()
+end
+
+return PlayerData
