diff --git a/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau b/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau
new file mode 100644
index 0000000..c993008
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau
@@ -0,0 +1,55 @@
+--!strict
+--[[
+	Shows how many more blocks the player may place, centered just above the hotbar. Turns red at
+	zero.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local create = Vide.create
+local read = Vide.read
+
+-- Keep in sync with BlockPicker: its BOTTOM_MARGIN plus its panel height (TILE_SIZE plus twice
+-- PANEL_PADDING), so the label clears the hotbar.
+local HOTBAR_TOP = 24 + 64 + 8 * 2
+local GAP = 8
+local TEXT_SIZE = 20
+local TEXT_COLOR = Color3.fromRGB(255, 255, 255)
+local EMPTY_COLOR = Color3.fromRGB(255, 95, 85)
+local STROKE_COLOR = Color3.fromRGB(28, 28, 34)
+
+export type BlocksLeftLabelProps = {
+	BlocksLeft: number | () -> number,
+}
+
+local function formatBlocksLeft(count: number): string
+	return if count == 1 then "1 block left" else `{count} blocks left`
+end
+
+local function blocksLeftLabel(props: BlocksLeftLabelProps): TextLabel
+	return create("TextLabel")({
+		Name = "BlocksLeftLabel",
+		AnchorPoint = Vector2.new(0.5, 1),
+		Position = UDim2.new(0.5, 0, 1, -(HOTBAR_TOP + GAP)),
+		AutomaticSize = Enum.AutomaticSize.XY,
+		BackgroundTransparency = 1,
+		FontFace = Font.fromEnum(Enum.Font.BuilderSansBold),
+		TextSize = TEXT_SIZE,
+		Text = function()
+			return formatBlocksLeft(read(props.BlocksLeft))
+		end,
+		TextColor3 = function()
+			return if read(props.BlocksLeft) <= 0 then EMPTY_COLOR else TEXT_COLOR
+		end,
+
+		-- Keeps the text readable over bright sky and blocks.
+		create("UIStroke")({
+			Color = STROKE_COLOR,
+			Thickness = 1.5,
+		}),
+	})
+end
+
+return blocksLeftLabel
