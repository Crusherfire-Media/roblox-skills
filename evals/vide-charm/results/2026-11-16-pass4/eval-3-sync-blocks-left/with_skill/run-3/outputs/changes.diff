diff --git a/src/ReplicatedStorage/Shared/SyncedPlayerData.luau b/src/ReplicatedStorage/Shared/SyncedPlayerData.luau
new file mode 100644
index 0000000..e72212a
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/SyncedPlayerData.luau
@@ -0,0 +1,33 @@
+--!strict
+--[[
+	The per-player data the server owns and CharmSync copies to that player's client. To sync a
+	new value, add a field to Data and its starting value to createDefault; the server writes it
+	with PlayerData.update and the client reads it from PlayerData.getData.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+
+export type Data = {
+	BlocksLeft: number,
+}
+
+local SyncedPlayerData = {}
+
+SyncedPlayerData.RemoteName = "PlayerDataSync"
+
+function SyncedPlayerData.createDefault(): Data
+	return {
+		BlocksLeft = BlockTypes.MaxBlocksPerPlayer,
+	}
+end
+
+--[[
+	CharmSync keys name one signal for every client, so each player's data needs a key of its own.
+]]
+function SyncedPlayerData.getSyncKey(userId: number): string
+	return `PlayerData-{userId}`
+end
+
+return table.freeze(SyncedPlayerData)
