diff --git a/src/StarterPlayer/StarterPlayerScripts/PlayerDataClient.luau b/src/StarterPlayer/StarterPlayerScripts/PlayerDataClient.luau
new file mode 100644
index 0000000..e6cbb28
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/PlayerDataClient.luau
@@ -0,0 +1,47 @@
+--[[
+	The local player's PlayerData, kept in sync with the server by CharmSync. Read it with
+	getData (a Charm getter; UI bridges it with useSignalState). The server owns this data, so
+	the client never sets it: the next patch would overwrite the change.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local PlayerData = require(ReplicatedStorage.Shared.PlayerData)
+
+local PlayerDataClient = {}
+
+local getData, setData = Charm.signal(PlayerData.Default)
+local hasStarted = false
+
+PlayerDataClient.getData = getData
+
+--[[
+	Connects to the server's sync remote and asks it to start sending this player's data. Yields
+	until the remotes exist, so call it after any UI is mounted or from its own thread.
+]]
+function PlayerDataClient.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	CharmSync.client.addSignals({
+		[PlayerData.syncKey(Players.LocalPlayer.UserId)] = setData,
+	})
+
+	local syncRemote = ReplicatedStorage:WaitForChild(PlayerData.SyncRemoteName)
+	local readyRemote = ReplicatedStorage:WaitForChild(PlayerData.ReadyRemoteName)
+	assert(syncRemote:IsA("RemoteEvent"), "PlayerDataSync must be a RemoteEvent")
+	assert(readyRemote:IsA("RemoteEvent"), "PlayerDataReady must be a RemoteEvent")
+
+	-- Connect before firing ready, or the first payload (the full data) is missed.
+	syncRemote.OnClientEvent:Connect(function(payloads: { CharmSync.SyncPayload })
+		CharmSync.client.patch(payloads)
+	end)
+	readyRemote:FireServer()
+end
+
+return PlayerDataClient
