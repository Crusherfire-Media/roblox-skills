diff --git a/src/ServerScriptService/PlayerDataServer.luau b/src/ServerScriptService/PlayerDataServer.luau
new file mode 100644
index 0000000..181f233
--- /dev/null
+++ b/src/ServerScriptService/PlayerDataServer.luau
@@ -0,0 +1,94 @@
+--[[
+	Owns each player's PlayerData while they are in the server and syncs it to that player's
+	client with CharmSync. Other server code reads it with get and changes it with update.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local PlayerData = require(ReplicatedStorage.Shared.PlayerData)
+
+type PlayerData = PlayerData.PlayerData
+
+type PlayerState = {
+	Get: Charm.Getter<PlayerData>,
+	Set: Charm.Setter<PlayerData>,
+	IsSyncing: boolean,
+}
+
+local PlayerDataServer = {}
+
+local states: { [Player]: PlayerState? } = {}
+
+local syncRemote = Instance.new("RemoteEvent")
+syncRemote.Name = PlayerData.SyncRemoteName
+syncRemote.Parent = ReplicatedStorage
+
+local readyRemote = Instance.new("RemoteEvent")
+readyRemote.Name = PlayerData.ReadyRemoteName
+readyRemote.Parent = ReplicatedStorage
+
+local function onPlayerAdded(player: Player)
+	if states[player] then
+		return
+	end
+	local get, set = Charm.signal(PlayerData.Default)
+	states[player] = {
+		Get = get,
+		Set = set,
+		IsSyncing = false,
+	}
+end
+
+-- The client fires this once its sync listener is connected, so the first payload is not lost.
+local function onReady(player: Player)
+	local state = states[player]
+	if not state or state.IsSyncing then
+		return
+	end
+	state.IsSyncing = true
+	CharmSync.server.addSignalsToClient(player, {
+		[PlayerData.syncKey(player.UserId)] = state.Get,
+	})
+end
+
+local function onPlayerRemoving(player: Player)
+	CharmSync.server.removeClient(player)
+	states[player] = nil
+end
+
+--[[
+	Returns the player's current data, or nil once they have left.
+]]
+function PlayerDataServer.get(player: Player): PlayerData?
+	local state = states[player]
+	return if state then state.Get() else nil
+end
+
+--[[
+	Replaces the player's data with what updater returns. The updater must return a new table:
+	Charm compares with ==, so a change made in place never syncs. Does nothing once the player
+	has left.
+]]
+function PlayerDataServer.update(player: Player, updater: (data: PlayerData) -> PlayerData)
+	local state = states[player]
+	if not state then
+		return
+	end
+	state.Set(updater)
+end
+
+CharmSync.server.connect(function(player: Player, payloads: { CharmSync.SyncPayload })
+	syncRemote:FireClient(player, payloads)
+end)
+
+readyRemote.OnServerEvent:Connect(onReady)
+Players.PlayerAdded:Connect(onPlayerAdded)
+Players.PlayerRemoving:Connect(onPlayerRemoving)
+for _, player in Players:GetPlayers() do
+	onPlayerAdded(player)
+end
+
+return PlayerDataServer
