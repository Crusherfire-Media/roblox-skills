new file mode 100644
index 0000000..0df8114
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlocksLeftLabel.luau
@@ -0,0 +1,58 @@
+--[[
+	A small pill just above the hotbar showing how many more blocks the player may place. The
+	count turns red at zero.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local HotbarLayout = require(script.Parent.HotbarLayout)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local create = Vide.create
+
+local GAP_ABOVE_HOTBAR = 8
+local TEXT_SIZE = 20
+local PADDING_X = 12
+local PADDING_Y = 4
+local PANEL_COLOR = Color3.fromRGB(28, 28, 34)
+local TEXT_COLOR = Color3.fromRGB(255, 255, 255)
+local EMPTY_TEXT_COLOR = Color3.fromRGB(255, 110, 100)
+
+export type BlocksLeftLabelProps = {
+	BlocksLeft: () -> number,
+}
+
+local function blocksLeftLabel(props: BlocksLeftLabelProps): TextLabel
+	return create("TextLabel")({
+		Name = "BlocksLeft",
+		AnchorPoint = Vector2.new(0.5, 1),
+		Position = UDim2.new(
+			0.5,
+			0,
+			1,
+			-(HotbarLayout.BottomMargin + HotbarLayout.PanelHeight + GAP_ABOVE_HOTBAR)
+		),
+		AutomaticSize = Enum.AutomaticSize.XY,
+		BackgroundColor3 = PANEL_COLOR,
+		BackgroundTransparency = 0.2,
+		FontFace = Font.fromEnum(Enum.Font.BuilderSansBold),
+		TextSize = TEXT_SIZE,
+		TextColor3 = function()
+			return if props.BlocksLeft() > 0 then TEXT_COLOR else EMPTY_TEXT_COLOR
+		end,
+		Text = function()
+			local blocksLeft = props.BlocksLeft()
+			return if blocksLeft == 1 then "1 block left" else `{blocksLeft} blocks left`
+		end,
+
+		create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+		create("UIPadding")({
+			PaddingLeft = UDim.new(0, PADDING_X),
+			PaddingRight = UDim.new(0, PADDING_X),
+			PaddingTop = UDim.new(0, PADDING_Y),
+			PaddingBottom = UDim.new(0, PADDING_Y),
+		}),
+	})
+end
+
+return blocksLeftLabel
