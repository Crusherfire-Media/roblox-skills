diff --git a/src/ReplicatedStorage/Shared/PlayerData.luau b/src/ReplicatedStorage/Shared/PlayerData.luau
new file mode 100644
index 0000000..f2352f6
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/PlayerData.luau
@@ -0,0 +1,30 @@
+--[[
+	The per-player data the server syncs to each player's own client with CharmSync. The server
+	owns it (PlayerDataServer); the client only reads its copy (PlayerDataClient).
+
+	To sync another value, add a field to PlayerData and its starting value to DEFAULT.
+]]
+
+export type PlayerData = {
+	BlocksPlaced: number,
+}
+
+local DEFAULT: PlayerData = table.freeze({
+	BlocksPlaced = 0,
+})
+
+local PlayerData = {
+	Default = DEFAULT,
+	SyncRemoteName = "PlayerDataSync",
+	ReadyRemoteName = "PlayerDataReady",
+}
+
+--[[
+	The CharmSync key for one player's data. A CharmSync key names one signal for every player,
+	so per-player keys must differ.
+]]
+function PlayerData.syncKey(userId: number): string
+	return `PlayerData-{userId}`
+end
+
+return table.freeze(PlayerData)
