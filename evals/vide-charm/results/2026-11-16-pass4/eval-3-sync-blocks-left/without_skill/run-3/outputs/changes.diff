diff --git a/src/ReplicatedStorage/Shared/PlayerData.luau b/src/ReplicatedStorage/Shared/PlayerData.luau
new file mode 100644
index 0000000..4c90bd9
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/PlayerData.luau
@@ -0,0 +1,37 @@
+--[[
+	The shape of the per-player data the server keeps and syncs to each player's client with
+	CharmSync. The server owns the values; clients only read them.
+
+	To sync another value, add a field to PlayerData and a starting value to Defaults. It reaches
+	the client with no other changes.
+]]
+
+export type PlayerData = {
+	-- How many more blocks the player may place in this server.
+	BlocksLeft: number,
+}
+
+local PlayerData = {}
+
+--[[
+	What a player's data starts as when they join.
+]]
+PlayerData.Defaults = table.freeze({
+	BlocksLeft = 50,
+} :: PlayerData)
+
+--[[
+	Name of the RemoteEvent in ReplicatedStorage that carries sync payloads. The client fires it
+	once when it's ready to receive them; the server fires it with each batch of changes.
+]]
+PlayerData.RemoteName = "PlayerDataSync"
+
+--[[
+	The CharmSync key for one player's data. Keys must be unique per player, because CharmSync
+	shares one key space across every client.
+]]
+function PlayerData.syncKey(userId: number): string
+	return `playerData-{userId}`
+end
+
+return PlayerData
