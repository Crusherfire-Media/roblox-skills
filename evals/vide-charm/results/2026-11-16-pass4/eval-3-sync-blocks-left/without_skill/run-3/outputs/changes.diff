diff --git a/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau b/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau
new file mode 100644
index 0000000..18c6c8c
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/PlayerData.luau
@@ -0,0 +1,49 @@
+--[[
+	The local player's data, synced from the server with CharmSync. Read-only on the client: the
+	server owns it. `get` returns nil until the first sync arrives.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local SharedPlayerData = require(ReplicatedStorage.Shared.PlayerData)
+
+type PlayerData = SharedPlayerData.PlayerData
+
+local getData, setData = Charm.signal(nil :: PlayerData?)
+
+local hasStarted = false
+
+local PlayerData = {}
+
+--[[
+	A Charm getter for the local player's data, or nil before the first sync.
+]]
+PlayerData.get = getData
+
+--[[
+	Starts receiving the local player's data from the server. Yields until the server's sync
+	remote exists, so call it after any UI is mounted or from its own thread.
+]]
+function PlayerData.start()
+	if hasStarted then
+		return
+	end
+	hasStarted = true
+
+	CharmSync.client.addSignals({
+		[SharedPlayerData.syncKey(Players.LocalPlayer.UserId)] = setData,
+	})
+
+	local remote = ReplicatedStorage:WaitForChild(SharedPlayerData.RemoteName)
+	assert(remote:IsA("RemoteEvent"), `{SharedPlayerData.RemoteName} must be a RemoteEvent`)
+	remote.OnClientEvent:Connect(function(payloads: { CharmSync.SyncPayload })
+		CharmSync.client.patch(payloads)
+	end)
+	-- Tell the server we're listening, so it starts sending our data.
+	remote:FireServer()
+end
+
+return PlayerData
