diff --git a/src/ServerScriptService/PlayerData.luau b/src/ServerScriptService/PlayerData.luau
new file mode 100644
index 0000000..1bee1f9
--- /dev/null
+++ b/src/ServerScriptService/PlayerData.luau
@@ -0,0 +1,77 @@
+--[[
+	Server-side store of per-player data (see ReplicatedStorage.Shared.PlayerData for its shape).
+	Each player's data lives in its own Charm signal, which CharmSync replicates to that player
+	only, once their client says it's ready.
+
+	Charm freezes values stored in signals, so change data with PlayerData.update, which hands you
+	the current data and stores whatever new table you return.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local SharedPlayerData = require(ReplicatedStorage.Shared.PlayerData)
+
+type PlayerData = SharedPlayerData.PlayerData
+
+type Entry = {
+	get: Charm.Getter<PlayerData>,
+	set: Charm.Setter<PlayerData>,
+}
+
+local entries: { [Player]: Entry } = {}
+
+local remote = Instance.new("RemoteEvent")
+remote.Name = SharedPlayerData.RemoteName
+remote.Parent = ReplicatedStorage
+
+local function getEntry(player: Player): Entry
+	local entry = entries[player]
+	if not entry then
+		local get, set = Charm.signal(table.clone(SharedPlayerData.Defaults))
+		entry = { get = get, set = set }
+		entries[player] = entry
+	end
+	return entry
+end
+
+local PlayerData = {}
+
+--[[
+	Returns the player's current data. The table is frozen; use PlayerData.update to change it.
+]]
+function PlayerData.get(player: Player): PlayerData
+	return getEntry(player).get()
+end
+
+--[[
+	Replaces the player's data with what `updater` returns. `updater` receives a mutable copy of
+	the current data, so it may change fields in place and return it.
+]]
+function PlayerData.update(player: Player, updater: (data: PlayerData) -> PlayerData)
+	local entry = getEntry(player)
+	entry.set(updater(table.clone(entry.get())))
+end
+
+remote.OnServerEvent:Connect(function(player: Player)
+	-- A ready message can arrive after the player has left; subscribing them then would leak.
+	if player.Parent ~= Players then
+		return
+	end
+	CharmSync.server.addSignalsToClient(player, {
+		[SharedPlayerData.syncKey(player.UserId)] = getEntry(player).get,
+	})
+end)
+
+Players.PlayerRemoving:Connect(function(player: Player)
+	CharmSync.server.removeClient(player)
+	entries[player] = nil
+end)
+
+CharmSync.server.connect(function(player: Player, payloads: { CharmSync.SyncPayload })
+	remote:FireClient(player, payloads)
+end)
+
+return PlayerData
