diff --git a/src/ReplicatedStorage/Shared/PlayerSync.luau b/src/ReplicatedStorage/Shared/PlayerSync.luau
new file mode 100644
index 0000000..38bf763
--- /dev/null
+++ b/src/ReplicatedStorage/Shared/PlayerSync.luau
@@ -0,0 +1,28 @@
+--[[
+	Shared plumbing for syncing per-player state from the server to that player's client with
+	CharmSync. The server keeps each player's values in atoms (ServerScriptService.PlayerState) and
+	the client mirrors its own in atoms of the same names (StarterPlayerScripts.PlayerState).
+
+	To sync another per-player value, add an atom with the same field name to both PlayerState
+	modules. Nothing here needs to change.
+]]
+
+local PlayerSync = {}
+
+-- RemoteEvent the server creates in ReplicatedStorage. The client fires it once (with no
+-- arguments) when it is ready for state; the server fires it with CharmSync payloads.
+PlayerSync.RemoteName = "PlayerSync"
+
+--[[
+	Keys each atom by field name and user ID, for CharmSync's addSignalsToClient and addSignals.
+	CharmSync needs keys that are unique per player, because the server tracks one signal per key.
+]]
+function PlayerSync.keyAtoms<T>(atoms: { [string]: T }, userId: number): { [string]: T }
+	local keyed = {}
+	for field, atom in atoms do
+		keyed[`{field}:{userId}`] = atom
+	end
+	return keyed
+end
+
+return table.freeze(PlayerSync)
