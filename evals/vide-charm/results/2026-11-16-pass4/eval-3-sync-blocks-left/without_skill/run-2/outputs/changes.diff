diff --git a/src/StarterPlayer/StarterPlayerScripts/BlocksLeft.luau b/src/StarterPlayer/StarterPlayerScripts/BlocksLeft.luau
new file mode 100644
index 0000000..9523961
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/BlocksLeft.luau
@@ -0,0 +1,53 @@
+--[[
+	A small label showing how many more blocks the player may place, e.g. "12 blocks left". It is
+	hidden until the count is known and turns red once no blocks are left.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local create = Vide.create
+
+local HEIGHT = 28
+local HORIZONTAL_PADDING = 12
+local PANEL_COLOR = Color3.fromRGB(28, 28, 34)
+local TEXT_COLOR = Color3.fromRGB(240, 240, 245)
+local EMPTY_COLOR = Color3.fromRGB(255, 95, 85)
+
+export type BlocksLeftProps = {
+	-- Blocks left, or nil while unknown.
+	Count: () -> number?,
+	LayoutOrder: number?,
+}
+
+local function blocksLeft(props: BlocksLeftProps): TextLabel
+	return create("TextLabel")({
+		Name = "BlocksLeft",
+		LayoutOrder = props.LayoutOrder,
+		AutomaticSize = Enum.AutomaticSize.X,
+		Size = UDim2.fromOffset(0, HEIGHT),
+		BackgroundColor3 = PANEL_COLOR,
+		BackgroundTransparency = 0.2,
+		FontFace = Font.fromEnum(Enum.Font.BuilderSansBold),
+		TextSize = 18,
+		TextColor3 = function()
+			return if props.Count() == 0 then EMPTY_COLOR else TEXT_COLOR
+		end,
+		Visible = function()
+			return props.Count() ~= nil
+		end,
+		Text = function()
+			local count = props.Count() or 0
+			return if count == 1 then "1 block left" else `{count} blocks left`
+		end,
+
+		create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+		create("UIPadding")({
+			PaddingLeft = UDim.new(0, HORIZONTAL_PADDING),
+			PaddingRight = UDim.new(0, HORIZONTAL_PADDING),
+		}),
+	})
+end
+
+return blocksLeft
