diff --git a/src/ServerScriptService/PlayerState.luau b/src/ServerScriptService/PlayerState.luau
new file mode 100644
index 0000000..bd0dda6
--- /dev/null
+++ b/src/ServerScriptService/PlayerState.luau
@@ -0,0 +1,44 @@
+--[[
+	Server-side per-player state that is synced to each player's own client by
+	PlayerSync.server.luau. Every field must be a Charm atom; the client mirrors each field in an
+	atom of the same name in StarterPlayerScripts.PlayerState.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+
+-- How many blocks one player may place in a server.
+local MAX_BLOCKS_PER_PLAYER = 50
+
+local function createState()
+	return {
+		-- Blocks this player may still place.
+		blocksLeft = Charm.atom(MAX_BLOCKS_PER_PLAYER),
+	}
+end
+
+export type State = typeof(createState())
+
+local states: { [Player]: State } = {}
+
+local PlayerState = {}
+
+--[[
+	Returns the player's state, creating it with default values the first time.
+]]
+function PlayerState.get(player: Player): State
+	local state = states[player]
+	if not state then
+		state = createState()
+		states[player] = state
+	end
+	return state
+end
+
+Players.PlayerRemoving:Connect(function(player: Player)
+	states[player] = nil
+end)
+
+return PlayerState
diff --git a/src/ServerScriptService/PlayerSync.server.luau b/src/ServerScriptService/PlayerSync.server.luau
new file mode 100644
index 0000000..d4d5a57
--- /dev/null
+++ b/src/ServerScriptService/PlayerSync.server.luau
@@ -0,0 +1,40 @@
+--[[
+	Syncs each player's PlayerState to their own client with CharmSync. A client fires the
+	PlayerSync remote once it has registered its atoms; from then on it gets the full state, then
+	patches whenever a value changes.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local PlayerState = require(script.Parent.PlayerState)
+local PlayerSync = require(ReplicatedStorage.Shared.PlayerSync)
+
+local server = CharmSync.server
+
+local remote = Instance.new("RemoteEvent")
+remote.Name = PlayerSync.RemoteName
+remote.Parent = ReplicatedStorage
+
+remote.OnServerEvent:Connect(function(player: Player)
+	-- Leaving players are removed below; don't re-subscribe one whose request arrived late.
+	if player.Parent ~= Players then
+		return
+	end
+	-- Safe to repeat: keys the player already has are left as they are.
+	server.addSignalsToClient(
+		player,
+		PlayerSync.keyAtoms(PlayerState.get(player) :: any, player.UserId)
+	)
+end)
+
+Players.PlayerRemoving:Connect(function(player: Player)
+	server.removeClient(player)
+end)
+
+server.connect(function(player: Player, payloads: { CharmSync.SyncPayload })
+	if player.Parent == Players then
+		remote:FireClient(player, payloads)
+	end
+end)
