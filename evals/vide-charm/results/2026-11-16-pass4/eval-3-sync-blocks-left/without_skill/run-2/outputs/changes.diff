diff --git a/src/StarterPlayer/StarterPlayerScripts/PlayerState.luau b/src/StarterPlayer/StarterPlayerScripts/PlayerState.luau
new file mode 100644
index 0000000..d2bc1c6
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/PlayerState.luau
@@ -0,0 +1,18 @@
+--[[
+	The local player's copy of their server-side state (ServerScriptService.PlayerState), kept up
+	to date by PlayerSync.client.luau. Each field is a Charm atom named like its server
+	counterpart. Values are nil until the server's first sync arrives.
+
+	Read only: the server is the source of truth, so client writes would be overwritten.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Charm = require(ReplicatedStorage.Packages.Charm)
+
+local PlayerState = table.freeze({
+	-- Blocks the local player may still place.
+	blocksLeft = Charm.atom(nil :: number?),
+})
+
+return PlayerState
diff --git a/src/StarterPlayer/StarterPlayerScripts/PlayerSync.client.luau b/src/StarterPlayer/StarterPlayerScripts/PlayerSync.client.luau
new file mode 100644
index 0000000..6c774dc
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/PlayerSync.client.luau
@@ -0,0 +1,25 @@
+--[[
+	Receives the local player's state from the server (see ServerScriptService/PlayerSync.server)
+	and writes it into the atoms in PlayerState.
+]]
+
+local Players = game:GetService("Players")
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local CharmSync = require(ReplicatedStorage.Packages.CharmSync)
+local PlayerState = require(script.Parent.PlayerState)
+local PlayerSync = require(ReplicatedStorage.Shared.PlayerSync)
+
+local client = CharmSync.client
+
+-- Register the atoms before asking for state, so the first payload has somewhere to go.
+client.addSignals(PlayerSync.keyAtoms(PlayerState :: any, Players.LocalPlayer.UserId))
+
+local remote = ReplicatedStorage:WaitForChild(PlayerSync.RemoteName)
+assert(remote:IsA("RemoteEvent"), `{PlayerSync.RemoteName} must be a RemoteEvent`)
+
+remote.OnClientEvent:Connect(function(payloads: { CharmSync.SyncPayload })
+	client.patch(payloads)
+end)
+
+remote:FireServer()
