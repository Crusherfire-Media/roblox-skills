@@ -7,8 +7,10 @@ local ReplicatedStorage = game:GetService("ReplicatedStorage")
 
 local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
 local Vide = require(ReplicatedStorage.Packages.Vide)
+local VideCharm = require(ReplicatedStorage.Packages.VideCharm)
 
 local create = Vide.create
+local useSignalState = VideCharm.useSignalState
 
 type BlockType = BlockTypes.BlockType
 
@@ -54,18 +56,22 @@ local function tile(props: TileProps): TextButton
 end
 
 export type BlockPickerProps = {
+	-- Charm signal (or getter reading Charm signals) with the selected block type's name.
 	Selected: () -> string,
 	Select: (name: string) -> (),
 }
 
 local function blockPicker(props: BlockPickerProps): Frame
+	-- Bridge the Charm signal into a Vide source so the tile strokes update reactively.
+	local selected = useSignalState(props.Selected)
+
 	local tiles = {}
 	for index, blockType in BlockTypes.List do
 		tiles[index] = tile({
 			BlockType = blockType,
 			LayoutOrder = index,
 			IsSelected = function()
-				return props.Selected() == blockType.Name
+				return selected() == blockType.Name
 			end,
 			Select = function()
 				props.Select(blockType.Name)
