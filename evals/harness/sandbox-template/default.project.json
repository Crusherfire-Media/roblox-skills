          "Color": [0.388, 0.373, 0.384]
        }
      },
      "SpawnLocation": {
        "$className": "SpawnLocation",
        "$properties": {
          "Anchored": true,
          "Size": [12, 1, 12],
          "Position": [0, 0.5, 0]
        }
      }
    }
  }
}
