@@ -0,0 +1,80 @@
+--!strict
+--[[
+	The primary action button, from the Figma component "Button/Primary" (22:9).
+	The design has only the enabled look; the disabled look is built from the
+	panel's own colors.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const shadow = require("./Shadow")
+const Theme = require("../Theme")
+
+const changed = Vide.changed
+const create = Vide.create
+const read = Vide.read
+const source = Vide.source
+
+export type Props = {
+	Text: string | () -> string,
+	IsEnabled: boolean | () -> boolean,
+	Name: string?,
+	LayoutOrder: number?,
+	Activated: () -> (),
+}
+
+const SIZE = UDim2.fromOffset(200, 52)
+const LABEL_STYLE = Theme.Text.ButtonLabel
+const ENABLED_GRADIENT = ColorSequence.new(Theme.Colors.PrimaryTop, Theme.Colors.PrimaryBottom)
+const DISABLED_GRADIENT = ColorSequence.new(Theme.Colors.StrokePanel, Theme.Colors.SlotTop)
+
+local function primaryButton(props: Props): TextButton
+	local guiState = source(Enum.GuiState.Idle)
+
+	local function isEnabled(): boolean
+		return read(props.IsEnabled)
+	end
+
+	return create("TextButton")({
+		Name = props.Name or "PrimaryButton",
+		Size = SIZE,
+		LayoutOrder = props.LayoutOrder,
+		BackgroundColor3 = function()
+			return if isEnabled() and guiState() == Enum.GuiState.Press
+				then Theme.Colors.PressedTint
+				else Theme.Colors.White
+		end,
+		Interactable = isEnabled,
+		Activated = function()
+			if isEnabled() then
+				props.Activated()
+			end
+		end,
+
+		changed("GuiState", guiState),
+		create("UICorner")({ CornerRadius = UDim.new(0, Theme.Radius.Button) }),
+		create("UIGradient")({
+			Color = function()
+				return if isEnabled() then ENABLED_GRADIENT else DISABLED_GRADIENT
+			end,
+			Rotation = 90,
+		}),
+		shadow(Theme.Shadows.PrimaryButtonInner),
+
+		create("TextLabel")({
+			Name = "Label",
+			Size = UDim2.fromScale(1, 1),
+			BackgroundTransparency = 1,
+			FontFace = LABEL_STYLE.Font,
+			TextSize = LABEL_STYLE.Size,
+			TextColor3 = function()
+				return if isEnabled() then Theme.Colors.PrimaryLabel else Theme.Colors.TextSecondary
+			end,
+			Text = function()
+				return string.upper(read(props.Text))
+			end,
+		}),
+	}) :: TextButton
+end
+
+return primaryButton
