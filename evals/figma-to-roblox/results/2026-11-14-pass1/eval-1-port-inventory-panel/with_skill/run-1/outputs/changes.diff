+function Module.scale(): number
+	local size = viewportSize()
+	return math.clamp(math.min(size.X, size.Y) / REFERENCE_HEIGHT, 1, MAX_SCALE)
+end
+
+--[[
+	The part of the viewport below the Roblox topbar, in UI units.
+]]
+function Module.usableSize(): Vector2
+	local size = viewportSize()
+	return Vector2.new(size.X, size.Y - topInset()) / Module.scale()
+end
+
+-- UI Labs loads a fresh copy of this module on every reload; a connection
+-- would keep each copy alive until Studio closes.
