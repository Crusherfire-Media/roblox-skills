diff --git a/src/ServerScriptService/Stories/Components/Slot.story.luau b/src/ServerScriptService/Stories/Components/Slot.story.luau
new file mode 100644
index 0000000..ce912ab
--- /dev/null
+++ b/src/ServerScriptService/Stories/Components/Slot.story.luau
@@ -0,0 +1,87 @@
+--!strict
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const slot = require("@game/StarterPlayer/StarterPlayerScripts/UI/Components/Slot")
+
+const create = Vide.create
+const indexes = Vide.indexes
+
+type StoryProps = {
+	controls: {
+		Block: {
+			Name: () -> string,
+			Count: () -> number,
+		},
+		State: {
+			IsSelected: () -> boolean,
+			IsLocked: () -> boolean,
+			UnlockLevel: () -> number,
+		},
+	},
+	target: Frame,
+}
+
+const BLOCK_NAMES = {}
+for _, blockType in BlockTypes.List do
+	table.insert(BLOCK_NAMES, blockType.Name)
+end
+
+const CONTROLS = {
+	Block = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Name = UILabs.Ordered(UILabs.Choose(BLOCK_NAMES), 1),
+			-- 99999 checks the widest count the slot has room for.
+			Count = UILabs.Ordered(UILabs.Slider(48, 0, 99999, 1), 2),
+		}),
+		1
+	),
+	State = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsSelected = UILabs.Ordered(false, 1),
+			IsLocked = UILabs.Ordered(false, 2),
+			-- Shown only while locked.
+			UnlockLevel = UILabs.Ordered(UILabs.Slider(4, 1, 99, 1), 3),
+		}),
+		2
+	),
+}
+
+local function story(props: StoryProps)
+	local controls = props.controls
+
+	return create("Frame")({
+		Size = UDim2.fromScale(1, 1),
+		BackgroundTransparency = 1,
+
+		create("UIListLayout")({
+			HorizontalAlignment = Enum.HorizontalAlignment.Center,
+			VerticalAlignment = Enum.VerticalAlignment.Center,
+		}),
+
+		-- Keyed by the block, since a slot reads its block's art once.
+		indexes(function()
+			return { [controls.Block.Name()] = true }
+		end, function(_, blockName: string)
+			return slot({
+				BlockName = blockName,
+				Count = controls.Block.Count,
+				IsSelected = controls.State.IsSelected,
+				IsLocked = controls.State.IsLocked,
+				UnlockLevel = controls.State.UnlockLevel,
+				Activated = function()
+					print(`Slot {blockName} activated`)
+				end,
+			})
+		end),
+	})
+end
+
+return {
+	summary = "One inventory slot in each state, with any block's art and count.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
