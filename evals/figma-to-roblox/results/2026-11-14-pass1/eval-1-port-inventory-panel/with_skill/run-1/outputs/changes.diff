@@ -0,0 +1,27 @@
+--!strict
+--[[
+	A UIShadow built from a Theme shadow token. Put the result directly under the
+	frame or text object it shades; it takes that object's box and UICorner.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const create = Vide.create
+
+const Theme = require("../Theme")
+
+type ShadowStyle = Theme.ShadowStyle
+
+local function shadow(style: ShadowStyle): Instance
+	return create("UIShadow")({
+		Color = style.Color,
+		Transparency = style.Transparency,
+		Offset = UDim2.fromOffset(style.Offset.X, style.Offset.Y),
+		BlurRadius = UDim.new(0, style.BlurRadius),
+		Spread = UDim2.fromOffset(style.Spread, style.Spread),
+		Inset = style.IsInset,
+		Mode = if style.IsText then Enum.ApplyShadowMode.Text else Enum.ApplyShadowMode.Shape,
+	})
+end
+
+return shadow
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/Slot.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/Slot.luau
new file mode 100644
index 0000000..90e4f52
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Components/Slot.luau
@@ -0,0 +1,152 @@
+--!strict
+--[[
+	One inventory slot, from the Figma component set "Slot" (node 20:1). Its
+	State variant becomes two props, since the game can select a locked block
+	(to show when it unlocks) and the slot must keep its lock look then.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const Assets = require("../Assets")
+const shadow = require("./Shadow")
+const Theme = require("../Theme")
+
+const create = Vide.create
+const read = Vide.read
+const show = Vide.show
+
+export type Props = {
+	BlockName: string,
+	Count: number | () -> number,
+	IsSelected: boolean | () -> boolean,
+	IsLocked: boolean | () -> boolean,
+	UnlockLevel: number | () -> number,
+	LayoutOrder: number?,
+	Activated: () -> (),
+}
+
+const SIZE = 96
+-- The art is 56 square in the design; its baked drop shadow adds 12 a side.
+const ART_SIZE = 80
+const ART_POSITION = UDim2.fromOffset(8, 4)
+const COUNT_POSITION = UDim2.new(1, -8, 1, -6)
+const LOCK_ICON_SIZE = 24
+const LOCK_ICON_POSITION = UDim2.new(0.5, 0, 0.5, -10)
+const UNLOCK_POSITION = UDim2.new(0.5, 0, 1, -8)
+
+const BACKGROUND_GRADIENT = ColorSequence.new(Theme.Colors.SlotTop, Theme.Colors.SlotBottom)
+const COUNT_STYLE = Theme.Text.CaptionCount
+const UNLOCK_STYLE = Theme.Text.CaptionUnlock
+
+local function slot(props: Props): TextButton
+	local function isSelected(): boolean
+		return read(props.IsSelected)
+	end
+
+	local function isLocked(): boolean
+		return read(props.IsLocked)
+	end
+
+	local art = Assets.blockArt(props.BlockName)
+	local lockIcon = Assets.Icons.Lock
+
+	return create("TextButton")({
+		Name = props.BlockName,
+		Size = UDim2.fromOffset(SIZE, SIZE),
+		LayoutOrder = props.LayoutOrder,
+		BackgroundColor3 = Theme.Colors.White,
+		Activated = props.Activated,
+
+		create("UICorner")({ CornerRadius = UDim.new(0, Theme.Radius.Slot) }),
+		create("UIGradient")({
+			Color = BACKGROUND_GRADIENT,
+			Rotation = 90,
+		}),
+		create("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			Color = function()
+				return if isSelected() then Theme.Colors.Accent else Theme.Colors.StrokePanel
+			end,
+			Thickness = function()
+				return if isSelected()
+					then Theme.StrokeWidth.SlotSelected
+					else Theme.StrokeWidth.Slot
+			end,
+			BorderStrokePosition = function()
+				return if isSelected()
+					then Enum.BorderStrokePosition.Outer
+					else Enum.BorderStrokePosition.Inner
+			end,
+		}),
+		show(isSelected, function()
+			return shadow(Theme.Shadows.SlotSelectedGlow)
+		end),
+
+		create("ImageLabel")({
+			Name = "BlockArt",
+			Position = ART_POSITION,
+			Size = UDim2.fromOffset(ART_SIZE, ART_SIZE),
+			BackgroundTransparency = 1,
+			Image = art.Image,
+			ImageRectOffset = art.Offset,
+			ImageRectSize = art.Size,
+			ScaleType = Enum.ScaleType.Fit,
+			ImageTransparency = function()
+				return if isLocked() then Theme.Transparency.LockedContent else 0
+			end,
+		}),
+
+		create("TextLabel")({
+			Name = "Count",
+			AnchorPoint = Vector2.new(1, 1),
+			Position = COUNT_POSITION,
+			Size = UDim2.fromOffset(0, COUNT_STYLE.LineHeight),
+			AutomaticSize = Enum.AutomaticSize.X,
+			BackgroundTransparency = 1,
+			FontFace = COUNT_STYLE.Font,
+			TextSize = COUNT_STYLE.Size,
+			TextColor3 = Theme.Colors.TextPrimary,
+			TextXAlignment = Enum.TextXAlignment.Right,
+			Text = function()
+				return `x{read(props.Count)}`
+			end,
+			Visible = function()
+				return not isLocked()
+			end,
+
+			shadow(Theme.Shadows.CountText),
+		}),
+
+		create("ImageLabel")({
+			Name = "LockIcon",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = LOCK_ICON_POSITION,
+			Size = UDim2.fromOffset(LOCK_ICON_SIZE, LOCK_ICON_SIZE),
+			BackgroundTransparency = 1,
+			Image = lockIcon.Image,
+			ImageRectOffset = lockIcon.Offset,
+			ImageRectSize = lockIcon.Size,
+			ImageColor3 = Theme.Colors.TextPrimary,
+			ScaleType = Enum.ScaleType.Fit,
+			Visible = isLocked,
+		}),
+
+		create("TextLabel")({
+			Name = "UnlockLabel",
+			AnchorPoint = Vector2.new(0.5, 1),
+			Position = UNLOCK_POSITION,
+			Size = UDim2.fromOffset(0, UNLOCK_STYLE.LineHeight),
+			AutomaticSize = Enum.AutomaticSize.X,
+			BackgroundTransparency = 1,
+			FontFace = UNLOCK_STYLE.Font,
+			TextSize = UNLOCK_STYLE.Size,
+			TextColor3 = Theme.Colors.TextPrimary,
+			Text = function()
+				return `Lv {read(props.UnlockLevel)}`
+			end,
+			Visible = isLocked,
+		}),
+	}) :: TextButton
+end
+
+return slot
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel.luau
new file mode 100644
index 0000000..99b644a
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel.luau
@@ -0,0 +1,74 @@
+--!strict
+--[[
+	The inventory panel connected to the game: the block types from BlockTypes,
+	counts and unlock levels from BlockInventory, and equipping through
+	BlockPlacer. Build it inside a Vide scope; it listens to the game for as long
+	as that scope lives.
+]]
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockInventory = require("../BlockInventory")
+const BlockPlacer = require("../BlockPlacer")
+const inventoryPanelView = require("./InventoryPanelView")
+const Screen = require("./Screen")
+
+const cleanup = Vide.cleanup
+const source = Vide.source
+
+export type Props = {
+	Close: () -> (),
+}
+
+local function readCounts(): { [string]: number? }
+	local counts = {}
+	for _, blockType in BlockTypes.List do
+		counts[blockType.Name] = BlockInventory.getCount(blockType.Name)
+	end
+	return table.freeze(counts)
+end
+
+local function inventoryPanel(props: Props): Frame
+	local blocks = {}
+	for _, blockType in BlockTypes.List do
+		table.insert(blocks, {
+			Name = blockType.Name,
+			DisplayName = blockType.DisplayName,
+			UnlockLevel = BlockInventory.getUnlockLevel(blockType.Name),
+		})
+	end
+
+	local counts = source(readCounts())
+	local playerLevel = source(BlockInventory.getLevel())
+	local equippedName = source(BlockPlacer.getBlockType())
+	local selectedName = source(BlockPlacer.getBlockType())
+
+	cleanup(BlockInventory.Changed:Connect(function()
+		counts(readCounts())
+		playerLevel(BlockInventory.getLevel())
+	end))
+	cleanup(BlockPlacer.BlockTypeChanged:Connect(function(name: string)
+		equippedName(name)
+	end))
+
+	return inventoryPanelView({
+		Blocks = blocks,
+		Counts = counts,
+		PlayerLevel = playerLevel,
+		SelectedName = selectedName,
+		EquippedName = equippedName,
+		AvailableSize = Screen.usableSize,
+		Select = function(name: string)
+			selectedName(name)
+		end,
+		Equip = function(name: string)
+			if BlockInventory.isUnlocked(name) then
+				BlockPlacer.setBlockType(name)
+			end
+		end,
+		Close = props.Close,
+	})
+end
+
+return inventoryPanel
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanelView.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanelView.luau
new file mode 100644
index 0000000..53109f7
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanelView.luau
@@ -0,0 +1,294 @@
+--!strict
+--[[
+	The inventory panel from the Figma frame "Inventory / Desktop" (12:340),
+	drawn from props only so a story can show it. InventoryPanel connects it to
+	the game.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const Assets = require("./Assets")
+const iconButton = require("./Components/IconButton")
+const primaryButton = require("./Components/PrimaryButton")
+const shadow = require("./Components/Shadow")
+const slot = require("./Components/Slot")
+const Theme = require("./Theme")
+
+const create = Vide.create
+const derive = Vide.derive
+const read = Vide.read
+
+export type Block = {
+	Name: string,
+	DisplayName: string,
+	UnlockLevel: number,
+}
+
+export type Props = {
+	-- In the order the slots show.
+	Blocks: { Block },
+	Counts: { [string]: number? } | () -> { [string]: number? },
+	PlayerLevel: number | () -> number,
+	SelectedName: string | () -> string,
+	EquippedName: string | () -> string,
+	-- The room the panel may use, in UI units. The panel shrinks to fit it,
+	-- never below half size; nil keeps it at its design size.
+	AvailableSize: (Vector2 | () -> Vector2?)?,
+	Select: (name: string) -> (),
+	Equip: (name: string) -> (),
+	Close: () -> (),
+}
+
+const WIDTH = 720
+const PADDING_X = 28
+const PADDING_Y = 24
+const SECTION_GAP = 16
+const HEADER_HEIGHT = 44
+const FOOTER_HEIGHT = 52
+const FOOTER_GAP = 16
+const SLOT_SIZE = 96
+const SLOT_GAP = 12
+const EDGE_PADDING = 16
+const MINIMUM_FIT_SCALE = 0.5
+
+const TITLE_STYLE = Theme.Text.HeadingTitle
+const NAME_STYLE = Theme.Text.BodyMedium
+const PATTERN_INSET = Theme.StrokeWidth.Panel
+
+local function designSize(slotCount: number): Vector2
+	local innerWidth = WIDTH - PADDING_X * 2
+	local columns = math.max(1, (innerWidth + SLOT_GAP) // (SLOT_SIZE + SLOT_GAP))
+	local rows = math.max(1, math.ceil(slotCount / columns))
+	local gridHeight = rows * SLOT_SIZE + (rows - 1) * SLOT_GAP
+	local height = PADDING_Y * 2 + HEADER_HEIGHT + gridHeight + FOOTER_HEIGHT + SECTION_GAP * 2
+	return Vector2.new(WIDTH, height)
+end
+
+local function inventoryPanelView(props: Props): Frame
+	local blocksByName: { [string]: Block? } = {}
+	for _, block in props.Blocks do
+		blocksByName[block.Name] = block
+	end
+
+	local size = designSize(#props.Blocks)
+
+	local function isUnlocked(name: string): boolean
+		local block = blocksByName[name]
+		return block == nil or read(props.PlayerLevel) >= block.UnlockLevel
+	end
+
+	local selectedBlock = derive(function(): Block?
+		return blocksByName[read(props.SelectedName)]
+	end)
+
+	local isSelectedEquipped = derive(function(): boolean
+		return read(props.SelectedName) == read(props.EquippedName)
+	end)
+
+	local isSelectedUnlocked = derive(function(): boolean
+		return isUnlocked(read(props.SelectedName))
+	end)
+
+	local function fitScale(): number
+		local available: Vector2? = read(props.AvailableSize)
+		if not available then
+			return 1
+		end
+		local fit = math.min(
+			(available.X - EDGE_PADDING * 2) / size.X,
+			(available.Y - EDGE_PADDING * 2) / size.Y
+		)
+		return math.clamp(fit, MINIMUM_FIT_SCALE, 1)
+	end
+
+	local slots = {}
+	for index, block in props.Blocks do
+		table.insert(
+			slots,
+			slot({
+				BlockName = block.Name,
+				Count = function()
+					return read(props.Counts)[block.Name] or 0
+				end,
+				IsSelected = function()
+					return read(props.SelectedName) == block.Name
+				end,
+				IsLocked = function()
+					return not isUnlocked(block.Name)
+				end,
+				UnlockLevel = block.UnlockLevel,
+				LayoutOrder = index,
+				Activated = function()
+					props.Select(block.Name)
+				end,
+			})
+		)
+	end
+
+	return create("Frame")({
+		Name = "InventoryPanel",
+		AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.5),
+		Size = UDim2.fromOffset(size.X, size.Y),
+		BackgroundColor3 = Theme.Colors.SurfacePanel,
+		BackgroundTransparency = Theme.Transparency.SurfacePanel,
+		-- Takes clicks on the panel's background, so they place no block behind it.
+		Active = true,
+
+		create("UIScale")({ Scale = fitScale }),
+		create("UICorner")({ CornerRadius = UDim.new(0, Theme.Radius.Panel) }),
+		create("UIStroke")({
+			Color = Theme.Colors.StrokePanel,
+			Thickness = Theme.StrokeWidth.Panel,
+			BorderStrokePosition = Enum.BorderStrokePosition.Inner,
+		}),
+		shadow(Theme.Shadows.Panel),
+
+		create("ImageLabel")({
+			Name = "HexPattern",
+			Position = UDim2.fromOffset(PATTERN_INSET, PATTERN_INSET),
+			Size = UDim2.new(1, -PATTERN_INSET * 2, 1, -PATTERN_INSET * 2),
+			BackgroundTransparency = 1,
+			Image = Assets.HexPattern.Image,
+			ImageColor3 = Theme.Colors.White,
+			ImageTransparency = Theme.Transparency.HexPattern,
+			ScaleType = Enum.ScaleType.Tile,
+			TileSize = Assets.HexPattern.TileSize,
+
+			create("UICorner")({
+				CornerRadius = UDim.new(0, Theme.Radius.Panel - PATTERN_INSET),
+			}),
+		}),
+
+		create("Frame")({
+			Name = "Content",
+			Size = UDim2.fromScale(1, 1),
+			BackgroundTransparency = 1,
+
+			create("UIPadding")({
+				PaddingLeft = UDim.new(0, PADDING_X),
+				PaddingRight = UDim.new(0, PADDING_X),
+				PaddingTop = UDim.new(0, PADDING_Y),
+				PaddingBottom = UDim.new(0, PADDING_Y),
+			}),
+			create("UIListLayout")({
+				FillDirection = Enum.FillDirection.Vertical,
+				Padding = UDim.new(0, SECTION_GAP),
+			}),
+
+			create("Frame")({
+				Name = "Header",
+				LayoutOrder = 1,
+				Size = UDim2.new(1, 0, 0, HEADER_HEIGHT),
+				BackgroundTransparency = 1,
+
+				create("UIListLayout")({
+					FillDirection = Enum.FillDirection.Horizontal,
+					HorizontalFlex = Enum.UIFlexAlignment.SpaceBetween,
+					VerticalAlignment = Enum.VerticalAlignment.Center,
+				}),
+
+				create("TextLabel")({
+					Name = "Title",
+					LayoutOrder = 1,
+					Size = UDim2.fromOffset(0, TITLE_STYLE.LineHeight),
+					AutomaticSize = Enum.AutomaticSize.X,
+					BackgroundTransparency = 1,
+					FontFace = TITLE_STYLE.Font,
+					TextSize = TITLE_STYLE.Size,
+					TextColor3 = Theme.Colors.TextPrimary,
+					TextXAlignment = Enum.TextXAlignment.Left,
+					Text = "INVENTORY",
+
+					shadow(Theme.Shadows.TitleText),
+				}),
+
+				iconButton({
+					Name = "CloseButton",
+					LayoutOrder = 2,
+					Icon = Assets.Icons.Close,
+					Activated = props.Close,
+				}),
+			}),
+
+			create("Frame")({
+				Name = "SlotGrid",
+				LayoutOrder = 2,
+				Size = UDim2.fromScale(1, 0),
+				AutomaticSize = Enum.AutomaticSize.Y,
+				BackgroundTransparency = 1,
+
+				create("UIGridLayout")({
+					CellSize = UDim2.fromOffset(SLOT_SIZE, SLOT_SIZE),
+					CellPadding = UDim2.fromOffset(SLOT_GAP, SLOT_GAP),
+				}),
+
+				slots,
+			}),
+
+			create("Frame")({
+				Name = "Footer",
+				LayoutOrder = 3,
+				Size = UDim2.new(1, 0, 0, FOOTER_HEIGHT),
+				BackgroundTransparency = 1,
+
+				create("UIListLayout")({
+					FillDirection = Enum.FillDirection.Horizontal,
+					VerticalAlignment = Enum.VerticalAlignment.Center,
+					Padding = UDim.new(0, FOOTER_GAP),
+				}),
+
+				create("TextLabel")({
+					Name = "SelectedName",
+					LayoutOrder = 1,
+					Size = UDim2.fromOffset(0, NAME_STYLE.LineHeight),
+					BackgroundTransparency = 1,
+					FontFace = NAME_STYLE.Font,
+					TextSize = NAME_STYLE.Size,
+					TextColor3 = Theme.Colors.TextSecondary,
+					TextXAlignment = Enum.TextXAlignment.Left,
+					TextTruncate = Enum.TextTruncate.AtEnd,
+					Text = function()
+						local block = selectedBlock()
+						if not block then
+							return "Pick a block"
+						elseif isSelectedUnlocked() then
+							return block.DisplayName
+						else
+							return `{block.DisplayName} · Unlocks at level {block.UnlockLevel}`
+						end
+					end,
+
+					create("UIFlexItem")({ FlexMode = Enum.UIFlexMode.Fill }),
+				}),
+
+				primaryButton({
+					Name = "EquipButton",
+					LayoutOrder = 2,
+					Text = function()
+						if not isSelectedUnlocked() then
+							return "Locked"
+						elseif isSelectedEquipped() then
+							return "Equipped"
+						else
+							return "Equip"
+						end
+					end,
+					IsEnabled = function()
+						return selectedBlock() ~= nil
+							and isSelectedUnlocked()
+							and not isSelectedEquipped()
+					end,
+					Activated = function()
+						local block = selectedBlock()
+						if block and isUnlocked(block.Name) then
+							props.Equip(block.Name)
+						end
+					end,
+				}),
+			}),
+		}),
+	}) :: Frame
+end
+
+return inventoryPanelView
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Screen.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Screen.luau
