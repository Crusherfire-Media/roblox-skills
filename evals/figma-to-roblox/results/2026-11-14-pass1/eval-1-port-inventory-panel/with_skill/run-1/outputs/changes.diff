diff --git a/src/ServerScriptService/Stories/InventoryPanelView.story.luau b/src/ServerScriptService/Stories/InventoryPanelView.story.luau
new file mode 100644
index 0000000..d57f6bc
--- /dev/null
+++ b/src/ServerScriptService/Stories/InventoryPanelView.story.luau
@@ -0,0 +1,116 @@
+--!strict
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockInventory = require("@game/StarterPlayer/StarterPlayerScripts/BlockInventory")
+const inventoryPanelView = require("@game/StarterPlayer/StarterPlayerScripts/UI/InventoryPanelView")
+
+const source = Vide.source
+
+type Block = inventoryPanelView.Block
+
+type StoryProps = {
+	controls: {
+		Player: {
+			Level: () -> number,
+			Counts: () -> string,
+		},
+		Layout: {
+			Screen: () -> string,
+		},
+	},
+	target: Frame,
+}
+
+const HUGE_COUNT = 99999
+-- Usable size below the topbar, in UI units. A missing entry keeps the design size.
+const SCREENS: { [string]: Vector2? } = {
+	["1080p monitor"] = Vector2.new(1920, 1022),
+	["Small phone"] = Vector2.new(667, 317),
+}
+
+const CONTROLS = {
+	Player = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- The game's unlock levels are 4, 6, and 10.
+			Level = UILabs.Ordered(UILabs.Slider(3, 1, 12, 1), 1),
+			Counts = UILabs.Ordered(UILabs.Choose({ "Sample", "Empty", "Huge" }), 2),
+		}),
+		1
+	),
+	Layout = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Screen = UILabs.Ordered(
+				UILabs.Choose({ "Design size", "1080p monitor", "Small phone" }),
+				1
+			),
+		}),
+		2
+	),
+}
+
+local function buildBlocks(): { Block }
+	local blocks = {}
+	for _, blockType in BlockTypes.List do
+		table.insert(blocks, {
+			Name = blockType.Name,
+			DisplayName = blockType.DisplayName,
+			UnlockLevel = BlockInventory.getUnlockLevel(blockType.Name),
+		})
+	end
+	return blocks
+end
+
+local function buildCounts(preset: string): { [string]: number? }
+	local counts = {}
+	for _, blockType in BlockTypes.List do
+		if preset == "Sample" then
+			counts[blockType.Name] = BlockInventory.getCount(blockType.Name)
+		elseif preset == "Huge" then
+			counts[blockType.Name] = HUGE_COUNT
+		else
+			counts[blockType.Name] = 0
+		end
+	end
+	return counts
+end
+
+local function story(props: StoryProps)
+	local controls = props.controls
+	local blocks = buildBlocks()
+	local selectedName = source(blocks[1].Name)
+	local equippedName = source(blocks[1].Name)
+
+	return inventoryPanelView({
+		Blocks = blocks,
+		Counts = function()
+			return buildCounts(controls.Player.Counts())
+		end,
+		PlayerLevel = controls.Player.Level,
+		SelectedName = selectedName,
+		EquippedName = equippedName,
+		AvailableSize = function()
+			return SCREENS[controls.Layout.Screen()]
+		end,
+		Select = function(name: string)
+			selectedName(name)
+		end,
+		Equip = function(name: string)
+			print(`Equipped {name}`)
+			equippedName(name)
+		end,
+		Close = function()
+			print("Close activated")
+		end,
+	})
+end
+
+return {
+	summary = "The inventory panel with the game's ten block types. Click a slot to select it "
+		.. "and Equip to equip it. Layout > Screen shrinks the panel the way a phone would.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
