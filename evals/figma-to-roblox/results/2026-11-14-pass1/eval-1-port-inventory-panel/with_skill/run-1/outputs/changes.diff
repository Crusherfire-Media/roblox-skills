@@ -0,0 +1,61 @@
+--!strict
+--[[
+	A round icon button, from the Figma component "Button/Icon" (22:7).
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const Theme = require("../Theme")
+
+const changed = Vide.changed
+const create = Vide.create
+const source = Vide.source
+
+const Assets = require("../Assets")
+
+type Sprite = Assets.Sprite
+
+export type Props = {
+	Icon: Sprite,
+	Name: string?,
+	LayoutOrder: number?,
+	Activated: () -> (),
+}
+
+const SIZE = 44
+const ICON_SIZE = 20
+
+local function iconButton(props: Props): TextButton
+	local guiState = source(Enum.GuiState.Idle)
+
+	return create("TextButton")({
+		Name = props.Name or "IconButton",
+		Size = UDim2.fromOffset(SIZE, SIZE),
+		LayoutOrder = props.LayoutOrder,
+		BackgroundColor3 = Theme.Colors.White,
+		BackgroundTransparency = function()
+			return if guiState() == Enum.GuiState.Idle
+				then Theme.Transparency.IconButton
+				else Theme.Transparency.IconButtonHover
+		end,
+		Activated = props.Activated,
+
+		changed("GuiState", guiState),
+		create("UICorner")({ CornerRadius = UDim.new(1, 0) }),
+
+		create("ImageLabel")({
+			Name = "Icon",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0.5),
+			Size = UDim2.fromOffset(ICON_SIZE, ICON_SIZE),
+			BackgroundTransparency = 1,
+			Image = props.Icon.Image,
+			ImageRectOffset = props.Icon.Offset,
+			ImageRectSize = props.Icon.Size,
+			ImageColor3 = Theme.Colors.TextPrimary,
+			ScaleType = Enum.ScaleType.Fit,
+		}),
+	}) :: TextButton
+end
+
+return iconButton
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/PrimaryButton.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/PrimaryButton.luau
new file mode 100644
