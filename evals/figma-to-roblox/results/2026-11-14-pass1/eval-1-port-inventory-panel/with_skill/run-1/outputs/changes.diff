+--!strict
+--[[
+	Design tokens from the Figma file "Block Builder - UI"
+	(design/figma/inventory-panel.json), named as the design names them. Sizes
+	are offsets for a screen 1080 pixels tall; the Figma frame is 1920x1080, so
+	its numbers are used as they are. Figma alpha becomes transparency 1 - alpha.
+]]
+
+export type TextStyle = {
+	Font: Font,
+	Size: number,
+	LineHeight: number,
+	IsUppercase: boolean,
+}
+
+export type ShadowStyle = {
+	Color: Color3,
+	Transparency: number,
+	Offset: Vector2,
+	BlurRadius: number,
+	Spread: number,
+	IsInset: boolean,
+	IsText: boolean,
+}
+
+const BUILDER_SANS = "rbxasset://fonts/families/BuilderSans.json"
+
+local Module = {}
+
+Module.Colors = table.freeze({
+	-- Style "Surface/Panel"
+	SurfacePanel = Color3.fromRGB(23, 26, 38),
+	StrokePanel = Color3.fromRGB(58, 64, 96),
+	-- Style "Text/Primary"
+	TextPrimary = Color3.fromRGB(245, 246, 250),
+	TextSecondary = Color3.fromRGB(199, 204, 224),
+	Accent = Color3.fromRGB(255, 200, 60),
+	SlotTop = Color3.fromRGB(43, 49, 80),
+	SlotBottom = Color3.fromRGB(32, 37, 59),
+	PrimaryTop = Color3.fromRGB(255, 210, 90),
+	PrimaryBottom = Color3.fromRGB(255, 159, 28),
+	PrimaryLabel = Color3.fromRGB(59, 35, 0),
+	White = Color3.new(1, 1, 1),
+	-- Not in the design: multiplies the button gradient while it is pressed.
+	PressedTint = Color3.fromRGB(215, 215, 215),
+})
+
+Module.Transparency = table.freeze({
+	-- The design's fill is 0.92 alpha over a 24 pixel background blur. Roblox
+	-- can't blur what sits behind one frame, so the fill is made more opaque.
+	SurfacePanel = 0.04,
+	IconButton = 0.92,
+	-- Not in the design: hover for the close button.
+	IconButtonHover = 0.84,
+	HexPattern = 0.94,
+	-- The Locked variant's content is at 0.4 opacity.
+	LockedContent = 0.6,
+})
+
+Module.Text = table.freeze({
+	-- Style "Heading/Title" has +2 letter spacing, which Roblox can't draw.
+	HeadingTitle = table.freeze({
+		Font = Font.new(BUILDER_SANS, Enum.FontWeight.Bold),
+		Size = 28,
+		LineHeight = 34,
+		IsUppercase = true,
+	}),
+	-- Style "Body/Medium"
+	BodyMedium = table.freeze({
+		Font = Font.new(BUILDER_SANS, Enum.FontWeight.Medium),
+		Size = 18,
+		LineHeight = 24,
+		IsUppercase = false,
+	}),
+	-- Style "Caption/Count"
+	CaptionCount = table.freeze({
+		Font = Font.new(BUILDER_SANS, Enum.FontWeight.Bold),
+		Size = 16,
+		LineHeight = 20,
+		IsUppercase = false,
+	}),
+	CaptionUnlock = table.freeze({
+		Font = Font.new(BUILDER_SANS, Enum.FontWeight.Bold),
+		Size = 14,
+		LineHeight = 18,
+		IsUppercase = false,
+	}),
+	ButtonLabel = table.freeze({
+		Font = Font.new(BUILDER_SANS, Enum.FontWeight.ExtraBold),
+		Size = 20,
+		LineHeight = 24,
+		IsUppercase = true,
+	}),
+})
+
+Module.Radius = table.freeze({
+	Panel = 16,
+	Slot = 12,
+	Button = 12,
+})
+
+Module.StrokeWidth = table.freeze({
+	Panel = 2,
+	Slot = 1,
+	SlotSelected = 3,
+})
+
+Module.Shadows = table.freeze({
+	Panel = table.freeze({
+		Color = Color3.new(0, 0, 0),
+		Transparency = 0.55,
+		Offset = Vector2.new(0, 12),
+		BlurRadius = 32,
+		Spread = 0,
+		IsInset = false,
+		IsText = false,
+	}),
+	TitleText = table.freeze({
+		Color = Color3.new(0, 0, 0),
+		Transparency = 0.5,
+		Offset = Vector2.new(0, 2),
+		BlurRadius = 0,
+		Spread = 0,
+		IsInset = false,
+		IsText = true,
+	}),
+	CountText = table.freeze({
+		Color = Color3.new(0, 0, 0),
+		Transparency = 0.4,
+		Offset = Vector2.new(0, 1),
+		BlurRadius = 2,
+		Spread = 0,
+		IsInset = false,
+		IsText = true,
+	}),
+	SlotSelectedGlow = table.freeze({
+		Color = Color3.fromRGB(255, 200, 60),
+		Transparency = 0.45,
+		Offset = Vector2.zero,
+		BlurRadius = 16,
+		Spread = 2,
+		IsInset = false,
+		IsText = false,
+	}),
+	PrimaryButtonInner = table.freeze({
+		Color = Color3.new(0, 0, 0),
+		Transparency = 0.75,
+		Offset = Vector2.new(0, -3),
+		BlurRadius = 0,
+		Spread = 0,
+		IsInset = true,
+		IsText = false,
+	}),
+})
+
+return table.freeze(Module)
