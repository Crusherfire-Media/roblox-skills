diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Assets.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Assets.luau
new file mode 100644
index 0000000..72564cf
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Assets.luau
@@ -0,0 +1,85 @@
+--!strict
+--[[
+	Every uploaded image the UI draws, with its sprite rects. What each image
+	holds and how to export it is in docs/figma/inventory-assets.md. Rects are in
+	pixels of the uploaded image, which is exported at 2x the size it shows.
+]]
+
+export type Sprite = {
+	Image: string,
+	Offset: Vector2,
+	Size: Vector2,
+}
+
+-- Replace with the real ids once the images are uploaded.
+const PLACEHOLDER_HEX_PATTERN = "rbxassetid://0"
+const PLACEHOLDER_ICONS = "rbxassetid://0"
+const PLACEHOLDER_BLOCK_ART = "rbxassetid://0"
+
+const BLOCK_ART_CELL = 168
+const BLOCK_ART_GUTTER = 4
+const BLOCK_ART_SIZE = 160
+const BLOCK_ART_COLUMNS = 6
+-- Cell index on the block art sheet, counted left to right, then top to bottom.
+const BLOCK_ART_CELLS: { [string]: number? } = {
+	Brick = 0,
+	Dirt = 1,
+	Grass = 2,
+	Window = 3,
+	Wood = 4,
+	Stone = 5,
+	Sand = 6,
+	Ice = 7,
+	Lamp = 8,
+	Gold = 9,
+}
+
+local Module = {}
+
+Module.HexPattern = table.freeze({
+	Image = PLACEHOLDER_HEX_PATTERN,
+	-- One repeat of the pattern, in offsets.
+	TileSize = UDim2.fromOffset(112, 192),
+})
+
+Module.Icons = table.freeze({
+	Close = table.freeze({
+		Image = PLACEHOLDER_ICONS,
+		Offset = Vector2.new(12, 12),
+		Size = Vector2.new(40, 40),
+	}),
+	Lock = table.freeze({
+		Image = PLACEHOLDER_ICONS,
+		Offset = Vector2.new(72, 8),
+		Size = Vector2.new(48, 48),
+	}),
+})
+
+--[[
+	The art for a block type, with its drop shadow baked in. A type with no cell
+	on the sheet gets an empty sprite, so a new block type shows a blank slot
+	instead of erroring.
+]]
+function Module.blockArt(name: string): Sprite
+	local index = BLOCK_ART_CELLS[name]
+	if index == nil then
+		return {
+			Image = "",
+			Offset = Vector2.zero,
+			Size = Vector2.zero,
+		}
+	end
+
+	local column = index % BLOCK_ART_COLUMNS
+	local row = index // BLOCK_ART_COLUMNS
+	return {
+		Image = PLACEHOLDER_BLOCK_ART,
+		Offset = Vector2.new(
+			column * BLOCK_ART_CELL + BLOCK_ART_GUTTER,
+			row * BLOCK_ART_CELL + BLOCK_ART_GUTTER
+		),
+		Size = Vector2.new(BLOCK_ART_SIZE, BLOCK_ART_SIZE),
+	}
+end
+
+return table.freeze(Module)
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Components/IconButton.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Components/IconButton.luau
