diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryAssets.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryAssets.luau
new file mode 100644
index 0000000..4f01bf8
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryAssets.luau
@@ -0,0 +1,94 @@
+--!strict
+--[[
+	Every uploaded image the inventory panel draws: asset ids, sheet cells, and
+	sprite rects. How each one is exported is in docs/figma/inventory-assets.md.
+	Ids of 0 are placeholders until the art is uploaded.
+]]
+
+const PLACEHOLDER_IMAGE = "rbxassetid://0"
+
+-- 880 x 352 sheet of 176 px cells: each block's art and drop shadow, at 2x.
+const BLOCK_ART_IMAGE = PLACEHOLDER_IMAGE
+const BLOCK_ART_CELL = 176
+const BLOCK_ART_COLUMNS = 5
+-- Sheet order, left to right then top to bottom. Keep in sync with the
+-- exported sheet, not with BlockTypes, so adding a block type moves no rect.
+const BLOCK_ART_ORDER = {
+	"Brick",
+	"Dirt",
+	"Grass",
+	"Window",
+	"Wood",
+	"Stone",
+	"Sand",
+	"Ice",
+	"Lamp",
+	"Gold",
+}
+
+-- 128 x 64 sheet of 64 px cells, white glyphs at 2x for tinting.
+const ICON_IMAGE = PLACEHOLDER_IMAGE
+const ICON_CELL = 64
+
+-- 224 x 384 seamless tile at 2x, white at full opacity.
+const HEX_PATTERN_IMAGE = PLACEHOLDER_IMAGE
+const HEX_PATTERN_TILE_SIZE = UDim2.fromOffset(112, 192)
+
+export type Sprite = {
+	Image: string,
+	RectOffset: Vector2,
+	RectSize: Vector2,
+}
+
+export type Tile = {
+	Image: string,
+	TileSize: UDim2,
+}
+
+local Module = {}
+
+local blockArt: { [string]: Sprite? } = {}
+for index, name in BLOCK_ART_ORDER do
+	local column = (index - 1) % BLOCK_ART_COLUMNS
+	local row = (index - 1) // BLOCK_ART_COLUMNS
+	blockArt[name] = table.freeze({
+		Image = BLOCK_ART_IMAGE,
+		RectOffset = Vector2.new(column, row) * BLOCK_ART_CELL,
+		RectSize = Vector2.new(BLOCK_ART_CELL, BLOCK_ART_CELL),
+	})
+end
+
+local function iconSprite(column: number): Sprite
+	return table.freeze({
+		Image = ICON_IMAGE,
+		RectOffset = Vector2.new(column * ICON_CELL, 0),
+		RectSize = Vector2.new(ICON_CELL, ICON_CELL),
+	})
+end
+
+-- Shown in an 88 x 88 box at slot offset (4, 4), so the art lands at (20, 16).
+Module.BlockArtBoxSize = Vector2.new(88, 88)
+-- Icon cells hold their glyph with padding, so they draw in a 32 x 32 box.
+Module.IconBoxSize = Vector2.new(32, 32)
+
+Module.Close = iconSprite(0)
+Module.Lock = iconSprite(1)
+
+Module.HexPattern = table.freeze({
+	Image = HEX_PATTERN_IMAGE,
+	TileSize = HEX_PATTERN_TILE_SIZE,
+}) :: Tile
+
+function Module.blockArt(blockName: string): Sprite?
+	return blockArt[blockName]
+end
+
+--[[
+	Whether the image has a real asset id yet. Until it does, components draw a
+	stand-in instead of an image that fails to load.
+]]
+function Module.isUploaded(image: string): boolean
+	return image ~= PLACEHOLDER_IMAGE
+end
+
+return table.freeze(Module)
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel.luau
new file mode 100644
index 0000000..1671c72
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel.luau
@@ -0,0 +1,426 @@
+--!strict
+--[[
+	The inventory panel from Figma screen 12:340 ("Inventory / Desktop"). It takes
+	every value and action through props and requires no game state, so a story
+	can render it; InventoryScreen connects it to the game.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const InventoryAssets = require("./InventoryAssets")
+const InventorySlot = require("./InventorySlot")
+const InventoryTheme = require("./InventoryTheme")
+
+const create = Vide.create
+const derive = Vide.derive
+const indexes = Vide.indexes
+const source = Vide.source
+
+const PANEL_WIDTH = 720
+const PADDING_X = 28
+const PADDING_Y = 24
+const SECTION_GAP = 16
+const HEADER_HEIGHT = 44
+const TITLE_HEIGHT = 34
+const CLOSE_BUTTON_SIZE = 44
+const SLOT_SIZE = 96
+const SLOT_GAP = 12
+const FOOTER_HEIGHT = 52
+const FOOTER_GAP = 16
+const NAME_HEIGHT = 24
+const EQUIP_BUTTON_WIDTH = 200
+const CONTENT_WIDTH = PANEL_WIDTH - PADDING_X * 2
+const COLUMNS = (CONTENT_WIDTH + SLOT_GAP) // (SLOT_SIZE + SLOT_GAP)
+const TITLE = "Inventory"
+
+const colors = InventoryTheme.Colors
+const transparency = InventoryTheme.Transparency
+const radius = InventoryTheme.Radius
+const shadows = InventoryTheme.Shadows
+
+export type SlotData = {
+	Name: string,
+	DisplayName: string,
+	Color: Color3,
+	Count: number,
+	UnlockLevel: number,
+	IsLocked: boolean,
+}
+
+export type InventoryPanelProps = {
+	Slots: () -> { SlotData },
+	-- The slot the player picked in the panel.
+	SelectedName: () -> string,
+	-- The block type the player builds with.
+	EquippedName: () -> string,
+	Select: (blockName: string) -> (),
+	Equip: (blockName: string) -> (),
+	Close: () -> (),
+}
+
+type EquipState = "Ready" | "Equipped" | "Locked" | "NoSelection"
+
+local Module = {}
+
+local function gridHeight(slotCount: number): number
+	local rows = math.max(1, math.ceil(slotCount / COLUMNS))
+	return rows * SLOT_SIZE + (rows - 1) * SLOT_GAP
+end
+
+local function closeButton(props: { Activated: () -> () }): TextButton
+	local isHovered = source(false)
+	const close = InventoryAssets.Close
+	const hasIcon = InventoryAssets.isUploaded(close.Image)
+	const iconBox = InventoryAssets.IconBoxSize
+
+	return create("TextButton")({
+		Name = "CloseButton",
+		LayoutOrder = 2,
+		Size = UDim2.fromOffset(CLOSE_BUTTON_SIZE, CLOSE_BUTTON_SIZE),
+		BackgroundColor3 = colors.White,
+		BackgroundTransparency = function()
+			return if isHovered() then transparency.IconButtonHover else transparency.IconButton
+		end,
+		-- Stand-in glyph until the icon sheet is uploaded.
+		Text = if hasIcon then "" else "X",
+		FontFace = InventoryTheme.Text.Title.Font,
+		TextSize = InventoryTheme.Text.Button.Size,
+		TextColor3 = colors.TextPrimary,
+
+		Activated = props.Activated,
+		MouseEnter = function()
+			isHovered(true)
+		end,
+		MouseLeave = function()
+			isHovered(false)
+		end,
+
+		create("UICorner")({ CornerRadius = UDim.new(1, 0) }),
+		hasIcon and create("ImageLabel")({
+			Name = "Icon",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0.5),
+			Size = UDim2.fromOffset(iconBox.X, iconBox.Y),
+			BackgroundTransparency = 1,
+			ScaleType = Enum.ScaleType.Fit,
+			Image = close.Image,
+			ImageRectOffset = close.RectOffset,
+			ImageRectSize = close.RectSize,
+			ImageColor3 = colors.TextPrimary,
+		}),
+	})
+end
+
+local function equipButton(props: {
+	State: () -> EquipState,
+	Activated: () -> (),
+}): TextButton
+	local isPressed = source(false)
+	const buttonText = InventoryTheme.Text.Button
+
+	local function isReady(): boolean
+		return props.State() == "Ready"
+	end
+
+	return create("TextButton")({
+		Name = "EquipButton",
+		LayoutOrder = 2,
+		Size = UDim2.fromOffset(EQUIP_BUTTON_WIDTH, FOOTER_HEIGHT),
+		BackgroundColor3 = function()
+			return if isPressed() and isReady() then colors.PrimaryPressed else colors.White
+		end,
+		Selectable = true,
+
+		Activated = function()
+			if isReady() then
+				props.Activated()
+			end
+		end,
+		MouseButton1Down = function()
+			isPressed(true)
+		end,
+		MouseButton1Up = function()
+			isPressed(false)
+		end,
+		MouseLeave = function()
+			isPressed(false)
+		end,
+
+		create("UICorner")({ CornerRadius = UDim.new(0, radius.Button) }),
+		create("UIGradient")({
+			Color = function()
+				return if isReady()
+					then InventoryTheme.Gradients.Primary
+					else InventoryTheme.Gradients.PrimaryDisabled
+			end,
+			Rotation = InventoryTheme.Gradients.VerticalRotation,
+		}),
+		create("UIShadow")({
+			Inset = true,
+			Color = colors.Black,
+			Transparency = transparency.PrimaryInnerShadow,
+			Offset = UDim2.fromOffset(shadows.PrimaryInner.Offset.X, shadows.PrimaryInner.Offset.Y),
+			BlurRadius = UDim.new(0, shadows.PrimaryInner.Blur),
+		}),
+
+		-- A child label, because the button's UIGradient would tint its own text.
+		create("TextLabel")({
+			Name = "Label",
+			Size = UDim2.fromScale(1, 1),
+			BackgroundTransparency = 1,
+			FontFace = buttonText.Font,
+			TextSize = buttonText.Size,
+			TextColor3 = function()
+				return if isReady() then colors.PrimaryText else colors.TextSecondary
+			end,
+			Text = function()
+				local state = props.State()
+				if state == "Equipped" then
+					return "EQUIPPED"
+				elseif state == "Locked" then
+					return "LOCKED"
+				end
+				return "EQUIP"
+			end,
+		}),
+	})
+end
+
+--[[
+	The panel's size at UI scale 1 for a number of slots, so a parent can fit it
+	to the screen without reading it back.
+]]
+function Module.designSize(slotCount: number): Vector2
+	local height = PADDING_Y * 2
+		+ HEADER_HEIGHT
+		+ SECTION_GAP
+		+ gridHeight(slotCount)
+		+ SECTION_GAP
+		+ FOOTER_HEIGHT
+	return Vector2.new(PANEL_WIDTH, height)
+end
+
+--[[
+	Builds the panel, centered in its parent.
+]]
+function Module.build(props: InventoryPanelProps): Frame
+	const selectedSlot: () -> SlotData? = derive(function(): SlotData?
+		local selectedName = props.SelectedName()
+		for _, slot in props.Slots() do
+			if slot.Name == selectedName then
+				return slot
+			end
+		end
+		return nil
+	end)
+
+	-- A plain function, not derive: derive widens the EquipState union to
+	-- string, and this is cheap to recompute.
+	local function equipState(): EquipState
+		local slot = selectedSlot()
+		if not slot then
+			return "NoSelection"
+		elseif slot.IsLocked then
+			return "Locked"
+		elseif slot.Name == props.EquippedName() then
+			return "Equipped"
+		end
+		return "Ready"
+	end
+
+	const titleText = InventoryTheme.Text.Title
+	const bodyText = InventoryTheme.Text.Body
+	const hexPattern = InventoryAssets.HexPattern
+	const panelStroke = InventoryTheme.StrokeWidth.Panel
+
+	return create("Frame")({
+		Name = "InventoryPanel",
+		AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.5),
+		Size = function()
+			local size = Module.designSize(#props.Slots())
+			return UDim2.fromOffset(size.X, size.Y)
+		end,
+		BackgroundColor3 = colors.Surface,
+		BackgroundTransparency = transparency.Surface,
+		Active = true,
+
+		create("UICorner")({ CornerRadius = UDim.new(0, radius.Panel) }),
+		create("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			BorderStrokePosition = Enum.BorderStrokePosition.Inner,
+			Thickness = panelStroke,
+			Color = colors.Stroke,
+		}),
+		create("UIShadow")({
+			Color = colors.Black,
+			Transparency = transparency.PanelShadow,
+			Offset = UDim2.fromOffset(shadows.Panel.Offset.X, shadows.Panel.Offset.Y),
+			BlurRadius = UDim.new(0, shadows.Panel.Blur),
+			-- The panel is see-through, and the design keeps the shadow off
+			-- what shows through it.
+			ShowBehindParent = false,
+		}),
+
+		InventoryAssets.isUploaded(hexPattern.Image) and create("ImageLabel")({
+			Name = "HexPattern",
+			Position = UDim2.fromOffset(panelStroke, panelStroke),
+			Size = UDim2.new(1, -panelStroke * 2, 1, -panelStroke * 2),
+			BackgroundTransparency = 1,
+			Image = hexPattern.Image,
+			ImageColor3 = colors.White,
+			ImageTransparency = transparency.HexPattern,
+			ScaleType = Enum.ScaleType.Tile,
+			TileSize = hexPattern.TileSize,
+
+			-- ClipsDescendants ignores UICorner, so the tile rounds itself.
+			create("UICorner")({ CornerRadius = UDim.new(0, radius.Panel - panelStroke) }),
+		}),
+
+		create("Frame")({
+			Name = "Content",
+			Size = UDim2.fromScale(1, 1),
+			BackgroundTransparency = 1,
+			ZIndex = 2,
+
+			create("UIPadding")({
+				PaddingLeft = UDim.new(0, PADDING_X),
+				PaddingRight = UDim.new(0, PADDING_X),
+				PaddingTop = UDim.new(0, PADDING_Y),
+				PaddingBottom = UDim.new(0, PADDING_Y),
+			}),
+			create("UIListLayout")({
+				FillDirection = Enum.FillDirection.Vertical,
+				Padding = UDim.new(0, SECTION_GAP),
+			}),
+
+			create("Frame")({
+				Name = "Header",
+				LayoutOrder = 1,
+				Size = UDim2.new(1, 0, 0, HEADER_HEIGHT),
+				BackgroundTransparency = 1,
+
+				create("UIListLayout")({
+					FillDirection = Enum.FillDirection.Horizontal,
+					HorizontalFlex = Enum.UIFlexAlignment.SpaceBetween,
+					VerticalAlignment = Enum.VerticalAlignment.Center,
+				}),
+
+				create("TextLabel")({
+					Name = "Title",
+					LayoutOrder = 1,
+					AutomaticSize = Enum.AutomaticSize.X,
+					Size = UDim2.fromOffset(0, TITLE_HEIGHT),
+					BackgroundTransparency = 1,
+					FontFace = titleText.Font,
+					TextSize = titleText.Size,
+					TextColor3 = colors.TextPrimary,
+					TextXAlignment = Enum.TextXAlignment.Left,
+					Text = string.upper(TITLE),
+
+					create("UIShadow")({
+						Mode = Enum.ApplyShadowMode.Text,
+						Color = colors.Black,
+						Transparency = transparency.TitleShadow,
+						Offset = UDim2.fromOffset(shadows.Title.Offset.X, shadows.Title.Offset.Y),
+						BlurRadius = UDim.new(0, shadows.Title.Blur),
+					}),
+				}),
+				closeButton({ Activated = props.Close }),
+			}),
+
+			create("Frame")({
+				Name = "SlotGrid",
+				LayoutOrder = 2,
+				Size = function()
+					return UDim2.new(1, 0, 0, gridHeight(#props.Slots()))
+				end,
+				BackgroundTransparency = 1,
+
+				create("UIGridLayout")({
+					CellSize = UDim2.fromOffset(SLOT_SIZE, SLOT_SIZE),
+					CellPadding = UDim2.fromOffset(SLOT_GAP, SLOT_GAP),
+				}),
+
+				indexes(props.Slots, function(slot, index)
+					return InventorySlot({
+						BlockName = function()
+							return slot().Name
+						end,
+						ArtColor = function()
+							return slot().Color
+						end,
+						Count = function()
+							return slot().Count
+						end,
+						UnlockLevel = function()
+							return slot().UnlockLevel
+						end,
+						IsLocked = function()
+							return slot().IsLocked
+						end,
+						IsSelected = function()
+							return slot().Name == props.SelectedName()
+						end,
+						LayoutOrder = index,
+						Activated = function()
+							props.Select(slot().Name)
+						end,
+					})
+				end),
+			}),
+
+			create("Frame")({
+				Name = "Footer",
+				LayoutOrder = 3,
+				Size = UDim2.new(1, 0, 0, FOOTER_HEIGHT),
+				BackgroundTransparency = 1,
+
+				create("UIListLayout")({
+					FillDirection = Enum.FillDirection.Horizontal,
+					VerticalAlignment = Enum.VerticalAlignment.Center,
+					Padding = UDim.new(0, FOOTER_GAP),
+				}),
+
+				create("TextLabel")({
+					Name = "SelectedName",
+					LayoutOrder = 1,
+					Size = UDim2.fromOffset(0, NAME_HEIGHT),
+					BackgroundTransparency = 1,
+					FontFace = bodyText.Font,
+					TextSize = bodyText.Size,
+					TextColor3 = colors.TextSecondary,
+					TextXAlignment = Enum.TextXAlignment.Left,
+					TextTruncate = Enum.TextTruncate.AtEnd,
+					-- The design shows only the name. The reason the button is
+					-- disabled is added here so every player can see it.
+					Text = function()
+						local slot = selectedSlot()
+						local state = equipState()
+						if not slot then
+							return "Pick a block"
+						elseif state == "Locked" then
+							return `{slot.DisplayName} · Unlocks at level {slot.UnlockLevel}`
+						elseif state == "Equipped" then
+							return `{slot.DisplayName} · Equipped`
+						end
+						return slot.DisplayName
+					end,
+
+					create("UIFlexItem")({ FlexMode = Enum.UIFlexMode.Fill }),
+				}),
+				equipButton({
+					State = equipState,
+					Activated = function()
+						local slot = selectedSlot()
+						if slot then
+							props.Equip(slot.Name)
+						end
+					end,
+				}),
+			}),
+		}),
+	})
+end
+
+return table.freeze(Module)
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau
new file mode 100644
index 0000000..1fc4b98
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau
@@ -0,0 +1,179 @@
+--!strict
+--[[
+	Connects the inventory panel to the game: the block types, the player's counts
+	and locks from BlockInventory, and the equipped block from BlockPlacer. Also
+	builds the button and the B key that open the panel again after it closes.
+]]
+
+const UserInputService = game:GetService("UserInputService")
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockInventory = require("../BlockInventory")
+const BlockPlacer = require("../BlockPlacer")
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const InventoryPanel = require("./InventoryPanel")
+const InventoryTheme = require("./InventoryTheme")
+const Screen = require("./Screen")
+
+const cleanup = Vide.cleanup
+const create = Vide.create
+const source = Vide.source
+
+const TOGGLE_KEYS = { Enum.KeyCode.B, Enum.KeyCode.ButtonY }
+const EDGE_PADDING = 16
+-- Below half size the panel's smallest text stops being readable.
+const MINIMUM_FIT_SCALE = 0.5
+const OPEN_BUTTON_POSITION = UDim2.fromOffset(16, 16)
+const OPEN_BUTTON_HEIGHT = 44
+const OPEN_BUTTON_PADDING = 16
+
+const colors = InventoryTheme.Colors
+
+local function readSlots(): { InventoryPanel.SlotData }
+	local slots = {}
+	for _, blockType in BlockTypes.List do
+		local name = blockType.Name
+		table.insert(
+			slots,
+			table.freeze({
+				Name = name,
+				DisplayName = blockType.DisplayName,
+				Color = blockType.Color,
+				Count = BlockInventory.getCount(name),
+				UnlockLevel = BlockInventory.getUnlockLevel(name),
+				IsLocked = not BlockInventory.isUnlocked(name),
+			})
+		)
+	end
+	return slots
+end
+
+local function openButton(props: { Visible: () -> boolean, Activated: () -> () }): TextButton
+	const text = InventoryTheme.Text.Count
+
+	return create("TextButton")({
+		Name = "OpenInventoryButton",
+		Position = OPEN_BUTTON_POSITION,
+		AutomaticSize = Enum.AutomaticSize.X,
+		Size = UDim2.fromOffset(0, OPEN_BUTTON_HEIGHT),
+		BackgroundColor3 = colors.Surface,
+		BackgroundTransparency = InventoryTheme.Transparency.Surface,
+		FontFace = text.Font,
+		TextSize = text.Size,
+		TextColor3 = colors.TextPrimary,
+		Text = "INVENTORY",
+		Visible = props.Visible,
+		Selectable = true,
+
+		Activated = props.Activated,
+
+		create("UICorner")({ CornerRadius = UDim.new(0, InventoryTheme.Radius.Button) }),
+		create("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			BorderStrokePosition = Enum.BorderStrokePosition.Inner,
+			Thickness = InventoryTheme.StrokeWidth.Panel,
+			Color = colors.Stroke,
+		}),
+		create("UIPadding")({
+			PaddingLeft = UDim.new(0, OPEN_BUTTON_PADDING),
+			PaddingRight = UDim.new(0, OPEN_BUTTON_PADDING),
+		}),
+	})
+end
+
+--[[
+	The inventory panel and its open button, connected to the local player's
+	inventory. Call it inside a Vide scope and parent the result to a ScreenGui
+	that has the Screen UIScale.
+]]
+local function inventoryScreen(): Frame
+	local equippedName = source(BlockPlacer.getBlockType())
+	local selectedName = source(BlockPlacer.getBlockType())
+	local slots = source(readSlots())
+	local isOpen = source(true)
+
+	local function setOpen(open: boolean)
+		if open then
+			selectedName(equippedName())
+		end
+		isOpen(open)
+	end
+
+	local function onInputBegan(input: InputObject, gameProcessed: boolean)
+		if gameProcessed or not table.find(TOGGLE_KEYS, input.KeyCode) then
+			return
+		end
+		setOpen(not isOpen())
+	end
+
+	cleanup(BlockInventory.Changed:Connect(function()
+		slots(readSlots())
+	end))
+	cleanup(BlockPlacer.BlockTypeChanged:Connect(function(name: string)
+		equippedName(name)
+		selectedName(name)
+	end))
+	cleanup(UserInputService.InputBegan:Connect(onInputBegan))
+
+	local function designSize(): Vector2
+		return InventoryPanel.designSize(#slots())
+	end
+
+	local function fitScale(): number
+		local design = designSize()
+		local usable = Screen.usableSize()
+		local fit = math.min(
+			(usable.X - EDGE_PADDING * 2) / design.X,
+			(usable.Y - EDGE_PADDING * 2) / design.Y
+		)
+		return math.clamp(fit, MINIMUM_FIT_SCALE, 1)
+	end
+
+	return create("Frame")({
+		Name = "Inventory",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundTransparency = 1,
+
+		create("Frame")({
+			Name = "InventoryDock",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0.5),
+			Size = function()
+				local size = designSize()
+				return UDim2.fromOffset(size.X, size.Y)
+			end,
+			BackgroundTransparency = 1,
+			Visible = isOpen,
+
+			create("UIScale")({ Scale = fitScale }),
+			InventoryPanel.build({
+				Slots = slots,
+				SelectedName = selectedName,
+				EquippedName = equippedName,
+				Select = function(name: string)
+					selectedName(name)
+				end,
+				Equip = function(name: string)
+					if BlockInventory.isUnlocked(name) then
+						BlockPlacer.setBlockType(name)
+					end
+				end,
+				Close = function()
+					setOpen(false)
+				end,
+			}),
+		}),
+
+		openButton({
+			Visible = function()
+				return not isOpen()
+			end,
+			Activated = function()
+				setOpen(true)
+			end,
+		}),
+	})
+end
+
+return inventoryScreen
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventorySlot.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventorySlot.luau
new file mode 100644
index 0000000..90c3ae3
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventorySlot.luau
@@ -0,0 +1,214 @@
+--!strict
+--[[
+	One inventory slot, the Figma "Slot" component set (20:1). The design's State
+	variant maps to two props: Selected is IsSelected, Locked is IsLocked, and
+	Default is neither. Selected and locked together is not in the design; it
+	draws the locked slot with the selected outline.
+]]
+
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const InventoryAssets = require("./InventoryAssets")
+const InventoryTheme = require("./InventoryTheme")
+
+const create = Vide.create
+const read = Vide.read
+const source = Vide.source
+
+const SLOT_SIZE = UDim2.fromOffset(96, 96)
+const ART_BOX_POSITION = UDim2.fromOffset(4, 4)
+const ART_FALLBACK_POSITION = UDim2.fromOffset(20, 16)
+const ART_FALLBACK_SIZE = UDim2.fromOffset(56, 56)
+const COUNT_POSITION = UDim2.new(1, -8, 1, -6)
+const COUNT_SIZE = UDim2.new(1, -16, 0, 20)
+-- The lock sits 10 above the slot's center, over the art's middle.
+const LOCK_POSITION = UDim2.new(0.5, 0, 0.5, -10)
+const UNLOCK_LABEL_POSITION = UDim2.fromOffset(0, 70)
+const UNLOCK_LABEL_SIZE = UDim2.new(1, 0, 0, 18)
+const OVERLAY_Z_INDEX = 2
+
+const colors = InventoryTheme.Colors
+const transparency = InventoryTheme.Transparency
+const strokeWidth = InventoryTheme.StrokeWidth
+const shadows = InventoryTheme.Shadows
+const countText = InventoryTheme.Text.Count
+const unlockText = InventoryTheme.Text.UnlockLabel
+
+export type InventorySlotProps = {
+	BlockName: string | () -> string,
+	-- Stand-in fill while the block art sheet has no asset id.
+	ArtColor: Color3 | () -> Color3,
+	Count: number | () -> number,
+	UnlockLevel: number | () -> number,
+	IsLocked: boolean | () -> boolean,
+	IsSelected: boolean | () -> boolean,
+	LayoutOrder: number?,
+	Activated: () -> (),
+}
+
+local function inventorySlot(props: InventorySlotProps): TextButton
+	local isHovered = source(false)
+
+	local function sprite(): InventoryAssets.Sprite?
+		local art = InventoryAssets.blockArt(read(props.BlockName))
+		if art and InventoryAssets.isUploaded(art.Image) then
+			return art
+		end
+		return nil
+	end
+
+	local function contentTransparency(): number
+		return if read(props.IsLocked) then transparency.LockedContent else 0
+	end
+
+	const lock = InventoryAssets.Lock
+	const iconBox = InventoryAssets.IconBoxSize
+	const artBox = InventoryAssets.BlockArtBoxSize
+
+	return create("TextButton")({
+		Name = "InventorySlot",
+		Size = SLOT_SIZE,
+		LayoutOrder = props.LayoutOrder,
+		BackgroundColor3 = colors.White,
+		Selectable = true,
+
+		Activated = props.Activated,
+		MouseEnter = function()
+			isHovered(true)
+		end,
+		MouseLeave = function()
+			isHovered(false)
+		end,
+
+		create("UICorner")({ CornerRadius = UDim.new(0, InventoryTheme.Radius.Slot) }),
+		create("UIGradient")({
+			Color = InventoryTheme.Gradients.Slot,
+			Rotation = InventoryTheme.Gradients.VerticalRotation,
+		}),
+		create("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			BorderStrokePosition = function()
+				return if read(props.IsSelected)
+					then Enum.BorderStrokePosition.Outer
+					else Enum.BorderStrokePosition.Inner
+			end,
+			Thickness = function()
+				return if read(props.IsSelected) then strokeWidth.SlotSelected else strokeWidth.Slot
+			end,
+			Color = function()
+				if read(props.IsSelected) then
+					return colors.Accent
+				elseif isHovered() then
+					-- Hover is not in the design; it brightens the outline.
+					return colors.TextSecondary
+				end
+				return colors.Stroke
+			end,
+		}),
+		create("UIShadow")({
+			Enabled = props.IsSelected,
+			Color = colors.Accent,
+			Transparency = transparency.SelectedGlow,
+			BlurRadius = UDim.new(0, shadows.SelectedGlow.Blur),
+			Spread = UDim2.fromOffset(shadows.SelectedGlow.Spread, shadows.SelectedGlow.Spread),
+			ShowBehindParent = false,
+		}),
+
+		create("ImageLabel")({
+			Name = "BlockArt",
+			BackgroundTransparency = 1,
+			Position = ART_BOX_POSITION,
+			Size = UDim2.fromOffset(artBox.X, artBox.Y),
+			ScaleType = Enum.ScaleType.Fit,
+			Visible = function()
+				return sprite() ~= nil
+			end,
+			Image = function()
+				local art = sprite()
+				return if art then art.Image else ""
+			end,
+			ImageRectOffset = function()
+				local art = sprite()
+				return if art then art.RectOffset else Vector2.zero
+			end,
+			ImageRectSize = function()
+				local art = sprite()
+				return if art then art.RectSize else Vector2.zero
+			end,
+			ImageTransparency = contentTransparency,
+		}),
+		create("Frame")({
+			Name = "BlockArtStandIn",
+			Position = ART_FALLBACK_POSITION,
+			Size = ART_FALLBACK_SIZE,
+			BackgroundColor3 = props.ArtColor,
+			BackgroundTransparency = contentTransparency,
+			Visible = function()
+				return sprite() == nil
+			end,
+
+			create("UICorner")({ CornerRadius = UDim.new(0, InventoryTheme.Radius.ArtFallback) }),
+		}),
+
+		create("TextLabel")({
+			Name = "Count",
+			AnchorPoint = Vector2.new(1, 1),
+			Position = COUNT_POSITION,
+			Size = COUNT_SIZE,
+			ZIndex = OVERLAY_Z_INDEX,
+			BackgroundTransparency = 1,
+			FontFace = countText.Font,
+			TextSize = countText.Size,
+			TextColor3 = colors.TextPrimary,
+			TextXAlignment = Enum.TextXAlignment.Right,
+			TextTruncate = Enum.TextTruncate.AtEnd,
+			Text = function()
+				return `x{read(props.Count)}`
+			end,
+			Visible = function()
+				return not read(props.IsLocked)
+			end,
+
+			create("UIShadow")({
+				Mode = Enum.ApplyShadowMode.Text,
+				Color = colors.Black,
+				Transparency = transparency.CountShadow,
+				Offset = UDim2.fromOffset(shadows.Count.Offset.X, shadows.Count.Offset.Y),
+				BlurRadius = UDim.new(0, shadows.Count.Blur),
+			}),
+		}),
+
+		create("ImageLabel")({
+			Name = "LockIcon",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = LOCK_POSITION,
+			Size = UDim2.fromOffset(iconBox.X, iconBox.Y),
+			ZIndex = OVERLAY_Z_INDEX,
+			BackgroundTransparency = 1,
+			ScaleType = Enum.ScaleType.Fit,
+			Image = lock.Image,
+			ImageRectOffset = lock.RectOffset,
+			ImageRectSize = lock.RectSize,
+			ImageColor3 = colors.TextPrimary,
+			Visible = function()
+				return read(props.IsLocked) and InventoryAssets.isUploaded(lock.Image)
+			end,
+		}),
+		create("TextLabel")({
+			Name = "UnlockLabel",
+			Position = UNLOCK_LABEL_POSITION,
+			Size = UNLOCK_LABEL_SIZE,
+			ZIndex = OVERLAY_Z_INDEX,
+			BackgroundTransparency = 1,
+			FontFace = unlockText.Font,
+			TextSize = unlockText.Size,
+			TextColor3 = colors.TextPrimary,
+			Text = function()
+				return `Lv {read(props.UnlockLevel)}`
+			end,
+			Visible = props.IsLocked,
+		}),
+	})
+end
+
+return inventorySlot
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryTheme.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryTheme.luau
new file mode 100644
index 0000000..dfd4806
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryTheme.luau
@@ -0,0 +1,113 @@
+--!strict
+--[[
+	Design tokens for the inventory panel, from the Figma file "Block Builder - UI"
+	(design/figma/inventory-panel.json, screen 12:340 and Slot set 20:1). Sizes are
+	offsets at the 1080-tall reference size. Figma alpha a is stored as a
+	transparency of 1 - a.
+]]
+
+const BUILDER_SANS = "rbxasset://fonts/families/BuilderSans.json"
+
+export type TextStyle = {
+	Font: Font,
+	Size: number,
+	LineHeight: number,
+}
+
+local Module = {}
+
+Module.Colors = table.freeze({
+	-- Surface/Panel
+	Surface = Color3.fromRGB(23, 26, 38),
+	Stroke = Color3.fromRGB(58, 64, 96),
+	-- Text/Primary
+	TextPrimary = Color3.fromRGB(245, 246, 250),
+	TextSecondary = Color3.fromRGB(199, 204, 224),
+	SlotTop = Color3.fromRGB(43, 49, 80),
+	SlotBottom = Color3.fromRGB(32, 37, 59),
+	Accent = Color3.fromRGB(255, 200, 60),
+	PrimaryTop = Color3.fromRGB(255, 210, 90),
+	PrimaryBottom = Color3.fromRGB(255, 159, 28),
+	PrimaryText = Color3.fromRGB(59, 35, 0),
+	PrimaryPressed = Color3.fromRGB(225, 225, 225),
+	White = Color3.new(1, 1, 1),
+	Black = Color3.new(0, 0, 0),
+})
+
+Module.Transparency = table.freeze({
+	-- The design is 0.08 over a 24 px background blur. Roblox can't blur what is
+	-- behind one frame, so a more opaque fill stands in for the blur.
+	Surface = 0.04,
+	IconButton = 0.92,
+	IconButtonHover = 0.84,
+	LockedContent = 0.6,
+	HexPattern = 0.94,
+	PanelShadow = 0.55,
+	TitleShadow = 0.5,
+	CountShadow = 0.4,
+	SelectedGlow = 0.45,
