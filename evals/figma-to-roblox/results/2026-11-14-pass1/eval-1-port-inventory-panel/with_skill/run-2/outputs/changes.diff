@@ -0,0 +1,83 @@
+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const InventorySlot = require("@game/StarterPlayer/StarterPlayerScripts/UI/InventorySlot")
+
+const create = Vide.create
+
+local blockNames = {}
+for _, blockType in BlockTypes.List do
+	table.insert(blockNames, blockType.Name)
+end
+
+const CONTROLS = {
+	Block = UILabs.Ordered(
+		UILabs.ControlGroup({
+			BlockName = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+			Count = UILabs.Ordered(UILabs.Slider(48, 0, 99999, 1), 2),
+		}),
+		1
+	),
+	State = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsSelected = UILabs.Ordered(true, 1),
+			IsLocked = UILabs.Ordered(false, 2),
+			-- Shown as "Lv N" while the slot is locked.
+			UnlockLevel = UILabs.Ordered(UILabs.Slider(4, 1, 99, 1), 3),
+		}),
+		2
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Block: {
+			BlockName: () -> string,
+			Count: () -> number,
+		},
+		State: {
+			IsSelected: () -> boolean,
+			IsLocked: () -> boolean,
+			UnlockLevel: () -> number,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local block = props.controls.Block
+	local state = props.controls.State
+
+	return create("Frame")({
+		Name = "SlotPreview",
+		AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.5),
+		Size = UDim2.fromOffset(96, 96),
+		BackgroundTransparency = 1,
+
+		InventorySlot({
+			BlockName = block.BlockName,
+			ArtColor = function()
+				local blockType = BlockTypes.ByName[block.BlockName()]
+				return if blockType then blockType.Color else Color3.new(1, 1, 1)
+			end,
+			Count = block.Count,
+			UnlockLevel = state.UnlockLevel,
+			IsLocked = state.IsLocked,
+			IsSelected = state.IsSelected,
+			Activated = function()
+				print(`Slot {block.BlockName()} activated`)
+			end,
+		}),
+	})
+end
+
+return {
+	summary = "One inventory slot in its default, selected, and locked states.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
