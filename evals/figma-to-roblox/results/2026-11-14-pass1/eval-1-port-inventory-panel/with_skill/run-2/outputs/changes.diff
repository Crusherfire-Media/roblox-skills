index 0000000..1becc72
--- /dev/null
+++ b/src/ServerScriptService/Stories/UI/InventoryPanel.story.luau
@@ -0,0 +1,93 @@
+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const InventoryPanel = require("@game/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel")
+
+const source = Vide.source
+
+const LONG_NAME_SUFFIX = " Reinforced Polished Deluxe Edition"
+const BLOCK_TYPE_COUNT = #BlockTypes.List
+
+const CONTROLS = {
+	Inventory = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Slots past this many block types are left out.
+			SlotCount = UILabs.Ordered(UILabs.Slider(BLOCK_TYPE_COUNT, 0, BLOCK_TYPE_COUNT, 1), 1),
+			-- The last three block types lock above this level.
+			PlayerLevel = UILabs.Ordered(UILabs.Slider(3, 1, 12, 1), 2),
+			AreCountsEmpty = UILabs.Ordered(false, 3),
+			HasLongNames = UILabs.Ordered(false, 4),
+		}),
+		1
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Inventory: {
+			SlotCount: () -> number,
+			PlayerLevel: () -> number,
+			AreCountsEmpty: () -> boolean,
+			HasLongNames: () -> boolean,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local inventory = props.controls.Inventory
+	local firstName = BlockTypes.List[1].Name
+	local selectedName = source(firstName)
+	local equippedName = source(firstName)
+	local lockedFrom = #BlockTypes.List - 2
+
+	local function slots(): { InventoryPanel.SlotData }
+		local list = {}
+		for index, blockType in BlockTypes.List do
+			if index > inventory.SlotCount() then
+				break
+			end
+			local unlockLevel = if index >= lockedFrom then (index - lockedFrom + 2) * 2 else 1
+			table.insert(
+				list,
+				table.freeze({
+					Name = blockType.Name,
+					DisplayName = if inventory.HasLongNames()
+						then blockType.DisplayName .. LONG_NAME_SUFFIX
+						else blockType.DisplayName,
+					Color = blockType.Color,
+					Count = if inventory.AreCountsEmpty() then 0 else index * index * 11,
+					UnlockLevel = unlockLevel,
+					IsLocked = inventory.PlayerLevel() < unlockLevel,
+				})
+			)
+		end
+		return list
+	end
+
+	return InventoryPanel.build({
+		Slots = slots,
+		SelectedName = selectedName,
+		EquippedName = equippedName,
+		Select = function(name: string)
+			selectedName(name)
+		end,
+		Equip = function(name: string)
+			print(`Equipped {name}`)
+			equippedName(name)
+		end,
+		Close = function()
+			print("Close pressed")
+		end,
+	})
+end
+
+return {
+	summary = "The inventory panel with sample counts, locks, and selection.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
