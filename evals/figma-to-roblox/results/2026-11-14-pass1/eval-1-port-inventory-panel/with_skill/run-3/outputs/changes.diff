diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryAssets.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryAssets.luau
new file mode 100644
index 0000000..5d53cf1
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryAssets.luau
@@ -0,0 +1,100 @@
+--!strict
+--[[
+	Every uploaded image the inventory panel draws, with its sprite rects. How each one
+	is exported is in docs/figma/inventory-assets.md. Until an id is filled in, its
+	getter returns nil (or an empty string) and the panel draws its fallback.
+]]
+
+local PLACEHOLDER_ID = "rbxassetid://0"
+
+-- Block Art sheet: 5 by 2 cells of 160 px, art plus its baked drop shadow, at 2x.
+local BLOCK_SHEET_ID = PLACEHOLDER_ID
+local BLOCK_CELL_SIZE = 160
+local BLOCK_COLUMNS = 5
+local BLOCK_CELLS: { [string]: number? } = {
+	Brick = 0,
+	Dirt = 1,
+	Grass = 2,
+	Window = 3,
+	Wood = 4,
+	Stone = 5,
+	Sand = 6,
+	Ice = 7,
+	Lamp = 8,
+	Gold = 9,
+}
+
+-- Icon sheet: 64 px cells, each glyph in the 60 px square at the cell's center.
+local ICON_SHEET_ID = PLACEHOLDER_ID
+local ICON_CELL_SIZE = 64
+local ICON_GLYPH_SIZE = 60
+local ICON_CELLS: { [string]: number } = {
+	Close = 0,
+	Lock = 1,
+}
+
+local HEX_TILE_ID = PLACEHOLDER_ID
+
+export type Sprite = {
+	Image: string,
+	RectOffset: Vector2,
+	RectSize: Vector2,
+}
+
+export type IconName = "Close" | "Lock"
+
+local Module = {}
+
+-- Display size of one Block Art cell, in UI units: 56 px art with room for its shadow.
+Module.BlockArtSize = Vector2.new(80, 80)
+-- Where the art sits inside its cell, in UI units.
+Module.BlockArtInset = Vector2.new(12, 8)
+
+-- Display size of one hex tile, in UI units. The image is twice this.
+Module.HexTileSize = Vector2.new(112, 192)
+
+--[[
+	The block's art from the Block Art sheet, or nil when the sheet isn't uploaded yet
+	or the block type has no cell.
+]]
+function Module.blockArt(blockName: string): Sprite?
+	local cell = BLOCK_CELLS[blockName]
+	if cell == nil or BLOCK_SHEET_ID == PLACEHOLDER_ID then
+		return nil
+	end
+
+	return {
+		Image = BLOCK_SHEET_ID,
+		RectOffset = Vector2.new(
+			cell % BLOCK_COLUMNS * BLOCK_CELL_SIZE,
+			cell // BLOCK_COLUMNS * BLOCK_CELL_SIZE
+		),
+		RectSize = Vector2.new(BLOCK_CELL_SIZE, BLOCK_CELL_SIZE),
+	}
+end
+
+--[[
+	A white icon to tint with ImageColor3, or nil when the sheet isn't uploaded yet.
+]]
+function Module.icon(name: IconName): Sprite?
+	if ICON_SHEET_ID == PLACEHOLDER_ID then
+		return nil
+	end
+
+	local padding = (ICON_CELL_SIZE - ICON_GLYPH_SIZE) / 2
+	return {
+		Image = ICON_SHEET_ID,
+		RectOffset = Vector2.new(ICON_CELLS[name] * ICON_CELL_SIZE + padding, padding),
+		RectSize = Vector2.new(ICON_GLYPH_SIZE, ICON_GLYPH_SIZE),
+	}
+end
+
+--[[
+	The seamless Hex Pattern tile, or an empty string when it isn't uploaded yet, so
+	nothing tries to load the placeholder.
+]]
+function Module.hexTile(): string
+	return if HEX_TILE_ID == PLACEHOLDER_ID then "" else HEX_TILE_ID
+end
+
+return Module
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel.luau
