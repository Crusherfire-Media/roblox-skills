 	never shrinks it below 1, so phones get the authored sizes.
 ]]
 
+local GuiService = game:GetService("GuiService")
 local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local RunService = game:GetService("RunService")
 local Workspace = game:GetService("Workspace")
 
 local Vide = require(ReplicatedStorage.Packages.Vide)
 
-local cleanup = Vide.cleanup
+local batch = Vide.batch
 local create = Vide.create
 local source = Vide.source
 
 local REFERENCE_HEIGHT = 1080
 local MAX_SCALE = 2
+-- ViewportSize can read (1, 1) before the first frame, which would pass for a tiny phone.
+local FALLBACK_VIEWPORT = Vector2.new(1920, 1080)
 
 local Screen = {}
 
 Screen.ReferenceHeight = REFERENCE_HEIGHT
 Screen.MaxScale = MAX_SCALE
 
+local viewportSize = source(FALLBACK_VIEWPORT)
+local topInset = source(0)
+local cameraConnection: RBXScriptConnection? = nil
+
+local function refresh()
+	local camera = Workspace.CurrentCamera
+	local inset = GuiService:GetGuiInset()
+	batch(function()
+		if camera and camera.ViewportSize.X > 1 and camera.ViewportSize.Y > 1 then
+			viewportSize(camera.ViewportSize)
+		end
+		topInset(inset.Y)
+	end)
+end
+
+local function watchCamera()
+	if cameraConnection then
+		cameraConnection:Disconnect()
+	end
+	local camera = Workspace.CurrentCamera
+	if camera then
+		cameraConnection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(refresh)
+	end
+	refresh()
+end
+
+--[[
+	How much the whole UI grows on this screen. Reads sources, so a binding that calls it
+	follows the window.
+]]
+function Screen.scale(): number
+	local size = viewportSize()
+	return math.clamp(math.min(size.X, size.Y) / REFERENCE_HEIGHT, 1, MAX_SCALE)
+end
+
+--[[
+	The part of the screen below the Roblox topbar, in UI units (before the scale).
+]]
+function Screen.usableSize(): Vector2
+	local size = viewportSize()
+	return Vector2.new(size.X, size.Y - topInset()) / Screen.scale()
+end
+
 --[[
 	A UIScale bound to the viewport's short side. Call it inside a Vide scope and put the result
 	directly under the ScreenGui.
 ]]
 function Screen.uiScale(): UIScale
-	local camera = Workspace.CurrentCamera
-	local viewportSize = source(camera.ViewportSize)
-	cleanup(camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
-		viewportSize(camera.ViewportSize)
-	end))
-
 	return create("UIScale")({
-		Scale = function()
-			local size = viewportSize()
-			return math.clamp(math.min(size.X, size.Y) / REFERENCE_HEIGHT, 1, MAX_SCALE)
-		end,
+		Scale = Screen.scale,
 	})
 end
 
+-- UI Labs loads a fresh copy of this module on every reload, and an engine connection would
+-- keep each copy alive until Studio closes, so edit mode reads the screen once.
+if RunService:IsRunning() then
+	watchCamera()
+	Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(watchCamera)
+	GuiService:GetPropertyChangedSignal("TopbarInset"):Connect(refresh)
+else
+	refresh()
+end
+
 return Screen
