diff --git a/src/ServerScriptService/Stories/InventoryPanel.story.luau b/src/ServerScriptService/Stories/InventoryPanel.story.luau
new file mode 100644
index 0000000..a81ef10
--- /dev/null
+++ b/src/ServerScriptService/Stories/InventoryPanel.story.luau
@@ -0,0 +1,133 @@
+--!strict
+
+local UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+local InventoryPanel = require("@game/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel")
+
+local create = Vide.create
+local show = Vide.show
+local source = Vide.source
+
+-- By hotbar position, the counts the design shows
+local SAMPLE_COUNTS = { 48, 120, 64, 0, 35, 999, 12, 0, 0, 0 }
+-- The last block types unlock at these levels, as in the game
+local LATE_UNLOCK_LEVELS = { 4, 6, 10 }
+local LONG_NAME_SUFFIX = " Reinforced Display Block Deluxe"
+local HUGE_COUNT = 99999
+
+local CONTROLS = {
+	Inventory = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Player level: block types above it show locked
+			Level = UILabs.Ordered(UILabs.Slider(3, 1, 12, 1), 1),
+			Counts = UILabs.Ordered(UILabs.Choose({ "Sample", "Empty", "Huge" }), 2),
+			LongNames = UILabs.Ordered(false, 3),
+		}),
+		1
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Inventory: {
+			Level: () -> number,
+			Counts: () -> string,
+			LongNames: () -> boolean,
+		},
+	},
+	target: Frame,
+}
+
+local function unlockLevel(position: number): number
+	local lateIndex = position - (#BlockTypes.List - #LATE_UNLOCK_LEVELS)
+	return LATE_UNLOCK_LEVELS[lateIndex] or 1
+end
+
+local function count(position: number, mode: string): number
+	if mode == "Empty" then
+		return 0
+	elseif mode == "Huge" then
+		return HUGE_COUNT
+	end
+	return SAMPLE_COUNTS[position] or 0
+end
+
+local function story(props: StoryProps)
+	local inventory = props.controls.Inventory
+	local firstName = BlockTypes.List[1].Name
+	local pickedName = source(firstName)
+	local equippedName = source(firstName)
+	local isOpen = source(true)
+
+	local function slots(): { InventoryPanel.SlotData }
+		local list = {}
+		for position, blockType in BlockTypes.List do
+			local level = unlockLevel(position)
+			local suffix = if inventory.LongNames() then LONG_NAME_SUFFIX else ""
+			table.insert(
+				list,
+				table.freeze({
+					Name = blockType.Name,
+					DisplayName = blockType.DisplayName .. suffix,
+					Color = blockType.Color,
+					Count = count(position, inventory.Counts()),
+					UnlockLevel = level,
+					IsLocked = inventory.Level() < level,
+				})
+			)
+		end
+		return list
+	end
+
+	local panelSize = InventoryPanel.size(#BlockTypes.List)
+
+	return create("Frame")({
+		Name = "Backdrop",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundColor3 = Color3.fromRGB(90, 110, 90),
+
+		create("Frame")({
+			Name = "Dock",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0.5),
+			Size = UDim2.fromOffset(panelSize.X, panelSize.Y),
+			BackgroundTransparency = 1,
+
+			show(isOpen, function(): Instance
+				return InventoryPanel.build({
+					Slots = slots,
+					PickedName = pickedName,
+					EquippedName = equippedName,
+					SlotPicked = function(name: string)
+						pickedName(name)
+					end,
+					Equipped = function(name: string)
+						print(`Equipped {name}`)
+						equippedName(name)
+					end,
+					Closed = function()
+						isOpen(false)
+					end,
+				})
+			end, function(): Instance
+				local button = InventoryPanel.buildOpenButton(function()
+					isOpen(true)
+				end)
+				button.AnchorPoint = Vector2.new(0.5, 0.5)
+				button.Position = UDim2.fromScale(0.5, 0.5)
+				return button
+			end),
+		}),
+	})
+end
+
+return {
+	summary = "The inventory panel (Figma 12:340). Click slots to pick, Equip to equip, X to "
+		.. "close and the INVENTORY button to reopen.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
diff --git a/src/ServerScriptService/Stories/InventorySlot.story.luau b/src/ServerScriptService/Stories/InventorySlot.story.luau
new file mode 100644
index 0000000..71b17e2
--- /dev/null
+++ b/src/ServerScriptService/Stories/InventorySlot.story.luau
@@ -0,0 +1,91 @@
+--!strict
+
+local UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+local InventorySlot = require("@game/StarterPlayer/StarterPlayerScripts/UI/InventorySlot")
+
+local create = Vide.create
+
+local BLOCK_NAMES = {}
+for _, blockType in BlockTypes.List do
+	table.insert(BLOCK_NAMES, blockType.Name)
+end
+
+local CONTROLS = {
+	Content = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Block = UILabs.Ordered(UILabs.Choose(BLOCK_NAMES), 1),
+			Count = UILabs.Ordered(UILabs.Slider(48, 0, 9999, 1), 2),
+			-- Shown only while locked
+			UnlockLevel = UILabs.Ordered(UILabs.Slider(4, 1, 99, 1), 3),
+		}),
+		1
+	),
+	-- The Figma State variant (Selected, Locked) plus Picked, which the design lacks
+	State = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Equipped: the block the player builds with
+			IsSelected = UILabs.Ordered(true, 1),
+			-- Picked in the panel but not equipped yet
+			IsPicked = UILabs.Ordered(false, 2),
+			IsLocked = UILabs.Ordered(false, 3),
+		}),
+		2
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Content: {
+			Block: () -> string,
+			Count: () -> number,
+			UnlockLevel: () -> number,
+		},
+		State: {
+			IsSelected: () -> boolean,
+			IsPicked: () -> boolean,
+			IsLocked: () -> boolean,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local content = props.controls.Content
+	local state = props.controls.State
+
+	local slot = InventorySlot.build({
+		BlockName = content.Block,
+		BlockColor = function()
+			return BlockTypes.ByName[content.Block()].Color
+		end,
+		Count = content.Count,
+		UnlockLevel = content.UnlockLevel,
+		IsSelected = state.IsSelected,
+		IsPicked = state.IsPicked,
+		IsLocked = state.IsLocked,
+		Activated = function()
+			print(`Slot {content.Block()} activated`)
+		end,
+	})
+	slot.AnchorPoint = Vector2.new(0.5, 0.5)
+	slot.Position = UDim2.fromScale(0.5, 0.5)
+
+	return create("Frame")({
+		Name = "Backdrop",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundColor3 = Color3.fromRGB(23, 26, 38),
+
+		slot,
+	})
+end
+
+return {
+	summary = "One inventory slot (Figma Slot, 20:1) in each state, with real block types.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
