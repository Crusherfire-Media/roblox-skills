index 0000000..37c1b60
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryPanel.luau
@@ -0,0 +1,477 @@
+--!strict
+--[[
+	The inventory panel, Figma frame "Inventory / Desktop" (12:340, Panel 40:88). It shows
+	what its props give it and reports clicks through callbacks, so a story can render it
+	without the game running. InventoryScreen connects it to the game.
+]]
+
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local InventoryAssets = require("./InventoryAssets")
+local InventorySlot = require("./InventorySlot")
+local InventoryTheme = require("./InventoryTheme")
+local Shadow = require("./Shadow")
+
+local create = Vide.create
+-- Vide's create types list only common classes; UIStroke and UIPadding aren't among them.
+local createUnlisted: any = Vide.create
+local derive = Vide.derive
+local indexes = Vide.indexes
+local source = Vide.source
+local spring = Vide.spring
+
+local PANEL_WIDTH = 720
+local PADDING_X = 28
+local PADDING_Y = 24
+local SECTION_GAP = 16
+local HEADER_HEIGHT = 44
+local SLOT_GAP = 12
+local FOOTER_HEIGHT = 52
+local CONTENT_WIDTH = PANEL_WIDTH - PADDING_X * 2
+local COLUMNS = math.floor((CONTENT_WIDTH + SLOT_GAP) / (InventorySlot.Size + SLOT_GAP))
+local CLOSE_SIZE = 44
+local CLOSE_ICON_SIZE = 20
+local EQUIP_WIDTH = 200
+local EQUIP_PRESS_DEPTH = 2
+local OPEN_BUTTON_HEIGHT = 52
+local OPEN_BUTTON_PADDING = 20
+
+local Color = InventoryTheme.Color
+local Transparency = InventoryTheme.Transparency
+local Text = InventoryTheme.Text
+
+export type SlotData = {
+	Name: string,
+	DisplayName: string,
+	Color: Color3,
+	Count: number,
+	UnlockLevel: number,
+	IsLocked: boolean,
+}
+
+export type Props = {
+	-- In hotbar order
+	Slots: () -> { SlotData },
+	-- The slot the player has picked in the panel; the footer and Equip act on it
+	PickedName: () -> string,
+	-- The block type the player builds with, drawn as the Selected slot
+	EquippedName: () -> string,
+	SlotPicked: (name: string) -> (),
+	Equipped: (name: string) -> (),
+	Closed: () -> (),
+}
+
+type EquipState = "Ready" | "Equipped" | "Locked"
+
+local EQUIP_LABELS: { [EquipState]: string } = {
+	Ready = "EQUIP",
+	Equipped = "EQUIPPED",
+	Locked = "LOCKED",
+}
+
+local function gridHeight(slotCount: number): number
+	local rows = math.max(1, math.ceil(slotCount / COLUMNS))
+	return rows * InventorySlot.Size + (rows - 1) * SLOT_GAP
+end
+
+local function header(props: Props): Frame
+	local isCloseHovered = source(false)
+	local closeIcon = InventoryAssets.icon("Close")
+
+	return create("Frame")({
+		Name = "Header",
+		LayoutOrder = 1,
+		Size = UDim2.new(1, 0, 0, HEADER_HEIGHT),
+		BackgroundTransparency = 1,
+
+		create("TextLabel")({
+			Name = "Title",
+			AnchorPoint = Vector2.new(0, 0.5),
+			Position = UDim2.fromScale(0, 0.5),
+			Size = UDim2.fromOffset(0, Text.HeadingTitle.LineHeight),
+			AutomaticSize = Enum.AutomaticSize.X,
+			BackgroundTransparency = 1,
+			FontFace = Text.HeadingTitle.Font,
+			TextSize = Text.HeadingTitle.Size,
+			TextColor3 = Color.TextPrimary,
+			TextXAlignment = Enum.TextXAlignment.Left,
+			Text = string.upper("Inventory"),
+
+			Shadow.build({
+				Color = Color.Shadow,
+				Transparency = 0.5,
+				Offset = Vector2.new(0, 2),
+				BlurRadius = 0,
+				IsText = true,
+			}),
+		}),
+
+		create("TextButton")({
+			Name = "CloseButton",
+			AnchorPoint = Vector2.new(1, 0.5),
+			Position = UDim2.fromScale(1, 0.5),
+			Size = UDim2.fromOffset(CLOSE_SIZE, CLOSE_SIZE),
+			BackgroundColor3 = Color.White,
+			BackgroundTransparency = function()
+				return if isCloseHovered()
+					then Transparency.CloseButtonHovered
+					else Transparency.CloseButton
+			end,
+			-- The icon sheet isn't uploaded yet: a text glyph stands in.
+			FontFace = Text.CaptionCount.Font,
+			TextSize = Text.ButtonLabel.Size,
+			TextColor3 = Color.TextPrimary,
+			Text = if closeIcon then "" else "X",
+
+			Activated = props.Closed,
+			MouseEnter = function()
+				isCloseHovered(true)
+			end,
+			MouseLeave = function()
+				isCloseHovered(false)
+			end,
+			SelectionGained = function()
+				isCloseHovered(true)
+			end,
+			SelectionLost = function()
+				isCloseHovered(false)
+			end,
+
+			create("UICorner")({
+				CornerRadius = UDim.new(1, 0),
+			}),
+			closeIcon and create("ImageLabel")({
+				Name = "Icon",
+				AnchorPoint = Vector2.new(0.5, 0.5),
+				Position = UDim2.fromScale(0.5, 0.5),
+				Size = UDim2.fromOffset(CLOSE_ICON_SIZE, CLOSE_ICON_SIZE),
+				BackgroundTransparency = 1,
+				ScaleType = Enum.ScaleType.Fit,
+				Image = closeIcon.Image,
+				ImageRectOffset = closeIcon.RectOffset,
+				ImageRectSize = closeIcon.RectSize,
+				ImageColor3 = Color.TextPrimary,
+			}),
+		}),
+	})
+end
+
+local function slotGrid(props: Props): Frame
+	return create("Frame")({
+		Name = "SlotGrid",
+		LayoutOrder = 2,
+		Size = function()
+			return UDim2.new(1, 0, 0, gridHeight(#props.Slots()))
+		end,
+		BackgroundTransparency = 1,
+
+		create("UIGridLayout")({
+			CellSize = UDim2.fromOffset(InventorySlot.Size, InventorySlot.Size),
+			CellPadding = UDim2.fromOffset(SLOT_GAP, SLOT_GAP),
+		}),
+
+		indexes(props.Slots, function(slot, index)
+			return InventorySlot.build({
+				BlockName = function()
+					return slot().Name
+				end,
+				BlockColor = function()
+					return slot().Color
+				end,
+				Count = function()
+					return slot().Count
+				end,
+				UnlockLevel = function()
+					return slot().UnlockLevel
+				end,
+				IsSelected = function()
+					return slot().Name == props.EquippedName()
+				end,
+				IsPicked = function()
+					return slot().Name == props.PickedName()
+				end,
+				IsLocked = function()
+					return slot().IsLocked
+				end,
+				LayoutOrder = index,
+				Activated = function()
+					props.SlotPicked(slot().Name)
+				end,
+			})
+		end),
+	})
+end
+
+local function equipButton(state: () -> EquipState, activated: () -> ()): TextButton
+	local isPressed = source(false)
+
+	local function isReady(): boolean
+		return state() == "Ready"
+	end
+
+	-- Direct feedback to the player's press, so it may bounce a little.
+	local labelPosition = spring(function()
+		local depth = if isPressed() and isReady() then EQUIP_PRESS_DEPTH else 0
+		return UDim2.new(0.5, 0, 0.5, depth)
+	end, 0.15, 0.6)
+
+	return create("TextButton")({
+		Name = "EquipButton",
+		AnchorPoint = Vector2.new(1, 0.5),
+		Position = UDim2.fromScale(1, 0.5),
+		Size = UDim2.new(0, EQUIP_WIDTH, 1, 0),
+		BackgroundColor3 = Color.White,
+		Text = "",
+
+		Activated = activated,
+		MouseButton1Down = function()
+			isPressed(true)
+		end,
+		MouseButton1Up = function()
+			isPressed(false)
+		end,
+		MouseLeave = function()
+			isPressed(false)
+		end,
+
+		create("UICorner")({
+			CornerRadius = UDim.new(0, InventoryTheme.Radius.Button),
+		}),
+		-- Not in the design: a disabled button takes the slot gradient.
+		create("UIGradient")({
+			Color = function()
+				return if isReady()
+					then ColorSequence.new(Color.ButtonTop, Color.ButtonBottom)
+					else ColorSequence.new(Color.SlotTop, Color.SlotBottom)
+			end,
+			Rotation = 90,
+		}),
+		Shadow.build({
+			Color = Color.Shadow,
+			Transparency = 0.75,
+			Offset = Vector2.new(0, -3),
+			BlurRadius = 0,
+			IsInset = true,
+		}),
+
+		create("TextLabel")({
+			Name = "Label",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = labelPosition,
+			Size = UDim2.new(1, 0, 0, Text.ButtonLabel.LineHeight),
+			BackgroundTransparency = 1,
+			FontFace = Text.ButtonLabel.Font,
+			TextSize = Text.ButtonLabel.Size,
+			TextColor3 = function()
+				return if isReady() then Color.ButtonLabel else Color.TextSecondary
+			end,
+			Text = function()
+				return EQUIP_LABELS[state()]
+			end,
+		}),
+	})
+end
+
+local function footer(props: Props, pickedSlot: () -> SlotData?): Frame
+	local derivedState = derive(function(): EquipState
+		local slot = pickedSlot()
+		if slot and slot.IsLocked then
+			return "Locked"
+		elseif slot and slot.Name ~= props.EquippedName() then
+			return "Ready"
+		end
+		return "Equipped"
+	end)
+
+	-- derive widens the string literals to string, so narrow them back.
+	local function equipState(): EquipState
+		return derivedState() :: EquipState
+	end
+
+	return create("Frame")({
+		Name = "Footer",
+		LayoutOrder = 3,
+		Size = UDim2.new(1, 0, 0, FOOTER_HEIGHT),
+		BackgroundTransparency = 1,
+
+		create("TextLabel")({
+			Name = "SelectedName",
+			AnchorPoint = Vector2.new(0, 0.5),
+			Position = UDim2.fromScale(0, 0.5),
+			Size = UDim2.new(1, -(EQUIP_WIDTH + SECTION_GAP), 0, Text.BodyMedium.LineHeight),
+			BackgroundTransparency = 1,
+			FontFace = Text.BodyMedium.Font,
+			TextSize = Text.BodyMedium.Size,
+			TextColor3 = Color.TextSecondary,
+			TextXAlignment = Enum.TextXAlignment.Left,
+			TextTruncate = Enum.TextTruncate.AtEnd,
+			Text = function()
+				local slot = pickedSlot()
+				if not slot then
+					return ""
+				elseif slot.IsLocked then
+					return `{slot.DisplayName}: unlocks at Lv {slot.UnlockLevel}`
+				end
+				return slot.DisplayName
+			end,
+		}),
+
+		equipButton(equipState, function()
+			local slot = pickedSlot()
+			if slot and equipState() == "Ready" then
+				props.Equipped(slot.Name)
+			end
+		end),
+	})
+end
+
+local Module = {}
+
+--[[
+	The panel's size in UI units for a number of slots: six to a row, as many rows as
+	they need.
+]]
+function Module.size(slotCount: number): Vector2
+	local height = PADDING_Y * 2
+		+ HEADER_HEIGHT
+		+ SECTION_GAP
+		+ gridHeight(slotCount)
+		+ SECTION_GAP
+		+ FOOTER_HEIGHT
+	return Vector2.new(PANEL_WIDTH, height)
+end
+
+function Module.build(props: Props): Frame
+	local pickedSlot = derive(function(): SlotData?
+		local pickedName = props.PickedName()
+		for _, slot in props.Slots() do
+			if slot.Name == pickedName then
+				return slot
+			end
+		end
+		return nil
+	end)
+
+	local strokeWidth = InventoryTheme.Stroke.Panel
+
+	return create("Frame")({
+		Name = "InventoryPanel",
+		Size = function()
+			local size = Module.size(#props.Slots())
+			return UDim2.fromOffset(size.X, size.Y)
+		end,
+		BackgroundColor3 = Color.SurfacePanel,
+		BackgroundTransparency = Transparency.SurfacePanel,
+		-- Clicks on the panel's background must not reach the world and place a block.
+		Active = true,
+
+		create("UICorner")({
+			CornerRadius = UDim.new(0, InventoryTheme.Radius.Panel),
+		}),
+		createUnlisted("UIStroke")({
+			BorderStrokePosition = Enum.BorderStrokePosition.Inner,
+			Thickness = strokeWidth,
+			Color = Color.Border,
+		}),
+		Shadow.build({
+			Color = Color.Shadow,
+			Transparency = 0.55,
+			Offset = Vector2.new(0, 12),
+			BlurRadius = 32,
+			ShowBehindParent = false,
+		}),
+
+		-- Inset by the stroke so the pattern never draws over the border.
+		create("ImageLabel")({
+			Name = "HexPattern",
+			Position = UDim2.fromOffset(strokeWidth, strokeWidth),
+			Size = UDim2.new(1, -strokeWidth * 2, 1, -strokeWidth * 2),
+			ZIndex = 1,
+			BackgroundTransparency = 1,
+			Image = InventoryAssets.hexTile(),
+			ImageColor3 = Color.White,
+			ImageTransparency = Transparency.HexPattern,
+			ScaleType = Enum.ScaleType.Tile,
+			TileSize = UDim2.fromOffset(
+				InventoryAssets.HexTileSize.X,
+				InventoryAssets.HexTileSize.Y
+			),
+
+			create("UICorner")({
+				CornerRadius = UDim.new(0, InventoryTheme.Radius.Panel - strokeWidth),
+			}),
+		}),
+
+		create("Frame")({
+			Name = "Content",
+			Size = UDim2.fromScale(1, 1),
+			ZIndex = 2,
+			BackgroundTransparency = 1,
+
+			createUnlisted("UIPadding")({
+				PaddingLeft = UDim.new(0, PADDING_X),
+				PaddingRight = UDim.new(0, PADDING_X),
+				PaddingTop = UDim.new(0, PADDING_Y),
+				PaddingBottom = UDim.new(0, PADDING_Y),
+			}),
+			create("UIListLayout")({
+				Padding = UDim.new(0, SECTION_GAP),
+			}),
+
+			header(props),
+			slotGrid(props),
+			footer(props, pickedSlot),
+		}),
+	})
+end
+
+--[[
+	The button that opens the panel again while it's closed. Not in the design: it is
+	built from the panel's own tokens, and stands in until the HUD has an inventory button.
+]]
+function Module.buildOpenButton(activated: () -> ()): TextButton
+	local isHovered = source(false)
+
+	return create("TextButton")({
+		Name = "OpenInventoryButton",
+		Size = UDim2.fromOffset(0, OPEN_BUTTON_HEIGHT),
+		AutomaticSize = Enum.AutomaticSize.X,
+		BackgroundColor3 = Color.SurfacePanel,
+		BackgroundTransparency = Transparency.SurfacePanel,
+		FontFace = Text.ButtonLabel.Font,
+		TextSize = Text.ButtonLabel.Size,
+		TextColor3 = Color.TextPrimary,
+		Text = string.upper("Inventory"),
+
+		Activated = activated,
+		MouseEnter = function()
+			isHovered(true)
+		end,
+		MouseLeave = function()
+			isHovered(false)
+		end,
+		SelectionGained = function()
+			isHovered(true)
+		end,
+		SelectionLost = function()
+			isHovered(false)
+		end,
+
+		create("UICorner")({
+			CornerRadius = UDim.new(0, InventoryTheme.Radius.Button),
+		}),
+		createUnlisted("UIStroke")({
+			BorderStrokePosition = Enum.BorderStrokePosition.Inner,
+			Thickness = InventoryTheme.Stroke.Panel,
+			Color = function()
+				return if isHovered() then Color.Accent else Color.Border
+			end,
+		}),
+		createUnlisted("UIPadding")({
+			PaddingLeft = UDim.new(0, OPEN_BUTTON_PADDING),
+			PaddingRight = UDim.new(0, OPEN_BUTTON_PADDING),
+		}),
+	})
+end
+
+return Module
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau
new file mode 100644
index 0000000..2c4e5b8
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventoryScreen.luau
@@ -0,0 +1,150 @@
+--!strict
+--[[
+	Connects the inventory panel to the game: block types from BlockTypes, counts and
+	locks from BlockInventory, and the equipped block type from BlockPlacer. Owns whether
+	the panel is open, centers it below the topbar, and shrinks it on screens too small
+	for it.
+]]
+
+local UserInputService = game:GetService("UserInputService")
+
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+
+local BlockInventory = require("../BlockInventory")
+local BlockPlacer = require("../BlockPlacer")
+local InventoryPanel = require("./InventoryPanel")
+local Screen = require("./Screen")
+
+local cleanup = Vide.cleanup
+local create = Vide.create
+-- Vide's create types list only common classes, and UIScale isn't one of them.
+local createUnlisted: any = Vide.create
+local show = Vide.show
+local source = Vide.source
+
+local TOGGLE_KEYS = { Enum.KeyCode.B, Enum.KeyCode.ButtonY }
+local EDGE_PADDING = 16
+-- Below half size the panel's text gets too small to read.
+local MINIMUM_FIT_SCALE = 0.5
+
+local function readSlots(): { InventoryPanel.SlotData }
+	local slots = {}
+	for _, blockType in BlockTypes.List do
+		table.insert(
+			slots,
+			table.freeze({
+				Name = blockType.Name,
+				DisplayName = blockType.DisplayName,
+				Color = blockType.Color,
+				Count = BlockInventory.getCount(blockType.Name),
+				UnlockLevel = BlockInventory.getUnlockLevel(blockType.Name),
+				IsLocked = not BlockInventory.isUnlocked(blockType.Name),
+			})
+		)
+	end
+	return slots
+end
+
+local function fitScale(designSize: Vector2): number
+	local usable = Screen.usableSize()
+	local fit = math.min(
+		(usable.X - EDGE_PADDING * 2) / designSize.X,
+		(usable.Y - EDGE_PADDING * 2) / designSize.Y
+	)
+	return math.clamp(fit, MINIMUM_FIT_SCALE, 1)
+end
+
+local Module = {}
+
+--[[
+	The panel's dock, centered in the ScreenGui, and the button that reopens the panel,
+	in the top right while it's closed. Opens with the panel showing. Call it inside a
+	Vide scope and put the result directly in the ScreenGui's children.
+]]
+function Module.build(): { Instance }
+	local isOpen = source(true)
+	local slots = source(readSlots())
+	local equippedName = source(BlockPlacer.getBlockType())
+
+	cleanup(BlockInventory.Changed:Connect(function()
+		slots(readSlots())
+	end))
+	cleanup(BlockPlacer.BlockTypeChanged:Connect(function(name: string)
+		equippedName(name)
+	end))
+	local function onInputBegan(input: InputObject, gameProcessedEvent: boolean)
+		if gameProcessedEvent then
+			return
+		end
+		if table.find(TOGGLE_KEYS, input.KeyCode) then
+			isOpen(not isOpen())
+		end
+	end
+	cleanup(UserInputService.InputBegan:Connect(onInputBegan))
+
+	local function designSize(): Vector2
+		return InventoryPanel.size(#slots())
+	end
+
+	local dock = create("Frame")({
+		Name = "InventoryDock",
+		AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.5),
+		Size = function()
+			local size = designSize()
+			return UDim2.fromOffset(size.X, size.Y)
+		end,
+		BackgroundTransparency = 1,
+
+		createUnlisted("UIScale")({
+			Scale = function()
+				return fitScale(designSize())
+			end,
+		}),
+
+		show(isOpen, function()
+			-- Each opening starts on the equipped block.
+			local pickedName = source(equippedName())
+			cleanup(BlockPlacer.BlockTypeChanged:Connect(function(name: string)
+				pickedName(name)
+			end))
+
+			return InventoryPanel.build({
+				Slots = slots,
+				PickedName = pickedName,
+				EquippedName = equippedName,
+				SlotPicked = function(name: string)
+					pickedName(name)
+				end,
+				Equipped = function(name: string)
+					BlockPlacer.setBlockType(name)
+				end,
+				Closed = function()
+					isOpen(false)
+				end,
+			})
+		end),
+	})
+
+	local openButtonDock = create("Frame")({
+		Name = "OpenInventoryDock",
+		AnchorPoint = Vector2.new(1, 0),
+		Position = UDim2.new(1, -EDGE_PADDING, 0, EDGE_PADDING),
+		AutomaticSize = Enum.AutomaticSize.XY,
+		BackgroundTransparency = 1,
+
+		show(function()
+			return not isOpen()
+		end, function()
+			return InventoryPanel.buildOpenButton(function()
+				isOpen(true)
+			end)
+		end),
+	})
+
+	return { dock, openButtonDock }
+end
+
+return Module
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/InventorySlot.luau b/src/StarterPlayer/StarterPlayerScripts/UI/InventorySlot.luau
new file mode 100644
index 0000000..e3ddb1a
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/InventorySlot.luau
@@ -0,0 +1,260 @@
+--!strict
+--[[
+	One inventory slot, the Figma Slot component set (20:1). Its State variant becomes two
+	props the game sets: IsSelected (the Selected variant, the block the player builds
+	with) and IsLocked (the Locked variant). IsPicked marks the slot the player has
+	picked in the panel but not equipped yet, which the design has no variant for. Hover
+	is the slot's own state.
+]]
+
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local InventoryAssets = require("./InventoryAssets")
+local InventoryTheme = require("./InventoryTheme")
+local Shadow = require("./Shadow")
+
+local create = Vide.create
+-- Vide's create types list only common classes, and UIStroke isn't one of them.
+local createUnlisted: any = Vide.create
+local effect = Vide.effect
+local read = Vide.read
+local source = Vide.source
+local spring = Vide.spring
+
+local SLOT_SIZE = 96
+local ART_SIZE = 56
+-- Block Art's top-left inside the slot
+local ART_POSITION = Vector2.new(20, 16)
+local SWATCH_RADIUS = 8
+local COUNT_RIGHT = 8
+local COUNT_BOTTOM = 6
+local UNLOCK_BOTTOM = 8
+local LOCK_ICON_SIZE = 24
+-- The lock's center sits this far above the slot's center
+local LOCK_ICON_RISE = 10
+local GLOW_PERIOD = 0.25
+
+local Color = InventoryTheme.Color
+local Transparency = InventoryTheme.Transparency
+local Text = InventoryTheme.Text
+
+export type Props = {
+	BlockName: string | () -> string,
+	-- Drawn as a swatch while the Block Art sheet isn't uploaded
+	BlockColor: Color3 | () -> Color3,
+	Count: number | () -> number,
+	UnlockLevel: number | () -> number,
+	IsSelected: boolean | () -> boolean,
+	IsPicked: (boolean | () -> boolean)?,
+	IsLocked: boolean | () -> boolean,
+	LayoutOrder: number?,
+	Activated: () -> (),
+}
+
+local Module = {}
+
+Module.Size = SLOT_SIZE
+
+function Module.build(props: Props): TextButton
+	local isHovered = source(false)
+
+	local function isSelected(): boolean
+		return read(props.IsSelected)
+	end
+
+	local function isPicked(): boolean
+		return read(props.IsPicked) == true
+	end
+
+	local function isLocked(): boolean
+		return read(props.IsLocked)
+	end
+
+	local function sprite(): InventoryAssets.Sprite?
+		return InventoryAssets.blockArt(read(props.BlockName))
+	end
+
+	local function contentTransparency(): number
+		return if isLocked() then Transparency.LockedContent else 0
+	end
+
+	local glowTransparency = spring(function()
+		return if isSelected() then 0.45 else 1
+	end, GLOW_PERIOD)
+
+	-- Selected: Accent at 55% alpha, blur 16, spread 2
+	local glow = Shadow.build({
+		Color = Color.Accent,
+		Transparency = 1,
+		Offset = Vector2.zero,
+		BlurRadius = 16,
+		Spread = 2,
+		ShowBehindParent = false,
+	})
+	if glow then
+		local glowShadow: any = glow
+		effect(function()
+			glowShadow.Transparency = glowTransparency()
+		end)
+	end
+
+	local artOrigin = ART_POSITION - InventoryAssets.BlockArtInset
+	local lockIcon = InventoryAssets.icon("Lock")
+
+	return create("TextButton")({
+		Name = "Slot",
+		Size = UDim2.fromOffset(SLOT_SIZE, SLOT_SIZE),
+		LayoutOrder = props.LayoutOrder,
+		BackgroundColor3 = Color.White,
+		Text = "",
+
+		Activated = props.Activated,
+		MouseEnter = function()
+			isHovered(true)
+		end,
+		MouseLeave = function()
+			isHovered(false)
+		end,
+		SelectionGained = function()
+			isHovered(true)
+		end,
+		SelectionLost = function()
+			isHovered(false)
+		end,
+
+		create("UICorner")({
+			CornerRadius = UDim.new(0, InventoryTheme.Radius.Slot),
+		}),
+		create("UIGradient")({
+			Color = ColorSequence.new(Color.SlotTop, Color.SlotBottom),
+			Rotation = 90,
+		}),
+		createUnlisted("UIStroke")({
+			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+			BorderStrokePosition = function()
+				return if isSelected()
+					then Enum.BorderStrokePosition.Outer
+					else Enum.BorderStrokePosition.Inner
+			end,
