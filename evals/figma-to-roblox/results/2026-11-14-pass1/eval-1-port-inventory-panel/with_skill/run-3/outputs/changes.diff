--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Shadow.luau
@@ -0,0 +1,62 @@
+--!strict
+--[[
+	Builds the UIShadow for a Figma drop shadow or inner shadow. Every shadow in the UI
+	goes through here, so a change to UIShadow's properties is a one-place fix.
+]]
+
+export type Spec = {
+	Color: Color3,
+	-- 1 minus the Figma alpha
+	Transparency: number,
+	Offset: Vector2,
+	BlurRadius: number,
+	Spread: number?,
+	-- Shadow the text glyphs instead of the box
+	IsText: boolean?,
+	-- Figma's inner shadow
+	IsInset: boolean?,
+	-- false for a see-through layer, so the shadow doesn't tint what shows through it
+	ShowBehindParent: boolean?,
+}
+
+local Module = {}
+
+local hasWarned = false
+
+--[[
+	A new UIShadow for the spec, or nil if the engine rejects it. A rejected shadow
+	warns once and leaves the UI without it instead of breaking the whole screen.
+]]
+function Module.build(spec: Spec): Instance?
+	-- Expected failures: UIShadow missing on this engine version, or a property name
+	-- or type here that differs from the shipped API.
+	local success, result = pcall(function()
+		local shadow: any = Instance.new("UIShadow" :: any)
+		shadow.Color = spec.Color
+		shadow.Transparency = spec.Transparency
+		shadow.Offset = spec.Offset
+		shadow.BlurRadius = spec.BlurRadius
+		shadow.Spread = spec.Spread or 0
+		if spec.IsText then
+			shadow.Mode = "Text"
+		end
+		if spec.IsInset then
+			shadow.Inset = true
+		end
+		if spec.ShowBehindParent ~= nil then
+			shadow.ShowBehindParent = spec.ShowBehindParent
+		end
+		return shadow
+	end)
+
+	if success then
+		return result
+	end
+	if not hasWarned then
+		hasWarned = true
+		warn(`UIShadow could not be built, shadows are off: {result}`)
+	end
+	return nil
+end
+
+return Module
