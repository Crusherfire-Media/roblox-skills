+			Size = UDim2.fromOffset(InventoryAssets.BlockArtSize.X, InventoryAssets.BlockArtSize.Y),
+			BackgroundTransparency = 1,
+			ScaleType = Enum.ScaleType.Fit,
+			Image = function()
+				local art = sprite()
+				return if art then art.Image else ""
+			end,
+			ImageRectOffset = function()
+				local art = sprite()
+				return if art then art.RectOffset else Vector2.zero
+			end,
+			ImageRectSize = function()
+				local art = sprite()
+				return if art then art.RectSize else Vector2.zero
+			end,
+			ImageTransparency = contentTransparency,
+			Visible = function()
+				return sprite() ~= nil
+			end,
+		}),
+
+		create("TextLabel")({
+			Name = "Count",
+			AnchorPoint = Vector2.new(1, 1),
+			Position = UDim2.new(1, -COUNT_RIGHT, 1, -COUNT_BOTTOM),
+			Size = UDim2.fromOffset(0, Text.CaptionCount.LineHeight),
+			AutomaticSize = Enum.AutomaticSize.X,
+			BackgroundTransparency = 1,
+			FontFace = Text.CaptionCount.Font,
+			TextSize = Text.CaptionCount.Size,
+			TextColor3 = Color.TextPrimary,
+			TextXAlignment = Enum.TextXAlignment.Right,
+			Text = function()
+				return `x{read(props.Count)}`
+			end,
+			Visible = function()
+				return not isLocked()
+			end,
+
+			Shadow.build({
+				Color = Color.Shadow,
+				Transparency = 0.4,
+				Offset = Vector2.new(0, 1),
+				BlurRadius = 2,
+				IsText = true,
+			}),
+		}),
+
+		create("ImageLabel")({
+			Name = "LockIcon",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.new(0.5, 0, 0.5, -LOCK_ICON_RISE),
+			Size = UDim2.fromOffset(LOCK_ICON_SIZE, LOCK_ICON_SIZE),
+			BackgroundTransparency = 1,
+			ScaleType = Enum.ScaleType.Fit,
+			Image = if lockIcon then lockIcon.Image else "",
+			ImageRectOffset = if lockIcon then lockIcon.RectOffset else Vector2.zero,
+			ImageRectSize = if lockIcon then lockIcon.RectSize else Vector2.zero,
+			ImageColor3 = Color.TextPrimary,
+			Visible = isLocked,
+		}),
+
+		create("TextLabel")({
+			Name = "UnlockLabel",
+			AnchorPoint = Vector2.new(0.5, 1),
+			Position = UDim2.new(0.5, 0, 1, -UNLOCK_BOTTOM),
+			Size = UDim2.fromOffset(0, Text.UnlockLabel.LineHeight),
+			AutomaticSize = Enum.AutomaticSize.X,
+			BackgroundTransparency = 1,
+			FontFace = Text.UnlockLabel.Font,
+			TextSize = Text.UnlockLabel.Size,
+			TextColor3 = Color.TextPrimary,
+			Text = function()
+				return `Lv {read(props.UnlockLevel)}`
+			end,
+			Visible = isLocked,
+		}),
+	})
+end
+
+return Module
