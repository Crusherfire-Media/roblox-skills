+				elseif isHovered() then
+					return Color.TextSecondary
+				end
+				return Color.Border
+			end,
+			Transparency = function()
+				local isPlainHover = isHovered() and not isSelected() and not isPicked()
+				return if isPlainHover then Transparency.SlotHoverBorder else 0
+			end,
+		}),
+		glow,
+
+		create("Frame")({
+			Name = "Swatch",
+			Position = UDim2.fromOffset(ART_POSITION.X, ART_POSITION.Y),
+			Size = UDim2.fromOffset(ART_SIZE, ART_SIZE),
+			BackgroundColor3 = props.BlockColor,
