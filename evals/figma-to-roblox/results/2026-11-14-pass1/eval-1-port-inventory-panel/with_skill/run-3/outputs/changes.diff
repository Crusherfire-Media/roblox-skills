+--!strict
+--[[
+	Design tokens for the inventory panel, taken from the Figma file "Block Builder - UI"
+	(design/figma/inventory-panel.json, screen 12:340 and the Slot set 20:1). Named as the
+	design names them. Each color comes with a transparency, which is 1 minus the Figma
+	alpha. Sizes are offsets at the 1080p reference size.
+]]
+
+local BUILDER_SANS = "rbxasset://fonts/families/BuilderSans.json"
+
+export type TextStyle = {
+	Font: Font,
+	Size: number,
+	LineHeight: number,
+}
+
+local Module = {}
+
+Module.Color = table.freeze({
+	-- Surface/Panel
+	SurfacePanel = Color3.fromRGB(23, 26, 38),
+	-- Panel border, slot border, and the disabled button's lower stop
+	Border = Color3.fromRGB(58, 64, 96),
+	-- Text/Primary
+	TextPrimary = Color3.fromRGB(245, 246, 250),
+	-- Body text in the footer
+	TextSecondary = Color3.fromRGB(199, 204, 224),
+	SlotTop = Color3.fromRGB(43, 49, 80),
+	SlotBottom = Color3.fromRGB(32, 37, 59),
+	-- Selected slot ring and glow
+	Accent = Color3.fromRGB(255, 200, 60),
+	ButtonTop = Color3.fromRGB(255, 210, 90),
+	ButtonBottom = Color3.fromRGB(255, 159, 28),
+	ButtonLabel = Color3.fromRGB(59, 35, 0),
+	Shadow = Color3.new(0, 0, 0),
+	White = Color3.new(1, 1, 1),
+})
+
+Module.Transparency = table.freeze({
+	-- Figma alpha is 0.92 with a 24 px background blur. Roblox can't blur what lies
+	-- behind one frame, so the fill is made more opaque to stand in for it.
+	SurfacePanel = 0.04,
+	-- White at 8% alpha
+	CloseButton = 0.92,
+	-- Not in the design: twice the resting alpha
+	CloseButtonHovered = 0.84,
+	-- Hex Pattern group opacity 6%
+	HexPattern = 0.94,
+	-- Content of a locked slot is at 40% opacity
+	LockedContent = 0.6,
+	-- Not in the design: the slot border on hover, in TextSecondary
+	SlotHoverBorder = 0.5,
+})
+
+Module.Text = table.freeze({
+	-- Heading/Title. The design adds +2 letter spacing, which Roblox can't draw.
+	HeadingTitle = table.freeze({
+		Font = Font.new(BUILDER_SANS, Enum.FontWeight.Bold),
+		Size = 28,
+		LineHeight = 34,
+	}),
+	-- Body/Medium
+	BodyMedium = table.freeze({
+		Font = Font.new(BUILDER_SANS, Enum.FontWeight.Medium),
+		Size = 18,
+		LineHeight = 24,
+	}),
+	-- Caption/Count
+	CaptionCount = table.freeze({
+		Font = Font.new(BUILDER_SANS, Enum.FontWeight.Bold),
+		Size = 16,
+		LineHeight = 20,
+	}),
+	-- Unlock Label on locked slots (no named style in the file)
+	UnlockLabel = table.freeze({
+		Font = Font.new(BUILDER_SANS, Enum.FontWeight.Bold),
+		Size = 14,
+		LineHeight = 18,
+	}),
+	-- Equip Button label (no named style in the file)
+	ButtonLabel = table.freeze({
+		Font = Font.new(BUILDER_SANS, Enum.FontWeight.ExtraBold),
+		Size = 20,
+		LineHeight = 24,
+	}),
+})
+
+Module.Radius = table.freeze({
+	Panel = 16,
+	Slot = 12,
+	Button = 12,
+})
+
+Module.Stroke = table.freeze({
+	Panel = 2,
+	Slot = 1,
+	-- Not in the design: the slot picked in the panel while another is equipped
+	SlotPicked = 2,
+	SlotSelected = 3,
+})
+
+return Module
