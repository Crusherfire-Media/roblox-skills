+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
diff --git a/src/ServerScriptService/Stories/HUD/QuestCard.story.luau b/src/ServerScriptService/Stories/HUD/QuestCard.story.luau
new file mode 100644
index 0000000..759e4bf
--- /dev/null
+++ b/src/ServerScriptService/Stories/HUD/QuestCard.story.luau
@@ -0,0 +1,73 @@
+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const QuestCard = require("@game/StarterPlayer/StarterPlayerScripts/UI/QuestCard")
+
+const LONG_TITLE = "Construct a towering fortress of stone and timber along the northern ridge"
+const LONG_DESCRIPTION = "Gather stone from the quarry and timber from the forest, then build "
+	.. "walls at least twelve blocks high around the whole ridge. Blocks you remove don't count, "
+	.. "and every tower needs a lookout platform on top before the quest will finish."
+
+const CONTROLS = {
+	Quest = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Title = UILabs.Ordered("Place 10 blocks", 1),
+			Description = UILabs.Ordered(
+				"Build anywhere on the baseplate. Blocks you remove don't count.",
+				2
+			),
+			Progress = UILabs.Ordered(UILabs.Slider(6, 0, 1000, 1), 3),
+			Goal = UILabs.Ordered(UILabs.Slider(10, 0, 1000, 1), 4),
+		}),
+		1
+	),
+	Preview = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- Overrides Title and Description with text longer than both caps.
+			UseLongText = UILabs.Ordered(false, 1),
+		}),
+		2
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Quest: {
+			Title: () -> string,
+			Description: () -> string,
+			Progress: () -> number,
+			Goal: () -> number,
+		},
+		Preview: {
+			UseLongText: () -> boolean,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local quest = props.controls.Quest
+	local preview = props.controls.Preview
+
+	return QuestCard({
+		Title = function()
+			return if preview.UseLongText() then LONG_TITLE else quest.Title()
+		end,
+		Description = function()
+			return if preview.UseLongText() then LONG_DESCRIPTION else quest.Description()
+		end,
+		Progress = quest.Progress,
+		Goal = quest.Goal,
+		AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.5),
+	})
+end
+
+return {
+	summary = "The HUD quest card, with sample, long, and finished quests.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
