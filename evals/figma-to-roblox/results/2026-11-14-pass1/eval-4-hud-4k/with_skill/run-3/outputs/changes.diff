+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const CoinCounter = require("@game/StarterPlayer/StarterPlayerScripts/UI/CoinCounter")
+
+const CONTROLS = {
+	-- The design's sample is 12,450; drag up for a wide pill.
+	Coins = UILabs.Ordered(UILabs.Slider(12450, 0, 999999999, 1), 1),
+}
