diff --git a/src/ServerScriptService/Stories/QuestCard.story.luau b/src/ServerScriptService/Stories/QuestCard.story.luau
new file mode 100644
index 0000000..a6b197e
--- /dev/null
+++ b/src/ServerScriptService/Stories/QuestCard.story.luau
@@ -0,0 +1,78 @@
+--!strict
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const QuestCard = require("@game/StarterPlayer/StarterPlayerScripts/UI/QuestCard")
+
+type Sample = {
+	Title: string,
+	Description: string,
+}
+
+const SAMPLES: { [string]: Sample } = {
+	Design = {
+		Title = "Place 10 blocks",
+		Description = "Build anywhere on the baseplate. Blocks you remove don't count.",
+	},
+	Long = {
+		Title = "Build a tower taller than the clock tower in the town square before sunset",
+		Description = "Stack blocks of any type on top of each other until your tower "
+			.. "reaches past the top of the clock tower. Blocks other players place on "
+			.. "your tower count too, so ask your friends for help. Towers that fall "
+			.. "over before you finish don't count, and you have to start again from "
+			.. "the ground. Glass blocks are worth double.",
+	},
+	NoDescription = {
+		Title = "Place 10 blocks",
+		Description = "",
+	},
+}
+
+const CONTROLS = {
+	Quest = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Text = UILabs.Ordered(UILabs.Choose({ "Design", "Long", "NoDescription" }), 1),
+			Progress = UILabs.Ordered(UILabs.Slider(6, 0, 1000, 1), 2),
+			Goal = UILabs.Ordered(UILabs.Slider(10, 0, 1000, 1), 3),
+		}),
+		1
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Quest: {
+			Text: () -> string,
+			Progress: () -> number,
+			Goal: () -> number,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	const quest = props.controls.Quest
+
+	local function sample(): Sample
+		return SAMPLES[quest.Text()] or SAMPLES.Design
+	end
+
+	return QuestCard({
+		Title = function()
+			return sample().Title
+		end,
+		Description = function()
+			return sample().Description
+		end,
+		Progress = quest.Progress,
+		Goal = quest.Goal,
+	})
+end
+
+return {
+	summary = "The HUD quest card, with the design's text, long text cut at its line "
+		.. "limits, and a quest with no description.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
