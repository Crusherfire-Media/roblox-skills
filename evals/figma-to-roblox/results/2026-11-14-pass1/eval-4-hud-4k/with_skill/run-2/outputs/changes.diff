diff --git a/src/ServerScriptService/Stories/HUD/QuestCard.story.luau b/src/ServerScriptService/Stories/HUD/QuestCard.story.luau
new file mode 100644
index 0000000..c8926c4
--- /dev/null
+++ b/src/ServerScriptService/Stories/HUD/QuestCard.story.luau
@@ -0,0 +1,74 @@
+--!strict
+
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const QuestCard = require("@game/StarterPlayer/StarterPlayerScripts/UI/QuestCard")
+
+const SAMPLE_TITLE = "Place 10 blocks"
+const SAMPLE_DESCRIPTION = "Build anywhere on the baseplate. Blocks you remove don't count."
+const LONG_TITLE = "Build a three-story watchtower beside the river before sundown"
+const LONG_DESCRIPTION = "Stack stone blocks at least twelve high on the riverbank, then "
+	.. "cap the tower with a wooden roof and a lantern on every side. Blocks placed by "
+	.. "friends on your plot count toward your goal, but blocks you remove, blocks that "
+	.. "fall into the water, and blocks placed during a rebuild don't count."
+
+const CONTROLS = {
+	Quest = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsLongText = UILabs.Ordered(false, 1),
+			-- Off shows a quest with no description.
+			HasDescription = UILabs.Ordered(true, 2),
+		}),
+		1
+	),
+	Progress = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Progress = UILabs.Ordered(UILabs.Slider(6, 0, 1000, 1), 1),
+			Goal = UILabs.Ordered(UILabs.Slider(10, 1, 1000, 1), 2),
+		}),
+		2
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Quest: {
+			IsLongText: () -> boolean,
+			HasDescription: () -> boolean,
+		},
+		Progress: {
+			Progress: () -> number,
+			Goal: () -> number,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local quest = props.controls.Quest
+	local progress = props.controls.Progress
+
+	return QuestCard({
+		Title = function()
+			return if quest.IsLongText() then LONG_TITLE else SAMPLE_TITLE
+		end,
+		Description = function()
+			if not quest.HasDescription() then
+				return ""
+			end
+			return if quest.IsLongText() then LONG_DESCRIPTION else SAMPLE_DESCRIPTION
+		end,
+		Progress = progress.Progress,
+		Goal = progress.Goal,
+		AnchorPoint = Vector2.new(1, 0),
+		Position = UDim2.new(1, -24, 0, 24),
+	})
+end
+
+return {
+	summary = "The quest tracker card from the HUD, at the 1080p reference size.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
