diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/HotbarSlot.luau b/src/StarterPlayer/StarterPlayerScripts/UI/HotbarSlot.luau
new file mode 100644
index 0000000..33d7f0e
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/HotbarSlot.luau
@@ -0,0 +1,116 @@
+--!strict
+--[[
+	One hotbar slot (the Figma "Hotbar Slot" component set): a block color swatch with its number
+	key in a badge, outlined in a gradient when selected. Hover and Pressed follow the pointer.
+]]
+
+local Theme = require("./Theme")
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local changed = Vide.changed
+local create = Vide.create
+local source = Vide.source
+
+local SLOT = Theme.Slot
+local KEY_BADGE = Theme.KeyBadge
+
+export type HotbarSlotProps = {
+	Name: string?,
+	LayoutOrder: number?,
+	Key: string | () -> string,
+	ShowKey: (boolean | () -> boolean)?,
+	Color: Color3 | () -> Color3,
+	IsSelected: boolean | () -> boolean,
+	-- Layer opacity of the frame the slot sits in, from 0 to 1. Defaults to 1.
+	Opacity: number?,
+	Activated: () -> (),
+}
+
+local function hotbarSlot(props: HotbarSlotProps): TextButton
+	local opacity = props.Opacity or 1
+	local guiState = source(Enum.GuiState.Idle)
+
+	local function isPressed(): boolean
+		return guiState() == Enum.GuiState.Press
+	end
+
+	local function fade(transparency: number): number
+		return Theme.foldOpacity(transparency, opacity)
+	end
+
+	-- The button keeps a fixed size so a pressed slot shrinks in place without moving the others.
+	return create("TextButton")({
+		Name = props.Name or "HotbarSlot",
+		LayoutOrder = props.LayoutOrder,
+		Size = UDim2.fromOffset(SLOT.Size, SLOT.Size),
+		BackgroundTransparency = 1,
+
+		Activated = props.Activated,
+		changed("GuiState", guiState),
+
+		create("Frame")({
+			Name = "Surface",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0.5),
+			Size = function()
+				local size = if isPressed() then SLOT.PressedSize else SLOT.Size
+				return UDim2.fromOffset(size, size)
+			end,
+			BackgroundColor3 = function()
+				local state = guiState()
+				if state == Enum.GuiState.Press then
+					return SLOT.PressedColor
+				elseif state == Enum.GuiState.Hover then
+					return SLOT.HoverColor
+				end
+				return SLOT.Color
+			end,
+			BackgroundTransparency = fade(0),
+
+			create("UICorner")({ CornerRadius = UDim.new(0, SLOT.CornerRadius) }),
+			create("UIStroke")({
+				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+				BorderStrokePosition = Enum.BorderStrokePosition.Outer,
+				Color = Color3.new(1, 1, 1),
+				Thickness = SLOT.SelectedStrokeThickness,
+				Transparency = fade(0),
+				Enabled = props.IsSelected,
+
+				create("UIGradient")({ Color = SLOT.SelectedStrokeGradient }),
+			}),
+
+			create("Frame")({
+				Name = "Swatch",
+				AnchorPoint = Vector2.new(0.5, 0.5),
+				Position = UDim2.fromScale(0.5, 0.5),
+				Size = UDim2.new(1, -2 * SLOT.SwatchInset, 1, -2 * SLOT.SwatchInset),
+				BackgroundColor3 = props.Color,
+				BackgroundTransparency = fade(0),
+
+				create("UICorner")({ CornerRadius = UDim.new(0, SLOT.SwatchCornerRadius) }),
+			}),
+
+			create("TextLabel")({
+				Name = "KeyBadge",
+				ZIndex = 2,
+				Position = function()
+					local inset = if isPressed() then KEY_BADGE.PressedInset else KEY_BADGE.Inset
+					return UDim2.fromOffset(inset, inset)
+				end,
+				Size = UDim2.fromOffset(KEY_BADGE.Size, KEY_BADGE.Size),
+				Visible = if props.ShowKey == nil then true else props.ShowKey,
+				BackgroundColor3 = KEY_BADGE.Color,
+				BackgroundTransparency = fade(KEY_BADGE.Transparency),
+				FontFace = KEY_BADGE.Font,
+				TextSize = KEY_BADGE.TextSize,
+				TextColor3 = KEY_BADGE.TextColor,
+				TextTransparency = fade(0),
+				Text = props.Key,
+
+				create("UICorner")({ CornerRadius = UDim.new(0.5, 0) }),
+			}),
+		}),
+	})
+end
+
+return hotbarSlot
diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/Theme.luau b/src/StarterPlayer/StarterPlayerScripts/UI/Theme.luau
new file mode 100644
index 0000000..5ad7011
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Theme.luau
@@ -0,0 +1,76 @@
+--!strict
+--[[
+	Design tokens from the Figma file "Block Builder - UI" (design/figma/hotbar.json), in offsets
+	for a screen 1080 pixels tall. Colors keep their Figma alpha as a transparency (1 - alpha).
+]]
+
+local WHITE = Color3.fromRGB(255, 255, 255)
+local BLACK = Color3.fromRGB(0, 0, 0)
+
+local Module = {}
+
+-- HUD / Desktop > Hotbar (node 40:40)
+Module.Hotbar = table.freeze({
+	-- Layer opacity on the whole bar. Roblox has no group opacity, so each layer folds it in.
+	Opacity = 0.8,
+	Color = Color3.fromRGB(14, 16, 32),
+	CornerRadius = 14,
+	Padding = 10,
+	Gap = 8,
+	BottomMargin = 24,
+	TopStrokeColor = WHITE,
+	TopStrokeTransparency = 0.88,
+	TopStrokeThickness = 2,
+})
+
+-- HUD / Desktop > Selected Name (node 40:41)
+Module.SelectedName = table.freeze({
+	-- The design uses Gilroy ExtraBold, which Roblox doesn't ship.
+	Font = Font.fromName("Montserrat", Enum.FontWeight.ExtraBold),
+	TextSize = 22,
+	LineHeight = 28,
+	TextColor = WHITE,
+	StrokeColor = BLACK,
+	StrokeTransparency = 0.4,
+	StrokeThickness = 2,
+	Gap = 8,
+})
+
+-- Hotbar Slot component set (node 31:2)
+Module.Slot = table.freeze({
+	Size = 64,
+	PressedSize = 60,
+	CornerRadius = 12,
+	Color = Color3.fromRGB(38, 43, 69),
+	HoverColor = Color3.fromRGB(49, 56, 88),
+	PressedColor = Color3.fromRGB(29, 33, 54),
+	SwatchInset = 12,
+	SwatchCornerRadius = 8,
+	SelectedStrokeThickness = 3,
+	SelectedStrokeGradient = ColorSequence.new(
+		Color3.fromRGB(255, 210, 90),
+		Color3.fromRGB(255, 128, 26)
+	),
+})
+
+-- Hotbar Slot > Key Badge
+Module.KeyBadge = table.freeze({
+	Size = 18,
+	Inset = 4,
+	PressedInset = 3,
+	Color = BLACK,
+	Transparency = 0.45,
+	Font = Font.fromName("BuilderSans", Enum.FontWeight.Bold),
+	TextSize = 12,
+	TextColor = WHITE,
+})
+
+--[[
+	The transparency a layer needs to look as it does inside a Figma frame with the given layer
+	opacity.
+]]
+function Module.foldOpacity(transparency: number, opacity: number): number
+	return 1 - (1 - transparency) * opacity
+end
+
+return table.freeze(Module)
