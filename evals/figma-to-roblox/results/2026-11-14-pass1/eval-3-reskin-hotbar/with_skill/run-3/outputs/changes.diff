@@ -0,0 +1,58 @@
+--!strict
+
+local BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+local Hotbar = require("@game/StarterPlayer/StarterPlayerScripts/UI/Hotbar")
+local UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local create = Vide.create
+local indexes = Vide.indexes
+local source = Vide.source
+
+local BLOCK_NAMES = {}
+for index, blockType in BlockTypes.List do
+	BLOCK_NAMES[index] = blockType.Name
+end
+
+local CONTROLS = {
+	-- Changing this starts the story over with that block selected. Clicking slots also selects.
+	Selected = UILabs.Ordered(UILabs.Choose(BLOCK_NAMES), 1),
+	-- A bright backdrop shows the bar's 80% opacity.
+	Backdrop = UILabs.Ordered(Color3.fromRGB(120, 170, 220), 2),
+}
+
+type StoryProps = {
+	controls: {
+		Selected: () -> string,
+		Backdrop: () -> Color3,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	return create("Frame")({
+		Size = UDim2.fromScale(1, 1),
+		BackgroundColor3 = props.controls.Backdrop,
+
+		indexes(function()
+			return { [props.controls.Selected()] = true }
+		end, function(_, startingName: string)
+			local selected = source(startingName)
+
+			return Hotbar({
+				Selected = selected,
+				Select = function(name: string)
+					print(`Selected {name}`)
+					selected(name)
+				end,
+			})
+		end),
+	})
+end
+
+return {
+	summary = "The hotbar with every block type. Click a slot to select it.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
