@@ -0,0 +1,53 @@
+--!strict
+
+local BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+local HotbarSlot = require("@game/StarterPlayer/StarterPlayerScripts/UI/HotbarSlot")
+local Theme = require("@game/StarterPlayer/StarterPlayerScripts/UI/Theme")
+local UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+local Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+local BLOCK_NAMES = {}
+for index, blockType in BlockTypes.List do
+	BLOCK_NAMES[index] = blockType.Name
+end
+
+local CONTROLS = {
+	Block = UILabs.Ordered(UILabs.Choose(BLOCK_NAMES), 1),
+	Key = UILabs.Ordered("1", 2),
+	ShowKey = UILabs.Ordered(true, 3),
+	IsSelected = UILabs.Ordered(false, 4),
+}
+
+type StoryProps = {
+	controls: {
+		Block: () -> string,
+		Key: () -> string,
+		ShowKey: () -> boolean,
+		IsSelected: () -> boolean,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local controls = props.controls
+
+	return HotbarSlot({
+		Key = controls.Key,
+		ShowKey = controls.ShowKey,
+		Color = function()
+			return BlockTypes.ByName[controls.Block()].Color
+		end,
+		IsSelected = controls.IsSelected,
+		Opacity = Theme.Hotbar.Opacity,
+		Activated = function()
+			print("Slot activated")
+		end,
+	})
+end
+
+return {
+	summary = "One hotbar slot at the hotbar's opacity. Hover and press it to see those states.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
