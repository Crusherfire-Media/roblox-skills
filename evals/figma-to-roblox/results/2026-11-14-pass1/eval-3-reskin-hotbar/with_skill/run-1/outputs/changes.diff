+--!strict
+--[[
+	The hotbar at the bottom of the preview. Point at a slot for Hover, hold it for Pressed, and
+	click it to select it, as in game.
+]]
+
+const BlockTypes = require("@game/ReplicatedStorage/Shared/BlockTypes")
+const UILabs = require("@game/ReplicatedStorage/Packages/UILabs")
+const Vide = require("@game/ReplicatedStorage/Packages/Vide")
+
+const Hotbar = require("@game/StarterPlayer/StarterPlayerScripts/UI/Hotbar")
+
+const create = Vide.create
+const indexes = Vide.indexes
+const source = Vide.source
+
+const BLOCK_NAMES = {}
+for index, blockType in BlockTypes.List do
+	BLOCK_NAMES[index] = blockType.Name
+end
+
+const CONTROLS = {
+	-- Changing it starts the story over with that block selected.
+	Selected = UILabs.Ordered(UILabs.Choose(BLOCK_NAMES), 1),
+	-- Stands in for the world behind the HUD; the default is the baseplate's gray.
+	Backdrop = UILabs.Ordered(Color3.fromRGB(99, 95, 98), 2),
+}
+
+type StoryProps = {
+	controls: {
+		Selected: () -> string,
+		Backdrop: () -> Color3,
+	},
+}
+
+local function story(props: StoryProps): Frame
+	const controls = props.controls
+
+	return create("Frame")({
+		Name = "HotbarStory",
+		Size = UDim2.fromScale(1, 1),
+		BackgroundColor3 = controls.Backdrop,
+
+		indexes(function()
+			return { [controls.Selected()] = true }
+		end, function(_, initialName: string)
+			const selected = source(initialName)
+
+			return Hotbar({
+				Selected = selected,
+				Select = function(name: string)
+					print(`Selected {name}`)
+					selected(name)
+				end,
+			})
+		end),
+	})
+end
+
+return {
+	summary = "The block hotbar: selected, default, hover, and pressed slots.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
