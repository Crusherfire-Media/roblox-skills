@@ -0,0 +1,68 @@
+--!strict
+--[[
+	Design tokens from the Figma file "Block Builder - UI" (design/figma/hotbar.json). Values are
+	the design's own, in offsets at the 1080-pixel reference height. Transparency is Figma's
+	alpha as 1 - alpha; layer opacity is left for the component to fold in.
+]]
+
+export type Fill = {
+	Color: Color3,
+	Transparency: number,
+}
+
+local Module = {}
+
+Module.Colors = table.freeze({
+	HotbarFill = table.freeze({ Color = Color3.fromRGB(14, 16, 32), Transparency = 0 }),
+	HotbarEdge = table.freeze({ Color = Color3.fromRGB(255, 255, 255), Transparency = 0.88 }),
+	SlotDefault = table.freeze({ Color = Color3.fromRGB(38, 43, 69), Transparency = 0 }),
+	SlotHover = table.freeze({ Color = Color3.fromRGB(49, 56, 88), Transparency = 0 }),
+	SlotPressed = table.freeze({ Color = Color3.fromRGB(29, 33, 54), Transparency = 0 }),
+	KeyBadge = table.freeze({ Color = Color3.fromRGB(0, 0, 0), Transparency = 0.45 }),
+	Text = table.freeze({ Color = Color3.fromRGB(255, 255, 255), Transparency = 0 }),
+	TextOutline = table.freeze({ Color = Color3.fromRGB(0, 0, 0), Transparency = 0.4 }),
+})
+
+-- Left to right across the selected slot's outline.
+Module.SelectedGradient =
+	ColorSequence.new(Color3.fromRGB(255, 210, 90), Color3.fromRGB(255, 128, 26))
+
+Module.Text = table.freeze({
+	-- The design uses Gilroy ExtraBold, which Roblox doesn't ship; Montserrat is the
+	-- nearest geometric sans that does.
+	SelectedName = table.freeze({
+		Font = Font.fromName("Montserrat", Enum.FontWeight.ExtraBold),
+		Size = 22,
+		LineHeight = 28,
+	}),
+	KeyLabel = table.freeze({
+		Font = Font.fromName("BuilderSans", Enum.FontWeight.Bold),
+		Size = 12,
+		LineHeight = 18,
+	}),
+})
+
+Module.Hotbar = table.freeze({
+	Opacity = 0.8,
+	Padding = 10,
+	Gap = 8,
+	CornerRadius = 14,
+	EdgeThickness = 2,
+	BottomMargin = 24,
+	NameGap = 8,
+	NameOutlineThickness = 2,
+})
+
+Module.Slot = table.freeze({
+	Size = 64,
+	PressedSize = 60,
+	CornerRadius = 12,
+	SwatchInset = 12,
+	SwatchCornerRadius = 8,
+	SelectedOutlineThickness = 3,
+	KeyBadgeSize = 18,
+	KeyBadgeInset = 4,
+	PressedKeyBadgeInset = 3,
+})
+
+return table.freeze(Module)
