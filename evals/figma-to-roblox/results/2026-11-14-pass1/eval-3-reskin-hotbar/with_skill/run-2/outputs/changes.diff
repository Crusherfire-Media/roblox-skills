diff --git a/src/StarterPlayer/StarterPlayerScripts/UI/HotbarSlot.luau b/src/StarterPlayer/StarterPlayerScripts/UI/HotbarSlot.luau
new file mode 100644
index 0000000..fe675e3
--- /dev/null
+++ b/src/StarterPlayer/StarterPlayerScripts/UI/HotbarSlot.luau
@@ -0,0 +1,165 @@
+--!strict
+--[[
+	One hotbar slot (Figma component set "Hotbar Slot", node 31:2): a block color swatch with its
+	number key in a badge. Selected is set by the caller; hover and pressed follow the pointer.
+]]
+
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+
+local Theme = require(script.Parent.Theme)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local changed = Vide.changed
+local create = Vide.create
+local read = Vide.read
+local source = Vide.source
+
+local SLOT_SIZE = 64
+local PRESSED_SLOT_SIZE = 60
+local SWATCH_SIZE = 40
+local PRESSED_SWATCH_SIZE = 36
+local BADGE_SIZE = 18
+local BADGE_INSET = 4
+local PRESSED_BADGE_INSET = 3
+
+export type PointerState = "Idle" | "Hover" | "Pressed"
+
+export type HotbarSlotProps = {
+	Name: string?,
+	LayoutOrder: number?,
+	Color: Color3 | () -> Color3,
+	Key: string | () -> string,
+	ShowKey: (boolean | () -> boolean)?,
+	IsSelected: boolean | () -> boolean,
+	-- Layer opacity of the frame the slot sits in, folded into every fill. Defaults to 1.
+	Opacity: number?,
+	-- Pins the pointer state for previews. Returning nil follows the real pointer.
+	PointerState: (() -> PointerState?)?,
+	Activated: () -> (),
+}
+
+local function hotbarSlot(props: HotbarSlotProps): TextButton
+	local opacity = props.Opacity or 1
+	local guiState = source(Enum.GuiState.Idle)
+
+	local function pointerState(): PointerState
+		if props.PointerState then
+			local pinned: PointerState? = props.PointerState()
+			if pinned ~= nil then
+				return pinned :: PointerState
+			end
+		end
+
+		local state = guiState()
+		if state == Enum.GuiState.Press then
+			return "Pressed"
+		elseif state == Enum.GuiState.Hover then
+			return "Hover"
+		end
+		return "Idle"
+	end
+
+	local function isPressed(): boolean
+		return pointerState() == "Pressed"
+	end
+
+	local function faceFill(): Theme.Fill
+		local state = pointerState()
+		if state == "Pressed" then
+			return Theme.Color.SlotPressed
+		elseif state == "Hover" then
+			return Theme.Color.SlotHover
+		end
+		return Theme.Color.SlotDefault
+	end
+
+	local badgeFill = Theme.Color.KeyBadge
+	local textFill = Theme.Color.Text
+
+	-- The button keeps its full size while the face shrinks on press, so the bar never reflows
+	-- and the hit area stays put under the finger.
+	return create("TextButton")({
+		Name = props.Name,
+		LayoutOrder = props.LayoutOrder,
+		Size = UDim2.fromOffset(SLOT_SIZE, SLOT_SIZE),
+		BackgroundTransparency = 1,
+
+		Activated = props.Activated,
+		changed("GuiState", guiState),
+
+		create("Frame")({
+			Name = "Face",
+			AnchorPoint = Vector2.new(0.5, 0.5),
+			Position = UDim2.fromScale(0.5, 0.5),
+			Size = function()
+				local size = if isPressed() then PRESSED_SLOT_SIZE else SLOT_SIZE
+				return UDim2.fromOffset(size, size)
+			end,
+			BackgroundColor3 = function()
+				return faceFill().Color
+			end,
+			BackgroundTransparency = function()
+				return Theme.fade(faceFill().Transparency, opacity)
+			end,
+
+			create("UICorner")({ CornerRadius = UDim.new(0, Theme.Radius.Slot) }),
+			create("UIStroke")({
+				Enabled = props.IsSelected,
+				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
+				BorderStrokePosition = Enum.BorderStrokePosition.Outer,
+				Thickness = Theme.Stroke.Selected,
+				Color = Color3.new(1, 1, 1),
+				Transparency = Theme.fade(0, opacity),
+
+				create("UIGradient")({ Color = Theme.SelectedGradient }),
+			}),
+
+			create("Frame")({
+				Name = "Swatch",
+				AnchorPoint = Vector2.new(0.5, 0.5),
+				Position = UDim2.fromScale(0.5, 0.5),
+				Size = function()
+					local size = if isPressed() then PRESSED_SWATCH_SIZE else SWATCH_SIZE
+					return UDim2.fromOffset(size, size)
+				end,
+				BackgroundColor3 = props.Color,
+				BackgroundTransparency = Theme.fade(0, opacity),
+
+				create("UICorner")({ CornerRadius = UDim.new(0, Theme.Radius.Swatch) }),
+			}),
+
+			create("Frame")({
+				Name = "KeyBadge",
+				Visible = function()
+					local showKey = props.ShowKey
+					return showKey == nil or read(showKey)
+				end,
+				-- Overlaps the swatch's corner and draws over it, as in the design.
+				ZIndex = 2,
+				Position = function()
+					local inset = if isPressed() then PRESSED_BADGE_INSET else BADGE_INSET
+					return UDim2.fromOffset(inset, inset)
+				end,
+				Size = UDim2.fromOffset(BADGE_SIZE, BADGE_SIZE),
+				BackgroundColor3 = badgeFill.Color,
+				BackgroundTransparency = Theme.fade(badgeFill.Transparency, opacity),
+
+				create("UICorner")({ CornerRadius = UDim.new(1, 0) }),
+
+				create("TextLabel")({
+					Name = "Key",
+					ZIndex = 2,
+					Size = UDim2.fromScale(1, 1),
+					BackgroundTransparency = 1,
+					FontFace = Theme.Text.Key.Font,
+					TextSize = Theme.Text.Key.Size,
+					TextColor3 = textFill.Color,
+					TextTransparency = Theme.fade(textFill.Transparency, opacity),
+					Text = props.Key,
+				}),
+			}),
+		}),
+	})
+end
+
+return hotbarSlot
