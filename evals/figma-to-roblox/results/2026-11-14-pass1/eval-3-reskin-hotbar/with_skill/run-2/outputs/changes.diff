diff --git a/src/ServerScriptService/Stories/UI/Hotbar.story.luau b/src/ServerScriptService/Stories/UI/Hotbar.story.luau
new file mode 100644
index 0000000..48d1b00
--- /dev/null
+++ b/src/ServerScriptService/Stories/UI/Hotbar.story.luau
@@ -0,0 +1,55 @@
+--!strict
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local StarterPlayer = game:GetService("StarterPlayer")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local Hotbar = require(StarterPlayer.StarterPlayerScripts.UI.Hotbar)
+local UILabs = require(ReplicatedStorage.Packages.UILabs)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local create = Vide.create
+local source = Vide.source
+
+local blockNames = {}
+for index, blockType in BlockTypes.List do
+	blockNames[index] = blockType.Name
+end
+
+local CONTROLS = {
+	-- Changing it starts the hotbar over with that block selected.
+	Selected = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+}
+
+type StoryProps = {
+	controls: {
+		Selected: () -> string,
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	return create("Frame")({
+		Size = UDim2.fromScale(1, 1),
+		BackgroundTransparency = 1,
+
+		Vide.indexes(function()
+			return { [props.controls.Selected()] = true }
+		end, function(_, initialName: string)
+			local selected = source(initialName)
+			return Hotbar({
+				Selected = selected,
+				Select = function(name: string)
+					print(`Selected {name}`)
+					selected(name)
+				end,
+			})
+		end),
+	})
+end
+
+return {
+	summary = "The hotbar at the bottom of the screen. Click a slot to select it.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
diff --git a/src/ServerScriptService/Stories/UI/HotbarSlot.story.luau b/src/ServerScriptService/Stories/UI/HotbarSlot.story.luau
new file mode 100644
index 0000000..1397f0d
--- /dev/null
+++ b/src/ServerScriptService/Stories/UI/HotbarSlot.story.luau
@@ -0,0 +1,120 @@
+--!strict
+local ReplicatedStorage = game:GetService("ReplicatedStorage")
+local StarterPlayer = game:GetService("StarterPlayer")
+
+local BlockTypes = require(ReplicatedStorage.Shared.BlockTypes)
+local HotbarSlot = require(StarterPlayer.StarterPlayerScripts.UI.HotbarSlot)
+local Theme = require(StarterPlayer.StarterPlayerScripts.UI.Theme)
+local UILabs = require(ReplicatedStorage.Packages.UILabs)
+local Vide = require(ReplicatedStorage.Packages.Vide)
+
+local create = Vide.create
+
+local blockNames = {}
+for index, blockType in BlockTypes.List do
+	blockNames[index] = blockType.Name
+end
+
+local CONTROLS = {
+	Slot = UILabs.Ordered(
+		UILabs.ControlGroup({
+			Block = UILabs.Ordered(UILabs.Choose(blockNames), 1),
+			Key = UILabs.Ordered("1", 2),
+			ShowKey = UILabs.Ordered(true, 3),
+		}),
+		1
+	),
+	State = UILabs.Ordered(
+		UILabs.ControlGroup({
+			IsSelected = UILabs.Ordered(false, 1),
+			-- Live follows the real pointer; the others pin that state.
+			Pointer = UILabs.Ordered(UILabs.Choose({ "Live", "Idle", "Hover", "Pressed" }), 2),
+		}),
+		2
+	),
+	Look = UILabs.Ordered(
+		UILabs.ControlGroup({
+			-- The hotbar draws its slots at 0.8.
+			Opacity = UILabs.Ordered(UILabs.Slider(Theme.HotbarOpacity, 0, 1, 0.05), 1),
+		}),
+		3
+	),
+	Preview = UILabs.Ordered(
+		UILabs.ControlGroup({
+			OnHotbarFill = UILabs.Ordered(true, 1),
+		}),
+		4
+	),
+}
+
+type StoryProps = {
+	controls: {
+		Slot: {
+			Block: () -> string,
+			Key: () -> string,
+			ShowKey: () -> boolean,
+		},
+		State: {
+			IsSelected: () -> boolean,
+			Pointer: () -> string,
+		},
+		Look: {
+			Opacity: () -> number,
+		},
+		Preview: {
+			OnHotbarFill: () -> boolean,
+		},
+	},
+	target: Frame,
+}
+
+local function story(props: StoryProps)
+	local controls = props.controls
+
+	-- Opacity is read once by the slot, so the slot is rebuilt when the slider moves.
+	return create("Frame")({
+		AnchorPoint = Vector2.new(0.5, 0.5),
+		Position = UDim2.fromScale(0.5, 0.5),
+		Size = UDim2.fromOffset(96, 96),
+		BackgroundColor3 = Theme.Color.HotbarFill.Color,
+		BackgroundTransparency = function()
+			return if controls.Preview.OnHotbarFill() then 0 else 1
+		end,
+
+		Vide.indexes(function()
+			return { [controls.Look.Opacity()] = true }
+		end, function(_, opacity: number)
+			return HotbarSlot({
+				Color = function()
+					return BlockTypes.ByName[controls.Slot.Block()].Color
+				end,
+				Key = controls.Slot.Key,
+				ShowKey = controls.Slot.ShowKey,
+				IsSelected = controls.State.IsSelected,
+				Opacity = opacity,
+				PointerState = function(): HotbarSlot.PointerState?
+					local pointer = controls.State.Pointer()
+					if pointer == "Idle" or pointer == "Hover" or pointer == "Pressed" then
+						return pointer
+					end
+					return nil
+				end,
+				Activated = function()
+					print("Slot activated")
+				end,
+			})
+		end),
+
+		create("UIListLayout")({
+			HorizontalAlignment = Enum.HorizontalAlignment.Center,
+			VerticalAlignment = Enum.VerticalAlignment.Center,
+		}),
+	})
+end
+
+return {
+	summary = "One hotbar slot in each pointer and selection state.",
+	vide = Vide,
+	controls = CONTROLS,
+	story = story,
+}
