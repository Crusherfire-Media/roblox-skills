+++ b/src/StarterPlayer/StarterPlayerScripts/UI/Theme.luau
@@ -0,0 +1,73 @@
+--!strict
+--[[
+	Design tokens from the Figma file "Block Builder - UI" (design/figma/hotbar.json), named as the
+	design names its layers. Each color pairs a Color3 with a transparency: Figma alpha a becomes
+	transparency 1 - a.
+]]
+
+export type Fill = {
+	Color: Color3,
+	Transparency: number,
+}
+
+export type TextStyle = {
+	Font: Font,
+	Size: number,
+	LineHeight: number,
+}
+
+local function fill(color: Color3, transparency: number): Fill
+	return table.freeze({ Color = color, Transparency = transparency })
+end
+
+local function textStyle(font: Font, size: number, lineHeight: number): TextStyle
+	return table.freeze({ Font = font, Size = size, LineHeight = lineHeight })
+end
+
+local Theme = {}
+
+Theme.Color = table.freeze({
+	HotbarFill = fill(Color3.fromRGB(14, 16, 32), 0),
+	HotbarHighlight = fill(Color3.new(1, 1, 1), 0.88),
+	SlotDefault = fill(Color3.fromRGB(38, 43, 69), 0),
+	SlotHover = fill(Color3.fromRGB(49, 56, 88), 0),
+	SlotPressed = fill(Color3.fromRGB(29, 33, 54), 0),
+	KeyBadge = fill(Color3.new(0, 0, 0), 0.45),
+	Text = fill(Color3.new(1, 1, 1), 0),
+	TextOutline = fill(Color3.new(0, 0, 0), 0.4),
+})
+
+-- Runs left to right across the selected slot's outline.
+Theme.SelectedGradient =
+	ColorSequence.new(Color3.fromRGB(255, 210, 90), Color3.fromRGB(255, 128, 26))
+
+Theme.Text = table.freeze({
+	-- Stands in for Gilroy ExtraBold, which Roblox doesn't ship.
+	SelectedName = textStyle(Font.fromName("Montserrat", Enum.FontWeight.ExtraBold), 22, 28),
+	Key = textStyle(Font.fromName("BuilderSans", Enum.FontWeight.Bold), 12, 18),
+})
+
+Theme.Radius = table.freeze({
+	Hotbar = 14,
+	Slot = 12,
+	Swatch = 8,
+})
+
+Theme.Stroke = table.freeze({
+	HotbarHighlight = 2,
+	Selected = 3,
+	TextOutline = 2,
+})
+
+-- Figma draws the whole Hotbar frame, slots included, at this opacity.
+Theme.HotbarOpacity = 0.8
+
+--[[
+	Folds a parent's layer opacity into a child's transparency. Children fade one by one rather
+	than as a single picture, so a faded child shows its parent through it.
+]]
+function Theme.fade(transparency: number, opacity: number): number
+	return 1 - (1 - transparency) * opacity
+end
+
+return table.freeze(Theme)
